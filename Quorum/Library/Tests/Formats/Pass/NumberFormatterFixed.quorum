use Libraries.Data.Formats.NumberFormatter

NumberFormatter format

// rounds half up, keeps the requested number of decimals
output format:Fixed(3.14159, 2)
output format:Fixed(2.5, 0)
output format:Fixed(0.0005, 3)
output format:Fixed(1.0, 3)
output format:Fixed(0.05, 5)
output format:Fixed(12.0, 0)

// never writes -0
output format:Fixed(-1.25, 1)
output format:Fixed(-0.0001, 2)
output format:Fixed(-0.0, 3)

// numbers past the integer range
output format:Fixed(123456789.5, 3)
output format:Fixed(-5000000.25, 2)
