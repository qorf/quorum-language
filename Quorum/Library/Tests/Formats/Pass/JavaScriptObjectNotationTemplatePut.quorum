use Libraries.Containers.Array
use Libraries.Data.Formats.JavaScriptObjectNotationTemplate

text dq = ""
dq = dq:GetDoubleQuote()
text lf = ""
lf = lf:GetLineFeed()

// ' stands in for " so the JSON stays readable
text sample = "{" + lf + "  'name': 'project_settings'," + lf + "  'layer_height': '0.2'," + lf
    + "  'wall_loops': 3," + lf + "  'filament_colour': ['#FFFFFF', '#000000']," + lf
    + "  'empty': []," + lf + "  'quote': 'say \'hi\''" + lf + "}"
sample = sample:Replace("'", dq)

JavaScriptObjectNotationTemplate json
json:Load(sample)
Array<text> corners
corners:Add("0x0")
corners:Add("256x0")
corners:Add("256x256")
json:FillList("filament_colour", corners)
json:Put("curr_bed_type", "Textured PEI Plate")
json:Put("name", "renamed")

JavaScriptObjectNotationTemplate again
again:Load(json:ToText())

// FillList sets the length
output again:Count("filament_colour")
// Put adds a missing key, at the end
output again:GetText("curr_bed_type", "?")
Array<text> keys = again:GetKeys()
output keys:Get(keys:GetSize() - 1)
// Put replaces an existing key
output again:GetText("name", "?")

// Put into an empty object
JavaScriptObjectNotationTemplate empty
empty:Load("{}")
empty:Put("only", "value")
JavaScriptObjectNotationTemplate reread
reread:Load(empty:ToText())
output reread:GetText("only", "?")
