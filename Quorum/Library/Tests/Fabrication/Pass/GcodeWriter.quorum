use Libraries.Containers.Array
use Libraries.Language.Errors.InvalidArgumentError
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Slicing.PathGenerator
use Libraries.Fabrication.Slicing.PathOrderer
use Libraries.Fabrication.Printing.GcodeWriter
use Tests.Fabrication.TestModels
use Tests.Fabrication.TestSlices
use Tests.Fabrication.TestFiles
use Tests.Fabrication.GcodeReader

/*
Tests Libraries.Fabrication.Printing.GcodeWriter by writing a 20 mm cube
and reading the file back the way a printer would.
*/
class Main
    TestModels models
    TestSlices slices
    TestFiles files
    Array<Contour> ordered
    text startPath = ""
    text endPath = ""
    text lf = ""

    on create
        lf = lf:GetLineFeed()
    end

    action Main
        Array<Contour> outlines = slices:Outlines(models:Cube(), 0.2)
        integer planes = slices:GetLastPlaneCount()
        PathGenerator paths
        paths:Generate(outlines, planes)
        PathOrderer orderer
        ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)
        startPath = files:Write("gcode/start.gcode", "; test start" + lf + "M190 S{BED_TEMP}" + lf + "M109 S{NOZZLE_TEMP}" + lf + "; bed {BED_X} x {BED_Y}")
        endPath = files:Write("gcode/end.gcode", "; test end" + lf + "M104 S0")

        WritesAPrintableFile()
        ExtrudesTheRightAmount()
        DryRun()
        BambuExtras()
        TemplatesAndPlaceholders()
        BambuA1Placeholders()
        RejectsBadSettings()
    end

    action Writer returns GcodeWriter
        GcodeWriter gcode
        gcode:SetLayerHeight(0.2)
        gcode:SetLineWidth(0.4)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetTemperatures(210, 60)
        gcode:SetBed(220, 220)
        gcode:SetStartGCodeFile(startPath)
        gcode:SetEndGCodeFile(endPath)
        return gcode
    end

    action WritesAPrintableFile
        // a printable file
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube.gcode")
        gcode:Write(ordered, path)
        Array<text> warnings = gcode:GetWarnings()
        output "no warnings: " + warnings:GetSize()
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        output "the header comes first: " + gcodeText:StartsWith(";Generated by ")
        output "the start G-code with its placeholders filled in: " + gcodeText:Contains("M190 S60" + lf + "M109 S210")
        output "the bed size placeholders: " + gcodeText:Contains("; bed 220.0 x 220.0")
        output "the end G-code: " + gcodeText:Contains("; test end" + lf + "M104 S0")
        output "relative extrusion: " + gcodeText:Contains("M83")
        output ";LAYER: comments: " + reader:GetLayerCount()
        output "layer 0 is printed at Z 0.2: " + Near(reader:GetLayerZ(0), 0.2, 0.0001)
        output "layer 1 at Z 0.4: " + Near(reader:GetLayerZ(1), 0.4, 0.0001)
        output "the last layer at Z 20: " + Near(reader:GetLayerZ(99), 20.0, 0.0001)
        output "numbers that aren't plain decimal text: " + reader:GetBadNumberCount()
        output "travels retract: " + (reader:GetRetractCount() > 0)
        output "the fan comes on: " + gcodeText:Contains("M106 S")
        output "feature comments: " + gcodeText:Contains(";TYPE:WALL-OUTER")
        // a 20 mm cube centred on a 220 mm bed: 100 to 120 mm on both axes
        output "left edge of the print: " + Near(reader:GetMinX(), 100, 0.5)
        output "right edge of the print: " + Near(reader:GetMaxX(), 120, 0.5)
        output "front edge of the print: " + Near(reader:GetMinY(), 100, 0.5)
        output "back edge of the print: " + Near(reader:GetMaxY(), 120, 0.5)
        output "GetFilamentLength matches the file: " + Near(gcode:GetFilamentLength(), reader:GetExtruded(), gcode:GetFilamentLength() * 0.001)
        output "the time estimate is filled in: " + (gcode:GetMoveSeconds() > 60)
    end

    action ExtrudesTheRightAmount
        // extrusion per millimetre
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube-ratio.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        // lineWidth * layerHeight / filament area = 0.4 * 0.2 / (pi * 0.875^2)
        number expected = 0.08 / (3.141592653589793 * 0.875 * 0.875)
        output "least filament per mm: " + Near(reader:GetMinRatio(), expected, expected * 0.02)
        output "most filament per mm: " + Near(reader:GetMaxRatio(), expected, expected * 0.02)
        // a 20 mm cube is 8000 mm^3; walls, skin and 20% infill use well under all of it
        number volume = gcode:GetFilamentLength() * 3.141592653589793 * 0.875 * 0.875
        output "the plastic used is plausible for a 20 mm cube: " + (volume > 1500 and volume < 8000)
    end

    action DryRun
        // dry run
        GcodeWriter gcode = Writer()
        gcode:SetDryRun(true, 20)
        text path = files:Path("gcode/cube-dry.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        output "no move extrudes: " + reader:GetPrintMoveCount()
        output "nothing retracts: " + reader:GetRetractCount()
        output "the first layer is traced 20 mm up: " + Near(reader:GetLayerZ(0), 20.2, 0.0001)
        output "the nozzle heater is off: " + gcodeText:Contains("M104 S0")
        output "it never waits for heat: " + (not gcodeText:Contains("M109"))
    end

    action BambuExtras
        // Bambu extras
        GcodeWriter gcode = Writer()
        gcode:SetBambuExtras(true)
        text path = files:Path("gcode/cube-bambu.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        output "the header block comes first: " + gcodeText:StartsWith("; HEADER_BLOCK_START")
        output "the layer count: " + gcodeText:Contains("; total layer number: 100")
        output "progress starts at 0%: " + gcodeText:Contains("M73 P0 R")
        output "the last layer change is reported: " + gcodeText:Contains("M991 S0 P99")
        output "the block is closed: " + gcodeText:Contains("; EXECUTABLE_BLOCK_END")
    end

    action TemplatesAndPlaceholders
        // missing templates and unknown placeholders
        files:Delete("gcode/created-start.gcode")
        GcodeWriter created = Writer()
        created:SetStartGCodeFile(files:Path("gcode/created-start.gcode"))
        created:Write(ordered, files:Path("gcode/cube-created.gcode"))
        output "a missing start file is created from the template: " + (files:Exists("gcode/created-start.gcode"))
        Array<text> createdWarnings = created:GetWarnings()
        output "and the user is told: " + createdWarnings:GetSize()

        text oddStart = files:Write("gcode/odd-start.gcode", "M109 S{NOT_A_PLACEHOLDER}")
        GcodeWriter odd = Writer()
        odd:SetStartGCodeFile(oddStart)
        odd:Write(ordered, files:Path("gcode/cube-odd.gcode"))
        Array<text> oddWarnings = odd:GetWarnings()
        output "an unknown placeholder is warned about: " + oddWarnings:GetSize()
        if oddWarnings:GetSize() = 1
            output "the warning quotes the line: " + oddWarnings:Get(0):Contains("NOT_A_PLACEHOLDER")
        end

        Array<Contour> nothing
        GcodeWriter empty = Writer()
        empty:Write(nothing, files:Path("gcode/empty.gcode"))
        Array<text> emptyWarnings = empty:GetWarnings()
        output "writing no paths is warned about: " + emptyWarnings:GetSize()
    end

    action BambuA1Placeholders
        // the Bambu A1 placeholders
        text a1Start = files:Write("gcode/a1-start.gcode", "M1002 set_filament_type:{FILAMENT_TYPE}" + lf
            + "M109 S{NOZZLE_TEMP_LESS_50}" + lf
            + "G0 X128 E8 F{LINE_FEED}" + lf
            + "G0 X133 E.3742 F{PRIME_FEED_SLOW}" + lf
            + "G0 X138 E.3742 F{PRIME_FEED}" + lf
            + "G1 E10 F{CALI_FEED}" + lf
            + "M983 F{CALI_FLOW} A0.3 H{NOZZLE_DIAMETER}")
        text a1End = files:Write("gcode/a1-end.gcode", "G1 X0 Y{FIRST_CENTER_Y} F18000" + lf
            + "; first layer centre x {FIRST_CENTER_X} mm" + lf
            + "G1 Z{PARK_Z_UP} F600" + lf
            + "G1 Z{PARK_Z_UP_BACK}")

        GcodeWriter gcode = Writer()
        gcode:SetFilamentType("petg")
        gcode:SetStartGCodeFile(a1Start)
        gcode:SetEndGCodeFile(a1End)
        text path = files:Path("gcode/cube-a1.gcode")
        gcode:Write(ordered, path)
        Array<text> warnings = gcode:GetWarnings()
        output "every A1 placeholder is known: " + warnings:GetSize()
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        output "{FILAMENT_TYPE}, upper case: " + gcodeText:Contains("M1002 set_filament_type:PETG")
        output "{NOZZLE_TEMP_LESS_50}: 210 - 50: " + gcodeText:Contains("M109 S160")
        // no SetMaxFlow, so the feeds use the default 12 mm^3/s
        output "{LINE_FEED}: 12 / 1.2 * 60: " + gcodeText:Contains("G0 X128 E8 F600.00")
        output "{PRIME_FEED_SLOW}: 12 / 0.15 / 4 * 60: " + gcodeText:Contains("G0 X133 E.3742 F1200.00")
        output "{PRIME_FEED}: 12 / 0.15 * 60: " + gcodeText:Contains("G0 X138 E.3742 F4800.00")
        output "{CALI_FEED}: 12 / 2.4 * 60: " + gcodeText:Contains("G1 E10 F300.00")
        output "{CALI_FLOW} and {NOZZLE_DIAMETER}: " + gcodeText:Contains("M983 F5.00 A0.3 H0.40")
        // the cube sits in the middle of the 220 mm bed
        output "{FIRST_CENTER_Y}: " + Near(NumberAfter(gcodeText, "G1 X0 Y", " F18000"), 110, 0.5)
        output "{FIRST_CENTER_X}: " + Near(NumberAfter(gcodeText, "; first layer centre x ", " mm"), 110, 0.5)
        // the 20 mm cube's top is at 20 mm: the gantry goes 100 mm above it, then down 2
        output "{PARK_Z_UP} and {PARK_Z_UP_BACK}: " + gcodeText:Contains("G1 Z120.00 F600" + lf + "G1 Z118.00")

        GcodeWriter capped = Writer()
        capped:SetStartGCodeFile(a1Start)
        capped:SetEndGCodeFile(a1End)
        capped:SetBedHeight(110)
        text cappedPath = files:Path("gcode/cube-a1-capped.gcode")
        capped:Write(ordered, cappedPath)
        GcodeReader cappedReader
        cappedReader:Read(cappedPath)
        text cappedText = cappedReader:GetText()
        output "the park stops at the top of the build volume and stays there: " + cappedText:Contains("G1 Z110.00 F600" + lf + "G1 Z110.00")
    end

    /* The number between the first 'before' and the next 'after', or -1. */
    action NumberAfter(text haystack, text before, text after) returns number
        integer start = haystack:IndexOf(before)
        if start < 0
            return -1.0
        end
        start = start + before:GetSize()
        integer stop = haystack:IndexOf(after, start)
        if stop < 0
            return -1.0
        end
        text value = haystack:GetSubtext(start, stop)
        return value:ParseNumber()
    end

    action RejectsBadSettings
        // bad settings are refused
        output "a layer height of 0: " + Refuses(0, 30)
        output "a travel speed of 0 (every travel would take forever): " + Refuses(0.2, 0)
        output "sensible values are accepted: " + (not Refuses(0.2, 150))
        boolean fan = false
        check
            GcodeWriter gcode
            gcode:SetFan(300, 1, 3)
        detect e is InvalidArgumentError
            fan = true
        end
        output "a fan speed above 255: " + fan
    end

    action Refuses(number layerHeight, number travelSpeed) returns boolean
        boolean refused = false
        check
            GcodeWriter gcode
            gcode:SetLayerHeight(layerHeight)
            gcode:SetTravelSpeed(travelSpeed)
        detect e is InvalidArgumentError
            refused = true
        end
        return refused
    end

    /* "true" if actual is within tolerance of expected, otherwise the actual value. */
    action Near(number actual, number expected, number tolerance) returns text
        number difference = actual - expected
        if difference < 0
            difference = -difference
        end
        if difference <= tolerance
            return "true"
        end
        return "" + actual
    end

end
