use Libraries.Interface.Controls.Support.SpreadsheetFile
use Libraries.Interface.Controls.Support.SpreadsheetRow
use Libraries.Containers.Array

/*
    Reads CSV text and writes it back, and says whether the text is the same,
    for the cases the spreadsheet must keep exactly. Then changes one value,
    and reads a file that isn't valid CSV.
*/
class Main
    text quote = ""
    text lineFeed = ""
    text carriageReturn = ""

    action Main
        quote = quote:GetDoubleQuote()
        lineFeed = lineFeed:GetLineFeed()
        carriageReturn = carriageReturn:GetCarriageReturn()
        text crlf = carriageReturn + lineFeed
        text mark = ""
        mark = mark:GetUnicodeValue(65279)

        Check("Line feeds", "Name,Year" + lineFeed + "Ada,1815" + lineFeed)
        Check("Carriage returns and line feeds", "Name,Year" + crlf + "Ada,1815" + crlf)
        Check("No line break at the end", "Name,Year" + lineFeed + "Ada,1815")
        Check("Byte order mark", mark + "Name,Year" + lineFeed + "Ada,1815" + lineFeed)
        Check("Empty", "")
        Check("Header only", "Name,Year" + lineFeed)
        Check("Quoted comma", "City" + lineFeed + quote + "Las Vegas, NV" + quote + lineFeed)
        Check("Quoted line break", "Note" + lineFeed + quote + "two" + lineFeed + "lines" + quote + lineFeed)
        Check("Doubled quotes", "Note" + lineFeed + quote + "say " + quote + quote + "hi" + quote + quote + quote + lineFeed)
        Check("Ragged rows", "a,b,c" + lineFeed + "d" + lineFeed + "e,f,g,h" + lineFeed)
        Check("Empty lines", "a" + lineFeed + lineFeed + "b" + lineFeed)
        Check("Spaces", "  a  , b " + lineFeed)
        Check("Equals sign", "=SUM(A1:A2),=1+1" + lineFeed)
        Check("Empty values", ",," + lineFeed + "," + lineFeed)
        Check("Quoted plain value", quote + "plain" + quote + ",x" + lineFeed)

        // Changing one value changes only that value's text.
        SpreadsheetFile csv
        Array<SpreadsheetRow> rows = csv:Read(quote + "a" + quote + ",b,c" + crlf + "d,e,f" + crlf)
        SpreadsheetRow second = rows:Get(1)
        second:SetValue(1, "x, y")
        text expected = quote + "a" + quote + ",b,c" + crlf + "d," + quote + "x, y" + quote + ",f" + crlf
        output "One change: " + (csv:Write(rows) = expected)

        // A quote that never closes: one problem, and saving closes it.
        SpreadsheetFile broken
        Array<SpreadsheetRow> brokenRows = broken:Read("a,b" + lineFeed + "c," + quote + "d" + lineFeed)
        output "Problems: " + broken:GetProblems():GetSize()
        text corrected = "a,b" + lineFeed + "c," + quote + "d" + lineFeed + quote
        output "Corrected: " + (broken:Write(brokenRows) = corrected)
    end

    action Check(text name, text contents)
        SpreadsheetFile csv
        Array<SpreadsheetRow> rows = csv:Read(contents)
        output name + ": " + (csv:Write(rows) = contents)
    end
end
