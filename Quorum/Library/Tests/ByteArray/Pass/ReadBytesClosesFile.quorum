use Libraries.System.File
use Libraries.System.BinaryFileReader
use Libraries.Containers.ByteArray

// a file that is still open can't be deleted on windows
// so this program checks that ReadBytes closes the file it read
File file
file:SetPath("ReadBytesClosesFile.bin")
file:Write("Lucas")

BinaryFileReader reader
reader:OpenForRead(file)
ByteArray bytes = reader:ReadBytes()
boolean deleted = file:Delete()
if bytes:GetSize() = 5 and deleted
    output "success"
else
    output "fail"
end