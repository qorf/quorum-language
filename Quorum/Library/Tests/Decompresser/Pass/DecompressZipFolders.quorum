use Libraries.System.File
use Libraries.Data.Compression.Decompresser

class Main
    action Main
        File inputFile
        inputFile:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
        inputFile:SetPath("zipfolders.zip")
        
        Decompresser decompress
        decompress:DecompressZip(inputFile)
        
        File outputFile
        outputFile:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
        outputFile:SetPath("folder/input.txt")
        text result = "fail"
        if outputFile:Exists()
            if outputFile:Read():Trim() = "inside a folder"
                result = "success"
            end
        end
        output result
        
        File folder
        folder:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
        folder:SetPath("folder")
        folder:Delete(true)
    end
end