use Libraries.System.File
use Libraries.Data.Compression.Decompressor

File inputFile
inputFile:SetWorkingDirectory("../../Library/Tests/Decompressor/Resources/")
inputFile:SetPath("folders.zip")

Decompressor decompress
decompress:DecompressZip(inputFile)

File outputFile
outputFile:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
outputFile:SetPath("folder/inner.txt")
text result = "fail"
if outputFile:Exists()
    if outputFile:Read() = "inside a folder"
        result = "success"
    end
end
output result

File folder
folder:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
folder:SetPath("folder")
folder:Delete(true)
