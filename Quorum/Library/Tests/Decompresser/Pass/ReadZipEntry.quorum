use Libraries.System.File
use Libraries.Data.Compression.Decompresser

File inputFile
inputFile:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
inputFile:SetPath("zipfile.zip")

File folders
folders:SetWorkingDirectory("../../Library/Tests/Decompresser/Resources/")
folders:SetPath("zipfolders.zip")

Decompresser decompress
output decompress:ReadZipEntry(inputFile, "zipfile.txt")
output decompress:ReadZipEntry(folders, "folder/input.txt")
