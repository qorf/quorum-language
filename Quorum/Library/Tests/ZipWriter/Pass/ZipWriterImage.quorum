use Libraries.System.File
use Libraries.Data.Compression.ZipWriter
use Libraries.Data.Compression.Decompresser

ZipWriter zip
zip:Open("ZipWriterImage.zip")
zip:BeginImage(4, 3)
zip:SetPixel(1, 2, 255, 0, 0, 255)
zip:SetPixel(9, 9, 0, 0, 0, 255)
zip:AddImage("Metadata/thumbnail.png")
zip:AddCopy("copy.png", "Metadata/thumbnail.png")
zip:Close()

File archive
archive:SetPath("ZipWriterImage.zip")
Decompresser decompress
output decompress:HasZipEntry(archive, "Metadata/thumbnail.png")
output decompress:HasZipEntry(archive, "copy.png")
