package Libraries.Language.Compile.Documentation

use Libraries.Containers.Array
use Libraries.Language.Compile.Translate.ClassOpcode
use Libraries.Web.Page.Footer
use Libraries.Containers.Iterator
use Libraries.Web.Page.WebPage
use Libraries.System.File
use Libraries.Web.Page.MetaData
use Libraries.Containers.HashTable
use Libraries.Language.Compile.Symbol.SymbolTable
use Libraries.Language.Compile.Symbol.Class
use Libraries.Language.Compile.Library
use Libraries.Language.Compile.Compiler
use Libraries.Web.Page.Section
use Libraries.Web.Page.Heading
use Libraries.Web.Quorum.QuorumSite
use Libraries.Web.Quorum.QuorumSiteOptions

class DocumentationGenerator 
    File runFolder = undefined
    constant text DOCUMENTATION_FOLDER = "Documents/"
    boolean isBuildingStandardLibrary = false
    boolean isBuildingSourceFiles = true

    // The standard library's pages in the website's look (Write(Library)):
    // the index, a page for each package and each class, framed as the
    // website frames its pages (QuorumSite), with a stylesheet of their
    // own, so the website's isn't replaced when they are copied into it.
    constant text LIBRARY_STYLE_SHEET = "style/library.css"
    // Where the frame's icons are read from, from the folder this runs in
    // (SetIconFolder). With none, the frame uses the icons below, the
    // website's own, written out here so the pages need no files.
    text iconFolder = ""
