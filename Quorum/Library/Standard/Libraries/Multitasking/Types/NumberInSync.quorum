package Libraries.Multitasking.Types

use Libraries.Multitasking.Key

/*
The NumberInSync class holds one number that tasks on different lines may use at the
same time. Each action is one step: no other line can change the value in
the middle of it. Use it to add up amounts across lines: Add never loses an update, unlike getting the value, adding, and setting it back.

Attribute: Example

use Libraries.Multitasking.Types.NumberInSync
class Main
    action Main
        NumberInSync common
        common:Set(2.5)
        output common:Get()
    end
end
*/
class NumberInSync
    number value = 0
    Key valueKey

    /*
        This action gets the value.

        Attribute: Returns The value.

        Attribute: Example
        use Libraries.Multitasking.Types.NumberInSync

        NumberInSync common
        number current = common:Get()
    */
    action Get returns number
        valueKey:Take()
        number result = value
        valueKey:Return()
        return result
    end

    /*
        This action sets the value.

        Attribute: Parameter value The new value.

        Attribute: Example
        use Libraries.Multitasking.Types.NumberInSync

        NumberInSync common
        common:Set(2.5)
    */
    action Set(number value)
        valueKey:Take()
        me:value = value
        valueKey:Return()
    end

    /*
        This action adds an amount to the value, as one step, and returns
        the new value. Several lines adding at once never lose an addition.

        Attribute: Parameter amount How much to add; may be negative.

        Attribute: Returns The value after adding.

        Attribute: Example
        use Libraries.Multitasking.Types.NumberInSync

        NumberInSync total
        total:Add(5)
        number current = total:Add(2)
    */
    action Add(number amount) returns number
        valueKey:Take()
        value = value + amount
        number result = value
        valueKey:Return()
        return result
    end

    /*
        This action adds one to the value, as one step, and returns the new
        value.

        Attribute: Returns The value after adding one.

        Attribute: Example
        use Libraries.Multitasking.Types.NumberInSync

        NumberInSync count
        count:Increase()
    */
    action Increase returns number
        return Add(1)
    end

    /*
        This action takes one from the value, as one step, and returns the
        new value.

        Attribute: Returns The value after taking one away.

        Attribute: Example
        use Libraries.Multitasking.Types.NumberInSync

        NumberInSync count
        count:Decrease()
    */
    action Decrease returns number
        return Add(-1)
    end
end
