        productButton:SetPadding(constants:SPACING_2, constants:SPACING_12)
        productButton:SetWidthPercent(100)
        productButton:SetTextStyle(productButtonWords)
        productLink:SetBold(true)
        productLink:SetUnderline(true)
        productLink:SetColor(quorumBlue150)
        productPictureWide:SetWidthPercent(66)
        featureCardWords:SetColor(white)
        featureCard:SetBackground(black)
        featureCard:SetRoundedCorners(constants:SPACING_2)
        featureCard:SetShadow(true)
        featureCard:SetClipContent(true)
        featureCard:SetTextStyle(featureCardWords)
        featureCardHeading:SetFontSize(constants:EXTRA_LARGE_FONT_SIZE)
        featureCardHeading:SetLineHeight(constants:EXTRA_LARGE_LINE_HEIGHT)
        featureCardHeading:SetBold(true)
        featureCardHeading:SetColor(white)
        featureCardText:SetPadding(constants:SPACING_4, constants:SPACING_4)
        featureCardTextWide:SetWidthPercent(25)
        featureCardTextWide:SetPadding(constants:SPACING_4, constants:SPACING_6)
        featureCardPicture:SetPadding(constants:SPACING_6, constants:SPACING_6)
        featureCardPictureWide:SetWidthPercent(75)
        featureCardPictureWide:SetPadding(constants:SPACING_6, constants:SPACING_6)
        greyCardBody:SetBackground(grey25)
        greyCardBody:SetPadding(constants:SPACING_4, constants:SPACING_4)
        greyCardBody:SetGrow(true)

        courseCards:SetGap(constants:SPACING_4)
        courseCards:SetSmallestColumnWidth(constants:SPACING_60)
        courseCard:SetBackground(white)
        courseCard:SetBorder(constants:SPACING_PIXEL, grey25)
        courseCard:SetRoundedCorners(constants:SPACING_2)
        courseCard:SetClipContent(true)
        courseCardPicture:SetWidthPercent(100)
        courseCardBody:SetPadding(constants:SPACING_3, constants:SPACING_4)
        courseCardLayout:SetGap(constants:SPACING_2)

        choices:SetGap(constants:SPACING_2_5)
        choices:SetSmallestColumnWidth(constants:SPACING_40)
        choiceWords:SetBold(true)
        choiceWords:SetUnderline(false)
        choiceWords:SetColor(white)
        choiceTile:SetBackground(quorumBlue150)
        choiceTile:SetRoundedCorners(constants:SPACING_3)
        choiceTile:SetPadding(constants:SPACING_4, constants:SPACING_4)
        choiceTile:SetTextStyle(choiceWords)
        choiceWordsActive:SetColor(white)
        choiceTileActive:SetBackground(grey95)
        choiceTileActive:SetTextStyle(choiceWordsActive)
        choiceTileLayout:SetGap(constants:SPACING_2)
        choiceTileLayout:SetCenteredHorizontally(true)
        choiceTileLayout:SetCenteredVertically(true)
        unitWords:SetGrow(true)
        unitWords:SetShrinkBelowContent(true)
        unitLayout:SetGap(constants:SPACING_4)
        unitLayout:SetAlignedTop(true)
        unitLessonsWords:SetBold(true)
        unitLessonsWords:SetColor(quorumBlue150)
        unitLessonsLabel:SetPadding(constants:SPACING_1, constants:SPACING_0)
        unitLessonsLabel:SetTextStyle(unitLessonsWords)

        // Standards (design 2): white cards with a dark blue bar on top,
        // side by side when there's room.
        standardsLabel = upNextLabel:Copy()
        standardsGrid:SetGap(constants:SPACING_2_5)
        standardsGrid:SetSmallestColumnWidth(constants:SPACING_56)
        standardCard:SetBackground(white)
        standardCard:SetTopBorder(constants:SPACING_1, quorumBlue150)
        standardCard:SetRoundedBottom(constants:SPACING_2)
        standardCard:SetPadding(constants:SPACING_3, constants:SPACING_4)
        card:SetBackground(white)
        card:SetBorder(constants:SPACING_PIXEL, grey25)
        card:SetRoundedCorners(constants:SPACING_2)
        card:SetPadding(constants:SPACING_4, constants:SPACING_6)
        standardCode:SetBold(true)
        standardCode:SetUnderline(false)
        standardCode:SetColor(quorumBlue150)
        standardDetails:SetFontSize(constants:SMALL_FONT_SIZE)
        standardDetails:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        standardDetails:SetColor(grey50)
        standardWords:SetFontSize(constants:SMALL_FONT_SIZE)
        standardWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        standardsLink:SetFontSize(constants:SMALL_FONT_SIZE)
        standardsLink:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        standardsLink:SetBold(true)
        standardsLink:SetUnderline(false)
        standardsLink:SetColor(quorumBlue150)

        // The standards report (design 1). Tiles: white, rounded, a small
        // grey label in capitals over a large bold number.
        WebBoxStyle reportTile = standardsReport:GetTile()
        reportTile:SetBackground(white)
        reportTile:SetRoundedCorners(constants:SPACING_2)
        reportTile:SetPadding(constants:SPACING_2_5, constants:SPACING_3_5)
        WebTextStyle reportTileLabel = standardsReport:GetTileLabel()
        reportTileLabel:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        reportTileLabel:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        reportTileLabel:SetUppercase(true)
        reportTileLabel:SetBold(true)
        reportTileLabel:SetColor(grey50)
        WebTextStyle reportTileNumber = standardsReport:GetTileNumber()
        reportTileNumber:SetFontSize(constants:EXTRA_LARGE_2_FONT_SIZE)
        reportTileNumber:SetLineHeight(constants:EXTRA_LARGE_2_LINE_HEIGHT)
        reportTileNumber:SetBold(true)
        WebTextStyle reportOutOf = standardsReport:GetTileOutOf()
        reportOutOf:SetFontSize(constants:SMALL_FONT_SIZE)
        reportOutOf:SetBold(false)
        reportOutOf:SetColor(grey50)
        WebTextStyle reportLabel = standardsReport:GetSectionLabel()
        reportLabel:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        reportLabel:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        reportLabel:SetUppercase(true)
        reportLabel:SetBold(true)
        reportLabel:SetColor(grey50)
        // The map's caption looks like the other labels.
        WebTextStyle reportCaptionWords = reportLabel:Copy()
        reportCaptionWords:AlignLeft()
        standardsReport:GetMapCaption():SetTextStyle(reportCaptionWords)

        // The map: small text, white cells with a little space between
        // them, light blue where there are lessons.
        standardsReport:GetMap():SetSharedBorders(false)
        WebTextStyle mapWords
        mapWords:SetFontSize(constants:SMALL_FONT_SIZE)
        mapWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        mapWords:AlignLeft()
        WebTextStyle mapNameWords = mapWords:Copy()
        mapNameWords:SetBold(true)
        standardsReport:GetMapName():SetTextStyle(mapNameWords)
        WebBoxStyle reportMapCell = standardsReport:GetMapCell()
        reportMapCell:SetBackground(white)
        reportMapCell:SetRoundedCorners(constants:SPACING_1)
        reportMapCell:SetTextStyle(mapWords)
        WebBoxStyle reportCoveredCell = standardsReport:GetCoveredMapCell()
        reportCoveredCell:SetBackground(quorumBlue25)
        reportCoveredCell:SetRoundedCorners(constants:SPACING_1)
        reportCoveredCell:SetTextStyle(mapNameWords:Copy())
        WebTextStyle reportMapLink = standardsReport:GetMapLink()
        reportMapLink:SetColor(quorumBlue150)
        reportMapLink:SetUnderline(true)

        // Specialties: white chips with a pale blue edge; dark blue edge
        // and bold where there are lessons.
        WebTextStyle chipWords
        chipWords:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        chipWords:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        chipWords:SetColor(quorumBlue150)
        chipWords:SetUnderline(true)
        WebBoxStyle chip = standardsReport:GetOtherGroup()
        chip:SetBackground(white)
        chip:SetBorder(constants:SPACING_PIXEL, quorumBlue25)
        chip:SetRoundedCorners(constants:SPACING_96)
        chip:SetTextStyle(chipWords)
        WebBoxStyle coveredChip = standardsReport:GetCoveredOtherGroup()
        coveredChip:SetBackground(white)
        coveredChip:SetBorder(constants:SPACING_PIXEL, quorumBlue150)
        coveredChip:SetRoundedCorners(constants:SPACING_96)
        WebTextStyle coveredChipWords = chipWords:Copy()
        coveredChipWords:SetBold(true)
        coveredChip:SetTextStyle(coveredChipWords)

        // Cards, as on the lessons: white with a dark blue bar on top when
        // a lesson covers the standard, a grey bar when none does yet.
        WebBoxStyle reportCovered = standardsReport:GetCoveredCard()
        reportCovered:SetBackground(white)
        reportCovered:SetTopBorder(constants:SPACING_1, quorumBlue150)
        reportCovered:SetRoundedBottom(constants:SPACING_2)
        reportCovered:SetPadding(constants:SPACING_2_5, constants:SPACING_3_5)
        WebBoxStyle reportUncovered = standardsReport:GetUncoveredCard()
        reportUncovered:SetBackground(white)
        reportUncovered:SetTopBorder(constants:SPACING_1, grey25)
        reportUncovered:SetRoundedBottom(constants:SPACING_2)
        reportUncovered:SetPadding(constants:SPACING_2_5, constants:SPACING_3_5)
        WebTextStyle reportCardDetails = standardsReport:GetCardDetails()
        reportCardDetails:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        reportCardDetails:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        reportCardDetails:SetColor(grey50)
        WebTextStyle reportCardWords = standardsReport:GetCardWords()
        reportCardWords:SetFontSize(constants:SMALL_FONT_SIZE)
        reportCardWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)

        // Lesson made every bold word <strong>, which Tailwind's reset
        // shows as "font-weight: bolder". Terms keep that look: bold, not
        // italic.
        WebTextStyle terms = GetTerm()
        terms:SetBold(true)
        terms:SetItalic(false)
        GetStrong():SetBold(true)

        // Variables (x, y, z) were bold words too: bold, not italic.
        WebTextStyle variables = GetVariable()
        variables:SetBold(true)
        variables:SetItalic(false)

        // Program output ("Placed") was plain text: keep the page's own
        // font instead of the reset's code font.
        GetOutput():UseSurroundingFont()

        // Lesson's headings, all bold: "text-3xl" for level 1 down to
        // "text-sm" for level 6.
        SetHeading(1, constants:EXTRA_LARGE_3_FONT_SIZE, constants:EXTRA_LARGE_3_LINE_HEIGHT)
        SetHeading(2, constants:EXTRA_LARGE_2_FONT_SIZE, constants:EXTRA_LARGE_2_LINE_HEIGHT)
        SetHeading(3, constants:EXTRA_LARGE_FONT_SIZE, constants:EXTRA_LARGE_LINE_HEIGHT)
        SetHeading(4, constants:LARGE_FONT_SIZE, constants:LARGE_LINE_HEIGHT)
        SetHeading(5, constants:BASE_FONT_SIZE, constants:BASE_LINE_HEIGHT)
        SetHeading(6, constants:SMALL_FONT_SIZE, constants:SMALL_LINE_HEIGHT)

        SetBlockEditorLooks()
        SetFormLooks()
        SetProblemLooks()
        SetProjectsLooks()
    end

    // A reader's projects table (ProfilePage).
    private action SetProjectsLooks
        projectsCount:SetColor(grey65)
        projectsCount:SetFontSize(constants:SMALL_FONT_SIZE)
        projectsCount:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        projectsTableBox:SetScrollSideways(true)

        projectsTable:SetFullWidth(true)
        projectsTable:SetSharedBorders(false)
        projectsTable:RemoveCellSpacing()
        WebBoxStyle card
        card:SetBackground(white)
        card:SetBorder(constants:SPACING_PIXEL, grey25)
        card:SetRoundedCorners(constants:SPACING_3)
        card:SetClipContent(true)
        projectsTable:SetBox(card)

        WebTextStyle headerWords
        headerWords:SetColor(quorumBlue150)
        headerWords:SetFontSize(constants:SMALL_FONT_SIZE)
        headerWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        headerWords:SetBold(true)
        headerWords:AlignLeft()
        projectsHeader:SetBackground(quorumBlue10)
        projectsHeader:SetPadding(constants:SPACING_2_5, constants:SPACING_4)
        projectsHeader:SetTextStyle(headerWords)

        WebTextStyle cellWords
        cellWords:AlignLeft()
        cellWords:SetFontSize(constants:SMALL_FONT_SIZE)
        cellWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        projectsCell:SetBackground(white)
        projectsCell:SetTopBorder(constants:SPACING_PIXEL, grey25)
        projectsCell:SetPadding(constants:SPACING_3, constants:SPACING_4)
        projectsCell:SetTextStyle(cellWords)
        WebTextStyle nameWords = cellWords:Copy()
        nameWords:SetBold(true)
        nameWords:SetBreakLongWords(true)
        projectsNameCell:SetBackground(white)
        projectsNameCell:SetTopBorder(constants:SPACING_PIXEL, grey25)
        projectsNameCell:SetPadding(constants:SPACING_3, constants:SPACING_4)
        projectsNameCell:SetTextStyle(nameWords)

        WebColor red
        red:SetColor(185, 28, 28)
        WebTextStyle deleteWords
        deleteWords:SetUnderline(true)
        deleteWords:SetColor(red)
        projectsDelete:SetTextStyle(deleteWords)
        // The table's caption is for screen readers; the page's title says it.
        projectsCaption:SetVisuallyHidden(true)

        projectsTitleRow:SetSpreadOut(true)
        projectsTitleRow:SetCenteredVertically(true)
        projectsTitleRow:SetWrap(true)
        projectsTitleRow:SetGap(constants:SPACING_4)
        projectsHeaderEnd = projectsHeader:Copy()
        WebTextStyle headerEndWords = projectsHeaderEnd:GetTextStyle():Copy()
        headerEndWords:AlignRight()
        projectsHeaderEnd:SetTextStyle(headerEndWords)
        projectsActions:SetAtEnd(true)
        projectsActions:SetCenteredVertically(true)
        projectsActions:SetGap(constants:SPACING_4)

        switchInput:SetVisuallyHidden(true)
        switchTrack:SetInline(true)
        switchTrack:SetAnchor(true)
        switchTrack:SetWidth(constants:SPACING_8)
        switchTrack:SetHeight(constants:SPACING_5)
        switchTrack:SetRoundedCorners(constants:SPACING_2_5)
        switchTrack:SetBackground(grey40)
        switchTrack:SetShrink(false)
        switchTrackOn:SetBackground(quorumBlue150)
        switchTrackFocus:SetOutline(constants:SPACING_0_5, quorumBlue150)
        switchTrackFocus:SetOutlineOffset(constants:SPACING_0_5)
        switchKnob:SetFloating(true)
        switchKnob:SetTopOffset(constants:SPACING_0_5)
        switchKnob:SetLeftOffset(constants:SPACING_0_5)
        switchKnob:SetWidth(constants:SPACING_4)
        switchKnob:SetHeight(constants:SPACING_4)
        switchKnob:SetRoundedCorners(constants:SPACING_2)
        switchKnob:SetBackground(white)
        switchKnobOn:SetLeftOffset(constants:SPACING_3_5)
    end

    // The practice problems' steps, buttons and hint ("flex flex-wrap
    // items-center p-3 gap-4 text-sm font-medium text-gray-500 bg-white
    // rounded-lg border border-slate-600 shadow-md sm:p-4 sm:text-base";
    // each step "w-5 h-5 text-xs border border-quorum-blue-100
    // rounded-full", the current "bg-neutral-black text-neutral-white").
    private action SetProblemLooks
        WebTextStyle stepsWords
        stepsWords:SetFontSize(constants:SMALL_FONT_SIZE)
        stepsWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        stepsWords:SetWeight(constants:MEDIUM_FONT_WEIGHT)
        stepsWords:SetColor(grey50)
        steps:SetBackground(white)
        steps:SetBorder(constants:SPACING_PIXEL, grey50)
        steps:SetRoundedCorners(constants:SPACING_2)
        steps:SetShadowDepth(steps:MEDIUM_SHADOW)
        steps:SetPadding(constants:SPACING_3, constants:SPACING_3)
        steps:SetTextStyle(stepsWords)
        stepsWide:SetPadding(constants:SPACING_4, constants:SPACING_4)
        stepsRow:SetWrap(true)
        stepsRow:SetCenteredVertically(true)
        stepsRow:SetGap(constants:SPACING_4)
        stepItem:SetCenteredVertically(true)
        stepItem:SetGap(constants:SPACING_2)
        WebTextStyle stepWords
        stepWords:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        stepWords:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        stepWords:SetUnderline(false)
        step:SetWidth(constants:SPACING_5)
        step:SetHeight(constants:SPACING_5)
        step:SetRoundedCorners(constants:SPACING_5)
        step:SetBorder(constants:SPACING_PIXEL, quorumBlue100)
        step:SetShrink(false)
        step:SetTextStyle(stepWords)
        stepLayout:SetCenteredVertically(true)
        stepLayout:SetCenteredHorizontally(true)
        WebTextStyle currentWords
        currentWords:SetColor(white)
        stepCurrent:SetBackground(black)
        stepCurrent:SetBorder(constants:SPACING_PIXEL, black)
        stepCurrent:SetTextStyle(currentWords)

        // "flex justify-between items-center w-full p-4"; each button
        // "py-2.5 px-4 text-center rounded-2xl w-36 text-sm font-bold
        // bg-quorum-blue-50", while unavailable "bg-neutral-grey-25
        // opacity-50 cursor-not-allowed".
        problemButtons:SetSpreadOut(true)
        problemButtons:SetCenteredVertically(true)
        problemButtons:SetWrap(true)
        problemButtons:SetGap(constants:SPACING_2)
        problemButtonsBox:SetPadding(constants:SPACING_4, constants:SPACING_4)
        WebTextStyle buttonWords
        buttonWords:SetFontSize(constants:SMALL_FONT_SIZE)
        buttonWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        buttonWords:SetBold(true)
        buttonWords:SetColor(textColor)
        buttonWords:SetUnderline(false)
        buttonWords:AlignCenter()
        problemButton:SetPadding(constants:SPACING_2_5, constants:SPACING_4)
        problemButton:SetRoundedCorners(constants:SPACING_4)
        problemButton:SetWidth(constants:SPACING_36)
        problemButton:SetBackground(quorumBlue50)
        problemButton:SetDisplayed(true)
        problemButton:SetTextStyle(buttonWords)
        problemButtonUnavailable:SetBackground(grey25)
        problemButtonUnavailable:SetOpacityPercent(50)
        problemButtonUnavailable:SetShowsUnavailable(true)

        numberedRows:SetBackground(white)
        numberedRows:SetBorder(constants:SPACING_PIXEL, grey25)
        numberedRows:SetRoundedCorners(constants:SPACING_3)
        numberedRows:SetClipContent(true)
        numberedRow:SetPadding(constants:SPACING_2_5, constants:SPACING_4)
        numberedRow:SetTopBorder(constants:SPACING_PIXEL, grey25)
        numberedRowFirst:SetTopBorder(constants:SPACING_0, white)
        numberedRowLayout:SetCenteredVertically(true)
        numberedRowLayout:SetGap(constants:SPACING_3)
        numberedRowTitle:SetBold(true)
        numberedRowTitle:SetColor(textColor)
        numberedRowTitleBox:SetGrow(true)
        numberedRowTitleBox:SetShrinkBelowContent(true)
        numberedRowTitleBox:SetTextStyle(numberedRowTitle)
        WebTextStyle linkWords
        linkWords:SetBold(true)
        linkWords:SetFontSize(constants:SMALL_FONT_SIZE)
        linkWords:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        linkWords:SetColor(black)
        linkWords:SetUnderline(false)
        numberedRowLink:SetBackground(quorumBlue50)
        numberedRowLink:SetRoundedCorners(constants:SPACING_4)
        numberedRowLink:SetPadding(constants:SPACING_1_5, constants:SPACING_4)
        numberedRowLink:SetShrink(false)
        numberedRowLink:SetTextStyle(linkWords)
        numberedRowLinkHover:SetBackground(quorumBlue25)

        // "rounded-t-lg bg-quorum-blue-150 px-6 py-2 font-bold
        // text-neutral-white" over "rounded-b-lg bg-neutral-white px-6 py-2".
        WebTextStyle hintWords
        hintWords:SetBold(true)
        hintWords:SetColor(white)
        hintHeading:SetBackground(quorumBlue150)
        hintHeading:SetPadding(constants:SPACING_2, constants:SPACING_6)
        hintHeading:SetRoundedTop(constants:SPACING_2)
        hintHeading:SetTextStyle(hintWords)
        hintBody:SetBackground(white)
        hintBody:SetPadding(constants:SPACING_2, constants:SPACING_6)
        hintBody:SetRoundedBottom(constants:SPACING_2)
    end

    // The forms' colors, edges and words, on the structure FormLooks sets.
    private action SetFormLooks
        WebColor right
        right:SetColor(21, 128, 61)
        WebColor wrong
        wrong:SetColor(185, 28, 28)

        WebTextStyle label = forms:GetLabel()
        label:SetSemibold(true)
        forms:GetLabelBox():SetTextStyle(label)
        WebBoxStyle entry = forms:GetEntry()
        entry:SetPadding(constants:SPACING_2, constants:SPACING_2)
        entry:SetRoundedCorners(constants:SPACING_1_5)
        entry:SetBorder(constants:SPACING_PIXEL, grey50)
        entry:SetBackground(white)
        WebBoxStyle entryFocus = forms:GetEntryFocus()
        entryFocus:SetOutline(constants:SPACING_0_5, quorumBlue150)
        entryFocus:SetOutlineOffset(constants:SPACING_0_5)
        forms:GetEntryWrong():SetBorder(constants:SPACING_0_5, wrong)
        forms:GetEntryRight():SetBorder(constants:SPACING_0_5, right)

        // "py-2 px-10 w-fit bg-quorum-blue-100 font-bold rounded-2xl",
        // with a large shadow under the pointer ("hover:shadow-lg").
        WebTextStyle buttonWords
        buttonWords:SetBold(true)
        buttonWords:SetColor(black)
        WebBoxStyle button = forms:GetButton()
        button:SetPadding(constants:SPACING_2, constants:SPACING_10)
        button:SetRoundedCorners(constants:SPACING_4)
        button:SetBackground(quorumBlue100)
        button:SetFitToContent(true)
        button:SetTextStyle(buttonWords)
        WebBoxStyle buttonHover = forms:GetButtonHover()
        buttonHover:SetShadowDepth(buttonHover:LARGE_SHADOW)
        WebBoxStyle buttonFocus = forms:GetButtonFocus()
        buttonFocus:SetOutline(constants:SPACING_0_5, quorumBlue150)
        buttonFocus:SetOutlineOffset(constants:SPACING_0_5)

        // As the sign-in dialog's messages: green, rose and light blue,
        // with black words.
        WebColor green
        green:SetColor(210, 232, 222)
        WebColor rose
        rose:SetColor(231, 179, 176)
        WebTextStyle messageWords
        messageWords:SetColor(black)
        SetMessage(forms:GetProblem(), rose, messageWords)
        SetMessage(forms:GetFeedback(), quorumBlue25, messageWords)
        SetMessage(forms:GetSuccess(), green, messageWords)
        WebTextStyle messageHeading = forms:GetMessageHeading()
        messageHeading:SetBold(true)
        messageHeading:SetFontSize(constants:EXTRA_LARGE_FONT_SIZE)
        messageHeading:SetLineHeight(constants:EXTRA_LARGE_LINE_HEIGHT)
        WebTextStyle messageText = forms:GetMessageWords()
        messageText:SetFontSize(constants:SMALL_FONT_SIZE)
        messageText:SetLineHeight(constants:SMALL_LINE_HEIGHT)

        // A quiz: "text-lg font-semibold text-gray-700" questions (in the
        // site's dark grey, 10.4 to 1), "text-sm mt-1" lines under them,
        // and a "text-lg font-semibold" result.
        WebTextStyle question = forms:GetQuestion()
        question:SetFontSize(constants:LARGE_FONT_SIZE)
        question:SetLineHeight(constants:LARGE_LINE_HEIGHT)
        question:SetSemibold(true)
        question:SetColor(grey65)
        WebTextStyle answerLine = forms:GetAnswerLine()
        answerLine:SetFontSize(constants:SMALL_FONT_SIZE)
        answerLine:SetLineHeight(constants:SMALL_LINE_HEIGHT)
        WebTextStyle resultWords
        resultWords:SetFontSize(constants:LARGE_FONT_SIZE)
        resultWords:SetLineHeight(constants:LARGE_LINE_HEIGHT)
        resultWords:SetSemibold(true)
        forms:GetResult():SetTextStyle(resultWords)
        WebTextStyle rightWords = forms:GetRight()
        rightWords:SetColor(right)
        WebTextStyle wrongWords = forms:GetWrong()
        wrongWords:SetColor(wrong)
        AddScriptClass("quiz-right", rightWords)
        AddScriptClass("quiz-wrong", wrongWords)

        // Link-like buttons ("underline"), in the links' dark blue.
        WebTextStyle linkButtonWords
        linkButtonWords:SetUnderline(true)
        linkButtonWords:SetColor(quorumBlue150)
        forms:GetLinkButton():SetTextStyle(linkButtonWords)

        // "disabled:opacity-50 disabled:cursor-not-allowed".
        WebBoxStyle buttonDisabled = forms:GetButtonDisabled()
        buttonDisabled:SetOpacityPercent(50)
        buttonDisabled:SetShowsUnavailable(true)

        // Dialogs, as the sign-in dialog: "bg-modal-black-50" behind,
        // "p-10 bg-neutral-white rounded-2xl shadow-lg flex flex-col gap-6"
        // in front, a "text-3xl font-bold" title, and a close button
        // "text-3xl font-bold text-quorum-blue-100 hover:text-quorum-blue-150"
        // (blue 150 throughout here: blue 100 is 3.1 to 1 on white).
        WebColor shade
        shade:SetColor(0, 0, 0)
        shade:SetOpacity(0.5)
        forms:GetBackdrop():SetBackground(shade)
        WebBoxStyle dialog = forms:GetDialog()
        dialog:SetPadding(constants:SPACING_10, constants:SPACING_10)
        dialog:SetBackground(white)
        dialog:SetRoundedCorners(constants:SPACING_4)
        dialog:SetShadowDepth(dialog:LARGE_SHADOW)
        forms:GetDialogLayout():SetGap(constants:SPACING_6)
        WebTextStyle dialogTitle = forms:GetDialogTitle()
        dialogTitle:SetBold(true)
        dialogTitle:SetFontSize(constants:EXTRA_LARGE_3_FONT_SIZE)
        dialogTitle:SetLineHeight(constants:EXTRA_LARGE_3_LINE_HEIGHT)
        WebTextStyle closeWords
        closeWords:SetColor(quorumBlue150)
        WebBoxStyle close = forms:GetClose()
        close:SetPadding(constants:SPACING_1, constants:SPACING_1)
        close:SetRoundedCorners(constants:SPACING_1)
        close:SetTextStyle(closeWords)
        WebBoxStyle closeHover = forms:GetCloseHover()
        closeHover:SetBackground(quorumBlue10)
    end

    // A message box: its color, room and words.
    private action SetMessage(WebBoxStyle box, WebColor background, WebTextStyle words)
        box:SetBackground(background)
        box:SetPadding(constants:SPACING_4, constants:SPACING_4)
        box:SetRoundedCorners(constants:SPACING_3)
        box:SetMargin(constants:SPACING_3, constants:SPACING_0)
        box:SetTextStyle(words)
    end

    // The block editor's colors, edges and words, on the structure
    // BlockEditorLooks sets ("mt-4 border-2 rounded-lg shadow-md" and the
    // like).
    private action SetBlockEditorLooks
        // Its own words, left-aligned inside a section that centers them.
        WebTextStyle editorWords
        editorWords:SetColor(textColor)
        editorWords:AlignLeft()
        SetEditorFrame(blockEditor:GetEditor(), editorWords)
        SetEditorFrame(blockEditor:GetFilledEditor(), editorWords)

        WebBoxStyle toolbar = blockEditor:GetToolbar()
        toolbar:SetPadding(constants:SPACING_1, constants:SPACING_1)
        toolbar:SetBottomBorder(constants:SPACING_0_5, quorumBlue50)
        toolbar:SetRoundedTop(constants:SPACING_2)
        toolbar:SetBackground(quorumBlue10)
        blockEditor:GetToolbarLayout():SetGap(constants:SPACING_2)
        WebTextStyle titleWords
        titleWords:SetFontSize(constants:EXTRA_LARGE_2_FONT_SIZE)
        titleWords:SetLineHeight(constants:EXTRA_LARGE_2_LINE_HEIGHT)
        titleWords:SetBold(true)
        blockEditor:GetTitle():SetTextStyle(titleWords)
        blockEditor:GetTitleLayout():SetGap(constants:SPACING_2_5)
        blockEditor:GetButtons():SetRightMargin(constants:SPACING_5)
        blockEditor:GetButtonsLayout():SetGap(constants:SPACING_2_5)

        WebTextStyle toolWords
        toolWords:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        toolWords:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        toolWords:SetColor(textColor)
        WebBoxStyle tool = blockEditor:GetTool()
        tool:SetPadding(constants:SPACING_1, constants:SPACING_1)
        tool:SetRoundedCorners(constants:SPACING_4)
        tool:SetTextStyle(toolWords)
        blockEditor:GetToolLayout():SetGap(constants:SPACING_1)
        WebTextStyle labelWords
        labelWords:AlignCenter()
        labelWords:SetWrapping(false)
        blockEditor:GetToolLabel():SetTextStyle(labelWords)
        blockEditor:GetActive():SetBackground(quorumBlue25)
        blockEditor:GetPressed():SetBackground(quorumBlue50)

        WebTextStyle runWords
        runWords:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        runWords:SetSemibold(true)
        runWords:SetColor(black)
        SetEditorPill(blockEditor:GetRun(), quorumBlue50, runWords)
        WebTextStyle stopWords = runWords:Copy()
        stopWords:SetColor(white)
        SetEditorPill(blockEditor:GetStop(), stopRed, stopWords)
        WebTextStyle unavailableWords
        unavailableWords:SetColor(white)
        WebBoxStyle unavailable = blockEditor:GetUnavailable()
        unavailable:SetBackground(grey40)
        unavailable:SetTextStyle(unavailableWords)

        // "min-h-[32rem]"
        blockEditor:GetArea():SetMinimumHeight(constants:SPACING_64 + constants:SPACING_64)
        blockEditor:GetDisplay():SetLeftBorder(constants:SPACING_PIXEL, grey25)
        WebTextStyle consoleWords
        consoleWords:UseCodeFont(true)
        consoleWords:SetFontSize(constants:BASE_FONT_SIZE)
        consoleWords:SetKeepSpaces(true)
        WebBoxStyle console = blockEditor:GetConsole()
        console:SetHeight(constants:SPACING_24)
        console:SetPadding(constants:SPACING_2, constants:SPACING_2)
        console:SetTopBorder(constants:SPACING_0_5, quorumBlue50)
        console:SetRoundedBottom(constants:SPACING_2)
        console:SetBackground(grey10)
        console:SetTextStyle(consoleWords)

        WebBoxStyle menu = blockEditor:GetMenu()
        menu:SetRightOffset(constants:SPACING_2)
        // "-mt-2": up over the toolbar's lower edge, as the old menu.
        menu:SetTopMargin(0 - constants:SPACING_2)
        menu:SetPadding(constants:SPACING_2, constants:SPACING_2)
        menu:SetRoundedCorners(constants:SPACING_1_5)
        menu:SetBackground(grey10)
        menu:SetShadowDepth(menu:MEDIUM_SHADOW)
        WebTextStyle menuWords
        menuWords:SetColor(textColor)
        menuWords:SetFontSize(constants:BASE_FONT_SIZE)
        menuWords:AlignLeft()
        WebBoxStyle menuItem = blockEditor:GetMenuItem()
        menuItem:SetPadding(constants:SPACING_2, constants:SPACING_2)
        menuItem:SetRoundedCorners(constants:SPACING_4)
        menuItem:SetTextStyle(menuWords)

        WebBoxStyle dialog = blockEditor:GetDialog()
        // "max-h-[calc(100vh-100px)]"
        dialog:SetMaximumHeightBelowWindow(constants:SPACING_24 + constants:SPACING_1)
        dialog:SetPadding(constants:SPACING_5, constants:SPACING_5)
        dialog:SetRoundedCorners(constants:SPACING_1_5)
        dialog:SetBackground(grey10)
        dialog:SetShadowDepth(dialog:MEDIUM_SHADOW)
        WebBoxStyle close = blockEditor:GetDialogClose()
        close:SetTopOffset(constants:SPACING_5)
        close:SetRightOffset(constants:SPACING_5)
        WebTextStyle dialogTitle = blockEditor:GetDialogTitle()
        dialogTitle:SetFontSize(constants:EXTRA_LARGE_2_FONT_SIZE)
        dialogTitle:SetLineHeight(constants:EXTRA_LARGE_2_LINE_HEIGHT)
        dialogTitle:SetBold(true)
        blockEditor:GetHotkeys():SetGap(constants:SPACING_2_5)
        WebTextStyle keyWords
        keyWords:SetFontSize(constants:EXTRA_SMALL_FONT_SIZE)
        keyWords:SetLineHeight(constants:EXTRA_SMALL_LINE_HEIGHT)
        WebBoxStyle key = blockEditor:GetKey()
        key:SetPadding(constants:SPACING_0_5, constants:SPACING_1)
        key:SetRoundedCorners(constants:SPACING_1)
        key:SetBackground(white)
        key:SetTextStyle(keyWords)
    end

    // The editor's frame, filled or not.
    private action SetEditorFrame(WebBoxStyle frame, WebTextStyle words)
        frame:SetTopMargin(constants:SPACING_4)
        frame:SetBorder(constants:SPACING_0_5, quorumBlue50)
        frame:SetRoundedCorners(constants:SPACING_2)
        frame:SetShadowDepth(frame:MEDIUM_SHADOW)
        frame:SetBackground(white)
        frame:SetTextStyle(words)
    end

    // Run or Stop: "h-6 px-4 rounded-2xl text-xs font-semibold".
    private action SetEditorPill(WebBoxStyle pill, WebColor background, WebTextStyle words)
        pill:SetMinimumHeight(constants:SPACING_6)
        pill:SetPadding(constants:SPACING_0, constants:SPACING_4)
        pill:SetRoundedCorners(constants:SPACING_4)
        pill:SetBackground(background)
        pill:SetTextStyle(words)
    end

