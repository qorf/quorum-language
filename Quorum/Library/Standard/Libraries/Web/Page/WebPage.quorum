    /*
        Sets the layout of a header: where the items inside it go. The
        website's build turns the layout into a stylesheet rule shared by
        every page.

        Attribute: Parameter element The header to lay out.
        Attribute: Parameter layout The layout to use.

        Attribute: Example
        use Libraries.Web.Page.all
        use Libraries.Web.Layouts.WebStackLayout

        class Main is WebPage
            action Main
                WebStackLayout stack
                stack:SetGap(8)

                Header headDiv
                SetLayout(headDiv, stack)
                Add(headDiv)
            end
        end
    */
    action SetLayout(Header element, WebLayout layout)
        layouts:Set(element, layout)
    end

    /*
        Sets the layout of a section: where the items inside it go. The
        website's build turns the layout into a stylesheet rule shared by
        every page.

        Attribute: Parameter element The section to lay out.
        Attribute: Parameter layout The layout to use.

        Attribute: Example
        use Libraries.Web.Page.all
        use Libraries.Web.Layouts.WebStackLayout

        class Main is WebPage
            action Main
                WebStackLayout stack
                stack:SetGap(8)

                Section section
                SetLayout(section, stack)
                Add(section)
            end
        end
    */
    action SetLayout(Section element, WebLayout layout)
        layouts:Set(element, layout)
    end

    /*
        Sets the layout of a division: where the items inside it go.

        Attribute: Parameter element The division to lay out.
        Attribute: Parameter layout The layout to use.
    */
