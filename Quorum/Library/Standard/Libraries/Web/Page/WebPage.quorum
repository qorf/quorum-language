package Libraries.Web.Page

use Libraries.Containers.List
use Libraries.Containers.Iterator
use Libraries.Web.Page.WebGenerator
use Libraries.Web.Page.GlobalAttributeAccepter
use Libraries.Web.Page.WebPageHeader
use Libraries.Web.Page.DocumentType
use Libraries.Web.Page.Body
use Libraries.Containers.Array
use Libraries.Containers.HashTable
use Libraries.Network.NetworkExchange
use Libraries.Web.Styles.WebStyle
use Libraries.Web.Styles.WebListStyle
use Libraries.Web.Styles.WebTextStyle
use Libraries.Web.Styles.StyleOptions
use Libraries.Web.WebSite
use Libraries.Web.Styles.WebTableStyle
use Libraries.Web.Styles.WebBoxStyle
use Libraries.Compute.Statistics.DataFrameColumn
use Libraries.Compute.Statistics.DataFrame
use Libraries.System.File
use Libraries.Web.Layouts.WebLayout
use Libraries.Web.Series.PageSeries
use Libraries.Web.ServerResponder
use Libraries.Web.Styles.WebConditionalLook
use Libraries.Web.WebLocations
use Libraries.Web.WebTextEscaper

/*
    WebPage is one web page: an HTML document with its head (title,
    metadata, stylesheets, scripts) and its body. Content can be added
    element by element, or written as an outline, like a document: Title,
    then Section, Subsection and Subsubsection, each holding paragraphs,
    lists, tables, code, pictures and more. Words in paragraphs and list
    items are written with RichText, by what they are (a term, a key, a
    variable), and every piece of text is made safe for the page.

    A page's look comes from its StyleOptions (its global look) and from
    styles and layouts set on single elements; it never needs CSS. A page
    is usually part of a WebSite, which writes or serves every page and
    one stylesheet for them all, and adds what search engines and link
    previews need. Every page starts with UTF-8 text, a viewport that fits
    phones, and English as its language; adding a character set or
    viewport of its own replaces the default.

    Attribute: Example
    use Libraries.Web.Page.all

    class Main is WebPage
        action Main
            Title("Welcome")
            Section("About")
            Paragraph("This page was written as an outline.")
            output Generate()
        end
    end
*/
class WebPage is WebGenerator, GlobalAttributeAccepter, ServerResponder
    DocumentType documentType
    WebPageHeader header
    // Each element's layout. Setting a layout again replaces the old one.
    HashTable<WebTag, WebLayout> layouts

    // Each element's style. Setting a style again replaces the old one.
    HashTable<WebTag, WebStyle> styles

    // Looks an element takes only on wider screens or in a state, such as
    // hover, in the order they were set.
    HashTable<WebTag, Array<WebConditionalLook>> conditionalLooks

    // The site's global look, handed to the page before it's set up.
    StyleOptions styleOptions = undefined

    // The site this page is on, set when the page is added to it.
    WebSite site = undefined
    WebLocations locations

    // The outline's open parts, outermost first: index 0 is the section,
    // 1 the subsection, 2 the subsubsection.
    Array<Section> openParts
    boolean titleAdded = false

    // The list that items go into, and the description list that
    // descriptions go into. Each ends when anything else is added.
    WebTag currentList = undefined

    // The item last added to the current list, which a nested list goes
    // inside; and, while a nested list is open, the lists and items it is
    // inside, outermost first.
    WebTag currentListItem = undefined
    Array<WebTag> outerLists
    Array<WebTag> outerListItems
    DefinitionList currentDescriptionList = undefined

    // The table that rows go into, while it is being built by hand, and
    // its header and body. It ends when anything else is added.
    WebTable currentTable = undefined
    TableHeader currentTableHeader = undefined
    TableBody currentTableBody = undefined

    // The open callout's body, which content goes into until the next
    // part starts or EndCallout is called.
    Division openCallout = undefined

    // Every picture on the page, so a site can add to them (such as
    // letting a reader zoom in).
    Array<Image> images

    // The language of code examples, for the page's code highlighter.
    text codeLanguage = "quorum"
    constant text LINE_NUMBERS_CLASS = "line-numbers"
    constant text LANGUAGE_CLASS_START = "language-"

    constant text ROLE_ATTRIBUTE = "role"
    constant text NOTE_ROLE = "note"
    constant text LABEL_ATTRIBUTE = "aria-label"
    constant text VIDEO_WIDTH = "100%"
    constant text VIDEO_HEIGHT = "450"
    constant text FULL_SCREEN_ATTRIBUTE = "allowfullscreen"

    // Every heading on the page, checked for text before the page is
    // written; the plain words of those written with text; and the
    // identifiers given to them.
    Array<Heading> headings
    Heading lastHeading = undefined
    HashTable<Heading, text> headingWords
    HashTable<text, boolean> usedIdentifiers
    constant text IDENTIFIER_CHARACTERS = "abcdefghijklmnopqrstuvwxyz0123456789"

    // The title's words, for links to this page (such as in a standards
    // report).
    text titleText = ""
    boolean webPageTitleSet = false
    WebTextEscaper escaper

    // For search engines and link previews: the page's summary, the
    // picture shown when it is shared, and whether search engines may
    // list it.
    text description = ""
    text shareImage = ""
    text shareImageDescription = ""
    boolean searchable = true

    // The series this page belongs to most, for its navigation when a
    // reader arrives without following any series.
    PageSeries homeSeries = undefined
    boolean sectionAdded = false
    constant integer SECTION_DEPTH = 0
    constant integer SUBSECTION_DEPTH = 1
    constant integer SUBSUBSECTION_DEPTH = 2

    // A part's heading is this many levels below its depth: a section
    // (depth 0) has a level 2 heading, under the page's level 1 title.
    constant integer HEADING_LEVEL_OFFSET = 2
    constant integer TITLE_HEADING_LEVEL = 1

    // Every page has these unless it changes them: UTF-8 text, a viewport
    // that fits phones, and English as its language.
    MetaData characterSet
    MetaData viewport
    boolean defaultCharacterSet = true
    boolean defaultViewport = true
    constant text VIEWPORT_NAME = "viewport"
    constant text DEFAULT_CHARACTER_SET = "UTF-8"
    constant text DEFAULT_VIEWPORT = "width=device-width, initial-scale=1"
    constant text DEFAULT_LANGUAGE = "en"

    on create
        characterSet:SetCharacterSet(DEFAULT_CHARACTER_SET)
        AddMetaData(characterSet)
        viewport:SetName(VIEWPORT_NAME)
        viewport:SetContent(DEFAULT_VIEWPORT)
        AddMetaData(viewport)
        SetLanguage(DEFAULT_LANGUAGE)
    end
    Body body
    constant text manifest = "manifest"
    /*
        This action gets the address of the documents cache.

        Attribute: Returns The document cache address. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.Attribute

        WebPage page
        text result = page:GetManifest()
        
    */
    action GetManifest returns text
        text textValue = ""
        Attribute value = me:GetAttribute(manifest)
        if value not= undefined
            textValue = value:GetValue()
        end
        return textValue
    end

    /*
        This action sets the address of the documents cache.

        Attribute: Parameter value The document cache address. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.Attribute

        WebPage page
        page:SetManifest("test.appcache")
        
    */
    action SetManifest(text value)
        Attribute attribute
        attribute:SetName(manifest)
        attribute:SetValue(value)
        me:Add(attribute)
    end

    /*
        This action gets the body of the webpage.

        Attribute: Returns The body of the webpage. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.Body

        WebPage page
        Body result = page:GetBody()
        
    */
    action GetBody returns Body
        return body
    end

    /*
        This action gets the type of document.

        Attribute: Returns The type of document. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.DocumentType

        WebPage page
        DocumentType result = page:GetDocumentType()
        
    */
    action GetDocumentType returns DocumentType
        return documentType
    end

    /*
        This action sets the DocumentType of the webpage.

        Attribute: Parameter doc The document type. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.DocumentType

        WebPage page
        DocumentType document
        page:SetDocumentType(document)
        
    */
    action SetDocumentType(DocumentType doc)
        documentType = doc
    end

    /*
        This action sets the title of the webpage.

        Attribute: Parameter value The title. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.Attribute

        WebPage page
        page:SetWebPageTitle("My First Webpage")
        
    */
    action SetWebPageTitle(text value)
        webPageTitleSet = true
        header:SetTitleHeaderValue(escaper:Escape(value))
    end

    /*
        Returns true if the page set its browser tab title itself, with
        SetWebPageTitle. If it didn't, its WebSite makes one from the
        page's title and the site's title ending.

        Attribute: Returns Whether the page set its own tab title.
    */
    action HasWebPageTitle returns boolean
        return webPageTitleSet
    end

    /*
        Adds metadata to the page's head. If it sets the character set or
        the viewport, it replaces the page's default one, so the page never
        has two.

        Attribute: Parameter meta The metadata.

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.MetaData

        WebPage page
        MetaData author
        author:SetName("author")
        author:SetContent("Quorum")
        page:AddMetaData(author)
    */
    action AddMetaData(MetaData meta)
        if meta not= characterSet and meta not= viewport
            if defaultCharacterSet and meta:GetCharacterSet() not= undefined
                header:Remove(characterSet)
                defaultCharacterSet = false
            end
            if defaultViewport and meta:GetName() not= undefined
                if meta:GetName():GetValue() = VIEWPORT_NAME
                    header:Remove(viewport)
                    defaultViewport = false
                end
            end
        end
        header:Add(meta)
    end
    /*
        This action gets the header of this webpage.

        Attribute: Returns The header. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.WebPageHeader

        WebPage page
        WebPageHeader result = page:GetWebPageHeader()
        
    */
    action GetWebPageHeader returns WebPageHeader
        return header
    end

    /*
        This action sets the address of the documents cache.

        Attribute: Parameter header The header. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.WebPageHeader

        WebPage page
        WebPageHeader header
        page:SetWebPageHeader(header)
        
    */
    action SetWebPageHeader(WebPageHeader header) 
        me:header = header
    end

    /*
        This action sets the body of the webpage.

        Attribute: Parameter body The body. 

        Attribute: Example
        use Libraries.Web.Page.WebPage
        use Libraries.Web.Page.Body

        WebPage page
        Body body
        page:SetBody(body)
        
    */
    action SetBody(Body body)
        me:body = body
    end

    /*
        Writes the page's content. A page overrides this; its WebSite calls
        it once, when the site is written or served, after every page has
        been added, so the page can use the site (its files, its other
        pages) while it is built. A page not on a site can call it itself.

        Attribute: Example
        use Libraries.Web.Page.all

        class Welcome is WebPage
            action Setup
                Title("Welcome")
                Paragraph("Hello.")
            end
        end
    */
    action Setup
    end

    action Generate returns text
        text result = documentType:Generate()
        result = result + "<html "
        Attributes attributes = me:GetAttributes()
        result = result + attributes:Generate()
        result = result + ">"
        
        if header not= undefined
            result = result + header:Generate()
        end

        result = result + body:Generate()
        return result + "</html>"
    end

    /*
        This action adds a link to a stylesheet in the header.

        Attribute: Parameter path The location of the stylesheet being added.
        
        Attribute: Returns The generated HeaderLink for any further manipulation

        Attribute: Example
        use Libraries.Web.Page.all

        WebPage page
        page:AddStylesheet("style.css")
    */
    action AddStylesheet(text path) returns HeaderLink
        return me:header:AddStylesheet(path)
    end
    
    /*
        This action adds a script in the header.

        Attribute: Parameter path The location of the script being added.
        
        Attribute: Returns The generated Script for any further manipulation

        Attribute: Example
        use Libraries.Web.Page.all

        WebPage page
        page:AddScript("script.js")
    */
    action AddScript(text path) returns Script
        Script script
        script:SetAddress(path)
        me:header:Add(script)
        return script
    end

    /*
        This action adds a link to an icon in the header. This is sometimes referred to as a "favicon".

        Attribute: Parameter path The location of the stylesheet being added. The file extension must be .ico
        
        Attribute: Returns The generated link for any further manipulation

        Attribute: Example
        use Libraries.Web.Page.all

        WebPage page
        page:AddIcon("favicon.ico")
    */
    action AddIcon(text path) returns HeaderLink
        return me:header:AddIcon(path)
    end

    /*
    This action places a Link object in the body of a WebPage.

    Attribute: Parameter content specifies what will be added to the page.

    Attribute: Example
    use Libraries.Web.Page.all

    class Main
        action Main
            WebPage page
            

            Link link
            page:Add(link)

            text value = page:Generate()
            output value
        end
    end
    */
    action Add(Link content)
        body:Add(content)
    end

    /*
    This action places a Abbreviation object in the body of a WebPage.

    Attribute: Parameter content specifies what will be added to the page.

