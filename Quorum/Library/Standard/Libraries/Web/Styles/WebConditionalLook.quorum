package Libraries.Web.Styles

use Libraries.Web.Styles.WebStyle
use Libraries.Web.Layouts.WebLayout

/*
    WebConditionalLook is a style or layout that an element takes only
    sometimes: on screens at least some width wide, while the pointer is
    over it or it is pressed, while it has keyboard focus, while it is
    disabled or empty, while it is the selected tab or the current item,
    or while it sits inside a disabled control. It changes only what it
    sets; everything else stays as the element's own look says. A page
    makes these with SetStyleFromWidth, SetLayoutFromWidth,
    SetStyleOnHover, SetStyleOnFocus, SetStyleWhenPressed,
    SetStyleWhenDisabled, SetStyleWhenEmpty, SetStyleWhenSelected,
    SetStyleWhenCurrent and SetStyleInsideDisabled; people making pages
    don't use this class directly.
*/
class WebConditionalLook
    number fromWidth = -1
    text state = ""
    WebStyle style = undefined
    WebLayout layout = undefined

    // The states a look can apply in, as the stylesheet names them.
    public constant text HOVER = ":hover"
    public constant text FOCUS = ":focus"
    public constant text INVALID = "[aria-invalid='true']"
    public constant text DISABLED = ":disabled"
    public constant text EMPTY = ":empty"
    public constant text PRESSED = ":active"
    // Marked by the page's scripts, so sight and screen readers agree:
    // the chosen tab (aria-selected), and the current item, such as the
    // slide shown (aria-current, any value but "false").
    public constant text SELECTED = "[aria-selected='true']"
    public constant text CURRENT = "[aria-current]:not([aria-current='false'])"
    // A state of the element's surroundings, not its own: inside a
    // disabled control, as a spinner shown in a button while it waits. A
    // state ending in a space is written before the element's class.
    public constant text INSIDE_DISABLED = ":disabled "

    /*
        Makes this a style for screens at least this wide.

        Attribute: Parameter pixels The narrowest screen the style applies on.
        Attribute: Parameter value The style.
    */
    action SetStyleFromWidth(number pixels, WebStyle value)
        fromWidth = pixels
        style = value
    end

    /*
        Makes this a layout for screens at least this wide.

        Attribute: Parameter pixels The narrowest screen the layout applies on.
        Attribute: Parameter value The layout.
    */
    action SetLayoutFromWidth(number pixels, WebLayout value)
        fromWidth = pixels
        layout = value
    end

    /*
        Makes this a style for a state, such as HOVER, FOCUS, INVALID (a
        form field its page marks as filled in wrongly), DISABLED, EMPTY,
        PRESSED, SELECTED, CURRENT or INSIDE_DISABLED.

        Attribute: Parameter stateName The state, one of this class's constants.
        Attribute: Parameter value The style.
    */
    action SetStyleInState(text stateName, WebStyle value)
        state = stateName
        style = value
    end

    /*
        Returns the narrowest screen this look applies on, or -1 if it
        applies on every screen.

        Attribute: Returns The width in pixels, or -1.
    */
    action GetFromWidth returns number
        return fromWidth
    end

    /*
        Returns the state this look applies in, or nothing if it applies in
        every state.

        Attribute: Returns The state, such as ":hover", or nothing.
    */
    action GetState returns text
        return state
    end

    /*
        Returns the declarations this look sets. WebSite calls this when it
        writes the stylesheet.

        Attribute: Returns The declarations.
    */
    action Generate returns text
        if style not= undefined
            return style:Generate()
        end
        return layout:Generate()
    end
end
