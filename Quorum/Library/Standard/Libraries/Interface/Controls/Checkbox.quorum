package Libraries.Interface.Controls

use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Gradient
use Libraries.Interface.Accessibility
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.View2D
use Libraries.Interface.Views.ToggleView
use Libraries.Interface.Views.CheckboxView
use Libraries.Interface.Events.FocusEvent
use Libraries.Game.Graphics.ColorGroup
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Layouts.ManualLayout

/*
    The Checkbox class is a ToggleButton object that inherits from Button and like other
    UI elements it is added to the Game class. The Checkbox is used to represent
    an individual or collection of toggle buttons. This button has a selected and
    unselected state.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Controls.Checkbox
    use Libraries.Interface.Forms.FormBehavior
    
    class Main 
        action Main 
            Form form
            Page page = form:GetMainPage()
            
            Checkbox button = page:AddCheckbox("checkbox")
            button:SetToggleState(true)
            
            form:Display()
        end
    end
*/
class Checkbox is ToggleButton

    Icon buttonIcon
    Control checkmark
    Label label
    /* Check box colors are set using Background, Selection, Border, and SelectionBorder colors but that would
 conflict with the updated graphics so they are stored for use then nulled out when graphics are loaded 
 */
    ColorGroup boxColor = undefined
    ColorGroup boxCheckedColor = undefined
    ColorGroup boxBorderColor = undefined
    ColorGroup checkmarkColor = undefined

    on create
        label:SetAccessibilityCode(label:parent:Item:NOT_ACCESSIBLE)
        FlowLayout layout
        //layout:SetSingleLine(true)
        layout:SetVerticalCentering(true)
        SetLayout(layout)
        
        // The layout should already be present, courtesy of our inheritance of Button.

        LayoutProperties properties = GetDefaultLayoutProperties()
        properties:SetHorizontalLayoutMode(properties:FIT_CONTENTS)
        properties:SetVerticalLayoutMode(properties:FIT_FONT)
        //properties:SetBorderThickness(2)

        // The properties already contain a loaded Font from the Button constructor.
        label:SetFont(properties:GetFont())
        label:SetFontSize(properties:GetFontSize())
        label:SetPositionOnBaseLine(false)

        LayoutProperties iconProperties = buttonIcon:GetDefaultLayoutProperties()
        iconProperties:SetHorizontalLayoutMode(iconProperties:MAINTAIN_ASPECT_RATIO)
        iconProperties:SetVerticalLayoutMode(iconProperties:STANDARD)
        iconProperties:SetPercentageWidth(1)
        iconProperties:SetPercentageHeight(0.8)
        iconProperties:SetLeftMargin(8)
        

        label:SetLeftMargin(15)
        label:SetRightMargin(8)

        Add(buttonIcon)
        Add(label)

        SetInterfaceOptionsKey("Checkbox")
        buttonIcon:SetInterfaceOptionsKey("Checkbox")

        SetAccessibilityCode(parent:Item:CHECKBOX)
    end
    /*
        This action toggles between the checkbox being checked and unchecked.
        
        Attribute: Parameter toggleState when true the check box is checked.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Controls.Checkbox
        
        class Main 
            action Main 
                Form form
                Page page = form:GetMainPage()
    
                page:AddCheckbox("on")
                Checkbox value = page:AddCheckbox("off")
    
                value:SetToggleState(true)
                
                form:Display()
            end
        end
    */
    action SetToggleState(boolean toggleState)
        /*
        This overwrites the ToggleButton implementation of SetToggleState.
        It is nearly identical to the ToggleButton implementation, except that
        it also tries to toggle the view of the Button icon.
        */
        if parent:ToggleButton:toggled = toggleState
            return now
        end

        ButtonGroup group = GetButtonGroup()
        if toggleState = true and group not= undefined
            group:DeselectAll()
        end

        parent:ToggleButton:toggled = toggleState
        if buttonIcon:GetView2D() is ToggleView
            ToggleView content = cast(ToggleView, buttonIcon:GetView2D())
            content:SetToggleState(toggleState)
        else
            if toggleState
                checkmark:Show()
                Color color
                buttonIcon:SetBackgroundColor(boxCheckedColor)
                buttonIcon:SetBorderColor(boxCheckedColor)
            else
                checkmark:Hide()
                Color color
                buttonIcon:SetBackgroundColor(boxColor)
                buttonIcon:SetBorderColor(boxBorderColor)
            end
            buttonIcon:RequestVerticesUpdate()
        end

        Behavior behavior = GetActivationBehavior()
        if toggleState = true
            OnToggleOn()
            if behavior not= undefined
                BehaviorEvent event
                event:SetItem(me)
                behavior:Run(event)
            end
        else
            OnToggleOff()
            if behavior not= undefined
                behavior:Dispose()
            end
        end

        Accessibility accessibility = parent:ToggleButton:manager:GetAccessibility()
        if accessibility not= undefined
            accessibility:ToggleButtonToggled(me)
        end
    end
    
    
    /*
    Sets the size of the box that contains the checkmark. By default the box is sized proportional to the font size
    but in the event where a different size is preferred it can be set by this action and the previous
    size will be ignored.
*/
    action SetCheckboxSize(number width, number height)
        LayoutProperties properties = GetDefaultLayoutProperties()
        buttonIcon:SetHorizontalLayoutMode(properties:STANDARD)
        buttonIcon:SetVerticalLayoutMode(properties:STANDARD)
        buttonIcon:SetPercentageWidth(0)
        buttonIcon:SetPercentageHeight(0)
        buttonIcon:SetPixelWidth(width)
        buttonIcon:SetPixelHeight(height)
    end

    /*
        This action is fired if the item received the focus.
    */
    action GainedFocus(FocusEvent event)
        //if we have the focus and we are toggled
        Color color
        if GetToggleState()
            if buttonIcon:GetView2D() is CheckboxView
            CheckboxView content = cast(CheckboxView, buttonIcon:GetView2D())
            if content not= undefined
content:SetCheckColor(GetSelectionColor())
            end
        end
        end
        SetSelectionBorderColor(GetFocusBorderColor())
        parent:Control:GainedFocus(event)
        buttonIcon:RequestVerticesUpdate()
    end

    /*
        This action is fired if the item lost the focus.
    */
    action LostFocus(FocusEvent event)
        //if we have the focus and we are toggled
        if GetToggleState()
            if buttonIcon:GetView2D() is CheckboxView
            CheckboxView content = cast(CheckboxView, buttonIcon:GetView2D())
            content:SetCheckColor(GetAccentColor())
        end
        end
        Color color
        SetSelectionBorderColor(color:CustomColor(0,0,0,0))
        parent:Control:LostFocus(event)
        buttonIcon:RequestVerticesUpdate()
    end

    /*
    This action is used to load the graphical components of the Control. This is
    handled automatically by the Game engine as needed, and most users shouldn't
    need to use this action directly.
    */
    action LoadGraphics(LayoutProperties properties)
        parent:Control:LoadGraphics(properties)

        View2D buttonView = buttonIcon:GetView2D()
        View2D propertiesView = properties:GetView2D()

        if propertiesView not= undefined and buttonView not= propertiesView
            buttonIcon:SetView2D(propertiesView)
            buttonView = propertiesView
        end

        label:SetPositionOnBaseLine(false)
        if label:GetSize() not= properties:GetFontSize()
            label:SetSize(properties:GetFontSize())
        end

        if label:GetText() not= properties:GetLabelText()
            label:SetText(properties:GetLabelText())
        end

        if buttonView = undefined
            // Draw using controls
            
            ControlShaderView shader
        shader:Initialize()
        SetView2D(shader)
            
            // update colors
        boxColor = GetBackgroundColor()
        boxCheckedColor = GetSelectionColor()
        boxBorderColor = GetBorderColor()
        checkmarkColor = GetSelectionBorderColor()
            
            Color color
            Color transparent = color:CustomColor(0,0,0,0)
            
            ManualLayout checkLayout
        buttonIcon:SetLayout(checkLayout)
        ControlShaderView containerView
        containerView:Initialize()
        buttonIcon:SetView2D(containerView)
        buttonIcon:SetBorderThickness(GetBorderThickness())
            buttonIcon:SetBorderColor(boxBorderColor)
            
        ControlShaderView checkmarkView
        checkmarkView:Initialize()
        checkmark:SetView2D(checkmarkView)
        
        checkmark:SetBackgroundColor(color:CustomColor(0,0,0,0))
        checkmark:SetBorderColor(color:White())
        checkmark:SetBorderStyle(properties:LEFT + properties:BOTTOM)
        checkmark:Rotate(-45)
        checkmark:SetBorderThickness(GetFontSize()/7)
        checkmark:SetPercentageX(0.2)
        checkmark:SetPercentageY(0.4)
        checkmark:SetPercentageWidth(0.6)
        checkmark:SetPercentageHeight(0.3)
            
            boolean toggleState = GetToggleState()
            if toggleState
                checkmark:Show()
                buttonIcon:SetBackgroundColor(boxCheckedColor)
                buttonIcon:SetBorderColor(boxCheckedColor)
            else
                checkmark:Hide()
                buttonIcon:SetBackgroundColor(boxColor)
            end
            
            if not GetToggleState()
                checkmark:Hide()
            end
            
            buttonIcon:Add(checkmark)
            // null out certain colors so it only effects the box not the whole control
            SetSelectionBorderColor(transparent)
        SetBackgroundColor(transparent)
        SetSelectionColor(transparent)
        SetMouseOverColor(transparent)
        SetBorderColor(transparent)
            
        end

        boolean toggleState = parent:ToggleButton:toggled
        if buttonIcon:GetView2D() is ToggleView
            ToggleView content = cast(ToggleView, buttonIcon:GetView2D())
            content:SetToggleState(toggleState)
        end

        if buttonIcon:GetView2D() is CheckboxView
            CheckboxView content = cast(CheckboxView, buttonIcon:GetView2D())
            if IsFocused()
content:SetCheckColor(buttonIcon:GetFocusColor())
            else
content:SetCheckColor(buttonIcon:GetAccentColor())
            end
        end

    end
    
    action Resize
        // adjust box be slightly lower to be more in line with cap height
        //buttonIcon:SetTopMargin(GetFontSize()*0.18)
        parent:ToggleButton:Resize()
    end
end