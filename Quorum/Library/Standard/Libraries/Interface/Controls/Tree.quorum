package Libraries.Interface.Controls

use Libraries.Interface.Item2D
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.Events.TreeChangeEvent
use Libraries.Interface.Events.TreeChangeListener
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.TreeLayout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Selections.TreeSelection
use Libraries.Interface.Accessibility
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Color
use Libraries.Interface.Controls.Support.FirstLetterNavigator

/*
The Tree class is a control that shows items in a hierarchy, such as the
files and folders of a project. Each entry is a TreeItem, and an item can
hold other items under it. Opening an item shows its children, indented
below it, and closing it hides them. The user selects an item by clicking
it or with the keyboard: the up and down arrows move through the rows that
are showing, the right arrow opens an item or moves into it, the left arrow
closes an item or moves to its parent, and enter activates it. Typing
letters jumps to the next item whose name starts with them. The selection
can be read with GetSelection, and TreeChangeListeners can be told when
items open and close.

Attribute: Author William Allee

Attribute: Example

use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem

Form form
Page page = form:GetMainPage()

Tree tree = page:AddTree("Files")

TreeItem scripts
scripts:SetName("Scripts")
tree:Add(scripts)

TreeItem main
main:SetName("Main.quorum")
scripts:Add(main)

form:Display()
*/
class Tree is Control, FirstLetterNavigator
    Control panel
    Layout panelLayout = undefined
    TreeSelection selection
    Array<TreeItem> treeItems
    Array<TreeChangeListener> listeners
    GameStateManager manager

    on create
        SetFocusable(true)
        SetInputGroup("Tree")
        TreeLayout flow
        
        // Hardcoded value sufficient for basic cases. Should be replaced with
        // something more responsive to design in the future.
        flow:SetPadding(2)
        flow:SetTopAligned(true)

        panelLayout = flow
        panel:SetLayout(flow)
        panel:SetName("Tree Panel")
        parent:Item2D:Add(panel)

        selection:Initialize(me)
        SetAccessibilityCode(parent:Item:TREE)

        LayoutProperties properties = GetDefaultLayoutProperties()
        properties:SetHorizontalLayoutMode(properties:FIT_CONTENTS)
        properties:SetVerticalLayoutMode(properties:FIT_CONTENTS)

        FlowLayout layout
        SetLayout(layout)

        LayoutProperties panelProperties = panel:GetDefaultLayoutProperties()
        panelProperties:SetHorizontalLayoutMode(panelProperties:FIT_CONTENTS)
        panelProperties:SetVerticalLayoutMode(panelProperties:FIT_CONTENTS)
    end

    /*
    This action returns true, because a Tree holds other accessible items (its
    TreeItems). Screen readers use this to treat the tree as the parent of its
    items. Most programs never use this action directly.

    Attribute: Returns True, since a Tree is always an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
    This action adds an item to the top level of this tree, after the items
    already there. The item, and every item under it, is told it belongs to
    this tree, and the item takes the tree's font size.

    Attribute: Parameter item The TreeItem to add.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem item
    item:SetName("Main.quorum")
    tree:Add(item)
    */
    action Add(TreeItem item)
        item:SetTree(me)
        item:SetFontSize(GetFontSize())
        treeItems:Add(item)
        panel:Add(item)
    end

    /*
    This action adds an item to the top level of this tree at the given
    position, counting from 0. The item, and every item under it, is told it
    belongs to this tree, and the item takes the tree's font size.

    Attribute: Parameter location Where to put the item among the top-level items.

    Attribute: Parameter item The TreeItem to add.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem player
    player:SetName("Player.quorum")
    tree:Add(player)
    TreeItem main
    main:SetName("Main.quorum")
    tree:Add(0, main)
    */
    action Add(integer location, TreeItem item)
        item:SetTree(me)
        item:SetFontSize(GetFontSize())
        treeItems:Add(location, item)
        panel:Add(location, item)
    end

    /*
    This action sets the font size of this tree and of all of its items, as a
    List does for its items.

    Attribute: Parameter size The font size for the tree and its items.
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        integer i = 0
        repeat while i < treeItems:GetSize()
            treeItems:Get(i):SetFontSize(size)
            i = i + 1
        end
    end
    
    /*
    This action removes a top-level item, and the items under it, from this
    tree. If the selection is inside the item, the selection first moves down,
    so it doesn't stay on an item that is no longer in the tree.

    Attribute: Parameter item The top-level TreeItem to remove.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    tree:Remove(scripts)
    */
    action Remove(TreeItem item)
        // If the removed TreeItem was part of the selected path, move the
        // selection down (rather than maintaining it on a removed item).
        if selection:GetPath():Get(0) = item
            SelectionDown()
        end

        panel:Remove(item)
        treeItems:Remove(item)
        item:SetTree(undefined)
    end

    /*
    This action returns an iterator over the top-level items of this tree.
    Items under them are not included; use each item's GetTreeItems action to
    go deeper.

    Attribute: Returns An iterator over the top-level TreeItems.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    use Libraries.Containers.Iterator
    Tree tree
    TreeItem item
    item:SetName("Main.quorum")
    tree:Add(item)
    Iterator<TreeItem> items = tree:GetTreeItems()
    repeat while items:HasNext()
        output items:Next():GetName()
    end
    */
    action GetTreeItems returns Iterator<TreeItem>
        return treeItems:GetIterator()
    end    

    /*
    This action returns the number of top-level TreeItems contained in the Tree,
    or in other words, how many TreeItems have been directly added to the Tree.
    This does not include the number of sub-items contained within TreeItems.

    Attribute: Returns The number of top-level TreeItems contained in the Tree.
    */
    action GetSize returns integer
        return treeItems:GetSize()
    end

    /*
    This action returns the tree's selection. The selection holds the path from
    a top-level item down to the selected item, and its GetTreeItem action
    returns the selected item itself.

    Attribute: Returns The selection of this tree.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    main:Select()
    TreeItem selected = tree:GetSelection():GetTreeItem()
    */
    action GetSelection returns TreeSelection
        return selection
    end

    /*
    A Tree selects only one item at a time, so this action always returns
    undefined.

    Attribute: Returns Always undefined.
    */
    action GetMultipleSelection returns Array<TreeSelection>
        return undefined
    end

    /*
    A Tree selects only one item at a time, so this action always returns
    false.

    Attribute: Returns Always false.
    */
    action HasMultipleSelection returns boolean
        return false
    end

    /*
    This action selects the item at the end of the given path. The path lists
    the items from a top-level item down to the item to select, as a TreeItem's
    GetTreePath action returns it. The old selection is cleared, the new item
    is drawn as selected, and a selection event is sent. If the tree is inside
    a ScrollPane, the pane scrolls so the selected row can be seen. Calling
    Select on the TreeItem itself does the same thing.

    Attribute: Parameter path The items from a top-level item down to the item to select.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    tree:Select(main:GetTreePath())
    */
    action Select(Array<TreeItem> path)
        Array<TreeItem> pathCopy = path:CopyToArray()
        TreeItem first = undefined

        if not path:IsEmpty()
            first = pathCopy:RemoveFromFront()
        end

        Array<TreeItem> selectionPath = selection:GetPath()
        TreeItem oldFirst = undefined

        if not selectionPath:IsEmpty()
            oldFirst = selectionPath:RemoveFromFront()
        end

        if first not= undefined
            if first = oldFirst
                first:UpdateSelection(selectionPath, pathCopy)
            else
                if oldFirst not= undefined
                    oldFirst:RecursiveDeselect(selectionPath)
                end
                first:RecursiveSelect(pathCopy)
            end
        end

        // Set our selection object with the new path, triggering a selection
        // event.
        selection:Set(path)

        // Keep the selected row in view when the tree is in a scroll pane.
        if not path:IsEmpty()
            ScrollSelectionIntoView(path:GetFromEnd())
        end
    end

    /*
    This action scrolls the ScrollPane holding this tree, if there is one, just
    far enough to show the given item's row: up so the row's top is at the
    view's top, or down so its bottom is at the view's bottom. A row already
    in view doesn't move anything.
    */
    private action ScrollSelectionIntoView(TreeItem item)
        if item = undefined
            return now
        end

        // The tree sits in a ScrollPane's anchor, the content that scrolls.
        Item2D candidate = GetParent()
        repeat until candidate = undefined or candidate is ScrollPaneRendererAnchor
            candidate = candidate:GetParent()
        end
        if candidate = undefined
            return now
        end
        ScrollPaneRendererAnchor anchor = cast(ScrollPaneRendererAnchor, candidate)
        ScrollPane pane = anchor:GetScrollPane()
        if pane = undefined
            return now
        end

        // A subtree that just opened may not be placed yet; lay out first.
        if pane:NeedsLayout() or anchor:NeedsLayout() or NeedsLayout()
            pane:Resize()
        end

        number contentHeight = pane:GetTotalContentHeight()
        number viewRatio = pane:GetScrollPercentageHeight()
        if contentHeight <= 0 or viewRatio >= 1.0
            return now
        end
        number viewHeight = viewRatio * contentHeight

        // The row is the item's own line, not its open subtree.
        number rowY = item:GetGlobalY()
        number rowHeight = item:GetHeight()
        TreeItemContent row = item:GetTreeItemContent()
        if row not= undefined
            rowY = row:GetGlobalY()
            rowHeight = row:GetHeight()
        end

        // Distances measured down from the top of the content. The scroll
        // pane shows the content from scrollPercentageY times its height.
        number contentTop = anchor:GetGlobalY() + contentHeight
        number rowTop = contentTop - (rowY + rowHeight)
        number rowBottom = rowTop + rowHeight
        number viewTop = pane:GetScrollPercentageY() * contentHeight

        if rowTop < viewTop
            pane:SetScrollPercentageY(rowTop / contentHeight)
        elseif rowBottom > viewTop + viewHeight
            pane:SetScrollPercentageY((rowBottom - viewHeight) / contentHeight)
        end
    end

    /*
    This action clears the selection, so no item is selected.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    main:Select()
    tree:Deselect()
    */
    action Deselect
        TreeSelection selection = GetSelection()
        Deselect(selection:GetPath())
    end

    /*
    This action draws every item along the given path as not selected and then
    sets the selection to an empty path. The path is the same when the action
    returns as when it was called.

    Attribute: Parameter path The path of the current selection.
    */
    private action Deselect(Array<TreeItem> path)
        TreeItem item = undefined
        if not path:IsEmpty()
            item = path:RemoveFromFront()
        end

        if item not= undefined
            item:RecursiveDeselect(path)
        end

        // Add the removed portion back to the path to undo our side effects.
        path:AddToFront(item)
        Array<TreeItem> newPath
        selection:Set(newPath)
    end

    /*
    This action is what the right arrow key does. If nothing is selected, it
    selects the first item. If the selected item has children, it opens it, or
    if it is already open, it selects its first child.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    scripts:Select()
    tree:SelectionRight()
    */
    action SelectionRight
        if selection:GetPath():IsEmpty()
            if not treeItems:IsEmpty()
                Array<TreeItem> array
                array:Add(treeItems:Get(0))
                Select(array)
            end
        else
            TreeItem item = selection:GetPath():GetFromEnd()
            if item not= undefined and item:IsSubtree()
                if item:IsOpen()
                    Iterator<TreeItem> iter = item:GetTreeItems()
                    if iter:HasNext()
                        Select(iter:Next():GetTreePath())
                    end
                else
                    item:Open()
                end
            end
        end
    end

    /*
    This action is what the left arrow key does. If nothing is selected, it
    selects the first item. If the selected item is open, it closes it;
    otherwise, it selects the item's parent, if it has one.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    main:Select()
    tree:SelectionLeft()
    */
    action SelectionLeft
        Array<TreeItem> path = selection:GetPath()
        if path:IsEmpty()
            if not treeItems:IsEmpty()
                SelectFirst()
            end
        else
            TreeItem item = path:GetFromEnd()
            if item not= undefined
                if item:IsSubtree() and item:IsOpen()
                    item:Close()
                elseif path:GetSize() > 1
                    path:RemoveFromEnd()
                    Select(path)
                end
            end
        end
    end

    /*
    This action is what the down arrow key does. If nothing is selected, it
    selects the first item; otherwise it selects the row below the selected
    one, going into open items and out of the end of them.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    scripts:Open()
    scripts:Select()
    tree:SelectionDown()
    */
    action SelectionDown
        Array<TreeItem> path = selection:GetPath()
        if path:IsEmpty()
            if not treeItems:IsEmpty()
                SelectFirst()
            end
        else
            TreeItem item = path:GetFromEnd()
            if item not= undefined
                item:SelectionDown()
            end
        end
    end

    /*
    This action is what the up arrow key does. If nothing is selected, it
    selects the first item; otherwise it selects the row above the selected
    one, which may be the last showing row inside an open item or the
    selected item's parent.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    scripts:Open()
    main:Select()
    tree:SelectionUp()
    */
    action SelectionUp
        Array<TreeItem> path = selection:GetPath()
        if path:IsEmpty()
            if not treeItems:IsEmpty()
                SelectFirst()
            end
        else
            TreeItem item = path:GetFromEnd()
            if item not= undefined
                item:SelectionUp()
            end
        end
    end

    /*
    This action selects the top-level item after the one the selection is in,
    skipping over the rows inside the current one. If nothing is selected, it
    selects the first item, and at the last top-level item it does nothing.
    TreeItem uses it when the selection moves down past the last row inside a
    top-level item.
    */
    action SelectionSkipForward
        Array<TreeItem> path = selection:GetPath()
        if path:IsEmpty()
            SelectFirst()
        else
            integer counter = 0
            TreeItem first = path:GetFromFront()
            repeat while counter < treeItems:GetSize()
                if treeItems:Get(counter):Equals(first)
                    integer select = counter + 1

                    if select >= treeItems:GetSize()
                        return now
                    end

                    first = treeItems:Get(select)
                    path:Empty()
                    path:Add(first)
                    Select(path)
                    return now
                end
                counter = counter + 1
            end
        end
    end

    /*
    This action selects the last showing row of the top-level item before the
    one the selection is in: that item itself, or the last row inside it if it
    is open. If nothing is selected, it selects the first item, and at the
    first top-level item it does nothing. TreeItem uses it when the selection
    moves up from a top-level item.
    */
    action SelectionSkipBackward
        Array<TreeItem> path = selection:GetPath()
        if path:IsEmpty()
            SelectFirst()
        else
            integer counter = 0
            TreeItem first = path:GetFromFront()
            repeat while counter < treeItems:GetSize()
                if treeItems:Get(counter):Equals(first)
                    integer select = counter - 1

                    if select < 0
                        return now
                    end

                    treeItems:Get(select):SelectLastElement()
                    return now
                end
                counter = counter + 1
            end
        end
    end

    /*
    This action selects the first top-level item, if the tree has any items.
    */
    private action SelectFirst
        if not treeItems:IsEmpty()
            Array<TreeItem> array
            array:Add(treeItems:Get(0))
            Select(array)
        end
    end

    /*
    This action is called when the tree gains the focus. If nothing is
    selected, it selects the first item. Otherwise it sends the selection
    event again, so a screen reader reads the selected item, and draws the
    item in the focused selection color.

    Attribute: Parameter event The focus event.
    */
    action GainedFocus(FocusEvent event)
        if selection:IsEmpty() and not treeItems:IsEmpty()
            Array<TreeItem> array
            array:Add(treeItems:Get(0))
            Select(array)
        else
            // Force a selection event.
            selection:SetDisplayName(selection:GetDisplayName())
            if not treeItems:IsEmpty()
                selection:GetTreeItem():GainedSelection()
            end
        end
        parent:Control:GainedFocus(event)
    end

    /*
    This action is called when the tree loses the focus. It draws the
    selected item in the unfocused selection color.

    Attribute: Parameter event The focus event.
    */
    action LostFocus(FocusEvent event)
        if not selection:IsEmpty()
            selection:GetTreeItem():UnfocusedSelection()
        end
        parent:Control:LostFocus(event)
    end

    /*
    This action adds a listener that is told whenever an item in this tree is
    opened or closed.

    Attribute: Parameter listener The TreeChangeListener to add.

    Attribute: Example
    // In the file FolderListener.quorum:
    use Libraries.Interface.Events.TreeChangeListener
    use Libraries.Interface.Events.TreeChangeEvent

    class FolderListener is TreeChangeListener
        action OpenedTree(TreeChangeEvent event)
            output "Opened " + event:GetTreeItem():GetName()
        end
    end

    // In the file Main.quorum:
    use Libraries.Interface.Controls.Tree

    class Main
        action Main
            Tree tree
            FolderListener listener
            tree:AddTreeChangeListener(listener)
        end
    end
    */
    action AddTreeChangeListener(TreeChangeListener listener)
        listeners:Add(listener)
    end

    /*
    This action removes a listener added with AddTreeChangeListener, so it is
    no longer told when items open or close.

    Attribute: Parameter listener The TreeChangeListener to remove.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Events.TreeChangeListener
    Tree tree
    TreeChangeListener listener
    tree:AddTreeChangeListener(listener)
    tree:RemoveTreeChangeListener(listener)
    */
    action RemoveTreeChangeListener(TreeChangeListener listener)
        listeners:Remove(listener)
    end

    /*
    This action tells this tree's listeners that an item opened or closed,
    calling OpenedTree or ClosedTree depending on the event's type, and then
    tells the game's input handler. TreeItem calls it when it opens or closes,
    so most programs never call it directly.

    Attribute: Parameter event The event describing the item that changed.
    */
    action NotifyTreeChangeListeners(TreeChangeEvent event)
        integer counter = 0
        if event:GetEventType() = event:OPENED
            repeat while counter < listeners:GetSize()
                listeners:Get(counter):OpenedTree(event)
                counter = counter + 1
            end
        elseif event:GetEventType() = event:CLOSED
            repeat while counter < listeners:GetSize()
                listeners:Get(counter):ClosedTree(event)
                counter = counter + 1
            end
        end

        manager:GetInput():NotifyTreeChangeListeners(event)
    end

    /*
    This action removes every item from this tree and clears the selection.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem scripts
    scripts:SetName("Scripts")
    tree:Add(scripts)
    TreeItem main
    main:SetName("Main.quorum")
    scripts:Add(main)
    tree:Empty()
    */
    action Empty 
        panel:Empty()
        treeItems:Empty()
        selection:Empty()
    end

    /*
    This action returns true if this tree has no items.

    Attribute: Returns True if the tree has no items, false otherwise.
    */
    action IsEmpty returns boolean
        return treeItems:IsEmpty()
    end

    /*
    This action selects an item using first letter navigation. The incoming letters
    should be lower case only.
    */
    action SelectByFirstLetters(text firstLetters)
        /* 
        We prioritize returning the original selection or the next item
        after it over items found before the original selection.
        We use a Boolean object so that we can pass it as a parameter and
        see if the value has changed via side effects (essentially, it's an
        extra return value).
        */
        Boolean foundOriginalSelection
        foundOriginalSelection:SetValue(false)

        TreeItem firstCandidate = undefined

        TreeSelection selection = GetSelection()
        TreeItem originalSelection = selection:GetTreeItem()

        if originalSelection = undefined
            // If there's no current selection, we want to return the first result we find that matches.
            foundOriginalSelection:SetValue(true)
        end

        integer counter = 0
        repeat while counter < treeItems:GetSize()
            TreeItem result = RecursiveSelectByFirstLetters(treeItems:Get(counter), firstLetters, foundOriginalSelection, originalSelection)
            if firstCandidate = undefined
                firstCandidate = result
            end

            // If we've found a valid result and we've already found the original selection,
            // we've found our desired item. Select it and return.
            if foundOriginalSelection:GetValue() = true and result not= undefined
                result:Select()
                return now
            end
            counter = counter + 1
        end

        // If we've reached this point, we didn't find a valid candidate without looping around to the beginning.
        if firstCandidate not= undefined
            firstCandidate:Select()
        end
    end

    /*
    This action looks for an item whose name starts with the given letters,
    ignoring case, in the given item and the items under it that are showing.
    Once the search has passed the originally selected item, the first match is
    returned right away. Before that, the first match is kept and returned if
    nothing better is found.

    Attribute: Parameter currentCandidate The item to search, along with the showing items under it.

    Attribute: Parameter firstLetters The lower case letters to look for.

    Attribute: Parameter foundOriginalSelection Set to true once the search passes the original selection.

    Attribute: Parameter originalSelection The item that was selected when the search began.

    Attribute: Returns The matching item, or undefined if there is none.
    */
    private action RecursiveSelectByFirstLetters(TreeItem currentCandidate, text firstLetters, Boolean foundOriginalSelection, TreeItem originalSelection) returns TreeItem
        if currentCandidate = originalSelection
            foundOriginalSelection:SetValue(true)
        end

        TreeItem firstValid = undefined

        // We test with the lower case letters because we ignore case sensitivity,
        // and the incoming filter characters are guaranteed to be lower case.
        if currentCandidate:GetName():ToLowerCase():StartsWith(firstLetters)
            if foundOriginalSelection:GetValue() = true
                return currentCandidate
            else
                firstValid = currentCandidate
            end
        end

        if currentCandidate:IsSubtree() and currentCandidate:IsOpen()
            Iterator<TreeItem> treeItems = currentCandidate:GetTreeItems()
            repeat while treeItems:HasNext()
                TreeItem next = treeItems:Next()
                TreeItem result = RecursiveSelectByFirstLetters(next, firstLetters, foundOriginalSelection, originalSelection)
    
                if result not= undefined
                    if foundOriginalSelection:GetValue() = true
                        return result
                    elseif firstValid = undefined
                        firstValid = result
                    end
                end
            end
        end

        // If we didn't find an exact match earlier, return the first valid one we found (or undefined if there was none).
        return firstValid
    end
end
