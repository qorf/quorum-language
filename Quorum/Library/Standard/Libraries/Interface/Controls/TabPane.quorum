package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Interface.Item2D
use Libraries.Interface.Controls.Control
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.Events.TabChangeListener
use Libraries.Interface.Selections.TabPaneSelection
use Libraries.Game.Graphics.Font

/*
The TabPane class is a control that holds a set of Tabs. It has a TabBar
showing the Tabs and a view area below it (or beside it, if the bar is on
the left). Only one Tab is selected at a time, and the view area shows the
selected Tab's related item. Users switch between Tabs with the mouse or the
keyboard, and can close Tabs with their close buttons.

Attribute: Author William Allee

Attribute: Example
use Libraries.Game.Game
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.Button

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        TabPane pane

        Tab homeTab
        homeTab:SetName("Home")
        Button homeButton
        homeButton:SetName("Welcome")
        homeTab:SetRelatedItem(homeButton)
        pane:Add(homeTab)

        Tab settingsTab
        settingsTab:SetName("Settings")
        Button settingsButton
        settingsButton:SetName("Change Settings")
        settingsTab:SetRelatedItem(settingsButton)
        pane:Add(settingsTab)

        Add(pane)
        pane:Select(0)
    end
end
*/
class TabPane is Control
    
    TabBar bar
    Item2D currentItem = undefined
    TabViewArea viewArea
    TabPaneSelection selection

    on create
        SetInputGroup("TabPane")
        SetName("Tab Pane")
        viewArea:SetName("Tab View Area")
        SetFocusable(true)
        SetAccessibilityCode(parent:Item:TAB_PANE)

        bar:SetTabPane(me)
        
        Font font = GetDefaultFont()
        if font not= undefined
            integer defaultFontSize = GetDefaultFontSize()
            SetFont(font)
            SetFontSize(font:GetSize())
        end
        
LayoutProperties paneProperties = GetDefaultLayoutProperties()
        paneProperties:SetHorizontalLayoutMode(paneProperties:STANDARD)
        paneProperties:SetVerticalLayoutMode(paneProperties:STANDARD)
        paneProperties:SetPercentageWidth(1)
        paneProperties:SetPercentageHeight(1)
        
        TopAlignTabBar()

        Add(bar)
        Add(viewArea)

        selection:Initialize(me, -1)

        FlowLayout layout
        layout:SetIgnoreHidden(true)
        SetLayout(layout)

        FlowLayout flow
        viewArea:SetLayout(flow)
    end
    
    /*This action sets the TabBar to be a horizontal bar across the top of the TabPane.
This is the default setting for the TabBar.*/
    action TopAlignTabBar
        LayoutProperties viewLayoutProperties = viewArea:GetDefaultLayoutProperties()
        viewLayoutProperties:SetHorizontalLayoutMode(viewLayoutProperties:STANDARD)
        viewLayoutProperties:SetVerticalLayoutMode(viewLayoutProperties:FILL)
        viewLayoutProperties:SetPercentageX(0)
        viewLayoutProperties:SetPercentageWidth(1)
        viewArea:SetClipping(true)
        
        bar:SetToHorizontal()
    end
    
    /*This action sets the TabBar to be a vertical bar placed on the left side of the TabPane.*/
    action LeftAlignTabBar
        LayoutProperties viewLayoutProperties = viewArea:GetDefaultLayoutProperties()
        viewLayoutProperties:SetHorizontalLayoutMode(viewLayoutProperties:FILL)
        viewLayoutProperties:SetVerticalLayoutMode(viewLayoutProperties:STANDARD)
        viewLayoutProperties:SetPercentageHeight(1.0)
        viewArea:SetClipping(true)
        
        bar:SetToVertical()
    end
    
    /* This action returns true if the TabBar is aligned across the top of the TabPane, 
or false otherwise. By default, this is true. */
    action IsBarTopAligned returns boolean
        return bar:IsVertical() = false
    end
    
    /* This action returns true if the TabBar is aligned on the left side of the TabPane,
or false otherwise. By default, this is false. */
    action IsBarLeftAligned returns boolean
        return bar:IsVertical()
    end
    
    /* This action sets the TabBar to use large tabs if the given value is true, or to use
the default smaller tabs if the value is false. Default tabs place the icon, label, and
close button all together on a single horizontal line. Large tabs place the label at
the bottom of the tab, with a larger icon on top of it. */
    action SetLargeTabs(boolean enable)
        bar:SetLargeTabs(enable)
    end
    
/* This action returns whether or not the TabBar is using large tabs. By default,
this is false. */
    action IsUsingLargeTabs returns boolean
        return bar:IsUsingLargeTabs()
    end

    /*
        This action returns true, because a TabPane is a parent for
        accessibility: screen readers treat its Tabs and view area as its
        children.

        Attribute: Returns True, since a TabPane is an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
        This action returns the font size a TabPane uses unless another size
        is set, which is 22.

        Attribute: Returns The default font size, 22.
    */
    action GetDefaultFontSize returns integer
        return 22
    end

    /*
        This action sets the layout of the view area, which places the
        selected Tab's related item. The view area uses a FlowLayout unless
        this is changed.

        Attribute: Parameter layout The layout for the view area.

        Attribute: Example
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Layouts.ManualLayout
        TabPane pane
        ManualLayout layout
        pane:SetViewAreaLayout(layout)
    */
    action SetViewAreaLayout(Layout layout)
        viewArea:SetLayout(layout)
    end

    /*
        This action returns the layout of the view area, which places the
        selected Tab's related item.

        Attribute: Returns The view area's layout.
    */
    action GetViewAreaLayout returns Layout
        return viewArea:GetLayout()
    end

    /*
        This action returns the layout properties of the view area. Use them
        to change how the view area itself is sized and placed in the
        TabPane.

        Attribute: Returns The view area's layout properties.

        Attribute: Example
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Layouts.LayoutProperties
        TabPane pane
        LayoutProperties properties = pane:GetViewAreaLayoutProperties()
        properties:SetLeftMargin(10)
    */
    action GetViewAreaLayoutProperties returns LayoutProperties
        return viewArea:GetDefaultLayoutProperties()
    end

    /*
        This action changes what the view area shows to the given Tab's
        related item, removing the item shown before. An undefined Tab, or a
        Tab with no related item, leaves the view area empty.

        Attribute: Parameter tab The Tab whose related item to show, or undefined.
    */
    private action SetCurrentItem(Tab tab)
        Item2D item = undefined

        if tab not= undefined
            item = tab:GetRelatedItem()
        end

        if currentItem not= undefined
            viewArea:Remove(currentItem)
        end
        if item not= undefined
            viewArea:Add(item)
        end
        currentItem = item
        Resize()
        if item not= undefined and item is Control
            Control control = cast(Control, item)
            control:RequestLayout()
        end
    end

    /*
        This action returns the item the view area is showing, which is the
        selected Tab's related item.

        Attribute: Returns The item being shown, or undefined if none is.
    */
    action GetCurrentItem returns Item2D
        return currentItem
    end

    /*
        This action adds every Tab in the given array to the end of the
        TabBar, in order.

        Attribute: Parameter array The Tabs to add.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Containers.Array

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab homeTab
                homeTab:SetName("Home")
                Tab settingsTab
                settingsTab:SetName("Settings")
                Array<Tab> tabs
                tabs:Add(homeTab)
                tabs:Add(settingsTab)
                pane:Add(tabs)
            end
        end
    */
    action Add(Array<Tab> array)
        i = 0
        repeat while i < array:GetSize()
            Tab tab = array:Get(i)
            tab:SetTabPane(me)
            bar:Add(tab)
            i = i + 1
        end
    end

    /*
        This action adds a Tab to the end of the TabBar. Adding a Tab does not
        select it.

        Attribute: Parameter tab The Tab to add.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
            end
        end
    */
    action Add(Tab tab)
        tab:SetTabPane(me)
        bar:Add(tab)
    end

    /*
        This action removes a Tab, as its close button does. If the Tab was
        selected, the Tab before it is selected instead. The removed Tab is
        disposed of and can't be used again.

        Attribute: Parameter tab The Tab to remove.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab homeTab
                homeTab:SetName("Home")
                pane:Add(homeTab)
                Tab notesTab
                notesTab:SetName("Notes")
                pane:Add(notesTab)
                pane:Remove(notesTab)
            end
        end
    */
    action Remove(Tab tab)
        bar:Remove(tab)
    end

    /*
        This action returns the Tab at the given index. The first Tab is at
        index 0.

        Attribute: Parameter index The index of the Tab.

        Attribute: Returns The Tab at that index.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                Tab first = pane:Get(0)
            end
        end
    */
    action Get(integer index) returns Tab
        return bar:Get(index)
    end

    /*
        This action returns all of the Tabs, in order. The array is the
        TabBar's own, so add and remove Tabs with the TabPane's actions, not
        the array's.

        Attribute: Returns An array of the Tabs.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Containers.Array

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                Array<Tab> tabs = pane:GetTabs()
            end
        end
    */
    action GetTabs returns Array<Tab>
        return bar:GetTabs()
    end

    /*
        This action returns how many Tabs the TabPane has.

        Attribute: Returns The number of Tabs.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                integer size = pane:GetSize()
            end
        end
    */
    action GetSize returns integer
        return bar:GetSize()
    end

    /*
        This essentially does what Select does but it will not move focus to the
        tab
    */
    action Display(integer index)
        if index = -1
            Deselect()
        elseif index >= 0 and index < GetSize()
            Get(index):SetToggleState(true)
        end
    end

    /*
        This action selects the given Tab and shows its related item, without
        moving the focus. If the Tab is not in this TabPane, nothing happens.

        Attribute: Parameter tab The Tab to show.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Display(tab)
            end
        end
    */
    action Display(Tab tab)
        integer size = GetSize()
        integer counter = 0
        repeat while counter < size
            if Get(counter) = tab
                Display(counter)
                return now
            end
            counter = counter + 1
        end
    end

    /*
        This action selects the Tab at the given index, shows its related
        item, and moves the focus into it. An index of -1 deselects the
        selected Tab, and other indexes outside the Tabs do nothing.

        Attribute: Parameter index The index of the Tab to select, or -1.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(0)
            end
        end
    */
    action Select(integer index)
        Select(index, true)
    end

    /*
        This action selects the Tab at the given index and shows its related
        item. If focusContents is true, the Tab is also activated, which moves
        the focus into its related item. An index of -1 deselects the selected
        Tab, and other indexes outside the Tabs do nothing.

        Attribute: Parameter index The index of the Tab to select, or -1.

        Attribute: Parameter focusContents True to move the focus into the Tab's related item.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(0, false)
            end
        end
    */
    action Select(integer index, boolean focusContents)
        if index = -1
            Deselect()
        elseif index >= 0 and index < GetSize()
            Get(index):SetToggleState(true)
            if focusContents
                Get(index):Activate()
            end
        end
    end

    /*
        This action selects the given Tab, shows its related item, and moves
        the focus into it. If the Tab is not in this TabPane, nothing happens.

        Attribute: Parameter tab The Tab to select.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(tab)
            end
        end
    */
    action Select(Tab tab)
        Select(tab, true)
    end

    /*
        This action selects the given Tab and shows its related item. If
        focusContents is true, the Tab is also activated, which moves the
        focus into its related item. If the Tab is not in this TabPane,
        nothing happens.

        Attribute: Parameter tab The Tab to select.

        Attribute: Parameter focusContents True to move the focus into the Tab's related item.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(tab, false)
            end
        end
    */
    action Select(Tab tab, boolean focusContents)
        integer size = GetSize()
        integer counter = 0
        repeat while counter < size
            if Get(counter) = tab
                Select(counter, focusContents)
                return now
            end
            counter = counter + 1
        end
    end

    /*
        This action deselects the selected Tab, so no Tab is selected and the
        view area is empty.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(0)
                pane:Deselect()
            end
        end
    */
    action Deselect
        integer index = selection:GetIndex()
        if index >= 0 and index < GetSize()
            Get(index):SetToggleState(false)
        end
    end

    /*
        This action records the given Tab as the selected one and shows its
        related item in the view area. A Tab calls it when it is selected or
        deselected. If the Tab is undefined or not in this TabPane, the
        selection is cleared and the view area is emptied. To select a Tab,
        use Select or Display instead.

        Attribute: Parameter tab The newly selected Tab, or undefined.
    */
    action UpdateSelection(Tab tab)
        integer size = GetSize()
        integer index = selection:GetIndex()
        if index >= 0 and index < size
            if Get(index) = tab
                return now
            end
        end

        integer counter = 0
        boolean found = false

        if tab not= undefined
            repeat while counter < size
                if Get(counter) = tab
                    selection:Set(counter)
                    found = true
                    counter = size
                end
                counter = counter + 1
            end
        end

        if found
            SetCurrentItem(tab)
        else
            SetCurrentItem(undefined)
            selection:Set(-1)
        end
    end

    /*
        This action returns the TabPane's selection, which says which Tab, if
        any, is selected.

        Attribute: Returns The TabPaneSelection of this TabPane.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Interface.Selections.TabPaneSelection

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(0)
                TabPaneSelection selection = pane:GetSelection()
                integer index = selection:GetIndex()
            end
        end
    */
    action GetSelection returns TabPaneSelection
        return selection
    end

    /*
        This action returns the selected Tab.

        Attribute: Returns The selected Tab, or undefined if no Tab is selected.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                pane:Select(0)
                Tab selected = pane:GetSelectedTab()
            end
        end
    */
    action GetSelectedTab returns Tab
        if selection = undefined
            return undefined
        end

        return selection:GetTab()
    end

    /*
        This action adds a listener that is told whenever a Tab is added to or
        removed from this TabPane.

        Attribute: Parameter listener The TabChangeListener to add.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Interface.Events.TabChangeListener
        use Libraries.Interface.Events.TabChangeEvent

        class Main is Game, TabChangeListener
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                pane:AddTabChangeListener(me)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                Add(pane)
            end

            action OpenedTab(TabChangeEvent event)
                output "Opened " + event:GetTab():GetName()
            end

            action ClosedTab(TabChangeEvent event)
                output "Closed " + event:GetTab():GetName()
            end
        end
    */
    action AddTabChangeListener(TabChangeListener listener)
        bar:AddTabChangeListener(listener)
    end

    /*
        This action removes a listener added with AddTabChangeListener, so it
        is no longer told when Tabs are added or removed.

        Attribute: Parameter listener The TabChangeListener to remove.
    */
    action RemoveTabChangeListener(TabChangeListener listener)
        bar:RemoveTabChangeListener(listener)
    end

    /*
    This action sets the Font to be used by this Control. How this Font is used
    varies between Controls, and in some cases the Control will ignore it 
    entirely (for example, ScrollPanes), but typically this sets the font that's
    used for the default label on many Controls, such as Buttons. If the Font
    is undefined, many Controls will omit their default label.

    Attribute: Parameter font The Font to use for this Control.
    */
    action SetFont(Font font)
        parent:Control:SetFont(font)
        if bar not= undefined
            bar:SetFont(font)
        end
    end

    /*
    This action sets the base Font size to be used by this Control, if the
    Control uses a Font.
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size) 
        if bar not= undefined
            bar:SetFontSize(size)
        end
    end

    /*
TabPanes don't usually accept focus on themselves. Instead, they redirect focus to their contents.
If the current tab has a focus target, that will receive the focus. If there isn't a target, the
TabPane will try to focus the tab's related item. If the related item isn't focusable, it'll focus
the first focusable item within the first generation of children of the related item instead.
    */
    action GainedFocus(FocusEvent event)
        if selection:IsEmpty() = true
            if bar:IsEmpty() = false
                Get(0):Activate()
            end
        else
            Tab tab = selection:GetTab()
            if tab:GetFocusTarget() not= undefined
                tab:GetFocusTarget():Focus()
            else
                Item2D relatedItem = tab:GetRelatedItem()
                Item2D focusable = GetFirstFocusableChild(relatedItem)
                if focusable not= undefined
                    focusable:Focus()
                end
            end
        end
        parent:Control:GainedFocus(event)
    end
    
    /*
        This action finds the first item that can take the focus, looking at an
        item and then at its children, depth first. The item itself is returned if
        it can take the focus.

        Attribute: Parameter item The item to start the search from.

        Attribute: Returns The first item that can take the focus, or undefined if there is none.
    */
    private action GetFirstFocusableChild(Item2D item) returns Item2D
        if item:IsFocusable()
            return item
        end
        
        Array<Item2D> children = item:GetChildren()
        integer i = 0
        repeat while i < children:GetSize()
            Item2D child = children:Get(i)
            Item2D target = GetFirstFocusableChild(child)
            if target not= undefined
                return target
            end
            i = i + 1
        end
        
        return undefined
    end
    
/*This action returns the amount of spacing, in non-scaled pixels, that will be placed
between each Tab in the TabBar. If a Tab has its own margin values set, then this
will be ignored for that Tab.

Attribute: Returns The default amount of pixels between each Tab.*/
    action GetTabSpacing returns number
        return bar:GetTabSpacing()
    end

/*This action sets the amount of spacing, in non-scaled pixels, that will be placed
between each Tab in the TabBar. If a Tab has its own margin values set, then this
will be ignored for that Tab.

Attribute: Parameter tabSpacing The default amount of pixels between each Tab.*/
    action SetTabSpacing(number tabSpacing)
        bar:SetTabSpacing(tabSpacing)
    end
    
    /*  This action returns the TabBar at the top of this TabPane.

        Attribute: Returns The TabBar associated with this TabPane.
    */
    action GetTabBar returns TabBar
        return bar
    end
end
