package Libraries.Interface.Controls

use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Item2D
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Label
use Libraries.Containers.Array
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Gradient
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.TextureRegion
use Libraries.Game.Graphics.Font
use Libraries.Interface.Views.View2D
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Views.LabelBoxToggleView
use Libraries.Interface.Behaviors.Controls.TabCloseBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.FocusEvent
use Libraries.Game.Graphics.PixelMap
use Libraries.Game.Graphics.Format
use Libraries.Interface.Views.ControlShaderView
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.SharedTextureManager
use Libraries.Game.Graphics.SharedTexture

/*
The Tab class is one tab in a TabPane. A Tab shows a name, and can also show
an icon and a close button. Each Tab has a related item, such as a panel of
controls, that the TabPane shows in its view area while the Tab is selected.
Clicking the close button removes the Tab from its TabPane.

Attribute: Author William Allee

Attribute: Example
use Libraries.Game.Game
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.Button

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        TabPane pane

        Tab homeTab
        homeTab:SetName("Home")
        Button homeButton
        homeButton:SetName("Welcome")
        homeTab:SetRelatedItem(homeButton)
        pane:Add(homeTab)

        Tab settingsTab
        settingsTab:SetName("Settings")
        Button settingsButton
        settingsButton:SetName("Change Settings")
        settingsTab:SetRelatedItem(settingsButton)
        pane:Add(settingsTab)

        Add(pane)
        pane:Select(0)
    end
end
*/
class Tab is Button
    TabPane container = undefined
    TabBar bar = undefined

    // The Item that is displayed in the TabPane when the Tab is activated.
    Item2D relatedItem = undefined

    // The Item that should receive focus when the Tab is activated. If left
    // undefined, the relatedItem is focused instead, if possible.
    Item2D focusTarget = undefined

    private boolean toggled = false
    LayoutProperties defaultProperties = undefined
    LayoutProperties iconLayoutProperties = undefined
    LayoutProperties labelLayoutProperties = undefined
    LayoutProperties buttonLayoutProperties = undefined

    CharacterIcon icon
    Label label
    Button closeButton
    // The close button's X, a picture on top of its hover square.
    Icon closeX

    // The last colors used to generate the "X" texture for the default close button.
    Color closeForeground = undefined
    Color closeAccent = undefined

    GameStateManager manager
    // Values used to track if the Tab or an item related to it is focused.
    boolean renderFocus = false
    Item lastKnownFocus = undefined
    
    // The first part of a key to the SharedTextureManager to store close icons.
    constant text CLOSE_TEXTURE_KEY_PREFIX = "Tab-"

    on create
label:SetAccessibilityCode(label:parent:Item:NOT_ACCESSIBLE)
        
        SetInterfaceOptionsKey("Tab")

        iconLayoutProperties = icon:GetDefaultLayoutProperties()
        iconLayoutProperties:SetHorizontalLayoutMode(iconLayoutProperties:MAINTAIN_ASPECT_RATIO)
        iconLayoutProperties:SetVerticalLayoutMode(iconLayoutProperties:STANDARD)
        iconLayoutProperties:SetPercentageWidth(1.0)
        iconLayoutProperties:SetPercentageHeight(1.0)
        iconLayoutProperties:SetTopMargin(4)
        iconLayoutProperties:SetBottomMargin(4)
        iconLayoutProperties:SetLeftMargin(4)
        
        defaultProperties = GetDefaultLayoutProperties()
        // Only the top edge has a border: the selected tab's accent line
        // (the Tab selection border in the interface options).
        defaultProperties:SetBorderStyle(defaultProperties:TOP)
        defaultProperties:SetHorizontalLayoutMode(defaultProperties:FIT_CONTENTS)
        defaultProperties:SetVerticalLayoutMode(defaultProperties:FIT_FONT)

        Font font = GetDefaultFont()
        if font not= undefined
            integer defaultFontSize = GetDefaultFontSize()
            defaultProperties:SetFont(font)
            defaultProperties:SetFontSize(defaultFontSize)
        end  

        labelLayoutProperties = label:GetDefaultLayoutProperties()
        buttonLayoutProperties = closeButton:GetDefaultLayoutProperties()

        SetAccessibilityCode(parent:Item:TAB)
        closeButton:SetName("Close")
        closeButton:SetFont(undefined)
        // The close button draws a hover square, with the X as a
        // picture on top of it.
        closeButton:SetInterfaceOptionsKey("TabClose")
        ManualLayout closeLayout
        closeButton:SetLayout(closeLayout)
        LayoutProperties xLayout = closeX:GetDefaultLayoutProperties()
        xLayout:SetPercentageWidth(1)
        xLayout:SetPercentageHeight(1)
        closeButton:Add(closeX)
        closeButton:SetAccessibilityCode(parent:Item:NOT_ACCESSIBLE)

        TabCloseBehavior behavior
        behavior:SetTab(me)
        closeButton:SetBehavior(behavior)

        labelLayoutProperties:SetHorizontalLayoutMode(labelLayoutProperties:FIT_CONTENTS)
        labelLayoutProperties:SetLeftMargin(7)
        labelLayoutProperties:SetRightMargin(7)

        buttonLayoutProperties:SetHorizontalLayoutMode(buttonLayoutProperties:MAINTAIN_ASPECT_RATIO)
        buttonLayoutProperties:SetVerticalLayoutMode(buttonLayoutProperties:STANDARD)
        buttonLayoutProperties:SetPercentageWidth(1.0)
        buttonLayoutProperties:SetPercentageHeight(1.0)
        buttonLayoutProperties:SetTopMargin(4)
        buttonLayoutProperties:SetBottomMargin(4)
        buttonLayoutProperties:SetRightMargin(4)

        icon:Hide()

        Add(icon)
        Add(label)
        Add(closeButton)
    end

    /*
        This action gets the containing tab pane for this tab.
    */
    action GetTabPane returns TabPane
        return container
    end

    /*
        This action sets the containing tab pane for this tab.
    */
    action SetTabPane(TabPane pane)
        me:container = pane
    end

    /*
        This action returns the TabBar this Tab is in.

        Attribute: Returns The TabBar holding this Tab, or undefined if it is not in one.
    */
    action GetTabBar returns TabBar
        return bar
    end

    /*
        This action sets the TabBar this Tab is in. The TabBar calls it when
        the Tab is added or removed, so most users won't need it.

        Attribute: Parameter bar The TabBar holding this Tab, or undefined.
    */
    action SetTabBar(TabBar bar)
        me:bar = bar
    end

    /*
        This action returns true, because a Tab is a parent for accessibility:
        screen readers treat the items inside it as its children.

        Attribute: Returns True, since a Tab is an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
        This action returns the font size a Tab uses unless another size is
        set, which is 14.

        Attribute: Returns The default font size, 14.
    */
    action GetDefaultFontSize returns integer
        return 14
    end

    /*
        This action sets the item the TabPane shows in its view area while
        this Tab is selected. When the Tab is activated, this item, or the
        first focusable item inside it, gets the focus.

        Attribute: Parameter item The item to show for this Tab.

        Attribute: Example
        use Libraries.Interface.Controls.Tab
        use Libraries.Interface.Controls.Button
        Tab tab
        tab:SetName("Home")
        Button button
        button:SetName("Welcome")
        tab:SetRelatedItem(button)
    */
    action SetRelatedItem(Item2D item)
        relatedItem = item
    end

    /*
        This action returns the item the TabPane shows in its view area while
        this Tab is selected.

        Attribute: Returns The related item, or undefined if none was set.
    */
    action GetRelatedItem returns Item2D
        return relatedItem
    end
    
    /*
        This action sets the Tab's icon to a character from a font, given by
        its unicode value. The icon is shown before the Tab's name. A value of
        -1 removes the icon.

        Attribute: Parameter unicodeValue The unicode value of the character to show, or -1 for no icon.

        Attribute: Parameter font The font to draw the character with.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Game.Graphics.Font

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Tab tab
                tab:SetName("Home")
                Font font = tab:GetDefaultFont()
                tab:SetIcon(9733, font)
                pane:Add(tab)
                Add(pane)
            end
        end
    */
    action SetIcon(integer unicodeValue, Font font)
        if unicodeValue = -1
            parent:Control:SetIcon(undefined)
            icon:Hide()
            return now
        end
        
icon:LoadCharacter(unicodeValue, font)
number aspectRatio = icon:GetWidth() / cast(number, icon:GetHeight())
            iconLayoutProperties:SetPercentageWidth(aspectRatio)
            icon:Show()
        parent:Control:SetIcon(icon)
    end
    
    /*
        This action sets the Tab's icon to a character from a font. The icon
        is shown before the Tab's name. An empty text removes the icon.

        Attribute: Parameter character The character to show, or "" for no icon.

        Attribute: Parameter font The font to draw the character with.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Game.Graphics.Font

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Tab tab
                tab:SetName("Notes")
                Font font = tab:GetDefaultFont()
                tab:SetIcon("N", font)
                pane:Add(tab)
                Add(pane)
            end
        end
    */
    action SetIcon(text character, Font font)
        if character = ""
            parent:Control:SetIcon(undefined)
            icon:Hide()
            return now
        end
        
        icon:LoadCharacter(character, font)
number aspectRatio = icon:GetWidth() / cast(number, icon:GetHeight())
            iconLayoutProperties:SetPercentageWidth(aspectRatio)
            icon:Show()
        parent:Control:SetIcon(icon)
    end

    /*
        This action sets the Tab's icon to the picture in the given Icon. The
        icon is shown before the Tab's name. An undefined Icon removes the
        icon.

        Attribute: Parameter newIcon The Icon whose picture to show, or undefined for no icon.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab
        use Libraries.Interface.Controls.Icon

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Tab tab
                tab:SetName("Pictures")
                Icon picture
                picture:Load("Resources/Picture.png")
                tab:SetIcon(picture)
                pane:Add(tab)
                Add(pane)
            end
        end
    */
    action SetIcon(Icon newIcon)
        parent:Control:SetIcon(newIcon)
        if newIcon = undefined
            icon:Hide()
        else
            icon:Load(newIcon)
            number aspectRatio = icon:GetWidth() / cast(number, icon:GetHeight())
            iconLayoutProperties:SetPercentageWidth(aspectRatio)
            icon:Show()
        end
    end

    /*
        This action sets the Tab's name. The name is the text shown on the
        Tab and read by screen readers, and the icon is named after it.

        Attribute: Parameter name The new name of the Tab.

        Attribute: Example
        use Libraries.Interface.Controls.Tab
        Tab tab
        tab:SetName("Home")
    */
    action SetName(text name)
        label:SetText(name)
        icon:SetName(name + " Icon")
        parent:Item2D:SetName(name)
    end

    /*
        This action shows or hides the Tab's name. A Tab with an icon can hide
        its name to save space.

        Attribute: Parameter display True to show the name, false to hide it.

        Attribute: Example
        use Libraries.Interface.Controls.Tab
        Tab tab
        tab:SetName("Home")
        tab:DisplayName(false)
    */
    action DisplayName(boolean display)
        displayLabel = display
        if display
            label:Show()
        else
            label:Hide()
        end
    end

    /*
        This action shows or hides the Tab's close button. A Tab without a
        close button can't be closed by the user.

        Attribute: Parameter display True to show the close button, false to hide it.

        Attribute: Example
        use Libraries.Interface.Controls.Tab
        Tab tab
        tab:SetName("Home")
        tab:DisplayCloseButton(false)
    */
    action DisplayCloseButton(boolean display)
        displayClose = display
        if display
            closeButton:Show()
        else
            closeButton:Hide()
        end
    end

    /*
        This action returns true if the Tab's close button is showing.

        Attribute: Returns True if the close button is showing.
    */
    action IsDisplayingCloseButton returns boolean
        return closeButton:IsShowing()
    end
    
    /*
        This action returns the Tab's close button. Clicking it removes the
        Tab from its TabPane.

        Attribute: Returns The close button.
    */
    action GetCloseButton returns Button
        return closeButton
    end

    /*
        This action selects the Tab when given true, or deselects it when
        given false. Selecting a Tab deselects the other Tabs in its TabBar,
        tells the TabPane to show the Tab's related item, and scrolls the Tab
        into view. Unlike TabPane's Select, it does not move the focus.

        Attribute: Parameter toggleState True to select the Tab, false to deselect it.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                tab:SetToggleState(true)
            end
        end
    */
    action SetToggleState(boolean toggleState)
        if toggled = toggleState
            return now
        end

        if toggleState = true and bar not= undefined
            bar:DeselectAll()
        end

        toggled = toggleState
        if GetView2D() is LabelBoxToggleView
            LabelBoxToggleView content = cast(LabelBoxToggleView, GetView2D())
            content:SetToggleState(toggleState)
        end
        if toggleState = true
            OnToggleOn()
        else
            OnToggleOff()
        end

        SetLabelRenderColor()
    end

    /*
        This action sets the color of the Tab's name: the selection font color
        while the Tab is selected and focused, the unfocused selection font
        color while it is selected but not focused, and the plain font color
        otherwise.
    */
    private action SetLabelRenderColor
        if label = undefined
            return now
        end

        if IsRenderingSelection()
            if IsRenderingFocus()
                label:SetColor(GetSelectionFontColor())
            else
                label:SetColor(GetUnfocusedSelectionFontColor())
            end
        else
            label:SetColor(GetFontColor())
        end
    end

    /*
        This action returns true if the Tab is drawn as selected.

        Attribute: Returns True if the Tab is selected.
    */
    action IsRenderingSelection returns boolean
        return toggled
    end

    /*
        This action returns true if the Tab should be drawn as focused: when
        the focus is on the Tab, its related item, its focus target, or
        anything inside them. When the focus has moved since the last check,
        it works the answer out again and updates the name's color.

        Attribute: Returns True if the Tab should be drawn as focused.
    */
    action IsRenderingFocus returns boolean
        if manager:GetFocus() not= lastKnownFocus
            renderFocus = CalculateRenderFocus()
            SetLabelRenderColor()
        end

        return renderFocus
    end

    /*
        This action records the item with the focus and returns true if that
        item, or any item holding it, is the Tab, its related item, or its
        focus target.

        Attribute: Returns True if the focus is on or inside the Tab or its items.
    */
    private action CalculateRenderFocus returns boolean
        lastKnownFocus = manager:GetFocus()

        if lastKnownFocus is Item2D
            Item2D focus = cast(Item2D, lastKnownFocus)
            repeat while focus not= undefined
                if focus:Equals(me) or focus = relatedItem or focus = focusTarget
                    return true
                end
                focus = focus:GetParent()
            end
        else
            return false
        end

        return false
    end

    /*
        This action returns true if the Tab is selected.

        Attribute: Returns True if the Tab is selected.
    */
    action IsActivated returns boolean
        return toggled
    end

    /*
        This action is called when the Tab becomes selected. It tells the
        TabPane to show the Tab's related item, and scrolls the TabBar so the
        Tab is in view.
    */
    action OnToggleOn
        if bar not= undefined
            TabPane pane = bar:GetTabPane()
            if pane not= undefined
                pane:UpdateSelection(me)
            end

            bar:FitTab(me)
        end
    end

    /*
        This action is called when the Tab stops being selected. It tells the
        TabPane to stop showing the Tab's related item.
    */
    action OnToggleOff
        if bar not= undefined
            TabPane pane = bar:GetTabPane()
            if pane not= undefined
                pane:UpdateSelection(undefined)
            end
        end
    end

    /*
    This action is fired when the Tab gains the focus. If the Tab is entirely
    out of view in its TabBar (for example, when the focus moves to it from
    the keyboard), the bar scrolls to show it.

    Attribute: Parameter event The FocusEvent describing the change of focus.
    */
    action GainedFocus(FocusEvent event)
        parent:Button:GainedFocus(event)
        if bar not= undefined
            bar:FitHiddenTab(me)
        end
    end

    /*
    The OnClose action is called when this Tab is closed (or in other words,
    when the Tab is removed from a TabPane or TabBar). By default, this action
    does nothing, but classes inheriting from Tab can override this action to
    perform clean up before closing the Tab.
    */
    action OnClose
    end

    /*
        This action lets go of the Tab's TabPane, TabBar, related item, focus
        target, and parts, and removes its children. The TabBar calls it after
        it removes the Tab, so the Tab can't be used after that.
    */
    action Dispose
        container = undefined
        bar = undefined

        // The Item that is displayed in the TabPane when the Tab is activated.
        relatedItem = undefined

        // The Item that should receive focus when the Tab is activated. If left
        // undefined, the relatedItem is focused instead, if possible.
        focusTarget = undefined

        defaultProperties = undefined
        iconLayoutProperties = undefined
        labelLayoutProperties = undefined
        buttonLayoutProperties = undefined

        icon = undefined
        label = undefined
        closeButton = undefined

        Empty()
    end

    /*
        This action activates the Tab, such as when the user clicks it or
        presses Enter on it. If the Tab isn't selected yet, it is selected
        first. Then the focus moves to the Tab's focus target if it has one,
        or else to the first focusable item in its related item. A Tab with
        no related item takes the focus itself.

        Attribute: Parameter event The event that caused the activation.
    */
    action Activate(BehaviorEvent event)
        if IsActivated()
            if relatedItem not= undefined
                if focusTarget not= undefined
                    focusTarget:Focus()
                else
                    Item2D target = GetFirstFocusableChild(relatedItem)
                    target:Focus()
                end
            else
                if bar not= undefined
                    TabPane pane = bar:GetTabPane()
                    if pane not= undefined
                        Focus()
                    end
                end
            end
        else
            SetToggleState(true)
            Activate()
        end
    end
    
    /*
        This action finds the first item that can take the focus, looking at an
        item and then at its children, depth first. The item itself is returned if
        it can take the focus.

        Attribute: Parameter item The item to start the search from.

        Attribute: Returns The first item that can take the focus, or undefined if there is none.
    */
    private action GetFirstFocusableChild(Item2D item) returns Item2D
        if item:IsFocusable()
            return item
        end
        
        Array<Item2D> children = item:GetChildren()
        integer i = 0
        repeat while i < children:GetSize()
            Item2D child = children:Get(i)
            Item2D target = GetFirstFocusableChild(child)
            if target not= undefined
                return target
            end
            i = i + 1
        end
        
        return undefined
    end

    /*
    For internal use only.
    */
    action GetLabel returns Label
        return label
    end
    
/*
    For internal use only.
    */
    action GetTabIcon returns CharacterIcon
        return icon
    end

    /*
    This action is used to load the graphical components of the Control. This is
    handled automatically by the Game engine as needed, and most users shouldn't
    need to use this action directly.
    */
    action LoadGraphics(LayoutProperties properties)
        if properties = undefined
            return now
        end

        TextureRegion region = properties:GetIcon()
        if region = undefined
            if icon:IsShowing()
                icon:Hide()
            end
        else
            if icon:IsShowing() = false
                icon:Load(region)
                number aspectRatio = icon:GetWidth() / cast(number, icon:GetHeight())
                iconLayoutProperties:SetPercentageWidth(aspectRatio)
                icon:Show()
            end
            ColorGroup iconColor = properties:GetIconColor()
            if iconColor = undefined
                Color color
                iconColor = color:White()
            end

            icon:SetColor(iconColor)
            icon:SetIconColor(iconColor)
        end

        Font font = properties:GetFont()
        if font not= undefined
            label:SetFont(font)
            label:SetSize(properties:GetFontSize())
        else
            label:Hide()
        end

        View2D view = properties:GetView2D()
        if view = undefined
            if GetView2D() = undefined
                ControlShaderView content
                content:Initialize()
                view = content
            else
                view = GetView2D()
            end
        end

        SetView2D(view)

        Color foreground = undefined
        if GetForegroundColor() not= undefined
            foreground = GetForegroundColor():GetBottomLeft()
        end
        
        Color accent = undefined
        if GetAccentColor() not= undefined
            accent = GetAccentColor():GetBottomLeft()
        end
        
        // Only regenerate the close texture if needed due to color changes
        if (foreground not= undefined and accent not= undefined) and
(closeForeground = undefined or closeAccent = undefined
                or foreground:GetRed() not= closeForeground:GetRed() or foreground:GetGreen() not= closeForeground:GetGreen() or foreground:GetGreen() not= closeForeground:GetGreen() or foreground:GetAlpha() not= closeForeground:GetAlpha()
                or accent:GetRed() not= closeAccent:GetRed() or accent:GetGreen() not= closeAccent:GetGreen() or accent:GetGreen() not= closeAccent:GetGreen() or accent:GetAlpha() not= closeAccent:GetAlpha())

            closeForeground = foreground
            closeAccent = accent
            Texture theX = GenerateX(100, 25, 10, closeForeground, closeAccent)
            closeX:Load(theX)
            if closeButton:GetView2D() = undefined
                ControlShaderView closeSurface
                closeSurface:Initialize()
                closeButton:SetView2D(closeSurface)
            end
        end
        
        SetLabelRenderColor()

        parent:Control:LoadGraphics(properties)
    end

    /*
        This action makes the picture for the close button: a filled circle in
        the background color with an X in the accent color on top. The
        picture is square, and the X stays the buffer distance away from its
        edges. Pictures are shared between Tabs with the same sizes and colors,
        so each one is only made once.

        Attribute: Parameter size The width and height of the picture, in pixels.

        Attribute: Parameter buffer How far the X stays from the picture's edges, in pixels.

        Attribute: Parameter width How thick the lines of the X are, in pixels.

        Attribute: Parameter background The color of the circle.

        Attribute: Parameter accent The color of the X.

        Attribute: Returns The texture holding the picture.
    */
    private action GenerateX(integer size, integer buffer, integer width, Color background, Color accent) returns Texture
        GameStateManager gameState
        SharedTextureManager textureManager = gameState:GetSharedTextureManager()
        text textureKey = CLOSE_TEXTURE_KEY_PREFIX + size + "-" + buffer + "-" + width
        integer backRed = cast(integer, background:GetRed() * 255)
integer backGreen = cast(integer, background:GetGreen() * 255)
integer backBlue = cast(integer, background:GetBlue() * 255)
integer backAlpha = cast(integer, background:GetAlpha() * 255)
integer accentRed = cast(integer, accent:GetRed() * 255)
integer accentGreen = cast(integer, accent:GetGreen() * 255)
integer accentBlue = cast(integer, accent:GetBlue() * 255)
integer accentAlpha = cast(integer, accent:GetAlpha() * 255)
        textureKey = textureKey + "-" + backRed + "/" + backGreen + "/" + backBlue + "/" + backAlpha
        textureKey = textureKey + "-" + accentRed + "/" + accentGreen + "/" + accentBlue + "/" + accentAlpha
        if textureManager:HasKey(textureKey)
            return textureManager:GetTexture(textureKey)
        end
        
        
        PixelMap map
        Format format
        format:SetValue(format:RGBA8888)
        map:CreatePixelMap(size, size, format)
        
        map:FillCircle(size / 2, size / 2, cast(integer, size * 0.43), background)
        integer x = buffer
        integer y = buffer
        repeat while x < size - buffer
            map:SetPixel(x, y, accent)
            map:SetPixel(x, size - y - 1, accent)

            integer theWidth = 1
            repeat while theWidth < width
                if y + theWidth < size - buffer
                    map:SetPixel(x, y + theWidth, accent)
                end

                if x + theWidth < size - buffer
                    map:SetPixel(x + theWidth, y, accent)
                end
                theWidth = theWidth + 1
            end

            theWidth = 1
            repeat while theWidth < width
                if x + theWidth < size - buffer
                    map:SetPixel(x + theWidth, size - y - 1, accent)
                end

                if size  - buffer- y - theWidth - 1 >= 0
                    map:SetPixel(x, size - y - theWidth - 1, accent)
                end
                theWidth = theWidth + 1
            end

            x = x + 1
            y = y + 1
        end

        SharedTexture texture
        texture:LoadFromPixelMap(map)
        textureManager:Add(textureKey, texture)
        return texture
    end

    /*
        This action sets the item that gets the focus when the Tab is
        activated. Without a focus target, the first focusable item in the
        Tab's related item gets the focus instead.

        Attribute: Parameter target The item to focus, or undefined to use the related item.

        Attribute: Example
        use Libraries.Interface.Controls.Tab
        use Libraries.Interface.Controls.TextBox
        Tab tab
        tab:SetName("Notes")
        TextBox notes
        tab:SetRelatedItem(notes)
        tab:SetFocusTarget(notes)
    */
    action SetFocusTarget(Item2D target)
        focusTarget = target
    end

    /*
        This action returns the item that gets the focus when the Tab is
        activated.

        Attribute: Returns The focus target, or undefined if none was set.
    */
    action GetFocusTarget returns Item2D
        return focusTarget
    end
    
end
