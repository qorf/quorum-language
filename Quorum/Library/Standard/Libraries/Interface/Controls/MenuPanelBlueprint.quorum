package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Game.Graphics.Shaders.Programs.ControlShaderProgram
use Libraries.Interface.Views.DropShadowView
use Libraries.Game.GameStateManager

/*
    The MenuPanelBlueprint class is the base for the boxes that hold the items of
    an open menu. It keeps the list of MenuItems shown in the panel, and it keeps
    the widths of the four columns each item is drawn in: the icon, the name, the
    keyboard shortcut, and the arrow that marks a submenu. Keeping these widths on
    the panel lets every item in the menu line up with the others. The MenuPanel
    and ScrollableMenuPanel classes are the two kinds of panel. Most programs never
    use these classes directly, because each MenuItem and PopupMenu makes its own
    panel.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Interface.Controls.MenuPanel
    use Libraries.Interface.Controls.MenuItem

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            MenuPanel panel
            MenuItem cut
            cut:SetName("Cut")
            MenuItem copy
            copy:SetName("Copy")
            panel:Add(cut)
            panel:Add(copy)
            output "The panel holds " + panel:GetSize() + " items."
        end
    end
*/
class MenuPanelBlueprint is Icon
    
    Array<MenuItem> menuItems

    number iconRegionWidth = 0
    number labelRegionWidth = 0
    number shortcutRegionWidth = 0
    number arrowRegionWidth = 0

    on create
        SetName("Menu Panel")
        SetInterfaceOptionsKey("MenuPanel")
        SetZ(-1)
    end

    /*
        This action sets the width of the icon column, the space at the left of each
        item where its icon is drawn. The menu's layout sets this to the width of the
        widest icon in the panel, so all of the names start at the same place.

        Attribute: Parameter width The width of the icon column, in pixels.
    */
    action SetIconRegionWidth(number width)
        iconRegionWidth = width
    end

    /*
        This action returns the width of the icon column, the space at the left of
        each item where its icon is drawn.

        Attribute: Returns The width of the icon column, in pixels.
    */
    action GetIconRegionWidth returns number
        return iconRegionWidth
    end

    /*
        This action sets the width of the name column, where the text of each item is
        drawn. The menu's layout sets this to the width of the widest name in the
        panel, so all of the shortcuts start at the same place.

        Attribute: Parameter width The width of the name column, in pixels.
    */
    action SetLabelRegionWidth(number width)
        labelRegionWidth = width
    end

    /*
        This action returns the width of the name column, where the text of each item
        is drawn.

        Attribute: Returns The width of the name column, in pixels.
    */
    action GetLabelRegionWidth returns number
        return labelRegionWidth
    end

    /*
        This action sets the width of the shortcut column, where the keyboard shortcut
        of each item is drawn. The menu's layout sets this to the width of the widest
        shortcut in the panel.

        Attribute: Parameter width The width of the shortcut column, in pixels.
    */
    action SetShortcutRegionWidth(number width)
        shortcutRegionWidth = width
    end

    /*
        This action returns the width of the shortcut column, where the keyboard
        shortcut of each item is drawn.

        Attribute: Returns The width of the shortcut column, in pixels.
    */
    action GetShortcutRegionWidth returns number
        return shortcutRegionWidth
    end

    /*
        This action sets the width of the arrow column, the space at the right of each
        item where an arrow shows that the item opens a submenu.

        Attribute: Parameter width The width of the arrow column, in pixels.
    */
    action SetArrowRegionWidth(number width)
        arrowRegionWidth = width
    end

    /*
        This action returns the width of the arrow column, the space at the right of
        each item where an arrow shows that the item opens a submenu.

        Attribute: Returns The width of the arrow column, in pixels.
    */
    action GetArrowRegionWidth returns number
        return arrowRegionWidth
    end

    /*
        This action adds a MenuItem to the end of the panel, below the items already
        in it.

        Attribute: Parameter item The MenuItem to add to the panel.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuPanel panel
                MenuItem undo
                undo:SetName("Undo")
                panel:Add(undo)
            end
        end
    */
    action Add(MenuItem item)
        menuItems:Add(item)
        parent:Control:Add(item)
    end

    /*
        This action adds a MenuItem to the panel at the given position. Position 0 is
        the top of the panel. The items already at or below that position move down
        one place.

        Attribute: Parameter index The position in the panel to add the item at.

        Attribute: Parameter item The MenuItem to add to the panel.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuPanel panel
                MenuItem paste
                paste:SetName("Paste")
                MenuItem copy
                copy:SetName("Copy")
                panel:Add(paste)
                // Put Copy above Paste.
                panel:Add(0, copy)
            end
        end
    */
    action Add(integer index, MenuItem item)
        menuItems:Add(index, item)
        parent:Control:Add(index, item)
    end

    /*
        This action returns the MenuItem at the given position in the panel. Position
        0 is the top of the panel.

        Attribute: Parameter index The position of the item in the panel.

        Attribute: Returns The MenuItem at that position.
    */
    action Get(integer index) returns MenuItem
        return menuItems:Get(index)
    end

    /*
        This action returns the last MenuItem in the panel, the one at the bottom.

        Attribute: Returns The last MenuItem in the panel.
    */
    action GetFromEnd returns MenuItem
        return menuItems:GetFromEnd()
    end

    /*
        This action takes a MenuItem out of the panel, so it is no longer shown in
        the menu.

        Attribute: Parameter item The MenuItem to remove.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuPanel panel
                MenuItem undo
                undo:SetName("Undo")
                panel:Add(undo)
                panel:Remove(undo)
            end
        end
    */
    action Remove(MenuItem item)
        menuItems:Remove(item)
        parent:Control:Remove(item)
    end

    /*
        This action takes the item at the given position out of the panel. Position 0
        is the top of the panel.

        Attribute: Parameter index The position of the item to remove.

        Attribute: Returns The item that was removed.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Item2D
        use Libraries.Interface.Controls.MenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuPanel panel
                MenuItem undo
                undo:SetName("Undo")
                panel:Add(undo)
                Item2D removed = panel:Remove(0)
            end
        end
    */
    action Remove(integer index) returns Item2D
        menuItems:RemoveAt(index)
        return parent:Control:Remove(index)
    end

    /*
        This action returns how many MenuItems are in the panel.

        Attribute: Returns The number of MenuItems in the panel.
    */
    action GetSize returns integer
        return menuItems:GetSize()
    end

    /*
        This action tells whether the panel has no MenuItems in it.

        Attribute: Returns true if the panel has no items, or false if it has at least one.
    */
    action IsEmpty returns boolean
        return menuItems:IsEmpty()
    end

    /*
        This action returns an Iterator that goes through the MenuItems in the panel,
        from top to bottom.

        Attribute: Returns An Iterator over the MenuItems in the panel.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Containers.Iterator
        use Libraries.Interface.Controls.MenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuPanel panel
                MenuItem cut
                cut:SetName("Cut")
                MenuItem copy
                copy:SetName("Copy")
                panel:Add(cut)
                panel:Add(copy)

                Iterator<MenuItem> iterator = panel:GetIterator()
                repeat while iterator:HasNext()
                    MenuItem item = iterator:Next()
                    output item:GetName()
                end
            end
        end
    */
    action GetIterator returns Iterator<MenuItem>
        return menuItems:GetIterator()
    end

    /*
        This action is used to load the graphical components of the panel: a filled
        background and a view that draws a drop shadow around it. This is handled
        automatically by the Game engine as needed, and most users shouldn't need to
        use this action directly.

        Attribute: Parameter properties The layout properties to load the graphics with.
    */
    action LoadGraphics(LayoutProperties properties)
        if GetShaderProgram() = undefined
            Color color
            color:SetColor(1, 1, 1, 1)
            LoadFilledRectangle(2, 2, color)
    
            GameStateManager gameState
            ShaderManager manager = gameState:GetShaderManager()
            ShaderProgram program = undefined
            if manager:HasShaderProgram("Control Shader Program")
                program = manager:GetShaderProgram("Control Shader Program")
            else
                ControlShaderProgram controlShader
                controlShader:Compile()
                program = controlShader
            end
            SetShaderProgram(program)
        end

        if GetView2D() = undefined
            DropShadowView view
            view:Initialize()
            SetView2D(view)
        end

        parent:Control:LoadGraphics(properties)
    end

    /*
        This action tells whether this panel scrolls through its items, showing only
        some of them at a time. Each kind of panel gives its own answer: a MenuPanel
        returns false, and a ScrollableMenuPanel returns true.

        Attribute: Returns true if the panel scrolls, or false if it shows all of its items.
    */
    blueprint action IsScrollable returns boolean

end