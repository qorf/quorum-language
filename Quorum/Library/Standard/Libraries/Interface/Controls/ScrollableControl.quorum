package Libraries.Interface.Controls

use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Events.MouseEvent
use Libraries.Compute.Math

/*
    The ScrollableControl class is the base for controls whose content can be
    bigger than the control itself, such as ScrollPane, TextBox and List. It
    makes a scroll bar for up and down scrolling and one for left and right
    scrolling, each a ScrollBarTrack with a ScrollBarControl handle inside it,
    and shows or hides them as needed. It keeps track of how far the content
    has been scrolled as a value between 0 and 1 in each direction. The mouse
    wheel, dragging a handle, clicking a track, and touch drags all move the
    view. Each class that extends this one says how big its content is, which
    control shows the content, and how far one turn of the mouse wheel should
    scroll.

    Each scroll bar can be shown only when the content does not fit
    (VISIBLE_IF_NEEDED, the default), always (ALWAYS_VISIBLE), or never
    (NEVER_VISIBLE).

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Controls.ScrollableControl

    Form form
    Page page = form:GetMainPage()

    ScrollableControl box = page:AddTextBox("Notes")
    box:SetVerticalBarVisibility(box:ALWAYS_VISIBLE)

    form:Display()
*/
class ScrollableControl is Control

    Control scrollableRegion = undefined
    ScrollBarTrack horizontalBar
    ScrollBarControl horizontalControl
    ScrollBarTrack verticalBar
    ScrollBarControl verticalControl

    // Values used for mouse wheel scrolling.
    Math math
    constant number liner = math:SquareRoot(math:Logarithm(1.1))

    // How thick the scroll bars are, before the interface scale.
    integer barThickness = 12

    // How round the bars' and handles' ends are, as a share of half their
    // thickness: 1 would be fully round, so this is a little less.
    constant number BAR_ROUNDING = 0.7

    /*
    Values representing how far the scroll bars have moved, where 0 is the start
    of a track (left/top) and 1 is the end of a track (right/bottom). Note that
    the values are calculated using the left/top edge of the scroll controls, so
    reaching a full value of 1.0 is an unlikely edge case.
    */
    number scrollPercentageX = 0
    number scrollPercentageY = 0

    // How much of the overall content can be seen in the view, as a ratio of overall width/height.
    number verticalViewRatio = 1
    number horizontalViewRatio = 1

    // The handles' lengths as a share of their tracks: the visible share of
    // the content, but never shorter than MinimumHandleLength.
    number verticalHandleRatio = 1
    number horizontalHandleRatio = 1

    public constant integer VISIBLE_IF_NEEDED = 1
    public constant integer ALWAYS_VISIBLE = 2
    public constant integer NEVER_VISIBLE = 3

    integer verticalMode = VISIBLE_IF_NEEDED
    integer horizontalMode = VISIBLE_IF_NEEDED
    
    on create
        scrollableRegion = GetScrollableRegion()
        scrollableRegion:SetPercentageWidth(1)
        scrollableRegion:SetPercentageHeight(1)

        SetClipping(true)

        ManualLayout layout
        parent:Control:SetLayout(layout)

        // Initialize the properties used to position the scroll bars.
        verticalBar:SetVertical(true)
        horizontalBar:SetVertical(false)
        verticalControl:SetVertical(true)
        horizontalControl:SetVertical(false)

        LayoutProperties verticalBarProperties = verticalBar:GetDefaultLayoutProperties()
        LayoutProperties verticalControlProperties = verticalControl:GetDefaultLayoutProperties()
        LayoutProperties horizontalBarProperties = horizontalBar:GetDefaultLayoutProperties()
        LayoutProperties horizontalControlProperties = horizontalControl:GetDefaultLayoutProperties()

        /*
        By default, the vertical bar has width equal to the bar thickness, has a
        height equal to the height of its container, and has its top right 
        corner touching the top right corner of the container.
        */
        verticalBarProperties:SetPercentageX(1)
        verticalBarProperties:SetPercentageOriginX(1)
        verticalBarProperties:SetPercentageY(1)
        verticalBarProperties:SetPercentageOriginY(1)
        verticalBarProperties:SetPercentageHeight(1)
        verticalBarProperties:SetPixelWidth(barThickness)

        /*
        The horizontal bar has width equal to its container's width, height
        equal to the bar thickness, and lies along the bottom of the text box.
        */
        horizontalBarProperties:SetPercentageX(0)
        horizontalBarProperties:SetPercentageY(0)
        horizontalBarProperties:SetPercentageWidth(1)
        horizontalBarProperties:SetPixelHeight(barThickness)

        /*
        The vertical control begins at the top of the bar, and its width fully
        fills the bar. Its height is not set here, instead being set during
        Resize().
        */
        verticalControlProperties:SetPercentageOriginY(1)
        verticalControlProperties:SetPercentageY(1)
        verticalControlProperties:SetPercentageX(0)
        verticalControlProperties:SetPercentageWidth(1)

        /*
        The horizontal control begins at the left of the bar, and its height
        fully fills the bar. Its width is not set here, instead being set during
        Resize().
        */
        horizontalControlProperties:SetPercentageX(0)
        horizontalControlProperties:SetPercentageY(0)
        horizontalControlProperties:SetPercentageHeight(1)

        parent:Control:Add(scrollableRegion)
        parent:Control:Add(verticalBar)
        parent:Control:Add(horizontalBar)
        verticalBar:Add(verticalControl)
        horizontalBar:Add(horizontalControl)

        // The bars and their handles have rounded ends.
        RoundEnds(verticalBar)
        RoundEnds(horizontalBar)
        RoundEnds(verticalControl)
        RoundEnds(horizontalControl)
    end

    /*
        This action rounds all four corners of a scroll bar track or handle, so
        its ends are almost fully round.

        Attribute: Parameter control The track or handle to round.
    */
    private action RoundEnds(Control control)
        control:SetTopLeftRounding(BAR_ROUNDING)
        control:SetTopRightRounding(BAR_ROUNDING)
        control:SetBottomLeftRounding(BAR_ROUNDING)
        control:SetBottomRightRounding(BAR_ROUNDING)
    end

    /*
    This action returns the total width of the content contained inside
    the scrollable region of this Control. If the content's width is larger
    than the width of the Control, then horizontal scrolling can be used.
    */
    blueprint action GetTotalContentWidth returns number

    /*
    This action returns the total height of the content contained inside
    the scrollable region of this Control. If the content's height is larger
    than the height of the Control, then vertical scrolling can be used.
    */
    blueprint action GetTotalContentHeight returns number

    /*
    This action returns the Control that represents the main content of the
    scrollable control. This is most commonly a pane or a specialized renderer
    used to display other elements inside of it.
    */
    blueprint action GetScrollableRegion returns Control
    
    /*
    This action returns how far the scrollable region should scroll vertically for
    a single "tick" of mouse scrolling on the y-axis. This value is returned as a
    percentage of the total content height (represented between 0 and 1).
    */
    blueprint action GetScrollIncrement returns number

    /*
    This action occurs just after the scroll positions are updated and just before Resizing occurs.
    It can be used to adjust any layout properties that need to be modified on the scrollable region
    before processing a resize.
    */
    private blueprint action RefreshScrollableRegion

    /*
    This action returns how far the content has been scrolled along the x-axis.
    In other words, it's a percentage represented between 0 and 1 indicating
    how far the horizontal scroll bar has been moved to the right.

    This percentage represents the position of the start of the scroll bar.
    For example, a scroll percent of 0.4 indicates that the view begins 40%
    of the way through the scrollable area. 
    */
    action GetScrollPercentageX returns number
        return scrollPercentageX
    end

    /*
    This action sets how far the view of content should be scrolled along the x-axis.
    In other words, it's a percentage represented between 0 and 1 indicating
    how far the horizontal scroll bar should be moved to the right.

    This percentage represents the position of the start of the scroll bar.
    For example, a scroll percent of 0.4 indicates that the view begins 40%
    of the way through the scrollable area. 
    */
    action SetScrollPercentageX(number scrollPercentageX)
        RefreshPaneView(scrollPercentageX, GetScrollPercentageY())
    end

    /*
    This action returns how far the content has been scrolled along the y-axis.
    In other words, it's a percentage represented between 0 and 1 indicating
    how far the vertical scroll bar has been moved down.

    This percentage represents the position of the start of the scroll bar.
    For example, a scroll percent of 0.4 indicates that the view begins 40%
    of the way through the scrollable area. 
    */
    action GetScrollPercentageY returns number
        return scrollPercentageY
    end

    /*
    This action sets how far the view of content should be scrolled along the y-axis.
    In other words, it's a percentage represented between 0 and 1 indicating
    how far the vertical scroll bar should be moved downwards.

    This percentage represents the position of the start of the scroll bar.
    For example, a scroll percent of 0.4 indicates that the view begins 40%
    of the way through the scrollable area. 
    */
    action SetScrollPercentageY(number scrollPercentageY)
        RefreshPaneView(GetScrollPercentageX(), scrollPercentageY)
    end

    /*
    This action returns a percentage (represented between 0 and 1) indicating how
    much of the content's width can be viewed in the scrollable region. For example,
    if the content is 400 pixels wide and the scrollable region is 100 pixels wide,
    the percent of viewable width returned will be 0.25.

    This value cannot be set directly. It is calculated from the dimensions of the
    content and the Control.
    */
    action GetScrollPercentageWidth returns number
        return horizontalViewRatio
    end

    /*
    This action returns a percentage (represented between 0 and 1) indicating how
    much of the content's height can be viewed in the scrollable region. For example,
    if the content is 400 pixels tall and the scrollable region is 100 pixels tall,
    the percent of viewable height returned will be 0.25.

    This value cannot be set directly. It is calculated from the dimensions of the
    content and the Control.
    */
    action GetScrollPercentageHeight returns number
        return verticalViewRatio
    end

    /*
    The Resize action is used to recalculate the size and position of Controls
    that are being controlled by a Layout. Calling Resize on an Item2D won't
    have a direct effect on it, but if the Item's children hierarchy contains
    any Controls, those Controls will be resized.
    */
    action Resize
        number height = GetHeight()
        number width = GetWidth()
        number totalHeight = GetTotalContentHeight()
        number totalWidth = GetTotalContentWidth()

        verticalViewRatio = height / totalHeight
        horizontalViewRatio = width / totalWidth

        boolean verticalVisible = (verticalViewRatio < 1.0 and verticalMode = VISIBLE_IF_NEEDED) or verticalMode = ALWAYS_VISIBLE
        boolean horizontalVisible = (horizontalViewRatio < 1.0 and horizontalMode = VISIBLE_IF_NEEDED) or horizontalMode = ALWAYS_VISIBLE
        number barHeight = height
        number barWidth = width
        /*
        If both bars are visible, we need to offset the total size of the bars so they can't overlap
        in the bottom right corner. Otherwise, if only one is visible, they're allowed to use the whole
        side of the spreadsheet view, so nix any previously set pixel values.
        */
        if verticalVisible and horizontalVisible
            verticalBar:SetPixelHeight(-barThickness)
            horizontalBar:SetPixelWidth(-barThickness)
            barHeight = height - barThickness * GetInterfaceScale()
            barWidth = width - barThickness * GetInterfaceScale()
            verticalViewRatio = barHeight / totalHeight
            horizontalViewRatio = barWidth / totalWidth
        else
            verticalBar:SetPixelHeight(0)
            horizontalBar:SetPixelWidth(0)
        end

        if verticalViewRatio > 1.0
            verticalViewRatio = 1.0
        end

        if horizontalViewRatio > 1.0
            horizontalViewRatio = 1.0
        end

        number gutterWidth = GetCombinedGutterWidth()

        verticalHandleRatio = GetHandleRatio(verticalViewRatio, barHeight)
        horizontalHandleRatio = GetHandleRatio(horizontalViewRatio, barWidth)

        if verticalVisible
            verticalControl:SetPercentageHeight(verticalHandleRatio)
            verticalBar:Show()
            scrollableRegion:SetPixelWidth(-barThickness - gutterWidth / GetInterfaceScale())
        else
            verticalBar:Hide()
            scrollableRegion:SetPixelWidth(-gutterWidth / GetInterfaceScale())
        end

        scrollableRegion:SetPixelX(gutterWidth)

        if horizontalVisible
            horizontalControl:SetPercentageWidth(horizontalHandleRatio)
            horizontalBar:Show()
            // Currently, ManualLayout applies interface scale to dimensions, but not to positions. Thus only the Y needs the scale applied manually.
            scrollableRegion:SetPixelHeight(-barThickness)
            scrollableRegion:SetPixelY(barThickness * GetInterfaceScale())
        else
            horizontalBar:Hide()
            scrollableRegion:SetPixelHeight(0)
            scrollableRegion:SetPixelY(0)
        end
        
        // if the scroll pane is attempting to use corner rounding passthrough the values or 
        // remove the rounding if it bar would be visible
        // this assumes that the scrollable control is going to have the rounding values
        scrollableRegion:SetTopLeftPixelRounding(GetTopLeftPixelRounding())
        if horizontalVisible
            scrollableRegion:SetBottomRightPixelRounding(0)
            scrollableRegion:SetBottomLeftPixelRounding(0)
        else
            scrollableRegion:SetBottomRightPixelRounding(GetBottomRightPixelRounding())
            scrollableRegion:SetBottomLeftPixelRounding(GetBottomLeftPixelRounding())
        end
        if verticalVisible
            scrollableRegion:SetBottomRightPixelRounding(0)
            scrollableRegion:SetTopRightPixelRounding(0)
        else
            scrollableRegion:SetBottomRightPixelRounding(GetBottomRightPixelRounding())
            scrollableRegion:SetTopRightPixelRounding(GetTopRightPixelRounding())
        end

        // The RefreshPaneView action will call the parent resize, so layouts will be applied then.
        RefreshPaneView(GetScrollPercentageX(), GetScrollPercentageY())

        /*
        It's possible that refreshing the pane view can result in a change to total content width/height due to scroll region resizing.
        If that happens, the view ratios change, which means that the scroll bars won't be the correct size. If that happens, we need to
        recalculate the ratios and selectively resize just the scroll bars to correct them to the right size.
        */
        if GetTotalContentHeight() not= totalHeight
            verticalViewRatio = height / GetTotalContentHeight()
            if verticalViewRatio > 1.0
                verticalViewRatio = 1.0
            end

            if verticalVisible = false
                // In this case, we didn't know ahead of time that we needed to display the vertical bar, but now we have to.
                // Unfortunately we just need to layout again now that we have more info.
                if (verticalViewRatio < 1.0 and verticalMode = VISIBLE_IF_NEEDED) or verticalMode = ALWAYS_VISIBLE
                    Resize()
                    return now
                end
            else
                verticalHandleRatio = GetHandleRatio(verticalViewRatio, barHeight)
                verticalControl:SetPercentageHeight(verticalHandleRatio)
                verticalControl:SetPercentageY(1.0 - ToTrack(scrollPercentageY, verticalViewRatio, verticalHandleRatio))
            end

            verticalBar:Resize()
        end

        if GetTotalContentWidth() not= totalWidth
            horizontalViewRatio = width / GetTotalContentWidth()
            if horizontalViewRatio > 1.0
                horizontalViewRatio = 1.0
            end

            if horizontalVisible = false
                // In this case, we didn't know ahead of time that we needed to display the horizontal bar, but now we have to.
                // Unfortunately we just need to layout again now that we have more info.
                if (horizontalViewRatio < 1.0 and horizontalMode = VISIBLE_IF_NEEDED) or horizontalMode = ALWAYS_VISIBLE
                    Resize()
                    return now
                end
            else
                horizontalHandleRatio = GetHandleRatio(horizontalViewRatio, barWidth)
                horizontalControl:SetPercentageWidth(horizontalHandleRatio)
                horizontalControl:SetPercentageX(ToTrack(scrollPercentageX, horizontalViewRatio, horizontalHandleRatio))
            end

            horizontalBar:Resize()
        end
    end

    /*
        This action scrolls the view to a position. It keeps each value within the
        range the content allows, moves the scroll bars' handles to match, and then
        refreshes the scrolled content and the gutter.

        Attribute: Parameter percentX How far across to scroll, from 0 up to 1 minus the share of the content's width that can be seen.

        Attribute: Parameter percentY How far down to scroll, from 0 up to 1 minus the share of the content's height that can be seen.
    */
    private action RefreshPaneView(number percentX, number percentY)
        if percentX > (1.0 - horizontalViewRatio)
            percentX = 1.0 - horizontalViewRatio
        elseif percentX < 0.0
            percentX = 0.0
        end

        if percentY > (1.0 - verticalViewRatio)
            percentY = 1.0 - verticalViewRatio
        elseif percentY < 0.0
            percentY = 0.0
        end

        horizontalControl:SetPercentageX(ToTrack(percentX, horizontalViewRatio, horizontalHandleRatio))
        verticalControl:SetPercentageY(1.0 - ToTrack(percentY, verticalViewRatio, verticalHandleRatio))

        scrollPercentageX = percentX
        scrollPercentageY = percentY

        parent:Control:Resize()

        RefreshScrollableRegion()
        RefreshGutterRegion()
    end

    /*
        This action returns how far the content should be moved to the right to
        make room for gutters along the left side. A plain ScrollableControl has
        no gutters, so it returns 0. ScrollableLineControl changes this to return
        the combined width of its gutters.

        Attribute: Returns The width taken by gutters, in pixels.
    */
    private action GetCombinedGutterWidth returns number
        // By default, this does nothing, but ScrollableLineControl overrides this to offset elements by the width of the gutters.
        return 0
    end

    /*
        This action is called after the view moves, so that gutters can be brought
        up to date. A plain ScrollableControl has no gutters, so it does nothing.
        ScrollableLineControl changes this to update its gutters.
    */
    private action RefreshGutterRegion
        // By default, this does nothing, but ScrollableLineControl overrides this to handle gutter values at the right time.
    end

    /*
        This action turns a place along the vertical scroll bar into how far the
        content is scrolled down. Dragging the handle uses it. The place is in
        pixels from the bottom of this control; when the horizontal scroll bar is
        showing, its thickness is taken off first.

        Attribute: Parameter y The place, in pixels from the bottom of this control.

        Attribute: Returns How far the content is scrolled down, as a share from 0 to 1.
    */
    action GetVerticalTrackPercentage(number y) returns number
        number sharedSpaceOffset = 0
        if horizontalBar:IsShowing()
            sharedSpaceOffset = barThickness * GetInterfaceScale()
        end

        return FromTrack(1.0 - (y - sharedSpaceOffset) / verticalBar:GetHeight(), verticalViewRatio, verticalHandleRatio)
    end

    /*
        This action turns a place along the horizontal scroll bar into how far the
        content is scrolled across. Dragging the handle uses it. The place is in
        pixels from the left edge of this control.

        Attribute: Parameter x The place, in pixels from the left edge of this control.

        Attribute: Returns How far the content is scrolled across, as a share from 0 to 1.
    */
    action GetHorizontalTrackPercentage(number x) returns number
        return FromTrack(x / horizontalBar:GetWidth(), horizontalViewRatio, horizontalHandleRatio)
    end

    /*
        This action returns the shortest a scroll bar's handle can be, in pixels:
        twice the bar's thickness, at the interface scale.

        Attribute: Returns The shortest handle length, in pixels.
    */
    private action MinimumHandleLength returns number
        return barThickness * 2 * GetInterfaceScale()
    end

    /*
        This action returns how long a scroll bar's handle is, as a share of its
        track. It is the share of the content that can be seen, but never shorter
        than MinimumHandleLength allows.

        Attribute: Parameter viewRatio How much of the content can be seen at once, from 0 to 1.

        Attribute: Parameter trackLength The track's length, in pixels.

        Attribute: Returns The handle's length as a share of its track, or the view ratio if the track has no length.
    */
    private action GetHandleRatio(number viewRatio, number trackLength) returns number
        if trackLength <= 0
            return viewRatio
        end
        number minimum = MinimumHandleLength() / trackLength
        if minimum > 1.0
            minimum = 1.0
        end
        if viewRatio < minimum
            return minimum
        end
        return viewRatio
    end

    /*
    Converts how far the content is scrolled (0 to 1 - viewRatio) into where
    the handle's start sits on its track (0 to 1 - handleRatio), and back.
    They are the same when the handle is its natural length.
    */
    private action ToTrack(number scrolled, number viewRatio, number handleRatio) returns number
        if viewRatio >= 1.0
            return 0
        end
        return scrolled * (1.0 - handleRatio) / (1.0 - viewRatio)
    end

    /*
        This action turns a handle's place on its track back into how far the
        content is scrolled. It is the reverse of ToTrack. Both values are shares
        between 0 and 1.

        Attribute: Parameter track Where the start of the handle sits on its track.

        Attribute: Parameter viewRatio How much of the content can be seen at once.

        Attribute: Parameter handleRatio How long the handle is, as a share of its track.

        Attribute: Returns How far the content is scrolled, or 0 if the handle fills the whole track.
    */
    private action FromTrack(number track, number viewRatio, number handleRatio) returns number
        if handleRatio >= 1.0
            return 0
        end
        return track * (1.0 - viewRatio) / (1.0 - handleRatio)
    end

    /*
    The PageVertically action moves the view by one view's height, toward
    the top (up is true) or the bottom, as a click on the scroll bar's
    track does.

    Attribute: Parameter up True to move toward the top.
    */
    action PageVertically(boolean up)
        number change = verticalViewRatio
        if up
            change = -change
        end
        RefreshPaneView(GetScrollPercentageX(), GetScrollPercentageY() + change)
    end

    /*
    The PageHorizontally action moves the view by one view's width, toward
    the left (left is true) or the right.

    Attribute: Parameter left True to move toward the left.
    */
    action PageHorizontally(boolean left)
        number change = horizontalViewRatio
        if left
            change = -change
        end
        RefreshPaneView(GetScrollPercentageX() + change, GetScrollPercentageY())
    end

    /*
    The CanScrollVertically action returns whether this control's view can
    move further toward the top of its content (up is true) or toward the
    bottom. It is false when all of the content already fits.

    Attribute: Parameter up True to ask about moving toward the top.
    Attribute: Returns True if the view can move further that way.
    */
    action CanScrollVertically(boolean up) returns boolean
        if verticalViewRatio >= 1.0
            return false
        end
        if up
            return scrollPercentageY > 0
        end
        return scrollPercentageY < 1.0 - verticalViewRatio
    end

    /*
    The ScrollByDrag action moves the view with a finger's drag on a touch
    screen. The distance is in pixels, with a drag up positive: the content
    follows the finger, so a drag up shows more of the content below.

    Attribute: Parameter distanceY How far the finger moved up, in pixels.
    */
    action ScrollByDrag(number distanceY)
        if verticalViewRatio >= 1.0 or GetHeight() <= 0
            return now
        end
        number totalHeight = GetHeight() / verticalViewRatio
        RefreshPaneView(GetScrollPercentageX(), GetScrollPercentageY() + distanceY / totalHeight)
    end

    /*
        This action scrolls the view up or down when the mouse wheel turns over
        this control. The input system calls it, so most programs don't need to.
        Each line scrolls by the amount from GetScrollIncrement. A bigger turn of
        the wheel scrolls more lines, but the number of lines grows slowly, so a
        fast spin doesn't jump too far. It always scrolls at least one line.

        Attribute: Parameter event The mouse event that says how far the wheel turned.
    */
    action ScrolledMouse(MouseEvent event)
        number y = event:scrollAmount
        boolean positive = true
        if y < 0
            positive = false
            y = y * -1
        end

        y = y + 1
        y = math:SquareRoot(math:Logarithm(y))
        number lines = cast(integer, y / liner)
        if lines <= 1
            lines = 1
        end

        number heightChange = -GetScrollIncrement() * lines

        if not positive
            heightChange = heightChange * -1
        end

        RefreshPaneView(GetScrollPercentageX(), GetScrollPercentageY() + heightChange)
    end

    /*
        This action returns whether the horizontal (left and right) scroll bar is
        showing. This depends on the bar's visibility mode and on whether the
        content is wider than the control, and is updated when the control is
        resized.

        Attribute: Returns True if the horizontal scroll bar is showing.
    */
    action IsShowingHorizontalBar returns boolean
        return horizontalBar:IsShowing()
    end

    /*
        This action returns whether the vertical (up and down) scroll bar is
        showing. This depends on the bar's visibility mode and on whether the
        content is taller than the control, and is updated when the control is
        resized.

        Attribute: Returns True if the vertical scroll bar is showing.
    */
    action IsShowingVerticalBar returns boolean
        return verticalBar:IsShowing()
    end

    /*
        This action returns how thick the scroll bars are, in pixels, before the
        interface scale is applied. The default is 12.

        Attribute: Returns The thickness of the scroll bars.
    */
    action GetBarThickness returns integer
        return barThickness
    end

    /*
        This action sets how thick the scroll bars are, in pixels, before the
        interface scale is applied. It changes both bars. The handles are never
        shorter than twice this thickness, so they stay easy to grab.

        Attribute: Parameter barThickness The new thickness of the scroll bars.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Layouts.ManualLayout
        use Libraries.Interface.Controls.ScrollPane
        use Libraries.Interface.Controls.Button

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                ManualLayout layout
                SetLayout(layout)

                ScrollPane pane
                pane:SetPixelWidth(200)
                pane:SetPixelHeight(150)
                pane:SetBarThickness(20)

                integer i = 0
                repeat 20 times
                    Button button
                    button:SetName("Item " + i)
                    pane:Add(button)
                    i = i + 1
                end
                Add(pane)
            end
        end
    */
    action SetBarThickness(integer barThickness)
        me:barThickness = barThickness
        verticalBar:GetDefaultLayoutProperties():SetPixelWidth(barThickness)
        horizontalBar:GetDefaultLayoutProperties():SetPixelHeight(barThickness)
    end

    /*
        This action sets when the vertical (up and down) scroll bar is shown. The
        mode is one of VISIBLE_IF_NEEDED (the default), which shows the bar only
        when the content is taller than the control, ALWAYS_VISIBLE, or
        NEVER_VISIBLE. The change shows the next time the control is resized.

        Attribute: Parameter mode The visibility mode for the vertical scroll bar.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Layouts.ManualLayout
        use Libraries.Interface.Controls.ScrollPane
        use Libraries.Interface.Controls.Button

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                ManualLayout layout
                SetLayout(layout)

                ScrollPane pane
                pane:SetPixelWidth(200)
                pane:SetPixelHeight(150)
                pane:SetVerticalBarVisibility(pane:ALWAYS_VISIBLE)

                integer i = 0
                repeat 20 times
                    Button button
                    button:SetName("Item " + i)
                    pane:Add(button)
                    i = i + 1
                end
                Add(pane)
            end
        end
    */
    action SetVerticalBarVisibility(integer mode)
        me:verticalMode = mode
    end

    /*
        This action sets when the horizontal (left and right) scroll bar is shown.
        The mode is one of VISIBLE_IF_NEEDED (the default), which shows the bar
        only when the content is wider than the control, ALWAYS_VISIBLE, or
        NEVER_VISIBLE. The change shows the next time the control is resized.

        Attribute: Parameter mode The visibility mode for the horizontal scroll bar.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Layouts.ManualLayout
