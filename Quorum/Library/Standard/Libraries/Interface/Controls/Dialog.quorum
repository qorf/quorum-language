package Libraries.Interface.Controls

use Libraries.Game.Game
use Libraries.Game.GameStateManager
use Libraries.Game.Layer
use Libraries.Game.DialogLayer
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Gradient
use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.PixelMap
use Libraries.Game.Graphics.Format
use Libraries.Interface.Behaviors.Controls.DialogHideBehavior
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Views.DropShadowView
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormPrimitiveContainer
use Libraries.Interface.Pages.StackedRowPage
use Libraries.Game.InputSet
use Libraries.Interface.Behaviors.Controls.MouseOnBehavior
use Libraries.Interface.Views.DrawableView
use Libraries.Containers.Iterator
use Libraries.Game.GameDisplay
use Libraries.Compute.Math

/*
    The Dialog class is a window that appears above the rest of a game or
    application, such as a settings window or a message that needs an answer. A
    Dialog is not added to another item. Instead, calling Show places it on its
    own layer in the middle of the screen, and Hide takes it away. By default a
    Dialog has a top bar with its name and a close button. A modal Dialog, set
    with SetModal, blocks input to everything else until it closes. The easiest
    way to fill a Dialog is to call InitializeDefaultPage, which gives a Page to
    add buttons, labels and other controls to. The OnShow and OnHide actions can
    be overridden in a subclass to do work when the Dialog opens or closes.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Interface.Controls.Dialog
    use Libraries.Interface.Forms.Page

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            Dialog dialog
            dialog:SetName("Settings")
            dialog:SetModal(true)
            dialog:SetPixelWidth(400)
            dialog:SetPixelHeight(250)

            Page page = dialog:InitializeDefaultPage()
            page:AddLabel("Choose your options.")
            page:AddButton("Done")

            dialog:Show()
        end
    end
*/
class Dialog is Control, FormPrimitiveContainer
    Behavior defaultBehavior = undefined
    
    GameStateManager manager
    boolean isModal = false
    boolean showTopBar = true

    Control topBar
    
    // use a page for defaults to help make dialogs
    boolean useDefaultPage = true
    Page currentPage = undefined
    Page defaultPage = undefined

    // Fit to contents (SetFitToContents): the width is a share of the
    // window, kept between a minimum and a maximum in points before the
    // interface scale, and the height is the page's content plus the bar.
    boolean fitToContents = false
    number fitWidthShare = 0.5
    number fitMinimumWidth = 360
    number fitMaximumWidth = 720
    Math math
    // True while the Dialog works out its size, so the Resize that setting
    // its size causes doesn't start again.
    boolean fitting = false
    // A Dialog that fits its contents is never larger than this share of
    // the window; content that doesn't fit scrolls in the page.
    constant number WINDOW_SHARE = 0.9

    // The top bar's height, in points before the interface scale.
    constant number BAR_HEIGHT = 32
    // Space between the bar's edges and its name and close button.
    constant number BAR_SIDE_PADDING = 16
    constant number CLOSE_BUTTON_SIZE = 26

    on create
        SetName("Dialog")
        SetInputGroup("Dialog")
        SetInterfaceOptionsKey("Dialog")
        
        topBar:SetInterfaceOptionsKey("DialogBar")

        LayoutProperties properties = GetDefaultLayoutProperties()
        // The bar draws the top of the dialog's outline, all the way round
        // its rounded top corners; its bottom edge is the line between the
        // bar and the body. The body draws the outline's sides and bottom.
        topBar:SetBorderStyle(properties:ALL)
        
        properties:SetHorizontalLayoutMode(properties:STANDARD)
        properties:SetVerticalLayoutMode(properties:FIT_CONTENTS)
        properties:SetPercentageX(0.5)
        properties:SetPercentageY(0.5)
        properties:SetPercentageOriginX(0.5)
        properties:SetPercentageOriginY(0.5)
        SetAccessibilityCode(parent:Item:DIALOG)
        parent:Item:visible = false
    end

    /*
        This action gets a default behavior for a hypothetical "ok" style button
        that the dialog will fire if "enter" is pressed on the keyboard. If no behavior
        is set, then no work will be done.
    */
    action GetBehavior returns Behavior
        return defaultBehavior
    end

    /*
        This action sets a default behavior for a hypothetical "ok" style button
        that the dialog will fire if "enter" is pressed on the keyboard. If no behavior
        is set, then no work will be done.
    */
    action SetBehavior(Behavior behavior)
        defaultBehavior = behavior
    end

    /*
    This action displays the Dialog in the Game window. When the Dialog is
    displayed, the OnShow() action will be called.
    */
    action Show
        if IsShowing()
            return now
        end
        Game game = manager:GetGame()
        DialogLayer layer = game:GetDialogLayerPool():GetDialogLayer()

        layer:SetModal(isModal)
        game:AddLayer(layer)

        FlowLayout layout
        SetLayout(layout)

        ManualLayout layerLayout
        layer:SetLayout(layerLayout)
        
        LayoutProperties properties = GetDefaultLayoutProperties()
        
        if showTopBar and GetChildren():Get(0):Equals(topBar) = false
            Control bar = topBar
            ControlShaderView barView
            barView:Initialize()
            bar:SetView2D(barView)

            Label nameLabel
nameLabel:SetAccessibilityCode(nameLabel:parent:Item:NOT_ACCESSIBLE)
            Font font = properties:GetFont()
            if font = undefined
                font = nameLabel:GetFont()
            end

            LayoutProperties barProperties = bar:GetDefaultLayoutProperties()
            // Bar will use manual layout for now, which doesn't respect these.
//            barProperties:SetHorizontalLayoutMode(barProperties:STANDARD)
//            barProperties:SetVerticalLayoutMode(barProperties:FIT_FONT)

            // Because we're using a manual layout, we need to set a concrete value. This should change in the future.
            number barHeight = BAR_HEIGHT
            // ManualLayout scales sizes but not positions, so the side
            // padding is scaled here.
            number scale = game:GetInterfaceScale()

            barProperties:SetFont(font)
            barProperties:SetPercentageWidth(1.0)
            barProperties:SetPixelHeight(barHeight)

            ManualLayout manualLayout
            bar:SetLayout(manualLayout)

            LayoutProperties labelProperties = nameLabel:GetDefaultLayoutProperties()
            labelProperties:SetPercentageOriginX(0)
            labelProperties:SetPercentageX(0)
            labelProperties:SetPixelX(BAR_SIDE_PADDING * scale)
            labelProperties:SetPercentageOriginY(0.5)
            labelProperties:SetPercentageY(0.5)
            labelProperties:SetPixelY(4)
            nameLabel:SetFontSize(16)

            nameLabel:SetText(GetName())
            nameLabel:SetFontColor(topBar:GetFontColor())
            bar:Add(nameLabel)

            Button closeButton
            DialogHideBehavior hideBehavior
            hideBehavior:SetDialog(me)
            closeButton:SetBehavior(hideBehavior)

            ManualLayout buttonLayout
            closeButton:SetLayout(buttonLayout)
            closeButton:Add(GenerateX())
            
            LayoutProperties buttonProperties = closeButton:GetDefaultLayoutProperties()
            buttonProperties:SetHorizontalLayoutMode(buttonProperties:STANDARD)
            buttonProperties:SetVerticalLayoutMode(buttonProperties:STANDARD)
            closeButton:SetInterfaceOptionsKey("DialogClose")
            // The button draws its own hover square behind the X; with
            // no label or icon, Button gives it no view of its own.
            ControlShaderView closeSurface
            closeSurface:Initialize()
            closeButton:SetView2D(closeSurface)
            buttonProperties:SetPixelHeight(CLOSE_BUTTON_SIZE)
            buttonProperties:SetPixelWidth(CLOSE_BUTTON_SIZE)
            buttonProperties:SetPercentageOriginX(1.0)
            buttonProperties:SetPercentageX(1)
            buttonProperties:SetPixelX((CLOSE_BUTTON_SIZE - BAR_HEIGHT) / 2.0 * scale)
            buttonProperties:SetPercentageOriginY(0.5)
            buttonProperties:SetPercentageY(0.5)
            buttonProperties:SetFont(undefined)
            

            closeButton:SetName("Close")

            bar:Add(closeButton)

            Add(0, bar)
        end
        
        layer:SetInterfaceScale(game:GetInterfaceScale())

        layer:OnShow()
        layer:Add(me)
        
        RequestLayout()

        parent:Item:Show()
        OnShow()
    end

    /*
    This action generates the texture used for the close button in the Dialog.
    */
    private action GenerateX() returns Icon
        Color color
        Icon closeIcon
        ControlShaderView closeView
        closeView:Initialize()
        closeIcon:SetView2D(closeView)
        ManualLayout closeLayout
        closeIcon:SetLayout(closeLayout)
        closeIcon:SetPercentageHeight(1.0)
        closeIcon:SetPercentageWidth(1.0)
        LayoutProperties properties
        //closeIcon:SetBackgroundColor(color:CustomColor(0,0,0,0))
        // Clear, so the button's hover and focus colors show through.
        closeIcon:SetBackgroundColor(color:CustomColor(0, 0, 0, 0))
        
        Control stroke1
        ControlShaderView strokeView
        strokeView:Initialize()
        stroke1:SetView2D(strokeView)
        stroke1:SetBackgroundColor(topBar:GetFontColor())
        stroke1:SetPercentageWidth(0.55)
        stroke1:SetPercentageHeight(0.08)
        stroke1:SetCornerRounding(1,1,1,1)
        stroke1:SetRotation(45)
        stroke1:SetPercentageOriginX(0.5)
        stroke1:SetPercentageOriginY(0.5)
        stroke1:SetPercentageX(0.5)
        stroke1:SetPercentageY(0.5)
        closeIcon:Add(stroke1)
        
        Control stroke2
        ControlShaderView stroke2View
        stroke2View:Initialize()
        stroke2:SetView2D(stroke2View)
        stroke2:SetBackgroundColor(topBar:GetFontColor())
        stroke2:SetPercentageWidth(0.55)
        stroke2:SetPercentageHeight(0.08)
        stroke2:SetCornerPixelRounding(5,5,5,5)
        stroke2:SetRotation(-45)
        stroke2:SetPercentageOriginX(0.5)
        stroke2:SetPercentageOriginY(0.5)
        stroke2:SetPercentageX(0.5)
        stroke2:SetPercentageY(0.5)
        closeIcon:Add(stroke2)
        return closeIcon
    end

    /*
    This action is called whenever the Dialog is displayed on the screen. This
    action does nothing by default, but can be overriden with user-defined code.
    */
    action OnShow
        
    end

    /*
    This action closes the Dialog, if it's currently displayed in the Game. When
    the Dialog is hidden with this call, the OnHide() action will be called.
    */
    action Hide
        Game game = manager:GetGame()
        Layer layer = GetLayer()
        if layer is DialogLayer
            DialogLayer dialogLayer = cast(DialogLayer, layer)
            dialogLayer:Remove(me)
            dialogLayer:OnHide()
            game:RemoveLayer(dialogLayer)

            game:GetDialogLayerPool():Recycle(dialogLayer)
        else
            return now
        end
        
        parent:Item:Hide()
        OnHide()
    end

    /*
    This action is called when the Dialog is hidden with the Hide() action. By
    default this action does nothing, but it can be overriden with user-defined
    code to perform tasks when the Dialog is closed.
    */
    action OnHide

    end

    /*
    This action is typically used to set the parent of an Item2D or Control, but
    Dialogs can't be added as children of other items directly. Calling this
    action with any value that isn't undefined will alert a runtime error.
    */
    action SetParent(Item2D item)
        if item not= undefined
            alert("I couldn't set the item " + item:GetName() + " as the parent of the dialog " + GetName() + " because Dialogs can't have parent Items.")
        else
            parent:Control:SetParent(item)
        end
    end

    /*
    This action is used to set if the Dialog is modal or not. A modal Dialog 
    prevents input from reaching other parts of the application while the
    Dialog is displayed -- for example, clicking outside of the Dialog on a
    Button will not trigger the Button if the Dialog is modal.
    */
    action SetModal(boolean value)
        isModal = value
        if GetLayer() is DialogLayer
            DialogLayer layer = cast(DialogLayer, GetLayer())
            layer:SetModal(value)
        end
    end

    /*
    This action is used to determine if the Dialog is modal or not. A modal Dialog 
    prevents input from reaching other parts of the application while the
    Dialog is displayed -- for example, clicking outside of the Dialog on a
    Button will not trigger the Button if the Dialog is modal.
    */
    action IsModal returns boolean
        return isModal
    end

    /*
    This action determines whether or not the top bar should be visible on this
    Dialog. This value must be set before the Dialog is shown -- if this is
    changed while the Dialog is open, it won't affect the Dialog until the next
    time it's opened.
    */
    action SetTopBarVisible(boolean enable)
        showTopBar = enable
    end

    /*
        This action works out the size and position of the Dialog and its contents.
        It first makes the Dialog's layer cover the whole game window, so the Dialog
        stays centered when the window changes size. This is called automatically as
        needed, and most users shouldn't need to call it directly.
    */
    action Resize
        Layer layer = GetLayer()
        if layer not= undefined
            layer:SetViewport(0, 0, manager:GetGameDisplay():GetWidth(), manager:GetGameDisplay():GetHeight())
            layer:GetCamera():Update()
        end
        if fitToContents
            if not fitting
                fitting = true
                FitToWindow()
                fitting = false
            end
        end
        parent:Control:Resize()
    end

    /*
        This action sets whether the Dialog sizes itself to its contents and to the
        window. When it does, its width is a share of the window, kept between a
        minimum and a maximum (SetFitWidth), and its height is as tall as its page's
        contents plus its top bar. It is never larger than nine tenths of the
        window: if the contents are taller, the page scrolls. The size is worked out
        again whenever the window changes size or the interface scale changes, so
        the Dialog stays on the screen. Any width or height set before is replaced.
        It is off by default.

        Attribute: Parameter value True to fit the Dialog to its contents and the window.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.Dialog
        use Libraries.Interface.Forms.Page

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Dialog dialog
                dialog:SetName("Rename")
                Page page = dialog:InitializeDefaultPage()
                page:AddLabel("New name")
                page:AddTextField("New name")
                dialog:SetFitToContents(true)
                dialog:Show()
            end
        end
    */
    action SetFitToContents(boolean value)
        fitToContents = value
        RequestLayout()
    end

    /*
        This action returns whether the Dialog sizes itself to its contents and to
        the window (SetFitToContents).

        Attribute: Returns True if the Dialog fits its contents and the window.
    */
    action IsFittingToContents returns boolean
        return fitToContents
    end

    /*
        This action sets the width of a Dialog that fits its contents: a share of
        the window's width, kept between a minimum and a maximum. The minimum and
        maximum are in points before the interface scale. A window narrower than
        the minimum still keeps the whole Dialog on the screen. The default is half
        the window, between 360 and 720 points.

        Attribute: Parameter share The share of the window's width, such as 0.5 for half.

        Attribute: Parameter minimum The narrowest the Dialog is, in points.

        Attribute: Parameter maximum The widest the Dialog is, in points.
    */
    action SetFitWidth(number share, number minimum, number maximum)
        fitWidthShare = share
        fitMinimumWidth = minimum
        fitMaximumWidth = maximum
        RequestLayout()
    end

    /*
    Works out the size of a Dialog that fits its contents, and sets it in its
    layout properties as well, so the layer's layout gives it the same size
    and centers it. The page is measured at the new width, since its text
    wraps to it.
    */
    private action FitToWindow
        GameDisplay display = manager:GetGameDisplay()
        Game game = manager:GetGame()
        if display = undefined or game = undefined
            return now
        end
        number windowWidth = display:GetWidth()
        number windowHeight = display:GetHeight()
        if windowWidth <= 0 or windowHeight <= 0
            return now
        end
        number scale = game:GetInterfaceScale()
        if scale <= 0
            scale = 1
        end

        number width = windowWidth * fitWidthShare
        if width < fitMinimumWidth * scale
            width = fitMinimumWidth * scale
        end
        if width > fitMaximumWidth * scale
            width = fitMaximumWidth * scale
        end
        if width > windowWidth * WINDOW_SHARE
            width = windowWidth * WINDOW_SHARE
        end

        Page page = currentPage
        if page = undefined
            page = defaultPage
        end
        number height = GetHeight()
        if page not= undefined
            // The page at the new width, then how tall its contents are.
            page:SetSize(width, page:GetHeight())
            number barHeight = 0
            if showTopBar
                barHeight = BAR_HEIGHT * scale
            end
            // The contents by themselves: the total is at least the page's
            // own height, which would grow the Dialog on every resize.
            height = page:GetNaturalContentHeight() + barHeight + GetBorderThickness() * 2
        end
        if height > windowHeight * WINDOW_SHARE
            height = windowHeight * WINDOW_SHARE
        end

        // In points before the scale, as the layout multiplies them by it.
        // Set only when they change, so a layout doesn't ask for another.
        number pointWidth = width / scale
        number pointHeight = height / scale
        if GetPercentageWidth() not= 0
            SetPercentageWidth(0)
        end
        if GetPercentageHeight() not= 0
            SetPercentageHeight(0)
        end
        if math:AbsoluteValue(GetPixelWidth() - pointWidth) > 0.5
            SetPixelWidth(pointWidth)
        end
        if math:AbsoluteValue(GetPixelHeight() - pointHeight) > 0.5
            SetPixelHeight(pointHeight)
        end
        LayoutProperties properties = GetDefaultLayoutProperties()
        if properties:GetHorizontalLayoutMode() not= properties:STANDARD
            SetHorizontalLayoutMode(properties:STANDARD)
        end
        if properties:GetVerticalLayoutMode() not= properties:STANDARD
            SetVerticalLayoutMode(properties:STANDARD)
        end

        SetSize(width, height)
        SetPosition((windowWidth - width) / 2.0, (windowHeight - height) / 2.0)
    end

    /*
        This action is used to load the graphical components of the Dialog, which by
        default is a view that draws the Dialog with a drop shadow. A view given in
        the layout properties is used instead, if there is one. This is handled
        automatically by the Game engine as needed, and most users shouldn't need to
        use this action directly.

        Attribute: Parameter properties The layout properties to load the graphics with.
    */
    action LoadGraphics(LayoutProperties properties)
        if properties:GetView2D() not= undefined and properties:GetView2D() not= GetView2D()
            SetView2D(properties:GetView2D())
        end

        if GetView2D() = undefined
            DropShadowView view
            view:Initialize()
            SetView2D(view)
        end
        
        parent:Control:LoadGraphics(properties)
    end

    /*
    This action returns whether or not the top bar will be displayed as part of
    this Dialog when it opens.
    */
    action IsTopBarVisible returns boolean
        return showTopBar
    end

    /*
        This action tells accessibility tools, such as screen readers, that the
        Dialog is the parent of the controls inside it, so they are announced as part
        of the Dialog.

        Attribute: Returns true, because a Dialog contains its controls for accessibility.
    */
    action IsAccessibleParent returns boolean
        return true
    end
    
    
    /*
    This action creates a default StackedRowPage and adds it to the Dialog. This page will be empty but 
    is added to the Dialog so it will be shown automatically when Show() is called. The page will be fit
    to the size given to the Dialog and adjust if the top bar is being shown. 
    Attribute: Returns Returns an empty Page that will be drawn when Show is called
*/
    action InitializeDefaultPage returns Page
        StackedRowPage page
        me:defaultPage = page
        SetVerticalLayoutMode(GetDefaultLayoutProperties():STANDARD)
        
        ApplyDefaultStyleToPage(page)
        
        Add(page)
        return page
    end
    
    /*
        This action styles a Page to fit inside the Dialog the same way the default
        page does. If the top bar is shown, the page is made shorter by the height of
        the bar so it fits below it. The page also gets the Dialog's border thickness
        and rounded bottom corners. InitializeDefaultPage calls this on the page it
        makes, and it can be used on other pages given to SetCurrentPage so they match.

        Attribute: Parameter page The Page to style.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.Dialog
        use Libraries.Interface.Pages.StackedRowPage

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Dialog dialog
                dialog:SetName("About")
                dialog:SetPixelWidth(400)
                dialog:SetPixelHeight(200)

                StackedRowPage page
                page:AddLabel("Version 1.0")
                dialog:ApplyDefaultStyleToPage(page)
                dialog:SetCurrentPage(page)

                dialog:Show()
            end
        end
    */
    action ApplyDefaultStyleToPage(Page page)
        LayoutProperties properties = GetDefaultLayoutProperties()
        if showTopBar
            page:SetPixelHeight(-BAR_HEIGHT)
            page:SetTopMargin(-0.5)
            // The bar draws the top of the outline, so the page draws its
            // sides and bottom.
            page:SetBorderStyle(properties:LEFT + properties:RIGHT + properties:BOTTOM)
        end

        page:SetBorderThickness(GetBorderThickness())
        // The outline is the theme's dialog border, when it has one.
        if GetBorderColor() not= undefined
            page:SetBorderColor(GetBorderColor())
        end
        // The same rounding as the bar's top corners.
        page:SetBottomLeftPixelRounding(8)
        page:SetBottomRightPixelRounding(8)
    end
    
    /*
    This action returns the default page used as the panel for the Dialog. If InitializeDefaultPage has not been called
    then this action will return undefined.
    Attribute: Returns Returns the current default page. Returns undefined if the default page hasn't been initialized.
*/
    action GetDefaultPage returns Page
        return defaultPage
    end
    
    
    /*
        This action makes the given Page the one shown in the Dialog. Any Page
        already in the Dialog is removed first, so this can be used to switch a
        Dialog between pages, such as the steps of a setup window.

        Attribute: Parameter page The Page to show in the Dialog.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.Dialog
        use Libraries.Interface.Pages.StackedRowPage

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Dialog dialog
                dialog:SetName("Setup")
                dialog:SetPixelWidth(400)
                dialog:SetPixelHeight(200)

                StackedRowPage firstStep
                firstStep:AddLabel("Welcome!")
                dialog:ApplyDefaultStyleToPage(firstStep)
                dialog:SetCurrentPage(firstStep)

                dialog:Show()
            end
        end
    */
    action SetCurrentPage(Page page)
            integer i = 0
            Iterator<Item2D> iterator = GetChildren():GetIterator()
            repeat while iterator:HasNext()
            Item2D child = iterator:Next()
            if child is Page
                    Remove(child)
    end
            end
        me:currentPage = page
        Add(currentPage)
    end
    
    /*
        This action returns the Page most recently given to SetCurrentPage, or
        undefined if SetCurrentPage has not been called. The page made by
        InitializeDefaultPage is returned by GetDefaultPage instead.

        Attribute: Returns The current Page, or undefined.
    */
    action GetCurrentPage returns Page
        return currentPage
    end

end