package Libraries.Interface.Controls

use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Color
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Layouts.ManualLayout

class ScrollBarControl is Control

    boolean vertical = true

    on create
        SetName("Scroll Bar Control")
        SetInputGroup("ScrollBarControl")
    end

    action LoadGraphics(LayoutProperties properties)
        if GetView2D() = undefined
            ControlShaderView view
            view:SetName("Scroll Control View")
            view:Initialize()
            SetView2D(view)
        end

        parent:Control:LoadGraphics(properties)
    end

    action GetBackgroundColor returns ColorGroup
        if HasColorPropertyOverride("backgroundColor")
            return parent:Control:GetBackgroundColor()
        end

        ScrollableControl control = GetScrollableControl()
        if control not= undefined
            return control:GetAccentColor()
        end

        return parent:Control:GetBackgroundColor()
    end

    /*
    Under the mouse (or a finger) the handle is drawn halfway between its
    accent color and the text color: lighter in dark mode, darker in light
    mode.
    */
    action GetMouseOverColor returns ColorGroup
        if HasColorPropertyOverride("mouseOverColor")
            return parent:Control:GetMouseOverColor()
        end

        ScrollableControl control = GetScrollableControl()
        if control not= undefined
            ColorGroup accent = control:GetAccentColor()
            ColorGroup font = control:GetFontColor()
            if accent is Color and font is Color
                Color accentColor = cast(Color, accent)
                Color fontColor = cast(Color, font)
                Color mixed
                mixed:SetColor((accentColor:GetRed() + fontColor:GetRed()) / 2,
                    (accentColor:GetGreen() + fontColor:GetGreen()) / 2,
                    (accentColor:GetBlue() + fontColor:GetBlue()) / 2,
                    accentColor:GetAlpha())
                return mixed
            end
        end
        return parent:Control:GetMouseOverColor()
    end

    action GetScrollableControl returns ScrollableControl
        Item2D result = GetParent()
        repeat until result is ScrollableControl or result = undefined
            result = result:GetParent()
        end
        return cast(ScrollableControl, result)
    end

    action IsVertical returns boolean
        return vertical
    end

    action SetVertical(boolean vertical)
        me:vertical = vertical
    end

end