package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Containers.Support.SortableContainer
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Painter2D
use Libraries.Interface.Controls.TextStyles.TextHighlight
use Libraries.Game.Graphics.ColorGroup

/*
    The TextBoxRenderer class draws the inside of a TextBox: the characters, the
    selection, any text highlights, and the caret. A TextBox makes one for
    itself and fills it as the text changes or scrolls. The renderer only keeps
    Drawables for the lines that fit on screen, and it reuses Drawables from a
    pool instead of making new ones, which keeps large text fast. Most users
    never need to work with it directly.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Controls.TextBox
    use Libraries.Interface.Controls.TextBoxRenderer

    Form form
    Page page = form:GetMainPage()

    TextBox box = page:AddTextBox("Notes")
    TextBoxRenderer renderer = cast(TextBoxRenderer, box:GetScrollableRegion())
    integer visibleLines = renderer:GetLineCount()

    form:Display()
*/
class TextBoxRenderer is Control

    Array<Array<Drawable>> lines
    Array<Drawable> selectionDrawables
    Array<SortableContainer<TextHighlight, Drawable>> preSelectionHighlights
    Array<SortableContainer<TextHighlight, Drawable>> postSelectionHighlights
    Drawable caret

    /*
    These variables indicate if the pre/post selection highlights
    need to be sorted before they're rendered.
    */
    boolean sortPreHighlights = false
    boolean sortPostHighlights = false

    Array<Drawable> drawablePool
    Array<SortableContainer<TextHighlight, Drawable>> highlightContainerPool

    // The line number of the first line of text we're displaying.
    integer startLine = 0

    // The array index of the first line. 
    integer startArray = 0

    on create
        SetCustomDrawing(true)
        Add(caret)
    end

    /*
        This action gives back a Drawable for showing one character or a selection
        box. It reuses a Drawable from the recycling pool when one is free, and only
        makes a new one when the pool is empty. New Drawables ignore the mouse, so
        clicks pass through to the TextBox. Hand the Drawable back with
        RecycleDrawable when you are done with it.

        Attribute: Returns A Drawable that is ready to be loaded and placed.

        Attribute: Example
        use Libraries.Interface.Controls.TextBoxRenderer
        use Libraries.Game.Graphics.Drawable
        TextBoxRenderer renderer
        Drawable drawable = renderer:GetDrawable()
        renderer:RecycleDrawable(drawable)
    */
    action GetDrawable returns Drawable
        if drawablePool:IsEmpty() = false
            Drawable drawable = drawablePool:RemoveFromEnd()
            return drawable
        else
            Drawable drawable
            drawable:SetAcceptsMouseInput(false)
            return drawable
        end
    end

    /*
        This action puts a Drawable into the recycling pool so GetDrawable can hand
        it out again later. This saves making new Drawables every time the text
        changes. If the Drawable is undefined, nothing happens.

        Attribute: Parameter drawable The Drawable to put back in the pool.

        Attribute: Example
        use Libraries.Interface.Controls.TextBoxRenderer
        use Libraries.Game.Graphics.Drawable
        TextBoxRenderer renderer
        Drawable drawable = renderer:GetDrawable()
        renderer:RecycleDrawable(drawable)
    */
    action RecycleDrawable(Drawable drawable)
        if drawable = undefined
            return now
        end

        drawablePool:Add(drawable)
    end

    /*
        This action gives back an empty container that pairs a TextHighlight with
        the Drawable that shows it. It reuses a container from the pool when one is
        free, and makes a new one otherwise. The renderer uses these containers to
        keep highlights sorted by render priority.

        Attribute: Returns A container for a TextHighlight and its Drawable.
    */
    action GetHighlightContainer returns SortableContainer<TextHighlight, Drawable>
        if highlightContainerPool:IsEmpty() = false
            return highlightContainerPool:RemoveFromEnd()
        else
            SortableContainer<TextHighlight, Drawable> container
            return container
        end
    end

    /*
        This action clears a highlight container and puts it into the pool so
        GetHighlightContainer can reuse it. The Drawable inside is not recycled,
        because the renderer did not make it and something else may still be using
        it. If the container is undefined, nothing happens.

        Attribute: Parameter container The highlight container to put back in the pool.
    */
    action RecycleHighlightContainer(SortableContainer<TextHighlight, Drawable> container)
        if container = undefined
            return now
        end

        // We don't recycle the Drawables from the highlights because
        // we didn't create them, and so we don't know if they're being reused
        // by whatever the original sources of the highlight drawables are.

        container:Set(undefined, undefined)
        highlightContainerPool:Add(container)
    end

    /*
        This action draws the text area. It first draws the background view, and
        then draws the highlights, selection, text and caret on top of it. The game
        calls this action each frame, so most users never need to call it.

        Attribute: Parameter painter The Painter2D used to draw.
    */
    action Draw(Painter2D painter)
        DrawView(painter)
        DrawContents(painter)
    end

    /*
        This action draws only the background view of the text area, if it has one.
        It is the first half of Draw.

        Attribute: Parameter painter The Painter2D used to draw.
    */
    action DrawView(Painter2D painter)
        if GetView2D() not= undefined
            GetView2D():Draw(painter)
        end
    end

    /*
        This action draws everything inside the text area, from back to front:
        highlights that sit behind the selection, the selection boxes, highlights
        that stay visible over the selection, the characters of each line, and last
        the caret. If a highlight is found out of order by render priority, the
        highlights are sorted again before the next draw.

        Attribute: Parameter painter The Painter2D used to draw.
    */
    action DrawContents(Painter2D painter)
        if sortPreHighlights
            preSelectionHighlights:Sort()
            sortPreHighlights = false
        end

        number priority = 0

        if preSelectionHighlights:IsEmpty() = false
            priority = preSelectionHighlights:Get(0):GetSorter():GetRenderPriority()
        end

        integer counter = 0
        repeat while counter < preSelectionHighlights:GetSize()
            SortableContainer<TextHighlight, Drawable> container = preSelectionHighlights:Get(counter)

            // If we find an object is in the wrong position according to its render priority,
            // we'll sort the objects on the next Draw call.
            if container:GetSorter():GetRenderPriority() < priority
                sortPreHighlights = true
            end

            container:GetValue():Draw(painter)
            counter = counter + 1
        end

        counter = 0
        repeat while counter < selectionDrawables:GetSize()
            painter:Draw(selectionDrawables:Get(counter))
            counter = counter + 1
        end

        if sortPostHighlights
            postSelectionHighlights:Sort()
            sortPostHighlights = false
        end

        if postSelectionHighlights:IsEmpty() = false
            priority = postSelectionHighlights:Get(0):GetSorter():GetRenderPriority()
        end

        counter = 0
        repeat while counter < postSelectionHighlights:GetSize()
            SortableContainer<TextHighlight, Drawable> container = postSelectionHighlights:Get(counter)

            // If we find an object is in the wrong position according to its render priority,
            // we'll sort the objects on the next Draw call.
            if container:GetSorter():GetRenderPriority() < priority
                sortPostHighlights = true
            end

            container:GetValue():Draw(painter)
            counter = counter + 1
        end

        counter = 0
        repeat while counter < lines:GetSize()
            integer characterCounter = 0
            Array<Drawable> line = lines:Get(counter)
            repeat while characterCounter < line:GetSize()
                painter:Draw(line:Get(characterCounter))
                characterCounter = characterCounter + 1
            end
            counter = counter + 1
        end

        caret:Draw(painter)
    end

    /*
        This action adds a character Drawable to a line at the given position in
        that line. If the line is not one of the lines being shown, nothing happens.

        Attribute: Parameter line The index of the line in the whole text.

        Attribute: Parameter index The position within the line to place the character at.

        Attribute: Parameter character The Drawable that shows the character.
    */
    action AddCharacter(integer line, integer index, Drawable character)
        Array<Drawable> array = GetLine(line)
        if array = undefined
            return now
        end
        Add(character)
        array:Add(index, character)
    end

    /*
        This action removes the character Drawable at the given position in a line
        and puts it back in the recycling pool. If the line is not being shown, or
        the position is past the end of the line, nothing happens.

        Attribute: Parameter line The index of the line in the whole text.

        Attribute: Parameter index The position within the line of the character to remove.
    */
    action RemoveCharacter(integer line, integer index)
        Array<Drawable> array = GetLine(line)
        if array = undefined
            // If the array is undefined, the line couldn't be fetched, most
            // likely because the line is off the screen.
            return now
        end
        if index >= array:GetSize()
            return now
        end
        Drawable character = array:RemoveAt(index)
        Remove(character)
        RecycleDrawable(character)
    end

    /*
        This action adds a Drawable that marks part of the selected text. Selection
        Drawables are drawn above the highlights that sit behind the selection and
        below the characters.

        Attribute: Parameter selection The Drawable that marks part of the selection.
    */
    action AddSelectionDrawable(Drawable selection)
        Add(selection)
        selectionDrawables:Add(selection)
    end

    /*
        This action removes a selection Drawable from the text area and puts it back
        in the recycling pool.

        Attribute: Parameter selection The selection Drawable to remove.
    */
    action RemoveSelectionDrawable(Drawable selection)
        selectionDrawables:Remove(selection)
        Remove(selection)
        RecycleDrawable(selection)
    end

    /*
        This action adds a highlight that is drawn behind the selection, so the
        selection covers it. The highlights are sorted by render priority before the
        next draw.

        Attribute: Parameter highlight The TextHighlight that made the Drawable.

        Attribute: Parameter drawable The Drawable that shows the highlight.
    */
    action AddPreSelectionHighlight(TextHighlight highlight, Drawable drawable)
        Add(drawable)
        SortableContainer<TextHighlight, Drawable> container = GetHighlightContainer()
        container:Set(highlight, drawable)
        preSelectionHighlights:Add(container)
        sortPreHighlights = true
    end

    /*
        This action removes a highlight that is drawn behind the selection. It finds
        the first entry for the given TextHighlight and takes its Drawable out of
        the text area.

        Attribute: Parameter highlight The TextHighlight to remove.
    */
    action RemovePreSelectionHighlight(TextHighlight highlight)
        integer counter = 0
        repeat while counter < preSelectionHighlights:GetSize()
            SortableContainer<TextHighlight, Drawable> container = preSelectionHighlights:Get(counter)
            if container:GetSorter() = highlight
                counter = preSelectionHighlights:GetSize()

                preSelectionHighlights:Remove(container)
                Remove(container:GetValue())
            else
                counter = counter + 1
            end
        end
    end

    /*
        This action adds a highlight that is drawn above the selection, so it stays
        visible when the text is selected. The highlights are sorted by render
        priority before the next draw.

        Attribute: Parameter highlight The TextHighlight that made the Drawable.

        Attribute: Parameter drawable The Drawable that shows the highlight.
    */
    action AddPostSelectionHighlight(TextHighlight highlight, Drawable drawable)
        Add(drawable)
        SortableContainer<TextHighlight, Drawable> container = GetHighlightContainer()
        container:Set(highlight, drawable)
        postSelectionHighlights:Add(container)
        sortPostHighlights = true
    end

    /*
        This action removes a highlight that is drawn above the selection. It finds
        the first entry for the given TextHighlight and takes its Drawable out of
        the text area.

        Attribute: Parameter highlight The TextHighlight to remove.
    */
    action RemovePostSelectionHighlight(TextHighlight highlight)
        integer counter = 0
        repeat while counter < postSelectionHighlights:GetSize()
            SortableContainer<TextHighlight, Drawable> container = postSelectionHighlights:Get(counter)
            if container:GetSorter() = highlight
                counter = postSelectionHighlights:GetSize()

                postSelectionHighlights:Remove(container)
                Remove(container:GetValue())
            else
                counter = counter + 1
            end
        end
    end

    /*
        This action sets the Drawable that is used as the caret, the blinking line
        that shows where typing will go.

        Attribute: Parameter newCaret The Drawable to use as the caret.
    */
    action SetCaret(Drawable newCaret)
        caret = newCaret
    end

    /*
        This action returns the Drawable used as the caret, the blinking line that
        shows where typing will go.

        Attribute: Returns The caret Drawable.
    */
    action GetCaret returns Drawable
        return caret
    end

    /*
    This action empties the most common drawables that would need to be cleared
    from the TextBox: the text, selection drawables, and highlighting.

    This DOES NOT remove the Caret!
    */
    action Empty
        EmptyLines()
        EmptySelectionDrawables()
        EmptyPreSelectionHighlights()
        EmptyPostSelectionHighlights()
    end

    /*
        This action removes and recycles all of the character Drawables on one line.
        If the line is not being shown, nothing happens.

        Attribute: Parameter index The index of the line in the whole text.
    */
    action EmptyLine(integer index)
        Array<Drawable> array = GetLine(index)
        
        if array not= undefined
            RecycleLine(array)
        end
    end

    /*
        This action removes and recycles the character Drawables on every line being
        shown. The line slots themselves are kept, so the same number of lines can
        be filled again.
    */
    action EmptyLines
        integer counter = 0

        repeat while counter < lines:GetSize()
            RecycleLine(lines:Get(counter))
            counter = counter + 1
        end

        // Reset the cyclical array start pointer to 0.
        startArray = 0
    end

    /*
    Recycles all Drawables in the array, and empties the array.
    */
    private action RecycleLine(Array<Drawable> line)
        repeat until line:IsEmpty()
            Drawable drawable = line:RemoveFromFront()
            Remove(drawable)
            RecycleDrawable(drawable)
        end
    end

    /*
        This action removes and recycles every selection Drawable, so no text looks
        selected.
    */
    action EmptySelectionDrawables
        repeat until selectionDrawables:IsEmpty()
            RemoveSelectionDrawable(selectionDrawables:Get(0))
        end
    end

    /*
        This action removes every highlight that is drawn behind the selection.
    */
    action EmptyPreSelectionHighlights
        repeat until preSelectionHighlights:IsEmpty()
            SortableContainer<TextHighlight, Drawable> container = preSelectionHighlights:RemoveFromEnd()
            Remove(container:GetValue())
        end
        sortPreHighlights = false
    end

    /*
        This action removes every highlight that is drawn above the selection.
    */
    action EmptyPostSelectionHighlights
        repeat until postSelectionHighlights:IsEmpty()
            SortableContainer<TextHighlight, Drawable> container = postSelectionHighlights:RemoveFromEnd()
            Remove(container:GetValue())
        end
        sortPostHighlights = false
    end

    /*
        This action sets how many lines of text the renderer keeps slots for, which
        is usually the number of lines that fit in the visible area. Adding lines
        makes new empty slots. Removing lines recycles the Drawables on the removed
        slots. A count of 0 clears every line, and a negative count is ignored.

        Attribute: Parameter lineCount The number of line slots to keep.

        Attribute: Example
        use Libraries.Interface.Controls.TextBoxRenderer
        TextBoxRenderer renderer
        renderer:SetLineCount(10)
        integer count = renderer:GetLineCount()
    */
    action SetLineCount(integer lineCount)
        if lineCount < 0
            return now
        elseif lineCount = 0
            integer counter = 0
            repeat while counter < lines:GetSize()
                RecycleLine(lines:Get(counter))
                counter = counter + 1
            end

            lines:Empty()

            return now
        end

        repeat while lineCount > lines:GetSize()
            Array<Drawable> line
            lines:Add(startArray, line)
            startArray = startArray + 1
        end

        repeat while lineCount < lines:GetSize()
            integer index = startArray - 1
            if index < 0
                index = lines:GetSize() - 1
            end

            Array<Drawable> line = lines:RemoveAt(index)
            RecycleLine(line)
        end
    end

    /*
        This action returns how many line slots the renderer keeps, which is the
        number of lines it can show at once.

        Attribute: Returns The number of line slots.
    */
    action GetLineCount returns integer
        return lines:GetSize()
    end

    /*
        This action sets which line of the whole text is shown in the first slot,
        for example after scrolling. Lines that are still on screen keep their
        Drawables, and lines that scrolled away are recycled. If the jump is bigger
        than the number of slots, everything is cleared.

        Attribute: Parameter line The index of the line in the whole text to show first.

        Attribute: Example
        use Libraries.Interface.Controls.TextBoxRenderer
        TextBoxRenderer renderer
        renderer:SetLineCount(10)
        renderer:SetStartLine(5)
        integer first = renderer:GetStartLine()
    */
    action SetStartLine(integer line)
        if line = startLine
            return now
        end

        integer difference = line - startLine

        // If the difference is larger than the number of lines we display, then
        // the new section of text we're about to view shares no lines in common
        // with the last view of the text, so we can get rid of the old drawables.
        if (difference > lines:GetSize()) or (-difference > lines:GetSize())
            Empty()
        elseif difference > 0
            integer counter = 0
            repeat while counter < difference
                RecycleLine(lines:Get( (startArray + counter) mod lines:GetSize() ))
                counter = counter + 1
            end

            startArray = (startArray + difference) mod lines:GetSize()
        else
            integer counter = 0
            repeat while counter > difference and startArray - counter < lines:GetSize()
                integer target = startArray - counter
                if target < 0
                    target = lines:GetSize() - target
                end

                RecycleLine(lines:Get(target))
                counter = counter - 1
            end

            startArray = startArray - difference
            if startArray < 0
                startArray = lines:GetSize() - startArray
            end
        end

        startLine = line
    end

    /*
        This action returns the index of the line in the whole text that is shown in
        the first slot.

        Attribute: Returns The index of the first shown line.
    */
    action GetStartLine returns integer
        return startLine
    end

    /*
        This action returns the character Drawables for one line of the whole text.
        The line must be one of the lines being shown. If it is not, or there are no
        line slots, the action returns undefined.

        Attribute: Parameter index The index of the line in the whole text.

        Attribute: Returns The array of character Drawables for the line, or undefined.

        Attribute: Example
        use Libraries.Interface.Controls.TextBoxRenderer
        use Libraries.Containers.Array
        use Libraries.Game.Graphics.Drawable
        TextBoxRenderer renderer
        renderer:SetLineCount(10)
        Array<Drawable> line = renderer:GetLine(0)
    */
    action GetLine(integer index) returns Array<Drawable>
        integer offset = index - startLine
        if offset < 0 or offset > lines:GetSize() or lines:IsEmpty()
            return undefined
        end

        return lines:Get((startArray + offset) mod lines:GetSize())
    end

    /*
        This action always returns false, so the renderer is not laid out again on
        its own. It is resized only when the TextBox asks for it.

        Attribute: Returns Always false.
    */
    action NeedsLayout returns boolean
        return false
    end

    /*
        This action returns the background color used to draw the text area. If this
        renderer has its own value set for "backgroundColor", that value is used.
        Otherwise it uses the value from the TextBox that holds this renderer, so
        the text area matches its TextBox. If there is no TextBox, it falls back to
        the normal Control value.

        Attribute: Returns The background color to use for the text area.
    */
    action GetBackgroundColor returns ColorGroup
        if HasColorPropertyOverride("backgroundColor")
            return parent:Control:GetBackgroundColor()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetBackgroundColor()
        else
            return parent:Control:GetBackgroundColor()
        end
    end

    /*
        This action returns the border color used to draw the text area. If this
        renderer has its own value set for "borderColor", that value is used.
        Otherwise it uses the value from the TextBox that holds this renderer, so
        the text area matches its TextBox. If there is no TextBox, it falls back to
        the normal Control value.

        Attribute: Returns The border color to use for the text area.
    */
    action GetBorderColor returns ColorGroup
        if HasColorPropertyOverride("borderColor")
            return parent:Control:GetBorderColor()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetBorderColor()
        else
            return parent:Control:GetBorderColor()
        end
    end
    
    /*
        This action returns the mouse-over color used to draw the text area. If this
        renderer has its own value set for "mouseOverColor", that value is used.
        Otherwise it uses the value from the TextBox that holds this renderer, so
        the text area matches its TextBox. If there is no TextBox, it falls back to
        the normal Control value.

        Attribute: Returns The mouse-over color to use for the text area.
    */
action GetMouseOverColor returns ColorGroup
        if HasColorPropertyOverride("mouseOverColor")
            return parent:Control:GetMouseOverColor()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetMouseOverColor()
        else
            return parent:Control:GetMouseOverColor()
        end
    end
    
    /*
        This action returns the mouse-over border color used to draw the text area.
        If this renderer has its own value set for "mouseOverBorderColor", that
        value is used. Otherwise it uses the value from the TextBox that holds this
        renderer, so the text area matches its TextBox. If there is no TextBox, it
        falls back to the normal Control value.

        Attribute: Returns The mouse-over border color to use for the text area.
    */
action GetMouseOverBorderColor returns ColorGroup
        if HasColorPropertyOverride("mouseOverBorderColor")
            return parent:Control:GetMouseOverBorderColor()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetMouseOverBorderColor()
        else
            return parent:Control:GetMouseOverBorderColor()
        end
    end

    /*
        This action returns the border thickness used to draw the text area. If this
        renderer has its own value set for "borderThickness", that value is used.
        Otherwise it uses the value from the TextBox that holds this renderer, so
        the text area matches its TextBox. If there is no TextBox, it falls back to
        the normal Control value.

        Attribute: Returns The border thickness to use for the text area.
    */
    action GetBorderThickness returns number
        if HasNumberPropertyOverride("borderThickness")
            return parent:Control:GetBorderThickness()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetBorderThickness()
        else
            return parent:Control:GetBorderThickness()
        end
    end
    
    /*
        This action returns the mouse-over border thickness used to draw the text
        area. If this renderer has its own value set for "mouseOverBorderThickness",
        that value is used. Otherwise it uses the value from the TextBox that holds
        this renderer, so the text area matches its TextBox. If there is no TextBox,
        it falls back to the normal Control value.

        Attribute: Returns The mouse-over border thickness to use for the text area.
    */
action GetMouseOverBorderThickness returns number
        if HasNumberPropertyOverride("mouseOverBorderThickness")
            return parent:Control:GetMouseOverBorderThickness()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetMouseOverBorderThickness()
        else
            return parent:Control:GetMouseOverBorderThickness()
        end
    end
    
    /*
        This action checks whether a mouse-over border thickness is set for the text
        area. If this renderer has its own value for "mouseOverBorderThickness", it
        checks that. Otherwise it asks the TextBox that holds this renderer. If
        there is no TextBox, it falls back to the normal Control check.

        Attribute: Returns True if a mouse-over border thickness is set, or false if not.
    */
action HasMouseOverBorderThickness returns boolean
        if HasNumberPropertyOverride("mouseOverBorderThickness")
            return parent:Control:HasMouseOverBorderThickness()
        end
        
TextBox box = GetTextBox()
        if box not= undefined
            return box:HasMouseOverBorderThickness()
        else
            return parent:Control:HasMouseOverBorderThickness()
        end
    end

    /*
        This action finds the TextBox that holds this renderer by walking up through
        its parents.

        Attribute: Returns The TextBox that holds this renderer, or undefined if there is none.
    */
    action GetTextBox returns TextBox
        Item2D candidate = GetParent()
        repeat until candidate is TextBox or candidate = undefined
            candidate = candidate:GetParent()
        end

        // Returns either the TextBox this is attached to, or undefined
        return cast(TextBox, candidate)
    end

    /*
        This action returns the top left corner rounding used to draw the text area.
        If this renderer has its own value set for "topLeftRounding", that value is
        used. Otherwise it uses the value from the TextBox that holds this renderer,
        so the text area matches its TextBox. If there is no TextBox, it falls back
        to the normal Control value.

        Attribute: Returns The top left corner rounding to use for the text area.
    */
    action GetTopLeftRounding returns number
        if HasNumberPropertyOverride("topLeftRounding")
            return parent:Control:GetTopLeftRounding()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetTopLeftRounding()
        else
            return parent:Control:GetTopLeftRounding()
        end
    end

    /*
        This action checks whether the top left corner rounding for the text area
        has a real value. It asks GetTopLeftRounding and returns true unless the
        result is not a number, which means no rounding was set.

        Attribute: Returns True if the top left corner rounding has a value, or false if it does not.
    */
    action HasTopLeftRounding returns boolean
        number value = GetTopLeftRounding()
        return value:IsNotANumber() = false
    end

    /*
        This action returns the top right corner rounding used to draw the text
        area. If this renderer has its own value set for "topRightRounding", that
        value is used. Otherwise it uses the value from the TextBox that holds this
        renderer, so the text area matches its TextBox. If there is no TextBox, it
        falls back to the normal Control value.

        Attribute: Returns The top right corner rounding to use for the text area.
    */
    action GetTopRightRounding returns number
        if HasNumberPropertyOverride("topRightRounding")
            return parent:Control:GetTopRightRounding()
        end

        TextBox box = GetTextBox()
        if box not= undefined
            return box:GetTopRightRounding()
        else
            return parent:Control:GetTopRightRounding()
        end
    end

    /*
        This action checks whether the top right corner rounding for the text area
        has a real value. It asks GetTopRightRounding and returns true unless the
        result is not a number, which means no rounding was set.

        Attribute: Returns True if the top right corner rounding has a value, or false if it does not.
    */
    action HasTopRightRounding returns boolean
        number value = GetTopRightRounding()
        return value:IsNotANumber() = false
    end

    /*
        This action returns the bottom left corner rounding used to draw the text
        area. If this renderer has its own value set for "bottomLeftRounding", that
        value is used. Otherwise it uses the value from the TextBox that holds this
        renderer, so the text area matches its TextBox. If there is no TextBox, it
        falls back to the normal Control value.

        Attribute: Returns The bottom left corner rounding to use for the text area.
