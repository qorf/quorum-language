package Libraries.Interface.Controls

use Libraries.Interface.Item2D
use Libraries.Interface.Controls.Control
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.TreeChangeEvent
use Libraries.Interface.Layouts.TreeLayout
use Libraries.Interface.Layouts.TreeItemLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Controls.ControlLabel
use Libraries.Interface.Controls.ToggleButton
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.TextureRegion
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Interface.Controls.TreeItemContent
use Libraries.Interface.Controls.DefaultTreeItemContent
use Libraries.Interface.Views.ControlShaderView

/*
The TreeItem class is one entry in a Tree, such as a file or a folder. Each
item has a name, shown on its row and read by screen readers, and it can
hold other TreeItems under it. An item with children shows an arrow button;
opening the item shows its children, indented below it, and closing it
hides them. A row can also show an icon, a short text after the name
(SetTrailingText) and a colored bar at the tree's left edge
(SetLeadingBar). Double clicking an item opens or closes it and runs its
activation behavior, if it has one (SetBehavior).

Attribute: Author William Allee

Attribute: Example

use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem

Form form
Page page = form:GetMainPage()
Tree tree = page:AddTree("Files")

TreeItem scripts
scripts:SetName("Scripts")
tree:Add(scripts)

TreeItem main
main:SetName("Main.quorum")
scripts:Add(main)

scripts:Open()
main:Select()

form:Display()
*/
class TreeItem is Control

    TreePanel panel
    TreeItemContent contents = undefined
    TreeItem parentTreeItem = undefined
    Tree parentTree = undefined
    Array<TreeItem> treeItems
    boolean open = false

    LayoutProperties panelProperties

    // The rounded band behind this row when it is selected or hovered. It
    // is not laid out by TreeItemLayout; PlaceRowHighlight sizes it.
    TreeRowHighlight rowHighlight

    // A short text right after this row's content, on its line, such as a
    // word for a file's version control state (SetTrailingText). Like the
    // band, it is not laid out by TreeItemLayout; PlaceTrailingLabel places
    // it. It is made the first time there is text, so most rows never have
    // one.
    ControlLabel trailingLabel = undefined
    text trailingText = ""
    // The color given to SetTrailingText. Left unset, the label takes the
    // theme's text color for this item's interface options key.
    ColorGroup trailingColor = undefined
    // The font given to the label, so it is only set again when it changes.
    Font trailingFont = undefined
    // What the label was last placed with: the content's width, this row's
    // height and the label's width. -1 means not placed.
    number placedContentWidth = -1
    number placedRowHeight = -1
    number placedLabelWidth = -1
    // In points before the interface scale: the gap between the row's
    // content and its trailing text.
    constant number TRAILING_GAP = 6

    // A thin bar at the tree's left edge on this row's line, such as a mark
    // for a file's version control state (SetLeadingBar). Like the band, it
    // is not laid out by TreeItemLayout; PlaceLeadingBar places it. It is
    // made the first time there is a bar, so most rows never have one.
    Control leadingBar = undefined
    // What the bar was last placed with: this row's indent, this row's
    // height and the interface scale. -1 means not placed.
    number barOffset = -1
    number barRowHeight = -1
    number barScale = -1
    // In points before the interface scale: the bar's distance from the
    // tree's left edge, its width, its distance from the row's top and
    // bottom, and the outline's thickness for SetLeadingBar(color, true).
    constant number BAR_INSET = 2
    constant number BAR_WIDTH = 4
    constant number BAR_VERTICAL_INSET = 3
    constant number BAR_OUTLINE = 1

    Behavior activationBehavior = undefined

    on create
        SetInputGroup("TreeItem")
        SetInterfaceOptionsKey("TreeItem")

        LayoutProperties treeItemProperties = GetDefaultLayoutProperties()
        treeItemProperties:SetHorizontalLayoutMode(treeItemProperties:FIT_CONTENTS)
        treeItemProperties:SetVerticalLayoutMode(treeItemProperties:FIT_CONTENTS)

        TreeItemLayout treeItemLayout
        SetLayout(treeItemLayout)

        panelProperties = panel:GetDefaultLayoutProperties()

        rowHighlight:Hide()
        parent:Item2D:Add(rowHighlight)

        SetAccessibilityCode(parent:Item:TREE_ITEM)
    end

    /*
    This action sets the key used to look up this item's colors and other
    settings in the interface options. The row's highlight, its content and its
    trailing text use the same key, so the whole row follows it. The default
    key is "TreeItem".

    Attribute: Parameter key The interface options key for this item.
    */
    action SetInterfaceOptionsKey(text key)
        parent:Control:SetInterfaceOptionsKey(key)
        rowHighlight:SetInterfaceOptionsKey(key)
        if contents not= undefined
            contents:SetInterfaceOptionsKey(key)
        end
        if trailingLabel not= undefined
            trailingLabel:SetInterfaceOptionsKey(key)
        end
    end

    /*
    This action returns the font size a TreeItem uses when it hasn't been given
    one, which is 14.

    Attribute: Returns The default font size for tree items.
    */
    action GetDefaultFontSize returns integer
        return 14
    end
    
    /*
    This action asks the row's content, if it has been made, to hide its arrow
    button. It is used when the last child is removed.
    */
    private action HideExpandButton
        if contents not= undefined
            contents:HideExpandButton()
        end
    end

    /*
    This action asks the row's content, if it has been made, to show its arrow
    button. It is used when the first child is added.
    */
    private action ShowExpandButton
        if contents not= undefined
            contents:ShowExpandButton()
        end
    end

    /*
    This action tells the row's content, if it has been made, whether the item
    is open, so its arrow button can show it.

    Attribute: Parameter expand True if the item is open, false if it is closed.
    */
    private action SetContentExpandState(boolean expand)
        if contents not= undefined
            contents:SetExpandState(expand)
        end
    end

    /*
    This action sets this item's name, which is shown on its row and read by
    screen readers. If the row's content has been made, it is told about the
    new name.

    Attribute: Parameter name The item's name.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem item
    item:SetName("Main.quorum")
    */
    action SetName(text name)
        parent:Item:SetName(name)
        if contents not= undefined
            contents:UpdateText(name)
        end
    end

    /*
    This action adds an item under this one, after its other children. If it
    is the first child, the arrow button is shown. The new child joins this
    item's Tree and takes this item's font size. It can only be seen while
    this item is open.

    Attribute: Parameter item The TreeItem to add under this one.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    */
    action Add(TreeItem item)
        if panel:GetChildren():IsEmpty()
            ShowExpandButton()
        end

        panel:Add(item)
        treeItems:Add(item)
        item:SetTree(GetTree())
        item:SetParentTreeItem(me)
        item:SetFontSize(GetFontSize())
    end

    /*
    This action adds an item under this one at the given position, counting
    from 0. If it is the first child, the arrow button is shown. The new child
    joins this item's Tree and takes this item's font size.

    Attribute: Parameter location Where to put the item among this item's children.

    Attribute: Parameter item The TreeItem to add under this one.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    TreeItem first
    first:SetName("Hero.quorum")
    folder:Add(0, first)
    */
    action Add(integer location, TreeItem item)
        if panel:GetChildren():IsEmpty()
            ShowExpandButton()
        end

        panel:Add(location, item)
        treeItems:Add(location, item)
        item:SetTree(GetTree())
        item:SetParentTreeItem(me)
        item:SetFontSize(GetFontSize())
    end

    /*
    This action sets the font size of this item, its row and all of the items
    under it.

    Attribute: Parameter size The font size for this item and its children.
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        if contents not= undefined
            contents:SetFontSize(size)
        end
        if trailingLabel not= undefined
            trailingLabel:SetFontSize(size)
        end
        integer i = 0
        repeat while i < treeItems:GetSize()
            treeItems:Get(i):SetFontSize(size)
            i = i + 1
        end
    end

    /*
    This action adds each item in the array under this one, in order, as the
    Add action does for one item.

    Attribute: Parameter items The TreeItems to add under this one.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    use Libraries.Containers.Array
    TreeItem folder
    folder:SetName("Scripts")
    Array<TreeItem> files
    TreeItem main
    main:SetName("Main.quorum")
    files:Add(main)
    TreeItem player
    player:SetName("Player.quorum")
    files:Add(player)
    folder:Add(files)
    */
    action Add(Array<TreeItem> items)
        integer counter = 0
        repeat while counter < items:GetSize()
            Add(items:Get(counter))
            counter = counter + 1
        end
    end

    /*
    This action removes a child item from under this one. If the child is
    selected, it is closed and the selection moves down first. If no children
    are left, this item is closed and its arrow button is hidden. The removed
    item no longer belongs to a tree.

    Attribute: Parameter item The child TreeItem to remove.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Remove(file)
    */
    action Remove(TreeItem item)
        if item:IsSelected()
            if item:IsOpen()
                item:Close()
            end

            item:SelectionDown()
        end

        panel:Remove(item)

        if panel:GetChildren():IsEmpty()
            if IsOpen()
                Close()
            end

            HideExpandButton()
        end

        treeItems:Remove(item)
        item:SetTree(undefined)
        item:SetParentTreeItem(undefined)
    end

    /*
    This action opens this item, showing the items under it. The arrow button
    shows that it is open, the tree lays itself out again, and the tree's
    change listeners are told the item opened. It does nothing if the item is
    already open.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Open()
    */
    action Open
        if not open
            if panel:GetInterfaceScale() not= GetInterfaceScale()
                panel:SetInterfaceScale(GetInterfaceScale())
            end
            parent:Item2D:Add(panel)
            open = true
            
            SetContentExpandState(true)

            Tree tree = GetTree()
            if tree not= undefined
                tree:RequestLayout()
                TreeChangeEvent event
                event:Set(tree, me, event:OPENED)
                tree:NotifyTreeChangeListeners(event)
            end
        end
    end

    /*
    This action closes this item, hiding the items under it. The arrow button
    shows that it is closed, the tree lays itself out again, and the tree's
    change listeners are told the item closed. It does nothing if the item is
    already closed.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Open()
    folder:Close()
    */
    action Close
        if open
            parent:Item2D:Remove(panel)
            open = false

            SetContentExpandState(false)

            Tree tree = GetTree()
            if tree not= undefined
                tree:RequestLayout()
                TreeChangeEvent event
                event:Set(tree, me, event:CLOSED)
                tree:NotifyTreeChangeListeners(event)
            end
        end
    end

    /*
    This action returns true if this item is open, showing the items under it.

    Attribute: Returns True if the item is open, false if it is closed.
    */
    action IsOpen returns boolean
        return open
    end

    /*
    This action sets the item this one was added under.

    Attribute: Parameter parentItem The parent TreeItem, or undefined.
    */
    private action SetParentTreeItem(TreeItem parentItem)
        parentTreeItem = parentItem
    end

    /*
    This action returns the item this one was added under, or undefined if it
    is a top-level item or hasn't been added to anything.

    Attribute: Returns The parent TreeItem, or undefined.
    */
    action GetParentTreeItem returns TreeItem
        return parentTreeItem
    end

    /*
    This action returns the TreeLayout of the panel that holds this item's
    children.

    Attribute: Returns The layout of this item's panel.
    */
    private action GetPanelLayout returns TreeLayout
        return cast(TreeLayout, panel:GetLayout())
    end

    /*
    This action sets the Tree this item belongs to, and does the same for
    every item under it. It is called automatically when the item is added to
    a Tree or to another item, so most programs never call it directly.

    Attribute: Parameter tree The Tree this item belongs to, or undefined.
    */
    action SetTree(Tree tree)
        parentTree = tree

        integer counter = 0
        repeat while counter < treeItems:GetSize()
            treeItems:Get(counter):SetTree(parentTree)
            counter = counter + 1
        end
    end

    /*
    This action returns the Tree this item belongs to, or undefined if it
    hasn't been added to one.

    Attribute: Returns The Tree holding this item, or undefined.
    */
    action GetTree returns Tree
        return parentTree
    end

    /*
    This action returns the last item in the given path, or undefined if the
    path is empty.

    Attribute: Parameter path A path of TreeItems.

    Attribute: Returns The last item in the path, or undefined.
    */
    private action GetTreeItem(Array<TreeItem> path) returns TreeItem
        if path:IsEmpty()
            return undefined
        end

        return path:GetFromEnd()
    end

    /*
    This action returns an iterator over the items added directly under this
    one. Items under those are not included.

    Attribute: Returns An iterator over this item's children.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    use Libraries.Containers.Iterator
    TreeItem folder
    folder:SetName("Scripts")
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    Iterator<TreeItem> children = folder:GetTreeItems()
    repeat while children:HasNext()
        output children:Next():GetName()
    end
    */
    action GetTreeItems returns Iterator<TreeItem>
        return treeItems:GetIterator()
    end

    /*
    This action sets the control that draws this item's row, replacing any it
    had. A TreeItem makes a DefaultTreeItemContent the first time it is drawn
    if it wasn't given one, so this is only needed to draw rows another way.
    The content takes this item's interface options key. Only a
    DefaultTreeItemContent row shows the highlight band; other contents draw
    their own selection.

    Attribute: Parameter content The content that draws this item's row.

    Attribute: Example
    use Libraries.Interface.Controls.TreeItem
    use Libraries.Interface.Controls.DefaultTreeItemContent
    TreeItem item
    item:SetName("Main.quorum")
    DefaultTreeItemContent content
    item:SetTreeItemContent(content)
    */
    action SetTreeItemContent(TreeItemContent content)
        if contents not= undefined
            parent:Item2D:Remove(contents)
        end

        contents = content
        content:SetInterfaceOptionsKey(GetInterfaceOptionsKey())
        content:SetTreeItem(me)
        parent:Item2D:Add(0, contents)

        // The highlight stays first, so it is drawn behind the row.
        parent:Item2D:Remove(rowHighlight)
        parent:Item2D:Add(0, rowHighlight)
    end

    /*
    This action returns the control that draws this item's row, or undefined
    if it hasn't been set or drawn yet.

    Attribute: Returns The content of this item's row, or undefined.
    */
    action GetTreeItemContent returns TreeItemContent
        return contents
    end

    /*
    This action moves the selection's drawing from one path to another under
    this item. Each path starts with the child of this item it goes through,
    and an empty path means this item itself. Where the two paths are the
    same, nothing changes; where they part, the old items are drawn as not
    selected and the new item as selected. Items are taken off the front of
    both paths as it works. The Tree calls it when the selection changes, so
    most programs use Select instead.

    Attribute: Parameter oldPath The path below this item to the old selection.

    Attribute: Parameter newPath The path below this item to the new selection.
    */
    action UpdateSelection(Array<TreeItem> oldPath, Array<TreeItem> newPath)

        TreeItem oldItem = undefined
        TreeItem newItem = undefined

        if not oldPath:IsEmpty()
            oldItem = oldPath:RemoveFromFront()
        end

        if not newPath:IsEmpty()
            newItem = newPath:RemoveFromFront()
        end

        if oldItem = newItem
            if oldItem = undefined
                return now
            else
                oldItem:UpdateSelection(oldPath, newPath)
            end
        else
            if oldItem not= undefined
                oldItem:RecursiveDeselect(oldPath)
            else
                LostSelection()
            end
            if newItem not= undefined
                newItem:RecursiveSelect(newPath)
            else
                GainedSelection()
            end
        end
    end

    /*
    This action follows the path down from this item and draws the last item on
    it as selected, or this item if the path is empty. Items are taken off the
    front of the path as it works. The Tree calls it, so most programs use
    Select instead.

    Attribute: Parameter path The path below this item to the selected item.
    */
    action RecursiveSelect(Array<TreeItem> path)
        if not path:IsEmpty()
            TreeItem item = path:RemoveFromFront()
            if item not= undefined
                item:RecursiveSelect(path)
            end
        else
            GainedSelection()
        end
    end

    /*
    This action follows the path down from this item and draws every item on
    it, and this item, as not selected. Items are taken off the front of the
    path as it works. The Tree calls it, so most programs use Deselect instead.

    Attribute: Parameter path The path below this item to the old selection.
    */
    action RecursiveDeselect(Array<TreeItem> path)
        if not path:IsEmpty()
            TreeItem item = path:RemoveFromFront()
            if item not= undefined
                item:RecursiveDeselect(path)
            end
        end
        LostSelection()
    end

    /*
    This action returns the height of this item along with the items showing
    under it. When the item is open, the heights of the items under it, and
    the gaps between them, are added to its own height. When it is closed,
    this is just its own height.

    Attribute: Returns The height of this item and the items showing under it.
    */
    action GetTreeHeight returns number
        if open
            number height = GetHeight()

            TreeLayout treeLayout = GetPanelLayout()
            // TreeLayout scales the gap between rows by the panel's scale.
            number padding = treeLayout:GetPadding() * panel:GetInterfaceScale()

            integer counter = 0
            Array<Item2D> children = panel:GetChildren()
            repeat while counter < children:GetSize()
                Item2D child = children:Get(counter)

                if child is TreeItem
                    TreeItem item = cast(TreeItem, child)
                    height = height + item:GetTreeHeight()
                else
                    height = height + child:GetHeight()
                end

                counter = counter + 1
            end

            height = height + children:GetSize() * padding

            return height
        else
            return GetHeight()
        end
    end

    /*
    This action returns the width needed to show this item and, when it is
    open, the items under it. Each child's width is measured from the tree's
    left edge, so its indent counts. When the item is closed, this is just its
    own width.

    Attribute: Returns The width of this item and the items showing under it.
    */
    action GetTreeWidth returns number
        if open
            number width = GetWidth()
            number rootX = 0
            if parentTree not= undefined
                rootX = parentTree:GetGlobalX()
            end
            
            integer counter = 0
            
            repeat while counter < treeItems:GetSize()
                TreeItem item = treeItems:Get(counter)

                number childWidth = item:GetTreeWidth()
                number x = item:GetGlobalX() - rootX

                if x + childWidth > width
                    width = x + childWidth
                end

                counter = counter + 1
            end

            return width
        else
            return GetWidth()
        end
    end

    /*
    This action sets the behavior run when this item is activated, such as when
    it is double clicked or when enter is pressed while it is selected.

    Attribute: Parameter behavior The behavior to run, or undefined for none.

    Attribute: Example
    // In the file OpenFileBehavior.quorum:
    use Libraries.Interface.Behaviors.Behavior
    use Libraries.Interface.Events.BehaviorEvent

    class OpenFileBehavior is Behavior
        action Run(BehaviorEvent event)
            output "Opening " + event:GetItem():GetName()
        end
    end

    // In the file Main.quorum:
    use Libraries.Interface.Controls.TreeItem

    class Main
        action Main
            TreeItem item
            item:SetName("Main.quorum")
            OpenFileBehavior behavior
            item:SetBehavior(behavior)
        end
    end
    */
    action SetBehavior(Behavior behavior)
        activationBehavior = behavior
    end

    /*
    This action returns the behavior set with SetBehavior, or undefined if
    there is none.

    Attribute: Returns The item's activation behavior, or undefined.
    */
    action GetActivationBehavior returns Behavior
        return activationBehavior
    end

    /*
    The ToggleOpen action opens this item if it is closed, or closes it if it
    is open. Items without children do nothing. A double click, a tap, and a
    screen reader's activation all use it.
    */
    action ToggleOpen
        if not panel:GetChildren():IsEmpty()
            if open
                Close()
            else
                Open()
            end
        end
    end

    /*
    This action is called when the item is double clicked. It opens the item
    if it is closed, or closes it if it is open, and then activates it, which
    runs its behavior.

    Attribute: Parameter event The event for the double click.
    */
    action OnDoubleClick(BehaviorEvent event)
        ToggleOpen()
        Activate()
    end

    /*
    This action is called when the item is clicked with the mouse. It selects
    the item.
    */
    action ClickedMouse
        parent:Control:ClickedMouse()
        Select()
    end

    /*
    This action is called when this item becomes the selected item. It draws
    the row as selected: the content in the selection colors and the highlight
    band behind the row in the focused selection color. The Tree calls it, so
    most programs use Select instead.
    */
    action GainedSelection
        parent:Control:GainedSelection()
        if contents not= undefined
            contents:GainedSelection()
        end
        rowHighlight:GainedSelection()
        rowHighlight:SetShowsFocus(true)
        ShowRowHighlight()
        // On the band, the trailing text takes the selection text color,
        // as the name does. Rows without the band keep its own color.
        if trailingLabel not= undefined and contents is DefaultTreeItemContent
            trailingLabel:GainedSelection()
        end
    end

    /*
    This action is called when this item stops being the selected item. The
    row is drawn in its normal colors again, and the highlight band is hidden
    unless the mouse is over the row. The Tree calls it, so most programs use
    Deselect instead.
    */
    action LostSelection
        parent:Control:LostSelection()
        if contents not= undefined
            contents:LostSelection()
        end
        rowHighlight:LostSelection()
        UpdateRowHighlightVisibility()
        if trailingLabel not= undefined
            trailingLabel:LostSelection()
        end
    end

    /*
    This action is called when this item is selected and its Tree loses the
    focus. The row is drawn in the unfocused selection colors.
    */
    action UnfocusedSelection
        if contents not= undefined
            contents:UnfocusedSelection()
        end
        rowHighlight:GainedSelection()
        rowHighlight:SetShowsFocus(false)
        ShowRowHighlight()
        if trailingLabel not= undefined and contents is DefaultTreeItemContent
            trailingLabel:UnfocusedSelection()
        end
    end

    /*
    This action is used when the mouse, or a finger on a touch screen, moves
    onto this row: the row is tinted with the mouse over color.
    */
    action BeginMouseOver
        parent:Control:BeginMouseOver()
        rowHighlight:BeginMouseOver()
        ShowRowHighlight()
    end

    /*
    This action is used when the mouse, or a finger, leaves this row.
    */
    action EndMouseOver
        parent:Control:EndMouseOver()
        rowHighlight:EndMouseOver()
        UpdateRowHighlightVisibility()
    end

    /*
    This action returns whether a point, in the layer's coordinates, is on this
    item. Besides the item itself, its whole row counts: the tree's width at
    this row's height, where its highlight is drawn, so a click or tap beside
    the words selects the row as the highlight suggests.

    Attribute: Parameter containsX The point's x coordinate
    Attribute: Parameter containsY The point's y coordinate
    Attribute: Returns True if the point is on this item or across its row
    */
    action Contains(number containsX, number containsY) returns boolean
        if parent:Item2D:Contains(containsX, containsY)
            return true
        end
        Tree tree = GetTree()
        if tree = undefined or contents = undefined
            return false
        end
        number rowBottom = contents:GetGlobalY()
        number rowLeft = tree:GetGlobalX()
        return containsY >= rowBottom and containsY <= rowBottom + contents:GetHeight()
            and containsX >= rowLeft and containsX <= rowLeft + tree:GetWidth()
    end

    /*
    Each frame, while the row's highlight is showing, it is kept the width of
    the tree and the height of this row, since the tree's width and this row's
    place in it change with layout and scrolling. The trailing text, if this
    row has any, is kept right after the row's content, and the leading bar,
    if it has one, at the tree's left edge; each is only moved when what it
    is placed by changed.
    */
    action Update(number seconds)
        if rowHighlight:IsShowing()
            PlaceRowHighlight()
        end
        if trailingLabel not= undefined
            if trailingLabel:IsShowing()
                PlaceTrailingLabel()
            end
        end
        if leadingBar not= undefined
            if leadingBar:IsShowing()
                PlaceLeadingBar()
            end
        end
    end

    /*
    This action shows a short text right after this item's name, on its
    row, such as a word for a file's version control state ("modified").
    The text is drawn in the theme's text color for tree items. The row is
    made wide enough for it, so it never covers the name, and it moves with
    the name when the name changes. On a selected row it is drawn in the
    selection text color, as the name is. The text is not read by screen
    readers; to say the same thing to them, put it in the item's description
    (SetDescription). An empty text removes it. The mouse goes through it to
    the row, so clicking it selects the row.

    Attribute: Parameter value The text to show, or "" for none.

    Attribute: Example

        use Libraries.Interface.Controls.Tree
        use Libraries.Interface.Controls.TreeItem
        use Libraries.Game.Game

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Tree tree

                TreeItem boss
                boss:SetName("Boss.quorum")
                boss:SetTrailingText("untracked")
                boss:SetDescription("Untracked")
                tree:Add(boss)

                TreeItem player
                player:SetName("Player.quorum")
                tree:Add(player)

                tree:SetPosition(50, 300)
                Add(tree)
            end
        end
    */
    action SetTrailingText(text value)
        // No color of its own: the label's layout properties fall back to
        // the theme's font color for this item's interface options key
        // (normally "TreeItem"), and follow the theme when it changes.
        ApplyTrailingText(value, undefined)
    end

    /*
    This action shows a short text right after this item's name, on its
    row, in the given color, such as a word for a file's version control
    state ("modified"). The row is made wide enough for it, so it never
    covers the name, and it moves with the name when the name changes. On a
    selected row it is drawn in the selection text color, as the name is.
    The text is not read by screen readers; to say the same thing to them,
    put it in the item's description (SetDescription). An empty text removes
    it. The mouse goes through it to the row, so clicking it selects the
    row. To use the theme's text color, use SetTrailingText(value).

    Attribute: Parameter value The text to show, or "" for none.
    Attribute: Parameter color The text's color when the row is not selected.

    Attribute: Example

        use Libraries.Interface.Controls.Tree
        use Libraries.Interface.Controls.TreeItem
        use Libraries.Game.Graphics.Color
        use Libraries.Game.Game

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Tree tree

                TreeItem hero
                hero:SetName("Hero.quorum")
                Color color
                hero:SetTrailingText("modified", color:Gray())
                hero:SetDescription("Modified")
                tree:Add(hero)

                TreeItem player
                player:SetName("Player.quorum")
                tree:Add(player)

                tree:SetPosition(50, 300)
                Add(tree)
            end
        end
    */
    action SetTrailingText(text value, ColorGroup color)
        // A missing color falls back to the theme's, as SetTrailingText(value).
        ApplyTrailingText(value, color)
    end

    /*
        This action shows, changes or removes the text after this item's name on
        its row. An empty value hides it. A color of undefined, which
        SetTrailingText(value) passes, leaves the text in the theme's color. The row
        is laid out again when the text's width may have changed.

        Attribute: Parameter value The text to show, or "" to remove it.

        Attribute: Parameter color The text's color, or undefined for the theme's color.
    */
    private action ApplyTrailingText(text value, ColorGroup color)
        if value = ""
            trailingText = ""
            trailingColor = color
            if trailingLabel not= undefined
                if trailingLabel:IsShowing()
                    trailingLabel:Hide()
                    // The row is only as wide as its content again.
                    RequestLayout()
                end
            end
            return now
        end

        if trailingLabel = undefined
            MakeTrailingLabel()
        end

        boolean changed = false
        if color not= trailingColor or trailingText = ""
            trailingLabel:SetFontColor(color)
            changed = true
        end
        if value not= trailingText
            trailingLabel:SetText(value)
            changed = true
        end
        trailingText = value
        trailingColor = color

        if not trailingLabel:IsShowing()
            trailingLabel:Show()
            changed = true
        end
        if changed
            // Placed again on the next Update; laid out again, since the
            // row's room depends on the text's width.
            placedContentWidth = -1
            RequestLayout()
        end
    end

    /*
    This action returns the text shown after this item's name on its row
    (SetTrailingText), or "" if there is none.

    Attribute: Returns The trailing text, or "" if there is none.
    */
    action GetTrailingText returns text
        return trailingText
    end

    /*
    This action returns the room, in pixels, kept after this row's content
    for its trailing text: the text's width and a small gap. TreeItemLayout
    adds it to the row's width, so the row is as wide as its name and its
    text. It is 0 when the row has no trailing text. Most programs never use
    this action directly.

    Attribute: Returns The room after this row's content, in pixels.
    */
    action GetTrailingRoom returns number
        // Neither the label nor the leading bar is laid out by a Layout, so
        // their layout requests (from SetText or SetInterfaceScale) are
        // answered here, where this row is laid out. Left set, they would
        // make this row lay out again every frame.
        if leadingBar not= undefined
            if leadingBar:NeedsLayout()
                leadingBar:ResetLayoutFlag()
            end
        end
        if trailingLabel = undefined
            return 0
        end

        if trailingLabel:NeedsLayout()
            trailingLabel:ResetLayoutFlag()
        end

        if not trailingLabel:IsShowing()
            return 0
        end
        SyncTrailingFont()
        return trailingLabel:GetWidth() + TRAILING_GAP * GetInterfaceScale()
    end

    /*
        This action makes the label for the trailing text, the first time this row
        has some. The label starts hidden, is skipped by screen readers and the
        mouse, uses the row's font size, and draws no selection box of its own. It
        is drawn on top of the row's band.
    */
    private action MakeTrailingLabel
        ControlLabel newLabel
        trailingLabel = newLabel
        // Set before it is added, so it never reaches the accessibility
        // tree. Screen readers read the item's name, then its description.
        trailingLabel:SetAccessibilityCode(trailingLabel:parent:Item:NOT_ACCESSIBLE)
        // Clicks and hovers go through it to the row (Contains counts the
        // tree's whole width as the row), so it acts like the row.
        trailingLabel:SetAcceptsMouseInput(false)
        trailingLabel:SetInterfaceOptionsKey(GetInterfaceOptionsKey())
        trailingLabel:SetInterfaceScale(GetInterfaceScale())
        trailingLabel:SetFontSize(GetFontSize())

        // The band shows the selection, so the label only changes its text
        // color and draws no box of its own, as the name's label does.
        Color clear
        trailingLabel:SetSelectionColor(clear:CustomColor(0, 0, 0, 0))
        trailingLabel:SetUnfocusedSelectionColor(clear:CustomColor(0, 0, 0, 0))

        trailingLabel:Hide()
        // Added after the content and the band, so it is drawn on top of
        // the band. TreeItemLayout doesn't lay it out.
        parent:Item2D:Add(trailingLabel)

        // A row that is already selected shows it at once.
        if contents is DefaultTreeItemContent and rowHighlight:IsRenderingSelection()
            if rowHighlight:IsRenderingFocus()
                trailingLabel:GainedSelection()
            else
                trailingLabel:UnfocusedSelection()
            end
        end
    end

    /*
        This action gives the trailing label the row's font, at the row's own font
        size, when the row's font has changed.
    */
    private action SyncTrailingFont
        Font font = GetFont()
        if font = undefined or font = trailingFont
            return now
        end
        trailingFont = font
        trailingLabel:SetFont(font)
        // SetFont takes the shared font's current size, which may already
        // be scaled, so the row's own size is set again, as
        // DefaultTreeItemContent does for the name.
        trailingLabel:SetFontSize(GetFontSize())
    end

    /*
    Places the trailing label right after this row's content, after a small
    gap, centered on this row's line, in this item's coordinates
    (the content is at 0, 0, as TreeItemLayout puts it). It reads three
    numbers and returns at once if none changed since the last time, so it
    is cheap to call each frame.
    */
    private action PlaceTrailingLabel
        if contents = undefined
            return now
        end

        if trailingLabel:GetInterfaceScale() not= GetInterfaceScale()
            trailingLabel:SetInterfaceScale(GetInterfaceScale())
        end
        SyncTrailingFont()
        LayoutProperties properties = trailingLabel:GetDefaultLayoutProperties()
        if properties:NeedsRendering()
            trailingLabel:LoadGraphics(properties)
        end

        number contentWidth = contents:GetWidth()
        number rowHeight = contents:GetHeight()
        number labelWidth = trailingLabel:GetWidth()

        boolean moved = contentWidth not= placedContentWidth or rowHeight not= placedRowHeight
        if not moved
            moved = labelWidth not= placedLabelWidth
        end
        if not moved
            return now
        end

        placedContentWidth = contentWidth
        placedRowHeight = rowHeight
        placedLabelWidth = labelWidth

        number x = contentWidth + TRAILING_GAP * GetInterfaceScale()
        number y = (rowHeight - trailingLabel:GetHeight()) / 2
        trailingLabel:SetPosition(x, y)
    end

    /*
    This action shows a thin bar at the left edge of the tree, on this
    item's row, in the given color, such as a mark for a file's version
    control state. The bar is a few points wide with rounded ends, a little
    shorter than the row, and is drawn over the row's highlight, so it shows
    on a selected row too. Filled, it is the given color; outlined, only its
    edge is, and its inside is clear, which can tell two states apart that
    share a color. Calling it again changes the bar; RemoveLeadingBar takes
    it away. The bar is not read by screen readers; to say the same thing
    to them, put it in the item's description (SetDescription). The mouse
    goes through it to the row, so clicking it selects the row.

    Attribute: Parameter color The bar's color.
    Attribute: Parameter outlined True to draw only the bar's edge, false to fill it.

    Attribute: Example

        use Libraries.Interface.Controls.Tree
        use Libraries.Interface.Controls.TreeItem
        use Libraries.Game.Graphics.Color
        use Libraries.Game.Game

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                Tree tree
                Color color

                TreeItem hero
                hero:SetName("Hero.quorum")
                hero:SetLeadingBar(color:Blue(), false)
                hero:SetDescription("Modified")
                tree:Add(hero)

                TreeItem boss
                boss:SetName("Boss.quorum")
                boss:SetLeadingBar(color:Green(), true)
                boss:SetDescription("Untracked")
                tree:Add(boss)

                tree:SetPosition(50, 300)
                Add(tree)
            end
        end
    */
    action SetLeadingBar(ColorGroup color, boolean outlined)
        if color = undefined
            RemoveLeadingBar()
            return now
        end
        if leadingBar = undefined
            MakeLeadingBar()
        end

        leadingBar:SetBorderColor(color)
        if outlined
            Color clear
            leadingBar:SetBackgroundColor(clear:CustomColor(0, 0, 0, 0))
            leadingBar:SetBorderThickness(BAR_OUTLINE)
        else
            leadingBar:SetBackgroundColor(color)
            leadingBar:SetBorderThickness(0)
        end
        leadingBar:RequestVerticesUpdate()

        if not leadingBar:IsShowing()
            leadingBar:Show()
        end
        // Placed again on the next Update.
        barOffset = -1
    end

    /*
    This action takes away the bar shown at the left edge of the tree on
    this item's row (SetLeadingBar). It does nothing if there is none.

    Attribute: Example

        use Libraries.Interface.Controls.TreeItem
        use Libraries.Game.Graphics.Color

        TreeItem hero
        hero:SetName("Hero.quorum")
        Color color
        hero:SetLeadingBar(color:Blue(), false)
        hero:RemoveLeadingBar()
    */
    action RemoveLeadingBar
        if leadingBar = undefined
            return now
        end
        if leadingBar:IsShowing()
            leadingBar:Hide()
        end
    end

    /*
    This action returns whether this item's row shows a bar at the left edge
    of the tree (SetLeadingBar).

    Attribute: Returns True if the row shows a leading bar.
    */
    action HasLeadingBar returns boolean
        if leadingBar = undefined
            return false
        end
        return leadingBar:IsShowing()
    end

    /*
        This action makes the leading bar, the first time this row has one: a bar
        with fully rounded ends, drawn on top of the row's band. It starts hidden,
        and screen readers, the mouse and the focus all skip it.
    */
    private action MakeLeadingBar
        Control newBar
        leadingBar = newBar
        // Set before it is added, so it never reaches the accessibility
        // tree. Screen readers read the item's name, then its description.
        leadingBar:SetAccessibilityCode(leadingBar:parent:Item:NOT_ACCESSIBLE)
        leadingBar:SetFocusable(false)
        // Clicks and hovers go through it to the row (Contains counts the
        // tree's whole width as the row), so it acts like the row.
        leadingBar:SetAcceptsMouseInput(false)
        leadingBar:SetInterfaceScale(GetInterfaceScale())
        // Fully rounded ends: a rounding of 1 is half the bar's width.
        leadingBar:SetCornerRounding(1, 1, 1, 1)

        // Drawn as a box with a border, as the band is.
        ControlShaderView view
        view:Initialize()
        leadingBar:SetView2D(view)

        leadingBar:Hide()
        // Added after the content and the band, so it is drawn on top of
        // the band. TreeItemLayout doesn't lay it out.
        parent:Item2D:Add(leadingBar)
    end

    /*
    Places the leading bar at the tree's left edge, plus a small inset, a
    little shorter than this row, in this item's coordinates (its left edge
    is moved back by this row's indent, as PlaceRowHighlight does). It reads
    three numbers and returns at once if none changed since the last time,
    so it is cheap to call each frame.
    */
    private action PlaceLeadingBar
        Tree tree = GetTree()
        if tree = undefined or contents = undefined
            return now
        end

        number scale = GetInterfaceScale()
        number offset = tree:GetGlobalX() - GetGlobalX()
        number rowHeight = contents:GetHeight()

        boolean moved = offset not= barOffset or rowHeight not= barRowHeight
        if not moved
            moved = scale not= barScale
        end
        if not moved
            return now
        end

        barOffset = offset
        barRowHeight = rowHeight
        barScale = scale

        if leadingBar:GetInterfaceScale() not= scale
            leadingBar:SetInterfaceScale(scale)
        end

        number height = rowHeight - BAR_VERTICAL_INSET * scale * 2
        if height < 0
            height = 0
        end
        leadingBar:SetPosition(offset + BAR_INSET * scale, BAR_VERTICAL_INSET * scale)
        leadingBar:SetSize(BAR_WIDTH * scale, height)

        LayoutProperties properties = leadingBar:GetDefaultLayoutProperties()
        if properties:NeedsRendering()
            leadingBar:LoadGraphics(properties)
        end
        // SetInterfaceScale asks for a layout no Layout answers (see
        // GetTrailingRoom).
        if leadingBar:NeedsLayout()
            leadingBar:ResetLayoutFlag()
        end
    end

    /*
        This action places and shows the band that marks the row as selected or
        under the pointer. Only the standard row content draws its selection with
        the band; other contents, such as the scene editor's palette, draw their
        own, so for them nothing happens.
    */
    private action ShowRowHighlight
        if not (contents is DefaultTreeItemContent)
            return now
        end
        PlaceRowHighlight()
        rowHighlight:Show()
    end

    /*
        This action hides the row's band once the row is neither selected nor
        under the pointer.
    */
    private action UpdateRowHighlightVisibility
        if not rowHighlight:IsRenderingSelection() and not rowHighlight:IsRenderingMouseOver()
            rowHighlight:Hide()
        end
    end

    /*
    Sizes the highlight as a rounded band across the whole tree, inset a
    little from its sides, at this row's height. It is placed in this item's
    coordinates, so its left edge is moved back by this row's indent.
    */
    private action PlaceRowHighlight
        Tree tree = GetTree()
        if tree = undefined or contents = undefined
            return now
        end

        if rowHighlight:GetInterfaceScale() not= GetInterfaceScale()
            rowHighlight:SetInterfaceScale(GetInterfaceScale())
        end

        number inset = 4 * GetInterfaceScale()
        number x = tree:GetGlobalX() - GetGlobalX() + inset
        number width = tree:GetWidth() - inset * 2
        if width < 0
            width = 0
        end
        number height = contents:GetHeight()

        if rowHighlight:GetX() not= x or rowHighlight:GetY() not= 0
            rowHighlight:SetPosition(x, 0)
        end
        if rowHighlight:GetWidth() not= width or rowHighlight:GetHeight() not= height
            rowHighlight:SetSize(width, height)
        end

        LayoutProperties properties = rowHighlight:GetDefaultLayoutProperties()
        if properties:NeedsRendering()
            rowHighlight:LoadGraphics(properties)
        end
    end

    /*
    This action makes this item the selected item of its Tree. If the item
    isn't in a tree, nothing happens.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    file:Select()
    */
    action Select
        // Don't actually select here! Go to Tree and ask it to select us.
        // We do this to allow the Tree to fully update its information,
        // deselect the previous selection, and prevent infinite loops.
        if parentTree not= undefined
            parentTree:Select(GetTreePath())
        end
    end

    /*
    This action clears the selection of this item's Tree, so no item is
    selected. If the item isn't in a tree, nothing happens.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    file:Select()
    file:Deselect()
    */
    action Deselect
        // Don't actually select here! Go to Tree and ask it to deselect us.
        // We do this to allow the Tree to fully update its information,
        // deselect this, and prevent infinite loops.
        if parentTree not= undefined
            parentTree:Deselect()
        end
    end

    /*
    This action returns true if this item has items under it.

    Attribute: Returns True if the item has children, false otherwise.
    */
    action IsSubtree returns boolean
        return not treeItems:IsEmpty()
    end

    /*
    This action returns the path from the top-level item down to this item,
    with this item last. The Tree's Select action takes a path in this form.

    Attribute: Returns The items from the top level down to this item.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    tree:Select(file:GetTreePath())
    */
    action GetTreePath returns Array<TreeItem>
        Array<TreeItem> path
        path:Add(me)
        if parentTreeItem not= undefined
            Array<TreeItem> a = parentTreeItem:GetTreePath(path)
            return a
        end
        return path
    end

    /*
    This action puts this item at the front of the given path, then has its
    parent do the same, building the path from the top level down.

    Attribute: Parameter array The path built so far, below this item.

    Attribute: Returns The finished path.
    */
    private action GetTreePath(Array<TreeItem> array) returns Array<TreeItem>
        array:AddToFront(me)
        if parentTreeItem not= undefined
            return parentTreeItem:GetTreePath(array)
        end

        return array
    end

    /*
    This action selects the row below this item: its first child if it is
    open, or else the next item after it, moving up through its parents as
    needed. The Tree calls it for the down arrow key.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Open()
    folder:Select()
    folder:SelectionDown()
    */
    action SelectionDown
        if IsSubtree() and IsOpen()
            treeItems:Get(0):Select()
        elseif parentTreeItem not= undefined
            parentTreeItem:SelectionDown(me)
        elseif parentTree not= undefined
            parentTree:SelectionSkipForward()
        end
    end

    /*
    This action selects the item after the given child of this item. The
    child is found by identity, not by name, so two children with the same
    name, such as two "Main.quorum" files, aren't mixed up. This is how
    MenuItem finds its place, too.
    */
    private action SelectionDown(TreeItem previous)
        if IsSubtree() and IsOpen()
            integer counter = 0
            repeat while counter < treeItems:GetSize()
                if treeItems:Get(counter):Equals(previous)
                    integer select = counter + 1

                    // If the last element was selected, go to the next subtree.
                    if select >= treeItems:GetSize()
                        if parentTreeItem not= undefined
                            parentTreeItem:SelectionDown(me)
                        elseif parentTree not= undefined
                            parentTree:SelectionSkipForward()
                        end
                        return now
                    end

                    treeItems:Get(select):Select()
                    return now
                end
                counter = counter + 1
            end
        elseif parentTreeItem not= undefined
            parentTreeItem:SelectionDown(me)
        elseif parentTree not= undefined
            parentTree:SelectionSkipForward()
        end
    end

    /*
    This action selects the row above this item: the last showing row of the
    item before it, or its parent if it is the first child. For a top-level
    item, it is the last showing row of the top-level item before it. The Tree
    calls it for the up arrow key.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Open()
    file:Select()
    file:SelectionUp()
    */
    action SelectionUp
        if parentTreeItem not= undefined
            parentTreeItem:SelectionUp(me)
        elseif parentTree not= undefined
            parentTree:SelectionSkipBackward()
        end
    end

    /*
    This action selects the item before the given child of this item, found
    by identity, as SelectionDown does.
    */
    private action SelectionUp(TreeItem previous)
        if IsSubtree() and IsOpen()
            integer counter = 0
            repeat while counter < treeItems:GetSize()
                if treeItems:Get(counter):Equals(previous)
                    integer select = counter - 1
                    // If this was the first element, select the subtree containing it.
                    if select < 0
                        Select()
                        return now
                    end

                    treeItems:Get(select):SelectLastElement()
                    return now
                end
                counter = counter + 1
            end
        elseif parentTreeItem not= undefined
            parentTreeItem:SelectionUp(me)
        elseif parentTree not= undefined
            parentTree:SelectionSkipBackward()
        end
    end

    /*
    This action selects the last showing row inside this item: if it is open,
    the last showing row of its last child, or else this item itself.

    Attribute: Example
    use Libraries.Interface.Controls.Tree
    use Libraries.Interface.Controls.TreeItem
    Tree tree
    TreeItem folder
    folder:SetName("Scripts")
    tree:Add(folder)
    TreeItem file
    file:SetName("Main.quorum")
    folder:Add(file)
    folder:Open()
    folder:SelectLastElement()
    */
    action SelectLastElement
        if IsSubtree() and IsOpen()
            treeItems:Get(treeItems:GetSize() - 1):SelectLastElement()
        else
            Select()
        end
    end

    /*
    This action returns how many items have been added directly under this
    one. Items under those are not counted.

    Attribute: Returns The number of children of this item.
    */
    action GetSize returns integer
        return treeItems:GetSize()
    end

    /*
    This action is used to load the graphical components of the Control. This is
    handled automatically by the Game engine as needed, and most users shouldn't
    need to use this action directly.
    */
    action LoadGraphics(LayoutProperties properties)
        if contents = undefined
            DefaultTreeItemContent defaultContents
            SetTreeItemContent(defaultContents)
            defaultContents:SetFontSize(properties:GetFontSize())
            defaultContents:SetInterfaceScale(properties:GetInterfaceScale())
            defaultContents:SetBackgroundColor(properties:GetBackgroundColor())
        else
            contents:GetDefaultLayoutProperties():SetRenderingFlag(true)
        end

        TreeLayout panelLayout = GetPanelLayout()
        // Hardcoded value sufficient for basic cases. Should be replaced with
        // something more responsive to design in the future.
        panelLayout:SetPadding(2)
        // The indent is one and a half lines of the font, in the same units
        // as the font size; TreeItemLayout scales it. The font is shared
        // with the label, which resizes it when it draws, so a copy at the
        // unscaled size is measured.
        integer height = 12
        Font font = properties:GetFont()
        if font not= undefined
            Font measure = font:Copy()
            measure:SetSize(cast(integer, properties:GetFontSize()))
            height = measure:GetLineHeight()
        end
        panelProperties:SetPixelX(height/2 * 3)

        if IsSelected()
            // If this is selected, we need the visuals to reflect that.
            GainedSelection()
        end

        parent:Control:LoadGraphics(properties)
    end

    /*
        Returns whether or not the TreeItem is selected.

        Attribute: Returns true if the item is selected.
    */
    action IsSelected returns boolean
        if GetTree() = undefined
            return false
        end
        Array<TreeItem> path = GetTree():GetSelection():GetPath()
        if path:IsEmpty()
            return false
        end

        return path:GetFromEnd() = me
    end

    /*
    This action returns true, because a TreeItem can hold other accessible
    items (its children). Screen readers use this to treat it as the parent of
    the items under it. Most programs never use this action directly.

    Attribute: Returns True, since a TreeItem is always an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end
end
