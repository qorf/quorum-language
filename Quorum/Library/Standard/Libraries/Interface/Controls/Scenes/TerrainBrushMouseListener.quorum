package Libraries.Interface.Controls.Scenes

use Libraries.Interface.Events.MouseMovementListener
use Libraries.Interface.Events.MouseEvent

/*
    The TerrainBrushMouseListener moves a terrain's brush to the ground under
    the pointer, while a terrain tool is chosen in the scene editor (step 7).
    The SceneEditor adds one to itself.
*/
class TerrainBrushMouseListener is MouseMovementListener
    SceneEditor editor = undefined

    /*
        Sets the scene editor whose terrain brush follows the pointer.

        Attribute: Parameter editor The scene editor
    */
    action SetSceneEditor(SceneEditor editor)
        me:editor = editor
    end

    // Hovering no longer moves the brush: the gray ghost ring shows where a
    // click would move the terrain cursor.
    action MovedMouse(MouseEvent event)
        if editor = undefined
            return now
        end
        // A new item's preview has its own ghost, showing where a click
        // would move it.
        if editor:HasActivePreview()
            editor:MovePreviewGhostToPointer(event:GetX(), event:GetY())
        elseif editor:IsRiverToolActive()
            // The River tool shows the next stretch of the river being
            // drawn instead (River plan R5).
            editor:MoveRiverLineToPointer(event:GetX(), event:GetY())
        else
            editor:MoveTerrainGhostToPointer(event:GetX(), event:GetY())
        end
    end

    // During a stroke with the mouse, the brush follows the pointer (step 8).
    action DraggedMouse(MouseEvent event)
        if editor not= undefined and editor:IsTerrainStroking()
            editor:MoveTerrainBrushToPointer(event:GetX(), event:GetY())
        elseif editor not= undefined and editor:IsDraggingRiverPoint()
            // A river's point being moved follows the pointer (River plan
            // R6).
            editor:DragRiverPoint(event:GetX(), event:GetY())
        end
    end
end
