/*
SceneEditor is the main Control that enables adding a functional scene editor
to a Game. 

Attribute: Example

TODO
need to implement more to understand how to structure examples.

*/
class SceneEditor is Control, DefaultSceneManager

    File file = undefined
    File projectLocation = undefined
    GameStateManager manager
    SceneProperties properties

    Array<EditorLayer> layers

    SceneConstants constants
    SceneEditorSelection selection

    Array<SceneEditorChangeListener> sceneEditorChangeListeners

    SceneEditorEditManager editManager

    // The rotational speed measured in degrees,
    // and the directional speed, measured in 3D world units.
    public constant number CAMERA_ROTATIONAL_SPEED_3D = 15
    public constant number CAMERA_DIRECTIONAL_SPEED_3D = 1

    public constant number SELECTION_ROTATIONAL_SPEED_3D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_3D = 5

    public constant number CAMERA_ROTATIONAL_SPEED_2D = 90
    public constant number CAMERA_DIRECTIONAL_SPEED_2D = 600
    public constant number SELECTION_ROTATIONAL_SPEED_2D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_2D = 600

    /*
    Velocities of the layer's camera.
    Directions are always -1, 0, or 1, and are multiplied by either the rotational
    or directional speed during the Update to produce the per-frame velocity.
    */
    integer yawDirection = 0
    integer pitchDirection = 0
    integer rollDirection = 0
    integer forwardDirection = 0
    integer strafeDirection = 0
    integer verticalDirection = 0

    // The velocity of the currently selected item on each axis.
    integer selectionXDirection = 0
    integer selectionYDirection = 0
    integer selectionZDirection = 0
    integer selectionYawDirection = 0
    integer selectionPitchDirection = 0
    integer selectionRollDirection = 0

    // Vectors which are constantly reused for frequent calculations.
    Vector2 workVector2
    Vector3 workVector3

    Accessibility accessibility = undefined
    Math math
    Color color

    /*
    A subset of the items, filtered in some way (e.g., the items in view of
    the camera). These can be iterated over to query for more information or to
    modify the elements.
    */
    Array<Item> filteredItems = undefined

    /*
    "Highlight" drawables used to show which items have been filtered.
    */
    Array<SelectionHighlight> filterHighlights

    /*
    Tracks how many times each name has been used from the palette.
    Used to add numbers to the end of the names of duplicate items.
    */
    HashTable<text, integer> nameCounts

    // Used for when a movement key is held and the grid lock is enabled.
    number gridMoveTimer = 0
    number gridMoveTimerMax = 0.5

    // A reference to the property dialogs for this controller.
    Item3DPropertiesDialog item3dPropertiesDialog
    Item2DPropertiesDialog item2dPropertiesDialog
    Camera2DPropertiesDialog camera2dPropertiesDialog
    Camera3DPropertiesDialog camera3dPropertiesDialog
    PointLightPropertiesDialog pointLightPropertiesDialog
    SpotLightPropertiesDialog spotLightPropertiesDialog
    Audio3DPropertiesDialog audio3DPropertiesDialog

    // A terrain's properties (step 5). They are added only with a
    // Properties panel, since two floating dialogs would cover each other.
    TerrainPropertiesDialog terrainPropertiesDialog
    TerrainPhysicsPropertiesDialog terrainPhysicsPropertiesDialog
    TerrainBrushPropertiesDialog terrainBrushPropertiesDialog
    TerrainMaterialsPropertiesDialog terrainMaterialsPropertiesDialog
    TerrainGeneratePropertiesDialog terrainGeneratePropertiesDialog

    // Makes and changes terrain in bulk: presets, stamps, erosion and auto
    // paint (step 10).
    TerrainGenerator generator

    // What finding a new texture set's maps by name found, said when the
    // layer is added (step 14).
    text layerMaterialNote = ""

    // A terrain's brush (step 7): the terrain whose tool is chosen, and the
    // ring that shows the brush on its ground. The ring is placed again only
    // when the brush moves or changes size.
    EditorTerrain brushTerrain = undefined
    TerrainBrushPreview brushPreview = undefined
    boolean brushPreviewShown = false
    number previewX = 0
    number previewZ = 0
    number previewSize = 0
    TerrainBrushMouseListener brushMouseListener

    // A ramp being marked (step 8): a green ring at its start, and a green
    // outline from there to the brush, which turns red as the ramp's end.
    TerrainBrushPreview rampStartMarker = undefined
    TerrainRampPreview rampOutline = undefined
    boolean rampShown = false

    // A stroke with a terrain's brush (step 8): it goes on while the key
    // that started it, or the left mouse button, is held.
    TerrainStroke terrainStroke
    boolean stroking = false
    boolean strokeByMouse = false
    // True when a click took the focus from the terrain's highlight while
    // its tool was chosen, so the next update gives it back.
    boolean refocusBrushHighlight = false
    // Painting is shown a few times a second during a stroke, since each
    // showing loads the splat texture again (step 9).
    number paintShownSeconds = 0
    constant number PAINT_SHOW_INTERVAL = 0.2
    integer strokeKey = 0
    InputMonitor strokeMonitor
    MouseEvent mouseButtons

    // How much each strength key strengthens or weakens the brush, and its
    // limits.
    constant number BRUSH_STRENGTH_STEP = 1.25
    constant number BRUSH_WEAKEST = 0.1
    constant number BRUSH_STRONGEST = 50

    // How fast the arrow keys move a terrain's brush, compared with how fast
    // they move a selection.
    constant number BRUSH_KEY_SPEED = 2
    // How much each size key grows or shrinks the brush, and its limits.
    constant number BRUSH_SIZE_STEP = 1.15
    constant number BRUSH_SMALLEST = 0.5
    constant number BRUSH_LARGEST = 64

    // An array containing the different property dialogs.
    Array<PropertiesDialog> propertiesDialogs

    // The panel the properties dialogs are docked in, or undefined to show
    // them as floating dialogs (step 4).
    PropertiesPanel propertiesPanel = undefined

    // A reference to the find dialog for this controller.
    SceneEditorFindDialog findDialog

    // Used to forcibly change the focus and send information via the screen reader.
    Item2D dummyItem


    on create
        FlowLayout layout
        SetLayout(layout)
        SetPercentageWidth(1.0)
        SetPercentageHeight(1.0)
        
        LabelBoxView view
        view:Initialize(color:CustomColor(0.9, 0.9, 0.925, 1), color:CustomColor(0.9, 0.9, 0.925, 1))
        SetView2D(view)

        SetInputGroup("SceneEditor")
        SetName("Scene Editor")
        SetFocusable(true)
        SetAccessibilityCode(parent:Item:CUSTOM)

        accessibility = manager:GetAccessibility()

        selection:Initialize(me)
        findDialog:Initialize(me)

        // A terrain's brush follows the pointer while a tool is chosen.
        brushMouseListener:SetSceneEditor(me)
        AddMouseMovementListener(brushMouseListener)

        propertiesDialogs:Add(item2dPropertiesDialog)
        propertiesDialogs:Add(item3dPropertiesDialog)
        propertiesDialogs:Add(camera2dPropertiesDialog)
        propertiesDialogs:Add(camera3dPropertiesDialog)
        propertiesDialogs:Add(pointLightPropertiesDialog)
        propertiesDialogs:Add(spotLightPropertiesDialog)
        propertiesDialogs:Add(audio3DPropertiesDialog)

        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Initialize(me)
            counter = counter + 1
        end
    end

    action GetFile returns File
        return file
    end

    action SetFile(File file)
        me:file = file
    end

    action GetProjectLocation returns File
        return projectLocation
    end

    action SetProjectLocation(File file)
        me:projectLocation = file
    end

    /*
    This action returns the relative path to reach the provided file
    from the project location associated with this tab.
    */
    action GetProjectPathToFile(File file) returns text
        text projectPath = projectLocation:GetAbsolutePath()
        text goalPath = file:GetAbsolutePath()

        Array<text> start = undefined
        Array<text> goal = undefined
        // The "Contains" action can correctly test for backslashes, but the "Split" command requires the escape character "\\", or it crashes
        if projectPath:Contains("\")
            start = projectPath:Split("\\")
            goal = goalPath:Split("\\")
        else
            start = projectPath:Split("/")
            goal = goalPath:Split("/")
        end

        /*
        Steps:
        1. Remove all common elements between the two paths
        2. For each element remaining in the source, prepend "../"
        3. For each element remaining in the goal, append it to the end
        */

        text result = ""
        boolean taskDone = false
        repeat until start:IsEmpty() or goal:IsEmpty() or taskDone
            text chunk1 = start:GetFromFront()
            text chunk2 = goal:GetFromFront()

            if chunk1 = chunk2
                start:RemoveFromFront()
                goal:RemoveFromFront()
            else
                taskDone = true
            end
        end

        repeat start:GetSize() times
            result = result + "../"
        end

        repeat until goal:IsEmpty()
            result = result + goal:RemoveFromFront()
            if goal:IsEmpty() = false
                result = result + "/"
            end
        end

        return result
    end

    action Load
        Scene scene
        scene:Load(file)
        SetName(file:GetPath())
        Load(scene)
    end

    /*
    This action returns the description of the item currently focused by the cursor on
    the current layer. If there is no item at the cursor this action returns the position
    of the cursor. If there are multiple items this action will return the names of each item
    at the current cursor position.

    Attribute: Returns The affine as the identy matrix

    */
    action GetDescription returns text
        if GetSelectedLayer() not= undefined
            EditorCursor cursor = GetSelectedLayer():GetCursor()
            text position = ""

            if cursor is EditorCursor2D
                EditorCursor2D cursor2D = cast(EditorCursor2D, cursor)
                position = cast(integer, cursor2D:GetX()) + " " + cast(integer, cursor2D:GetY())
            elseif cursor is EditorCursor3D
                EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
                position = cast(integer, cursor3D:GetX()) + " " + cast(integer, cursor3D:GetY()) + " " + cast(integer, cursor3D:GetZ())
            end

            Array<Item> items = cursor:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return names + position + ", press Enter to select items"
            else
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > items:GetSize() - 3
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return names + items:GetSize() + " items, " + position + ", press Enter to select items"
            end
        end

        return parent:Item:GetDescription()
    end


    /*
    This action is called automatically by the system. This resize adjusts the size of the
    viewports, camera, and grid.
    */
    action Resize
        parent:Control:Resize()

        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer layer = layers:Get(counter)
            layer:SetViewport(cast(integer, GetGlobalX()), cast(integer, GetGlobalY()), cast(integer, GetWidth()), cast(integer, GetHeight()))
            Camera camera = layer:GetCamera()
            camera:SetSize(GetWidth(), GetHeight())
            counter = counter + 1

            if layer is EditorLayer2D
                EditorLayer2D layer2D = cast(EditorLayer2D, layer)
                layer2D:UpdateGridSize()
            end
        end
    end


    /*
        This action takes every dialog added to this Scene Editor and hides all of them.
    */
    action HideDialogs
        // A docked panel is part of the editor's own view, so it keeps
        // showing the selection, for example when switching tabs.
        if propertiesPanel not= undefined
            return now
        end
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Hide()
            counter = counter + 1
        end
    end

    /*
        Shows the properties of the selected item in a panel, instead of in
        floating dialogs. Every properties dialog, including any added later
        with AddPropertiesDialog, docks in the panel. Set it once, before the
        scene is loaded.

        Attribute: Parameter panel The panel
    */
    action SetPropertiesPanel(PropertiesPanel panel)
        boolean firstPanel = false
        if propertiesPanel = undefined
            firstPanel = true
        end
        propertiesPanel = panel
        panel:SetSceneEditor(me)
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):DockIn(panel)
            counter = counter + 1
        end

        // A terrain's sections, after the built-in dialogs (step 5): its
        // facts, its materials (step 9), its brush (step 7), its generate
        // tools (step 10) and its physics.
        if firstPanel
            AddPropertiesDialog(terrainPropertiesDialog)
            AddPropertiesDialog(terrainMaterialsPropertiesDialog)
            AddPropertiesDialog(terrainBrushPropertiesDialog)
            AddPropertiesDialog(terrainGeneratePropertiesDialog)
            AddPropertiesDialog(terrainPhysicsPropertiesDialog)
        end
    end

    /*
        Returns the panel showing the selected item's properties.

        Attribute: Returns The panel, or undefined if the editor uses floating dialogs
    */
    action GetPropertiesPanel returns PropertiesPanel
        return propertiesPanel
    end

    /*
        Adds a properties dialog for another kind of item. It is set up as
        the built-in ones are: it listens to the selection, and docks in the
        panel if there is one. Step 5 adds a terrain's dialog this way.

        Attribute: Parameter dialog The dialog
    */
    action AddPropertiesDialog(PropertiesDialog dialog)
        dialog:Initialize(me)
        propertiesDialogs:Add(dialog)
        if propertiesPanel not= undefined
            dialog:DockIn(propertiesPanel)
        end
    end

    action GetEditorTag returns text
        return constants:EDITOR_TAG
    end

    action GetSceneConstants returns SceneConstants
        return constants
    end

    action SetProperties3DDialog(Item3DPropertiesDialog dialog)
        item3dPropertiesDialog = dialog
    end

    action GetProperties3DDialog returns Item3DPropertiesDialog
        return item3dPropertiesDialog
    end

    action SetProperties2DDialog(Item2DPropertiesDialog dialog)
        item2dPropertiesDialog = dialog
    end

    action SetCameraProperties2DDialog(Camera2DPropertiesDialog dialog)
        camera2dPropertiesDialog = dialog
    end

    action GetCameraProperties2DDialog returns Camera2DPropertiesDialog
        return camera2dPropertiesDialog
    end

    action SetCameraProperties3DDialog(Camera3DPropertiesDialog dialog)
        camera3dPropertiesDialog = dialog
    end

    action GetCameraProperties3DDialog returns Camera3DPropertiesDialog
        return camera3dPropertiesDialog
    end

    action GetProperties2DDialog returns Item2DPropertiesDialog
        return item2dPropertiesDialog
    end

    action GetPointLightPropertiesDialog returns PointLightPropertiesDialog
        return pointLightPropertiesDialog
    end

    action SetPointLightPropertiesDialog(PointLightPropertiesDialog pointLightPropertiesDialog)
        me:pointLightPropertiesDialog = pointLightPropertiesDialog
    end

    action FocusItemProperties
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:FocusField()
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateActivePropertiesDialog(EditorItem item)
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:SetFields(item)
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateEditorCameraTarget
        Item item = GetSelectedItem()
        EditorLayer layer = GetSelectedLayer()
        if item is Item2D or layer is EditorLayer2D
            // We currently only support this feature for 3D.
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)

        // A terrain is too big to center on: going to its middle would fly
        // the camera away from where the user was looking, so selecting one
        // keeps the camera where it is.
        if item is TerrainSelectionHighlight
            return now
        end

        if item = undefined and IsFocused()
            // The cursor becomes the target without the camera jumping to
            // it, such as after a click in the view; moving the cursor with
            // the keys then moves the camera with it. The cursor is held as
            // an Item, since it can only be cast to an Item3D from there.
            Item cursorItem = layer3D:GetCursor()
            layer3D:GetEditorCamera():SetTargetWithoutMoving(cast(Item3D, cursorItem))
            return now
        end
        
        layer3D:GetEditorCamera():SetTarget(cast(Item3D, item))
    end

    action UpdateEditorCameraPosition
        if GetSelectedLayer() is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            layer:GetEditorCamera():UpdateCameraPosition()
        else
            // Do nothing -- we currently don't support this for 2D
        end
    end

    action GetFindDialog returns SceneEditorFindDialog
        return findDialog
    end

    action GetEditManager returns SceneEditorEditManager
        return editManager
    end

    action IsFocused returns boolean
        // Although we can get the focus directly from the manager, we request
        // it from the Game instead. This allows the Game to do any necessary
        // additional book-keeping.
        return parent:Item:IsFocused() or (dummyItem not= undefined and dummyItem:IsFocused())
    end

action Update(number seconds)
        if layers:IsEmpty() or GetSelectedLayer() = undefined
            return now
        end

        UpdateTerrains()
        if refocusBrushHighlight
            refocusBrushHighlight = false
            if IsTerrainBrushActive() and GetSelectedItem() is TerrainSelectionHighlight and IsFocused()
                GetSelectedItem():Focus()
            end
        end
        UpdateTerrainStroke(seconds)
        UpdateBrushPreview()

        Camera camera = GetSelectedLayer():GetCamera()
        boolean moved = false
        boolean isCursor = false
        Item movedItem = undefined

        if GetSelectedLayer() is EditorLayer3D

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())

            if (yawDirection not= 0 or pitchDirection not= 0 or rollDirection not= 0)
                number yaw = layer:GetCameraYaw() + (yawDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                number pitch = layer:GetCameraPitch() + (pitchDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                if pitch > 90.0
                    pitch = 90.0
                elseif pitch < -90.0
                    pitch = -90.0
                end
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                
//                layer:SetCameraYawPitchRoll(yaw, pitch, roll)
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
//                camera:Move(workVector3:Scale(strafeDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds))
            end
    
            if verticalDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(verticalDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem3D
                moved = false
                workVector3:Set(0, 0, 0)

                EditorItem3D focus = undefined

                if IsFocused()
                    isCursor = true
                    focus = cast(EditorItem3D, cast(Object, layer:GetCursor()))
                else
                    focus = cast(EditorItem3D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                if gridSnapEnabled = false
                    if selectionXDirection not= 0
                        workVector3:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector3:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if selectionZDirection not= 0
                        workVector3:SetZ(selectionZDirection * -SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if moved
                        focus:Move(workVector3)
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0 or selectionZDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax

                            if focus is CameraItem3D
                                CameraItem3D cameraItem = cast(CameraItem3D, focus)
                                if selectionXDirection not= 0
                                    cameraItem:SetYaw(cameraItem:GetYaw() + selectionXDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionYDirection not= 0
                                    cameraItem:SetPitch(cameraItem:GetPitch() + selectionYDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionZDirection not= 0
                                    cameraItem:SetDistance(cameraItem:GetDistance() - selectionZDirection * CAMERA_DIRECTIONAL_SPEED_3D)
                                end
                            else
                                moved = true
                                number x = focus:GetGlobalX()
                                number y = focus:GetGlobalY()
                                number z = focus:GetGlobalZ()
        
                                if selectionXDirection < 0
                                    x = layer:GetPreviousGridCoordinate(x)
                                elseif selectionXDirection > 0
                                    x = layer:GetNextGridCoordinate(x)
                                end
        
                                if selectionYDirection < 0
                                    y = layer:GetPreviousGridCoordinate(y)
                                elseif selectionYDirection > 0
                                    y = layer:GetNextGridCoordinate(y)
                                end
        
                                if selectionZDirection < 0
                                    z = layer:GetPreviousGridCoordinate(z)
                                elseif selectionZDirection > 0
                                    z = layer:GetNextGridCoordinate(z)
                                end
        
                                focus:Move(x - focus:GetGlobalX(), y - focus:GetGlobalY(), z - focus:GetGlobalZ())
                                Grid3D grid = layer:GetGrid()
                                grid:SetPosition(grid:GetNearestGridCoordinate(focus:GetGlobalX()),
                                    0,
                                    grid:GetNearestGridCoordinate(focus:GetGlobalZ()))
                            end
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = focus
                end

                if IsSelectionRotating()
                    workVector3:Set(focus:GetYaw(), focus:GetPitch(), focus:GetRoll())
                    workVector3:Add(seconds * selectionYawDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionPitchDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_3D)
                    focus:SetRotation(workVector3)
                end
            end

        elseif GetSelectedLayer() is EditorLayer2D
            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if (rollDirection not= 0)
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_2D * seconds)
                layer:SetCameraRoll(roll)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
                camera:Move(workVector3:Scale(-strafeDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds))
                moved = true
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds)
                camera:Move(workVector3)
                moved = true
            end

            if moved
                layer:UpdateGridPosition()
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem2D
                moved = false
                workVector2:Set(0, 0)

                Item2D target = undefined
                
                if IsFocused()
                    isCursor = true
                    target = cast(Item2D, cast(Object, layer:GetCursor()))
                else
                    target = cast(Item2D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                if gridSnapEnabled = false
                    if selectionXDirection not= 0
                        workVector2:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector2:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if moved
                        target:Move(workVector2)
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax
    
                            number x = target:GetGlobalX()
                            number y = target:GetGlobalY()
    
                            if selectionXDirection < 0
                                x = layer:GetPreviousGridCoordinate(x)
                            elseif selectionXDirection > 0
                                x = layer:GetNextGridCoordinate(x)
                            end
    
                            if selectionYDirection < 0
                                y = layer:GetPreviousGridCoordinate(y)
                            elseif selectionYDirection > 0
                                y = layer:GetNextGridCoordinate(y)
                            end
    
                            target:Move(x - target:GetGlobalX(), y - target:GetGlobalY())
                            moved = true
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = target
                end

                if GetSelectionRollDirection() not= 0 and isCursor = false
                    number angle = target:GetRotation()
                    angle = angle + (seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_2D)
                    target:SetRotation(angle)
                end
            end
        end

        if moved
            if movedItem not= undefined and movedItem is EditorItem
                UpdateActivePropertiesDialog(cast(EditorItem, movedItem))
                UpdateEditorCameraPosition()
            end

            if isCursor
                if accessibility not= undefined
                    Item2D newDummy
                    text describe = GetDescription()
                    newDummy:SetProperty(constants:EDITOR_TAG, undefined)
                    newDummy:SetFocusable(true)
                    newDummy:SetAccessibilityCode(dummyItem:parent:Item:ITEM)
                    newDummy:SetName(describe)
                    newDummy:SetInputGroup("PassthroughInput")
    
                    Add(newDummy)
                    if dummyItem not= undefined
                        Remove(dummyItem)
                    end
                    dummyItem = newDummy
                    newDummy:Focus()
                end
            end
        end
    end

    action SetFilteredItems(Array<Item> items, boolean moveFocus)
        filteredItems = items

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            elseif highlight is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        // Display selection highlighting around the items.
        
        EditorLayer currentLayer = GetSelectedLayer()

        if currentLayer is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item3D item = cast(Item3D, filteredItems:Get(counter))
                SelectionHighlight3D highlight = undefined
                if item is EditorTerrain
                    // A terrain isn't a model, so it has its own highlight.
                    TerrainSelectionHighlight terrainHighlight
                    terrainHighlight:LoadTerrain(cast(EditorTerrain, item), me)
                    highlight = terrainHighlight
                else
                    if item is EditorPointLight
                        PointLightSelectionHighlight light
                        highlight = light
                    elseif item is EditorSpotLight
                        SpotLightSelectionHighlight spot
                        highlight = spot
                    elseif item is EditorAudio3D
                        Audio3DSelectionHighlight light
                        highlight = light
                    else
                        ModelSelectionHighlight model
                        highlight = model
                    end
                    highlight:Load(cast(EditorModel, item), me)
                end
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        else
            EditorLayer2D layer = cast(EditorLayer2D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item2D item = cast(Item2D, filteredItems:Get(counter))
                SelectionHighlight2D highlight
                highlight:Load(item, me)
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        end

        SetFilterHighlightData()

        if moveFocus
            if filterHighlights:IsEmpty()
                Focus()
            else
                filterHighlights:Get(0):Focus()
            end
        else
            if filterHighlights:IsEmpty()
                SetSelectedItem(undefined)
            else
                SetSelectedItem(filterHighlights:Get(0))
            end
        end
    end

    private action EmptyFilteredItems(boolean moveFocus)
        filteredItems = undefined

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            else
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        SetFilterHighlightData()

        if moveFocus
            Focus()
        else
            SetSelectedItem(undefined)
        end
    end

    private action SetFilterHighlightData
        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            Item item = highlight:GetItem()

            if counter = 0
                highlight:SetPreviousFocus(filterHighlights:GetFromEnd())
            else
                highlight:SetPreviousFocus(filterHighlights:Get(counter - 1))
            end

            if counter = filterHighlights:GetSize() - 1
                highlight:SetNextFocus(filterHighlights:GetFromFront())
            else
                highlight:SetNextFocus(filterHighlights:Get(counter + 1))
            end 

            number x = math:Round(item:GetGlobalX(), 2)
            number y = math:Round(item:GetGlobalY(), 2)
            number z = math:Round(item:GetGlobalZ(), 2)

            highlight:SetName(item:GetName())
            highlight:SetDescription((counter + 1) + " of " + filterHighlights:GetSize() + ": " + x + ", " + y + ", " + z)
            counter = counter + 1
        end

        if filterHighlights:IsEmpty() = false
            SetPreviousFocus(filterHighlights:Get(filterHighlights:GetSize() - 1))
            SetNextFocus(filterHighlights:Get(0))
        else
            SetPreviousFocus(undefined)
            SetNextFocus(undefined)
        end
    end

    // Removes the item that is selected by the given highlight, along with the highlight itself.
    action Delete(SelectionHighlight highlight)
        Item nextFocus = undefined

        if highlight:IsFocused()
            // If we're deleting the focused item, move the focus.
            if highlight:GetPreviousFocus() not= undefined and (highlight:GetPreviousFocus():Equals(highlight) = false)
                nextFocus = highlight:GetPreviousFocus()
            else
                SetCursorToItem(highlight)
                nextFocus = me
            end
        end

        EditorLayer resultLayer = undefined

        if highlight is SelectionHighlight3D
            SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
            EditorLayer3D layer = cast(EditorLayer3D, highlight3D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight3D)
            layer:Remove(cast(Item3D, highlight3D:GetItem()))
        else
            SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
            EditorLayer2D layer = cast(EditorLayer2D, highlight2D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight2D)
            layer:Remove(cast(Item2D, highlight2D:GetItem()))
        end

        integer index = filterHighlights:GetFirstLocation(highlight)
        if index >= 0
            filterHighlights:RemoveAt(index)

            // Refresh filter highlight focus order and descriptions.
            SetFilterHighlightData()
        end

        if nextFocus not= undefined
            nextFocus:Focus()
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, highlight:GetItem())
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, highlight:GetItem(), undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    /*
    This action will delete an item that has been added to the scene.
    */
    action Delete(Item item)
        EditorLayer resultLayer = undefined

        if item is Item2D
            Item2D item2D = cast(Item2D, item)
            EditorLayer2D layer = cast(EditorLayer2D, item2D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item2D)
        elseif item is Item3D
            Item3D item3D = cast(Item3D, item)
            EditorLayer3D layer = cast(EditorLayer3D, item3D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item3D)
        end

        integer index = 0
        repeat while index < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(index)
            if highlight:GetItem() = item
                filterHighlights:RemoveAt(index)
                if resultLayer is EditorLayer2D
                    EditorLayer2D layer = cast(EditorLayer2D, resultLayer)
                    layer:Remove(cast(SelectionHighlight2D, highlight))
                elseif resultLayer is EditorLayer3D
                    EditorLayer3D layer = cast(EditorLayer3D, resultLayer)
                    layer:Remove(cast(SelectionHighlight3D, highlight))
                end

                // Manually set the index so we'll escape the loop early.
                index = filterHighlights:GetSize()

                // Refresh filter highlight focus order and descriptions.
                SetFilterHighlightData()
            end

            index = index + 1
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, item)
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, item, undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    action CreateItemPreview(ItemBlueprint schematic) returns ItemPreview
        return CreateItemPreview(schematic, undefined)
    end

    action CreateItemPreview(ItemBlueprint schematic, File asset) returns ItemPreview
        // A terrain has no preview to place: it is added flat, at the
        // origin, at once.
        if schematic is TerrainBlueprint
            AddTerrain(cast(TerrainBlueprint, schematic))
            return undefined
        end

        if schematic is DrawableBlueprint
            DrawableBlueprint drawableBlueprint = cast(DrawableBlueprint, schematic)
            if not (GetSelectedLayer() is EditorLayer2D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer2D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if drawableBlueprint:GetPreferredGridWidth() not= 0 and drawableBlueprint:GetPreferredGridHeight() not= 0
                // TO-DO: Consider both width and height when setting grid unit size.
                layer:SetGridUnitSize(drawableBlueprint:GetPreferredGridWidth())
                layer:UpdateGridPosition()
            end

            ItemPreview2D preview
            preview:Load(me, drawableBlueprint)
            // TO-DO: Position preview to match cursor

            layer:Add(preview)
            preview:Focus()
            return preview
        elseif schematic is ModelBlueprint or schematic is PointLightBlueprint or schematic is SpotLightBlueprint or schematic is Audio3DBlueprint
            
            if not (GetSelectedLayer() is EditorLayer3D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer3D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())

            // TO-DO: Consider modifying grid size for 3D objects here, same as with 2D objects above.

            ItemPreview3D preview = undefined
            if asset = undefined
                if schematic is ModelBlueprint
                    ModelPreview modelPreview
                    preview = modelPreview
                    ModelBlueprint modelBlueprint = cast(ModelBlueprint, schematic)
                    modelPreview:Load(me, modelBlueprint)
                elseif schematic is PointLightBlueprint
                    PointLightPreview lightPreview
                    preview = lightPreview
                    PointLightBlueprint lightBlueprint = cast(PointLightBlueprint, schematic)
                    lightPreview:Load(me, lightBlueprint)
                elseif schematic is SpotLightBlueprint
                    SpotLightPreview spotPreview
                    preview = spotPreview
                    SpotLightBlueprint spotBlueprint = cast(SpotLightBlueprint, schematic)
                    spotPreview:Load(me, spotBlueprint)
                else
                    Audio3DPreview audioPreview
                    preview = audioPreview
                    Audio3DBlueprint audioBlueprint = cast(Audio3DBlueprint, schematic)
                    audioPreview:Load(me, audioBlueprint)
                end
            else
                if schematic is Custom3DPrimitiveBlueprint
                    Custom3DPrimitivePreview primitivePreview
                    preview = primitivePreview
                    Custom3DPrimitiveBlueprint primitiveBlueprint = cast(Custom3DPrimitiveBlueprint, schematic)
                    primitivePreview:Load(me, primitiveBlueprint, asset)
                elseif schematic is CustomModelBlueprint
                    CustomModelBlueprint newBlueprint = cast(CustomModelBlueprint, schematic)
                    newBlueprint:SetFile(asset)
                    ModelPreview modelPreview
                    preview = modelPreview
                    modelPreview:Load(me, newBlueprint)
                end
            end

            layer:Add(preview)
            preview:Focus()
            return preview
        end
        return undefined
    end

    action CancelItemPreview(ItemPreview preview)
        if preview is ItemPreview3D
            ItemPreview3D preview3D = cast(ItemPreview3D, preview)
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            layer:Remove(preview3D)
        else
            ItemPreview2D preview2D = cast(ItemPreview2D, preview)
            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())
            layer:Remove(preview2D)
        end
    end

    /*
    This action adds a new, flat terrain to the scene's 3D layer. Its files
    are saved at once into the project, in a new folder under the project's
    Scenes folder, Scenes/Terrains/Terrain1 (then Terrain2, and so on), and
    the scene refers to its terrain.json. It
    is then selected and announced. Adding it can be undone. A terrain needs
    Vulkan, and a scene that is in a project.

    Attribute: Parameter schematic The terrain's blueprint, from the palette.
    Attribute: Returns The terrain, or undefined if it couldn't be added.
    */
    action AddTerrain(TerrainBlueprint schematic) returns EditorTerrain
        if not (manager:GetGameGraphics() is VulkanGraphics)
            NotifyAccessibility(me, "A terrain needs Vulkan, so it can't be added here.")
            return undefined
        end
        if projectLocation = undefined
            NotifyAccessibility(me, "A terrain is saved in the scene's project, but this scene isn't in a project.")
            return undefined
        end
        EditorLayer3D layer = FindLayer3D()
        if layer = undefined
            NotifyAccessibility(me, "A terrain needs a 3D layer, and this scene has none.")
            return undefined
        end

        // The first free folder: Scenes/Terrains/Terrain1, then Terrain2, ...
        // A scene's own files go under the project's Scenes folder.
        text terrainsPath = properties:SCENES_FOLDER + "/" + properties:TERRAINS_FOLDER + "/Terrain"
        text folderPath = ""
        integer count = 1
        repeat while folderPath = ""
            File candidateFolder
            candidateFolder:SetWorkingDirectory(projectLocation:GetAbsolutePath())
            candidateFolder:SetPath(terrainsPath + count)
            if not candidateFolder:Exists()
                folderPath = terrainsPath + count
            end
            count = count + 1
        end
        File terrainFile
        terrainFile:SetWorkingDirectory(projectLocation:GetAbsolutePath())
        terrainFile:SetPath(folderPath + "/terrain.json")

        EditorTerrain terrain
        terrain:SetSceneEditor(me)
        text name = schematic:GetName()
        terrain:SetName(name + GetNextNamePostfix(name))
        IncrementNameCount(name)
        terrain:SetDescription(schematic:GetDescription())
        terrain:CreateFlat(terrainFile, schematic:GetRegionsAcross(), schematic:GetRegionSize(), schematic:GetVertexSpacing())

        Add(layer, terrain)
        Array<Item> selected
        selected:Add(terrain)
        SetFilteredItems(selected, true)

        number width = schematic:GetRegionsAcross() * schematic:GetRegionSize() * schematic:GetVertexSpacing()
        NotifyAccessibility(terrain, "Placed " + terrain:GetName() + ", flat, " + width + " by " + width +
            " units, saved in " + folderPath + ".")
        return terrain
    end

    /*
    This action makes a 3D layer the selected layer, if it isn't already,
    and returns it.

    Attribute: Returns The 3D layer, or undefined if the scene has none.
    */
    private action FindLayer3D returns EditorLayer3D
        if GetSelectedLayer() is EditorLayer3D
            return cast(EditorLayer3D, GetSelectedLayer())
        end
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer layer = layers:Get(counter)
            if layer is EditorLayer3D
                SetSelectedLayer(layer)
                return cast(EditorLayer3D, layer)
            end
            counter = counter + 1
        end
        return undefined
    end

    /*
    This action chooses a terrain's tool, by its number (1 raise, 2 lower,
    3 smooth, 4 flatten, 5 ramp, 6 paint, 7 blend paint, 8 add region,
    9 remove region, 10 stamp, 11 erode, 12 auto paint), or 0 to leave the
    tool (step 7). With a tool chosen, a
    ring shows the brush on the ground; the arrow keys and the pointer move
    it, and the size keys size it. A stroke going on is finished first. It is
    announced, and the Brush section of the Properties panel follows.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter tool The tool's number, from 0 to 12
    */
    action SetTerrainTool(EditorTerrain terrain, integer tool)
        if terrain = undefined
            return now
        end
        // A stroke going on is finished first, so it can be undone.
        if stroking
            EndTerrainStroke()
        end
        if brushTerrain not= undefined and brushTerrain not= terrain
            brushTerrain:SetToolNumber(0)
        end
        terrain:SetToolNumber(tool)
        if tool > 0
            brushTerrain = terrain
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " tool. " + terrain:DescribeBrush())
        else
            brushTerrain = undefined
            NotifyAccessibility(terrain, "No tool. The arrow keys move the selection again.")
        end
        UpdateBrushPreview()
        TerrainBrushChanged(terrain)
    end

    /*
    This action returns the terrain whose tool is chosen, or undefined.

    Attribute: Returns The terrain with a tool chosen
    */
    action GetBrushTerrain returns EditorTerrain
        return brushTerrain
    end

    /*
    This action returns true while a terrain's tool is chosen, so the arrow
    keys, the pointer and clicks act on its brush.

    Attribute: Returns True while a terrain's brush is in use
    */
    action IsTerrainBrushActive returns boolean
        return brushTerrain not= undefined and brushTerrain:HasTool()
    end

    /*
    This action moves a terrain's brush by a selection move: right along the
    camera's right, and forward along the way the camera faces, flat on the
    ground (step 7).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter right How far to the camera's right, as the selection would move along x
    Attribute: Parameter forward How far forward, as the selection would move along -z
    */
    action MoveTerrainBrush(EditorTerrain terrain, number right, number forward)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        Camera camera = layer:GetCamera()
        Vector3 direction = camera:GetDirection()
        number forwardX = direction:GetX()
        number forwardZ = direction:GetZ()
        number flat = math:SquareRoot(forwardX * forwardX + forwardZ * forwardZ)
        if flat < 0.0001
            // Looking straight down: forward is the camera's up.
            Vector3 up = camera:GetUp()
            forwardX = up:GetX()
            forwardZ = up:GetZ()
            flat = math:SquareRoot(forwardX * forwardX + forwardZ * forwardZ)
            if flat < 0.0001
                return now
            end
        end
        forwardX = forwardX / flat
        forwardZ = forwardZ / flat
        // In Quorum's left-handed world, the right of forward (x, z) is (z, -x).
        number rightX = forwardZ
        number rightZ = -forwardX
        number speed = BRUSH_KEY_SPEED
        number x = terrain:GetBrushX() + (rightX * right + forwardX * forward) * speed
        number z = terrain:GetBrushZ() + (rightZ * right + forwardZ * forward) * speed
        terrain:SetBrushPosition(x, z)
        // Each arrow key move says the height in a few words; the report
        // location key says everything (step 12).
        NotifyAccessibility(terrain, terrain:DescribeBrushHeight())
    end

    /*
    This action makes a terrain's brush larger or smaller, by one step, and
    says its new size (step 7).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter larger True to grow the brush, false to shrink it
    */
    action ResizeTerrainBrush(EditorTerrain terrain, boolean larger)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        number size = brush:GetSize()
        if larger
            size = size * BRUSH_SIZE_STEP
        else
            size = size / BRUSH_SIZE_STEP
        end
        if size < BRUSH_SMALLEST
            size = BRUSH_SMALLEST
        elseif size > BRUSH_LARGEST
            size = BRUSH_LARGEST
        end
        brush:SetSize(size)
        NotifyAccessibility(terrain, "Brush size " + (cast(integer, size * 10 + 0.5) / 10.0))
        TerrainBrushChanged(terrain)
    end

    /*
    This action moves the brush of the terrain whose tool is chosen to the
    ground under the pointer, given in the same screen coordinates as mouse
    events. Off the ground, the brush is hidden. The pointer listener calls
    it (step 7).

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action MoveTerrainBrushToPointer(number x, number y)
        if not IsTerrainBrushActive()
            return now
        end
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()
        // The same pick ray the selection click uses.
        // GetPickRay mirrors x across the view (the world is left-handed),
        // so the pointer's x is mirrored first, as the in-game terrain
        // editor does; otherwise the brush moves opposite the pointer.
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray ray = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        Vector3 hit = brushTerrain:GetWorldTerrain():GetData():RayCast(ray:GetOrigin(), ray:GetDirection(), camera:GetFar())
        if hit = undefined and brushTerrain:GetToolNumber() = 8
            // Add region works past the edge of the ground, so the pointer
            // finds where it meets the level of the ground's base, height 0
            // (step 11).
            Vector3 direction = ray:GetDirection()
            Vector3 origin = ray:GetOrigin()
            if direction:GetY() < -0.0001
                number distance = -origin:GetY() / direction:GetY()
                brushTerrain:SetBrushPosition(origin:GetX() + direction:GetX() * distance, origin:GetZ() + direction:GetZ() * distance)
                return now
            end
        end
        if hit = undefined
            brushTerrain:SetBrushOffGround()
        else
            brushTerrain:SetBrushPosition(hit:GetX(), hit:GetZ())
        end
    end

    /*
    This action returns true if a tool's strokes are ready in the scene
    editor for a terrain: raise, lower, smooth, flatten and ramp (step 8),
    paint, once the terrain has two or more materials (step 9), and add and
    remove region (step 11), and stamp, erode and auto paint. Paint and
    blend paint need two or more materials.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter tool The tool's number, from 1 to 12
    Attribute: Returns True if the tool can make strokes
    */
    action CanStrokeWithTool(EditorTerrain terrain, integer tool) returns boolean
        if tool = 1 or tool = 2 or tool = 3 or tool = 4 or tool = 5 or tool = 8 or tool = 9
            return true
        end
        // Stamp, erode and auto paint (EditorTerrain's STAMP_TOOL to
        // AUTO_PAINT_TOOL).
        if tool >= 10 and tool <= 12
            return true
        end
        // Paint and blend paint need two materials to paint between.
        return (tool = 6 or tool = 7) and terrain not= undefined and terrain:GetLayerCount() >= 2
    end

    /*
    This action starts a stroke with the brush of the terrain whose tool is
    chosen (step 8). The stroke goes on, once a frame, while the key that
    started it is held, or the left mouse button for a stroke started with
    a click, and ends when it is let go. Nothing starts if the brush is off
    the ground, if a stroke is already going, or if the tool's strokes
    aren't ready yet.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter byMouse True if the left mouse button started the stroke
    Attribute: Parameter key The key that started it, for a stroke started with a key
    */
    action BeginTerrainStroke(EditorTerrain terrain, boolean byMouse, integer key)
        if stroking or terrain = undefined or terrain not= brushTerrain or not terrain:HasTool()
            return now
        end
        integer tool = terrain:GetToolNumber()
        if (tool = 6 or tool = 7) and terrain:GetLayerCount() < 2
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " needs two or more materials. Add them in the Materials section.")
            return now
        end
        if not CanStrokeWithTool(terrain, tool)
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " strokes aren't ready yet. The other tools are.")
            return now
        end
        if tool = 5
            // The ramp isn't a stroke: the first click (or Space) marks its
            // start, and the second makes the whole ramp to where the brush
            // is (step 8).
            SetNextTerrainRampPoint(terrain)
            return now
        end
        if tool = 6 and terrain:GetBrush():GetLayer() >= terrain:GetLayerCount()
            NotifyAccessibility(terrain, "Layer " + (terrain:GetBrush():GetLayer() + 1) + " has no material. Choose another layer to paint.")
            return now
        end
        if not terrain:IsBrushOnGround()
            if tool = 8
                NotifyAccessibility(terrain, "A region can't go there: the grid of regions runs from -16 to 15 along each side.")
            else
                NotifyAccessibility(terrain, "The brush is off the ground")
            end
            return now
        end
        if tool = terrain:STAMP_TOOL or tool = terrain:ERODE_TOOL or tool = terrain:AUTO_PAINT_TOOL
            // These aren't strokes: each click (or Space) does it once at
            // the brush, as one undoable change.
            UseOperationTool(terrain, tool)
            return now
        end
        terrainStroke:Begin(terrain:GetWorldTerrain():GetData(), terrain:GetBrush())
        paintShownSeconds = 0
        stroking = true
        strokeByMouse = byMouse
        strokeKey = key
    end

    /*
    This action uses the Stamp, Erode or Auto paint tool once, at the brush:
    a stamp with the terrain's stamp settings from the Generate section, or
    erosion or auto paint as wide as the brush.
    */
    private action UseOperationTool(EditorTerrain terrain, integer tool)
        if tool = terrain:STAMP_TOOL
            integer mode = terrain:GetStampMode()
            if mode < 0
                mode = generator:GetStampMode(terrain:GetStampShape())
            end
            StampTerrain(terrain, terrain:GetStampShape(), mode, terrain:GetStampHeight(), terrain:GetStampTurn())
        elseif tool = terrain:ERODE_TOOL
            ErodeTerrainAtBrush(terrain)
        else
            AutoPaintTerrainAtBrush(terrain)
        end
    end

    /*
    This action returns true while a stroke with a terrain's brush is going.

    Attribute: Returns True during a stroke
    */
    action IsTerrainStroking returns boolean
        return stroking
    end

    /*
    This action keeps a stroke going while its key or button is held, and
    ends it when it is let go. The ground is redrawn each frame.
    */
    private action UpdateTerrainStroke(number seconds)
        if not stroking
            return now
        end
        boolean held = false
        if strokeByMouse
            held = strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
        else
            held = strokeMonitor:IsKeyPressed(strokeKey)
        end
        if not held
            EndTerrainStroke()
            return now
        end
        if brushTerrain = undefined
            terrainStroke:Cancel()
            stroking = false
            return now
        end
        if brushTerrain:IsBrushOnGround()
            terrainStroke:Apply(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), seconds)
            integer toolNumber = brushTerrain:GetToolNumber()
            if toolNumber = 8 or toolNumber = 9
                // A region tool adds or removes only the region under the
                // ring where it was clicked: the stroke ends at once, so
                // the pointer drifting while the button is held doesn't
                // add or remove others. Ending it redraws the terrain and
                // says the new size.
                EndTerrainStroke()
                return now
            elseif toolNumber = 6 or toolNumber = 7
                // Painting and blending load the splat texture again to show, so it is
                // shown a few times a second, and fully at the end.
                paintShownSeconds = paintShownSeconds + seconds
                if paintShownSeconds >= PAINT_SHOW_INTERVAL
                    paintShownSeconds = 0
                    RedrawTerrain(brushTerrain)
                end
            else
                RedrawTerrain(brushTerrain)
            end
        end
    end

    /*
    This action finishes a stroke: it goes into the undo list, the terrain
    is marked changed for the next save, and what happened is announced.
    */
    action EndTerrainStroke
        if not stroking
            return now
        end
        stroking = false
        TerrainStrokeEdit strokeEdit = terrainStroke:End()
        if brushTerrain = undefined
            return now
        end
        if strokeEdit = undefined
            NotifyAccessibility(brushTerrain, "Nothing changed")
            return now
        end
        SceneEditorTerrainEdit edit
        edit:Create(me, brushTerrain, strokeEdit)
        editManager:Add(edit)
        brushTerrain:SetChanged(true)
        RedrawTerrain(brushTerrain)
        TerrainFactsChanged(brushTerrain)
        NotifyAccessibility(brushTerrain, DescribeStroke(brushTerrain, strokeEdit))
    end

    /*
    This action says what a finished stroke did (step 12): "Raised by up to
    2.4" for raise and lower, the layer for paint, and the size for the
    region tools, then the ground under the brush.
    */
    private action DescribeStroke(EditorTerrain terrain, TerrainStrokeEdit strokeEdit) returns text
        integer tool = terrain:GetToolNumber()
        if tool = 1 or tool = 2
            number change = strokeEdit:GetLargestHeightChange()
            text verb = "Raised"
            if change < 0
                verb = "Lowered"
                change = -change
            end
            return verb + " by up to " + RoundTenth(change) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 4 or tool = 5
            number shaped = strokeEdit:GetLargestHeightChange()
            if shaped < 0
                shaped = -shaped
            end
            text shapedVerb = "Flattened"
            if tool = 5
                shapedVerb = "Shaped the ramp"
            end
            return shapedVerb + ", changing heights by up to " + RoundTenth(shaped) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 3
            number smoothed = strokeEdit:GetLargestHeightChange()
            if smoothed < 0
                smoothed = -smoothed
            end
            return "Smoothed, changing heights by up to " + RoundTenth(smoothed) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 6
            return "Painted " + terrain:GetLayerLabel(terrain:GetBrush():GetLayer()) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 7
            return "Blended the paint. " + terrain:DescribeBrush()
        elseif tool = 8 or tool = 9
            return terrain:GetToolName(tool) + " done. The terrain is now " + terrain:DescribeSize()
        end
        return terrain:GetToolName(tool) + " done. " + terrain:DescribeBrush()
    end

    /*
    This action stops a stroke and puts the ground back as it was before
    it. Escape calls it.

    Attribute: Returns True if a stroke was going and was canceled
    */
    action CancelTerrainStroke returns boolean
        if not stroking
            return false
        end
        terrainStroke:Cancel()
        stroking = false
        if brushTerrain not= undefined
            RedrawTerrain(brushTerrain)
            TerrainFactsChanged(brushTerrain)
            NotifyAccessibility(brushTerrain, "Stroke canceled")
        end
        return true
    end

    /*
    This action redraws a terrain after its ground changed, and places the
    brush's ring on the new ground.

    Attribute: Parameter terrain The terrain
    */
    private action RedrawTerrain(EditorTerrain terrain)
        if terrain:RegionsMatchModels()
            terrain:GetWorldTerrain():Rebuild()
        else
            // Regions were added or removed (step 11), so the models are
            // made again, and the selection's border fits the new size.
            terrain:RebuildRegionModels()
            RefreshTerrainHighlight(terrain)
        end
        if terrain = brushTerrain
            // The ring follows the ground, so it is placed again.
            previewSize = -1
        end
    end

    /*
    This action is called after a terrain stroke is undone or redone: the
    terrain is redrawn, marked changed for the next save, and what happened
    is announced.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter message What happened, such as "Undid raise"
    */
    action TerrainEdited(EditorTerrain terrain, text message)
        if terrain = undefined
            return now
        end
        if stroking
            CancelTerrainStroke()
        end
        RedrawTerrain(terrain)
        terrain:SetChanged(true)
        TerrainFactsChanged(terrain)
        NotifyAccessibility(terrain, message)
    end

    /*
    This action shows a terrain's new ground heights in the Terrain section
    of the Properties panel, after a stroke or an undo.

    Attribute: Parameter terrain The terrain
    */
    private action TerrainFactsChanged(EditorTerrain terrain)
        if terrainPropertiesDialog:IsShowing()
            terrainPropertiesDialog:SetTerrain(terrain)
        end
    end

    /*
    This action fits the selection's border to a terrain again, after its
    size changed, if the terrain is selected.

    Attribute: Parameter terrain The terrain
    */
    action RefreshTerrainHighlight(EditorTerrain terrain)
        EditorItem selected = GetSelectedItem()
        if selected is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selected)
            if highlight:GetEditorTerrain() = terrain
                highlight:LoadTerrain(terrain, me)
            end
        end
    end

    /*
    This action returns the TerrainGenerator the scene editor uses for
    presets, stamps, erosion and auto paint (step 10).

    Attribute: Returns The generator
    */
    action GetTerrainGenerator returns TerrainGenerator
        return generator
    end

    /*
    This action remakes a terrain's whole ground with a preset (step 10):
    rolling hills, mountains, plateaus, canyons or flat. The same seed gives
    the same ground. With auto paint, the layers are painted by height and
    slope afterward, if the terrain has two or more materials. It can be
    undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter preset The preset, such as TerrainGenerator's PRESET_MOUNTAINS
    Attribute: Parameter seed The seed
    Attribute: Parameter height The tallest the ground can be, in world units
    Attribute: Parameter autoPaint True to auto paint afterward
    */
    action GenerateTerrain(EditorTerrain terrain, integer preset, number seed, number height, boolean autoPaint)
        if not CanOperateOn(terrain)
            return now
        end
        boolean painting = autoPaint and terrain:GetLayerCount() >= 2
        text presetName = generator:GetPresetName(preset)
        NotifyAccessibility(terrain, "Generating " + presetName + "...")
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation = BeginTerrainOperation(terrain, "generate " + presetName, true, painting, minimumX, minimumZ, maximumX, maximumZ)
        generator:SetSeed(seed)
        generator:GeneratePreset(data, preset, minimumX, minimumZ, maximumX - minimumX + 1, maximumZ - minimumZ + 1, height)
        if painting
            PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        end
        text message = "Generated " + presetName + ", seed " + cast(integer, seed) + ", heights " +
            RoundTenth(data:GetLowestHeight()) + " to " + RoundTenth(data:GetHighestHeight()) + "."
        if autoPaint and not painting
            message = message + " Auto paint needs two or more materials, so the ground wasn't painted."
        end
        FinishTerrainOperation(terrain, operation, message)
    end

    /*
    This action wears a terrain's whole ground as weather would, with one
    drop of rain for every eight samples (step 10). It can be undone.

    Attribute: Parameter terrain The terrain
    */
    action ErodeTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        NotifyAccessibility(terrain, "Eroding the whole terrain...")
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainStroke operation = BeginTerrainOperation(terrain, "erode", true, false, minimumX, minimumZ, maximumX, maximumZ)
        integer drops = (maximumX - minimumX + 1) * (maximumZ - minimumZ + 1) / 8
        generator:Erode(terrain:GetWorldTerrain():GetData(), minimumX, minimumZ, maximumX, maximumZ, drops)
        FinishTerrainOperation(terrain, operation, "Eroded the whole terrain, " + drops + " drops of rain.")
    end

    /*
    This action paints a terrain's whole ground by rules (step 10): layer 1
    on flat ground, layer 2 on slopes, layer 3 in hollows and layer 4 low
    down. Rules for layers the terrain doesn't have go to layer 1. It needs
    two or more materials, and can be undone.

    Attribute: Parameter terrain The terrain
    */
    action AutoPaintTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not CanAutoPaint(terrain)
            return now
        end
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainStroke operation = BeginTerrainOperation(terrain, "auto paint", false, true, minimumX, minimumZ, maximumX, maximumZ)
        PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        FinishTerrainOperation(terrain, operation, "Auto painted the whole terrain.")
    end

    /*
    This action presses a stamp into the ground at a terrain's brush, as big
    as the brush (step 10). The Stamp tool calls it. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter stamp The shape, such as TerrainGenerator's STAMP_HILL
    Attribute: Parameter mode STAMP_ADD, STAMP_SUBTRACT or STAMP_RAISE
    Attribute: Parameter height The height of the shape's top, in world units
    Attribute: Parameter turn How far to turn the shape, in degrees
    */
    action StampTerrain(EditorTerrain terrain, integer stamp, integer mode, number height, number turn)
        if not CanOperateOn(terrain) or not BrushReady(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number size = terrain:GetBrush():GetSize()
        number reach = size * 1.4143
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        text name = "stamp a " + generator:GetStampName(stamp)
        TerrainStroke operation = BeginTerrainOperation(terrain, name, true, false, data:GetSampleX(x - reach) - 1, data:GetSampleZ(z - reach) - 1,
            data:GetSampleX(x + reach) + 2, data:GetSampleZ(z + reach) + 2)
        integer width = 129
        Number32BitArray shape = generator:MakeStampShape(stamp, width)
        generator:Stamp(data, shape, width, x, z, size, turn, height, mode)
        FinishTerrainOperation(terrain, operation, "Stamped a " + generator:GetStampName(stamp) + ". " + terrain:DescribeBrush())
    end

    /*
    This action erodes the ground under a terrain's brush (step 10). Drops
    of rain start under it and may run on one brush size past it. It can be
    undone.

    Attribute: Parameter terrain The terrain
    */
    action ErodeTerrainAtBrush(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not BrushReady(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number radius = terrain:GetBrush():GetSize()
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        integer minimumX = data:GetSampleX(x - radius)
        integer minimumZ = data:GetSampleZ(z - radius)
        integer maximumX = data:GetSampleX(x + radius) + 1
        integer maximumZ = data:GetSampleZ(z + radius) + 1
        integer runOn = cast(integer, math:Ceiling(radius / data:GetVertexSpacing()))
        TerrainStroke operation = BeginTerrainOperation(terrain, "erode", true, false, minimumX - runOn - 1, minimumZ - runOn - 1,
            maximumX + runOn + 1, maximumZ + runOn + 1)
        integer drops = (maximumX - minimumX + 1) * (maximumZ - minimumZ + 1)
        generator:Erode(data, minimumX, minimumZ, maximumX, maximumZ, minimumX - runOn, minimumZ - runOn, maximumX + runOn, maximumZ + runOn, drops)
        FinishTerrainOperation(terrain, operation, "Eroded under the brush, " + drops + " drops of rain. " + terrain:DescribeBrush())
    end

    /*
    This action auto paints the ground under a terrain's brush (step 10).
    It needs two or more materials, and can be undone.

    Attribute: Parameter terrain The terrain
    */
    action AutoPaintTerrainAtBrush(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not BrushReady(terrain) or not CanAutoPaint(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number radius = terrain:GetBrush():GetSize()
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        integer minimumX = data:GetSampleX(x - radius)
        integer minimumZ = data:GetSampleZ(z - radius)
        integer maximumX = data:GetSampleX(x + radius) + 1
        integer maximumZ = data:GetSampleZ(z + radius) + 1
        TerrainStroke operation = BeginTerrainOperation(terrain, "auto paint", false, true, minimumX, minimumZ, maximumX, maximumZ)
        PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        FinishTerrainOperation(terrain, operation, "Auto painted under the brush.")
    end

    /*
    This action makes a terrain one region bigger on every side, with flat
    new regions, as far as the grid of regions allows (step 11). It can be
    undone.

    Attribute: Parameter terrain The terrain
    */
    action GrowTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer size = data:GetRegionSize()
        integer firstX = data:GetRegionLocation(terrain:GetSampleEdge(true, true)) - 1
        integer firstZ = data:GetRegionLocation(terrain:GetSampleEdge(false, true)) - 1
        integer lastX = data:GetRegionLocation(terrain:GetSampleEdge(true, false)) + 1
        integer lastZ = data:GetRegionLocation(terrain:GetSampleEdge(false, false)) + 1
        TerrainStroke operation
        operation:BeginOperation(data, "grow", true, true)
        operation:CopyAreaIncludingEmpty(firstX * size, firstZ * size, lastX * size + size - 1, lastZ * size + size - 1)
        integer added = 0
        integer locationZ = firstZ
        repeat while locationZ <= lastZ
            integer locationX = firstX
            repeat while locationX <= lastX
                if data:IsInRegionMap(locationX, locationZ) and not data:HasRegion(locationX, locationZ)
                    data:AddRegion(locationX, locationZ)
                    added = added + 1
                end
                locationX = locationX + 1
            end
            locationZ = locationZ + 1
        end
        if added = 0
            operation:Cancel()
            NotifyAccessibility(terrain, "The terrain can't grow: it reaches the edge of the grid of regions on every side.")
            return now
        end
        FinishTerrainOperation(terrain, operation, "Added " + added + " regions. The terrain is now " + terrain:DescribeSize())
    end

    /*
    This action returns true if a terrain can be changed by an operation,
    and says why not otherwise. A stroke going on is finished first.
    */
    private action CanOperateOn(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so it can't be changed.")
            return false
        end
        if terrain:GetWorldTerrain():GetData():GetRegionCount() = 0
            NotifyAccessibility(terrain, "This terrain has no regions.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action returns true if a terrain's brush is chosen and on the
    ground, and says what to do otherwise.
    */
    private action BrushReady(EditorTerrain terrain) returns boolean
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool in the Brush section first, to place the brush.")
            return false
        end
        if not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "The brush is off the ground")
            return false
        end
        return true
    end

    /*
    This action returns true if a terrain has the two or more materials auto
    paint needs, and says so otherwise.
    */
    private action CanAutoPaint(EditorTerrain terrain) returns boolean
        if terrain:GetLayerCount() < 2
            NotifyAccessibility(terrain, "Auto paint needs two or more materials. Add them in the Materials section.")
            return false
        end
        return true
    end

    /*
    This action auto paints a rectangle of samples, then gives rules for
    layers the terrain doesn't have to its first layer.
    */
    private action PaintArea(EditorTerrain terrain, integer minimumX, integer minimumZ, integer maximumX, integer maximumZ)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        generator:AutoPaint(data, minimumX, minimumZ, maximumX, maximumZ)
        data:FoldSplatLayers(terrain:GetLayerCount(), minimumX, minimumZ, maximumX, maximumZ)
    end

    /*
    This action starts an operation on a terrain, copying a rectangle of
    samples so it can be undone.
    */
    private action BeginTerrainOperation(EditorTerrain terrain, text name, boolean changesShape, boolean changesSplat,
            integer minimumX, integer minimumZ, integer maximumX, integer maximumZ) returns TerrainStroke
        TerrainStroke operation
        operation:BeginOperation(terrain:GetWorldTerrain():GetData(), name, changesShape, changesSplat)
        operation:CopyArea(minimumX, minimumZ, maximumX, maximumZ)
        return operation
    end

    /*
    This action finishes an operation: it goes into the undo list, the
    terrain is redrawn and marked changed, the Properties panel follows, and
    the message is announced.
    */
    private action FinishTerrainOperation(EditorTerrain terrain, TerrainStroke operation, text message)
        TerrainStrokeEdit strokeEdit = operation:End()
        if strokeEdit not= undefined
            SceneEditorTerrainEdit edit
            edit:Create(me, terrain, strokeEdit)
            editManager:Add(edit)
        end
        terrain:SetChanged(true)
        RedrawTerrain(terrain)
        TerrainFactsChanged(terrain)
        NotifyAccessibility(terrain, message)
    end

    /*
    This action rounds a number to one place after the point, for speaking.
    */
    private action RoundTenth(number value) returns number
        return math:Round(value, 1)
    end

    /*
    This action returns every terrain in the scene's 3D layers.

    Attribute: Returns The terrains
    */
    action GetEditorTerrains returns Array<EditorTerrain>
        Array<EditorTerrain> result
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        result:Add(cast(EditorTerrain, item))
                    end
                end
            end
            counter = counter + 1
        end
        return result
    end

    /*
    This action returns how many terrains in the scene use a terrain
    material (step 9).

    Attribute: Parameter material The terrain material
    Attribute: Returns How many terrains use it
    */
    action CountTerrainsUsing(TerrainMaterial material) returns integer
        if material = undefined
            return 0
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer count = 0
        integer i = 0
        repeat while i < terrains:GetSize()
            if terrains:Get(i):GetMaterial() = material
                count = count + 1
            end
            i = i + 1
        end
        return count
    end

    /*
    This action adds a material to a terrain as its next ground layer
    (step 9). The file can be a material file, a texture set's color map,
    such as Ground037_1K-PNG_Color.png, or another image, used as a plain
    texture; for an image, a material file is written beside it. The first
    layer makes the terrain's terrain material file, in the project's
    Scenes/Materials folder, and covers the whole ground. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter chosen The file chosen
    */
    action AddTerrainLayer(EditorTerrain terrain, File chosen)
        if not CanChangeMaterials(terrain)
            return now
        end
        if terrain:GetLayerCount() >= 4
            NotifyAccessibility(terrain, "This terrain has four materials, which is the most it can have.")
            return now
        end
        Material material = MakeTerrainLayerMaterial(terrain, chosen)
        if material = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        text beforeFile = terrain:GetMaterialFile()
        text layerName = material:GetName()
        SceneEditorTerrainMaterialEdit edit
        if current = undefined
            TerrainMaterial created = CreateTerrainMaterial(terrain)
            created:AddLayer(layerName, material)
            created:Save(created:GetFile())
            terrain:SetMaterialFile(created:GetFile():GetPath())
            terrain:SetMaterial(created)
            edit:Create(me, terrain, "add " + layerName, undefined, beforeFile, created, terrain:GetMaterialFile())
        else
            TerrainMaterial before = current:Copy()
            current:AddLayer(layerName, material)
            edit:Create(me, terrain, "add " + layerName, current, beforeFile, current, beforeFile)
            edit:SetChangedLayers(current, before, current:Copy())
            terrain:RefreshMaterial()
        end
        editManager:Add(edit)
        integer count = terrain:GetLayerCount()
        // The new layer is the one painted next.
        terrain:GetBrush():SetLayer(count - 1)
        text message = "Added " + layerName + " as layer " + count + ", tiles " + RoundTenth(material:GetTextureScale()) + " units."
        if count = 1
            message = message + " It covers the whole ground. Add another material to paint with."
        else
            message = message + " Paint it with the Paint tool."
        end
        if layerMaterialNote not= ""
            message = message + " " + layerMaterialNote
        end
        TerrainMaterialEdited(terrain, current, message)
    end

    /*
    This action gives one of a terrain's ground layers a different
    material. Its painted places stay the same. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter chosen The file chosen, as for AddTerrainLayer
    */
    action ChooseTerrainLayer(EditorTerrain terrain, integer layer, File chosen)
        if not CanChangeMaterials(terrain) or layer < 0 or layer >= terrain:GetLayerCount()
            return now
        end
        Material material = MakeTerrainLayerMaterial(terrain, chosen)
        if material = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        TerrainMaterial before = current:Copy()
        current:SetLayer(layer, material:GetName(), material)
        SceneEditorTerrainMaterialEdit edit
        edit:Create(me, terrain, "choose " + material:GetName(), current, terrain:GetMaterialFile(), current, terrain:GetMaterialFile())
        edit:SetChangedLayers(current, before, current:Copy())
        editManager:Add(edit)
        terrain:RefreshMaterial()
        text chosenMessage = "Layer " + (layer + 1) + " is now " + material:GetName() + "."
        if layerMaterialNote not= ""
            chosenMessage = chosenMessage + " " + layerMaterialNote
        end
        TerrainMaterialEdited(terrain, current, chosenMessage)
    end

    /*
    This action removes one of a terrain's ground layers. Its painted
    weight goes to the first layer, and the layers after it move down one,
    on every terrain sharing the terrain material. Removing the last layer
    makes the ground plain again: the painting is cleared, its files are
    deleted on the next save, and the scene stops naming a material. It can
    be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action RemoveTerrainLayer(EditorTerrain terrain, integer layer)
        if not CanChangeMaterials(terrain) or layer < 0 or layer >= terrain:GetLayerCount()
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        text layerName = current:GetLayerName(layer)
        text beforeFile = terrain:GetMaterialFile()
        SceneEditorTerrainMaterialEdit edit
        if current:GetLayerCount() = 1
            edit:Create(me, terrain, "remove " + layerName, current, beforeFile, undefined, "")
            edit:AddPaintingEdit(ClearTerrainPainting(terrain))
            terrain:SetMaterialFile("")
            terrain:SetMaterial(undefined)
            editManager:Add(edit)
            terrain:GetBrush():SetLayer(0)
            TerrainMaterialEdited(terrain, undefined, layerName + " removed. The ground is plain.")
            return now
        end

        TerrainMaterial before = current:Copy()
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain sharing = terrains:Get(i)
            if sharing:GetMaterial() = current
                edit:AddPaintingEdit(RemoveTerrainPaintingLayer(sharing, layer))
            end
            i = i + 1
        end
        current:RemoveLayer(layer)
        edit:Create(me, terrain, "remove " + layerName, current, beforeFile, current, beforeFile)
        edit:SetChangedLayers(current, before, current:Copy())
        editManager:Add(edit)
        terrain:RefreshMaterial()
        if terrain:GetBrush():GetLayer() >= current:GetLayerCount()
            terrain:GetBrush():SetLayer(current:GetLayerCount() - 1)
        end
        TerrainMaterialEdited(terrain, current, layerName + " removed. Where it was painted, " + current:GetLayerName(0) + " shows.")
    end

    /*
    This action sets how many world units one tile of a ground layer's
    material covers. It is saved into the material's file with the scene.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter size The tile size, more than 0
    */
    action SetTerrainLayerTileSize(EditorTerrain terrain, integer layer, number size)
        if terrain = undefined or layer < 0 or layer >= terrain:GetLayerCount() or size <= 0
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        current:GetLayerMaterial(layer):SetTextureScale(size)
        terrain:RefreshMaterial()
        TerrainMaterialEdited(terrain, current, "")
    end

    /*
    This action sets how softly a terrain's texture set layers blend where
    they meet, from 0.01 to 1. It is saved into the terrain material file
    with the scene.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter softness The softness
    */
    action SetTerrainBlendSoftness(EditorTerrain terrain, number softness)
        if terrain = undefined or terrain:GetMaterial() = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        current:SetBlendSoftness(softness)
        terrain:RefreshMaterial()
        TerrainMaterialEdited(terrain, current, "")
    end

    /*
    This action returns a terrain layer's material, or undefined, for the
    Material details (step 14).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Returns The layer's Material
    */
    action GetTerrainLayerMaterial(EditorTerrain terrain, integer layer) returns Material
        if terrain = undefined or layer < 0 or layer >= terrain:GetLayerCount()
            return undefined
        end
        return terrain:GetMaterial():GetLayerMaterial(layer)
    end

    /*
    This action returns how many layers in the scene's terrains use a
    material, counting each layer once (step 14).

    Attribute: Parameter material The material
    Attribute: Returns How many layers use it
    */
    action CountLayersUsing(Material material) returns integer
        if material = undefined
            return 0
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        Array<TerrainMaterial> counted
        integer count = 0
        integer i = 0
        repeat while i < terrains:GetSize()
            TerrainMaterial terrainMaterial = terrains:Get(i):GetMaterial()
            if terrainMaterial not= undefined and not counted:Has(terrainMaterial)
                counted:Add(terrainMaterial)
                integer layer = 0
                repeat while layer < terrainMaterial:GetLayerCount()
                    if terrainMaterial:GetLayerMaterial(layer) = material
                        count = count + 1
                    end
                    layer = layer + 1
                end
            end
            i = i + 1
        end
        return count
    end

    /*
    This action gives a terrain layer's material a different image for one
    of its maps (step 14). The image must be the same size as the color map,
    or it is refused. Choosing a color map for a plain texture makes it a
    texture set. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter kind The map, such as Material's NORMAL_MAP
    Attribute: Parameter chosen The image
    */
    action SetTerrainLayerMap(EditorTerrain terrain, integer layer, integer kind, File chosen)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or chosen = undefined or not chosen:Exists()
            return now
        end
        text path = chosen:GetAbsolutePath()
        text lower = chosen:GetFileName():ToLowerCase()
        if not (lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg"))
            NotifyAccessibility(terrain, "A map is an image, a .png or .jpg file.")
            return now
        end
        // Every map in a set must be the size of its color map.
        text problem = ""
        if kind = material:COLOR_MAP
            Material trial = material:Copy()
            trial:SetMapPath(material:COLOR_MAP, path)
            integer other = material:NORMAL_MAP
            repeat while other <= material:HEIGHT_MAP and problem = ""
                if trial:GetMapPath(other) not= ""
                    problem = trial:GetMapSizeProblem(trial:GetMapPath(other))
                end
                other = other + 1
            end
        elseif kind not= material:TEXTURE
            problem = material:GetMapSizeProblem(path)
        end
        if problem not= ""
            NotifyAccessibility(terrain, problem)
            return now
        end

        Material before = material:Copy()
        if kind = material:COLOR_MAP and not material:UsesTextureSet()
            // A plain texture becomes a texture set with this color map.
            material:SetTexturePath("")
        end
        material:SetMapPath(kind, path)
        text message = material:GetMapName(kind) + " is now " + chosen:GetFileName() + "."
        message = message:GetSubtext(0, 1):ToUpperCase() + message:GetSubtext(1)
        if not IsInProject(chosen)
            message = message + " This map is outside the project, so it won't be copied with it."
        end
        RecordMaterialChange(material, before, material:GetMapName(kind), true, message)
    end

    /*
    This action clears one of a terrain layer's maps (step 14). A texture
    set's color map, and a plain texture's image, can't be cleared. It can
    be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter kind The map, such as Material's NORMAL_MAP
    */
    action ClearTerrainLayerMap(EditorTerrain terrain, integer layer, integer kind)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or material:GetMapPath(kind) = ""
            return now
        end
        if kind = material:COLOR_MAP
            NotifyAccessibility(terrain, "A texture set needs its color map. Choose another, or use Make plain.")
            return now
        end
        if kind = material:TEXTURE
            NotifyAccessibility(terrain, "A plain texture needs its image. Choose another, or remove the layer.")
            return now
        end
        Material before = material:Copy()
        material:SetMapPath(kind, "")
        text message = "Cleared the " + material:GetMapName(kind) + "."
        RecordMaterialChange(material, before, "clear " + material:GetMapName(kind), true, message)
    end

    /*
    This action sets whether a terrain layer's normal map uses the DirectX
    convention, rather than OpenGL's (step 14). It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter directX True for DirectX
    */
    action SetTerrainLayerNormalConvention(EditorTerrain terrain, integer layer, boolean directX)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or material:IsNormalMapDirectX() = directX
            return now
        end
        Material before = material:Copy()
        material:SetNormalMapDirectX(directX)
        text convention = "OpenGL"
        if directX
            convention = "DirectX"
        end
        RecordMaterialChange(material, before, "normal map convention", true, "The normal map is now " + convention + ".")
    end

    /*
    This action sets a terrain layer's roughness (0) or metallic (1) value,
    from 0 to 1 (step 14). It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter valueKind 0 for roughness, 1 for metallic
    Attribute: Parameter value The value, from 0 to 1
    */
    action SetTerrainLayerValue(EditorTerrain terrain, integer layer, integer valueKind, number value)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or value < 0 or value > 1
            return now
        end
        Material before = material:Copy()
        text valueName = "roughness"
        if valueKind = 0
            if material:GetRoughness() = value
                return now
            end
            material:SetRoughness(value)
        else
            valueName = "metallic"
            if material:GetMetallic() = value
                return now
            end
            material:SetMetallic(value)
        end
        text message = valueName:GetSubtext(0, 1):ToUpperCase() + valueName:GetSubtext(1) + " " + RoundTenth(value) + "."
        if valueKind = 0 and material:GetRoughnessMapPath() not= ""
            message = message + " Not used: the roughness map sets it."
        end
        RecordMaterialChange(material, before, valueName, true, message)
    end

    /*
    This action renames a terrain layer's material (step 14). The layer's
    name in its terrain material follows. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter newName The new name
    */
    action RenameTerrainLayerMaterial(EditorTerrain terrain, integer layer, text newName)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or newName = "" or newName = material:GetName()
            return now
        end
        Material before = material:Copy()
        material:SetName(newName)
        terrain:GetMaterial():SetLayer(layer, newName, material)
        RecordMaterialChange(material, before, "name", false, "")
    end

    /*
    This action fills in a terrain layer's empty maps from its color map's
    folder, by name, and says what it found (step 14). It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action FindTerrainLayerMaps(EditorTerrain terrain, integer layer)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined
            return now
        end
        if not material:UsesTextureSet()
            NotifyAccessibility(terrain, "This is a plain texture. Choose a color map first to make it a texture set.")
            return now
        end
        Material before = material:Copy()
        // The color map's path is a full path, which File's SetPath
        // doesn't take.
        File colorMap = material:MakeFile(material:GetColorMapPath())
        text found = material:FindTextureSetMaps(colorMap, false)
        // A map found by name must still be the size of the color map.
        integer kind = material:NORMAL_MAP
        repeat while kind <= material:HEIGHT_MAP
            if material:GetMapPath(kind) not= "" and before:GetMapPath(kind) = ""
                text problem = material:GetMapSizeProblem(material:GetMapPath(kind))
                if problem not= ""
                    material:SetMapPath(kind, "")
                    found = found + " " + problem + " It was left out."
                end
            end
            kind = kind + 1
        end
        RecordMaterialChange(material, before, "find maps", true, found)
    end

    /*
    This action makes a terrain layer's texture set a plain texture, with
    its color map as its one image (step 14). It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action MakeTerrainLayerPlain(EditorTerrain terrain, integer layer)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or not material:UsesTextureSet()
            return now
        end
        Material before = material:Copy()
        material:MakePlain()
        RecordMaterialChange(material, before, "make plain", true, "Now a plain texture, with its color map.")
    end

    /*
    This action is called after a material changed, or the change was
    undone or redone (step 14): every terrain layer using it is given its
    new look, each terrain's materials are marked changed for the next
    save, the Properties panel follows, and the message is said.

    Attribute: Parameter material The material that changed
    Attribute: Parameter reload True if the layers must be given to the renderer again, false for a name
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action MaterialEdited(Material material, boolean reload, text message)
        if stroking
            EndTerrainStroke()
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        EditorTerrain shown = undefined
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain terrain = terrains:Get(i)
            TerrainMaterial terrainMaterial = terrain:GetMaterial()
            if terrainMaterial not= undefined
                boolean uses = false
                integer layer = 0
                repeat while layer < terrainMaterial:GetLayerCount()
                    if terrainMaterial:GetLayerMaterial(layer) = material
                        uses = true
                        // The layer's name follows the material's.
                        terrainMaterial:SetLayer(layer, material:GetName(), material)
                        if reload
                            terrain:RefreshMaterialLayer(layer)
                        end
                    end
                    layer = layer + 1
                end
                if uses
                    terrain:SetMaterialChanged(true)
                    shown = terrain
                end
            end
            i = i + 1
        end
        previewSize = -1
        if terrainMaterialsPropertiesDialog:IsShowing()
            terrainMaterialsPropertiesDialog:Refresh()
        end
        if shown not= undefined
            TerrainBrushChanged(shown)
            if message not= ""
                text said = message
                if reload
                    said = "Packing the texture set... " + message
                end
                NotifyAccessibility(shown, said)
            end
        end
    end

    /*
    This action adds a material change to the undo list and gives every
    layer using the material its new look.
    */
    private action RecordMaterialChange(Material material, Material before, text name, boolean reload, text message)
        SceneEditorMaterialEdit edit
        edit:Create(me, material, before, name, reload)
        editManager:Add(edit)
        MaterialEdited(material, reload, message)
    end

    /*
    This action returns true if a file is inside the scene's project.
    */
    private action IsInProject(File file) returns boolean
        if projectLocation = undefined
            return true
        end
        return file:GetAbsolutePath():StartsWith(projectLocation:GetAbsolutePath())
    end

    /*
    This action is called after a terrain's materials changed, or the
    change was undone or redone (step 9). The terrain was given its new
    look already; other terrains sharing the terrain material that changed
    are given theirs. Each is marked changed for the next save, the
    Properties panel follows, and the message is announced.

    Attribute: Parameter terrain The terrain whose materials changed
    Attribute: Parameter changed The terrain material whose layers changed, or undefined
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action TerrainMaterialEdited(EditorTerrain terrain, TerrainMaterial changed, text message)
        if stroking
            CancelTerrainStroke()
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain other = terrains:Get(i)
            if other not= terrain and changed not= undefined and other:GetMaterial() = changed
                other:RefreshMaterial()
                other:SetMaterialChanged(true)
                other:SetChanged(true)
            end
            i = i + 1
        end
        terrain:SetMaterialChanged(true)
        terrain:SetChanged(true)
        if terrain:GetBrush():GetLayer() >= terrain:GetLayerCount() and terrain:GetLayerCount() > 0
            terrain:GetBrush():SetLayer(terrain:GetLayerCount() - 1)
        end
        // The region models were made again, so the brush's ring is placed
        // again over them.
        previewSize = -1
        if terrainMaterialsPropertiesDialog:IsShowing()
            terrainMaterialsPropertiesDialog:SetTerrain(terrain)
        end
        TerrainBrushChanged(terrain)
        if message not= ""
            NotifyAccessibility(terrain, message)
        end
    end

    /*
    This action returns true if a terrain's materials can be changed, and
    says why not otherwise.
    */
    private action CanChangeMaterials(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so its materials can't be changed.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action makes a ground layer's material from a chosen file: a
    material file is loaded; a texture set's color map, such as
    Ground037_1K-PNG_Color.png, or another image makes a new material,
    written beside it as a .json file named after it, unless that file is
    there already. It returns undefined, and says why, for other files.
    */
    private action MakeTerrainLayerMaterial(EditorTerrain terrain, File chosen) returns Material
        layerMaterialNote = ""
        if chosen = undefined or not chosen:Exists()
            return undefined
        end
        HashTable<text, Material> materials = GetLoadedMaterials()
        text fileName = chosen:GetFileName()
        text lower = fileName:ToLowerCase()
        if lower:EndsWith(".json")
            text jsonKey = chosen:GetAbsolutePath()
            if materials:HasKey(jsonKey)
                return materials:GetValue(jsonKey)
            end
            Material material
            boolean loaded = true
            check
                material:Load(chosen)
            detect e is Error
                loaded = false
            end
            if not loaded
                NotifyAccessibility(terrain, fileName + " isn't a material file.")
                return undefined
            end
            if material:GetName() = ""
                material:SetName(fileName:GetSubtext(0, fileName:GetSize() - 5))
            end
            materials:Add(jsonKey, material)
            return material
        end
        if not (lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg"))
            NotifyAccessibility(terrain, "Choose a material file, or an image: a texture set's color map, such as Ground037_1K-PNG_Color.png or rock_wall_diff_1k.png, or a plain texture.")
            return undefined
        end

        // An image with a color ending, such as _Color or _diff, is a texture
        // set, and its other maps are found by name (step 14). Others are
        // plain textures.
        Material made
        text folder = chosen:GetParentDirectory():GetAbsolutePath()
        text materialName = made:GetSetName(fileName)
        if made:IsColorMapName(fileName)
            layerMaterialNote = made:FindTextureSetMaps(chosen, true)
            made:SetTextureScale(3)
            // AmbientCG's sets end in a size and format, such as _1K-PNG,
            // which the material's name leaves out.
            text lowerName = materialName:ToLowerCase()
            if lowerName:EndsWith("-png") or lowerName:EndsWith("-jpg")
                integer last = -1
                integer i = 0
                repeat while i < materialName:GetSize()
                    if materialName:GetSubtext(i, i + 1) = "_"
                        last = i
                    end
                    i = i + 1
                end
                if last > 0
                    materialName = materialName:GetSubtext(0, last)
                end
            end
        else
            made:SetTexturePath(chosen:GetAbsolutePath())
            made:SetTextureScale(4)
        end
        made:SetName(materialName)

        // The folder is a full path, which File's SetPath doesn't take.
        File materialFile
        materialFile:SetAbsolutePath(folder + "/" + materialName + ".json")
        text key = materialFile:GetAbsolutePath()
        if materials:HasKey(key)
            layerMaterialNote = ""
            return materials:GetValue(key)
        end
        if materialFile:Exists()
            Material existing
            existing:Load(materialFile)
            materials:Add(key, existing)
            layerMaterialNote = ""
            return existing
        end
        made:Save(materialFile)
        materials:Add(key, made)
        return made
    end

    /*
    This action makes a terrain's terrain material, with its file in the
    project's Scenes/Materials folder, named after the terrain's folder,
    such as Scenes/Materials/Terrain1.json. The folder is made if needed.
    The file isn't written yet.
    */
    private action CreateTerrainMaterial(EditorTerrain terrain) returns TerrainMaterial
        SceneProperties sceneProperties
        text folderPath = sceneProperties:SCENES_FOLDER + "/" + sceneProperties:MATERIALS_FOLDER
        File folder = ConvertToProjectFile(folderPath)
        if not folder:Exists()
            boolean made = folder:CreateDirectories()
        end

        // The terrain's folder name, from "Scenes/Terrains/Terrain1/terrain.json".
        text baseName = "Terrain"
        text terrainPath = terrain:GetTerrainFile()
        Array<text> parts = terrainPath:Split("/")
        if parts:GetSize() >= 2
            baseName = parts:Get(parts:GetSize() - 2)
        end

        text candidate = baseName
        integer count = 2
        File file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        repeat while file:Exists()
            candidate = baseName + " " + count
            count = count + 1
            file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        end

        TerrainMaterial material
        material:SetName(candidate)
        material:Save(file)
        return material
    end

    /*
    This action takes one ground layer out of a terrain's painting, keeping
    a copy for undo, and returns the edit that puts it back.
    */
    private action RemoveTerrainPaintingLayer(EditorTerrain terrain, integer layer) returns TerrainStrokeEdit
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation
        operation:BeginOperation(data, "remove layer", false, true)
        terrain:CopyAllRegions(operation)
        data:RemoveSplatLayer(layer)
        terrain:SetChanged(true)
        return operation:End()
    end

    /*
    This action clears a terrain's painting, keeping a copy for undo, and
    returns the edit that puts it back.
    */
    private action ClearTerrainPainting(EditorTerrain terrain) returns TerrainStrokeEdit
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation
        operation:BeginOperation(data, "clear painting", false, true)
        terrain:CopyAllRegions(operation)
        data:ClearSplat()
        terrain:SetChanged(true)
        return operation:End()
    end

    /*
    This action moves a terrain's paint layer to the next layer that has a
    material, going back to the first after the last, and says which it is
    (step 9).

    Attribute: Parameter terrain The terrain
    */
    action NextTerrainPaintLayer(EditorTerrain terrain)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        integer count = terrain:GetLayerCount()
        if count = 0
            NotifyAccessibility(terrain, "No materials to paint. Add them in the Materials section.")
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        integer layer = brush:GetLayer() + 1
        if layer >= count
            layer = 0
        end
        brush:SetLayer(layer)
        NotifyAccessibility(terrain, "Paint layer " + (layer + 1) + ", " + terrain:GetMaterial():GetLayerName(layer))
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets one end of a terrain's ramp at its brush, and says it
    (step 8).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter isEnd True for the ramp's end, false for its start
    */
    action SetTerrainRampPoint(EditorTerrain terrain, boolean isEnd)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool first, with Alt and a number, to place the brush.")
            return now
        end
        if isEnd
            // The end makes the ramp, if its start is set.
            if terrain:HasRampStart()
                ApplyTerrainRamp(terrain)
            else
                NotifyAccessibility(terrain, "Set the ramp's start first.")
            end
            return now
        end
        NotifyAccessibility(terrain, terrain:SetRampPoint(false))
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets the next end of a terrain's ramp at its brush, for its
    key (step 8): the start, then the end; after both, a new start.

    Attribute: Parameter terrain The terrain
    */
    action SetNextTerrainRampPoint(EditorTerrain terrain)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        if not terrain:HasRampStart()
            text started = terrain:SetRampPoint(false)
            if terrain:HasRampStart()
                started = "Ramp start at " + RoundTenth(terrain:GetRampStartX()) + ", " + RoundTenth(terrain:GetRampStartZ()) +
                    ", height " + RoundTenth(terrain:GetRampStartHeight()) + ". Move to where it ends, and click or press Alt+G again."
            end
            NotifyAccessibility(terrain, started)
            TerrainBrushChanged(terrain)
            return now
        end
        ApplyTerrainRamp(terrain)
    end

    /*
    This action makes a whole ramp at once (step 8): a straight slope from
    the ramp's start, at its height, to the brush, at the ground's height
    there, as wide as the brush. The ground across the ramp is set to the
    slope, fading back to the ground over the brush's outer edge. It can be
    undone, and the ramp is cleared for the next one.

    Attribute: Parameter terrain The terrain
    */
    action ApplyTerrainRamp(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        if not terrain:HasRampStart()
            return now
        end
        if not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "The brush is off the ground, so the ramp can't end there.")
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number startX = terrain:GetRampStartX()
        number startZ = terrain:GetRampStartZ()
        number startHeight = terrain:GetRampStartHeight()
        number endX = terrain:GetBrushX()
        number endZ = terrain:GetBrushZ()
        number endHeight = data:GetSurfaceHeight(endX, endZ)
        number halfWidth = terrain:GetBrush():GetSize()

        number lineX = endX - startX
        number lineZ = endZ - startZ
        number length = math:SquareRoot(lineX * lineX + lineZ * lineZ)
        if length < data:GetVertexSpacing()
            NotifyAccessibility(terrain, "The ramp's end is too close to its start. Move further away.")
            return now
        end
        number alongX = lineX / length
        number alongZ = lineZ / length

        number reach = halfWidth + 1
        integer minimumX = data:GetSampleX(math:MinimumOf(startX, endX) - reach)
        integer minimumZ = data:GetSampleZ(math:MinimumOf(startZ, endZ) - reach)
        integer maximumX = data:GetSampleX(math:MaximumOf(startX, endX) + reach) + 1
        integer maximumZ = data:GetSampleZ(math:MaximumOf(startZ, endZ) + reach) + 1
        TerrainStroke operation = BeginTerrainOperation(terrain, "ramp", true, false, minimumX, minimumZ, maximumX, maximumZ)

        number spacing = data:GetVertexSpacing()
        // Full strength across the middle of the ramp, fading to nothing at
        // its sides.
        number solid = halfWidth * 0.7
        integer z = minimumZ
        repeat while z <= maximumZ
            integer x = minimumX
            repeat while x <= maximumX
                if data:HasSample(x, z)
                    number offsetX = x * spacing - startX
                    number offsetZ = z * spacing - startZ
                    number along = offsetX * alongX + offsetZ * alongZ
                    number across = math:AbsoluteValue(offsetZ * alongX - offsetX * alongZ)
                    if along >= 0 and along <= length and across <= halfWidth
                        number weight = 1
                        if across > solid
                            number fade = (halfWidth - across) / (halfWidth - solid)
                            weight = fade * fade * (3 - 2 * fade)
                        end
                        number goal = startHeight + (endHeight - startHeight) * along / length
                        number height = data:GetSampleHeight(x, z)
                        data:SetSampleHeight(x, z, height + (goal - height) * weight)
                    end
                end
                x = x + 1
            end
            z = z + 1
        end

        terrain:ClearRamp()
        FinishTerrainOperation(terrain, operation, "Made a ramp from height " + RoundTenth(startHeight) + " to " + RoundTenth(endHeight) +
            ", " + RoundTenth(length) + " units long. Click again to start another.")
        TerrainBrushChanged(terrain)
    end

    /*
    This action clears a terrain's ramp, so the next two clicks (or Alt+G
    presses) set a new start and end (step 8).

    Attribute: Parameter terrain The terrain
    */
    action ClearTerrainRamp(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        terrain:ClearRamp()
        NotifyAccessibility(terrain, "Ramp cleared. With the Ramp tool, click where the next one starts.")
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets what flatten evens the ground to: the height where each
    stroke starts, or a set height (step 8).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter toStart True for the height where each stroke starts
    */
    action SetTerrainFlattenToStart(EditorTerrain terrain, boolean toStart)
        if terrain = undefined
            return now
        end
        terrain:GetBrush():SetFlattenToStart(toStart)
        if toStart
            NotifyAccessibility(terrain, "Flatten to the height where each stroke starts")
        else
            NotifyAccessibility(terrain, "Flatten to height " + RoundTenth(terrain:GetBrush():GetTargetHeight()))
        end
    end

    /*
    This action sets the height flatten evens the ground to, and makes it
    flatten to that height rather than where each stroke starts (step 8).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter height The height
    */
    action SetTerrainFlattenHeight(EditorTerrain terrain, number height)
        if terrain = undefined
            return now
        end
        terrain:GetBrush():SetTargetHeight(height)
        terrain:GetBrush():SetFlattenToStart(false)
        TerrainBrushChanged(terrain)
    end

    /*
    This action takes the ground's height under a terrain's brush as the
    height flatten evens to (step 8).

    Attribute: Parameter terrain The terrain
    */
    action TakeTerrainFlattenHeight(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool() or not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "Place the brush on the ground first, with a tool chosen.")
            return now
        end
        number height = terrain:GetWorldTerrain():GetData():GetSurfaceHeight(terrain:GetBrushX(), terrain:GetBrushZ())
        terrain:GetBrush():SetTargetHeight(height)
        terrain:GetBrush():SetFlattenToStart(false)
        NotifyAccessibility(terrain, "Flatten to height " + RoundTenth(height))
        TerrainBrushChanged(terrain)
    end

    /*
    This action says what the ground under a terrain's whole brush is like:
    its heights, its steepest slope, and how much of it each layer covers
    (step 12). The Brush section's "Describe the area" button calls it.

    Attribute: Parameter terrain The terrain
    */
    action DescribeTerrainArea(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool first, with Alt and a number, to place the brush.")
            return now
        end
        NotifyAccessibility(terrain, terrain:DescribeArea())
    end

    /*
    This action makes a terrain's brush stronger or weaker, by one step, and
    says its new strength (step 8).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter stronger True to strengthen the brush, false to weaken it
    */
    action ChangeTerrainStrength(EditorTerrain terrain, boolean stronger)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        number strength = brush:GetStrength()
        if stronger
            strength = strength * BRUSH_STRENGTH_STEP
        else
            strength = strength / BRUSH_STRENGTH_STEP
        end
        if strength < BRUSH_WEAKEST
            strength = BRUSH_WEAKEST
        elseif strength > BRUSH_STRONGEST
            strength = BRUSH_STRONGEST
        end
        brush:SetStrength(strength)
        NotifyAccessibility(terrain, "Brush strength " + (cast(integer, strength * 100 + 0.5) / 100.0))
        TerrainBrushChanged(terrain)
    end

    /*
    This action keeps the Brush section of the Properties panel in step with
    a terrain's brush, after a key or the pointer changed it (step 7).

    Attribute: Parameter terrain The terrain whose brush changed
    */
    action TerrainBrushChanged(EditorTerrain terrain)
        if terrainBrushPropertiesDialog:IsShowing()
            terrainBrushPropertiesDialog:SetTerrain(terrain)
        end
    end

    /*
    This action shows the ring for the terrain whose tool is chosen, placed
    again only when the brush moved or changed size, and hides it otherwise
    (step 7). The ring is one of the editor's own items: it isn't saved,
    listed or picked.
    */
    private action UpdateBrushPreview
        boolean show = IsTerrainBrushActive() and brushTerrain:IsBrushOnGround()
        if not show
            if brushPreviewShown
                brushPreview:Hide()
                brushPreviewShown = false
            end
            HideRampPreview()
            return now
        end
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        number size = brushTerrain:GetBrush():GetSize()
        boolean moved = brushTerrain:GetBrushX() not= previewX or brushTerrain:GetBrushZ() not= previewZ or size not= previewSize
        UpdateRampPreview(cast(EditorLayer3D, layer))
        if brushPreview = undefined
            TerrainBrushPreview preview
            preview:SetName("Terrain Brush")
            preview:SetProperty(constants:EDITOR_TAG, undefined)
            // The ring lets clicks through to the scene editor.
            preview:SetAcceptsMouseInput(false)
            preview:Place(brushTerrain:GetWorldTerrain():GetData(), brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), size)
            brushPreview = preview
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(preview)
            moved = false
        end
        if moved
            brushPreview:Place(brushTerrain:GetWorldTerrain():GetData(), brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), size)
        end
        // The brush turns red while it marks a ramp's end.
        if brushTerrain:GetToolNumber() = 5 and brushTerrain:HasRampStart()
            brushPreview:SetRingColor(0.95, 0.15, 0.1)
        else
            brushPreview:SetRingColor(1, 0.85, 0.1)
        end
        if not brushPreviewShown
            brushPreview:Show()
            brushPreviewShown = true
        end
        previewX = brushTerrain:GetBrushX()
        previewZ = brushTerrain:GetBrushZ()
        previewSize = size
    end

    /*
    This action shows a ramp being marked (step 8): a green ring at its
    start, and a green outline from the start, at its height, to the brush,
    at the ground's height there, as wide as the brush. They are the
    editor's own items, so they aren't saved, listed or picked.

    Attribute: Parameter layer The 3D layer the terrain is in
    */
    private action UpdateRampPreview(EditorLayer3D layer)
        boolean marking = brushTerrain:GetToolNumber() = 5 and brushTerrain:HasRampStart()
        if not marking
            HideRampPreview()
            return now
        end
        TerrainData data = brushTerrain:GetWorldTerrain():GetData()
        number size = brushTerrain:GetBrush():GetSize()
        number startX = brushTerrain:GetRampStartX()
        number startZ = brushTerrain:GetRampStartZ()
        if rampStartMarker = undefined
            TerrainBrushPreview marker
            marker:SetName("Ramp Start")
            marker:SetProperty(constants:EDITOR_TAG, undefined)
            marker:SetAcceptsMouseInput(false)
            marker:SetRingColor(0.15, 0.85, 0.25)
            marker:Place(data, startX, startZ, size)
            rampStartMarker = marker
            layer:Add(marker)

            TerrainRampPreview outline
            outline:SetName("Ramp")
            outline:SetProperty(constants:EDITOR_TAG, undefined)
            outline:SetAcceptsMouseInput(false)
            rampOutline = outline
            layer:Add(outline)
        end
        rampStartMarker:Place(data, startX, startZ, size)
        number endHeight = data:GetSurfaceHeight(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ())
        rampOutline:Place(startX, startZ, brushTerrain:GetRampStartHeight(), brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(),
            endHeight, size)
        if not rampShown
            rampStartMarker:Show()
            rampOutline:Show()
            rampShown = true
        end
    end

    /*
    This action hides a ramp's start ring and outline.
    */
    private action HideRampPreview
        if rampShown
            rampStartMarker:Hide()
            rampOutline:Hide()
            rampShown = false
        end
    end

    /*
    This action gives back what each terrain in the 3D layers holds in the
    renderer, such as its block of texture places. Call it when the scene is
    closed, after HideLayers, so reopening scenes doesn't use up places.
    */
    action ReleaseTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        item:Dispose()
                    end
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action keeps each terrain in the 3D layers up to date, once a frame,
    with the editor camera's place. Painted ground textures only show once
    the renderer has them ready, which this checks.
    */
    private action UpdateTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Camera camera = layer:GetCamera()
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        EditorTerrain terrain = cast(EditorTerrain, item)
                        terrain:Update(layer, camera:GetPosition():GetX(), camera:GetPosition():GetZ())
                    end
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action saves the files of each terrain whose ground has changed
    since it was last saved. Saving the scene calls it.
    */
    private action SaveChangedTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        EditorTerrain terrain = cast(EditorTerrain, item)
                        terrain:SaveIfChanged()
                    end
                end
            end
            counter = counter + 1
        end
    end

    action SelectEditorCamera(EditorLayer layer)
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            CameraItem2D item
            item:Load(layer:GetCamera(), me)
            layer2D:Add(item)
            SetSelection(layer2D, item)

            item:Focus()
        elseif layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            CameraItem3D item
            item:Load(layer3D:GetEditorCamera(), me)
            layer3D:Add(item)
            SetSelection(layer3D, item)

            item:Focus()
        end
    end

    action DeselectEditorCamera
        // Was already empty
    end

    Matrix4 previewTransform = undefined
    action GetPreviewTransform returns Matrix4
        return previewTransform
    end

    action SetPreviewTransform(Matrix4 transform)
        previewTransform = transform
    end

    action GetDefaultItemName(integer type) returns text
        if type = 0
            return "Box"
        elseif type = 1
            return "Sphere"
        elseif type = 2
            return "Cylinder"
        end

        return "Item"
    end

    action ConfirmItemPreview(ItemPreview newItem)
        Item result = undefined
        EditorLayer resultLayer = undefined

        if newItem:GetItemBlueprint() not= undefined
            IncrementNameCount(newItem:GetItemBlueprint():GetName())
        end

        if newItem is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, newItem)
            Model model = preview:ConvertToModel()
            result = model

            previewTransform = preview:GetTransform()
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(model)
        elseif newItem is ItemPreview2D
            ItemPreview2D preview = cast(ItemPreview2D, newItem)
            Drawable drawable = preview:ConvertToDrawable()
            result = drawable

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(drawable)
        end

        // This Dispose call currently does nothing, but if there are any
        // resources that need to be cleaned up, it should be done here.
        //preview:Dispose()
        //Focus()

        NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, result, undefined, resultLayer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        if newItem:GetItemBlueprint() not= undefined
            text name = newItem:GetItemBlueprint():GetName()
            newItem:SetName(name + GetNextNamePostfix(name))
            if newItem is ModelPreview
                //item3dPropertiesDialog:SetFields(newItem)
            elseif newItem is PointLightPreview
                //pointLightPropertiesDialog:SetFields(newItem)
            elseif newItem is Audio3DPreview
                //audio3DPropertiesDialog:SetFields(newItem)
            elseif newItem is ItemPreview2D
                //item2dPropertiesDialog:SetFields(newItem)
            end
        end

        SceneEditorInsertEdit edit
        edit:Create(me, resultLayer, result)
        editManager:Add(edit)
    end

    action Add(EditorLayer layer, Item item)
        if layer is EditorLayer2D and item is Item2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Item2D item2D = cast(Item2D, item)
            layer2D:Add(item2D)
        elseif layer is EditorLayer3D and item is Item3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Item3D item3D = cast(Item3D, item)
            layer3D:Add(item3D)    
        else
            alert("I couldn't add the item " + item:GetName() + " because it's incompatible with the requested layer.")
        end

        // It's not clear if we should notify accessibility here, or allow a change in selection to handle that for us.
        //NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, item, undefined, layer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        SceneEditorInsertEdit edit
        edit:Create(me, layer, item)
        editManager:Add(edit)
    end

    action AddLayer(EditorLayer layer)
        selection:SetSelection(layer)
        layer:SetSceneEditor(me)
        layers:Add(layer)
    end

    action SetYawDirection(integer direction)
        yawDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Yaw " + math:Round(GetSelectedLayer():GetCameraYaw(), 1))
        end
    end

    action GetYawDirection returns integer
        return yawDirection
    end

    action SetPitchDirection(integer direction)
        pitchDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Pitch " + math:Round(GetSelectedLayer():GetCameraPitch(), 1))
        end
    end

    action GetPitchDirection returns integer
        return pitchDirection
    end

    action SetRollDirection(integer direction)
        rollDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Roll " + math:Round(GetSelectedLayer():GetCameraRoll(), 1))
        end
    end

    action GetRollDirection returns integer
        return rollDirection
    end

    action IsCameraRotating returns boolean
        return GetYawDirection() not= 0 or GetPitchDirection() not= 0
    end

    action GetYaw returns number
        return GetSelectedLayer():GetCameraYaw()
    end

    action GetPitch returns number
        return GetSelectedLayer():GetCameraPitch()
    end

    action GetRoll returns number
        return GetSelectedLayer():GetCameraRoll()
    end

    action SetForwardDirection(integer direction)
        forwardDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetForwardDirection returns integer
        return forwardDirection
    end
    action SetStrafeDirection(integer direction)
        strafeDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetStrafeDirection returns integer
        return strafeDirection
    end

    action SetVerticalDirection(integer direction)
        verticalDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetVerticalDirection returns integer
        return verticalDirection
    end

    action IsCameraMoving returns boolean
        return GetForwardDirection() not= 0 or GetStrafeDirection() not= 0 or GetVerticalDirection() not= 0
    end

    action SetCursorToItem(EditorItem item)
        // We don't want the cursor to jump to the camera item, so abort now.
        if item is CameraItem
            return now
        end
        // A terrain's middle may be far from where it was clicked, so the
        // cursor stays where it is when a terrain is selected.
        if item is TerrainSelectionHighlight
            return now
        end

        if item is EditorItem2D
            EditorCursor2D cursor = cast(EditorCursor2D, GetCursor())
            number x = item:GetGlobalX()
            number y = item:GetGlobalY()
            if not IsGridCoordinate(x)
                x = GetSelectedLayer():GetPreviousGridCoordinate(x)
            end
            if not IsGridCoordinate(y)
                y = GetSelectedLayer():GetPreviousGridCoordinate(y)
            end
            cursor:SetPosition(x, y)
        elseif item is EditorItem3D
            EditorCursor3D cursor = cast(EditorCursor3D, GetCursor())
            number x = item:GetGlobalX()
            number y = item:GetGlobalY()
            number z = item:GetGlobalZ()
            cursor:SetPosition(x, y, z)
        end
    end

    // Used when moving an InteractableItem into a grid space to give information about what's under the item.
    // Doesn't include the item itself in the description.
    private action GetDescriptionAtItemPosition(EditorItem item) returns text
        // With a terrain tool chosen, the arrows move its brush: say where
        // the brush is and the ground's height there (step 7).
        if item is TerrainSelectionHighlight
            TerrainSelectionHighlight terrainHighlight = cast(TerrainSelectionHighlight, item)
            EditorTerrain highlighted = terrainHighlight:GetEditorTerrain()
            if highlighted not= undefined and highlighted:HasTool()
                return highlighted:DescribeBrush()
            end
        end

        SetCursorToItem(item)

        Item ignoredItem = undefined

        if item is SelectionHighlight
            SelectionHighlight highlight = cast(SelectionHighlight, item)
            ignoredItem = highlight:GetItem()
        end

        EditorCursor cursor = GetCursor()
        if cursor is EditorCursor2D
            EditorCursor2D cursor2D = cast(EditorCursor2D, cursor)
            text position = cast(integer, item:GetGlobalX()) + " " + cast(integer, item:GetGlobalY())
            Array<Item> items = cursor2D:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                    end
                end
                return names + position
            else
                integer counter = items:GetSize()
                integer used = 0
                text names = ""
                repeat while used < 3
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                        used = used + 1
                    end
                end
                return names + (items:GetSize() - 1) + " items, " + position
            end
        else
            EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
            text position = ""
            if cursor:GetGlobalX() = cast(integer, cursor:GetGlobalX())
                position = position + cast(integer, cursor:GetGlobalX())
            else
                position = position + cursor:GetGlobalX()
            end

            position = position + " "

            if cursor:GetGlobalY() = cast(integer, cursor:GetGlobalY())
                position = position + cast(integer, cursor:GetGlobalY())
            else
                position = position + cursor:GetGlobalY()
            end

            position = position + " "

            if cursor:GetGlobalZ() = cast(integer, cursor:GetGlobalZ())
                position = position + cast(integer, cursor:GetGlobalZ())
            else
                position = position + cursor:GetGlobalZ()
            end

            Array<Item> items = cursor3D:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                    end
                end
                return names + position
            else
                integer counter = items:GetSize()
                integer used = 0
                text names = ""
                repeat while used < 3
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                        used = used + 1
                    end
                end
                return names + (items:GetSize() - 1) + " items, " + position
            end
        end
        return item:GetGlobalX() + " " + item:GetGlobalY()
    end

    action SetSelectionXDirection(integer direction)
        selectionXDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionXDirection returns integer
        return selectionXDirection
    end

    action SetSelectionYDirection(integer direction)
        selectionYDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionYDirection returns integer
        return selectionYDirection
    end

    action SetSelectionZDirection(integer direction)
        selectionZDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionZDirection returns integer
        return selectionZDirection
    end

    action IsSelectionMoving returns boolean
        return GetSelectionXDirection() not= 0 or GetSelectionYDirection() not= 0 or GetSelectionZDirection() not= 0
    end

    action SetSelectionYawDirection(integer direction)
        selectionYawDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number yaw = math:Round(focus:GetYaw(), 1)
                NotifyAccessibility(focus, "yaw " + yaw)
            end
        end
    end

    action GetSelectionYawDirection returns integer
        return selectionYawDirection
    end

    action SetSelectionPitchDirection(integer direction)
        selectionPitchDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number pitch = math:Round(focus:GetPitch(), 1)
                NotifyAccessibility(focus, "pitch " + pitch)
            end
        end
    end

    action GetSelectionPitchDirection returns integer
        return selectionPitchDirection
    end

    action SetSelectionRollDirection(integer direction)
        selectionRollDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number roll = math:Round(focus:GetRoll(), 1)
                NotifyAccessibility(focus, "roll " + roll)
            elseif manager:GetFocus() is EditorItem2D
                EditorItem2D focus = cast(EditorItem2D, manager:GetFocus())
                number rotation = math:Round(focus:GetRotation(), 1)
                NotifyAccessibility(focus, rotation + " degrees")
            end
        end
    end

    action GetSelectionRollDirection returns integer
        return selectionRollDirection
    end

    action IsSelectionRotating returns boolean
        return GetSelectionYawDirection() not= 0 or GetSelectionPitchDirection() not= 0 or GetSelectionRollDirection() not= 0
    end

    action NotifyAccessibility(Item item, text message)
        if accessibility not= undefined
            accessibility:Notify(item, message)
        end
    end

    action SetGridSnapping(boolean enabled)
        EditorLayer layer = GetSelectedLayer()

        if layer:IsGridSnapping() = enabled
            return now
        end

        layer:SetGridSnapping(enabled)

        if enabled
            NotifyAccessibility(me, "Grid snapping enabled")
        else
            NotifyAccessibility(me, "Grid snapping disabled")
        end
    end

    action SetGridUnitSize(number units)
        EditorLayer layer = GetSelectedLayer()
        layer:SetGridUnitSize(units)
        
        NotifyAccessibility(me, "Grid size " + units)
    end

    action GetGridUnitSize returns number
        EditorLayer layer = GetSelectedLayer()
        return layer:GetGridUnitSize()
    end

    action IsGridSnapping returns boolean
        EditorLayer layer = GetSelectedLayer()
        return layer:IsGridSnapping()
    end

    private action IsGridCoordinate(number value) returns boolean
        return GetSelectedLayer():IsGridCoordinate(value)
    end

    action SetSelectedItem(EditorItem item)
        selection:SetSelection(item)
    end

    action SetSelectedLayer(EditorLayer layer)
        if layer = selection:GetSelectedLayer()
            return now
        end

        EmptyFilteredItems(false)

        selection:SetSelection(layer, undefined)
    end

    action SetSelection(EditorLayer layer, EditorItem item)
        if layer = selection:GetSelectedLayer() and item = selection:GetSelectedItem()
            return now
        end

        EmptyFilteredItems(false)
        selection:SetSelection(layer, item)
    end

    action GetSelectedItem returns EditorItem
        return selection:GetSelectedItem()
    end

    action GetSelectedLayer returns EditorLayer
        return selection:GetSelectedLayer()
    end

    action GetCursor returns EditorCursor
        EditorLayer layer = GetSelectedLayer()
        if layer = undefined
            return undefined
        end

        return layer:GetCursor()
    end

    action GetSceneLayers returns Array<EditorLayer>
        return layers
    end

    action GainedFocus(FocusEvent event)
        // A click in the view with a terrain's tool chosen is a stroke
        // (step 8), so the terrain stays selected, and its highlight gets
        // the focus back on the next update, for the brush's keys.
        if IsTerrainBrushActive() and GetSelectedItem() is TerrainSelectionHighlight
            refocusBrushHighlight = true
            parent:Control:GainedFocus(event)
            return now
        end
        SetSelectedItem(undefined)
        UpdateCursorVisibility()

        if accessibility not= undefined
            // Update the description for the controller in accessibility.
            accessibility:DescriptionChanged(me)
        end
        parent:Control:GainedFocus(event)
    end

    action LostFocus(FocusEvent event)
        Item item = event:GetNewFocus()
        integer value = dummyItem:GetHashCode()
        boolean goingToDummy = false
        if item not= undefined
            integer value1 = item:GetHashCode()
            goingToDummy = (value1 = value)
        end
        EditorLayer layer = GetSelectedLayer()
        if layer not= undefined and not goingToDummy
            layer:ShowCursor(false)
        end
        parent:Control:LostFocus(event)
    end

    /*
    If the given Item has a corresponding SelectionHighlight, this action
    will return the highlight. Otherwise, it will return undefined.
    */
    action GetSelectionHighlight(Item item) returns SelectionHighlight
        integer i = 0
        repeat while i < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(i)
            if highlight:GetItem() = item
                return highlight
            end
            i = i + 1
        end

        return undefined
    end

    /*
    This action sets the cursor to either be visible or hidden, as is appropriate
    based on the current editor context. For example, if a layer is active and no
    items are selected, it will show the cursor, or hide it if there are already
    selected items.

    This is called automatically by the SceneEditorSelection when the selection
    changes.
    */
    action UpdateCursorVisibility
        EditorLayer layer = selection:GetSelectedLayer()
        if layer = undefined
            return now
        end

        // If an item is selected, hide the cursor. Otherwise, show it.
        layer:ShowCursor(selection:GetSelectedItem() = undefined)
    end

    action GetNameCount(text name) returns integer
        if nameCounts:HasKey(name)
            return nameCounts:GetValue(name)
        end
        return 0
    end

    action IncrementNameCount(text name)
        nameCounts:Set(name, GetNameCount(name) + 1)
    end

    action GetNextNamePostfix(text name) returns text
        integer count = GetNameCount(name)
        if count = 0
            return ""
        end

        return " " + count
    end


    action AddSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Add(listener)
    end

    action RemoveSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Remove(listener)
    end

    private action NotifySceneEditorChangeListeners(SceneEditorChangeEvent event)
        integer i = 0
        repeat while i < sceneEditorChangeListeners:GetSize()
            if event:GetEventType() = event:ADDED
                sceneEditorChangeListeners:Get(i):SceneAddedItem(event)
            else
                sceneEditorChangeListeners:Get(i):SceneRemovedItem(event)
            end
            i = i + 1
        end
    end

/* 
    Overrides the action in DefaultSceneManager. Used to determine which layers
    should be used to match the layers described in the Scene.

    We always make new layers which are stored as part of the VisualSceneController.
    */
    private action SelectLayer(JavaScriptObjectNotation layerJson) returns Layer

        text name = layerJson:GetValue(properties:NAME)
        text classValue = layerJson:GetValue(properties:CLASS)
        EditorLayer current = undefined

        if classValue = "Layer3D"
            EditorLayer3D layer
            current = layer
        elseif classValue = "Layer2D"
            EditorLayer2D layer
            current = layer
        end

        current:SetName(name)
        AddLayer(current)

        return current
    end

    /*
    This action can be used to override a portion of the default camera loading.
    */
    private action CustomLoadCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE        
                Number32BitArray size = ConvertToNumber32BitArray(json:GetObject(key))
                layer2D:SetCameraPreviewSize(size:Get(0), size:Get(1))
                return true
            elseif key = "EDITOR_" + properties:POSITION
                Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                camera:SetPosition(position:Get(0), position:Get(1), camera:GetPosition():GetZ())
                return true
            elseif key = "EDITOR_" + properties:ZOOM
                camera:SetZoom(json:GetNumber(key))
                return true
            end
        end

        return false
    end

    private action CustomSaveCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE
                json:Add(properties:SIZE, NewJsonArray(layer2D:GetCameraPreviewWidth(), layer2D:GetCameraPreviewHeight()))
                return true
            elseif key = properties:POSITION
                CameraPreview2D preview = layer2D:GetCameraPreview()
                number x = preview:GetX() + preview:GetWidth() / 2.0
                number y = preview:GetY() + preview:GetHeight() / 2.0
                json:Add(properties:POSITION, NewJsonArray(x, y, camera:GetPosition():GetZ()))

                json:Add("EDITOR_" + properties:POSITION, NewJsonArray(camera:GetPosition():GetX(), camera:GetPosition():GetY()))

                return true
            elseif key = properties:ZOOM
                json:Add(properties:ZOOM, 1.0)

                json:Add("EDITOR_" + properties:ZOOM, camera:GetZoom())

                return true
            end
        end

        return false
    end

    action Save
        // A terrain's heights and painting live in its own files.
        SaveChangedTerrains()

        Array<EditorLayer> layers = GetSceneLayers()
        Scene scene = Save(layers)
        scene:GetData():SetPrettyPrint(true)
        file:Write(scene:GetData():ToText())
    end

    // We override the particular save item calls to ignore items with the editor tag.
    private action SaveItem3D(Item3D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        elseif item is EditorAudio3D
            JavaScriptObjectNotation json

            json:Add(properties:CLASS, "Audio3D")

            json:Add(properties:NAME, item:GetName())
            json:Add(properties:DESCRIPTION, item:GetDescription())
            json:Add(properties:POSITION, NewJsonArray(item:GetX(), item:GetY(), item:GetZ()))
            json:Add(properties:SIZE, NewJsonArray(item:GetWidth(), item:GetHeight(), item:GetDepth()))
    
            EditorAudio3D audio = cast(EditorAudio3D, item)
            json:Add(properties:FILE, audio:GetSource())
            json:Add(properties:VOLUME, audio:GetVolume())
            json:Add(properties:PITCH, audio:GetPitch())
            json:Add(properties:MAX_VOLUME_DISTANCE, audio:GetMaximumVolumeDistance())
            json:Add(properties:ROLLOFF_RATE, audio:GetRolloffRate())
            json:Add(properties:LOOPING, audio:GetLooping())
            json:Add(properties:DOPPLER_ENABLED, audio:GetDoppler())
            json:Add(properties:PLAY_ON_LOAD, audio:GetPlayOnLoad())

            return json
        else
            JavaScriptObjectNotation json = parent:DefaultSceneManager:SaveItem3D(item)
            return json
        end
    end

    private action SaveItem2D(Item2D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        end

        return parent:DefaultSceneManager:SaveItem2D(item)
    end

    private action CreateItem3D(text type) returns Item3D
        if type = "Model"
            EditorModel model
            return model
        elseif type = "PointLight"
            EditorPointLight light
            return light
        elseif type = "SpotLight"
            EditorSpotLight spot
            return spot
        elseif type = "Terrain"
            EditorTerrain terrain
            terrain:SetSceneEditor(me)
            return terrain
        end

        return parent:DefaultSceneManager:CreateItem3D(type)
    end

    private action LoadItem3D(JavaScriptObjectNotation json) returns Item3D
        if json:GetValue(properties:CLASS) = "Audio3D"
            EditorAudio3D item
            item:LoadPlaceholderBox()

            text file = ""
            JavaScriptObjectNotation children = undefined
            number volume = 0
            number pitch = 0
            number maxDistance = 0
            number rolloffRate = 0
            boolean looping = false
            boolean doppler = true
            boolean playOnLoad = false

            Array<text> keys = json:GetKeys()

            integer counter = 0
            repeat while counter < keys:GetSize()
                text key = keys:Get(counter)
    
                if CustomLoadProperty3D(item, key, json)
                    // If we custom loaded this property, we don't do the normal processing for that key.
                elseif key = properties:NAME
                    item:SetName(json:GetValue(key))
                elseif key = properties:POSITION
                    Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                    item:SetPosition(position:Get(0), position:Get(1), position:Get(2))
                elseif key = properties:FILE
                    item:SetSource(json:GetValue(key))
                elseif key = properties:DESCRIPTION
                    item:SetDescription(json:GetValue(key))
                elseif key = properties:CHILDREN
                    children = json:GetObject(key)
                elseif key = properties:VOLUME
                    item:SetVolume(json:GetNumber(key))
                elseif key = properties:PITCH
                    item:SetPitch(json:GetNumber(key))
                elseif key = properties:MAX_VOLUME_DISTANCE
                    item:SetMaximumVolumeDistance(json:GetNumber(key))
                elseif key = properties:ROLLOFF_RATE
                    item:SetRolloffRate(json:GetNumber(key))
                elseif key = properties:LOOPING
                    item:SetLooping(json:GetBoolean(key))
                elseif key = properties:DOPPLER_ENABLED
                    item:SetDoppler(json:GetBoolean(key))
                elseif key = properties:PLAY_ON_LOAD
                    item:SetPlayOnLoad(json:GetBoolean(key))
                end
    
                counter = counter + 1
            end

            return item
        else
            return parent:DefaultSceneManager:LoadItem3D(json)
        end
    end

    /*
    This action can be used to determine what working directory
    to use for file loading. This can be used to open model resources that
    exist in a different project, for example.
    */
    private action ConvertToProjectFile(text path) returns File
        File file
        file:SetWorkingDirectory(projectLocation:GetAbsolutePath())
        file:SetPath(path)
        return file
    end

    private action CustomLoadProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        elseif key = constants:EULER_ANGLES
            
        end

        return false
    end

    private action CustomSaveProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:CLASS
            if item is EditorPointLight
                json:Add(key, "PointLight")
                return true
            elseif item is EditorSpotLight
                json:Add(key, "SpotLight")
                return true
            else
                return false
            end
        elseif key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        elseif key = constants:EULER_ANGLES
            if not (item is EditorModel)
                return false
            end
            EditorModel model = cast(EditorModel, item)

            JavaScriptObjectNotation angles
            angles:SetArray()
            angles:Add(model:GetYaw())
            angles:Add(model:GetPitch())
            angles:Add(model:GetRoll())
    
            json:Add(key, angles)
            return true
        end
        return false
    end

    private action CustomLoadProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        end

        return false
    end

    private action CustomSaveProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true

            // If physics is enabled but no responsiveness was selected, use the default responsiveness value (0 = UNMOVABLE).
            elseif item:HasProperty(properties:PHYSICS_ENABLED)
                json:Add(key, 0)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        end
        return false
    end

action HideLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:RemoveLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

    action ShowLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:AddLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

end