/*
SceneEditor is the main Control that enables adding a functional scene editor
to a Game. 

Attribute: Example

TODO
need to implement more to understand how to structure examples.

*/
class SceneEditor is Control, DefaultSceneManager

    File file = undefined
    File projectLocation = undefined
    GameStateManager manager
    SceneProperties properties

    Array<EditorLayer> layers

    SceneConstants constants
    SceneEditorSelection selection

    Array<SceneEditorChangeListener> sceneEditorChangeListeners

    SceneEditorEditManager editManager

    // The rotational speed measured in degrees,
    // and the directional speed, measured in 3D world units.
    public constant number CAMERA_ROTATIONAL_SPEED_3D = 15
    public constant number CAMERA_DIRECTIONAL_SPEED_3D = 1

    public constant number SELECTION_ROTATIONAL_SPEED_3D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_3D = 5

    public constant number CAMERA_ROTATIONAL_SPEED_2D = 90
    public constant number CAMERA_DIRECTIONAL_SPEED_2D = 600
    public constant number SELECTION_ROTATIONAL_SPEED_2D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_2D = 600

    /*
    Velocities of the layer's camera.
    Directions are always -1, 0, or 1, and are multiplied by either the rotational
    or directional speed during the Update to produce the per-frame velocity.
    */
    integer yawDirection = 0
    integer pitchDirection = 0
    integer rollDirection = 0
    integer forwardDirection = 0
    integer strafeDirection = 0
    integer verticalDirection = 0

    // The velocity of the currently selected item on each axis.
    integer selectionXDirection = 0
    integer selectionYDirection = 0
    integer selectionZDirection = 0
    integer selectionYawDirection = 0
    integer selectionPitchDirection = 0
    integer selectionRollDirection = 0

    // Vectors which are constantly reused for frequent calculations.
    Vector2 workVector2
    Vector3 workVector3

    Accessibility accessibility = undefined

    // The camera perspectives that NextCameraPerspective cycles through, in order.
    public constant integer ORIGIN_PERSPECTIVE = 0
    public constant integer HORIZON_PERSPECTIVE = 1
    public constant integer TOP_DOWN_PERSPECTIVE = 2
    integer cameraPerspective = -1

    /*
        While a perspective is on, focus is on perspectiveItem, which uses the arrow keys to move the
        camera and Escape to leave. The camera looks at perspectiveCenter, a point that is never added
        to a layer. The camera and focus from before the perspective are kept so Escape can put them back.
    */
    boolean inCameraPerspective = false
    CameraPerspectiveItem perspectiveItem = undefined
    Item3D perspectiveCenter
    integer perspectivePanX = 0
    integer perspectivePanZ = 0
    // 1 while zooming in, -1 while zooming out, and 0 otherwise.
    integer perspectiveZoom = 0
    Item3D savedCameraTarget = undefined
    number savedCameraDistance = 0
    number savedCameraYaw = 0
    number savedCameraPitch = 0
    number savedCameraRoll = 0
    Vector3 savedCameraPosition
    Item savedFocus = undefined
    CameraItem3D perspectiveCameraItem = undefined

    // A message for screen readers that waits until a focus change has been announced, because a
    // focus announcement replaces any message sent just before it.
    text pendingAnnouncement = ""
    number pendingAnnouncementDelay = 0

    Math math
    Color color

    /*
    A subset of the items, filtered in some way (e.g., the items in view of
    the camera). These can be iterated over to query for more information or to
    modify the elements.
    */
    Array<Item> filteredItems = undefined

    /*
    True while a selection is being built from the keyboard with Shift+Enter on the cursor. Focus
    stays on the cursor until Enter confirms the selection. Any other change to the selection ends it.
    */
    boolean keyboardSelectionPending = false

    // The last items copied with CopyItems, stored as JSON so they can be pasted with PasteCopiedItem.
    Array<JavaScriptObjectNotation> copiedItemsJson

    // The items that copiedItemsJson was made from, in the same order. When several items are pasted,
    // each copy is placed where its original is at the time of pasting.
    Array<Item3D> copiedOriginals

    // The 3D item grabbed with the mouse, or undefined if the mouse is not dragging an item.
    Item3D mouseDragItem = undefined

    /*
    When the mouse is pressed on an item that is part of a group selection, the group stays
    selected so it can be dragged together. If the mouse is released without dragging, only
    this item is selected, as most editors do.
    */
    Item3D mouseDragCollapseItem = undefined

    // The distance from the point under the mouse to the grabbed item, so the item does not jump to the mouse.
    number mouseDragOffsetX = 0
    number mouseDragOffsetY = 0
    number mouseDragOffsetZ = 0

    /*
    Whether the current drag moves items up and down (Alt and drag) instead of along the ground.
    When this changes during a drag, the drag is anchored again so the items do not jump.
    */
    boolean mouseDragVertical = false

    // False until the drag knows where the mouse is relative to the grabbed item.
    boolean mouseDragAnchored = false

    /*
    For up and down dragging, items move along an upright plane through the grabbed item that
    faces the camera. This is the direction the plane faces, along the ground.
    */
    number mouseDragNormalX = 0
    number mouseDragNormalZ = 0

    /*
    The selected 3D items and where they were when the current move started, by keyboard or mouse.
    When the move finishes, these are recorded as one SceneEditorMoveEdit so the move can be undone.
    Both arrays are empty when no move is in progress.
    */
    Array<Item3D> moveEditItems
    Array<Vector3> moveEditStartPositions

    /*
    "Highlight" drawables used to show which items have been filtered.
    */
    Array<SelectionHighlight> filterHighlights

    /*
    Tracks how many times each name has been used from the palette.
    Used to add numbers to the end of the names of duplicate items.
    */
    HashTable<text, integer> nameCounts

    // Used for when a movement key is held and the grid lock is enabled.
    number gridMoveTimer = 0
    number gridMoveTimerMax = 0.5

    // A reference to the property dialogs for this controller.
    Item3DPropertiesDialog item3dPropertiesDialog
    Item2DPropertiesDialog item2dPropertiesDialog
    Camera2DPropertiesDialog camera2dPropertiesDialog
    Camera3DPropertiesDialog camera3dPropertiesDialog
    PointLightPropertiesDialog pointLightPropertiesDialog
    Audio3DPropertiesDialog audio3DPropertiesDialog

    // An array containing the different property dialogs.
    Array<PropertiesDialog> propertiesDialogs

    // A reference to the find dialog for this controller.
    SceneEditorFindDialog findDialog

    // Used to forcibly change the focus and send information via the screen reader.
    Item2D dummyItem


    on create
        FlowLayout layout
        SetLayout(layout)
        SetPercentageWidth(1.0)
        SetPercentageHeight(1.0)
        
        LabelBoxView view
        view:Initialize(color:CustomColor(0.9, 0.9, 0.925, 1), color:CustomColor(0.9, 0.9, 0.925, 1))
        SetView2D(view)

        SetInputGroup("SceneEditor")
        SetName("Scene Editor TEST")
        SetFocusable(true)
        SetAccessibilityCode(parent:Item:CUSTOM)

        accessibility = manager:GetAccessibility()

        selection:Initialize(me)
        findDialog:Initialize(me)

        propertiesDialogs:Add(item2dPropertiesDialog)
        propertiesDialogs:Add(item3dPropertiesDialog)
        propertiesDialogs:Add(camera2dPropertiesDialog)
        propertiesDialogs:Add(camera3dPropertiesDialog)
        propertiesDialogs:Add(pointLightPropertiesDialog)
        propertiesDialogs:Add(audio3DPropertiesDialog)

        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Initialize(me)
            counter = counter + 1
        end
    end

    action GetFile returns File
        return file
    end

    action SetFile(File file)
        me:file = file
    end

    action GetProjectLocation returns File
        return projectLocation
    end

    action SetProjectLocation(File file)
        me:projectLocation = file
    end

    /*
    This action returns the relative path to reach the provided file
    from the project location associated with this tab.
    */
    action GetProjectPathToFile(File file) returns text
        text projectPath = projectLocation:GetAbsolutePath()
        text goalPath = file:GetAbsolutePath()

        Array<text> start = undefined
        Array<text> goal = undefined
        // The "Contains" action can correctly test for backslashes, but the "Split" command requires the escape character "\\", or it crashes
        if projectPath:Contains("\")
            start = projectPath:Split("\\")
            goal = goalPath:Split("\\")
        else
            start = projectPath:Split("/")
            goal = goalPath:Split("/")
        end

        /*
        Steps:
        1. Remove all common elements between the two paths
        2. For each element remaining in the source, prepend "../"
        3. For each element remaining in the goal, append it to the end
        */

        text result = ""
        boolean taskDone = false
        repeat until start:IsEmpty() or goal:IsEmpty() or taskDone
            text chunk1 = start:GetFromFront()
            text chunk2 = goal:GetFromFront()

            if chunk1 = chunk2
                start:RemoveFromFront()
                goal:RemoveFromFront()
            else
                taskDone = true
            end
        end

        repeat start:GetSize() times
            result = result + "../"
        end

        repeat until goal:IsEmpty()
            result = result + goal:RemoveFromFront()
            if goal:IsEmpty() = false
                result = result + "/"
            end
        end

        return result
    end

    action Load
        Scene scene
        scene:Load(file)
        SetName(file:GetPath())
        Load(scene)
    end

    /*
    This action returns the description of the item currently focused by the cursor on
    the current layer. If there is no item at the cursor this action returns the position
    of the cursor. If there are multiple items this action will return the names of each item
    at the current cursor position.

    Attribute: Returns The affine as the identy matrix

    */
    action GetDescription returns text
        if GetSelectedLayer() not= undefined
            EditorCursor cursor = GetSelectedLayer():GetCursor()
            text position = ""

            if cursor is EditorCursor2D
                EditorCursor2D cursor2D = cast(EditorCursor2D, cursor)
                position = cast(integer, cursor2D:GetX()) + " " + cast(integer, cursor2D:GetY())
            elseif cursor is EditorCursor3D
                EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
                position = cast(integer, cursor3D:GetX()) + " " + cast(integer, cursor3D:GetY()) + " " + cast(integer, cursor3D:GetZ())
            end

            Array<Item> items = cursor:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return names + position + ", press Enter to select items"
            else
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > items:GetSize() - 3
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return names + items:GetSize() + " items, " + position + ", press Enter to select items"
            end
        end

        return parent:Item:GetDescription()
    end


    /*
    This action is called automatically by the system. This resize adjusts the size of the
    viewports, camera, and grid.
    */
    action Resize
        parent:Control:Resize()

        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer layer = layers:Get(counter)
            layer:SetViewport(cast(integer, GetGlobalX()), cast(integer, GetGlobalY()), cast(integer, GetWidth()), cast(integer, GetHeight()))
            Camera camera = layer:GetCamera()
            camera:SetSize(GetWidth(), GetHeight())
            counter = counter + 1

            if layer is EditorLayer2D
                EditorLayer2D layer2D = cast(EditorLayer2D, layer)
                layer2D:UpdateGridSize()
            end
        end
    end


    /*
        This action takes every dialog added to this Scene Editor and hides all of them.
    */
    action HideDialogs
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Hide()
            counter = counter + 1
        end
    end

    action GetEditorTag returns text
        return constants:EDITOR_TAG
    end

    action GetSceneConstants returns SceneConstants
        return constants
    end

    action SetProperties3DDialog(Item3DPropertiesDialog dialog)
        item3dPropertiesDialog = dialog
    end

    action GetProperties3DDialog returns Item3DPropertiesDialog
        return item3dPropertiesDialog
    end

    action SetProperties2DDialog(Item2DPropertiesDialog dialog)
        item2dPropertiesDialog = dialog
    end

    action SetCameraProperties2DDialog(Camera2DPropertiesDialog dialog)
        camera2dPropertiesDialog = dialog
    end

    action GetCameraProperties2DDialog returns Camera2DPropertiesDialog
        return camera2dPropertiesDialog
    end

    action SetCameraProperties3DDialog(Camera3DPropertiesDialog dialog)
        camera3dPropertiesDialog = dialog
    end

    action GetCameraProperties3DDialog returns Camera3DPropertiesDialog
        return camera3dPropertiesDialog
    end

    action GetProperties2DDialog returns Item2DPropertiesDialog
        return item2dPropertiesDialog
    end

    action GetPointLightPropertiesDialog returns PointLightPropertiesDialog
        return pointLightPropertiesDialog
    end

    action SetPointLightPropertiesDialog(PointLightPropertiesDialog pointLightPropertiesDialog)
        me:pointLightPropertiesDialog = pointLightPropertiesDialog
    end

    action FocusItemProperties
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:FocusField()
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateActivePropertiesDialog(EditorItem item)
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:SetFields(item)
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateEditorCameraTarget
        Item item = GetSelectedItem()
        EditorLayer layer = GetSelectedLayer()
        if item is Item2D or layer is EditorLayer2D
            // We currently only support this feature for 3D.
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)

        if item = undefined and IsFocused()
            item = layer3D:GetCursor()
        end
        
        layer3D:GetEditorCamera():SetTarget(cast(Item3D, item))
    end

    action UpdateEditorCameraPosition
        if GetSelectedLayer() is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            layer:GetEditorCamera():UpdateCameraPosition()
        else
            // Do nothing -- we currently don't support this for 2D
        end
    end

    action GetFindDialog returns SceneEditorFindDialog
        return findDialog
    end

    action GetEditManager returns SceneEditorEditManager
        return editManager
    end

    action IsFocused returns boolean
        // Although we can get the focus directly from the manager, we request
        // it from the Game instead. This allows the Game to do any necessary
        // additional book-keeping.
        return parent:Item:IsFocused() or (dummyItem not= undefined and dummyItem:IsFocused())
    end

action Update(number seconds)
        if pendingAnnouncement not= ""
            pendingAnnouncementDelay = pendingAnnouncementDelay - seconds
            if pendingAnnouncementDelay <= 0
                Item focused = manager:GetFocus()
                if focused = undefined
                    focused = me
                end
                NotifyAccessibility(focused, pendingAnnouncement)
                pendingAnnouncement = ""
            end
        end

        if layers:IsEmpty() or GetSelectedLayer() = undefined
            return now
        end

        if inCameraPerspective and (perspectivePanX not= 0 or perspectivePanZ not= 0)
            PanCameraPerspective(seconds)
        end

        if inCameraPerspective and perspectiveZoom not= 0
            ZoomCameraPerspective(seconds)
        end

        Camera camera = GetSelectedLayer():GetCamera()
        boolean moved = false
        boolean isCursor = false
        Item movedItem = undefined

        if GetSelectedLayer() is EditorLayer3D

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())

            if (yawDirection not= 0 or pitchDirection not= 0 or rollDirection not= 0)
                number yaw = layer:GetCameraYaw() + (yawDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                number pitch = layer:GetCameraPitch() + (pitchDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                if pitch > 90.0
                    pitch = 90.0
                elseif pitch < -90.0
                    pitch = -90.0
                end
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                
//                layer:SetCameraYawPitchRoll(yaw, pitch, roll)
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
//                camera:Move(workVector3:Scale(strafeDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds))
            end
    
            if verticalDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(verticalDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem3D
                moved = false
                workVector3:Set(0, 0, 0)

                EditorItem3D focus = undefined

                if IsFocused()
                    isCursor = true
                    focus = cast(EditorItem3D, cast(Object, layer:GetCursor()))
                else
                    focus = cast(EditorItem3D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                if gridSnapEnabled = false
                    if selectionXDirection not= 0
                        workVector3:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector3:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if selectionZDirection not= 0
                        workVector3:SetZ(selectionZDirection * -SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if moved
                        BeginMoveEdit(focus)
                        focus:Move(workVector3)
                        MoveOtherSelectedItems(focus, workVector3:GetX(), workVector3:GetY(), workVector3:GetZ())
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0 or selectionZDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax

                            if focus is CameraItem3D
                                CameraItem3D cameraItem = cast(CameraItem3D, focus)
                                if selectionXDirection not= 0
                                    cameraItem:SetYaw(cameraItem:GetYaw() + selectionXDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionYDirection not= 0
                                    cameraItem:SetPitch(cameraItem:GetPitch() + selectionYDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionZDirection not= 0
                                    cameraItem:SetDistance(cameraItem:GetDistance() - selectionZDirection * CAMERA_DIRECTIONAL_SPEED_3D)
                                end
                            else
                                moved = true
                                number x = focus:GetGlobalX()
                                number y = focus:GetGlobalY()
                                number z = focus:GetGlobalZ()
        
                                if selectionXDirection < 0
                                    x = layer:GetPreviousGridCoordinate(x)
                                elseif selectionXDirection > 0
                                    x = layer:GetNextGridCoordinate(x)
                                end
        
                                if selectionYDirection < 0
                                    y = layer:GetPreviousGridCoordinate(y)
                                elseif selectionYDirection > 0
                                    y = layer:GetNextGridCoordinate(y)
                                end
        
                                if selectionZDirection < 0
                                    z = layer:GetPreviousGridCoordinate(z)
                                elseif selectionZDirection > 0
                                    z = layer:GetNextGridCoordinate(z)
                                end
        
                                number deltaX = x - focus:GetGlobalX()
                                number deltaY = y - focus:GetGlobalY()
                                number deltaZ = z - focus:GetGlobalZ()
                                BeginMoveEdit(focus)
                                focus:Move(deltaX, deltaY, deltaZ)
                                MoveOtherSelectedItems(focus, deltaX, deltaY, deltaZ)
                                Grid3D grid = layer:GetGrid()
                                grid:SetPosition(grid:GetNearestGridCoordinate(focus:GetGlobalX()),
                                    0,
                                    grid:GetNearestGridCoordinate(focus:GetGlobalZ()))
                            end
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = focus
                end

                if IsSelectionRotating()
                    workVector3:Set(focus:GetYaw(), focus:GetPitch(), focus:GetRoll())
                    workVector3:Add(seconds * selectionYawDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionPitchDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_3D)
                    focus:SetRotation(workVector3)
                    RotateOtherSelectedItems3D(focus, seconds * selectionYawDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionPitchDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_3D)
                end
            end

        elseif GetSelectedLayer() is EditorLayer2D
            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if (rollDirection not= 0)
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_2D * seconds)
                layer:SetCameraRoll(roll)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
                camera:Move(workVector3:Scale(-strafeDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds))
                moved = true
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds)
                camera:Move(workVector3)
                moved = true
            end

            if moved
                layer:UpdateGridPosition()
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem2D
                moved = false
                workVector2:Set(0, 0)

                Item2D target = undefined
                
                if IsFocused()
                    isCursor = true
                    target = cast(Item2D, cast(Object, layer:GetCursor()))
                else
                    target = cast(Item2D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                if gridSnapEnabled = false
                    if selectionXDirection not= 0
                        workVector2:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector2:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if moved
                        target:Move(workVector2)
                        MoveOtherSelectedItems2D(target, workVector2:GetX(), workVector2:GetY())
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax
    
                            number x = target:GetGlobalX()
                            number y = target:GetGlobalY()
    
                            if selectionXDirection < 0
                                x = layer:GetPreviousGridCoordinate(x)
                            elseif selectionXDirection > 0
                                x = layer:GetNextGridCoordinate(x)
                            end
    
                            if selectionYDirection < 0
                                y = layer:GetPreviousGridCoordinate(y)
                            elseif selectionYDirection > 0
                                y = layer:GetNextGridCoordinate(y)
                            end
    
                            number deltaX2D = x - target:GetGlobalX()
                            number deltaY2D = y - target:GetGlobalY()
                            target:Move(deltaX2D, deltaY2D)
                            MoveOtherSelectedItems2D(target, deltaX2D, deltaY2D)
                            moved = true
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = target
                end

                if GetSelectionRollDirection() not= 0 and isCursor = false
                    number angle = target:GetRotation()
                    angle = angle + (seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_2D)
                    target:SetRotation(angle)
                    RotateOtherSelectedItems2D(target, seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_2D)
                end
            end
        end

        if moved
            if movedItem not= undefined and movedItem is EditorItem
                UpdateActivePropertiesDialog(cast(EditorItem, movedItem))
                UpdateEditorCameraPosition()
            end

            if isCursor
                if accessibility not= undefined
                    Item2D newDummy
                    text describe = GetDescription()
                    newDummy:SetProperty(constants:EDITOR_TAG, undefined)
                    newDummy:SetFocusable(true)
                    newDummy:SetAccessibilityCode(dummyItem:parent:Item:ITEM)
                    newDummy:SetName(describe)
                    newDummy:SetInputGroup("PassthroughInput")
    
                    Add(newDummy)
                    if dummyItem not= undefined
                        Remove(dummyItem)
                    end
                    dummyItem = newDummy
                    newDummy:Focus()
                end
            end
        end
    end

    /*
    This action moves every selected 3D item other than the focused one by the same amount the
    focused one moved, so a group of selected items moves together and keeps its layout. Nothing
    happens if the focused item is not one of the selection highlights, such as the cursor.
    */
    /*
    This action returns the selection highlights other than the focused one, when the focused item
    is part of the selection. Otherwise, such as when the cursor has focus, it returns an empty array.
    It is used so that rotating and scaling the focused item also applies to the rest of a group.
    */
    private action GetOtherSelectedHighlights(Item focus) returns Array<SelectionHighlight>
        Array<SelectionHighlight> others
        if focus = undefined or not (focus is SelectionHighlight)
            return others
        end

        SelectionHighlight focusHighlight = cast(SelectionHighlight, focus)
        if GetSelectionHighlight(focusHighlight:GetItem()) = undefined
            return others
        end

        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            if highlight not= focusHighlight
                others:Add(highlight)
            end
            counter = counter + 1
        end
        return others
    end

    /*
    This action rotates every other selected 3D item by the same amounts as the focused one. Each
    item turns around its own center.
    */
    private action RotateOtherSelectedItems3D(Item focus, number yaw, number pitch, number roll)
        Array<SelectionHighlight> others = GetOtherSelectedHighlights(focus)
        integer counter = 0
        repeat while counter < others:GetSize()
            if others:Get(counter) is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, others:Get(counter))
                highlight3D:SetRotation(highlight3D:GetYaw() + yaw, highlight3D:GetPitch() + pitch, highlight3D:GetRoll() + roll)
            end
            counter = counter + 1
        end
    end

    /*
    This action rotates every other selected 2D item by the same angle as the focused one. Each
    item turns around its own center.
    */
    private action RotateOtherSelectedItems2D(Item focus, number angle)
        Array<SelectionHighlight> others = GetOtherSelectedHighlights(focus)
        integer counter = 0
        repeat while counter < others:GetSize()
            if others:Get(counter) is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, others:Get(counter))
                highlight2D:SetRotation(highlight2D:GetRotation() + angle)
            end
            counter = counter + 1
        end
    end

    /*
    This action scales every other selected item by the same amounts as the focused one, which has
    already been scaled. 2D items use only the X and Y amounts. It is used by the scale shortcuts.
    */
    action ScaleOtherSelectedItems(Item focus, number x, number y, number z)
        Array<SelectionHighlight> others = GetOtherSelectedHighlights(focus)
        integer counter = 0
        repeat while counter < others:GetSize()
            if others:Get(counter) is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, others:Get(counter))
                Vector3 amount
                amount:Set(x, y, z)
                highlight3D:Scale(amount)
            elseif others:Get(counter) is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, others:Get(counter))
                highlight2D:Scale(x, y)
            end
            counter = counter + 1
        end
    end

    /*
    This action resets the scale of every other selected item, after the focused one has been reset.
    */
    action ResetScaleOfOtherSelectedItems(Item focus)
        Array<SelectionHighlight> others = GetOtherSelectedHighlights(focus)
        integer counter = 0
        repeat while counter < others:GetSize()
            others:Get(counter):ResetScale()
            counter = counter + 1
        end
    end

    /*
    This action deselects every selected item, including a selection still being built with
    Shift+Enter. If moveFocus is true, focus moves to the scene editor. It is used by Escape.
    */
    action ClearSelection(boolean moveFocus)
        boolean hadSelection = filteredItems not= undefined and filteredItems:IsEmpty() = false
        Array<Item> empty
        SetFilteredItems(empty, moveFocus)
        if hadSelection
            AnnounceAfterFocus("Selection cleared")
        end
    end

    /*
    This action moves every other selected 2D item by the same amount as the focused one, so a
    group selection moves together with the arrow keys. Nothing happens if the focused item is
    not one of the selection highlights, such as the cursor.
    */
    private action MoveOtherSelectedItems2D(Item2D focus, number x, number y)
        if not (focus is SelectionHighlight2D)
            return now
        end

        SelectionHighlight2D focusHighlight = cast(SelectionHighlight2D, focus)
        if GetSelectionHighlight(focusHighlight:GetItem()) = undefined
            return now
        end

        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            if highlight is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                if highlight2D not= focusHighlight
                    highlight2D:Move(x, y)
                end
            end
            counter = counter + 1
        end
    end

    private action MoveOtherSelectedItems(EditorItem3D focus, number x, number y, number z)
        if not (focus is SelectionHighlight3D)
            return now
        end

        SelectionHighlight3D focusHighlight = cast(SelectionHighlight3D, focus)
        if GetSelectionHighlight(focusHighlight:GetItem()) = undefined
            return now
        end

        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                if highlight3D not= focusHighlight
                    highlight3D:Move(x, y, z)
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action is called when the mouse is pressed on a 3D item, with the ray that was used to
    find it. The item is selected and grabbed so it can be dragged. If the item is already part of
    a group selection, the group stays selected and the item is focused, so the group can be dragged.
    The drag starts along the ground. If Alt is held while dragging, ContinueMouseDrag anchors it
    again for moving up and down.
    */
    action BeginMouseDrag(Item3D item, Ray ray)
        CancelMouseDrag()

        SelectionHighlight highlight = GetSelectionHighlight(item)
        if highlight not= undefined and filteredItems:GetSize() > 1
            highlight:Focus()
            mouseDragCollapseItem = item
        else
            Array<Item> items
            items:Add(item)
            SetFilteredItems(items, true)
        end

        mouseDragItem = item
        AnchorMouseDrag(ray, false)
    end

    /*
    This action moves the grabbed item, and every other selected item with it, to follow the mouse.
    Normally items move along a flat plane at the grabbed item's height, so their X and Z positions
    change but not their height. If vertical is true, items move only up and down instead. If grid
    snapping is on, the grabbed item snaps to the grid.
    */
    action ContinueMouseDrag(MouseEvent mouse, boolean vertical)
        if mouseDragItem = undefined or GetSelectedLayer() is EditorLayer3D = false
            return now
        end

        SelectionHighlight highlight = GetSelectionHighlight(mouseDragItem)
        if highlight = undefined or not (highlight is SelectionHighlight3D)
            return now
        end
        SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)

        EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        Ray ray = camera:GetPickRay(mouse:GetX(), mouse:GetY(), GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())

        // When Alt is pressed or released during a drag, start measuring from the mouse again so nothing jumps.
        if mouseDragAnchored = false or vertical not= mouseDragVertical
            AnchorMouseDrag(ray, vertical)
            return now
        end

        number deltaX = 0
        number deltaY = 0
        number deltaZ = 0

        if vertical
            Vector3 point = GetVerticalMouseDragPoint(ray)
            if point = undefined
                return now
            end

            number targetY = point:GetY() + mouseDragOffsetY
            if IsGridSnapping()
                targetY = layer:GetNearestGridCoordinate(targetY)
            end
            deltaY = targetY - mouseDragItem:GetGlobalY()
        else
            Vector3 point = GetMouseDragPoint(ray, mouseDragItem:GetGlobalY())
            if point = undefined
                return now
            end

            number targetX = point:GetX() + mouseDragOffsetX
            number targetZ = point:GetZ() + mouseDragOffsetZ
            if IsGridSnapping()
                targetX = layer:GetNearestGridCoordinate(targetX)
                targetZ = layer:GetNearestGridCoordinate(targetZ)
            end
            deltaX = targetX - mouseDragItem:GetGlobalX()
            deltaZ = targetZ - mouseDragItem:GetGlobalZ()
        end

        if deltaX = 0 and deltaY = 0 and deltaZ = 0
            return now
        end

        // Once the group has been dragged, releasing the mouse should keep the whole group selected.
        mouseDragCollapseItem = undefined

        BeginMoveEdit(highlight3D)
        highlight3D:Move(deltaX, deltaY, deltaZ)
        MoveOtherSelectedItems(highlight3D, deltaX, deltaY, deltaZ)

        if IsGridSnapping() and vertical = false
            Grid3D grid = layer:GetGrid()
            grid:SetPosition(grid:GetNearestGridCoordinate(highlight3D:GetGlobalX()), 0, grid:GetNearestGridCoordinate(highlight3D:GetGlobalZ()))
        end

        UpdateActivePropertiesDialog(highlight3D)
    end

    /*
    This action records where the mouse is relative to the grabbed item, for either kind of drag,
    so later mouse movement moves the item by the same amount the mouse moves. If the mouse ray
    does not cross the plane the drag uses, the drag stays unanchored and tries again on the next
    mouse movement.
    */
    private action AnchorMouseDrag(Ray ray, boolean vertical)
        mouseDragVertical = vertical
        mouseDragAnchored = false
        if mouseDragItem = undefined
            return now
        end

        if vertical
            // Face the plane toward the camera, along the ground, so it stays upright.
            Vector3 direction = ray:GetDirection()
            number length = math:SquareRoot(direction:GetX() * direction:GetX() + direction:GetZ() * direction:GetZ())
            if length < 0.0001
                return now
            end
            mouseDragNormalX = direction:GetX() / length
            mouseDragNormalZ = direction:GetZ() / length

            Vector3 point = GetVerticalMouseDragPoint(ray)
            if point = undefined
                return now
            end
            mouseDragOffsetY = mouseDragItem:GetGlobalY() - point:GetY()
        else
            Vector3 point = GetMouseDragPoint(ray, mouseDragItem:GetGlobalY())
            if point = undefined
                return now
            end
            mouseDragOffsetX = mouseDragItem:GetGlobalX() - point:GetX()
            mouseDragOffsetZ = mouseDragItem:GetGlobalZ() - point:GetZ()
        end

        mouseDragAnchored = true
    end

    /*
    This action returns where the ray crosses the upright plane through the grabbed item that is
    used for up and down dragging, or undefined if the ray runs alongside the plane or points away from it.
    */
    private action GetVerticalMouseDragPoint(Ray ray) returns Vector3
        Vector3 origin = ray:GetOrigin()
        Vector3 direction = ray:GetDirection()
        number facing = direction:GetX() * mouseDragNormalX + direction:GetZ() * mouseDragNormalZ
        if math:AbsoluteValue(facing) < 0.0001
            return undefined
        end

        number toItem = (mouseDragItem:GetGlobalX() - origin:GetX()) * mouseDragNormalX + (mouseDragItem:GetGlobalZ() - origin:GetZ()) * mouseDragNormalZ
        number distance = toItem / facing
        if distance < 0
            return undefined
        end

        Vector3 point
        point:Set(origin:GetX() + direction:GetX() * distance, origin:GetY() + direction:GetY() * distance, origin:GetZ() + direction:GetZ() * distance)
        return point
    end

    /*
    This action is called when the mouse is released. If the mouse was pressed on an item in a
    group selection and not dragged, only that item stays selected.
    */
    action FinishMouseDrag
        Item3D collapseItem = mouseDragCollapseItem
        CancelMouseDrag()

        if collapseItem not= undefined
            Array<Item> items
            items:Add(collapseItem)
            SetFilteredItems(items, true)
        end
    end

    /*
    This action stops any mouse drag without changing the selection.
    */
    action CancelMouseDrag
        mouseDragItem = undefined
        mouseDragCollapseItem = undefined
        mouseDragAnchored = false

        // Any movement that already happened during the drag is kept, so it is recorded for undo.
        FinishMoveEdit()
    end

    /*
    This action is called just before the selected 3D items move. If no move is in progress, it
    remembers where each selected item is, so the move can be undone once it finishes. If a move
    is already in progress, nothing changes, so a held key or a mouse drag is recorded as one move.
    Nothing happens if the focused item is not one of the selection highlights, such as the cursor.
    */
    private action BeginMoveEdit(EditorItem3D focus)
        if moveEditItems:IsEmpty() = false or not (focus is SelectionHighlight3D)
            return now
        end

        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            if highlight is SelectionHighlight3D and highlight:GetItem() is Item3D
                Item3D item = cast(Item3D, highlight:GetItem())
                Vector3 start
                start:Set(item:GetX(), item:GetY(), item:GetZ())
                moveEditItems:Add(item)
                moveEditStartPositions:Add(start)
            end
            counter = counter + 1
        end
    end

    /*
    This action ends the move in progress, if there is one, and records it as a single edit so it
    can be undone. If none of the items ended up somewhere new, nothing is recorded.
    */
    private action FinishMoveEdit
        if moveEditItems:IsEmpty()
            return now
        end

        Array<Item3D> items = moveEditItems
        Array<Vector3> startPositions = moveEditStartPositions
        Array<Item3D> newItems
        Array<Vector3> newStartPositions
        moveEditItems = newItems
        moveEditStartPositions = newStartPositions

        Array<Vector3> endPositions
        boolean changed = false
        integer counter = 0
        repeat while counter < items:GetSize()
            Item3D item = items:Get(counter)
            Vector3 start = startPositions:Get(counter)
            Vector3 finish
            finish:Set(item:GetX(), item:GetY(), item:GetZ())
            endPositions:Add(finish)
            if start:GetX() not= finish:GetX() or start:GetY() not= finish:GetY() or start:GetZ() not= finish:GetZ()
                changed = true
            end
            counter = counter + 1
        end

        if changed
            SceneEditorMoveEdit edit
            edit:Create(me, items, startPositions, endPositions)
            editManager:Add(edit)
        end
    end

    /*
    This action finishes a keyboard move once every movement key has been released, so holding
    keys in more than one direction is still recorded as one move. A mouse drag in progress is
    left alone, since it finishes when the mouse is released.
    */
    private action FinishKeyboardMoveEdit
        if selectionXDirection = 0 and selectionYDirection = 0 and selectionZDirection = 0 and mouseDragItem = undefined
            FinishMoveEdit()
        end
    end

    /*
    This action moves a 3D item so its position is the given values. If the item is selected,
    its selection highlight moves with it. This is used to undo and redo moves.
    */
    action MoveItemTo(Item3D item, number x, number y, number z)
        number deltaX = x - item:GetX()
        number deltaY = y - item:GetY()
        number deltaZ = z - item:GetZ()

        SelectionHighlight highlight = GetSelectionHighlight(item)
        if highlight is SelectionHighlight3D
            SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
            highlight3D:Move(deltaX, deltaY, deltaZ)
            UpdateActivePropertiesDialog(highlight3D)
        else
            item:Move(deltaX, deltaY, deltaZ)
        end
    end

    /*
    This action returns where the ray crosses the flat plane at the given height, or undefined if
    the ray runs alongside the plane or points away from it.
    */
    private action GetMouseDragPoint(Ray ray, number height) returns Vector3
        Vector3 origin = ray:GetOrigin()
        Vector3 direction = ray:GetDirection()
        if math:AbsoluteValue(direction:GetY()) < 0.0001
            return undefined
        end

        number distance = (height - origin:GetY()) / direction:GetY()
        if distance < 0
            return undefined
        end

        Vector3 point
        point:Set(origin:GetX() + direction:GetX() * distance, height, origin:GetZ() + direction:GetZ() * distance)
        return point
    end

    action SetFilteredItems(Array<Item> items, boolean moveFocus)
        keyboardSelectionPending = false
        filteredItems = items

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            elseif highlight is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        // Display selection highlighting around the items.
        
        EditorLayer currentLayer = GetSelectedLayer()

        if currentLayer is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item3D item = cast(Item3D, filteredItems:Get(counter))
                SelectionHighlight3D highlight = undefined
                if item is EditorPointLight
                    PointLightSelectionHighlight light
                    highlight = light
                elseif item is EditorAudio3D
                    Audio3DSelectionHighlight light
                    highlight = light
                else
                    ModelSelectionHighlight model
                    highlight = model
                end
                highlight:Load(cast(EditorModel, item), me)
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        else
            EditorLayer2D layer = cast(EditorLayer2D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item2D item = cast(Item2D, filteredItems:Get(counter))
                SelectionHighlight2D highlight
                highlight:Load(item, me)
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        end

        SetFilterHighlightData()

        if moveFocus
            if filterHighlights:IsEmpty()
                Focus()
            else
                filterHighlights:Get(0):Focus()
            end
        else
            if filterHighlights:IsEmpty()
                SetSelectedItem(undefined)
            else
                SetSelectedItem(filterHighlights:Get(0))
            end
        end
    end

    /*
    This action returns the items that are currently selected, or undefined if nothing is selected.
    */
    action GetFilteredItems returns Array<Item>
        return filteredItems
    end

    /*
    This action adds an item to the current selection, or removes it if it is already selected.
    The other selected items stay selected. If the item was added, focus moves to its highlight.
    */
    action ToggleFilteredItem(Item item)
        Array<Item> items
        boolean found = false
        if filteredItems not= undefined
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item current = filteredItems:Get(counter)
                if current = item
                    found = true
                else
                    items:Add(current)
                end
                counter = counter + 1
            end
        end

        if not found
            items:Add(item)
        end

        SetFilteredItems(items, true)

        if not found
            SelectionHighlight highlight = GetSelectionHighlight(item)
            if highlight not= undefined
                highlight:Focus()
            end
        end
    end

    /*
    This action adds the given items to the current selection, keeping the items that are already
    selected. Items that are already selected stay selected; this never removes anything. Focus is
    not moved, so the cursor keeps focus and more items can be added from other places in the
    scene. Pressing Enter afterward confirms the selection and moves focus to it, so the selected
    items can be moved with the keyboard. It is used by Shift+Enter on the cursor, and the change
    is announced to screen readers.
    */
    action AddSelectedItems(Array<Item> items)
        if items = undefined or items:IsEmpty()
            AnnounceToFocusedItem("There is nothing at the cursor to select")
            return now
        end

        Array<Item> result
        // A selection left over from a layer of the other kind (2D or 3D) is dropped rather than mixed in.
        boolean sameKind = true
        if filteredItems not= undefined and filteredItems:IsEmpty() = false
            sameKind = (filteredItems:Get(0) is Item3D) = (items:Get(0) is Item3D)
        end
        if filteredItems not= undefined and sameKind
            integer index = 0
            repeat while index < filteredItems:GetSize()
                result:Add(filteredItems:Get(index))
                index = index + 1
            end
        end

        integer added = 0
        text addedName = ""
        integer counter = 0
        repeat while counter < items:GetSize()
            if ContainsItem(result, items:Get(counter)) = false
                result:Add(items:Get(counter))
                addedName = items:Get(counter):GetName()
                added = added + 1
            end
            counter = counter + 1
        end

        boolean wasPending = keyboardSelectionPending
        // Changing the editor's selected item moves the cursor onto that item, so the cursor's
        // position is saved here and put back afterward. The cursor stays where the user left it.
        Item cursorItem = cast(Item, cast(Object, GetCursor()))
        number cursorX = 0
        number cursorY = 0
        number cursorZ = 0
        if cursorItem is Item3D
            Item3D cursor3D = cast(Item3D, cursorItem)
            cursorX = cursor3D:GetX()
            cursorY = cursor3D:GetY()
            cursorZ = cursor3D:GetZ()
        elseif cursorItem is Item2D
            Item2D cursor2D = cast(Item2D, cursorItem)
            cursorX = cursor2D:GetX()
            cursorY = cursor2D:GetY()
        end

        if added > 0
            SetFilteredItems(result, false)
        end
        // Focus stays on the cursor until Enter confirms the selection. The editor's selected item
        // is cleared as well: while an item is the selected item, the editor hides the cube cursor
        // and points the camera at that item, which would look like focus had left the cursor.
        SetSelectedItem(undefined)

        if cursorItem is Item3D
            Item3D restore3D = cast(Item3D, cursorItem)
            restore3D:SetPosition(cursorX, cursorY, cursorZ)
        elseif cursorItem is Item2D
            Item2D restore2D = cast(Item2D, cursorItem)
            restore2D:SetPosition(cursorX, cursorY)
        end
        UpdateEditorCameraTarget()
        keyboardSelectionPending = true

        text hint = ""
        if wasPending = false
            hint = ". Press Enter to confirm"
        end
        if added = 0
            if items:GetSize() = 1
                AnnounceToFocusedItem(items:Get(0):GetName() + " is already selected, " + GetSelectedCountText(result:GetSize()) + hint)
            else
                AnnounceToFocusedItem("Already selected, " + GetSelectedCountText(result:GetSize()) + hint)
            end
        elseif added = 1
            AnnounceToFocusedItem("Selected " + addedName + ", " + GetSelectedCountText(result:GetSize()) + hint)
        else
            AnnounceToFocusedItem("Selected " + added + " items, " + GetSelectedCountText(result:GetSize()) + hint)
        end
    end

    /*
    This action returns true while a selection is being built from the keyboard with Shift+Enter
    and has not been confirmed with Enter yet.
    */
    action IsKeyboardSelectionPending returns boolean
        return keyboardSelectionPending
    end

    /*
    This action confirms a selection built with Shift+Enter. Every selected item stays selected and
    focus moves from the cursor to the first one, so the arrow keys move all of the selected items
    together and Tab moves through them. It is used by Enter on the cursor.
    */
    action ConfirmKeyboardSelection
        keyboardSelectionPending = false
        if filterHighlights:IsEmpty()
            return now
        end
        SetSelectedItem(filterHighlights:Get(0))
        filterHighlights:Get(0):Focus()
        UpdateEditorCameraTarget()
        AnnounceAfterFocus("Selection confirmed, " + GetSelectedCountText(filterHighlights:GetSize()))
    end

    /*
    This action selects every item in the selected layer and moves focus to the first one, so the
    items can be moved through with Tab like any other selection. It is used by Ctrl+A.
    */
    action SelectAllItems
        EditorLayer layer = GetSelectedLayer()
        SceneConstants constants
        Array<Item> items
        if layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Iterator<Item3D> iterator3D = layer3D:GetIterator()
            repeat while iterator3D:HasNext()
                Item3D item3D = iterator3D:Next()
                if item3D:HasProperty(constants:EDITOR_TAG) = false
                    items:Add(item3D)
                end
            end
        elseif layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Iterator<Item2D> iterator2D = layer2D:GetIterator()
            repeat while iterator2D:HasNext()
                Item2D item2D = iterator2D:Next()
                if item2D:HasProperty(constants:EDITOR_TAG) = false
                    items:Add(item2D)
                end
            end
        end

        if items:IsEmpty()
            AnnounceToFocusedItem("There are no items to select")
            return now
        end

        SetFilteredItems(items, true)
        AnnounceAfterFocus("Selected all, " + GetSelectedCountText(items:GetSize()))
    end

    /*
    This action returns true if the exact item is in the array.
    */
    private action ContainsItem(Array<Item> items, Item item) returns boolean
        integer counter = 0
        repeat while counter < items:GetSize()
            if items:Get(counter) = item
                return true
            end
            counter = counter + 1
        end
        return false
    end

    /*
    This action returns text such as "1 item selected" or "3 items selected".
    */
    private action GetSelectedCountText(integer count) returns text
        if count = 1
            return "1 item selected"
        end
        return count + " items selected"
    end

    private action EmptyFilteredItems(boolean moveFocus)
        filteredItems = undefined

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            else
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        SetFilterHighlightData()

        if moveFocus
            Focus()
        else
            SetSelectedItem(undefined)
        end
    end

    private action SetFilterHighlightData
        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            Item item = highlight:GetItem()

            if counter = 0
                highlight:SetPreviousFocus(filterHighlights:GetFromEnd())
            else
                highlight:SetPreviousFocus(filterHighlights:Get(counter - 1))
            end

            if counter = filterHighlights:GetSize() - 1
                highlight:SetNextFocus(filterHighlights:GetFromFront())
            else
                highlight:SetNextFocus(filterHighlights:Get(counter + 1))
            end 

            number x = math:Round(item:GetGlobalX(), 2)
            number y = math:Round(item:GetGlobalY(), 2)
            number z = math:Round(item:GetGlobalZ(), 2)

            highlight:SetName(item:GetName())
            highlight:SetDescription((counter + 1) + " of " + filterHighlights:GetSize() + ": " + x + ", " + y + ", " + z)
            counter = counter + 1
        end

        if filterHighlights:IsEmpty() = false
            SetPreviousFocus(filterHighlights:Get(filterHighlights:GetSize() - 1))
            SetNextFocus(filterHighlights:Get(0))
        else
            SetPreviousFocus(undefined)
            SetNextFocus(undefined)
        end
    end

    // Removes the item that is selected by the given highlight, along with the highlight itself.
    action Delete(SelectionHighlight highlight)
        Item nextFocus = undefined

        if highlight:IsFocused()
            // If we're deleting the focused item, move the focus.
            if highlight:GetPreviousFocus() not= undefined and (highlight:GetPreviousFocus():Equals(highlight) = false)
                nextFocus = highlight:GetPreviousFocus()
            else
                SetCursorToItem(highlight)
                nextFocus = me
            end
        end

        EditorLayer resultLayer = undefined

        if highlight is SelectionHighlight3D
            SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
            EditorLayer3D layer = cast(EditorLayer3D, highlight3D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight3D)
            layer:Remove(cast(Item3D, highlight3D:GetItem()))
        else
            SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
            EditorLayer2D layer = cast(EditorLayer2D, highlight2D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight2D)
            layer:Remove(cast(Item2D, highlight2D:GetItem()))
        end

        integer index = filterHighlights:GetFirstLocation(highlight)
        if index >= 0
            filterHighlights:RemoveAt(index)

            // Refresh filter highlight focus order and descriptions.
            SetFilterHighlightData()
        end

        if nextFocus not= undefined
            nextFocus:Focus()
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, highlight:GetItem())
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, highlight:GetItem(), undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    /*
    This action will delete an item that has been added to the scene.
    */
    action Delete(Item item)
        EditorLayer resultLayer = undefined

        if item is Item2D
            Item2D item2D = cast(Item2D, item)
            EditorLayer2D layer = cast(EditorLayer2D, item2D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item2D)
        elseif item is Item3D
            Item3D item3D = cast(Item3D, item)
            EditorLayer3D layer = cast(EditorLayer3D, item3D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item3D)
        end

        integer index = 0
        repeat while index < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(index)
            if highlight:GetItem() = item
                filterHighlights:RemoveAt(index)
                if resultLayer is EditorLayer2D
                    EditorLayer2D layer = cast(EditorLayer2D, resultLayer)
                    layer:Remove(cast(SelectionHighlight2D, highlight))
                elseif resultLayer is EditorLayer3D
                    EditorLayer3D layer = cast(EditorLayer3D, resultLayer)
                    layer:Remove(cast(SelectionHighlight3D, highlight))
                end

                // Manually set the index so we'll escape the loop early.
                index = filterHighlights:GetSize()

                // Refresh filter highlight focus order and descriptions.
                SetFilterHighlightData()
            end

            index = index + 1
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, item)
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, item, undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    /*
    This action creates a copy of an item that has been added to the scene. The copy is
    placed in the same layer, offset along the X axis by the width of the original so the
    two do not overlap. The copy is then selected so it can be moved right away. The copy is
    recorded as an insert edit, so it can be undone.
    */
    action Duplicate(Item item)
        EditorLayer layer = undefined
        Item copy = undefined

        if item is Item3D
            Item3D original = cast(Item3D, item)
            layer = cast(EditorLayer3D, original:GetLayer())
            JavaScriptObjectNotation json = WrapArrayProperties(SaveItem3D(original))
            if layer = undefined or json = undefined
                return now
            end

            Item3D copy3D = LoadItem3D(json)
            copy3D:SetName(GetCopyName(layer, original:GetName()))
            copy3D:SetPosition(original:GetX() + original:GetWidth(), original:GetY(), original:GetZ())
            copy = copy3D
        elseif item is Item2D
            Item2D original = cast(Item2D, item)
            layer = cast(EditorLayer2D, original:GetLayer())
            JavaScriptObjectNotation json = SaveItem2D(original)
            if layer = undefined or json = undefined
                return now
            end

            Item2D copy2D = parent:DefaultSceneManager:LoadItem2D(json)
            copy2D:SetName(GetCopyName(layer, original:GetName()))
            copy2D:SetPosition(original:GetX() + original:GetWidth(), original:GetY())
            copy = copy2D
        else
            return now
        end

        Add(layer, copy)
        NotifyAccessibility(copy, "Duplicated " + copy:GetName())

        if GetSelectedLayer() not= layer
            SetSelectedLayer(layer)
        end

        Array<Item> selected
        selected:Add(copy)
        SetFilteredItems(selected, true)
    end

    /*
    The scene loader reads position, size, scale, rotation, and color arrays through an outer
    array, but SaveItem3D writes them without it. This action wraps those values so a saved item
    can be loaded back with LoadItem3D, as CopyItem and Duplicate do.
    */
    private action WrapArrayProperties(JavaScriptObjectNotation json) returns JavaScriptObjectNotation
        // Build a new object rather than adding to json, since Add would keep the unwrapped entry too.
        JavaScriptObjectNotation wrapped
        Iterator<JavaScriptObjectNotation> iterator = json:GetIterator()
        repeat while iterator:HasNext()
            JavaScriptObjectNotation child = iterator:Next()
            text key = child:GetKey()
            if key = properties:POSITION or key = properties:SIZE or key = properties:SCALE or key = properties:ROTATION or key = properties:COLOR
                JavaScriptObjectNotation outer
                outer:SetArray()
                outer:Add(child)
                outer:SetKey(key)
                wrapped:Add(outer)
            else
                wrapped:Add(child)
            end
        end
        return wrapped
    end

    /*
    This action returns the name for a new copy of an item. Any " Copy" suffix is removed from the
    original name first, so copying "Coin Copy 2" also produces "Coin Copy 3" rather than "Coin Copy 2 Copy 1".
    The number is the first one not already used by an item in the layer.
    */
    private action GetCopyName(EditorLayer layer, text originalName) returns text
        text baseName = originalName
        Array<text> parts = originalName:Split(" Copy")
        if parts:Get(0):IsEmpty() = false
            baseName = parts:Get(0)
        end

        integer copyNumber = 1
        repeat while NameExistsInLayer(layer, baseName + " Copy " + copyNumber)
            copyNumber = copyNumber + 1
        end
        return baseName + " Copy " + copyNumber
    end

    /*
    This action returns true if an item in the layer has the given name. Editor items are skipped,
    since the selection highlights share the names of the items they highlight.
    */
    private action NameExistsInLayer(EditorLayer layer, text name) returns boolean
        return NameExistsInLayer(layer, name, undefined)
    end

    /*
    This action returns true if an item in the layer other than the skipped one has the given name.
    Editor items are skipped, since the selection highlights share the names of the items they highlight.
    */
    private action NameExistsInLayer(EditorLayer layer, text name, Item skip) returns boolean
        SceneConstants constants
        if layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Iterator<Item3D> items = layer3D:GetIterator()
            repeat while items:HasNext()
                Item3D item = items:Next()
                if item:HasProperty(constants:EDITOR_TAG) = false and item:GetName() = name
                    if skip = undefined or item:Equals(skip) = false
                        return true
                    end
                end
            end
        elseif layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Iterator<Item2D> items2D = layer2D:GetIterator()
            repeat while items2D:HasNext()
                Item2D item2D = items2D:Next()
                if item2D:HasProperty(constants:EDITOR_TAG) = false and item2D:GetName() = name
                    if skip = undefined or item2D:Equals(skip) = false
                        return true
                    end
                end
            end
        end
        return false
    end

    /*
    This action stores a copy of the given item so it can be pasted into the scene later with
    PasteCopiedItem. It is the same as calling CopyItems with only this item.
    */
    action CopyItem(Item item)
        Array<Item> items
        items:Add(item)
        CopyItems(items)
    end

    /*
    This action stores copies of the given items so they can be pasted into the scene later with
    PasteCopiedItem. Only 3D items can be copied, and other items are skipped. Each item is saved
    to JSON, the same way the scene is saved, so pasting creates new items and leaves the originals
    untouched. If none of the items are 3D, the previously copied items are kept.
    */
    action CopyItems(Array<Item> items)
        if items = undefined
            return now
        end

        Array<JavaScriptObjectNotation> copies
        Array<Item3D> originals
        integer counter = 0
        repeat while counter < items:GetSize()
            Item item = items:Get(counter)
            if item is Item3D
                Item3D original = cast(Item3D, item)
                copies:Add(WrapArrayProperties(SaveItem3D(original)))
                originals:Add(original)
            end
            counter = counter + 1
        end

        if copies:IsEmpty() = false
            copiedItemsJson = copies
            copiedOriginals = originals
        end
    end

    /*
    This action pastes the last copied items into the selected 3D layer. A single pasted item is
    placed at the selected item, or at the cursor if no item is selected. When several items are
    pasted, each copy is placed where its original is now, so the copies sit on top of the items
    they were copied from. If an original has been deleted since it was copied, its copy goes where
    the original was when it was copied. The selection and focus stay on whatever was selected
    before pasting. The pasted items are recorded as a single insert edit so one undo removes all
    of them. Nothing happens if no items have been copied or the selected layer is not 3D.
    */
    action PasteCopiedItem
        EditorLayer layer = GetSelectedLayer()
        if copiedItemsJson:IsEmpty() or layer is EditorLayer3D = false
            return now
        end

        Item3D target = GetPasteTarget(cast(EditorLayer3D, layer))

        // Load every copy first so the center of the group is known before anything is moved.
        Array<Item3D> copies
        number minX = 0
        number maxX = 0
        number minY = 0
        number maxY = 0
        number minZ = 0
        number maxZ = 0
        integer counter = 0
        repeat while counter < copiedItemsJson:GetSize()
            Item3D copy3D = LoadItem3D(copiedItemsJson:Get(counter))
            if counter = 0 or copy3D:GetX() < minX
                minX = copy3D:GetX()
            end
            if counter = 0 or copy3D:GetX() > maxX
                maxX = copy3D:GetX()
            end
            if counter = 0 or copy3D:GetY() < minY
                minY = copy3D:GetY()
            end
            if counter = 0 or copy3D:GetY() > maxY
                maxY = copy3D:GetY()
            end
            if counter = 0 or copy3D:GetZ() < minZ
                minZ = copy3D:GetZ()
            end
            if counter = 0 or copy3D:GetZ() > maxZ
                maxZ = copy3D:GetZ()
            end
            copies:Add(copy3D)
            counter = counter + 1
        end

        number shiftX = 0
        number shiftY = 0
        number shiftZ = 0
        if target not= undefined and copies:GetSize() = 1
            shiftX = target:GetGlobalX() - (minX + maxX) * 0.5
            shiftY = target:GetGlobalY() - (minY + maxY) * 0.5
            shiftZ = target:GetGlobalZ() - (minZ + maxZ) * 0.5
        end

        Array<Item> pasted
        counter = 0
        repeat while counter < copies:GetSize()
            Item3D copy3D = copies:Get(counter)
            // Each pasted item is added before the next is named, so items pasted together get different numbers.
            copy3D:SetName(GetCopyName(layer, copy3D:GetName()))
            if copies:GetSize() > 1
                // Several items: each copy goes on its original. A deleted original has no layer, so its
                // copy keeps the position saved when it was copied.
                if counter < copiedOriginals:GetSize() and copiedOriginals:Get(counter):GetLayer() not= undefined
                    Item3D original = copiedOriginals:Get(counter)
                    copy3D:SetPosition(original:GetX(), original:GetY(), original:GetZ())
                end
            else
                copy3D:SetPosition(copy3D:GetX() + shiftX, copy3D:GetY() + shiftY, copy3D:GetZ() + shiftZ)
            end
            AddToLayer(layer, copy3D)
            pasted:Add(copy3D)
            counter = counter + 1
        end

        SceneEditorInsertEdit edit
        edit:Create(me, layer, pasted)
        editManager:Add(edit)

        // The selection and focus are left alone, so the announcement comes from the item that has focus.
        if pasted:GetSize() = 1
            AnnounceToFocusedItem("Pasted " + pasted:Get(0):GetName())
        else
            AnnounceToFocusedItem("Pasted " + pasted:GetSize() + " items")
        end
    end

    /*
    This action returns where pasted items should go: the selected 3D item, or the layer's cursor
    if no 3D item is selected. A selection highlight counts as the item it highlights. The camera
    item is skipped, so pasting while it is selected uses the cursor.
    */
    private action GetPasteTarget(EditorLayer3D layer) returns Item3D
        Object selected = GetSelectedItem()
        if selected is SelectionHighlight
            SelectionHighlight highlight = cast(SelectionHighlight, selected)
            selected = highlight:GetItem()
        end

        if selected not= undefined and selected is Item3D and (selected is CameraItem) = false
            return cast(Item3D, selected)
        end

        Object cursor = layer:GetCursor()
        if cursor is Item3D
            return cast(Item3D, cursor)
        end
        return undefined
    end

    /*
        Sends a message to the screen reader using the currently focused item, or the Scene Editor
        itself if nothing is focused.
    */
    private action AnnounceToFocusedItem(text message)
        Item focusedItem = manager:GetFocus()
        if focusedItem = undefined
            focusedItem = me
        end
        NotifyAccessibility(focusedItem, message)
    end

    action CreateItemPreview(ItemBlueprint schematic) returns ItemPreview
        return CreateItemPreview(schematic, undefined)
    end

    action CreateItemPreview(ItemBlueprint schematic, File asset) returns ItemPreview
        if schematic is DrawableBlueprint
            DrawableBlueprint drawableBlueprint = cast(DrawableBlueprint, schematic)
            if not (GetSelectedLayer() is EditorLayer2D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer2D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if drawableBlueprint:GetPreferredGridWidth() not= 0 and drawableBlueprint:GetPreferredGridHeight() not= 0
                // TO-DO: Consider both width and height when setting grid unit size.
                layer:SetGridUnitSize(drawableBlueprint:GetPreferredGridWidth())
                layer:UpdateGridPosition()
            end

            ItemPreview2D preview
            preview:Load(me, drawableBlueprint)
            // TO-DO: Position preview to match cursor

            layer:Add(preview)
            preview:Focus()
            return preview
        elseif schematic is ModelBlueprint or schematic is PointLightBlueprint or schematic is Audio3DBlueprint
            
            if not (GetSelectedLayer() is EditorLayer3D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer3D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())

            // TO-DO: Consider modifying grid size for 3D objects here, same as with 2D objects above.

            ItemPreview3D preview = undefined
            if asset = undefined
                if schematic is ModelBlueprint
                    ModelPreview modelPreview
                    preview = modelPreview
                    ModelBlueprint modelBlueprint = cast(ModelBlueprint, schematic)
                    modelPreview:Load(me, modelBlueprint)
                elseif schematic is PointLightBlueprint
                    PointLightPreview lightPreview
                    preview = lightPreview
                    PointLightBlueprint lightBlueprint = cast(PointLightBlueprint, schematic)
                    lightPreview:Load(me, lightBlueprint)
                else
                    Audio3DPreview audioPreview
                    preview = audioPreview
                    Audio3DBlueprint audioBlueprint = cast(Audio3DBlueprint, schematic)
                    audioPreview:Load(me, audioBlueprint)
                end
            else
                if schematic is Custom3DPrimitiveBlueprint
                    Custom3DPrimitivePreview primitivePreview
                    preview = primitivePreview
                    Custom3DPrimitiveBlueprint primitiveBlueprint = cast(Custom3DPrimitiveBlueprint, schematic)
                    primitivePreview:Load(me, primitiveBlueprint, asset)
                elseif schematic is CustomModelBlueprint
                    CustomModelBlueprint newBlueprint = cast(CustomModelBlueprint, schematic)
                    newBlueprint:SetFile(asset)
                    ModelPreview modelPreview
                    preview = modelPreview
                    modelPreview:Load(me, newBlueprint)
                end
            end

            layer:Add(preview)
            preview:Focus()
            return preview
        end
        return undefined
    end

    action CancelItemPreview(ItemPreview preview)
        if preview is ItemPreview3D
            ItemPreview3D preview3D = cast(ItemPreview3D, preview)
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            layer:Remove(preview3D)
        else
            ItemPreview2D preview2D = cast(ItemPreview2D, preview)
            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())
            layer:Remove(preview2D)
        end
    end

    action SelectEditorCamera(EditorLayer layer)
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            CameraItem2D item
            item:Load(layer:GetCamera(), me)
            layer2D:Add(item)
            SetSelection(layer2D, item)

            item:Focus()
        elseif layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            CameraItem3D item
            item:Load(layer3D:GetEditorCamera(), me)
            layer3D:Add(item)
            SetSelection(layer3D, item)

            item:Focus()
        end
    end

    action DeselectEditorCamera
        // Was already empty
    end

    Matrix4 previewTransform = undefined
    action GetPreviewTransform returns Matrix4
        return previewTransform
    end

    action SetPreviewTransform(Matrix4 transform)
        previewTransform = transform
    end

    action GetDefaultItemName(integer type) returns text
        if type = 0
            return "Box"
        elseif type = 1
            return "Sphere"
        elseif type = 2
            return "Cylinder"
        end

        return "Item"
    end

    action ConfirmItemPreview(ItemPreview newItem)
        Item result = undefined
        EditorLayer resultLayer = undefined

        if newItem:GetItemBlueprint() not= undefined
            IncrementNameCount(newItem:GetItemBlueprint():GetName())
        end

        if newItem is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, newItem)
            Model model = preview:ConvertToModel()
            result = model

            previewTransform = preview:GetTransform()
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(model)
        elseif newItem is ItemPreview2D
            ItemPreview2D preview = cast(ItemPreview2D, newItem)
            Drawable drawable = preview:ConvertToDrawable()
            result = drawable

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(drawable)
        end

        // This Dispose call currently does nothing, but if there are any
        // resources that need to be cleaned up, it should be done here.
        //preview:Dispose()
        //Focus()

        NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, result, undefined, resultLayer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        if newItem:GetItemBlueprint() not= undefined
            text name = newItem:GetItemBlueprint():GetName()
            newItem:SetName(name + GetNextNamePostfix(name))
            if newItem is ModelPreview
                //item3dPropertiesDialog:SetFields(newItem)
            elseif newItem is PointLightPreview
                //pointLightPropertiesDialog:SetFields(newItem)
            elseif newItem is Audio3DPreview
                //audio3DPropertiesDialog:SetFields(newItem)
            elseif newItem is ItemPreview2D
                //item2dPropertiesDialog:SetFields(newItem)
            end
        end

        SceneEditorInsertEdit edit
        edit:Create(me, resultLayer, result)
        editManager:Add(edit)
    end

    action Add(EditorLayer layer, Item item)
        AddToLayer(layer, item)

        SceneEditorInsertEdit edit
        edit:Create(me, layer, item)
        editManager:Add(edit)
    end

    /*
    This action adds an item to a layer and notifies the change listeners, but does not record
    an insert edit. It is used when several items are added together under one edit.
    */
    private action AddToLayer(EditorLayer layer, Item item)
        if layer is EditorLayer2D and item is Item2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Item2D item2D = cast(Item2D, item)
            layer2D:Add(item2D)
        elseif layer is EditorLayer3D and item is Item3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Item3D item3D = cast(Item3D, item)
            layer3D:Add(item3D)    
        else
            alert("I couldn't add the item " + item:GetName() + " because it's incompatible with the requested layer.")
        end

        // It's not clear if we should notify accessibility here, or allow a change in selection to handle that for us.
        //NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, item, undefined, layer, event:ADDED)
        NotifySceneEditorChangeListeners(event)
    end

    action AddLayer(EditorLayer layer)
        selection:SetSelection(layer)
        layer:SetSceneEditor(me)
        layers:Add(layer)
    end

    action SetYawDirection(integer direction)
        yawDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Yaw " + math:Round(GetSelectedLayer():GetCameraYaw(), 1))
        end
    end

    action GetYawDirection returns integer
        return yawDirection
    end

    action SetPitchDirection(integer direction)
        pitchDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Pitch " + math:Round(GetSelectedLayer():GetCameraPitch(), 1))
        end
    end

    action GetPitchDirection returns integer
        return pitchDirection
    end

    action SetRollDirection(integer direction)
        rollDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Roll " + math:Round(GetSelectedLayer():GetCameraRoll(), 1))
        end
    end

    action GetRollDirection returns integer
        return rollDirection
    end

    action IsCameraRotating returns boolean
        return GetYawDirection() not= 0 or GetPitchDirection() not= 0
    end

    action GetYaw returns number
        return GetSelectedLayer():GetCameraYaw()
    end

    action GetPitch returns number
        return GetSelectedLayer():GetCameraPitch()
    end

    action GetRoll returns number
        return GetSelectedLayer():GetCameraRoll()
    end

    action SetForwardDirection(integer direction)
        forwardDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetForwardDirection returns integer
        return forwardDirection
    end
    action SetStrafeDirection(integer direction)
        strafeDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetStrafeDirection returns integer
        return strafeDirection
    end

    action SetVerticalDirection(integer direction)
        verticalDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
