/*
SceneEditor is the main Control that enables adding a functional scene editor
to a Game. 

Attribute: Example

TODO
need to implement more to understand how to structure examples.

*/
class SceneEditor is Control, DefaultSceneManager

    File file = undefined
    File projectLocation = undefined
    GameStateManager manager
    SceneProperties properties

    Array<EditorLayer> layers

    SceneConstants constants
    SceneEditorSelection selection

    Array<SceneEditorChangeListener> sceneEditorChangeListeners

    SceneEditorEditManager editManager

    // The scene's file text as it was last loaded or saved, without its
    // cameras, to tell whether it has changed since (HasUnsavedChanges).
    text savedText = ""
    // True while the scene's text is made only to compare it: the cameras,
    // which are the editor's view, are left out, so opening a scene or
    // looking around doesn't count as a change.
    boolean comparingText = false

    // The rotational speed measured in degrees,
    // and the directional speed, measured in 3D world units.
    public constant number CAMERA_ROTATIONAL_SPEED_3D = 15
    public constant number CAMERA_DIRECTIONAL_SPEED_3D = 1

    public constant number SELECTION_ROTATIONAL_SPEED_3D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_3D = 5

    public constant number CAMERA_ROTATIONAL_SPEED_2D = 90
    public constant number CAMERA_DIRECTIONAL_SPEED_2D = 600
    public constant number SELECTION_ROTATIONAL_SPEED_2D = 90
    public constant number SELECTION_DIRECTIONAL_SPEED_2D = 600

    /*
    Velocities of the layer's camera.
    Directions are always -1, 0, or 1, and are multiplied by either the rotational
    or directional speed during the Update to produce the per-frame velocity.
    */
    // The 3D camera's moves while their keys are held: look, slide, orbit
    // and zoom, each -1, 0 or 1 on x (left, right) and y (down or out, up
    // or in). StartCameraMove and StopCameraMove set them; the update
    // moves the camera through EditorCamera3D, as the mouse does.
    integer cameraLookX = 0
    integer cameraLookY = 0
    integer cameraSlideX = 0
    integer cameraSlideY = 0
    integer cameraOrbitX = 0
    integer cameraOrbitY = 0
    integer cameraZoom = 0

    // How fast held camera keys move it: turns and orbits in radians a
    // second (90 degrees), slides as a share of the view distance a second,
    // and zoom steps a second. A tap moves TAP_SECONDS' worth at once.
    constant number CAMERA_KEY_TURN_SPEED = 1.5708
    constant number CAMERA_KEY_SLIDE_SHARE = 0.75
    constant number CAMERA_KEY_ZOOM_STEPS = 10
    constant number CAMERA_KEY_TAP_SECONDS = 0.1

    // One step of RunCommand (Quorum Studio's Scenes menu): turns of 15
    // degrees, slides of a tenth of the view distance, and a brush stroke
    // as long as a short press.
    constant number COMMAND_TURN_RADIANS = 0.2618
    constant number COMMAND_TURN_DEGREES = 15
    constant number COMMAND_SLIDE_SHARE = 0.1
    constant number COMMAND_STROKE_SECONDS = 0.1

    integer yawDirection = 0
    integer pitchDirection = 0
    integer rollDirection = 0
    integer forwardDirection = 0
    integer strafeDirection = 0
    integer verticalDirection = 0

    // The velocity of the currently selected item on each axis.
    integer selectionXDirection = 0
    // The camera's forward over the ground, for the move keys (FindMoveAxes).
    number moveForwardX = 0
    number moveForwardZ = 1
    integer selectionYDirection = 0
    integer selectionZDirection = 0
    integer selectionYawDirection = 0
    integer selectionPitchDirection = 0
    integer selectionRollDirection = 0

    // Vectors which are constantly reused for frequent calculations.
    Vector2 workVector2
    Vector3 workVector3

    Accessibility accessibility = undefined
    Math math
    Color color

    /*
    A subset of the items, filtered in some way (e.g., the items in view of
    the camera). These can be iterated over to query for more information or to
    modify the elements.
    */
    Array<Item> filteredItems = undefined

    /*
    "Highlight" drawables used to show which items have been filtered.
    */
    Array<SelectionHighlight> filterHighlights

    /*
    Tracks how many times each name has been used from the palette.
    Used to add numbers to the end of the names of duplicate items.
    */
    HashTable<text, integer> nameCounts

    // Used for when a movement key is held and the grid lock is enabled.
    number gridMoveTimer = 0
    number gridMoveTimerMax = 0.5

    // A reference to the property dialogs for this controller.
    Item3DPropertiesDialog item3dPropertiesDialog
    Item2DPropertiesDialog item2dPropertiesDialog
    Camera2DPropertiesDialog camera2dPropertiesDialog
    Camera3DPropertiesDialog camera3dPropertiesDialog
    PointLightPropertiesDialog pointLightPropertiesDialog
    SpotLightPropertiesDialog spotLightPropertiesDialog
    Audio3DPropertiesDialog audio3DPropertiesDialog
    // A 3D layer's Sky section (QuincyWorld demo D3).
    SkyPropertiesDialog skyPropertiesDialog

    // A terrain's properties. They are added only with a
    // Properties panel, since two floating dialogs would cover each other.
    TerrainPropertiesDialog terrainPropertiesDialog
    TerrainPhysicsPropertiesDialog terrainPhysicsPropertiesDialog
    TerrainBrushPropertiesDialog terrainBrushPropertiesDialog
    TerrainMaterialsPropertiesDialog terrainMaterialsPropertiesDialog
    // A terrain's Foliage section, after its Materials.
    TerrainFoliagePropertiesDialog terrainFoliagePropertiesDialog
    // A terrain's Water section, after its Foliage.
    TerrainWaterPropertiesDialog terrainWaterPropertiesDialog
    TerrainGeneratePropertiesDialog terrainGeneratePropertiesDialog
    // The Stamp tool's settings, shown only while it is chosen.
    TerrainStampPropertiesDialog terrainStampPropertiesDialog
    // A model's Controller section, such as a Vehicle, and the lines drawn
    // over a selected vehicle: its box, wheels and springs.
    ControllerPropertiesDialog controllerPropertiesDialog
    // A layer's Physics section: physics in games, and gravity.
    LayerPhysicsPropertiesDialog layerPhysicsPropertiesDialog

    // A placed 3D item being dragged with the mouse: its highlight and
    // item; whether it has moved yet; where the pointer was pressed, on
    // screen; how far the item's origin is from the point picked under the
    // pointer; where it started; and the ground's height under it then, if
    // there was ground.
    boolean itemDragging = false
    boolean itemDragMoved = false
    SelectionHighlight3D itemDragHighlight = undefined
    Item3D itemDragItem = undefined
    number itemDragStartX = 0
    number itemDragStartY = 0
    number itemDragOffsetX = 0
    number itemDragOffsetZ = 0
    Vector3 itemDragBefore
    boolean itemDragHadGround = false
    number itemDragGroundStart = 0
    // How far, in pixels, the pointer moves before a press becomes a drag.
    constant number ITEM_DRAG_THRESHOLD = 4
    // The ground's height found by HasGroundAt.
    number foundGroundHeight = 0

    // The models added to the palette with Custom Model, kept in the
    // scene's file (CUSTOM_MODELS) and shown first in the palette.
    Array<ModelBlueprint> customModels
    VehicleGuides vehicleGuides = undefined
    // While the guides show, the car is drawn see-through, so the guides
    // inside it show: the model, each part's own color to put back, and
    // whether it was see-through before.
    Model seeThroughModel = undefined
    // The selection box drawn faint while a vehicle's guides show.
    SelectionHighlight3D fadedBox = undefined
    Array<Color> seeThroughColors
    boolean seeThroughHadTransparency = false
    constant number SEE_THROUGH_OPACITY = 0.35

    // The keys holding camera moves, and each move's kind and direction, so
    // a move stops once its key is up, however the key was let go
    // (UpdateCameraKeys).
    Array<integer> cameraHeldKeys
    // A followed car's game camera being viewed (StartFollowCamera): the
    // car, its layer, the camera's place last frame, and its place when its
    // follow settings were last taken.
    boolean followCameraActive = false
    Item3D followCameraModel = undefined
    EditorLayer3D followCameraLayer = undefined
    Vector3 followCameraLast
    Vector3 followCameraCommitted
    Array<integer> cameraHeldMoves
    Array<integer> cameraHeldX
    Array<integer> cameraHeldY

    // Makes and changes terrain in bulk: presets, stamps, erosion and auto
    // paint.
    TerrainGenerator generator

    // What finding a new texture set's maps by name found, said when the
    // layer is added.
    text layerMaterialNote = ""

    // A terrain's brush: the terrain whose tool is chosen, and the
    // ring that shows the brush on its ground. The ring is placed again only
    // when the brush moves or changes size.
    EditorTerrain brushTerrain = undefined
    TerrainBrushPreview brushPreview = undefined
    boolean brushPreviewShown = false

    // The ghost ring: a gray ring under the pointer, showing where a click
    // would move the terrain cursor. Hidden over the cursor's own ring,
    // where a click applies instead, and during a stroke.
    TerrainBrushPreview ghostPreview = undefined
    boolean ghostPreviewShown = false

    // A click outside the ring moved the cursor; holding the button past
    // HOLD_SECONDS then starts a stroke there.
    boolean pointerHolding = false
    number pointerHoldSeconds = 0
    constant number HOLD_SECONDS = 0.25

    // The new item's preview being placed, if any: a click on it places
    // it, a click elsewhere moves it there, and a fainter ghost of it
    // follows the pointer to show where a click would move it.
    ItemPreview3D activePreview = undefined
    // True while a placeholder from the palette (Enter or a double click)
    // places copies: it follows the pointer, and each click or Enter
    // places a copy where it is and keeps it out (multiple placement).
    // Dragging from the palette places once, as before.
    boolean placingCopies = false
    // True while a copy is being placed, so the placeholder keeps itself if
    // the focus moves for a moment.
    boolean placingCopyNow = false
    // A line outside the editor, such as above Studio's palette, that says
    // what a click places while copies are being placed; hidden otherwise.
    Label placementStatusLabel = undefined
    // The settings of the last placeholder that placed copies, given to the
    // next one from the palette, so switching tiles keeps them: scale,
    // rotation, Follow the ground, Lean with the slope, physics, and the
    // overriding color. A name and a model's own colors aren't kept.
    boolean hasPlacementSettings = false
    number placementScaleX = 1
    number placementScaleY = 1
    number placementScaleZ = 1
    number placementYaw = 0
    number placementPitch = 0
    number placementRoll = 0
    boolean placementFollowGround = false
    boolean placementLeanWithSlope = false
    boolean placementPhysicsEnabled = false
    integer placementResponsiveness = 0
    number placementMass = 0
    number placementFriction = 0
    number placementRestitution = 0
    boolean placementColorOverridden = false
    Color placementColor = undefined
    // True while placing selects the new item, so the camera stays put.
    boolean keepCameraAfterPlacing = false
    // True while a click selects an item: the camera follows it from where
    // it is, without moving.
    boolean keepCameraOnSelection = false
    EditorModel previewGhost = undefined
    boolean previewGhostShown = false
    // True after the preview's focus went into the Properties panel: the
    // next click in the view only gives the preview the focus back, so going
    // back and forth doesn't move it.
    boolean previewInProperties = false
    // How see-through the ghost is, as a share of the preview's alpha.
    constant number GHOST_ALPHA_SHARE = 0.35

    // The 3D grid's size: a patch under a selected item, or the
    // large floor for the scene's cursor, in grid squares across.
    constant integer GRID_PATCH_SQUARES = 9
    constant integer GRID_FLOOR_SQUARES = 64

    // The grid on a terrain: lines over the ground around the
    // terrain cursor, this many squares out each way. The flat grid hides
    // while it shows.
    TerrainGridPatch terrainGridPatch = undefined
    boolean terrainGridPatchShown = false
    boolean flatGridHiddenForPatch = false
    constant integer TERRAIN_GRID_SQUARES_OUT = 4
    // The grid drawn over terrain: its lines have faded out this many squares
    // from the camera, and at least this many world units, and show this
    // strongly (0 to 1).
    constant number TERRAIN_GRID_FADE_SQUARES = 60
    constant number TERRAIN_GRID_FADE_LEAST = 40
    constant number TERRAIN_GRID_STRENGTH = 0.45

    // The terrain whose cursor a new item's preview starts at, recorded
    // before the preview takes the focus, so the ring stays shown with it.
    EditorTerrain previewStartTerrain = undefined
    // The ring blinks like a text cursor: solid for a second after it
    // moves, then on and off (TextField's caretIdleTime and caretBlinkTime).
    number ringBlinkTimer = 0
    boolean ringBlinkHidden = false
    constant number RING_IDLE_TIME = 1.0
    constant number RING_BLINK_TIME = 0.35
    number previewX = 0
    number previewZ = 0
    number previewSize = 0
    TerrainBrushMouseListener brushMouseListener

    // The terrain cursor's beam and crosshair, which can be seen from far
    // away, and the settings they follow. Quorum Studio gives every scene
    // editor the same settings (SetTerrainCursorSettings).
    TerrainCursorSettings cursorSettings
    TerrainCursorBeam cursorBeam = undefined
    TerrainCursorCrosshair cursorCrosshair = undefined
    boolean cursorBeamShown = false
    boolean cursorCrosshairShown = false
    number markX = 0
    number markZ = 0
    // Seconds since the cursor last moved, for After Moving, and a clock
    // for Breathing.
    number markSecondsSinceMove = 100
    number markClock = 0
    constant number MARK_FLASH_TIME = 2.0
    constant number MARK_FLASH_PERIOD = 0.5
    constant number MARK_BREATH_PERIOD = 1.8

    // The terrain cursor: the terrain whose highlight has the focus, whose
    // brush position the arrow keys move with or without a tool; an unsaved
    // item at the cursor that the camera follows; whether the pointer moved
    // the cursor last; and whether it is stopped at the terrain's edge.
    EditorTerrain cursorTerrain = undefined
    Item3D terrainCursorTarget = undefined
    boolean terrainCursorMovedByPointer = false
    boolean terrainCursorAtEdge = false
    // Said before the scene cursor's place once, as "Left Terrain1. Scene
    // cursor. ", when Escape leaves a terrain; cleared when the
    // cursor moves or the editor loses the focus.
    text terrainLeftMessage = ""

    // New items start on the ground: the terrain
    // whose cursor a new item's preview started at, so Escape goes back to
    // that cursor, or undefined; the terrain the last ground search found,
    // or undefined; and boxes reused to measure an item's shape.
    EditorTerrain placementTerrain = undefined
    EditorTerrain lastGround = undefined
    BoundingBox shapeBox
    BoundingBox groundBox

    // A ramp being marked: a green ring at its start, and a green
    // outline from there to the brush, which turns red as the ramp's end.
    TerrainBrushPreview rampStartMarker = undefined
    TerrainRampPreview rampOutline = undefined
    boolean rampShown = false

    // The region tools, Add region and Remove region. The slot outline
    // shows the region slot under the pointer, or under the terrain cursor
    // when the keys moved it last: green where the tool can act, red where
    // it can't. The placeholder is a rectangle of region slots, by region
    // location, waiting to be added or removed. It is yellow, and white
    // while the pointer is over an edge or corner that can be dragged.
    // There is a placeholder while placeholderTerrain is defined.
    TerrainRegionOutline regionSlotOutline = undefined
    boolean regionSlotShown = false
    integer regionSlotX = 0
    integer regionSlotZ = 0
    TerrainRegionOutline placeholderOutline = undefined
    EditorTerrain placeholderTerrain = undefined
    integer placeholderFirstX = 0
    integer placeholderFirstZ = 0
    integer placeholderLastX = 0
    integer placeholderLastZ = 0
    number placeholderHeight = 0
    // An edge or corner of the placeholder being dragged with the mouse,
    // which sides move, and the rectangle when the drag began, for undo.
    boolean placeholderDragging = false
    boolean dragLeft = false
    boolean dragRight = false
    boolean dragNear = false
    boolean dragFar = false
    integer dragStartFirstX = 0
    integer dragStartFirstZ = 0
    integer dragStartLastX = 0
    integer dragStartLastZ = 0
    // The height of the level the pointer is read on during a drag, kept
    // from its start so the placeholder doesn't shift as its height does.
    number dragHeight = 0
    // Whether the slot outline follows the pointer, rather than the
    // terrain cursor, and where the cursor was last seen, so a move with
    // the keys gives the outline back to the cursor.
    boolean slotFollowsPointer = false
    number slotCursorX = 0
    number slotCursorZ = 0
    // True while the status line shows something from a region tool, so
    // it is cleared when the tool is left.
    boolean regionStatusShown = false
    // How close to the placeholder's edge, as a share of a region's width,
    // a press grabs the edge instead of committing.
    constant number PLACEHOLDER_GRAB_SHARE = 0.15

    // A stroke with a terrain's brush: it goes on while the key
    // that started it, or the left mouse button, is held.
    TerrainStroke terrainStroke
    boolean stroking = false
    boolean strokeByMouse = false
    // True when a click took the focus from the terrain's highlight while
    // its tool was chosen, so the next update gives it back.
    boolean refocusBrushHighlight = false
    // Painting is shown a few times a second during a stroke, since each
    // showing loads the splat texture again.
    number paintShownSeconds = 0
    constant number PAINT_SHOW_INTERVAL = 0.2
    integer strokeKey = 0
    InputMonitor strokeMonitor
    MouseEvent mouseButtons

    // A stroke with the Foliage tool, going while
    // foliageStroking is true. It is a stroke like the others for the keys
    // and buttons that start and end it.
    FoliageStroke foliageStroke = undefined
    boolean foliageStroking = false

    // A stroke with the Paint water tool: the lake it
    // paints into, whether it adds or erases, the water as it was before
    // it, for undo, and where it last painted.
    boolean waterStroking = false
    TerrainLake waterStrokeLake = undefined

    // The River tool: the points of a river being
    // drawn, the river and point chosen to edit, a point being dragged, and
    // the line that shows the path over the ground.
    boolean riverDrawing = false
    EditorTerrain riverTerrain = undefined
    Array<number> riverDraftX
    Array<number> riverDraftZ
    TerrainRiver chosenRiver = undefined
    integer chosenRiverPoint = -1
    boolean riverDragging = false
    boolean riverDragMoved = false
    number riverDragX = 0
    number riverDragZ = 0
    TerrainPathLine riverLine = undefined
    boolean riverLineShown = false
    // The other rivers' paths, shown while the River tool is chosen, so
    // their points can be found and clicked; and how many are shown.
    Array<TerrainPathLine> allRiverLines
    integer allRiverLinesShown = 0
    // How close to a river's point a click must be to choose it, at least.
    constant number RIVER_POINT_REACH = 1.5
    boolean waterStrokeAdds = true
    WaterState waterStrokeBefore = undefined
    integer waterStrokeCells = 0
    number waterStrokeX = 0
    number waterStrokeZ = 0
    boolean waterStrokeDabbed = false
    boolean waterStrokeMadeLake = false
    KeyboardEvent modifierKeys

    // How much each strength key strengthens or weakens the brush, and its
    // limits.
    constant number BRUSH_STRENGTH_STEP = 1.25
    constant number BRUSH_WEAKEST = 0.1
    constant number BRUSH_STRONGEST = 50

    // How far one arrow key step moves the terrain cursor, as a share of
    // the brush's size R, and how many sizes a second it glides with the
    // grid off: R/2 a step, R a second.
    constant number CURSOR_STEP_SHARE = 0.5
    constant number CURSOR_GLIDE_RATE = 1
    // How much each size key grows or shrinks the brush, and its limits.
    constant number BRUSH_SIZE_STEP = 1.15
    constant number BRUSH_SMALLEST = 0.5
    constant number BRUSH_LARGEST = 64

    // An array containing the different property dialogs.
    Array<PropertiesDialog> propertiesDialogs

    // The panel the properties dialogs are docked in, or undefined to show
    // them as floating dialogs.
    PropertiesPanel propertiesPanel = undefined

    // A reference to the find dialog for this controller.
    SceneEditorFindDialog findDialog

    // Used to forcibly change the focus and send information via the screen reader.
    Item2D dummyItem


    on create
        FlowLayout layout
        SetLayout(layout)
        SetPercentageWidth(1.0)
        SetPercentageHeight(1.0)
        
        LabelBoxView view
        view:Initialize(color:CustomColor(0.9, 0.9, 0.925, 1), color:CustomColor(0.9, 0.9, 0.925, 1))
        SetView2D(view)

        SetInputGroup("SceneEditor")
        SetName("Scene Editor")
        SetFocusable(true)
        SetAccessibilityCode(parent:Item:CUSTOM)

        accessibility = manager:GetAccessibility()

        selection:Initialize(me)
        findDialog:Initialize(me)

        // A terrain's brush follows the pointer while a tool is chosen.
        brushMouseListener:SetSceneEditor(me)
        AddMouseMovementListener(brushMouseListener)

        propertiesDialogs:Add(item2dPropertiesDialog)
        propertiesDialogs:Add(item3dPropertiesDialog)
        propertiesDialogs:Add(camera2dPropertiesDialog)
        propertiesDialogs:Add(camera3dPropertiesDialog)
        propertiesDialogs:Add(pointLightPropertiesDialog)
        propertiesDialogs:Add(spotLightPropertiesDialog)
        propertiesDialogs:Add(audio3DPropertiesDialog)
        propertiesDialogs:Add(skyPropertiesDialog)

        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Initialize(me)
            counter = counter + 1
        end
    end

    action GetFile returns File
        return file
    end

    action SetFile(File file)
        me:file = file
    end

    action GetProjectLocation returns File
        return projectLocation
    end

    action SetProjectLocation(File file)
        me:projectLocation = file
    end

    /*
    This action returns the relative path to reach the provided file
    from the project location associated with this tab.
    */
    action GetProjectPathToFile(File file) returns text
        text projectPath = projectLocation:GetAbsolutePath()
        text goalPath = file:GetAbsolutePath()

        Array<text> start = undefined
        Array<text> goal = undefined
        // The "Contains" action can correctly test for backslashes, but the "Split" command requires the escape character "\\", or it crashes
        if projectPath:Contains("\")
            start = projectPath:Split("\\")
            goal = goalPath:Split("\\")
        else
            start = projectPath:Split("/")
            goal = goalPath:Split("/")
        end

        /*
        Steps:
        1. Remove all common elements between the two paths
        2. For each element remaining in the source, prepend "../"
        3. For each element remaining in the goal, append it to the end
        */

        text result = ""
        boolean taskDone = false
        repeat until start:IsEmpty() or goal:IsEmpty() or taskDone
            text chunk1 = start:GetFromFront()
            text chunk2 = goal:GetFromFront()

            if chunk1 = chunk2
                start:RemoveFromFront()
                goal:RemoveFromFront()
            else
                taskDone = true
            end
        end

        repeat start:GetSize() times
            result = result + "../"
        end

        repeat until goal:IsEmpty()
            result = result + goal:RemoveFromFront()
            if goal:IsEmpty() = false
                result = result + "/"
            end
        end

        return result
    end

    action Load
        Scene scene
        scene:Load(file)
        SetName(file:GetPath())
        Load(scene)
        LoadCustomModels(scene:GetData())
        SelectStartingLayer()
        savedText = GetComparableText()
    end

    /*
    This action picks the layer a scene opens on. Each layer is selected as
    it loads, so the last one in the file is selected, usually the 2D layer.
    A scene with nothing in its 2D layer but something in a 3D layer opens
    on that 3D layer instead. An empty scene keeps the 2D layer.
    */
    private action SelectStartingLayer
        EditorLayer selected = GetSelectedLayer()
        if selected = undefined or not (selected is EditorLayer2D) or HasSceneItems(selected)
            return now
        end
        integer i = 0
        repeat while i < layers:GetSize()
            EditorLayer layer = layers:Get(i)
            if layer is EditorLayer3D and HasSceneItems(layer)
                SetSelectedLayer(layer)
                return now
            end
            i = i + 1
        end
    end

    /*
    This action returns true if a layer holds any of the scene's own items,
    as the Scene tree lists them: not the editor's grids, cursors and
    other helpers, which have the editor's tag.

    Attribute: Parameter layer The layer
    Attribute: Returns True if the layer has scene items
    */
    private action HasSceneItems(EditorLayer layer) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Iterator<Item2D> items2D = layer2D:GetIterator()
            repeat while items2D:HasNext()
                if items2D:Next():HasProperty(constants:EDITOR_TAG) = false
                    return true
                end
            end
        elseif layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Iterator<Item3D> items3D = layer3D:GetIterator()
            repeat while items3D:HasNext()
                if items3D:Next():HasProperty(constants:EDITOR_TAG) = false
                    return true
                end
            end
        end
        return false
    end

    /*
    This action returns the description of the item currently focused by the cursor on
    the current layer. If there is no item at the cursor this action returns the position
    of the cursor. If there are multiple items this action will return the names of each item
    at the current cursor position.

    Attribute: Returns The affine as the identy matrix

    */
    action GetDescription returns text
        if GetSelectedLayer() not= undefined
            EditorCursor cursor = GetSelectedLayer():GetCursor()
            text position = ""

            if cursor is EditorCursor2D
                EditorCursor2D cursor2D = cast(EditorCursor2D, cursor)
                position = cast(integer, cursor2D:GetX()) + " " + cast(integer, cursor2D:GetY())
            elseif cursor is EditorCursor3D
                EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
                position = cast(integer, cursor3D:GetX()) + " " + cast(integer, cursor3D:GetY()) + " " + cast(integer, cursor3D:GetZ())
            end

            Array<Item> items = cursor:GetItemsAtCursor()
            // Just after Escape left a terrain, this starts with "Left
            // Terrain1. Scene cursor. ".
            if items:GetSize() = 0
                return terrainLeftMessage + position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return terrainLeftMessage + names + position + ", press Enter to select items"
            else
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > items:GetSize() - 3
                    counter = counter - 1
                    names = names + items:Get(counter):GetName() + ", "
                end
                return terrainLeftMessage + names + items:GetSize() + " items, " + position + ", press Enter to select items"
            end
        end

        return parent:Item:GetDescription()
    end


    /*
    This action is called automatically by the system. This resize adjusts the size of the
    viewports, camera, and grid.
    */
    action Resize
        parent:Control:Resize()

        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer layer = layers:Get(counter)
            layer:SetViewport(cast(integer, GetGlobalX()), cast(integer, GetGlobalY()), cast(integer, GetWidth()), cast(integer, GetHeight()))
            Camera camera = layer:GetCamera()
            camera:SetSize(GetWidth(), GetHeight())
            counter = counter + 1

            if layer is EditorLayer2D
                EditorLayer2D layer2D = cast(EditorLayer2D, layer)
                layer2D:UpdateGridSize()
            end
        end
    end


    /*
        This action takes every dialog added to this Scene Editor and hides all of them.
    */
    action HideDialogs
        // A docked panel is part of the editor's own view, so it keeps
        // showing the selection, for example when switching tabs.
        if propertiesPanel not= undefined
            return now
        end
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):Hide()
            counter = counter + 1
        end
    end

    /*
        Shows the properties of the selected item in a panel, instead of in
        floating dialogs. Every properties dialog, including any added later
        with AddPropertiesDialog, docks in the panel. Set it once, before the
        scene is loaded.

        Attribute: Parameter panel The panel
    */
    action SetPropertiesPanel(PropertiesPanel panel)
        boolean firstPanel = false
        if propertiesPanel = undefined
            firstPanel = true
        end
        propertiesPanel = panel
        panel:SetSceneEditor(me)
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            propertiesDialogs:Get(counter):DockIn(panel)
            counter = counter + 1
        end

        // A terrain's sections, after the built-in dialogs: its
        // facts, its materials, its foliage, its
        // water, its brush, the Stamp
        // tool's settings, its generate tools and its
        // physics. The panel shows them in this order.
        if firstPanel
            AddPropertiesDialog(terrainPropertiesDialog)
            AddPropertiesDialog(terrainMaterialsPropertiesDialog)
            AddPropertiesDialog(terrainFoliagePropertiesDialog)
            AddPropertiesDialog(terrainWaterPropertiesDialog)
            AddPropertiesDialog(terrainBrushPropertiesDialog)
            AddPropertiesDialog(terrainStampPropertiesDialog)
            AddPropertiesDialog(terrainGeneratePropertiesDialog)
            AddPropertiesDialog(terrainPhysicsPropertiesDialog)
            AddPropertiesDialog(controllerPropertiesDialog)
            AddPropertiesDialog(layerPhysicsPropertiesDialog)
        end
    end

    /*
        Returns the panel showing the selected item's properties.

        Attribute: Returns The panel, or undefined if the editor uses floating dialogs
    */
    action GetPropertiesPanel returns PropertiesPanel
        return propertiesPanel
    end

    /*
        Adds a properties dialog for another kind of item. It is set up as
        the built-in ones are: it listens to the selection, and docks in the
        panel if there is one. A terrain's dialog is added this way.

        Attribute: Parameter dialog The dialog
    */
    action AddPropertiesDialog(PropertiesDialog dialog)
        dialog:Initialize(me)
        propertiesDialogs:Add(dialog)
        if propertiesPanel not= undefined
            dialog:DockIn(propertiesPanel)
        end
    end

    action GetEditorTag returns text
        return constants:EDITOR_TAG
    end

