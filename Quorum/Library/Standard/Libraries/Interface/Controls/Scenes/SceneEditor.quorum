            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number pitch = math:Round(focus:GetPitch(), 1)
                NotifyAccessibility(focus, "pitch " + pitch)
