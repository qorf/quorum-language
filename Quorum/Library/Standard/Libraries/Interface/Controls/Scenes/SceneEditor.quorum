    action FocusItemProperties
        // A terrain's key goes to its brush settings.
        if GetSelectedItem() is TerrainSelectionHighlight and terrainBrushPropertiesDialog:IsShowing()
            terrainBrushPropertiesDialog:FocusSection()
            return now
        end
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:FocusSection()
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateActivePropertiesDialog(EditorItem item)
        integer counter = 0
        repeat while counter < propertiesDialogs:GetSize()
            PropertiesDialog dialog = propertiesDialogs:Get(counter)
            if dialog:IsShowing()
                dialog:SetFields(item)
                return now
            end
            counter = counter + 1
        end
    end

    action UpdateEditorCameraTarget
        Item item = GetSelectedItem()
        EditorLayer layer = GetSelectedLayer()
        if item is Item2D or layer is EditorLayer2D
            // We currently only support this feature for 3D.
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)

        // A terrain is too big to center on: going to its middle would fly
        // the camera away from where the user was looking, so selecting one
        // keeps the camera where it is.
        if item is TerrainSelectionHighlight
            return now
        end

        // A new item's preview, and the item just placed from it, leave the
        // camera where it is: jumping to them while placing is distracting,
        // and could put the camera inside the preview.
        if item is ItemPreview3D or keepCameraAfterPlacing
            keepCameraAfterPlacing = false
            return now
        end

        if item = undefined and IsFocused()
            // The cursor becomes the target without the camera jumping to
            // it, such as after a click in the view; moving the cursor with
            // the keys then moves the camera with it. The cursor is held as
            // an Item, since it can only be cast to an Item3D from there.
            Item cursorItem = layer3D:GetCursor()
            layer3D:GetEditorCamera():SetTargetWithoutMoving(cast(Item3D, cursorItem))
            return now
        end
        
        // Selecting an item while viewing through the game camera leaves
        // the view where it is, so a click doesn't move where a game starts.
        if keepCameraOnSelection or layer3D:IsViewingGameCamera()
            layer3D:GetEditorCamera():SetTargetWithoutMoving(cast(Item3D, item))
            return now
        end
        layer3D:GetEditorCamera():SetTarget(cast(Item3D, item))
    end

    /*
    This action sets whether selecting an item keeps the camera where it is,
    such as while a click in the view selects one. The camera still follows
    the item from there when it moves.

    Attribute: Parameter keep True to keep the camera still on selection
    */
    action SetKeepCameraOnSelection(boolean keep)
        keepCameraOnSelection = keep
    end

    action UpdateEditorCameraPosition
        if GetSelectedLayer() is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            layer:GetEditorCamera():UpdateCameraPosition()
        else
            // Do nothing -- we currently don't support this for 2D
        end
    end

    action GetFindDialog returns SceneEditorFindDialog
        return findDialog
    end

    action GetEditManager returns SceneEditorEditManager
        return editManager
    end

    action IsFocused returns boolean
        // Although we can get the focus directly from the manager, we request
        // it from the Game instead. This allows the Game to do any necessary
        // additional book-keeping.
        return parent:Item:IsFocused() or (dummyItem not= undefined and dummyItem:IsFocused())
    end

action Update(number seconds)
        if layers:IsEmpty() or GetSelectedLayer() = undefined
            return now
        end

        UpdateTerrains()
        if refocusBrushHighlight
            refocusBrushHighlight = false
            if IsTerrainBrushActive() and GetSelectedItem() is TerrainSelectionHighlight and IsFocused()
                GetSelectedItem():Focus()
            end
        end
        UpdateTerrainStroke(seconds)
        UpdatePointerHold(seconds)
        UpdateRiverDrag()
        UpdateRegionDrag()
        UpdateItemDrag()
        UpdateCameraKeys()
        UpdateFollowCamera()
        // The vehicle guides go wherever the car is, however it moved.
        if vehicleGuides not= undefined and vehicleGuides:IsShowing()
            vehicleGuides:Follow()
        end
        UpdateTerrainGridPatch()
        // A click in the view gives the scene editor the focus; a preview
        // being placed takes it back, so Enter and the arrow keys reach it.
        if HasActivePreview() and IsFocused()
            activePreview:Focus()
        end
        if HasActivePreview() and activePreview:IsFocused()
            previewInProperties = false
        end
        UpdateBrushPreview()
        BlinkBrushPreview(seconds)
        UpdateCursorMarks(seconds)

        Camera camera = GetSelectedLayer():GetCamera()
        boolean moved = false
        boolean isCursor = false
        Item movedItem = undefined

        if GetSelectedLayer() is EditorLayer3D

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            MoveCameraByKeys(layer:GetEditorCamera(), seconds)

            if (yawDirection not= 0 or pitchDirection not= 0 or rollDirection not= 0)
                number yaw = layer:GetCameraYaw() + (yawDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                number pitch = layer:GetCameraPitch() + (pitchDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                if pitch > 90.0
                    pitch = 90.0
                elseif pitch < -90.0
                    pitch = -90.0
                end
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_3D * seconds)
                
//                layer:SetCameraYawPitchRoll(yaw, pitch, roll)
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
//                camera:Move(workVector3:Scale(strafeDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds))
            end
    
            if verticalDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(verticalDirection * CAMERA_DIRECTIONAL_SPEED_3D * seconds)
//                camera:Move(workVector3)
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem3D
                moved = false
                workVector3:Set(0, 0, 0)

                EditorItem3D focus = undefined

                if IsFocused()
                    isCursor = true
                    focus = cast(EditorItem3D, cast(Object, layer:GetCursor()))
                else
                    focus = cast(EditorItem3D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                // Left, right, forward and back are the camera's, over the
                // ground: Up moves away from the camera, Right to its right.
                // With the grid on, they are the world axes nearest the
                // camera's, so items step along the grid.
                FindMoveAxes(camera, gridSnapEnabled)
                number moveRightX = moveForwardZ
                number moveRightZ = -moveForwardX
                number alongX = moveRightX * selectionXDirection + moveForwardX * selectionZDirection
                number alongZ = moveRightZ * selectionXDirection + moveForwardZ * selectionZDirection

                // A new item started at a terrain's cursor moves as that
                // cursor does, and takes the cursor (and its ring) with it.
                boolean followsCursor = focus is ItemPreview3D and placementTerrain not= undefined and placementTerrain = cursorTerrain

                // With a region tool, the terrain cursor steps one whole
                // region at a time, since the tools act on whole regions.
                // Gliding at the brush's speed took most of a minute to
                // cross one region.
                boolean regionSteps = focus is TerrainSelectionHighlight and IsTerrainBrushActive() and IsRegionTool(brushTerrain)
                if regionSteps
                    if selectionXDirection not= 0 or selectionZDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax
                            StepTerrainCursor(brushTerrain, selectionXDirection, selectionZDirection)
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                elseif gridSnapEnabled = false and followsCursor
                    if selectionXDirection not= 0 or selectionZDirection not= 0
                        MoveTerrainBrush(placementTerrain, selectionXDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds, selectionZDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        MoveFocusToTerrainCursor(focus, placementTerrain)
                    end
                elseif gridSnapEnabled = false
                    if selectionXDirection not= 0 or selectionZDirection not= 0
                        if focus is TerrainSelectionHighlight
                            // The terrain cursor turns the keys to the camera
                            // itself (MoveTerrainBrush), so it gets them as
                            // pressed: right, and forward, which its Move
                            // reads from -z. Turned here too, they were
                            // turned twice.
                            workVector3:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                            workVector3:SetZ(-selectionZDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        else
                            workVector3:SetX(alongX * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                            workVector3:SetZ(alongZ * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        end
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector3:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_3D * seconds)
                        moved = true
                    end
    
                    if moved
                        // A preview that follows the ground keeps its height
                        // above it, unless its height is being changed.
                        number aboveBefore = -GetGroundChange(focus)
                        boolean groundBefore = lastGround not= undefined
                        focus:Move(workVector3)
                        if selectionYDirection = 0
                            FollowGroundAfterMove(focus, aboveBefore, groundBefore)
                        end
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0 or selectionZDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax

                            if focus is TerrainSelectionHighlight
                                // The terrain cursor steps half the brush's
                                // size over the ground, in whole grid units;
                                // the terrain stays where it is.
                                TerrainSelectionHighlight cursorHighlight = cast(TerrainSelectionHighlight, focus)
                                StepTerrainCursor(cursorHighlight:GetEditorTerrain(), selectionXDirection, selectionZDirection)
                            elseif followsCursor and (selectionXDirection not= 0 or selectionZDirection not= 0)
                                StepTerrainCursor(placementTerrain, selectionXDirection, selectionZDirection)
                                MoveFocusToTerrainCursor(focus, placementTerrain)
                            elseif focus is CameraItem3D
                                CameraItem3D cameraItem = cast(CameraItem3D, focus)
                                if selectionXDirection not= 0
                                    cameraItem:SetYaw(cameraItem:GetYaw() + selectionXDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionYDirection not= 0
                                    cameraItem:SetPitch(cameraItem:GetPitch() + selectionYDirection * CAMERA_ROTATIONAL_SPEED_3D)
                                end

                                if selectionZDirection not= 0
                                    cameraItem:SetDistance(cameraItem:GetDistance() - selectionZDirection * CAMERA_DIRECTIONAL_SPEED_3D)
                                end
                            else
                                moved = true
                                number x = focus:GetGlobalX()
                                number y = focus:GetGlobalY()
                                number z = focus:GetGlobalZ()
        
                                if alongX < 0
                                    x = layer:GetPreviousGridCoordinate(x)
                                elseif alongX > 0
                                    x = layer:GetNextGridCoordinate(x)
                                end
        
                                if selectionYDirection < 0
                                    y = layer:GetPreviousGridCoordinate(y)
                                elseif selectionYDirection > 0
                                    y = layer:GetNextGridCoordinate(y)
                                end
        
                                if alongZ < 0
                                    z = layer:GetPreviousGridCoordinate(z)
                                elseif alongZ > 0
                                    z = layer:GetNextGridCoordinate(z)
                                end
        
                                number aboveStep = -GetGroundChange(focus)
                                boolean groundStep = lastGround not= undefined
                                focus:Move(x - focus:GetGlobalX(), y - focus:GetGlobalY(), z - focus:GetGlobalZ())
                                if selectionYDirection = 0
                                    FollowGroundAfterMove(focus, aboveStep, groundStep)
                                end
                                PlaceGridUnder(focus)
                            end
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = focus
                end

                if IsSelectionRotating()
                    workVector3:Set(focus:GetYaw(), focus:GetPitch(), focus:GetRoll())
                    workVector3:Add(seconds * selectionYawDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionPitchDirection * SELECTION_ROTATIONAL_SPEED_3D, seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_3D)
                    focus:SetRotation(workVector3)
                end
            end

        elseif GetSelectedLayer() is EditorLayer2D
            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if (rollDirection not= 0)
                number roll = layer:GetCameraRoll() + (rollDirection * CAMERA_ROTATIONAL_SPEED_2D * seconds)
                layer:SetCameraRoll(roll)
            end
    
            if strafeDirection not= 0
                workVector3:Set(camera:GetDirection())
                workVector3:CrossProduct(camera:GetUp())
                camera:Move(workVector3:Scale(-strafeDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds))
                moved = true
            end
    
            if forwardDirection not= 0
                workVector3:Set(camera:GetUp())
                workVector3:Scale(forwardDirection * CAMERA_DIRECTIONAL_SPEED_2D * seconds)
                camera:Move(workVector3)
                moved = true
            end

            if moved
                layer:UpdateGridPosition()
            end
    
            if IsFocused() or manager:GetFocus() is EditorItem2D
                moved = false
                workVector2:Set(0, 0)

                Item2D target = undefined
                
                if IsFocused()
                    isCursor = true
                    target = cast(Item2D, cast(Object, layer:GetCursor()))
                else
                    target = cast(Item2D, manager:GetFocus())
                end
    
                boolean gridSnapEnabled = IsGridSnapping()
    
                if gridSnapEnabled = false
                    if selectionXDirection not= 0
                        workVector2:SetX(selectionXDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if selectionYDirection not= 0
                        workVector2:SetY(selectionYDirection * SELECTION_DIRECTIONAL_SPEED_2D * seconds)
                        moved = true
                    end
    
                    if moved
                        target:Move(workVector2)
                    end
                else
                    if selectionXDirection not= 0 or selectionYDirection not= 0
                        if gridMoveTimer <= 0
                            gridMoveTimer = gridMoveTimerMax
    
                            number x = target:GetGlobalX()
                            number y = target:GetGlobalY()
    
                            if selectionXDirection < 0
                                x = layer:GetPreviousGridCoordinate(x)
                            elseif selectionXDirection > 0
                                x = layer:GetNextGridCoordinate(x)
                            end
    
                            if selectionYDirection < 0
                                y = layer:GetPreviousGridCoordinate(y)
                            elseif selectionYDirection > 0
                                y = layer:GetNextGridCoordinate(y)
                            end
    
                            target:Move(x - target:GetGlobalX(), y - target:GetGlobalY())
                            moved = true
                        else
                            gridMoveTimer = gridMoveTimer - seconds
                        end
                    else
                        gridMoveTimer = 0
                    end
                end

                if moved
                    movedItem = target
                end

                if GetSelectionRollDirection() not= 0 and isCursor = false
                    number angle = target:GetRotation()
                    angle = angle + (seconds * selectionRollDirection * SELECTION_ROTATIONAL_SPEED_2D)
                    target:SetRotation(angle)
                end
            end
        end

        if moved
            if movedItem not= undefined and movedItem is EditorItem
                UpdateActivePropertiesDialog(cast(EditorItem, movedItem))
                // A new item's preview moves on its own; the camera stays.
                // A placed item's camera follows only once the item leaves
                // the view.
                if not (movedItem is ItemPreview3D) and not IsInView(movedItem)
                    UpdateEditorCameraPosition()
                end
            end

            if isCursor
                if accessibility not= undefined
                    // The cursor moved, so "Left Terrain1" isn't said again.
                    terrainLeftMessage = ""
                    Item2D newDummy
                    text describe = GetDescription()
                    newDummy:SetProperty(constants:EDITOR_TAG, undefined)
                    newDummy:SetFocusable(true)
                    newDummy:SetAccessibilityCode(dummyItem:parent:Item:ITEM)
                    newDummy:SetName(describe)
                    newDummy:SetInputGroup("PassthroughInput")
    
                    Add(newDummy)
                    if dummyItem not= undefined
                        Remove(dummyItem)
                    end
                    dummyItem = newDummy
                    newDummy:Focus()
                end
            end
        end
    end

    action SetFilteredItems(Array<Item> items, boolean moveFocus)
        filteredItems = items

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            elseif highlight is SelectionHighlight2D
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        // Display selection highlighting around the items.
        
        EditorLayer currentLayer = GetSelectedLayer()

        if currentLayer is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item3D item = cast(Item3D, filteredItems:Get(counter))
                SelectionHighlight3D highlight = undefined
                if item is EditorTerrain
                    // A terrain isn't a model, so it has its own highlight.
                    TerrainSelectionHighlight terrainHighlight
                    terrainHighlight:LoadTerrain(cast(EditorTerrain, item), me)
                    highlight = terrainHighlight
                else
                    if item is EditorPointLight
                        PointLightSelectionHighlight light
                        highlight = light
                    elseif item is EditorSpotLight
                        SpotLightSelectionHighlight spot
                        highlight = spot
                    elseif item is EditorAudio3D
                        Audio3DSelectionHighlight light
                        highlight = light
                    else
                        ModelSelectionHighlight model
                        highlight = model
                    end
                    highlight:Load(cast(EditorModel, item), me)
                end
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        else
            EditorLayer2D layer = cast(EditorLayer2D, currentLayer)
            integer counter = 0
            repeat while counter < filteredItems:GetSize()
                Item2D item = cast(Item2D, filteredItems:Get(counter))
                SelectionHighlight2D highlight
                highlight:Load(item, me)
                filterHighlights:Add(highlight)
                layer:Add(highlight)
    
                counter = counter + 1
            end
        end

        SetFilterHighlightData()

        if moveFocus
            if filterHighlights:IsEmpty()
                Focus()
            else
                filterHighlights:Get(0):Focus()
            end
        else
            if filterHighlights:IsEmpty()
                SetSelectedItem(undefined)
            else
                SetSelectedItem(filterHighlights:Get(0))
            end
        end
    end

    private action EmptyFilteredItems(boolean moveFocus)
        filteredItems = undefined

        // Remove previous highlights.
        repeat while filterHighlights:IsEmpty() = false
            SelectionHighlight highlight = filterHighlights:RemoveFromEnd()
            if highlight is SelectionHighlight3D
                SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
                highlight3D:GetLayer():Remove(highlight3D)
            else
                SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
                highlight2D:GetLayer():Remove(highlight2D)
            end
        end

        SetFilterHighlightData()

        if moveFocus
            Focus()
        else
            SetSelectedItem(undefined)
        end
    end

    private action SetFilterHighlightData
        integer counter = 0
        repeat while counter < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(counter)
            Item item = highlight:GetItem()

            if counter = 0
                highlight:SetPreviousFocus(filterHighlights:GetFromEnd())
            else
                highlight:SetPreviousFocus(filterHighlights:Get(counter - 1))
            end

            if counter = filterHighlights:GetSize() - 1
                highlight:SetNextFocus(filterHighlights:GetFromFront())
            else
                highlight:SetNextFocus(filterHighlights:Get(counter + 1))
            end 

            number x = math:Round(item:GetGlobalX(), 2)
            number y = math:Round(item:GetGlobalY(), 2)
            number z = math:Round(item:GetGlobalZ(), 2)

            highlight:SetName(item:GetName())
            highlight:SetDescription((counter + 1) + " of " + filterHighlights:GetSize() + ": " + x + ", " + y + ", " + z)
            counter = counter + 1
        end

        if filterHighlights:IsEmpty() = false
            SetPreviousFocus(filterHighlights:Get(filterHighlights:GetSize() - 1))
            SetNextFocus(filterHighlights:Get(0))
        else
            SetPreviousFocus(undefined)
            SetNextFocus(undefined)
        end
    end

    // Removes the item that is selected by the given highlight, along with the highlight itself.
    action Delete(SelectionHighlight highlight)
        Item nextFocus = undefined

        if highlight:IsFocused()
            // If we're deleting the focused item, move the focus.
            if highlight:GetPreviousFocus() not= undefined and (highlight:GetPreviousFocus():Equals(highlight) = false)
                nextFocus = highlight:GetPreviousFocus()
            else
                SetCursorToItem(highlight)
                nextFocus = me
            end
        end

        EditorLayer resultLayer = undefined

        if highlight is SelectionHighlight3D
            SelectionHighlight3D highlight3D = cast(SelectionHighlight3D, highlight)
            EditorLayer3D layer = cast(EditorLayer3D, highlight3D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight3D)
            layer:Remove(cast(Item3D, highlight3D:GetItem()))
        else
            SelectionHighlight2D highlight2D = cast(SelectionHighlight2D, highlight)
            EditorLayer2D layer = cast(EditorLayer2D, highlight2D:GetLayer())
            resultLayer = layer
            layer:Remove(highlight2D)
            layer:Remove(cast(Item2D, highlight2D:GetItem()))
        end

        integer index = filterHighlights:GetFirstLocation(highlight)
        if index >= 0
            filterHighlights:RemoveAt(index)

            // Refresh filter highlight focus order and descriptions.
            SetFilterHighlightData()
        end

        if nextFocus not= undefined
            nextFocus:Focus()
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, highlight:GetItem())
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, highlight:GetItem(), undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    /*
    This action will delete an item that has been added to the scene.
    */
    action Delete(Item item)
        EditorLayer resultLayer = undefined

        if item is Item2D
            Item2D item2D = cast(Item2D, item)
            EditorLayer2D layer = cast(EditorLayer2D, item2D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item2D)
        elseif item is Item3D
            Item3D item3D = cast(Item3D, item)
            EditorLayer3D layer = cast(EditorLayer3D, item3D:GetLayer())
            resultLayer = layer
            if layer = undefined
                return now
            end
            layer:Remove(item3D)
        end

        integer index = 0
        repeat while index < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(index)
            if highlight:GetItem() = item
                filterHighlights:RemoveAt(index)
                if resultLayer is EditorLayer2D
                    EditorLayer2D layer = cast(EditorLayer2D, resultLayer)
                    layer:Remove(cast(SelectionHighlight2D, highlight))
                elseif resultLayer is EditorLayer3D
                    EditorLayer3D layer = cast(EditorLayer3D, resultLayer)
                    layer:Remove(cast(SelectionHighlight3D, highlight))
                end

                // Manually set the index so we'll escape the loop early.
                index = filterHighlights:GetSize()

                // Refresh filter highlight focus order and descriptions.
                SetFilterHighlightData()
            end

            index = index + 1
        end

        SceneEditorDeleteEdit edit
        edit:Create(me, resultLayer, item)
        editManager:Add(edit)

        SceneEditorChangeEvent event
        event:Set(me, item, undefined, resultLayer, event:REMOVED)
        NotifySceneEditorChangeListeners(event)
    end

    action CreateItemPreview(ItemBlueprint schematic) returns ItemPreview
        return CreateItemPreview(schematic, undefined)
    end

    /*
        Asks for a model file for the palette's Custom Model, and makes a
        palette tile for it if it loads, so it can be seen and placed like
        any other model. ScenePalette's AddProjectModel shows the tile and
        keeps it in the scene (AddCustomModel). It says what
        happened if it can't: no file chosen, a file of the wrong kind, or
        a file that couldn't be read. A model whose longest side is under
        0.25 units or over 500 starts scaled so its longest side is 2 units,
        so its placeholder can be seen; the tile's description says so. A
        picture beside the file with the model's name, such as Car.png,
        becomes the tile's picture.

        Attribute: Parameter custom The palette's Custom Model blueprint
        Attribute: Returns The new tile's blueprint, or undefined if there is none
    */
    action ChooseModelFile(CustomItemBlueprint custom) returns ModelBlueprint
        if custom = undefined
            return undefined
        end
        File project = GetProjectLocation()
        FileChooser chooser
        FileFilter filter
        filter:Add("gltf")
        filter:Add("glb")
        filter:Add("fbx")
        filter:Add("obj")
        filter:Add("g3db")
        filter:SetAcceptAll(false)
        File file = chooser:OpenFileDialog(project, filter)
        if file = undefined
            NotifyAccessibility(me, "No file chosen, so nothing was added.")
            return undefined
        end
        text fileName = file:GetFileName()

        text relativePath = GetProjectPathToFile(file)
        File result
        result:SetWorkingDirectory(project:GetAbsolutePath())
        result:SetPath(relativePath)
        if not custom:IsFileValid(result)
            NotifyAccessibility(me, fileName + " isn't a model file the scene editor can load. Choose a .gltf, .glb, .fbx, .obj or .g3db file.")
            return undefined
        end

        // Loading it once checks it can be read; the loaded model is kept
        // for the placeholder.
        Model test
        test:Load(result)
        if test:GetModelBlueprint() = undefined
            NotifyAccessibility(me, fileName + " couldn't be read as a model.")
            return undefined
        end

        text name = fileName
        text extension = file:GetFileExtension()
        if extension not= "" and name:GetSize() > extension:GetSize() + 1
            name = name:GetSubtext(0, name:GetSize() - extension:GetSize() - 1)
        end
        text description = "A model from " + relativePath + "."

        number scale = 1
        BoundingBox bounds = test:CalculateBoundingBox()
        if bounds:IsValid()
            number longest = math:MaximumOf(bounds:GetWidth(), math:MaximumOf(bounds:GetHeight(), bounds:GetDepth()))
            if longest > 0 and (longest < 0.25 or longest > 500)
                scale = 2 / longest
                if scale >= 10
                    scale = math:Round(scale, 0)
                else
                    scale = math:Round(scale, 2)
                end
                if scale > 1
                    description = description + " It is " + math:Round(longest, 3) + " units long, so it starts " + scale + " times larger. Change Scale in Properties."
                else
                    description = description + " It is " + math:Round(longest, 0) + " units long, so it starts at " + scale + " of its size. Change Scale in Properties."
                end
            end
        end
        return MakeCustomModelTile(name, relativePath, scale, description)
    end

    /*
        Makes the palette tile for a model file added with Custom Model. A
        picture beside the file with the model's name, such as Car.png,
        becomes its picture.

        Attribute: Parameter name The tile's name
        Attribute: Parameter path The model file, from the project's folder
        Attribute: Parameter scale The scale a placed copy starts with
        Attribute: Parameter description The tile's description
        Attribute: Returns The tile's blueprint
    */
    action MakeCustomModelTile(text name, text path, number scale, text description) returns ModelBlueprint
        File project = GetProjectLocation()
        File modelFile
        if project not= undefined
            modelFile:SetWorkingDirectory(project:GetAbsolutePath())
        end
        modelFile:SetPath(path)

        SceneProperties modelProperties
        ModelBlueprint tile
        tile:SetName(name)
        tile:SetModelType(modelProperties:CUSTOM)
        tile:SetModelFile(modelFile)
        tile:SetDimensions(1, 1, 1)
        tile:SetRotation(0, 0, 0)
        tile:SetScale(scale, scale, scale)
        tile:SetDescription(description)

        File picture
        picture:SetPath(modelFile:GetParentDirectory():GetAbsolutePath() + "/" + name + ".png")
        if picture:Exists()
            Drawable icon
            icon:Load(picture)
            tile:SetPaletteIcon(icon)
            tile:SetPaletteIconFile(picture)
        end
        return tile
    end

    /*
        Adds a model added with Custom Model to the scene's list, which is
        saved in the scene's file and shown first in the palette. A model of
        the same name replaces the one before.

        Attribute: Parameter model The model's tile
    */
    action AddCustomModel(ModelBlueprint model)
        if model = undefined
            return now
        end
        integer i = 0
        repeat while i < customModels:GetSize()
            if customModels:Get(i):GetName() = model:GetName()
                customModels:RemoveAt(i)
            else
                i = i + 1
            end
        end
        customModels:Add(model)
    end

    /*
        Returns the models added to this scene's palette with Custom Model.

        Attribute: Returns The models' tiles
    */
    action GetCustomModels returns Array<ModelBlueprint>
        return customModels
    end

    /*
        Writes the scene's custom models: one entry each, by number, with
        its name, file, starting scale and description.
    */
    private action SaveCustomModels returns JavaScriptObjectNotation
        JavaScriptObjectNotation json
        integer i = 0
        repeat while i < customModels:GetSize()
            ModelBlueprint model = customModels:Get(i)
            JavaScriptObjectNotation entry
            entry:Add(properties:NAME, model:GetName())
            File modelFile = model:GetModelFile()
            if modelFile not= undefined
                entry:Add(properties:FILE, modelFile:GetPath())
            end
            entry:Add("Scale", model:GetScaleX())
            entry:Add(properties:DESCRIPTION, model:GetDescription())
            json:Add("" + i, entry)
            i = i + 1
        end
        return json
    end

    /*
        Reads the scene's custom models, as SaveCustomModels writes them. A
        model whose file is gone is left out and logged.
    */
    private action LoadCustomModels(JavaScriptObjectNotation data)
        customModels:Empty()
        if data = undefined
            return now
        end
        JavaScriptObjectNotation list = data:GetObject(properties:CUSTOM_MODELS)
        if list = undefined
            return now
        end
        Iterator<JavaScriptObjectNotation> entries = list:GetIterator()
        repeat while entries:HasNext()
            JavaScriptObjectNotation entry = entries:Next()
            if entry:HasValue(properties:NAME) and entry:HasValue(properties:FILE)
                text name = entry:GetValue(properties:NAME)
                text path = entry:GetValue(properties:FILE)
                number scale = 1
                Iterator<JavaScriptObjectNotation> values = entry:GetIterator()
                repeat while values:HasNext()
                    JavaScriptObjectNotation value = values:Next()
                    if value:GetKey() = "Scale"
                        if value:IsInteger()
                            scale = value:GetInteger()
                        elseif value:IsNumber()
                            scale = value:GetNumber()
                        end
                    end
                end
                text description = ""
                if entry:HasValue(properties:DESCRIPTION)
                    description = entry:GetValue(properties:DESCRIPTION)
                end
                ModelBlueprint tile = MakeCustomModelTile(name, path, scale, description)
                if tile:GetModelFile():Exists()
                    customModels:Add(tile)
                else
                    SharedLogger logger
                    logger:Log("The scene's custom model " + name + " is at " + path + ", which wasn't found, so it is left out of the palette.")
                end
            end
        end
    end

    /*
        Asks for the file of a palette item that needs one, such as Custom
        Model, and starts placing it, saying what happened either way: no
        file chosen, a file of the wrong kind, a file that couldn't be read,
        or the item being placed. For a model, the chooser lists only the
        model files the loader reads.

        Attribute: Parameter custom The palette item's blueprint
        Attribute: Returns The placeholder being placed, or undefined if there is none
    */
    action AddCustomItem(CustomItemBlueprint custom) returns ItemPreview
        if custom = undefined
            return undefined
        end
        File project = GetProjectLocation()
        FileChooser chooser
        File file = undefined
        if custom is CustomModelBlueprint
            FileFilter filter
            filter:Add("gltf")
            filter:Add("glb")
            filter:Add("fbx")
            filter:Add("obj")
            filter:Add("g3db")
            filter:SetAcceptAll(false)
            file = chooser:OpenFileDialog(project, filter)
        else
            file = chooser:OpenFileDialog(project)
        end
        if file = undefined
            NotifyAccessibility(me, "No file chosen, so nothing was added.")
            return undefined
        end

        text relativePath = GetProjectPathToFile(file)
        File result
        result:SetWorkingDirectory(project:GetAbsolutePath())
        result:SetPath(relativePath)

        if not custom:IsFileValid(result)
            if custom is CustomModelBlueprint
                NotifyAccessibility(me, file:GetFileName() + " isn't a model file the scene editor can load. Choose a .gltf, .glb, .fbx, .obj or .g3db file.")
            else
                NotifyAccessibility(me, file:GetFileName() + " can't be used for " + custom:GetName() + ".")
            end
            return undefined
        end
        ItemPreview preview = CreateItemPreview(custom, result)
        if preview not= undefined
            BeginPlacingCopies()
        end
        return preview
    end

    action CreateItemPreview(ItemBlueprint schematic, File asset) returns ItemPreview
        // A placeholder already being placed ends first, so its settings,
        // such as its scale and color, are kept for this one. While the
        // focus is in the Properties panel, as after typing a size or
        // choosing a color, the placeholder doesn't lose the focus when
        // another palette item is chosen, so nothing else ends it.
        if HasActivePreview()
            CancelItemPreview(activePreview)
        end

        // Set again below if the new item starts at the terrain cursor. The
        // terrain is recorded now, before the preview takes the focus.
        placementTerrain = undefined
        previewStartTerrain = cursorTerrain

        // A terrain has no preview to place: it is added flat, at the
        // origin, at once.
        if schematic is TerrainBlueprint
            AddTerrain(cast(TerrainBlueprint, schematic))
            return undefined
        end

        if schematic is DrawableBlueprint
            DrawableBlueprint drawableBlueprint = cast(DrawableBlueprint, schematic)
            if not (GetSelectedLayer() is EditorLayer2D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer2D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())

            if drawableBlueprint:GetPreferredGridWidth() not= 0 and drawableBlueprint:GetPreferredGridHeight() not= 0
                // TO-DO: Consider both width and height when setting grid unit size.
                layer:SetGridUnitSize(drawableBlueprint:GetPreferredGridWidth())
                layer:UpdateGridPosition()
            end

            ItemPreview2D preview
            preview:Load(me, drawableBlueprint)
            // TO-DO: Position preview to match cursor

            layer:Add(preview)
            preview:Focus()
            return preview
        elseif schematic is ModelBlueprint or schematic is PointLightBlueprint or schematic is SpotLightBlueprint or schematic is Audio3DBlueprint
            
            if not (GetSelectedLayer() is EditorLayer3D)
                integer counter = 0
                boolean found = false
                repeat while counter < layers:GetSize()
                    EditorLayer layer = layers:Get(counter)
                    if layer is EditorLayer3D
                        SetSelectedLayer(layer)
                        counter = layers:GetSize()
                        found = true
                    end
                    counter = counter + 1
                end

                if not found
                    return undefined
                end
            end

            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())

            // TO-DO: Consider modifying grid size for 3D objects here, same as with 2D objects above.

            ItemPreview3D preview = undefined
            if asset = undefined
                if schematic is ModelBlueprint
                    ModelPreview modelPreview
                    preview = modelPreview
                    ModelBlueprint modelBlueprint = cast(ModelBlueprint, schematic)
                    // A custom model needs its file first (AddCustomItem).
                    if schematic is CustomModelBlueprint
                        NotifyAccessibility(me, "Choose " + schematic:GetName() + " with a click or Enter to pick its file.")
                        return undefined
                    end
                    modelPreview:Load(me, modelBlueprint)
                    if modelBlueprint:GetModelType() = properties:CUSTOM and modelPreview:GetModelBlueprint() = undefined
                        NotifyAccessibility(me, schematic:GetName() + " couldn't be read as a model.")
                        return undefined
                    end
                elseif schematic is PointLightBlueprint
                    PointLightPreview lightPreview
                    preview = lightPreview
                    PointLightBlueprint lightBlueprint = cast(PointLightBlueprint, schematic)
                    lightPreview:Load(me, lightBlueprint)
                elseif schematic is SpotLightBlueprint
                    SpotLightPreview spotPreview
                    preview = spotPreview
                    SpotLightBlueprint spotBlueprint = cast(SpotLightBlueprint, schematic)
                    spotPreview:Load(me, spotBlueprint)
                else
                    Audio3DPreview audioPreview
                    preview = audioPreview
                    Audio3DBlueprint audioBlueprint = cast(Audio3DBlueprint, schematic)
                    audioPreview:Load(me, audioBlueprint)
                end
            else
                if schematic is Custom3DPrimitiveBlueprint
                    Custom3DPrimitivePreview primitivePreview
                    preview = primitivePreview
                    Custom3DPrimitiveBlueprint primitiveBlueprint = cast(Custom3DPrimitiveBlueprint, schematic)
                    primitivePreview:Load(me, primitiveBlueprint, asset)
                elseif schematic is CustomModelBlueprint
                    CustomModelBlueprint newBlueprint = cast(CustomModelBlueprint, schematic)
                    newBlueprint:SetFile(asset)
                    ModelPreview modelPreview
                    preview = modelPreview
                    modelPreview:Load(me, newBlueprint)
                    if modelPreview:GetModelBlueprint() = undefined
                        NotifyAccessibility(me, asset:GetFileName() + " couldn't be read as a model.")
                        return undefined
                    end
                end
            end

            layer:Add(preview)
            // A new item starts on the ground, if a terrain is there. This
            // runs before the preview gets the focus, which ends the
            // terrain's selection, while the terrain cursor is still known.
            text groundMessage = StartPreviewOnGround(preview)
            activePreview = preview
            // Every new item from the palette, by a click, Enter, a double
            // click or a drag, starts with the last placeholder's settings,
            // such as its scale, so they are set once for many items.
            ApplyPlacementSettings(preview)
            preview:Focus()
            if groundMessage not= ""
                NotifyAccessibility(preview, groundMessage)
            end
            return preview
        end
        return undefined
    end

    action CancelItemPreview(ItemPreview preview)
        // Taken from the layer it is in, if it is still in one: it may have
        // been taken out already (placed, or canceled before), and the
        // selected layer may have changed since it was added.
        if preview is ItemPreview3D
            ItemPreview3D preview3D = cast(ItemPreview3D, preview)
            Layer3D own3D = preview3D:GetLayer()
            if own3D not= undefined
                own3D:Remove(preview3D)
            end
        else
            ItemPreview2D preview2D = cast(ItemPreview2D, preview)
            Layer2D own2D = preview2D:GetLayer()
            if own2D not= undefined
                own2D:Remove(preview2D)
            end
        end
        // Only the placeholder being placed now is ended. An older one can
        // be canceled after a new one is made, such as when the old one
        // loses the focus to the new one; ending the new one then left it
        // in the scene, untracked, as a ghost.
        if activePreview not= undefined and not activePreview:Equals(preview)
            return now
        end
        EndActivePreview()
        ReleasePlacementRing()
    end

    /*
    This action forgets the new item's preview being placed, and takes its
    ghost away, once it is placed or canceled.
    */
    private action EndActivePreview
        // The next placeholder from the palette starts with these settings,
        // however this one ended: placed, canceled, or left for another.
        if activePreview not= undefined
            RememberPlacementSettings(activePreview)
        end
        activePreview = undefined
        previewInProperties = false
        placingCopies = false
        ShowPlacementStatus("")
        if previewGhost not= undefined
            // From the layer it is in, even if another layer is selected now.
            Layer3D ghostLayer = previewGhost:GetLayer()
            if ghostLayer not= undefined
                ghostLayer:Remove(previewGhost)
            end
            previewGhost:Dispose()
            previewGhost = undefined
        end
        previewGhostShown = false
    end

    /*
    This action notes that the focus went from the new item's preview into
    the Properties panel, so the next click in the view only returns to it.
    ItemPreview calls it.
    */
    action PreviewWentToProperties
        if HasActivePreview()
            previewInProperties = true
        end
    end

    /*
    This action returns true while a new item's preview is being placed in
    the 3D view.

    Attribute: Returns True while a preview is out
    */
    action HasActivePreview returns boolean
        return activePreview not= undefined and GetSelectedLayer() is EditorLayer3D
    end

    /*
    This action returns where the pointer points, for moving a preview: the
    ground of the nearest terrain under it, or else the level plane at a
    height. It returns undefined if the pointer points away from the plane.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    Attribute: Parameter height The plane's height, when no ground is under the pointer
    Attribute: Returns The point
    */
    private action PickPreviewPoint(number x, number y, number height) returns Vector3
        Vector3 ground = PickGround(x, y)
        if ground not= undefined
            return ground
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
        EditorCamera3D camera = layer3D:GetEditorCamera()
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray ray = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        Vector3 origin = ray:GetOrigin()
        Vector3 direction = ray:GetDirection()
        if math:AbsoluteValue(direction:GetY()) < 0.0001
            return undefined
        end
        number distance = (height - origin:GetY()) / direction:GetY()
        if distance <= 0
            return undefined
        end
        Vector3 point
        point:Set(origin:GetX() + direction:GetX() * distance, height, origin:GetZ() + direction:GetZ() * distance)
        return point
    end

    /*
    This action returns true if a point is on the preview, seen from above:
    within half its larger width or depth of its middle, and at least half
    a unit.
    */
    private action IsOnPreview(Vector3 point) returns boolean
        number half = activePreview:GetWidth() * activePreview:GetScaleX()
        number depthAcross = activePreview:GetDepth() * activePreview:GetScaleZ()
        if depthAcross > half
            half = depthAcross
        end
        half = half / 2
        if half < 0.5
            half = 0.5
        end
        number offsetX = point:GetX() - activePreview:GetGlobalX()
        number offsetZ = point:GetZ() - activePreview:GetGlobalZ()
        return offsetX * offsetX + offsetZ * offsetZ <= half * half
    end

    /*
    This action handles a click in the 3D view while a new item's preview
    is out: on the preview it places it, as Enter does; anywhere else it
    moves the preview there, on the ground if a terrain is under the
    pointer, or at its height if not. The preview keeps the focus.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action PressPreview(number x, number y)
        if not HasActivePreview()
            return now
        end
        // Back from the Properties panel: the first click only returns to
        // the preview, with its settings, where it was.
        if previewInProperties
            previewInProperties = false
            activePreview:Focus()
            NotifyAccessibility(activePreview, "Back to " + activePreview:GetName())
            return now
        end
        // Placing copies: every click places a copy where the pointer is.
        if placingCopies
            if MovePreviewToPointer(x, y)
                PlaceCopyOfPreview(activePreview)
            else
                activePreview:Focus()
            end
            return now
        end
        Vector3 point = PickPreviewPoint(x, y, activePreview:GetGlobalY())
        if point = undefined
            activePreview:Focus()
            return now
        end
        if IsOnPreview(point)
            ItemPreview3D placing = activePreview
            ConfirmItemPreview(placing)
            return now
        end
        HidePreviewGhost()
        activePreview:SetPosition(point:GetX(), activePreview:GetY(), point:GetZ())
        text message = "Moved " + activePreview:GetName()
        if PutOnGround(activePreview, activePreview)
            message = message + " onto " + lastGround:GetName()
        end
        // A preview started at a terrain's cursor takes the cursor with it.
        if placementTerrain not= undefined and placementTerrain = cursorTerrain
            placementTerrain:SetBrushPosition(activePreview:GetGlobalX(), activePreview:GetGlobalZ())
            UpdateBrushPreview()
        end
        activePreview:Focus()
        NotifyAccessibility(activePreview, message)
    end

    /*
    This action follows the pointer while a new item's preview is out: a
    fainter ghost of the preview shows where a click would move it, on the
    ground if a terrain is under the pointer. Over the preview itself, where
    a click places it, the ghost hides.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action MovePreviewGhostToPointer(number x, number y)
        if not HasActivePreview()
            HidePreviewGhost()
            return now
        end
        // Placing copies: the placeholder itself follows the pointer.
        if placingCopies
            HidePreviewGhost()
            // While the focus is in the Properties panel, the placeholder
            // waits, so the panel's numbers aren't changed under the typing.
            if not previewInProperties
                MovePreviewToPointer(x, y)
            end
            return now
        end
        Vector3 point = PickPreviewPoint(x, y, activePreview:GetGlobalY())
        if point = undefined or IsOnPreview(point)
            HidePreviewGhost()
            return now
        end
        if previewGhost = undefined
            if activePreview:GetModelBlueprint() = undefined
                return now
            end
            EditorModel ghost
            ghost:Load(activePreview:GetModelBlueprint())
            ghost:SetName("Placement Ghost")
            ghost:SetProperty(constants:EDITOR_TAG, undefined)
            ghost:SetAcceptsMouseInput(false)
            ghost:SetCastsShadows(false)
            ghost:SetScale(activePreview:GetScaleX(), activePreview:GetScaleY(), activePreview:GetScaleZ())
            ghost:SetRotation(activePreview:GetYaw(), activePreview:GetPitch(), activePreview:GetRoll())
            Color shade = activePreview:GetColor()
            if shade not= undefined
                Color faint = shade:Copy()
                faint:SetAlpha(shade:GetAlpha() * GHOST_ALPHA_SHARE)
                ghost:SetColor(faint)
            end
            previewGhost = ghost
            EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
            layer3D:Add(ghost)
            previewGhostShown = true
        end
        previewGhost:SetPosition(point:GetX(), activePreview:GetGlobalY(), point:GetZ())
        // The ghost isn't a scene item, so it moves itself by the same
        // ground rule PutOnGround uses: its base onto the ground.
        number groundChange = GetGroundChange(previewGhost)
        if lastGround not= undefined and groundChange not= 0
            previewGhost:MoveY(groundChange)
        end
        if not previewGhostShown
            previewGhost:Show()
            previewGhostShown = true
        end
    end

    /*
    This action starts multiple placement for the new item's placeholder
    just made from the palette (with Enter or a double click): the
    placeholder follows the pointer, and each click, or Enter, places a copy
    where it is, until Escape or the focus leaving the scene editor and the
    Properties panel. The placeholder's settings in the Properties panel,
    such as its scale and rotation, are kept for every copy.
    PaletteCreatePreviewBehavior calls it.
    */
    action BeginPlacingCopies
        if not HasActivePreview()
            return now
        end
        placingCopies = true
        ShowPlacementStatus("Placing copies of " + activePreview:GetName() + " (Esc to stop)")
        NotifyAccessibility(activePreview, "Placing copies of " + activePreview:GetName() +
            ". Click or press Enter to place one, Escape to stop.")
    end

    /*
    This action sets the line, outside the editor, that says what a click
    places while copies are being placed, such as one above Studio's scene
    palette. The editor shows it then and hides it otherwise. Undefined, the
    default, shows nothing.

    Attribute: Parameter label The line to show the status on, or undefined.
    */
    action SetPlacementStatusLabel(Label label)
        if placementStatusLabel not= undefined and placementStatusLabel not= label
            ShowPlacementStatus("")
        end
        placementStatusLabel = label
        if placingCopies and activePreview not= undefined
            ShowPlacementStatus("Placing copies of " + activePreview:GetName() + " (Esc to stop)")
        else
            ShowPlacementStatus("")
        end
    end

    /*
    This action returns the line that says what a click places while copies
    are being placed, or undefined if none is set.

    Attribute: Returns The status line, or undefined.
    */
    action GetPlacementStatusLabel returns Label
        return placementStatusLabel
    end

    /*
    Shows words on the placement status line, or hides it for "".
    */
    private action ShowPlacementStatus(text words)
        if placementStatusLabel = undefined
            return now
        end
        if words = ""
            if placementStatusLabel:IsShowing()
                placementStatusLabel:Hide()
            else
                return now
            end
        else
            placementStatusLabel:SetText(words)
            placementStatusLabel:Show()
        end
        Item2D column = placementStatusLabel:GetParent()
        if column not= undefined and column is Control
            Control container = cast(Control, column)
            container:RequestLayout()
        end
    end

    /*
    This action keeps a placeholder's settings for the next one from the
    palette.
    */
    private action RememberPlacementSettings(ItemPreview3D preview)
        placementScaleX = preview:GetScaleX()
        placementScaleY = preview:GetScaleY()
        placementScaleZ = preview:GetScaleZ()
        placementYaw = preview:GetYaw()
        placementPitch = preview:GetPitch()
        placementRoll = preview:GetRoll()
        placementFollowGround = preview:IsFollowingGround()
        placementLeanWithSlope = preview:IsLeaningWithSlope()
        placementPhysicsEnabled = preview:IsEditorPhysicsEnabled()
        placementResponsiveness = preview:GetEditorResponsiveness()
        placementMass = preview:GetEditorMass()
        placementFriction = preview:GetEditorFriction()
        placementRestitution = preview:GetEditorRestitution()
        placementColorOverridden = preview:IsColorOverridden()
        placementColor = undefined
        if preview:GetColor() not= undefined
            placementColor = preview:GetColor():Copy()
        end
        hasPlacementSettings = true
    end

    /*
    This action gives a new placeholder from the palette the settings the
    last one had, then sets it on the ground again at its new size.
    */
    private action ApplyPlacementSettings(ItemPreview3D preview)
        if not hasPlacementSettings
            return now
        end
        preview:SetScale(placementScaleX, placementScaleY, placementScaleZ)
        preview:SetRotation(placementYaw, placementPitch, placementRoll)
        preview:SetFollowingGround(placementFollowGround)
        preview:SetLeaningWithSlope(placementLeanWithSlope)
        preview:SetEditorPhysicsEnabled(placementPhysicsEnabled)
        if placementPhysicsEnabled
            preview:SetEditorResponsiveness(placementResponsiveness)
            preview:SetEditorMass(placementMass)
            preview:SetEditorFriction(placementFriction)
            preview:SetEditorRestitution(placementRestitution)
        end
        if placementColorOverridden and placementColor not= undefined
            // The placeholder stays see-through, as it was made.
            Color chosen = placementColor:Copy()
            if preview:GetColor() not= undefined
                chosen:SetAlpha(preview:GetColor():GetAlpha())
            end
            preview:OverrideColor(chosen)
        end
        boolean onGround = PutOnGround(preview, preview)
        UpdateActivePropertiesDialog(preview)
    end

    /*
    This action gives a placed item the placeholder's physics settings,
    which turning it into a model doesn't carry over.
    */
    private action CopyPlacementPhysics(ItemPreview3D preview, Item placed)
        if not (placed is EditorItem)
            return now
        end
        // EditorItem is an interface, so it is cast through Object.
        Object placedObject = placed
        EditorItem item = cast(EditorItem, placedObject)
        item:SetEditorPhysicsEnabled(preview:IsEditorPhysicsEnabled())
        if preview:IsEditorPhysicsEnabled()
            item:SetEditorResponsiveness(preview:GetEditorResponsiveness())
            item:SetEditorMass(preview:GetEditorMass())
            item:SetEditorFriction(preview:GetEditorFriction())
            item:SetEditorRestitution(preview:GetEditorRestitution())
        end
    end

    /*
    This action returns true while the placeholder places copies (multiple
    placement).

    Attribute: Returns True while placing copies
    */
    action IsPlacingCopies returns boolean
        return HasActivePreview() and placingCopies
    end

    /*
    This action returns true while a copy of the placeholder is being
    placed, so the placeholder doesn't end if the focus moves for a moment.
    ItemPreview's LostFocus asks.

    Attribute: Returns True while a copy is being placed
    */
    action IsPlacingCopyNow returns boolean
        return placingCopyNow
    end

    /*
    This action moves the placeholder to where the pointer points: onto the
    ground of the nearest terrain, leaning with its slope if the
    placeholder's "Lean with the slope" is on, or at its own height off the
    ground. It returns false, and leaves the placeholder where it is, if the
    pointer points at nothing.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    Attribute: Returns True if the placeholder moved
    */
    private action MovePreviewToPointer(number x, number y) returns boolean
        Vector3 point = PickPreviewPoint(x, y, activePreview:GetGlobalY())
        if point = undefined
            return false
        end
        activePreview:SetPosition(point:GetX(), activePreview:GetY(), point:GetZ())
        if PutOnGround(activePreview, activePreview) and activePreview:IsLeaningWithSlope()
            LeanWithGround(activePreview, lastGround)
            // Leaning moves its base, so it is set on the ground again.
            boolean again = PutOnGround(activePreview, activePreview)
        end
        return true
    end

    /*
    This action leans the placeholder with the ground under it, as foliage
    leans with the slope: its up direction becomes the ground's, under its
    own yaw. Its pitch and roll come from the ground; its yaw and scale stay
    as set.

    Attribute: Parameter preview The placeholder
    Attribute: Parameter terrain The terrain under it
    */
    private action LeanWithGround(ItemPreview3D preview, EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number x = preview:GetGlobalX()
        number z = preview:GetGlobalZ()
        if not data:HasHeight(x, z)
            return now
        end
        Vector3 normal = data:GetNormal(x, z)
        // The ground's up direction in the placeholder's own frame, after
        // its yaw.
        number yawRadians = preview:GetYaw() * math:pi / 180
        number cosine = math:Cosine(yawRadians)
        number sine = math:Sine(yawRadians)
        number localX = normal:GetX() * cosine - normal:GetZ() * sine
        number localY = normal:GetY()
        number localZ = normal:GetX() * sine + normal:GetZ() * cosine
        if localY <= 0.0001
            return now
        end
        // Forward and back is the pitch, side to side the roll. If a copy
        // leans away from the slope instead of with it, the sign of one of
        // these is the one to change.
        number pitch = math:InverseTangent(localZ / localY) * 180 / math:pi
        if localX > 1
            localX = 1
        elseif localX < -1
            localX = -1
        end
        number roll = -math:InverseSine(localX) * 180 / math:pi
        preview:SetRotation(preview:GetYaw(), pitch, roll)
    end

    /*
    This action places a copy of the placeholder where it is, while placing
    copies: the copy gets the placeholder's name, scale, rotation and color,
    is announced and can be undone, and the placeholder stays out, with the
    next name and the focus, for more copies. Nothing is selected, so the
    camera stays where it is.

    Attribute: Parameter preview The placeholder
    */
    action PlaceCopyOfPreview(ItemPreview3D preview)
        if preview = undefined or not (GetSelectedLayer() is EditorLayer3D)
            return now
        end
        placingCopyNow = true
        if preview:GetItemBlueprint() not= undefined
            IncrementNameCount(preview:GetItemBlueprint():GetName())
        end
        Model model = preview:ConvertToModel()
        // Through the setter: the field is declared further down the file.
        SetPreviewTransform(preview:GetTransform())
        EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
        layer:Add(model)
        CopyPlacementPhysics(preview, model)

        text message = "Placed " + model:GetName()
        if lastGround not= undefined
            message = message + " on " + lastGround:GetName()
        end
        NotifyAccessibility(preview, message)

        SceneEditorChangeEvent event
        event:Set(me, model, undefined, layer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        if preview:GetItemBlueprint() not= undefined
            text name = preview:GetItemBlueprint():GetName()
            preview:SetName(name + GetNextNamePostfix(name))
        end

        SceneEditorInsertEdit edit
        edit:Create(me, layer, model)
        editManager:Add(edit)
        placingCopyNow = false
        preview:Focus()
    end

    /*
    This action hides the preview's ghost.
    */
    action HidePreviewGhost
        if previewGhost not= undefined and previewGhostShown
            previewGhost:Hide()
        end
        previewGhostShown = false
    end

    /*
    This action hides the ring a new item's preview kept shown, once the
    preview is placed or canceled, unless its terrain is selected again
    (ReturnToPlacementTerrain shows it again then).
    */
    private action ReleasePlacementRing
        if cursorTerrain not= undefined and cursorTerrain = placementTerrain and not (GetSelectedItem() is TerrainSelectionHighlight)
            cursorTerrain = undefined
            UpdateBrushPreview()
        end
    end

    /*
    This action adds a new, flat terrain to the scene's 3D layer. Its files
    are saved at once into the project, in a new folder under the project's
    Scenes folder, Scenes/Terrains/Terrain1 (then Terrain2, and so on), and
    the scene refers to its terrain.json. It
    is then selected and announced. Adding it can be undone. A terrain needs
    Vulkan, and a scene that is in a project.

    Attribute: Parameter schematic The terrain's blueprint, from the palette.
    Attribute: Returns The terrain, or undefined if it couldn't be added.
    */
    action AddTerrain(TerrainBlueprint schematic) returns EditorTerrain
        if not (manager:GetGameGraphics() is VulkanGraphics)
            NotifyAccessibility(me, "A terrain needs Vulkan, so it can't be added here.")
            return undefined
        end
        if projectLocation = undefined
            NotifyAccessibility(me, "A terrain is saved in the scene's project, but this scene isn't in a project.")
            return undefined
        end
        EditorLayer3D layer = FindLayer3D()
        if layer = undefined
            NotifyAccessibility(me, "A terrain needs a 3D layer, and this scene has none.")
            return undefined
        end

        // The first free folder: Scenes/Terrains/Terrain1, then Terrain2, ...
        // A scene's own files go under the project's Scenes folder.
        text terrainsPath = properties:SCENES_FOLDER + "/" + properties:TERRAINS_FOLDER + "/Terrain"
        text folderPath = ""
        integer count = 1
        repeat while folderPath = ""
            File candidateFolder
            candidateFolder:SetWorkingDirectory(projectLocation:GetAbsolutePath())
            candidateFolder:SetPath(terrainsPath + count)
            if not candidateFolder:Exists()
                folderPath = terrainsPath + count
            end
            count = count + 1
        end
        File terrainFile
        terrainFile:SetWorkingDirectory(projectLocation:GetAbsolutePath())
        terrainFile:SetPath(folderPath + "/terrain.json")

        EditorTerrain terrain
        terrain:SetSceneEditor(me)
        text name = schematic:GetName()
        terrain:SetName(name + GetNextNamePostfix(name))
        IncrementNameCount(name)
        terrain:SetDescription(schematic:GetDescription())
        terrain:CreateFlat(terrainFile, schematic:GetRegionsAcross(), schematic:GetRegionSize(), schematic:GetVertexSpacing())

        Add(layer, terrain)
        Array<Item> selected
        selected:Add(terrain)
        SetFilteredItems(selected, true)

        number width = schematic:GetRegionsAcross() * schematic:GetRegionSize() * schematic:GetVertexSpacing()
        NotifyAccessibility(terrain, "Placed " + terrain:GetName() + ", flat, " + width + " by " + width +
            " units, saved in " + folderPath + ".")
        return terrain
    end

    /*
    This action makes a 3D layer the selected layer, if it isn't already,
    and returns it.

    Attribute: Returns The 3D layer, or undefined if the scene has none.
    */
    private action FindLayer3D returns EditorLayer3D
        if GetSelectedLayer() is EditorLayer3D
            return cast(EditorLayer3D, GetSelectedLayer())
        end
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer layer = layers:Get(counter)
            if layer is EditorLayer3D
                SetSelectedLayer(layer)
                return cast(EditorLayer3D, layer)
            end
            counter = counter + 1
        end
        return undefined
    end

    /*
    This action chooses a terrain's tool, by its number (1 raise, 2 lower,
    3 smooth, 4 flatten, 5 ramp, 6 paint, 7 blend paint, 8 add region,
    9 remove region, 10 stamp, 11 erode, 12 auto paint, 13 foliage), or 0
    to leave the tool. With a tool chosen, a
    ring shows the brush on the ground; the arrow keys and the pointer move
    it, and the size keys size it. The region tools show region slots and
    a placeholder instead of the ring (PressRegionTool). A stroke going on is finished first. It is
    announced, and the Brush section of the Properties panel follows.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter tool The tool's number, from 0 to 16
    */
    action SetTerrainTool(EditorTerrain terrain, integer tool)
        if terrain = undefined
            return now
        end
        // A stroke going on is finished first, so it can be undone.
        if stroking
            EndTerrainStroke()
        end
        // A river being drawn is left, unfinished.
        LeaveRiverTool()
        if brushTerrain not= undefined and brushTerrain not= terrain
            brushTerrain:SetToolNumber(0)
        end
        terrain:SetToolNumber(tool)
        if tool = terrain:RIVER_TOOL
            brushTerrain = terrain
            ShowAllRiverLines(terrain)
            NotifyAccessibility(terrain, "River tool. " + DescribeRiversForTool(terrain) + "Click, or press Space, to start a river and add its points; press Enter to finish it, or Escape to stop. " + terrain:DescribeBrush())
        elseif tool = 8 or tool = 9
            // The region tools work with whole regions, through a
            // placeholder, whatever the brush's size.
            brushTerrain = terrain
            text verb = "add"
            if tool = 9
                verb = "remove"
            end
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " tool. Click a region slot, or use the brush, to put down a placeholder. " +
                "Drag its edges, or use the size keys, to resize it, then click inside it to " + verb + " the regions.")
        elseif tool > 0
            brushTerrain = terrain
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " tool. " + terrain:DescribeBrush())
        else
            brushTerrain = undefined
            NotifyAccessibility(terrain, "No tool. The arrow keys move the terrain cursor.")
        end
        UpdateBrushPreview()
        TerrainBrushChanged(terrain)
    end

    /*
    This action returns the terrain whose tool is chosen, or undefined.

    Attribute: Returns The terrain with a tool chosen
    */
    action GetBrushTerrain returns EditorTerrain
        return brushTerrain
    end

    /*
    This action returns true while a terrain's tool is chosen, so the arrow
    keys, the pointer and clicks act on its brush.

    Attribute: Returns True while a terrain's brush is in use
    */
    action IsTerrainBrushActive returns boolean
        return brushTerrain not= undefined and brushTerrain:HasTool()
    end

    /*
    This action moves a terrain's brush by a selection move: right along the
    camera's right, and forward along the way the camera faces, flat on the
    ground.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter right How far to the camera's right, as the selection would move along x
    Attribute: Parameter forward How far forward, as the selection would move along -z
    */
    action MoveTerrainBrush(EditorTerrain terrain, number right, number forward)
        // A move of nothing, such as a Set to the same place, leaves the
        // cursor, and the camera, where they are.
        if terrain = undefined or (right = 0 and forward = 0)
            return now
        end
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        Camera camera = layer:GetCamera()
        Vector3 direction = camera:GetDirection()
        number forwardX = direction:GetX()
        number forwardZ = direction:GetZ()
        number flat = math:SquareRoot(forwardX * forwardX + forwardZ * forwardZ)
        if flat < 0.0001
            // Looking straight down: forward is the camera's up.
            Vector3 up = camera:GetUp()
            forwardX = up:GetX()
            forwardZ = up:GetZ()
            flat = math:SquareRoot(forwardX * forwardX + forwardZ * forwardZ)
            if flat < 0.0001
                return now
            end
        end
        forwardX = forwardX / flat
        forwardZ = forwardZ / flat
        // In Quorum's left-handed world, the right of forward (x, z) is (z, -x).
        number rightX = forwardZ
        number rightZ = -forwardX
        // The move already holds the selection's speed and the frame's
        // time, so this glides R units a second for a brush of size R.
        number speed = terrain:GetBrush():GetSize() * CURSOR_GLIDE_RATE / SELECTION_DIRECTIONAL_SPEED_3D
        number x = terrain:GetBrushX() + (rightX * right + forwardX * forward) * speed
        number z = terrain:GetBrushZ() + (rightZ * right + forwardZ * forward) * speed
        // With the grid off, the cursor glides while a key is held.
        MoveTerrainCursorTo(terrain, x, z)
    end

    /*
    This action gives the terrain cursor the focus, when a terrain's
    highlight gets it: the cursor is placed if it has no place yet, at the
    ground in the middle of the view or the terrain's middle; its ring
    shows; and the camera follows it from where it is. A tool the user had
    chosen when they last left this terrain is chosen again.

    Attribute: Parameter highlight The terrain's highlight
    */
    action FocusTerrainCursor(TerrainSelectionHighlight highlight)
        EditorTerrain terrain = highlight:GetEditorTerrain()
        if terrain = undefined
            return now
        end
        if not terrain:IsBrushPlaced()
            EditorLayer layer = GetSelectedLayer()
            Vector3 hit = undefined
            if layer is EditorLayer3D
                EditorLayer3D layer3D = cast(EditorLayer3D, layer)
                EditorCamera3D camera = layer3D:GetEditorCamera()
                hit = PickTerrainGround(terrain, GetGlobalX() + camera:GetWidth() / 2, GetGlobalY() + camera:GetHeight() / 2)
            end
            if hit not= undefined
                terrain:SetBrushPosition(hit:GetX(), hit:GetZ())
            else
                terrain:SetBrushPosition((terrain:GetMinimumX() + terrain:GetMaximumX()) / 2, (terrain:GetMinimumZ() + terrain:GetMaximumZ()) / 2)
            end
        end
        cursorTerrain = terrain
        terrainCursorAtEdge = false
        // The tool chosen when the user last left this terrain comes back,
        // quietly: the focus says it. The saved number is used
        // once, so "No tool" chosen in the Properties panel stays.
        integer savedTool = terrain:GetSavedToolNumber()
        if savedTool > 0
            terrain:SetSavedToolNumber(0)
            if not terrain:HasTool()
                if brushTerrain not= undefined and brushTerrain not= terrain
                    brushTerrain:SetToolNumber(0)
                end
                terrain:SetToolNumber(savedTool)
                brushTerrain = terrain
                // The Brush section's Tool group shows it.
                TerrainBrushChanged(terrain)
            end
        end
        AimCameraAtTerrainCursor(terrain)
        UpdateBrushPreview()
        if accessibility not= undefined
            accessibility:DescriptionChanged(highlight)
        end
    end

    /*
    This action leaves the terrain cursor, when its terrain stops being
    selected: a stroke is finished, the tool is remembered and then left
    without a message, so the brush isn't in use on the scene, and the ring
    is hidden. The tool comes back when the terrain gets the focus again
    (FocusTerrainCursor). Calling it twice is harmless.

    Attribute: Parameter terrain The terrain
    */
    action LeaveTerrainCursor(EditorTerrain terrain)
        if terrain = brushTerrain
            if stroking
                EndTerrainStroke()
            end
            LeaveRiverTool()
            terrain:SetSavedToolNumber(terrain:GetToolNumber())
            terrain:SetToolNumber(0)
            brushTerrain = undefined
            TerrainBrushChanged(terrain)
        end
        // A new item started at this cursor keeps the ring shown, at the
        // item, until it is placed or canceled.
        if cursorTerrain = terrain and previewStartTerrain not= terrain and placementTerrain not= terrain
            cursorTerrain = undefined
        end
        HideTerrainGhost()
        UpdateBrushPreview()
    end

    /*
    This action leaves a terrain for the scene's own cursor, when Escape is
    pressed on it, with or without a tool: a stroke going on is
    canceled; the tool is remembered and left; the scene's cursor moves to
    where the terrain cursor was, on the ground; the terrain stops being
    selected; and the scene editor gets the focus, which says "Left
    Terrain1. Scene cursor." and where the cursor is, once.

    Attribute: Parameter highlight The terrain's highlight
    */
    action ExitTerrainCursor(TerrainSelectionHighlight highlight)
        EditorTerrain terrain = highlight:GetEditorTerrain()
        text name = "the terrain"
        if terrain not= undefined
            name = terrain:GetName()
            CancelTerrainStroke()
            // The tool is left now, not when the highlight loses the
            // selection: with a tool still chosen, GainedFocus would give
            // the focus back to the terrain (refocusBrushHighlight).
            LeaveTerrainCursor(terrain)
            EditorLayer layer = GetSelectedLayer()
            TerrainData data = terrain:GetWorldTerrain():GetData()
            if layer is EditorLayer3D and terrain:IsBrushPlaced() and data:HasHeight(terrain:GetBrushX(), terrain:GetBrushZ())
                EditorCursor3D cursor = cast(EditorCursor3D, layer:GetCursor())
                cursor:SetPosition(terrain:GetBrushX(), data:GetSurfaceHeight(terrain:GetBrushX(), terrain:GetBrushZ()), terrain:GetBrushZ())
            end
        end
        // GainedFocus reads GetDescription, which starts with this, so the
        // place is said once, with no separate notification.
        terrainLeftMessage = "Left " + name + ". Scene cursor. "
        // Removes the highlight and focuses the scene editor itself.
        Array<Item> none
        SetFilteredItems(none, true)
    end

    /*
    This action moves the terrain cursor one step with the arrow keys,
    while the grid is on: half the brush's size, in whole grid units, at
    least one. Forward is the world axis nearest the way the
    camera faces, and right is across it, and the cursor lands on the grid,
    so the numbers it says are round.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter right 1 for right, -1 for left, 0 for neither
    Attribute: Parameter forward 1 for away from the camera, -1 for toward it, 0 for neither
    */
    /*
    This action finds the camera's forward direction over the ground, for
    the move keys, into moveForwardX and moveForwardZ: a unit direction, or
    with snapping, the world axis nearest it (one of them 1 or -1, the
    other 0). Looking straight down, forward is the camera's up.
    */
    private action FindMoveAxes(Camera camera, boolean snap)
        Vector3 direction = camera:GetDirection()
        number forwardX = direction:GetX()
        number forwardZ = direction:GetZ()
        if math:AbsoluteValue(forwardX) < 0.0001 and math:AbsoluteValue(forwardZ) < 0.0001
            Vector3 up = camera:GetUp()
            forwardX = up:GetX()
            forwardZ = up:GetZ()
        end
        if snap
            if math:AbsoluteValue(forwardX) >= math:AbsoluteValue(forwardZ)
                forwardZ = 0
                if forwardX >= 0
                    forwardX = 1
                else
                    forwardX = -1
                end
            else
                forwardX = 0
                if forwardZ >= 0
                    forwardZ = 1
                else
                    forwardZ = -1
                end
            end
        else
            number flat = math:SquareRoot(forwardX * forwardX + forwardZ * forwardZ)
            if flat < 0.0001
                forwardX = 0
                forwardZ = 1
            else
                forwardX = forwardX / flat
                forwardZ = forwardZ / flat
            end
        end
        moveForwardX = forwardX
        moveForwardZ = forwardZ
    end

    /*
    This action keeps the grid on terrain: with the grid on, the terrain
    shader draws grid lines over every terrain in the scene, on the grid's
    units, following the hills and fading out with distance from the camera
    (VulkanPainter3D:SetTerrainGrid). The flat grid, at height 0, hides while
    the scene has a terrain, so it doesn't cut through the ground. With the
    grid off, neither shows.
    */
    private action UpdateTerrainGridPatch
        if not (GetSelectedLayer() is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
        Grid3D grid = layer3D:GetGrid()
        boolean hasTerrain = not GetEditorTerrains():IsEmpty()

        // The grid starts off on terrain: the first time this layer has
        // terrain, its grid is turned off once. The grid key turns it back on.
        // The layer's own action is used so the screen reader doesn't say
        // "Grid snapping disabled" each time a scene opens.
        if hasTerrain and not layer3D:IsTerrainGridDefaultApplied()
            layer3D:SetTerrainGridDefaultApplied(true)
            layer3D:SetGridSnapping(false)
        end

        boolean gridOnTerrain = IsGridSnapping() and hasTerrain

        Painter3D painter = layer3D:GetPainter()
        if painter is VulkanPainter3D
            VulkanPainter3D vulkan = cast(VulkanPainter3D, painter)
            if gridOnTerrain
                number unit = GetGridUnitSize()
                number fadeDistance = unit * TERRAIN_GRID_FADE_SQUARES
                if fadeDistance < TERRAIN_GRID_FADE_LEAST
                    fadeDistance = TERRAIN_GRID_FADE_LEAST
                end
                vulkan:SetTerrainGrid(unit, fadeDistance, TERRAIN_GRID_STRENGTH)
            elseif vulkan:GetTerrainGridUnit() not= 0
                vulkan:SetTerrainGrid(0, 0, 0)
            end
        end

        // The old patch of lines around the cursor (TerrainGridPatch) is
        // no longer shown.
        if terrainGridPatch not= undefined and terrainGridPatchShown
            terrainGridPatch:Hide()
            terrainGridPatchShown = false
        end
        if gridOnTerrain
            if grid:IsShowing()
                grid:Hide()
                flatGridHiddenForPatch = true
            end
        elseif flatGridHiddenForPatch
            flatGridHiddenForPatch = false
            if IsGridSnapping()
                grid:Show()
            end
        end
    end

    /*
    This action puts the 3D grid under an item: a patch of
    GRID_PATCH_SQUARES squares at the height of the item's base, so the grid
    is the plane the item steps across, on a hill or in the air. For the
    scene's own cursor, it is the large floor at height 0, as before.

    Attribute: Parameter item The selected item, a new item's preview, or the scene's cursor
    */
    action PlaceGridUnder(Item3D item)
        if item = undefined or not (GetSelectedLayer() is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
        Grid3D grid = layer3D:GetGrid()
        number x = grid:GetNearestGridCoordinate(item:GetGlobalX())
        number z = grid:GetNearestGridCoordinate(item:GetGlobalZ())
        if item is EditorModel and not (item is EditorCursor)
            EditorModel model = cast(EditorModel, item)
            if grid:GetExtent() not= GRID_PATCH_SQUARES
                grid:SetExtent(GRID_PATCH_SQUARES)
            end
            grid:SetPosition(x, GetBaseHeight(model), z)
        else
            if grid:GetExtent() not= GRID_FLOOR_SQUARES
                grid:SetExtent(GRID_FLOOR_SQUARES)
            end
            grid:SetPosition(x, 0, z)
        end
    end

    /*
    This action returns the height of the bottom of a model's box, as it
    stands, the same base GetGroundChange puts on the ground.
    */
    private action GetBaseHeight(EditorModel model) returns number
        number base = model:GetGlobalY()
        if model:GetModelBlueprint() not= undefined
            model:CalculateBoundingBox(shapeBox)
            Vector3 low = shapeBox:GetMinimum()
            Vector3 high = shapeBox:GetMaximum()
            if low:GetX() <= high:GetX() and low:GetY() <= high:GetY() and low:GetZ() <= high:GetZ()
                groundBox:Invalidate()
                groundBox:Extend(shapeBox, model:GetTransform())
                base = groundBox:GetMinimum():GetY()
            end
        end
        return base
    end

    action StepTerrainCursor(EditorTerrain terrain, integer right, integer forward)
        EditorLayer layer = GetSelectedLayer()
        if terrain = undefined or not (layer is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        Camera camera = layer:GetCamera()
        Vector3 direction = camera:GetDirection()
        number forwardX = direction:GetX()
        number forwardZ = direction:GetZ()
        if math:AbsoluteValue(forwardX) < 0.0001 and math:AbsoluteValue(forwardZ) < 0.0001
            // Looking straight down: forward is the camera's up.
            Vector3 up = camera:GetUp()
            forwardX = up:GetX()
            forwardZ = up:GetZ()
        end
        if math:AbsoluteValue(forwardX) >= math:AbsoluteValue(forwardZ)
            forwardZ = 0
            if forwardX >= 0
                forwardX = 1
            else
                forwardX = -1
            end
        else
            forwardX = 0
            if forwardZ >= 0
                forwardZ = 1
            else
                forwardZ = -1
            end
        end
        // In Quorum's left-handed world, the right of forward (x, z) is (z, -x).
        number moveX = forwardZ * right + forwardX * forward
        number moveZ = -forwardX * right + forwardZ * forward
        // A region tool steps to the middle of the next region slot.
        if IsRegionTool(terrain)
            TerrainData data = terrain:GetWorldTerrain():GetData()
            integer locationX = GetRegionLocationAt(data, terrain:GetBrushX()) + cast(integer, moveX)
            integer locationZ = GetRegionLocationAt(data, terrain:GetBrushZ()) + cast(integer, moveZ)
            if not data:IsInRegionMap(locationX, locationZ)
                TellRegionTool(terrain, "That is the edge of the grid of regions, which runs from -16 to 15 along each side.")
                return now
            end
            number size = GetRegionWorldSize(data)
            MoveTerrainCursorTo(terrain, (locationX + 0.5) * size, (locationZ + 0.5) * size)
            return now
        end
        number step = GetTerrainCursorStep(terrain)
        Grid3D grid = layer3D:GetGrid()
        number x = grid:GetNearestGridCoordinate(terrain:GetBrushX() + moveX * step)
        number z = grid:GetNearestGridCoordinate(terrain:GetBrushZ() + moveZ * step)
        MoveTerrainCursorTo(terrain, x, z)
    end

    /*
    This action returns how far one arrow key step moves the terrain
    cursor: half the brush's size, and with the grid on, rounded
    to whole grid units, at least one.

    Attribute: Parameter terrain The terrain
    Attribute: Returns The step, in world units
    */
    action GetTerrainCursorStep(EditorTerrain terrain) returns number
        number step = terrain:GetBrush():GetSize() * CURSOR_STEP_SHARE
        if IsGridSnapping()
            number unit = GetGridUnitSize()
            integer units = cast(integer, step / unit + 0.5)
            if units < 1
                units = 1
            end
            step = units * unit
        end
        return step
    end

    /*
    This action puts the terrain cursor at a place, if there is ground there,
    or anywhere in the grid of regions with the Add region tool. The camera
    follows it. Nothing is spoken: a screen reader reads the cursor's new
    place as the terrain's selected row
    (TerrainSelectionHighlight:GetAccessibilityCursor). A move past the edge
    leaves the cursor where it is and marks it at the edge, which the
    reading then starts with (IsTerrainCursorAtEdge).
    */
    private action MoveTerrainCursorTo(EditorTerrain terrain, number x, number z)
        boolean onGround = terrain:GetWorldTerrain():GetData():HasHeight(x, z)
        if not onGround and terrain:GetToolNumber() not= 8
            terrainCursorAtEdge = true
            return now
        end
        terrainCursorAtEdge = false
        if terrainCursorMovedByPointer
            // The pointer moved the cursor last: the camera takes it as its
            // target from where it is now, rather than jumping to it.
            terrainCursorMovedByPointer = false
            AimCameraAtTerrainCursor(terrain)
        end
        terrain:SetBrushPosition(x, z)
        PlaceTerrainCursorTarget(terrain)
        UpdateEditorCameraPosition()
        // The ring follows at once. The update placed it earlier this frame,
        // before the keys moved the cursor, so it trailed by a frame.
        UpdateBrushPreview()
    end

    /*
    This action returns true if the last move of the terrain cursor was
    stopped by the edge of the ground, until it moves again or the terrain
    gets the focus again.

    Attribute: Returns True if the cursor is held at the edge
    */
    action IsTerrainCursorAtEdge returns boolean
        return terrainCursorAtEdge
    end

    /*
    This action makes the item at the terrain cursor the camera's target,
    without moving the camera, so moving the cursor then moves the camera.
    */
    private action AimCameraAtTerrainCursor(EditorTerrain terrain)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        PlaceTerrainCursorTarget(terrain)
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        layer3D:GetEditorCamera():SetTargetWithoutMoving(terrainCursorTarget)
    end

    /*
    This action puts the camera's target item at the terrain cursor, on the
    ground. The item is the editor's own: it isn't saved, listed or drawn.
    */
    private action PlaceTerrainCursorTarget(EditorTerrain terrain)
        if terrainCursorTarget = undefined
            Item3D target
            target:SetProperty(constants:EDITOR_TAG, undefined)
            terrainCursorTarget = target
        end
        number height = 0
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if data:HasHeight(terrain:GetBrushX(), terrain:GetBrushZ())
            height = data:GetSurfaceHeight(terrain:GetBrushX(), terrain:GetBrushZ())
        end
        terrainCursorTarget:SetPosition(terrain:GetBrushX(), height, terrain:GetBrushZ())
    end

    /*
    This action returns where a terrain's ground is under a point on the
    screen, in the same coordinates as mouse events, or undefined.
    */
    private action PickTerrainGround(EditorTerrain terrain, number x, number y) returns Vector3
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return undefined
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray ray = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        return terrain:GetWorldTerrain():GetData():RayCast(ray:GetOrigin(), ray:GetDirection(), camera:GetFar())
    end

    /*
    This action returns how far an item must move up, or down if negative,
    so that its base rests on the ground under the middle of its base. The
    base is the bottom of the box around the item's shape in the world,
    after turning and scaling; an item with no shape to measure uses its
    position. The ground is the highest terrain there. With no ground
    there, off the terrains or over a hole, it returns 0, and GetLastGround
    returns undefined. Nothing is moved. It is meant for an item in the
    scene itself, or a child of an item that isn't turned or scaled.

    Attribute: Parameter model The item, or a new item's preview
    Attribute: Returns How far to move the item along y
    */
    action GetGroundChange(EditorModel model) returns number
        lastGround = undefined
        number centerX = model:GetGlobalX()
        number centerZ = model:GetGlobalZ()
        number base = model:GetGlobalY()
        if model:GetModelBlueprint() not= undefined
            model:CalculateBoundingBox(shapeBox)
            Vector3 low = shapeBox:GetMinimum()
            Vector3 high = shapeBox:GetMaximum()
            // BoundingBox:IsValid needs some height, which a flat plane hasn't.
            if low:GetX() <= high:GetX() and low:GetY() <= high:GetY() and low:GetZ() <= high:GetZ()
                groundBox:Invalidate()
                groundBox:Extend(shapeBox, model:GetTransform())
                centerX = (groundBox:GetMinimum():GetX() + groundBox:GetMaximum():GetX()) / 2
                centerZ = (groundBox:GetMinimum():GetZ() + groundBox:GetMaximum():GetZ()) / 2
                base = groundBox:GetMinimum():GetY()
            end
        end

        boolean found = false
        number ground = 0
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer counter = 0
        repeat while counter < terrains:GetSize()
            EditorTerrain terrain = terrains:Get(counter)
            TerrainData data = terrain:GetWorldTerrain():GetData()
            if data:HasHeight(centerX, centerZ)
                number height = data:GetSurfaceHeight(centerX, centerZ)
                if not found or height > ground
                    ground = height
                    found = true
                    lastGround = terrain
                end
            end
            counter = counter + 1
        end
        if not found
            return 0
        end
        return ground - base
    end

    /*
    This action returns the terrain the last ground search found under an
    item, or undefined if there was none.

    Attribute: Returns The terrain, or undefined
    */
    action GetLastGround returns EditorTerrain
        return lastGround
    end

    /*
    This action rests an item's base on the ground under the middle of its
    base, once. Nothing follows the ground afterward. The target moved is
    the item's highlight, which moves the item with it, or a new item's
    preview, which is its own item.

    Attribute: Parameter target The highlight or preview to move
    Attribute: Parameter model The item whose base rests on the ground
    Attribute: Returns True if there was ground under it, false if not
    */
    action PutOnGround(EditorItem3D target, EditorModel model) returns boolean
        number change = GetGroundChange(model)
        if lastGround = undefined
            return false
        end
        if change not= 0
            target:MoveY(change)
        end
        return true
    end

    /*
    This action drops the focused item, or a new item's preview, onto the
    ground under the middle of its base, once (Shift+Alt+B by default). It
    doesn't follow the ground afterward. It says where the item went, or
    that there's no ground under it.

    Attribute: Parameter focus The focused highlight or preview
    */
    action DropOnGround(EditorItem3D focus)
        if focus is TerrainSelectionHighlight
            NotifyAccessibility(focus, "A terrain is the ground itself.")
            return now
        end
        EditorModel model = undefined
        if focus is SelectionHighlight3D
            SelectionHighlight3D highlight = cast(SelectionHighlight3D, focus)
            Item selected = highlight:GetItem()
            if selected is EditorModel
                model = cast(EditorModel, selected)
            end
        elseif focus is ItemPreview3D
            model = focus
        end
        if model = undefined
            NotifyAccessibility(focus, "Only an item in the scene can be dropped onto the ground.")
            return now
        end
        if not PutOnGround(focus, model)
            NotifyAccessibility(focus, "No ground under " + model:GetName())
            return now
        end
        UpdateActivePropertiesDialog(focus)
        NotifyAccessibility(focus, "Dropped " + model:GetName() + " onto " + lastGround:GetName() + ", " + DescribeGroundPosition(model))
    end

    /*
    This action starts a new item's preview on the ground, if a terrain is
    under it: at the terrain cursor when a terrain is selected, or else
    under the scene's cursor, where the preview was made. Lights and sounds
    start on the ground too.

    Attribute: Parameter preview The preview
    Attribute: Returns What to say, such as "On Terrain1", or "" if it isn't on the ground
    */
    private action StartPreviewOnGround(ItemPreview3D preview) returns text
        EditorTerrain startTerrain = previewStartTerrain
        if startTerrain = undefined
            startTerrain = cursorTerrain
        end
        previewStartTerrain = undefined
        if startTerrain not= undefined and startTerrain:IsBrushPlaced()
            placementTerrain = startTerrain
            cursorTerrain = startTerrain
            preview:SetPosition(startTerrain:GetBrushX(), preview:GetY(), startTerrain:GetBrushZ())
            UpdateBrushPreview()
        end
        if PutOnGround(preview, preview)
            return "On " + lastGround:GetName()
        end
        return ""
    end

    /*
    This action gives the terrain cursor the focus again, after a new item
    that started at it was placed or canceled with Escape: the terrain is
    selected again, and its cursor is where it was.

    Attribute: Returns True if it went back to a terrain, false if the new item didn't start at one
    */
    action ReturnToPlacementTerrain returns boolean
        EditorTerrain terrain = placementTerrain
        placementTerrain = undefined
        if terrain = undefined or not (GetSelectedLayer() is EditorLayer3D)
            return false
        end
        if not GetEditorTerrains():Has(terrain)
            return false
        end
        Array<Item> chosen
        chosen:Add(terrain)
        SetFilteredItems(chosen, true)
        return true
    end

    /*
    This action returns where the nearest terrain's ground is under a point
    on the screen, in the same coordinates as mouse events, or undefined if
    no terrain is there.

    Attribute: Parameter x The point's x
    Attribute: Parameter y The point's y
    Attribute: Returns The point on the ground, or undefined
    */
    action PickGround(number x, number y) returns Vector3
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return undefined
        end
        Vector3 eye = layer:GetCamera():GetPosition()
        Vector3 nearest = undefined
        number nearestDistance = 0
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer counter = 0
        repeat while counter < terrains:GetSize()
            Vector3 hit = PickTerrainGround(terrains:Get(counter), x, y)
            if hit not= undefined
                number distance = eye:Distance(hit)
                if nearest = undefined or distance < nearestDistance
                    nearest = hit
                    nearestDistance = distance
                end
            end
            counter = counter + 1
        end
        return nearest
    end

    /*
    This action says where an item is, such as "12 4.8 30", rounded to one
    place after the point.
    */
    private action DescribeGroundPosition(Item3D item) returns text
        return SpeakNumber(item:GetGlobalX()) + " " + SpeakNumber(item:GetGlobalY()) + " " + SpeakNumber(item:GetGlobalZ())
    end

    /*
    This action rounds a number to one place after the point for speaking,
    without ".0" on a whole number.
    */
    private action SpeakNumber(number value) returns text
        number rounded = RoundTenth(value)
        if rounded = cast(integer, rounded)
            return "" + cast(integer, rounded)
        end
        return "" + rounded
    end

    /*
    This action makes a terrain's brush, which is also its cursor's ring,
    larger or smaller by one step, with or without a tool.
    Nothing is spoken: the new size and, with the grid on, the arrow keys'
    new step are in the terrain cursor's description
    (TerrainSelectionHighlight:GetDescription).

    Attribute: Parameter terrain The terrain
    Attribute: Parameter larger True to grow the brush, false to shrink it
    */
    action ResizeTerrainBrush(EditorTerrain terrain, boolean larger)
        if terrain = undefined
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        number size = brush:GetSize()
        if larger
            size = size * BRUSH_SIZE_STEP
        else
            size = size / BRUSH_SIZE_STEP
        end
        if size < BRUSH_SMALLEST
            size = BRUSH_SMALLEST
        elseif size > BRUSH_LARGEST
            size = BRUSH_LARGEST
        end
        brush:SetSize(size)
        TerrainBrushChanged(terrain)
    end

    /*
    This action moves the brush of the terrain whose tool is chosen to the
    ground under the pointer, given in the same screen coordinates as mouse
    events. Off the ground, the brush is hidden. The pointer listener calls
    it.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action MoveTerrainBrushToPointer(number x, number y)
        if not IsTerrainBrushActive()
            return now
        end
        terrainCursorMovedByPointer = true
        Vector3 hit = PickPointerGround(brushTerrain, x, y)
        if hit = undefined
            brushTerrain:SetBrushOffGround()
        else
            brushTerrain:SetBrushPosition(hit:GetX(), hit:GetZ())
        end
    end

    /*
    This action returns where the pointer meets a terrain's ground, in the
    same screen coordinates as mouse events, or undefined. With the Add
    region tool it reaches past the ground's edge, to the level of its base,
    height 0.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    Attribute: Returns The point, or undefined
    */
    action PickPointerGround(EditorTerrain terrain, number x, number y) returns Vector3
        EditorLayer layer = GetSelectedLayer()
        if terrain = undefined or not (layer is EditorLayer3D)
            return undefined
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()
        // The same pick ray the selection click uses. GetPickRay mirrors x
        // across the view (the world is left-handed), so the pointer's x is
        // mirrored first; otherwise the brush moves opposite the pointer.
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray ray = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        Vector3 hit = terrain:GetWorldTerrain():GetData():RayCast(ray:GetOrigin(), ray:GetDirection(), camera:GetFar())
        if hit = undefined and terrain:GetToolNumber() = 8
            Vector3 direction = ray:GetDirection()
            Vector3 origin = ray:GetOrigin()
            if direction:GetY() < -0.0001
                number distance = -origin:GetY() / direction:GetY()
                Vector3 level
                level:Set(origin:GetX() + direction:GetX() * distance, 0, origin:GetZ() + direction:GetZ() * distance)
                return level
            end
        end
        return hit
    end

    /*
    This action returns the terrain whose cursor the mouse moves: the one
    whose tool is chosen, or else the selected terrain, or undefined.

    Attribute: Returns The terrain
    */
    action GetPointerTerrain returns EditorTerrain
        if IsTerrainBrushActive()
            return brushTerrain
        end
        if cursorTerrain not= undefined and GetSelectedItem() is TerrainSelectionHighlight
            return cursorTerrain
        end
        return undefined
    end

    /*
    This action returns true while a click in the 3D view belongs to a
    terrain's cursor: a terrain is selected, with or without a tool.

    Attribute: Returns True when the mouse moves a terrain's cursor
    */
    action IsTerrainCursorActive returns boolean
        return GetPointerTerrain() not= undefined and GetSelectedLayer() is EditorLayer3D
    end

    /*
    This action returns true if a point is within a terrain's ring: its
    brush's size from the brush, across the ground.
    */
    private action IsInsideRing(EditorTerrain terrain, Vector3 point) returns boolean
        if not terrain:IsBrushOnGround()
            return false
        end
        number offsetX = point:GetX() - terrain:GetBrushX()
        number offsetZ = point:GetZ() - terrain:GetBrushZ()
        number size = terrain:GetBrush():GetSize()
        return offsetX * offsetX + offsetZ * offsetZ <= size * size
    end

    /*
    This action handles a press of the left mouse button on a selected
    terrain. Inside the ring, with a tool, it applies, as Space does, and
    goes on as a stroke while the button is held. Anywhere else it moves the
    cursor there and applies nothing; holding the button past HOLD_SECONDS
    then starts a stroke there. With no tool, it only moves the cursor.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action PressTerrainCursor(number x, number y)
        EditorTerrain terrain = GetPointerTerrain()
        // The region tools work with a placeholder (PressRegionTool).
        if terrain not= undefined and terrain = brushTerrain and IsRegionTool(terrain)
            PressRegionTool(terrain, x, y)
            return now
        end
        Vector3 hit = PickPointerGround(terrain, x, y)
        if hit = undefined
            return now
        end
        HideTerrainGhost()
        // The River tool adds, chooses or moves points where the click is.
        if terrain:GetToolNumber() = terrain:RIVER_TOOL
            terrainCursorMovedByPointer = true
            terrain:SetBrushPosition(hit:GetX(), hit:GetZ())
            UpdateBrushPreview()
            PressRiverTool(terrain, hit:GetX(), hit:GetZ(), true)
            return now
        end
        if terrain:HasTool() and IsInsideRing(terrain, hit)
            BeginTerrainStroke(terrain, true, 0)
            return now
        end
        terrainCursorMovedByPointer = true
        terrain:SetBrushPosition(hit:GetX(), hit:GetZ())
        UpdateBrushPreview()
        if terrain:HasTool()
            pointerHolding = true
            pointerHoldSeconds = 0
        end
    end

    /*
    This action starts a stroke once the button pressed outside the ring has
    been held past HOLD_SECONDS, and forgets the press when it is let go.
    */
    private action UpdatePointerHold(number seconds)
        if not pointerHolding
            return now
        end
        if not strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
            pointerHolding = false
            return now
        end
        pointerHoldSeconds = pointerHoldSeconds + seconds
        if pointerHoldSeconds >= HOLD_SECONDS
            pointerHolding = false
            EditorTerrain terrain = GetPointerTerrain()
            if terrain not= undefined and terrain:HasTool()
                BeginTerrainStroke(terrain, true, 0)
            end
        end
    end

    /*
    This action follows the pointer as it moves without a button held:
    while a selected terrain's cursor is in use, the gray ghost ring shows
    where a click would move the cursor. Over the cursor's own ring, where a
    click applies, and during a stroke, it hides.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action MoveTerrainGhostToPointer(number x, number y)
        if stroking or pointerHolding or not IsTerrainCursorActive()
            HideTerrainGhost()
            return now
        end
        EditorTerrain terrain = GetPointerTerrain()
        // The region tools show the region slot under the pointer instead.
        if terrain = brushTerrain and IsRegionTool(terrain)
            MoveRegionSlotToPointer(terrain, x, y)
            return now
        end
        Vector3 hit = PickPointerGround(terrain, x, y)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if hit = undefined or not data:HasHeight(hit:GetX(), hit:GetZ()) or IsInsideRing(terrain, hit)
            HideTerrainGhost()
            return now
        end
        number size = terrain:GetBrush():GetSize()
        if ghostPreview = undefined
            TerrainBrushPreview ghost
            ghost:SetName("Terrain Brush Ghost")
            ghost:SetProperty(constants:EDITOR_TAG, undefined)
            // The ghost lets clicks through to the scene editor.
            ghost:SetAcceptsMouseInput(false)
            ghost:SetRingColor(0.6, 0.6, 0.6)
            ghost:Place(data, hit:GetX(), hit:GetZ(), size)
            ghostPreview = ghost
            EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
            layer3D:Add(ghost)
        else
            ghostPreview:Place(data, hit:GetX(), hit:GetZ(), size)
        end
        if not ghostPreviewShown
            ghostPreview:Show()
            ghostPreviewShown = true
        end
    end

    /*
    This action hides the ghost ring.
    */
    action HideTerrainGhost
        if ghostPreview not= undefined and ghostPreviewShown
            ghostPreview:Hide()
        end
        ghostPreviewShown = false
    end

    /*
    This action moves the focused item, a new item's preview started at a
    terrain's cursor, to where that cursor is now, on the ground, so the
    preview and the ring move together.
    */
    private action MoveFocusToTerrainCursor(EditorItem3D focus, EditorTerrain terrain)
        if not (focus is ItemPreview3D)
            return now
        end
        ItemPreview3D preview = cast(ItemPreview3D, focus)
        // With "Follow the ground" on, the keyboard keeps the preview's
        // height above the ground; off (the default), it keeps its height.
        // Only the mouse snaps it onto the ground.
        number above = -GetGroundChange(preview)
        boolean hadGround = lastGround not= undefined
        preview:SetPosition(terrain:GetBrushX(), preview:GetY(), terrain:GetBrushZ())
        FollowGroundAfterMove(preview, above, hadGround)
    end

    /*
    This action keeps a preview that follows the ground at the height above
    the ground it had before a move, if it had ground under it before and
    has now. Other items, and previews that don't follow, are left as they
    are.

    Attribute: Parameter focus The item that moved
    Attribute: Parameter above How far its base was above the ground before the move
    Attribute: Parameter hadGround True if there was ground under it before the move
    */
    private action FollowGroundAfterMove(EditorItem3D focus, number above, boolean hadGround)
        if not (focus is ItemPreview3D)
            return now
        end
        ItemPreview3D preview = cast(ItemPreview3D, focus)
        if not preview:IsFollowingGround()
            return now
        end
        number change = GetGroundChange(preview)
        if lastGround not= undefined
            if hadGround
                preview:MoveY(change + above)
            else
                preview:MoveY(change)
            end
        end
    end

    /*
    This action returns true if a tool's strokes are ready in the scene
    editor for a terrain: raise, lower, smooth, flatten and ramp,
    paint, once the terrain has two or more materials, and add and
    remove region, and stamp, erode and auto paint. Paint and
    blend paint need two or more materials.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter tool The tool's number, from 1 to 12
    Attribute: Returns True if the tool can make strokes
    */
    action CanStrokeWithTool(EditorTerrain terrain, integer tool) returns boolean
        if tool = 1 or tool = 2 or tool = 3 or tool = 4 or tool = 5 or tool = 8 or tool = 9
            return true
        end
        // Stamp, erode and auto paint (EditorTerrain's STAMP_TOOL to
        // AUTO_PAINT_TOOL).
        if tool >= 10 and tool <= 12
            return true
        end
        // The Fill water and Paint water tools.
        if terrain not= undefined and (tool = terrain:FILL_WATER_TOOL or tool = terrain:PAINT_WATER_TOOL)
            return true
        end
        // The Foliage tool needs an asset to paint.
        if terrain not= undefined and tool = terrain:FOLIAGE_TOOL
            return terrain:GetFoliageAssetCount() > 0
        end
        // Paint and blend paint need two materials to paint between.
        return (tool = 6 or tool = 7) and terrain not= undefined and terrain:GetLayerCount() >= 2
    end

    /*
    This action starts a stroke with the brush of the terrain whose tool is
    chosen. The stroke goes on, once a frame, while the key that
    started it is held, or the left mouse button for a stroke started with
    a click, and ends when it is let go. Nothing starts if the brush is off
    the ground, if a stroke is already going, or if the tool's strokes
    aren't ready yet.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter byMouse True if the left mouse button started the stroke
    Attribute: Parameter key The key that started it, for a stroke started with a key
    */
    action BeginTerrainStroke(EditorTerrain terrain, boolean byMouse, integer key)
        if stroking or terrain = undefined or terrain not= brushTerrain or not terrain:HasTool()
            return now
        end
        integer tool = terrain:GetToolNumber()
        if tool = terrain:RIVER_TOOL
            // Not a stroke: Space adds a point at the cursor, or chooses the
            // river point there.
            PressRiverTool(terrain, terrain:GetBrushX(), terrain:GetBrushZ(), false)
            return now
        end
        if (tool = 6 or tool = 7) and terrain:GetLayerCount() < 2
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " needs two or more materials. Add them in the Materials section.")
            return now
        end
        if tool = terrain:FOLIAGE_TOOL and terrain:GetFoliageAssetCount() = 0
            NotifyAccessibility(terrain, "The Foliage tool needs a foliage asset. Add one in the Foliage section.")
            return now
        end
        if not CanStrokeWithTool(terrain, tool)
            NotifyAccessibility(terrain, terrain:GetToolName(tool) + " strokes aren't ready yet. The other tools are.")
            return now
        end
        if tool = 5
            // The ramp isn't a stroke: the first click (or Space) marks its
            // start, and the second makes the whole ramp to where the brush
            // is.
            SetNextTerrainRampPoint(terrain)
            return now
        end
        if tool = 6 and terrain:GetBrush():GetLayer() >= terrain:GetLayerCount()
            NotifyAccessibility(terrain, "Layer " + (terrain:GetBrush():GetLayer() + 1) + " has no material. Choose another layer to paint.")
            return now
        end
        if not terrain:IsBrushOnGround()
            if tool = 8
                NotifyAccessibility(terrain, "A region can't go there: the grid of regions runs from -16 to 15 along each side.")
            else
                NotifyAccessibility(terrain, "The brush is off the ground")
            end
            return now
        end
        if tool = terrain:STAMP_TOOL
            // The stamp presses one shape: each click (or Space) does it
            // once at the brush, as one undoable change.
            UseOperationTool(terrain, tool)
            return now
        end
        if tool = terrain:AUTO_PAINT_TOOL and not CanAutoPaint(terrain)
            return now
        end
        if tool = terrain:FILL_WATER_TOOL
            // Not a stroke: each click (or Space) pours water at the brush,
            // as one undoable change.
            FillTerrainWater(terrain, terrain:GetBrushX(), terrain:GetBrushZ())
            return now
        end
        if tool = terrain:PAINT_WATER_TOOL
            if BeginWaterStroke(terrain)
                stroking = true
                strokeByMouse = byMouse
                strokeKey = key
            end
            return now
        end
        if tool = terrain:FOLIAGE_TOOL
            BeginFoliageStroke(terrain)
            paintShownSeconds = 0
            stroking = true
            strokeByMouse = byMouse
            strokeKey = key
            return now
        end
        terrainStroke:Begin(terrain:GetWorldTerrain():GetData(), terrain:GetBrush())
        // Erode and Auto paint are strokes too: they use the generator's
        // rain and painting rules under the brush, fading with its falloff
        // and as strong as its strength.
        terrainStroke:SetGenerator(generator, terrain:GetLayerCount())
        paintShownSeconds = 0
        stroking = true
        strokeByMouse = byMouse
        strokeKey = key
    end

    /*
    This action uses the Stamp tool once, at the brush, with the terrain's
    stamp settings from the Generate section. Erode and Auto paint are
    strokes instead (BeginTerrainStroke).
    */
    private action UseOperationTool(EditorTerrain terrain, integer tool)
        if tool = terrain:STAMP_TOOL
            integer mode = terrain:GetStampMode()
            if mode < 0
                mode = generator:GetStampMode(terrain:GetStampShape())
            end
            StampTerrain(terrain, terrain:GetStampShape(), mode, terrain:GetStampHeight(), terrain:GetStampTurn())
        end
    end

    /*
    This action returns true while a stroke with a terrain's brush is going.

    Attribute: Returns True during a stroke
    */
    action IsTerrainStroking returns boolean
        return stroking
    end

    /*
    This action keeps a stroke going while its key or button is held, and
    ends it when it is let go. The ground is redrawn each frame.
    */
    private action UpdateTerrainStroke(number seconds)
        if not stroking
            return now
        end
        boolean held = false
        if strokeByMouse
            held = strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
        else
            held = strokeMonitor:IsKeyPressed(strokeKey)
        end
        if not held
            EndTerrainStroke()
            return now
        end
        if brushTerrain = undefined
            if foliageStroking
                foliageStroking = false
                boolean anything = foliageStroke:End()
                foliageStroke:Undo()
            elseif waterStroking
                // The terrain the water was painted on is gone; there is
                // nothing to put back.
                waterStroking = false
            else
                terrainStroke:Cancel()
            end
            stroking = false
            return now
        end
        if waterStroking
            ApplyWaterStroke(brushTerrain)
            return now
        end
        if foliageStroking
            // The Foliage tool adds or removes copies under the brush;
            // the ground doesn't change.
            if brushTerrain:IsBrushOnGround()
                number radius = brushTerrain:GetBrush():GetSize()
                if foliageStroke:Apply(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), radius, brushTerrain:GetFoliageDensityScale())
                    brushTerrain:RefreshFoliage(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), radius)
                end
            end
            return now
        end
        if brushTerrain:IsBrushOnGround()
            terrainStroke:Apply(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(), seconds)
            integer toolNumber = brushTerrain:GetToolNumber()
            if toolNumber = 8 or toolNumber = 9
                // A region tool adds or removes only the region under the
                // ring where it was clicked: the stroke ends at once, so
                // the pointer drifting while the button is held doesn't
                // add or remove others. Ending it redraws the terrain and
                // says the new size.
                EndTerrainStroke()
                return now
            elseif toolNumber = 6 or toolNumber = 7 or toolNumber = brushTerrain:AUTO_PAINT_TOOL
                // Painting, blending and auto paint load the splat texture again to show, so it is
                // shown a few times a second, and fully at the end.
                paintShownSeconds = paintShownSeconds + seconds
                if paintShownSeconds >= PAINT_SHOW_INTERVAL
                    paintShownSeconds = 0
                    RedrawTerrain(brushTerrain)
                end
            else
                RedrawTerrain(brushTerrain)
            end
        end
    end

    /*
    This action sets what a terrain's Foliage brush does, and says it: 0
    paints the chosen asset, 1 removes the chosen asset, and 2 removes every
    asset. The Brush section and the next layer key call it.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter mode The mode, from 0 to 2
    */
    action SetFoliageBrushMode(EditorTerrain terrain, integer mode)
        if terrain = undefined or mode < 0 or mode > 2
            return now
        end
        terrain:SetFoliageBrushMode(mode)
        text assetName = "the chosen asset"
        FoliageList list = terrain:GetFoliageList()
        if list not= undefined and terrain:GetFoliageAsset() >= 0 and terrain:GetFoliageAsset() < list:GetAssetCount()
            assetName = list:GetAsset(terrain:GetFoliageAsset()):GetName()
        end
        if mode = 0
            NotifyAccessibility(terrain, "Foliage brush: paint " + assetName + ".")
        elseif mode = 1
            NotifyAccessibility(terrain, "Foliage brush: remove " + assetName + ".")
        else
            NotifyAccessibility(terrain, "Foliage brush: remove every asset.")
        end
        TerrainBrushChanged(terrain)
    end

    /*
    This action starts a Foliage tool stroke: it adds
    copies of the chosen foliage asset, or with Ctrl held removes them, or
    with Ctrl and Shift held removes every asset's copies under the brush.
    */
    private action BeginFoliageStroke(EditorTerrain terrain)
        if terrain:GetFoliageAsset() < 0 or terrain:GetFoliageAsset() >= terrain:GetFoliageAssetCount()
            terrain:SetFoliageAsset(0)
        end
        boolean control = strokeMonitor:IsKeyPressed(modifierKeys:CONTROL_LEFT) or strokeMonitor:IsKeyPressed(modifierKeys:CONTROL_RIGHT)
        boolean shift = strokeMonitor:IsKeyPressed(modifierKeys:SHIFT_LEFT) or strokeMonitor:IsKeyPressed(modifierKeys:SHIFT_RIGHT)
        FoliageStroke stroke
        // The brush's mode, chosen in the Brush section or with the next
        // layer key; Ctrl held as the stroke starts removes too, where the
        // system allows it.
        integer mode = terrain:GetFoliageBrushMode()
        if control and shift
            mode = stroke:REMOVE_ALL
        elseif control
            mode = stroke:REMOVE_ASSET
        end
        stroke:Begin(terrain:GetTerrainFoliage(), terrain:GetFoliageList(), terrain:GetFoliageAsset(), mode)
        foliageStroke = stroke
        foliageStroking = true
        // An asset that grows on a material layer isn't painted: it grows
        // wherever that layer is.
        FoliageList list = terrain:GetFoliageList()
        if mode = stroke:ADD_COPIES and list not= undefined and terrain:GetFoliageAsset() < list:GetAssetCount()
            FoliageAsset chosen = list:GetAsset(terrain:GetFoliageAsset())
            if chosen:GetGrowsOnLayer() > 0
                NotifyAccessibility(terrain, chosen:GetName() + " grows wherever material layer " + chosen:GetGrowsOnLayer() + " is painted. Paint that layer to grow it.")
            end
        end
    end

    /*
    This action finishes a Foliage tool stroke: it goes into the undo list,
    the terrain is marked changed for the next save, and what it added or
    removed is announced.
    */
    private action EndFoliageStroke
        foliageStroking = false
        boolean anything = foliageStroke:End()
        if brushTerrain = undefined
            return now
        end
        if not anything
            NotifyAccessibility(brushTerrain, "Nothing changed")
            return now
        end
        text name = ""
        text message = ""
        if foliageStroke:GetMode() = foliageStroke:ADD_COPIES
            name = "paint " + foliageStroke:GetAssetName()
            // The brush moves coverage toward its strength, so a light brush
            // over thick growth thins it.
            if foliageStroke:GetRemovedCount() > 0
                message = "Thinned " + foliageStroke:GetAssetName() + ", " + foliageStroke:GetRemovedCount() + " fewer."
            else
                message = "Added " + foliageStroke:GetAddedCount() + " " + foliageStroke:GetAssetName() + "."
            end
        else
            name = "remove " + foliageStroke:GetAssetName()
            message = "Removed " + foliageStroke:GetRemovedCount() + " " + foliageStroke:GetAssetName() + "."
        end
        SceneEditorFoliageEdit edit
        edit:Create(me, brushTerrain, foliageStroke, name)
        editManager:Add(edit)
        brushTerrain:SetChanged(true)
        if terrainFoliagePropertiesDialog:IsShowing()
            terrainFoliagePropertiesDialog:Refresh()
        end
        NotifyAccessibility(brushTerrain, message + " Under the brush: " + brushTerrain:DescribeFoliageUnderBrush() + ".")
    end

    /*
    This action draws the foliage a stroke touched again.
    */
    private action RefreshFoliageStrokeArea(EditorTerrain terrain, FoliageStroke stroke)
        terrain:RefreshFoliage(stroke:GetAreaMiddleX(), stroke:GetAreaMiddleZ(), stroke:GetAreaRadius())
    end

    /*
    This action is called after a Foliage tool stroke is undone or redone:
the foliage there is drawn again, the terrain is
    marked changed for the next save, and what happened is announced.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter stroke The stroke undone or redone
    Attribute: Parameter message What happened, such as "Undid add Pine"
    */
    action FoliageEdited(EditorTerrain terrain, FoliageStroke stroke, text message)
        if terrain = undefined
            return now
        end
        if stroking
            CancelTerrainStroke()
        end
        RefreshFoliageStrokeArea(terrain, stroke)
        terrain:SetChanged(true)
        if terrainFoliagePropertiesDialog:IsShowing()
            terrainFoliagePropertiesDialog:Refresh()
        end
        NotifyAccessibility(terrain, message)
    end

    /*
    This action pours water at a place on a terrain, with
    the Fill water tool: the water's level is the ground's height there plus
    the terrain's water depth, and it fills the hollow it is poured in, as
    far as the ground lower than the level reaches. Poured into a lake of
    water cells, that lake is filled again at the new level. It can be
    undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter x Where the water is poured, along x
    Attribute: Parameter z Where the water is poured, along z
    */
    action FillTerrainWater(EditorTerrain terrain, number x, number z)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if not data:HasHeight(x, z)
            NotifyAccessibility(terrain, "There is no ground there to pour water on.")
            return now
        end
        WaterState before
        before:Copy(terrain)
        TerrainWater water = terrain:GetWater()
        number level = RoundTenth(data:GetSurfaceHeight(x, z) + terrain:GetWaterDepth())
        TerrainLake existing = water:GetMaskedLakeAt(x, z)
        text oldName = ""
        if existing not= undefined
            oldName = existing:GetName()
        end
        TerrainLake lake = water:FillLake(x, z, level)
        if lake = undefined
            NotifyAccessibility(terrain, "There is no hollow here to hold water: the ground slopes away, so the water would run off.")
            return now
        end
        if lake:GetName() = ""
            if oldName not= ""
                lake:SetName(oldName)
            else
                lake:SetName("Lake " + water:GetLakeCount())
            end
        end
        terrain:WaterChanged()
        text stoppedAt = "water at " + level
        if water:DidLastFillSpill()
            stoppedAt = "water at " + RoundTenth(lake:GetLevel()) + ", the hollow's rim"
        end
        RecordWaterChange(terrain, before, "fill " + lake:GetName(), "Filled the hollow: " + stoppedAt + ", " +
            lake:GetWaterCellCount() + " cells, about " + RoundTenth(lake:GetWidth()) + " by " + RoundTenth(lake:GetDepth()) + ".")
    end

    /*
    This action returns true while the River tool is chosen on a terrain.

    Attribute: Returns True while the River tool is in use
    */
    action IsRiverToolActive returns boolean
        return brushTerrain not= undefined and brushTerrain:GetToolNumber() = brushTerrain:RIVER_TOOL
    end

    /*
    This action returns true while a river is being drawn.

    Attribute: Returns True while drawing a river
    */
    action IsDrawingRiver returns boolean
        return riverDrawing
    end

    /*
    This action returns true while a river's point is being dragged with
    the mouse.

    Attribute: Returns True while dragging
    */
    action IsDraggingRiverPoint returns boolean
        return riverDragging
    end

    /*
    This action starts dragging the selected placed 3D item, when the left
    button is pressed on it. Nothing moves until the pointer has moved a
    few pixels, so a plain click only selects. The item keeps the same spot
    under the pointer, and over a terrain its height above the ground.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action BeginItemDrag(number x, number y)
        itemDragging = false
        itemDragMoved = false
        Item selected = GetSelectedItem()
        if not (selected is SelectionHighlight3D)
            return now
        end
        SelectionHighlight3D highlight = cast(SelectionHighlight3D, selected)
        Item target = highlight:GetItem()
        if not (target is Item3D) or target is EditorTerrain
            return now
        end
        Item3D item = cast(Item3D, target)
        Vector3 hit = PickDragPoint(x, y, item:GetY())
        if hit = undefined
            return now
        end
        itemDragHighlight = highlight
        itemDragItem = item
        itemDragStartX = x
        itemDragStartY = y
        itemDragOffsetX = item:GetX() - hit:GetX()
        itemDragOffsetZ = item:GetZ() - hit:GetZ()
        itemDragBefore:Set(item:GetX(), item:GetY(), item:GetZ())
        itemDragHadGround = HasGroundAt(item:GetX(), item:GetZ())
        itemDragGroundStart = foundGroundHeight
        itemDragging = true
    end

    /*
    This action returns true while a placed 3D item is being dragged.

    Attribute: Returns True while dragging
    */
    action IsDraggingItem returns boolean
        return itemDragging
    end

    /*
    This action moves the item being dragged to follow the pointer.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action DragItem(number x, number y)
        if not itemDragging or itemDragItem = undefined
            return now
        end
        if not itemDragMoved
            number movedX = x - itemDragStartX
            number movedY = y - itemDragStartY
            if movedX * movedX + movedY * movedY < ITEM_DRAG_THRESHOLD * ITEM_DRAG_THRESHOLD
                return now
            end
            itemDragMoved = true
        end
        Vector3 hit = PickDragPoint(x, y, itemDragBefore:GetY())
        if hit = undefined
            return now
        end
        number newX = hit:GetX() + itemDragOffsetX
        number newZ = hit:GetZ() + itemDragOffsetZ
        number newY = itemDragBefore:GetY()
        // Over a terrain, the item keeps its height above the ground.
        if itemDragHadGround and HasGroundAt(newX, newZ)
            newY = itemDragBefore:GetY() + foundGroundHeight - itemDragGroundStart
        end
        itemDragHighlight:Move(newX - itemDragItem:GetX(), newY - itemDragItem:GetY(), newZ - itemDragItem:GetZ())
        UpdateActivePropertiesDialog(itemDragHighlight)
    end

    /*
    This action puts the item being dragged back where it started, such as
    when Escape is pressed during the drag.

    Attribute: Returns True if a drag was canceled
    */
    action CancelItemDrag returns boolean
        if not itemDragging
            return false
        end
        itemDragging = false
        if itemDragMoved and itemDragItem not= undefined
            PutItemPosition(itemDragItem, itemDragBefore, "Move canceled.")
        end
        itemDragMoved = false
        return true
    end

    /*
    This action finishes a drag when the button is let go: if the item
    moved, the move is one change that can be undone, and is announced.
    */
    private action UpdateItemDrag
        if not itemDragging
            return now
        end
        if strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
            return now
        end
        itemDragging = false
        if not itemDragMoved or itemDragItem = undefined
            return now
        end
        itemDragMoved = false
        Vector3 after
        after:Set(itemDragItem:GetX(), itemDragItem:GetY(), itemDragItem:GetZ())
        SceneEditorMoveEdit edit
        edit:Create(me, itemDragItem, itemDragBefore, after, "move " + itemDragItem:GetName())
        editManager:Add(edit)
        PutItemPosition(itemDragItem, after, "Moved " + itemDragItem:GetName() + " to " + RoundTenth(after:GetX()) + ", " + RoundTenth(after:GetY()) + ", " + RoundTenth(after:GetZ()) + ".")
    end

    /*
    This action puts a placed 3D item at a position, such as when a move is
    undone, then moves its selection box over it, and shows and says the
    change.

    Attribute: Parameter item The item
    Attribute: Parameter position Where its origin goes
    Attribute: Parameter message What to say, or an empty text to say nothing
    */
    action PutItemPosition(Item3D item, Vector3 position, text message)
        if item = undefined
            return now
        end
        item:SetPosition(position:GetX(), position:GetY(), position:GetZ())
        Item selected = GetSelectedItem()
        if selected is SelectionHighlight3D
            SelectionHighlight3D highlight = cast(SelectionHighlight3D, selected)
            if item:Equals(highlight:GetItem())
                highlight:PlaceOverItem()
                UpdateActivePropertiesDialog(highlight)
            end
        end
        if vehicleGuides not= undefined and vehicleGuides:IsShowing()
            vehicleGuides:Refresh()
        end
        if message not= ""
            NotifyAccessibility(me, message)
        end
    end

    /*
    Returns the point under the pointer that a dragged item follows: on a
    terrain's ground, or, away from any terrain, on the level plane at a
    height. Undefined if the pointer looks away from both.
    */
    private action PickDragPoint(number x, number y, number planeY) returns Vector3
        Vector3 ground = PickGround(x, y)
        if ground not= undefined
            return ground
        end
        EditorLayer selectedLayer = GetSelectedLayer()
        if not (selectedLayer is EditorLayer3D)
            return undefined
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, selectedLayer)
        EditorCamera3D camera = layer3D:GetEditorCamera()
        // GetPickRay mirrors x across the view, so the pointer's x is
        // mirrored first, as the palette's drag does.
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray pickRay = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        number directionY = pickRay:GetDirection():GetY()
        if directionY = 0
            return undefined
        end
        number along = (planeY - pickRay:GetOrigin():GetY()) / directionY
        if along < 0
            return undefined
        end
        Vector3 hit
        hit:Set(pickRay:GetOrigin():GetX() + pickRay:GetDirection():GetX() * along, planeY, pickRay:GetOrigin():GetZ() + pickRay:GetDirection():GetZ() * along)
        return hit
    end

    /*
    Returns true if a terrain's ground is at a place, and keeps its height
    in foundGroundHeight.
    */
    private action HasGroundAt(number x, number z) returns boolean
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer i = 0
        repeat while i < terrains:GetSize()
            TerrainData data = terrains:Get(i):GetWorldTerrain():GetData()
            if data:HasHeight(x, z)
                foundGroundHeight = data:GetSurfaceHeight(x, z)
                return true
            end
            i = i + 1
        end
        return false
    end

    /*
    This action is a click with the River tool, or Space, at a place on the
    ground:
    - while a river is being drawn, it adds the next point there;
    - on one of a river's points, it chooses it, and with the mouse, holding
      the button and moving drags it;
    - on a river's water, between points, it adds a point there;
    - anywhere else, it lets go of the chosen river, if one is chosen, or
      starts a new river there.
    */
    private action PressRiverTool(EditorTerrain terrain, number x, number z, boolean byMouse)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if not data:HasHeight(x, z)
            NotifyAccessibility(terrain, "A river needs ground under its points.")
            return now
        end
        if riverDrawing
            AddRiverDraftPoint(terrain, x, z)
            return now
        end
        TerrainWater water = terrain:GetWater()
        // A river's point: chosen, and dragged while the button is held.
        integer i = water:GetRiverCount() - 1
        repeat while i >= 0
            TerrainRiver river = water:GetRiver(i)
            number reach = river:GetWidth() / 2
            if reach < RIVER_POINT_REACH
                reach = RIVER_POINT_REACH
            end
            integer point = river:GetPointNear(x, z, reach)
            if point >= 0
                ChooseRiverPoint(terrain, river, point)
                if byMouse
                    riverDragging = true
                    riverDragMoved = false
                    riverDragX = river:GetPointX(point)
                    riverDragZ = river:GetPointZ(point)
                end
                NotifyAccessibility(terrain, "Point " + (point + 1) + " of " + river:GetPointCount() + " of " + river:GetName() + ". Drag it to move it, or press Delete to remove it.")
                return now
            end
            i = i - 1
        end
        // A river's water, between points: a new point there.
        TerrainRiver under = water:GetRiverAt(x, z)
        if under not= undefined
            integer index = under:GetInsertIndexAt(x, z)
            if index > 0 and index < under:GetPointCount()
                InsertRiverPoint(terrain, under, index, x, z)
                return now
            end
        end
        // Anywhere else while a river is chosen: it is let go, so a stray
        // click while editing doesn't start a new river.
        if chosenRiver not= undefined
            chosenRiver = undefined
            chosenRiverPoint = -1
            HideRiverLine()
            ShowAllRiverLines(terrain)
            NotifyAccessibility(terrain, "No river chosen. Click empty ground again to start a new river.")
            return now
        end
        // Anywhere else: a new river starts here.
        riverDrawing = true
        riverTerrain = terrain
        riverDraftX:Empty()
        riverDraftZ:Empty()
        riverDraftX:Add(x)
        riverDraftZ:Add(z)
        chosenRiver = undefined
        chosenRiverPoint = -1
        ShowRiverLine(terrain, riverDraftX, riverDraftZ, 0)
        NotifyAccessibility(terrain, "Started a river at " + RoundTenth(x) + ", " + RoundTenth(z) + ", ground height " + RoundTenth(data:GetSurfaceHeight(x, z)) +
            ". Click, or move the cursor and press Space, to add its next point. Press Enter to finish it, or Escape to stop.")
    end

    /*
    This action adds the next point to the river being drawn, and says how
    far it is from the last and how much the ground drops.
    */
    private action AddRiverDraftPoint(EditorTerrain terrain, number x, number z)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer last = riverDraftX:GetSize() - 1
        number lastX = riverDraftX:Get(last)
        number lastZ = riverDraftZ:Get(last)
        number apartX = x - lastX
        number apartZ = z - lastZ
        number apart = math:SquareRoot(apartX * apartX + apartZ * apartZ)
        if apart < 0.5
            NotifyAccessibility(terrain, "That is where the last point is. Move farther to add the next point.")
            return now
        end
        riverDraftX:Add(x)
        riverDraftZ:Add(z)
        ShowRiverLine(terrain, riverDraftX, riverDraftZ, riverDraftX:GetSize() - 1)
        number drop = data:GetSurfaceHeight(lastX, lastZ) - data:GetSurfaceHeight(x, z)
        text slope = "the ground drops " + RoundTenth(drop)
        if drop < 0
            slope = "the ground rises " + RoundTenth(-drop) + ", so the river will cut into it there"
        elseif drop = 0
            slope = "the ground is level"
        end
        NotifyAccessibility(terrain, "Point " + riverDraftX:GetSize() + ", " + RoundTenth(apart) + " units from the last; " + slope + ". Press Enter to finish the river.")
    end

    /*
    This action finishes the river being drawn: it becomes one of the
    terrain's rivers, its water runs downhill along its points, and its bed
    is carved into the ground, as one change that can be undone. A river needs two points or more.

    Attribute: Returns True if a river was being drawn, so Enter did this
    */
    action FinishRiverDrawing returns boolean
        if not riverDrawing
            return false
        end
        EditorTerrain terrain = riverTerrain
        if riverDraftX:GetSize() < 2
            NotifyAccessibility(terrain, "A river needs two points or more. Add another point, or press Escape to stop.")
            return true
        end
        if not CanChangeWater(terrain)
            return true
        end
        riverDrawing = false
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainWater water = terrain:GetWater()
        WaterState before
        before:Copy(terrain)
        TerrainRiver river = water:AddRiver()
        river:SetName(water:GetNewRiverName())
        integer i = 0
        repeat while i < riverDraftX:GetSize()
            river:AddPoint(RoundTenth(riverDraftX:Get(i)), RoundTenth(riverDraftZ:Get(i)), terrain:GetRiverWidth(), terrain:GetRiverDepth())
            i = i + 1
        end
        riverDraftX:Empty()
        riverDraftZ:Empty()
        TerrainStroke operation = StartRiverGround(terrain, river)
        water:RiverChanged(river)
        CarveRiverGround(terrain, river, operation)
        chosenRiver = river
        chosenRiverPoint = river:GetPointCount() - 1
        ShowChosenRiverLine(terrain)
        FinishRiverChange(terrain, before, operation, "draw " + river:GetName(), "Drew " + DescribeRiver(terrain, river))
        return true
    end

    /*
    This action stops drawing a river, without making it.

    Attribute: Returns True if a river was being drawn, so Escape did this
    */
    action CancelRiverDrawing returns boolean
        if not riverDrawing
            return false
        end
        EditorTerrain terrain = riverTerrain
        riverDrawing = false
        riverDraftX:Empty()
        riverDraftZ:Empty()
        HideRiverLine()
        NotifyAccessibility(terrain, "Stopped drawing the river. Nothing was added.")
        return true
    end

    /*
    This action removes the chosen point of a river, or the
    whole river if it would have fewer than two points left. The ground it
    carved is put back where it wasn't changed since. It can be undone.

    Attribute: Returns True if a river's point was chosen, so Delete did this
    */
    action RemoveChosenRiverPoint returns boolean
        if not IsRiverToolActive()
            return false
        end
        EditorTerrain terrain = brushTerrain
        // While drawing, Delete takes back the last point added.
        if riverDrawing
            if riverDraftX:GetSize() <= 1
                return CancelRiverDrawing()
            end
            number removedX = riverDraftX:RemoveFromEnd()
            number removedZ = riverDraftZ:RemoveFromEnd()
            ShowRiverLine(terrain, riverDraftX, riverDraftZ, riverDraftX:GetSize() - 1)
            NotifyAccessibility(terrain, "Took back the last point. The river has " + riverDraftX:GetSize() + " points so far.")
            return true
        end
        if chosenRiver = undefined or chosenRiverPoint < 0
            NotifyAccessibility(terrain, "Click a river's point first to choose it. Escape leaves the terrain.")
            return true
        end
        if not CanChangeWater(terrain)
            return true
        end
        TerrainRiver river = chosenRiver
        if river:GetPointCount() <= 2
            RemoveTerrainRiver(terrain, terrain:GetWater():GetRiverIndex(river))
            return true
        end
        WaterState before
        before:Copy(terrain)
        integer removedPoint = chosenRiverPoint
        TerrainStroke operation = StartRiverGround(terrain, river)
        river:RemovePoint(removedPoint)
        terrain:GetWater():RiverChanged(river)
        CarveRiverGround(terrain, river, operation)
        chosenRiverPoint = removedPoint - 1
        if chosenRiverPoint < 0
            chosenRiverPoint = 0
        end
        ShowChosenRiverLine(terrain)
        FinishRiverChange(terrain, before, operation, "remove a point of " + river:GetName(), "Removed point " + (removedPoint + 1) + " of " + river:GetName() + ". " + DescribeRiver(terrain, river))
        return true
    end

    /*
    This action adds a point to a river where its water is, between two of
    its points, with the width and depth between theirs. It can be undone.
    */
    private action InsertRiverPoint(EditorTerrain terrain, TerrainRiver river, integer index, number x, number z)
        WaterState before
        before:Copy(terrain)
        number width = (river:GetPointWidth(index - 1) + river:GetPointWidth(index)) / 2
        number depth = (river:GetPointDepth(index - 1) + river:GetPointDepth(index)) / 2
        TerrainStroke operation = StartRiverGround(terrain, river)
        river:InsertPoint(index, RoundTenth(x), RoundTenth(z), width, depth)
        terrain:GetWater():RiverChanged(river)
        CarveRiverGround(terrain, river, operation)
        ChooseRiverPoint(terrain, river, index)
        FinishRiverChange(terrain, before, operation, "add a point to " + river:GetName(), "Added point " + (index + 1) + " to " + river:GetName() + ". Drag it to move it, or press Delete to remove it.")
    end

    /*
    This action makes a river's point the chosen one, and shows the river's
    path with it larger.
    */
    private action ChooseRiverPoint(EditorTerrain terrain, TerrainRiver river, integer point)
        chosenRiver = river
        chosenRiverPoint = point
        ShowChosenRiverLine(terrain)
        // The other rivers keep their paths shown.
        if IsRiverToolActive()
            ShowAllRiverLines(terrain)
        end
    end

    /*
    This action moves the dragged point of a river to the ground under the
    pointer; the river follows when the button is let go.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action DragRiverPoint(number x, number y)
        if not riverDragging or chosenRiver = undefined or brushTerrain = undefined
            return now
        end
        Vector3 hit = PickPointerGround(brushTerrain, x, y)
        if hit = undefined or not brushTerrain:GetWorldTerrain():GetData():HasHeight(hit:GetX(), hit:GetZ())
            return now
        end
        riverDragX = hit:GetX()
        riverDragZ = hit:GetZ()
        riverDragMoved = true
        Array<number> xs
        Array<number> zs
        integer i = 0
        repeat while i < chosenRiver:GetPointCount()
            if i = chosenRiverPoint
                xs:Add(riverDragX)
                zs:Add(riverDragZ)
            else
                xs:Add(chosenRiver:GetPointX(i))
                zs:Add(chosenRiver:GetPointZ(i))
            end
            i = i + 1
        end
        ShowRiverLine(brushTerrain, xs, zs, chosenRiverPoint)
    end

    /*
    This action finishes a drag when the button is let go: the point moves,
    the river's water and bed follow, as one change that can be undone.
    */
    private action UpdateRiverDrag
        if not riverDragging
            return now
        end
        if strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
            return now
        end
        riverDragging = false
        if not riverDragMoved or chosenRiver = undefined or brushTerrain = undefined
            return now
        end
        EditorTerrain terrain = brushTerrain
        if not CanChangeWater(terrain)
            ShowChosenRiverLine(terrain)
            return now
        end
        TerrainRiver river = chosenRiver
        WaterState before
        before:Copy(terrain)
        TerrainStroke operation = StartRiverGround(terrain, river)
        river:MovePoint(chosenRiverPoint, RoundTenth(riverDragX), RoundTenth(riverDragZ))
        terrain:GetWater():RiverChanged(river)
        CarveRiverGround(terrain, river, operation)
        ShowChosenRiverLine(terrain)
        FinishRiverChange(terrain, before, operation, "move a point of " + river:GetName(), "Moved point " + (chosenRiverPoint + 1) + " of " + river:GetName() + " to " +
            RoundTenth(riverDragX) + ", " + RoundTenth(riverDragZ) + ". " + DescribeRiver(terrain, river))
    end

    /*
    This action follows the pointer with the River tool: while a river is
    drawn, the line reaches from its last point to the ground under the
    pointer, to show where the next point would go.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action MoveRiverLineToPointer(number x, number y)
        HideTerrainGhost()
        if not riverDrawing or riverTerrain = undefined
            return now
        end
        Vector3 hit = PickPointerGround(riverTerrain, x, y)
        if hit = undefined or not riverTerrain:GetWorldTerrain():GetData():HasHeight(hit:GetX(), hit:GetZ())
            return now
        end
        Array<number> xs
        Array<number> zs
        integer i = 0
        repeat while i < riverDraftX:GetSize()
            xs:Add(riverDraftX:Get(i))
            zs:Add(riverDraftZ:Get(i))
            i = i + 1
        end
        xs:Add(hit:GetX())
        zs:Add(hit:GetZ())
        ShowRiverLine(riverTerrain, xs, zs, riverDraftX:GetSize() - 1)
    end

    /*
    This action leaves the River tool's work: a river being drawn is
    dropped, unfinished, a drag stops, and the path line is hidden.
    */
    private action LeaveRiverTool
        riverDrawing = false
        riverDragging = false
        riverDraftX:Empty()
        riverDraftZ:Empty()
        chosenRiver = undefined
        chosenRiverPoint = -1
        HideRiverLine()
        HideAllRiverLines()
    end

    /*
    This action says which rivers a terrain has, for choosing the River
    tool: "2 rivers: River 1, 7 points, and River 2, 3 points. Their paths
    are shown; click a point to choose it, then drag it, or press Delete.",
    or nothing for a terrain with none.
    */
    private action DescribeRiversForTool(EditorTerrain terrain) returns text
        TerrainWater water = terrain:GetWater()
        integer count = water:GetRiverCount()
        if count = 0
            return ""
        end
        text result = "1 river: "
        if count > 1
            result = "" + count + " rivers: "
        end
        integer i = 0
        repeat while i < count
            TerrainRiver river = water:GetRiver(i)
            if i > 0 and i = count - 1
                result = result + ", and "
            elseif i > 0
                result = result + ", "
            end
            result = result + river:GetName() + ", " + river:GetPointCount() + " points"
            i = i + 1
        end
        if count = 1
            return result + ". Its path is shown; click a point to choose it, then drag it, or press Delete. "
        end
        return result + ". Their paths are shown; click a point to choose it, then drag it, or press Delete. "
    end

    /*
    This action shows the path of every river on a terrain but the chosen
    one, whose path has its own line, so their points can be found and
    clicked.
    */
    private action ShowAllRiverLines(EditorTerrain terrain)
        EditorLayer layer = GetSelectedLayer()
        if terrain = undefined or not (layer is EditorLayer3D)
            HideAllRiverLines()
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainWater water = terrain:GetWater()
        integer used = 0
        integer i = 0
        repeat while i < water:GetRiverCount()
            TerrainRiver river = water:GetRiver(i)
            if river not= chosenRiver and river:GetPointCount() > 0
                if used >= allRiverLines:GetSize()
                    TerrainPathLine line
                    line:SetName("River Path")
                    layer3D:Add(line)
                    allRiverLines:Add(line)
                end
                Array<number> xs
                Array<number> zs
                integer point = 0
                repeat while point < river:GetPointCount()
                    xs:Add(river:GetPointX(point))
                    zs:Add(river:GetPointZ(point))
                    point = point + 1
                end
                TerrainPathLine pathLine = allRiverLines:Get(used)
                pathLine:Place(data, xs, zs, -1)
                pathLine:Show()
                used = used + 1
            end
            i = i + 1
        end
        // Lines no river needs now are hidden.
        integer extra = used
        repeat while extra < allRiverLines:GetSize()
            allRiverLines:Get(extra):Hide()
            extra = extra + 1
        end
        allRiverLinesShown = used
    end

    /*
    This action hides every river's path but the chosen one's.
    */
    private action HideAllRiverLines
        integer i = 0
        repeat while i < allRiverLines:GetSize()
            allRiverLines:Get(i):Hide()
            i = i + 1
        end
        allRiverLinesShown = 0
    end

    /*
    This action is the Water section's Edit path for a river: the River tool is chosen, the river's
    first point is chosen and
    the terrain cursor moves to it, and every river's path shows, so the
    river's points can be clicked, dragged or removed.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter index The river, from 0
    */
    action EditTerrainRiver(EditorTerrain terrain, integer index)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        if index < 0 or index >= water:GetRiverCount()
            return now
        end
        TerrainRiver river = water:GetRiver(index)
        if terrain:GetToolNumber() not= terrain:RIVER_TOOL
            SetTerrainTool(terrain, terrain:RIVER_TOOL)
        end
        // A river being drawn is dropped first, so the clicks that follow
        // edit this river, not the drawing.
        if riverDrawing
            riverDrawing = false
            riverDraftX:Empty()
            riverDraftZ:Empty()
        end
        if river:GetPointCount() > 0
            terrain:SetBrushPosition(river:GetPointX(0), river:GetPointZ(0))
            UpdateBrushPreview()
        end
        ChooseRiverPoint(terrain, river, 0)
        if terrainWaterPropertiesDialog:IsShowing()
            terrainWaterPropertiesDialog:OpenRiverPart(index)
        end
        NotifyAccessibility(terrain, "Editing " + river:GetName() + ", point 1 of " + river:GetPointCount() + " chosen. In the scene, click a point to choose it, drag it to move it, click the water between points to add one, or press Delete to remove the chosen point.")
    end

    /*
    This action shows the chosen river's path, with its chosen point
    larger.
    */
    private action ShowChosenRiverLine(EditorTerrain terrain)
        if chosenRiver = undefined
            HideRiverLine()
            return now
        end
        Array<number> xs
        Array<number> zs
        integer i = 0
        repeat while i < chosenRiver:GetPointCount()
            xs:Add(chosenRiver:GetPointX(i))
            zs:Add(chosenRiver:GetPointZ(i))
            i = i + 1
        end
        ShowRiverLine(terrain, xs, zs, chosenRiverPoint)
    end

    /*
    This action shows the path line through points over a terrain's ground.
    */
    private action ShowRiverLine(EditorTerrain terrain, Array<number> xs, Array<number> zs, integer chosen)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D) or xs:IsEmpty()
            return now
        end
        if riverLine = undefined
            TerrainPathLine line
            line:SetName("River Path")
            riverLine = line
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(line)
        end
        riverLine:Place(terrain:GetWorldTerrain():GetData(), xs, zs, chosen)
        if not riverLineShown
            riverLine:Show()
            riverLineShown = true
        end
    end

    /*
    This action hides the path line.
    */
    private action HideRiverLine
        if riverLine not= undefined and riverLineShown
            riverLine:Hide()
        end
        riverLineShown = false
    end

    /*
    This action starts a river change's ground edit: the ground under the
    river now is kept for undoing, and the bed it carved is put back, so the
    river can be carved again where it goes now.
    */
    private action StartRiverGround(EditorTerrain terrain, TerrainRiver river) returns TerrainStroke
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation
        operation:BeginOperation(data, "river", true, false)
        Array<integer> area = river:GetCarveArea(data)
        if area:GetSize() = 4
            operation:CopyArea(area:Get(0), area:Get(1), area:Get(2), area:Get(3))
        end
        integer kept = river:Uncarve(data)
        return operation
    end

    /*
    This action carves a river's bed where it goes now, keeping the ground
    there for undoing first. Call the water's RiverChanged before it, so
    the river's line is found.
    */
    private action CarveRiverGround(EditorTerrain terrain, TerrainRiver river, TerrainStroke operation)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        Array<integer> area = river:GetCarveArea(data)
        if area:GetSize() = 4
            operation:CopyArea(area:Get(0), area:Get(1), area:Get(2), area:Get(3))
        end
        integer carved = river:Carve(data)
    end

    /*
    This action finishes a river change: the water and the ground's edit go
    into the undo list as one step, the terrain is redrawn and marked
    changed, and what happened is said.
    */
    private action FinishRiverChange(EditorTerrain terrain, WaterState before, TerrainStroke operation, text name, text message)
        TerrainStrokeEdit groundEdit = operation:End()
        WaterState after
        after:Copy(terrain)
        SceneEditorRiverEdit edit
        edit:Create(me, terrain, before, after, groundEdit, name)
        editManager:Add(edit)
        RiverEdited(terrain, groundEdit not= undefined, message)
    end

    /*
    This action is called after a river changed, or a change was undone or
    redone: the ground is redrawn if it changed, the
    terrain is marked changed for the next save, the Water section follows,
    and what happened is said.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter groundChanged True if the river's bed changed the ground
    Attribute: Parameter message What happened
    */
    action RiverEdited(EditorTerrain terrain, boolean groundChanged, text message)
        if terrain = undefined
            return now
        end
        if stroking
            CancelTerrainStroke()
        end
        if groundChanged
            RedrawTerrain(terrain)
            TerrainFactsChanged(terrain)
            if riverLine not= undefined
                riverLine:Forget()
            end
            integer lineIndex = 0
            repeat while lineIndex < allRiverLines:GetSize()
                allRiverLines:Get(lineIndex):Forget()
                lineIndex = lineIndex + 1
            end
        end
        terrain:WaterChanged()
        terrain:SetChanged(true)
        // A chosen river or point that an undo took away is let go.
        if chosenRiver not= undefined
            integer index = terrain:GetWater():GetRiverIndex(chosenRiver)
            if index < 0
                chosenRiver = undefined
                chosenRiverPoint = -1
                HideRiverLine()
            else
                if chosenRiverPoint >= chosenRiver:GetPointCount()
                    chosenRiverPoint = chosenRiver:GetPointCount() - 1
                end
                if riverLineShown
                    ShowChosenRiverLine(terrain)
                end
            end
        end
        // Every river's path follows, while the River tool is chosen.
        if IsRiverToolActive() and terrain = brushTerrain
            ShowAllRiverLines(terrain)
        end
        if terrainWaterPropertiesDialog:IsShowing()
            terrainWaterPropertiesDialog:Refresh()
        end
        if message not= ""
            NotifyAccessibility(terrain, message)
        end
    end

    /*
    This action describes a river: its points, length, the water's height
    at its start and end, what water it starts from or ends in, and where
    it cuts into the ground.
    */
    private action DescribeRiver(EditorTerrain terrain, TerrainRiver river) returns text
        TerrainWater water = terrain:GetWater()
        integer count = river:GetPointCount()
        text result = river:GetName() + ": " + count + " points, " + RoundTenth(river:GetLength()) + " units long, water from height " +
            RoundTenth(river:GetStartLevel()) + " down to " + RoundTenth(river:GetEndLevel()) + "."
        if count >= 2
            if water:GetStillWaterLevelAt(river:GetPointX(0), river:GetPointZ(0)) not= water:NO_WATER
                result = result + " It starts from still water."
            end
            if water:GetStillWaterLevelAt(river:GetPointX(count - 1), river:GetPointZ(count - 1)) not= water:NO_WATER
                result = result + " It ends in still water."
            end
        end
        if river:GetDeepestCut() >= 0.5 and river:GetDeepestCutPoint() >= 0
            integer cutPoint = river:GetDeepestCutPoint()
            result = result + " The river cuts " + RoundTenth(river:GetDeepestCut()) + " units into the ground between points " + (cutPoint + 1) + " and " + (cutPoint + 2) + ", where the ground rises."
        end
        return result
    end

    /*
    This action changes a river's name, width, depth and speed, from the
    Water section. The width and depth are set at every
    point, and the bed is carved again. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter index The river, from 0
    Attribute: Parameter name Its name
    Attribute: Parameter width How wide it is
    Attribute: Parameter depth How deep it is in the middle
    Attribute: Parameter speed How fast its ripples flow, in units a second
    */
    action SetTerrainRiver(EditorTerrain terrain, integer index, text name, number width, number depth, number speed)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        if index < 0 or index >= water:GetRiverCount() or width <= 0 or depth <= 0 or speed < 0
            return now
        end
        TerrainRiver river = water:GetRiver(index)
        WaterState before
        before:Copy(terrain)
        TerrainStroke operation = StartRiverGround(terrain, river)
        river:SetName(name)
        river:SetWidth(width)
        river:SetDepth(depth)
        river:SetSpeed(speed)
        water:RiverChanged(river)
        CarveRiverGround(terrain, river, operation)
        FinishRiverChange(terrain, before, operation, "change " + name, name + ": " + RoundTenth(width) + " units wide, " + RoundTenth(depth) + " deep, flowing at " + RoundTenth(speed) + ". " + DescribeRiver(terrain, river))
    end

    /*
    This action removes one of a terrain's rivers, putting back the ground
    it carved where it wasn't changed since. It can be
    undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter index The river, from 0
    */
    action RemoveTerrainRiver(EditorTerrain terrain, integer index)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        if index < 0 or index >= water:GetRiverCount()
            return now
        end
        TerrainRiver river = water:GetRiver(index)
        text riverName = river:GetName()
        WaterState before
        before:Copy(terrain)
        TerrainStroke operation = StartRiverGround(terrain, river)
        boolean removed = water:RemoveRiver(river)
        if chosenRiver = river
            chosenRiver = undefined
            chosenRiverPoint = -1
            HideRiverLine()
        end
        FinishRiverChange(terrain, before, operation, "remove " + riverName, "Removed " + riverName + ". Its bed was filled back in where the ground wasn't changed since.")
    end

    /*
    This action starts a Paint water stroke. It paints into
    the lake under the brush, or a new lake of water cells whose level is
    the ground's height under the brush plus the terrain's water depth. With
    Ctrl held, it erases the water of the lake under the brush instead, and
    does nothing where there is none.

    Attribute: Parameter terrain The terrain
    Attribute: Returns True if a stroke started
    */
    private action BeginWaterStroke(EditorTerrain terrain) returns boolean
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so its water can't be changed.")
            return false
        end
        boolean control = strokeMonitor:IsKeyPressed(modifierKeys:CONTROL_LEFT) or strokeMonitor:IsKeyPressed(modifierKeys:CONTROL_RIGHT)
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        TerrainWater water = terrain:GetWater()
        TerrainLake lake = water:GetLakeAt(x, z)
        if control and lake = undefined
            NotifyAccessibility(terrain, "There is no water under the brush to erase.")
            return false
        end
        WaterState before
        before:Copy(terrain)
        waterStrokeBefore = before
        waterStrokeAdds = not control
        waterStrokeMadeLake = (lake = undefined)
        if lake = undefined
            // New painted water follows the ground, the water depth above
            // it, so it never floats where the ground falls away.
            lake = water:AddPaintedLake(terrain:GetWaterDepth())
            lake:SetName("Lake " + water:GetLakeCount())
        end
        waterStrokeLake = lake
        waterStrokeCells = 0
        waterStrokeDabbed = false
        waterStroking = true
        ApplyWaterStroke(terrain)
        return true
    end

    /*
    This action paints or erases water under the brush during a Paint water
    stroke, once the brush has moved a quarter of its size since the last
    time.
    */
    private action ApplyWaterStroke(EditorTerrain terrain)
        if not terrain:IsBrushOnGround()
            return now
        end
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        number radius = terrain:GetBrush():GetSize()
        if waterStrokeDabbed
            number movedX = x - waterStrokeX
            number movedZ = z - waterStrokeZ
            number step = radius / 4
            if movedX * movedX + movedZ * movedZ < step * step
                return now
            end
        end
        waterStrokeDabbed = true
        waterStrokeX = x
        waterStrokeZ = z
        integer changed = terrain:GetWater():PaintLake(waterStrokeLake, x, z, radius, waterStrokeAdds)
        waterStrokeCells = waterStrokeCells + changed
    end

    /*
    This action finishes a Paint water stroke: a lake left with no water is
    removed, the change goes into the undo list, and what changed is
    announced.
    */
    private action EndWaterStroke
        waterStroking = false
        if brushTerrain = undefined
            return now
        end
        text name = waterStrokeLake:GetName()
        if waterStrokeCells = 0
            // A lake made for this stroke, which got no water, goes again.
            if waterStrokeMadeLake
                waterStrokeBefore:TakeOutLake(brushTerrain, waterStrokeLake)
                brushTerrain:WaterChanged()
            end
            NotifyAccessibility(brushTerrain, "Nothing changed")
            return now
        end
        boolean emptied = waterStrokeLake:IsMasked() and waterStrokeLake:GetWaterCellCount() = 0
        if emptied
            waterStrokeBefore:TakeOutLake(brushTerrain, waterStrokeLake)
            brushTerrain:WaterChanged()
        end
        text message = ""
        if emptied
            message = "Erased all of " + name + ", so it was removed."
        elseif waterStrokeAdds
            message = "Painted water into " + name + ": " + waterStrokeLake:GetWaterCellCount() + " cells, water at " + waterStrokeLake:GetLevel() + "."
        else
            message = "Erased water from " + name + ": " + waterStrokeLake:GetWaterCellCount() + " cells left."
        end
        text changeName = "paint water"
        if not waterStrokeAdds
            changeName = "erase water"
        end
        RecordWaterChange(brushTerrain, waterStrokeBefore, changeName, message)
    end

    /*
    This action shows the Water section again, if it is showing.
    */
    private action RefreshWaterSection
        if terrainWaterPropertiesDialog:IsShowing()
            terrainWaterPropertiesDialog:Refresh()
        end
    end

    /*
    This action turns a terrain's sea on at a level, or off.
    It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter wanted True for a sea
    Attribute: Parameter level The sea's level
    */
    action SetTerrainSea(EditorTerrain terrain, boolean wanted, number level)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        boolean sameSea = (wanted = water:HasSea())
        if sameSea and (not wanted or level = water:GetSeaLevel())
            return now
        end
        WaterState before
        before:Copy(terrain)
        if wanted
            water:SetSeaLevel(level)
        else
            water:RemoveSea()
        end
        terrain:WaterChanged()
        if wanted
            RecordWaterChange(terrain, before, "sea level", "Sea at height " + level + ".")
        else
            RecordWaterChange(terrain, before, "remove sea", "No sea.")
        end
    end

    /*
    This action changes one of a terrain's lakes: its place, size, level
    and name. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter index The lake, from 0
    Attribute: Parameter x Its middle along x
    Attribute: Parameter z Its middle along z
    Attribute: Parameter width Its size along x
    Attribute: Parameter depth Its size along z
    Attribute: Parameter level The water's height
    Attribute: Parameter name Its name
    */
    action SetTerrainLake(EditorTerrain terrain, integer index, number x, number z, number width, number depth, number level, text name)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        if index < 0 or index >= water:GetLakeCount() or width <= 0 or depth <= 0
            return now
        end
        TerrainLake lake = water:GetLake(index)
        WaterState before
        before:Copy(terrain)
        water:SetLake(lake, x, z, width, depth, level)
        lake:SetName(name)
        terrain:WaterChanged()
        text message = name + ": water at height " + level + ", " + width + " by " + depth + " units, middle " + x + ", " + z + "."
        if water:DidLastFillSpill()
            message = name + ": the hollow spills over its rim at height " + RoundTenth(lake:GetLevel()) + ", so the water stops there, about " +
                RoundTenth(lake:GetWidth()) + " by " + RoundTenth(lake:GetDepth()) + "."
        elseif lake:IsMasked()
            message = name + ": water at height " + RoundTenth(lake:GetLevel()) + ", filling its hollow, about " +
                RoundTenth(lake:GetWidth()) + " by " + RoundTenth(lake:GetDepth()) + "."
        end
        RecordWaterChange(terrain, before, "change " + name, message)
    end

    /*
    This action removes one of a terrain's lakes. It can be
    undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter index The lake, from 0
    */
    action RemoveTerrainLake(EditorTerrain terrain, integer index)
        if not CanChangeWater(terrain)
            return now
        end
        TerrainWater water = terrain:GetWater()
        if index < 0 or index >= water:GetLakeCount()
            return now
        end
        WaterState before
        before:Copy(terrain)
        TerrainLake lake = water:GetLake(index)
        text name = lake:GetName()
        before:TakeOutLake(terrain, lake)
        terrain:WaterChanged()
        RecordWaterChange(terrain, before, "remove " + name, "Removed " + name + ".")
    end

    /*
    This action changes one number of a terrain's water look: the shallow or deep color's red,
    green, blue or alpha, from 0 to 1,
    or the clarity, shore fade, ripple size, ripple speed, roughness,
    ripple strength or reflection. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter kind Which number: 0 to 3 the shallow color's parts, 4 to 7 the deep color's, then 8 clarity, 9 shore fade, 10 ripple size, 11 ripple speed, 12 roughness, 13 ripple strength, 14 reflection
    Attribute: Parameter value The new value
    Attribute: Parameter label What the number is called, for speaking
    */
    action SetTerrainWaterLook(EditorTerrain terrain, integer kind, number value, text label)
        if not CanChangeWater(terrain) or value < 0
            return now
        end
        if kind < 8 and value > 1
            return now
        end
        WaterShaderProgram program = terrain:GetWater():GetWaterProgram()
        WaterState before
        before:Copy(terrain)
        if kind < 8
            Color old = program:GetShallowColor()
            if kind >= 4
                old = program:GetDeepColor()
            end
            number red = old:GetRed()
            number green = old:GetGreen()
            number blue = old:GetBlue()
            number alpha = old:GetAlpha()
            integer part = kind mod 4
            if part = 0
                red = value
            elseif part = 1
                green = value
            elseif part = 2
                blue = value
            else
                alpha = value
            end
            Color made
            made:SetColor(red, green, blue, alpha)
            if kind >= 4
                program:SetDeepColor(made)
            else
                program:SetShallowColor(made)
            end
        elseif kind = 8
            program:SetClarity(value)
        elseif kind = 9
            program:SetShoreFade(value)
        elseif kind = 10
            program:SetWaveScale(value)
        elseif kind = 11
            program:SetWaveSpeed(value)
        elseif kind = 12
            program:SetRoughness(value)
        elseif kind = 13
            program:SetNormalStrength(value)
        elseif kind = 14
            if value > 1
                return now
            end
            program:SetReflectionStrength(value)
        else
            return now
        end
        terrain:WaterChanged()
        RecordWaterChange(terrain, before, "water look", label + " " + value + ".")
    end

    /*
    This action puts a water change in the undo list, if it changed
    anything, and marks the terrain changed for the next save, which
    writes its water.json.
    */
    private action RecordWaterChange(EditorTerrain terrain, WaterState before, text name, text message)
        WaterState after
        after:Copy(terrain)
        if before:IsSameAs(after)
            return now
        end
        SceneEditorWaterEdit edit
        edit:Create(me, terrain, before, after, name)
        editManager:Add(edit)
        WaterEdited(terrain, message)
    end

    /*
    This action returns true if the editor's 3D layers have skies to edit,
    so the Properties panel shows the Sky section. A scene editor does; a
    view built on it that shows no sky, such as Quorum Studio's model
    preview, returns false.

    Attribute: Returns True if the Sky section shows for a 3D layer
    */
    action HasSky returns boolean
        return true
    end

    /*
    This action gives a 3D layer the sky found in a folder (QuincyWorld demo
    D3): six pictures named as Skybox:LoadFolder says. A folder inside the
    project is kept relative to it, so the scene can be moved and games find
    the same pictures. It can be undone.

    Attribute: Parameter layer The 3D layer
    Attribute: Parameter folder The folder chosen
    */
    action ChooseLayerSkyFolder(EditorLayer3D layer, File folder)
        if layer = undefined or folder = undefined
            return now
        end
        File projectFolder = folder
        if projectLocation not= undefined and folder:GetAbsolutePath():StartsWith(projectLocation:GetAbsolutePath())
            projectFolder = ConvertToProjectFile(GetProjectRelativePath(folder))
        elseif projectLocation not= undefined
            NotifyAccessibility(me, "That folder is outside the project, so the sky's pictures may not be found when the game runs. Copying them into the project is safer.")
        end
        Skybox before = layer:GetSkybox()
        number beforeTurn = 0
        if before not= undefined
            beforeTurn = before:GetTurn()
        end
        Skybox sky
        if not sky:LoadFolder(projectFolder)
            NotifyAccessibility(me, "No sky: the folder " + folder:GetFileName() + " needs six pictures named right, left, top, bottom, front and back, or px, nx, py, ny, pz and nz.")
            return now
        end
        sky:SetTurn(beforeTurn)
        layer:SetSkybox(sky)
        SceneEditorSkyEdit edit
        edit:Create(me, layer, before, beforeTurn, sky, beforeTurn, "choose sky")
        editManager:Add(edit)
        SkyEdited(layer, "Sky chosen from " + folder:GetFileName() + ".")
    end

    /*
    This action takes a 3D layer's sky away (QuincyWorld demo D3). It can be
    undone.

    Attribute: Parameter layer The 3D layer
    */
    action RemoveLayerSky(EditorLayer3D layer)
        if layer = undefined
            return now
        end
        Skybox before = layer:GetSkybox()
        if before = undefined
            NotifyAccessibility(me, "This layer has no sky.")
            return now
        end
        layer:SetSkybox(undefined)
        SceneEditorSkyEdit edit
        edit:Create(me, layer, before, before:GetTurn(), undefined, 0, "remove sky")
        editManager:Add(edit)
        SkyEdited(layer, "Sky removed.")
    end

    /*
    This action turns a 3D layer's sky about the up axis (QuincyWorld demo
    D3), in degrees. It can be undone.

    Attribute: Parameter layer The 3D layer
    Attribute: Parameter degrees The turn
    */
    action SetLayerSkyTurn(EditorLayer3D layer, number degrees)
        if layer = undefined
            return now
        end
        Skybox sky = layer:GetSkybox()
        if sky = undefined
            SkyEdited(layer, "")
            return now
        end
        number before = sky:GetTurn()
        if before = degrees
            return now
        end
        sky:SetTurn(degrees)
        SceneEditorSkyEdit edit
        edit:Create(me, layer, sky, before, sky, degrees, "turn sky")
        editManager:Add(edit)
        SkyEdited(layer, "Sky turned to " + degrees + " degrees.")
    end

    /*
    This action turns a 3D layer's linear lighting on or off: on, colors are lit as amounts of light; off, as stored.
    The change is saved with the scene and can be undone.

    Attribute: Parameter layer The layer
    Attribute: Parameter linear True for linear lighting
    */
    action SetLayerLinearLighting(EditorLayer3D layer, boolean linear)
        if layer = undefined or not (layer:GetEnvironment() is EnvironmentVulkan)
            return now
        end
        EnvironmentVulkan environment = cast(EnvironmentVulkan, layer:GetEnvironment())
        boolean before = environment:IsLinearLighting()
        if before = linear
            return now
        end
        environment:SetLinearLighting(linear)
        text changeName = "turn off linear lighting"
        text message = "Linear lighting off."
        if linear
            changeName = "turn on linear lighting"
            message = "Linear lighting on."
        end
        SceneEditorLinearLightingEdit edit
        edit:Create(me, layer, before, linear, changeName)
        editManager:Add(edit)
        SkyEdited(layer, message)
    end

    /*
    This action is called after a layer's sky changed, or a change was undone
    or redone (QuincyWorld demo D3): the Sky section follows, and the message
    is announced.

    Attribute: Parameter layer The layer
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    /*
    This action returns the settings of an item's controller, read from its
    Controller block, or undefined if it has none. Changing them changes
    nothing until they are given back with ChangeController.

    Attribute: Parameter item The item, such as a model
    Attribute: Returns A copy of its Vehicle controller's settings, or undefined
    */
    action GetControllerSettings(Item3D item) returns VehicleControllerSettings
        if item = undefined or not item:HasProperty(properties:CONTROLLER)
            return undefined
        end
        JavaScriptObjectNotation block = item:GetProperty(properties:CONTROLLER)
        if block = undefined or not block:HasValue("Type")
            return undefined
        end
        VehicleControllerSettings settings
        if block:GetValue("Type") not= settings:VEHICLE
            return undefined
        end
        settings:FromJson(block)
        return settings
    end

    /*
    This action gives an item a controller's settings, or takes its
    controller away, as one step to undo, then shows the change and says
    what happened. The settings are saved in the scene's Controller block.

    Attribute: Parameter item The item, such as a model
    Attribute: Parameter settings The new settings, or undefined for no controller
    Attribute: Parameter changeName What changed, for Undo and Redo, such as "change stiffness"
    Attribute: Parameter message What to say, such as "Stiffness 10."
    */
    action ChangeController(Item3D item, VehicleControllerSettings settings, text changeName, text message)
        if item = undefined
            return now
        end
        // A vehicle needs physics in its layer in games.
        if settings not= undefined
            TurnOnLayerPhysicsIfNeeded()
        end
        VehicleControllerSettings before = GetControllerSettings(item)
        SetControllerBlock(item, settings)
        SceneEditorControllerEdit edit
        edit:Create(me, item, before, settings, changeName)
        editManager:Add(edit)
        ControllerEdited(item, message)
    end

    /*
    This action sets whether a game using the scene runs physics in a
    layer, and its gravity, as one step to undo, then shows and says the
    change. The editor itself never runs physics.

    Attribute: Parameter layer The layer
    Attribute: Parameter enabled True for physics in games
    Attribute: Parameter gravity The gravity
    Attribute: Parameter changeName What changed, for Undo and Redo, such as "change gravity"
    Attribute: Parameter message What to say, such as "Gravity y -9.8."
    */
    action SetLayerGamePhysics(EditorLayer layer, boolean enabled, Vector3 gravity, text changeName, text message)
        if layer = undefined
            return now
        end
        boolean beforeEnabled = layer:IsGamePhysicsEnabled()
        Vector3 beforeGravity = layer:GetGameGravity()
        layer:SetGamePhysicsEnabled(enabled)
        layer:SetGameGravity(gravity:GetX(), gravity:GetY(), gravity:GetZ())
        SceneEditorLayerPhysicsEdit edit
        edit:Create(me, layer, beforeEnabled, beforeGravity, enabled, gravity, changeName)
        editManager:Add(edit)
        LayerPhysicsEdited(layer, message)
    end

    /*
    This action sets a layer's physics in games without a step to undo, such
    as when a change is undone or redone.

    Attribute: Parameter layer The layer
    Attribute: Parameter enabled True for physics in games
    Attribute: Parameter gravity The gravity
    Attribute: Parameter message What to say
    */
    action PutLayerPhysics(EditorLayer layer, boolean enabled, Vector3 gravity, text message)
        if layer = undefined
            return now
        end
        layer:SetGamePhysicsEnabled(enabled)
        layer:SetGameGravity(gravity:GetX(), gravity:GetY(), gravity:GetZ())
        LayerPhysicsEdited(layer, message)
    end

    /*
    This action is called after a layer's physics in games changed: its
    Physics section follows, and the message is announced.

    Attribute: Parameter layer The layer
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action LayerPhysicsEdited(EditorLayer layer, text message)
        if layerPhysicsPropertiesDialog:IsShowing()
            layerPhysicsPropertiesDialog:Refresh()
        end
        if message not= ""
            NotifyAccessibility(me, message)
        end
    end

    /*
    This action turns on physics in games for the selected layer if it is
    off, such as when an item in it is given physics or a Vehicle
    controller, and says so. It is part of that change, not a step of its
    own.
    */
    action TurnOnLayerPhysicsIfNeeded
        EditorLayer layer = GetSelectedLayer()
        if layer = undefined or layer:IsGamePhysicsEnabled()
            return now
        end
        layer:SetGamePhysicsEnabled(true)
        LayerPhysicsEdited(layer, "Physics in games turned on for " + layer:GetName() + ", so it moves in a game. Its gravity is in the layer's Physics section.")
    end

    /*
    This action gives an item a controller's settings, or takes its
    controller away, without a step to undo, such as when a change is undone
    or redone.

    Attribute: Parameter item The item
    Attribute: Parameter settings The settings, or undefined for no controller
    Attribute: Parameter message What to say
    */
    action PutController(Item3D item, VehicleControllerSettings settings, text message)
        if item = undefined
            return now
        end
        SetControllerBlock(item, settings)
        ControllerEdited(item, message)
    end

    /*
    Keeps an item's controller settings in its Controller block, or none.
    */
    private action SetControllerBlock(Item3D item, VehicleControllerSettings settings)
        if settings = undefined
            item:SetProperty(properties:CONTROLLER, undefined)
        else
            item:SetProperty(properties:CONTROLLER, settings:ToJson())
        end
    end

    /*
    This action is called after an item's controller changed, or a change
    was undone or redone: the Controller section and the guides follow, and
    the message is announced.

    Attribute: Parameter item The item
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action ControllerEdited(Item3D item, text message)
        if controllerPropertiesDialog:IsShowing()
            controllerPropertiesDialog:Refresh()
        end
        // A followed car's game camera goes to its new follow place, such as
        // after the change is undone.
        if followCameraActive and followCameraModel not= undefined and item:Equals(followCameraModel)
            VehicleControllerSettings followed = GetControllerSettings(item)
            if followed not= undefined and followed:IsCameraFollowing()
                PlaceFollowCamera(followed)
            end
        end
        // The item's own Physics card shows or gives way to a note.
        if item3dPropertiesDialog:IsShowing() and GetSelectedItem() is EditorItem3D
            item3dPropertiesDialog:SetFields(cast(EditorItem3D, GetSelectedItem()))
        end
        if message not= ""
            NotifyAccessibility(me, message)
        end
    end

    /*
    This action draws a vehicle's guides over its model: its physics box, an
    arrow out of its front, its wheels and springs, and where the following
    camera starts. They are an editor helper, not saved.

    Attribute: Parameter item The model
    Attribute: Parameter settings Its Vehicle controller's settings
    */
    action ShowVehicleGuides(Item3D item, VehicleControllerSettings settings)
        EditorLayer layer = GetSelectedLayer()
        if item = undefined or settings = undefined or not (layer is EditorLayer3D)
            HideVehicleGuides()
            return now
        end
        if vehicleGuides = undefined
            VehicleGuides guides
            guides:SetName("Vehicle Guides")
            vehicleGuides = guides
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(guides)
        end
        vehicleGuides:Place(item, settings)
        vehicleGuides:Show()
        MakeSeeThrough(item)
        FadeSelectionBox()
    end

    /*
    This action hides a vehicle's guides, and draws the car as it is again.
    */
    action HideVehicleGuides
        if vehicleGuides not= undefined
            vehicleGuides:Hide()
        end
        ClearSeeThrough()
        if fadedBox not= undefined
            fadedBox:SetFaint(false)
            fadedBox = undefined
        end
    end

    /*
    Draws the selected item's box faint, so the vehicle guides inside it
    show.
    */
    private action FadeSelectionBox
        Item selected = GetSelectedItem()
        if not (selected is SelectionHighlight3D)
            return now
        end
        SelectionHighlight3D box = cast(SelectionHighlight3D, selected)
        if fadedBox not= undefined and not fadedBox:Equals(box)
            fadedBox:SetFaint(false)
        end
        box:SetFaint(true)
        fadedBox = box
    end

    /*
    Draws a model see-through, each part at SEE_THROUGH_OPACITY of its own
    color, so the vehicle guides inside it show. Its colors are kept to put
    back (ClearSeeThrough).
    */
    private action MakeSeeThrough(Item3D item)
        if seeThroughModel not= undefined and item:Equals(seeThroughModel)
            return now
        end
        ClearSeeThrough()
        if not (item is Model)
            return now
        end
        Model model = cast(Model, item)
        if model:GetModelBlueprint() = undefined
            return now
        end
        seeThroughColors:Empty()
        seeThroughHadTransparency = model:HasTransparency()
        integer parts = model:GetMeshCount()
        if parts < 1
            parts = 1
        end
        integer part = 0
        repeat while part < parts
            Color own = model:GetColor(part)
            Color faded
            if own = undefined
                Color none = undefined
                seeThroughColors:Add(none)
                faded:SetColor(1, 1, 1, SEE_THROUGH_OPACITY)
            else
                seeThroughColors:Add(own:Copy())
                faded:SetColor(own:GetRed(), own:GetGreen(), own:GetBlue(), own:GetAlpha() * SEE_THROUGH_OPACITY)
            end
            model:SetColor(part, faded)
            part = part + 1
        end
        seeThroughModel = model
    end

    /*
    Draws the see-through model with its own colors again.
    */
    private action ClearSeeThrough
        if seeThroughModel = undefined
            return now
        end
        Model model = seeThroughModel
        seeThroughModel = undefined
        integer part = 0
        repeat while part < seeThroughColors:GetSize()
            Color own = seeThroughColors:Get(part)
            if own = undefined
                Color white
                white:SetColor(1, 1, 1, 1)
                model:SetColor(part, white)
            else
                model:SetColor(part, own)
            end
            part = part + 1
        end
        seeThroughColors:Empty()
        if not seeThroughHadTransparency
            model:EnableTransparency(false)
        end
    end

    /*
    Returns true if a 3D item's position is in the editor camera's view.
    */
    private action IsInView(Item item) returns boolean
        if not (item is Item3D) or not (GetSelectedLayer() is EditorLayer3D)
            return false
        end
        Item3D item3D = cast(Item3D, item)
        EditorLayer3D layer3D = cast(EditorLayer3D, GetSelectedLayer())
        Frustum frustum = layer3D:GetEditorCamera():GetFrustum()
        if frustum = undefined
            return false
        end
        return frustum:PointInFrustum(item3D:GetGlobalX(), item3D:GetGlobalY(), item3D:GetGlobalZ())
    end

    /*
    This action keeps the key that holds a camera move, so the move stops
    once the key is up (UpdateCameraKeys). The key's release can come with
    other modifiers than its press, such as Shift let go first, and then it
    wouldn't stop the move itself. CameraKeyBehavior calls it.

    Attribute: Parameter key The key, such as an arrow key's code
    Attribute: Parameter move One of SceneConstants' CAMERA_ moves
    Attribute: Parameter x The move's x direction
    Attribute: Parameter y The move's y direction
    */
    action HoldCameraKey(integer key, integer move, integer x, integer y)
        cameraHeldKeys:Add(key)
        cameraHeldMoves:Add(move)
        cameraHeldX:Add(x)
        cameraHeldY:Add(y)
    end

    /*
    Stops each camera move whose key is no longer held.
    */
    private action UpdateCameraKeys
        integer i = 0
        repeat while i < cameraHeldKeys:GetSize()
            if strokeMonitor:IsKeyPressed(cameraHeldKeys:Get(i))
                i = i + 1
            else
                StopCameraMove(cameraHeldMoves:Get(i), cameraHeldX:Get(i), cameraHeldY:Get(i))
                cameraHeldKeys:RemoveAt(i)
                cameraHeldMoves:RemoveAt(i)
                cameraHeldX:RemoveAt(i)
                cameraHeldY:RemoveAt(i)
            end
        end
    end

    action SkyEdited(EditorLayer3D layer, text message)
        if skyPropertiesDialog:IsShowing()
            skyPropertiesDialog:Refresh()
        end
        if message not= ""
            NotifyAccessibility(me, message)
        end
    end

    /*
    This action is called after a terrain's water changed, or a change was
    undone or redone: the terrain is marked changed for the
    next save, the Water section follows, and the message is announced.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action WaterEdited(EditorTerrain terrain, text message)
        if terrain = undefined
            return now
        end
        if stroking
            CancelTerrainStroke()
        end
        terrain:SetChanged(true)
        if terrainWaterPropertiesDialog:IsShowing()
            terrainWaterPropertiesDialog:Refresh()
        end
        if message not= ""
            NotifyAccessibility(terrain, message)
        end
    end

    /*
    This action returns true if a terrain's water can be changed.
    */
    private action CanChangeWater(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so its water can't be changed.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action adds a foliage asset to a terrain's foliage list: a model file (.glb, .gltf, .fbx
    or .obj) is drawn as itself,
    and a picture (.png) as a card. A terrain with no foliage list is given
    one first, in the project's Scenes/Foliage folder, named after the
    terrain's folder. The asset is named after its file, and becomes the one
    the Foliage tool paints. It can't be undone; Remove takes it out.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter chosen The model or picture file
    */
    action AddFoliageAsset(EditorTerrain terrain, File chosen)
        if not CanChangeFoliage(terrain) or chosen = undefined or not chosen:Exists()
            return now
        end
        FoliageList list = terrain:GetFoliageList()
        if list = undefined
            list = CreateFoliageList(terrain)
            terrain:SetFoliageFile(GetProjectRelativePath(list:GetFile()))
            terrain:SetFoliageList(list)
        end
        if list:GetAssetCount() >= list:MAXIMUM_ASSETS
            NotifyAccessibility(terrain, "This foliage list has " + list:MAXIMUM_ASSETS + " assets, which is the most it can have.")
            return now
        end
        text fileName = chosen:GetFileName()
        text lower = fileName:ToLowerCase()
        text name = fileName
        integer dot = -1
        integer found = fileName:IndexOf(".")
        repeat while found >= 0
            dot = found
            found = fileName:IndexOf(".", found + 1)
        end
        if dot > 0
            name = fileName:GetSubtext(0, dot)
        end
        Material paths
        text listFolder = list:GetFile():GetParentDirectory():GetAbsolutePath()
        text relative = paths:GetRelativePath(listFolder, chosen:GetAbsolutePath())
        FoliageAsset asset
        asset:SetName(name)
        text kind = "model"
        if lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg")
            asset:SetCardPicturePath(relative)
            // Grass and other cards usually cast no shadows.
            asset:SetCastsShadows(false)
            kind = "card"
        else
            asset:SetModelPath(relative)
        end
        integer assetNumber = list:AddAsset(asset)
        terrain:SetFoliageAsset(assetNumber)
        terrain:SetFoliageListChanged(true)
        terrain:SetChanged(true)
        terrain:FoliageChanged()
        FoliageListEdited(terrain, "Added " + name + " as foliage asset " + (assetNumber + 1) + ", a " + kind + ". Paint it with the Foliage tool.")
    end

    /*
    This action removes a foliage asset from a terrain's foliage list, and
    every copy of it. The assets after it move up one
    place. It can't be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter asset The asset's number, from 0
    */
    action RemoveFoliageAsset(EditorTerrain terrain, integer asset)
        if not CanChangeFoliage(terrain)
            return now
        end
        FoliageList list = terrain:GetFoliageList()
        if list = undefined or asset < 0 or asset >= list:GetAssetCount()
            return now
        end
        text name = list:GetAsset(asset):GetName()
        TerrainFoliage foliage = terrain:GetTerrainFoliage()
        integer copies = foliage:GetCopyCount(asset)
        foliage:RemoveAsset(asset)
        list:RemoveAsset(asset)
        if terrain:GetFoliageAsset() >= list:GetAssetCount() and list:GetAssetCount() > 0
            terrain:SetFoliageAsset(list:GetAssetCount() - 1)
        elseif terrain:GetFoliageAsset() > asset
            terrain:SetFoliageAsset(terrain:GetFoliageAsset() - 1)
        end
        terrain:SetFoliageListChanged(true)
        terrain:SetChanged(true)
        terrain:FoliageChanged()
        FoliageListEdited(terrain, "Removed " + name + " and its " + copies + " copies.")
    end

    /*
    This action moves a foliage asset up or down one place in a terrain's
    foliage list. Every copy keeps its asset.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter asset The asset's number, from 0
    Attribute: Parameter up True to move it up, false down
    Attribute: Returns True if it moved
    */
    action MoveFoliageAsset(EditorTerrain terrain, integer asset, boolean up) returns boolean
        if not CanChangeFoliage(terrain)
            return false
        end
        FoliageList list = terrain:GetFoliageList()
        if list = undefined
            return false
        end
        integer target = asset + 1
        if up
            target = asset - 1
        end
        if asset < 0 or asset >= list:GetAssetCount() or target < 0 or target >= list:GetAssetCount()
            return false
        end
        list:SwapAssets(asset, target)
        terrain:GetTerrainFoliage():SwapAssets(asset, target)
        if terrain:GetFoliageAsset() = asset
            terrain:SetFoliageAsset(target)
        elseif terrain:GetFoliageAsset() = target
            terrain:SetFoliageAsset(asset)
        end
        terrain:SetFoliageListChanged(true)
        terrain:SetChanged(true)
        terrain:FoliageChanged()
        text direction = "down"
        if up
            direction = "up"
        end
        FoliageListEdited(terrain, "Moved " + list:GetAsset(target):GetName() + " " + direction + " to place " + (target + 1) + ".")
        return true
    end

    /*
    This action chooses the foliage asset the Foliage tool paints.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter asset The asset's number, from 0
    */
    action ChooseFoliageAsset(EditorTerrain terrain, integer asset)
        if terrain = undefined or asset < 0 or asset >= terrain:GetFoliageAssetCount()
            return now
        end
        if stroking
            EndTerrainStroke()
        end
        terrain:SetFoliageAsset(asset)
        TerrainBrushChanged(terrain)
        if terrainFoliagePropertiesDialog:IsShowing()
            terrainFoliagePropertiesDialog:Refresh()
        end
        NotifyAccessibility(terrain, "The Foliage tool paints " + terrain:GetFoliageList():GetAsset(asset):GetName())
    end

    /*
    This action is called after a foliage asset's settings were changed in
    the Foliage section: the list is marked changed for the
    next save, and the foliage is drawn again with the new settings.

    Attribute: Parameter terrain The terrain
    */
    action FoliageAssetSettingsChanged(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        terrain:SetFoliageListChanged(true)
        terrain:FoliageChanged()
    end

    /*
    This action keeps the Foliage and Brush sections in step after a
    terrain's foliage list changed, and announces what happened.
    */
    private action FoliageListEdited(EditorTerrain terrain, text message)
        if terrainFoliagePropertiesDialog:IsShowing()
            terrainFoliagePropertiesDialog:SetTerrain(terrain)
        end
        TerrainBrushChanged(terrain)
        if message not= ""
            NotifyAccessibility(terrain, message)
        end
    end

    /*
    This action returns true if a terrain's foliage can be changed.
    */
    private action CanChangeFoliage(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so its foliage can't be changed.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action makes a terrain's foliage list, with its file in the
    project's Scenes/Foliage folder, named after the terrain's folder, such
    as Scenes/Foliage/Terrain1.json. The folder is made if
    needed, and the empty list is written.
    */
    private action CreateFoliageList(EditorTerrain terrain) returns FoliageList
        SceneProperties sceneProperties
        text folderPath = sceneProperties:SCENES_FOLDER + "/Foliage"
        File folder = ConvertToProjectFile(folderPath)
        if not folder:Exists()
            boolean made = folder:CreateDirectories()
        end
        text baseName = "Terrain"
        text terrainPath = terrain:GetTerrainFile()
        Array<text> parts = terrainPath:Split("/")
        if parts:GetSize() >= 2
            baseName = parts:Get(parts:GetSize() - 2)
        end
        text candidate = baseName
        integer count = 2
        File file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        repeat while file:Exists()
            candidate = baseName + " " + count
            count = count + 1
            file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        end
        FoliageList list
        list:SetName(candidate)
        list:Save(file)
        return list
    end

    /*
    This action returns a file's path as a scene names it: relative to the
    project, with forward slashes.
    */
    private action GetProjectRelativePath(File file) returns text
        if projectLocation = undefined
            return file:GetPath()
        end
        Material paths
        text relative = paths:GetRelativePath(projectLocation:GetAbsolutePath(), file:GetAbsolutePath())
        return relative:Replace("\", "/")
    end

    /*
    This action finishes a stroke: it goes into the undo list, the terrain
    is marked changed for the next save, and what happened is announced.
    */
    action EndTerrainStroke
        if not stroking
            return now
        end
        stroking = false
        if foliageStroking
            EndFoliageStroke()
            return now
        end
        if waterStroking
            EndWaterStroke()
            return now
        end
        TerrainStrokeEdit strokeEdit = terrainStroke:End()
        if brushTerrain = undefined
            return now
        end
        if strokeEdit = undefined
            NotifyAccessibility(brushTerrain, "Nothing changed")
            return now
        end
        SceneEditorTerrainEdit edit
        edit:Create(me, brushTerrain, strokeEdit)
        editManager:Add(edit)
        brushTerrain:SetChanged(true)
        RedrawTerrain(brushTerrain)
        TerrainFactsChanged(brushTerrain)
        NotifyAccessibility(brushTerrain, DescribeStroke(brushTerrain, strokeEdit))
    end

    /*
    This action says what a finished stroke did: "Raised by up to
    2.4" for raise and lower, the layer for paint, and the size for the
    region tools, then the ground under the brush.
    */
    private action DescribeStroke(EditorTerrain terrain, TerrainStrokeEdit strokeEdit) returns text
        integer tool = terrain:GetToolNumber()
        if tool = 1 or tool = 2
            number change = strokeEdit:GetLargestHeightChange()
            text verb = "Raised"
            if change < 0
                verb = "Lowered"
                change = -change
            end
            return verb + " by up to " + RoundTenth(change) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 4 or tool = 5
            number shaped = strokeEdit:GetLargestHeightChange()
            if shaped < 0
                shaped = -shaped
            end
            text shapedVerb = "Flattened"
            if tool = 5
                shapedVerb = "Shaped the ramp"
            end
            return shapedVerb + ", changing heights by up to " + RoundTenth(shaped) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 3
            number smoothed = strokeEdit:GetLargestHeightChange()
            if smoothed < 0
                smoothed = -smoothed
            end
            return "Smoothed, changing heights by up to " + RoundTenth(smoothed) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 6
            return "Painted " + terrain:GetLayerLabel(terrain:GetBrush():GetLayer()) + ". " + terrain:DescribeBrushHeight()
        elseif tool = 7
            return "Blended the paint. " + terrain:DescribeBrush()
        elseif tool = terrain:ERODE_TOOL
            number worn = strokeEdit:GetLargestHeightChange()
            if worn < 0
                worn = -worn
            end
            return "Eroded, changing heights by up to " + RoundTenth(worn) + ". " + terrain:DescribeBrushHeight()
        elseif tool = terrain:AUTO_PAINT_TOOL
            return "Auto painted under the brush. " + terrain:DescribeBrush()
        elseif tool = 8 or tool = 9
            return terrain:GetToolName(tool) + " done. The terrain is now " + terrain:DescribeSize()
        end
        return terrain:GetToolName(tool) + " done. " + terrain:DescribeBrush()
    end

    /*
    This action stops a stroke and puts the ground back as it was before
    it. Escape calls it.

    Attribute: Returns True if a stroke was going and was canceled
    */
    action CancelTerrainStroke returns boolean
        if not stroking
            return false
        end
        if foliageStroking
            foliageStroking = false
            stroking = false
            boolean anything = foliageStroke:End()
            foliageStroke:Undo()
            if brushTerrain not= undefined
                RefreshFoliageStrokeArea(brushTerrain, foliageStroke)
                NotifyAccessibility(brushTerrain, "Stroke canceled")
            end
            return true
        end
        if waterStroking
            waterStroking = false
            stroking = false
            if brushTerrain not= undefined
                waterStrokeBefore:Apply(brushTerrain)
                RefreshWaterSection()
                NotifyAccessibility(brushTerrain, "Stroke canceled")
            end
            return true
        end
        terrainStroke:Cancel()
        stroking = false
        if brushTerrain not= undefined
            RedrawTerrain(brushTerrain)
            TerrainFactsChanged(brushTerrain)
            NotifyAccessibility(brushTerrain, "Stroke canceled")
        end
        return true
    end

    /*
    This action redraws a terrain after its ground changed, and places the
    brush's ring on the new ground.

    Attribute: Parameter terrain The terrain
    */
    private action RedrawTerrain(EditorTerrain terrain)
        if terrain:RegionsMatchModels()
            terrain:GetWorldTerrain():Rebuild()
            // The ground may now reach past the box the layer culls the
            // terrain by; rebuilding the models below refreshes it too.
            terrain:RefreshRenderBounds()
        else
            // Regions were added or removed, so the models are
            // made again.
            terrain:RebuildRegionModels()
        end
        // The selection's border follows the ground's heights at its edge
        // and the terrain's size, after Generate, Erode, an undo or anything
        // else that reshapes it. During a stroke it waits for the stroke's
        // end, which redraws again.
        if not stroking
            RefreshTerrainHighlight(terrain)
        end
        // The grid's lines over the ground follow it too.
        if terrainGridPatch not= undefined and terrainGridPatchShown
            terrainGridPatch:Refresh(terrain:GetWorldTerrain():GetData())
        end
        // The crosshair's lines follow the ground too.
        if cursorCrosshair not= undefined and cursorCrosshairShown
            cursorCrosshair:Refresh(terrain:GetWorldTerrain():GetData(), terrain:GetMinimumX(), terrain:GetMaximumX(), terrain:GetMinimumZ(), terrain:GetMaximumZ())
        end
        // The foliage follows the ground: under the brush
        // during a stroke, and everywhere after anything else, such as an
        // undo or a whole-terrain operation.
        if stroking and terrain = brushTerrain
            integer movedCells = terrain:FollowGround(terrain:GetBrushX(), terrain:GetBrushZ(), terrain:GetBrush():GetSize() + 1)
        else
            integer movedAll = terrain:FollowGround(0, 0, -1)
        end
        if terrain = brushTerrain
            // The ring follows the ground, so it is placed again.
            previewSize = -1
        end
    end

    /*
    This action is called after a terrain stroke is undone or redone: the
    terrain is redrawn, marked changed for the next save, and what happened
    is announced.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter message What happened, such as "Undid raise"
    */
    action TerrainEdited(EditorTerrain terrain, text message)
        if terrain = undefined
            return now
        end
        if stroking
            CancelTerrainStroke()
        end
        RedrawTerrain(terrain)
        terrain:SetChanged(true)
        TerrainFactsChanged(terrain)
        NotifyAccessibility(terrain, message)
    end

    /*
    This action shows a terrain's new ground heights in the Terrain section
    of the Properties panel, after a stroke or an undo.

    Attribute: Parameter terrain The terrain
    */
    private action TerrainFactsChanged(EditorTerrain terrain)
        if terrainPropertiesDialog:IsShowing()
            terrainPropertiesDialog:SetTerrain(terrain)
        end
    end

    /*
    This action fits the selection's border to a terrain again, after its
    size changed, if the terrain is selected.

    Attribute: Parameter terrain The terrain
    */
    action RefreshTerrainHighlight(EditorTerrain terrain)
        EditorItem selected = GetSelectedItem()
        if selected is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selected)
            if highlight:GetEditorTerrain() = terrain
                highlight:LoadTerrain(terrain, me)
            end
        end
    end

    /*
    This action returns the TerrainGenerator the scene editor uses for
    presets, stamps, erosion and auto paint.

    Attribute: Returns The generator
    */
    action GetTerrainGenerator returns TerrainGenerator
        return generator
    end

    /*
    This action remakes a terrain's whole ground with a preset:
    rolling hills, mountains, plateaus, canyons or flat. The same seed gives
    the same ground. With auto paint, the layers are painted by height and
    slope afterward, if the terrain has two or more materials. It can be
    undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter preset The preset, such as TerrainGenerator's PRESET_MOUNTAINS
    Attribute: Parameter seed The seed
    Attribute: Parameter height The tallest the ground can be, in world units
    Attribute: Parameter autoPaint True to auto paint afterward
    */
    action GenerateTerrain(EditorTerrain terrain, integer preset, number seed, number height, boolean autoPaint)
        if not CanOperateOn(terrain)
            return now
        end
        boolean painting = autoPaint and terrain:GetLayerCount() >= 2
        text presetName = generator:GetPresetName(preset)
        NotifyAccessibility(terrain, "Generating " + presetName + "...")
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation = BeginTerrainOperation(terrain, "generate " + presetName, true, painting, minimumX, minimumZ, maximumX, maximumZ)
        generator:SetSeed(seed)
        generator:GeneratePreset(data, preset, minimumX, minimumZ, maximumX - minimumX + 1, maximumZ - minimumZ + 1, height)
        if painting
            PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        end
        text message = "Generated " + presetName + ", seed " + cast(integer, seed) + ", heights " +
            RoundTenth(data:GetLowestHeight()) + " to " + RoundTenth(data:GetHighestHeight()) + "."
        if autoPaint and not painting
            message = message + " Auto paint needs two or more materials, so the ground wasn't painted."
        end
        FinishTerrainOperation(terrain, operation, message)
    end

    /*
    This action wears a terrain's whole ground as weather would, with one
    drop of rain for every eight samples. It can be undone.

    Attribute: Parameter terrain The terrain
    */
    action ErodeTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        NotifyAccessibility(terrain, "Eroding the whole terrain...")
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainStroke operation = BeginTerrainOperation(terrain, "erode", true, false, minimumX, minimumZ, maximumX, maximumZ)
        integer drops = (maximumX - minimumX + 1) * (maximumZ - minimumZ + 1) / 8
        generator:Erode(terrain:GetWorldTerrain():GetData(), minimumX, minimumZ, maximumX, maximumZ, drops)
        FinishTerrainOperation(terrain, operation, "Eroded the whole terrain, " + drops + " drops of rain.")
    end

    /*
    This action paints a terrain's whole ground by rules: layer 1
    on flat ground, layer 2 on slopes, layer 3 in hollows and layer 4 low
    down. Rules for layers the terrain doesn't have go to layer 1. It needs
    two or more materials, and can be undone.

    Attribute: Parameter terrain The terrain
    */
    action AutoPaintTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not CanAutoPaint(terrain)
            return now
        end
        integer minimumX = terrain:GetSampleEdge(true, true)
        integer minimumZ = terrain:GetSampleEdge(false, true)
        integer maximumX = terrain:GetSampleEdge(true, false)
        integer maximumZ = terrain:GetSampleEdge(false, false)
        TerrainStroke operation = BeginTerrainOperation(terrain, "auto paint", false, true, minimumX, minimumZ, maximumX, maximumZ)
        PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        FinishTerrainOperation(terrain, operation, "Auto painted the whole terrain.")
    end

    /*
    This action presses a stamp into the ground at a terrain's brush, as big
    as the brush. The Stamp tool calls it. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter stamp The shape, such as TerrainGenerator's STAMP_HILL
    Attribute: Parameter mode STAMP_ADD, STAMP_SUBTRACT or STAMP_RAISE
    Attribute: Parameter height The height of the shape's top, in world units
    Attribute: Parameter turn How far to turn the shape, in degrees
    */
    action StampTerrain(EditorTerrain terrain, integer stamp, integer mode, number height, number turn)
        if not CanOperateOn(terrain) or not BrushReady(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number size = terrain:GetBrush():GetSize()
        number reach = size * 1.4143
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        text name = "stamp a " + generator:GetStampName(stamp)
        TerrainStroke operation = BeginTerrainOperation(terrain, name, true, false, data:GetSampleX(x - reach) - 1, data:GetSampleZ(z - reach) - 1,
            data:GetSampleX(x + reach) + 2, data:GetSampleZ(z + reach) + 2)
        integer width = 129
        Number32BitArray shape = generator:MakeStampShape(stamp, width)
        generator:Stamp(data, shape, width, x, z, size, turn, height, mode)
        FinishTerrainOperation(terrain, operation, "Stamped a " + generator:GetStampName(stamp) + ". " + terrain:DescribeBrush())
    end

    /*
    This action erodes the ground under a terrain's brush. Drops
    of rain start under it and may run on one brush size past it. It can be
    undone.

    Attribute: Parameter terrain The terrain
    */
    action ErodeTerrainAtBrush(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not BrushReady(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number radius = terrain:GetBrush():GetSize()
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        integer minimumX = data:GetSampleX(x - radius)
        integer minimumZ = data:GetSampleZ(z - radius)
        integer maximumX = data:GetSampleX(x + radius) + 1
        integer maximumZ = data:GetSampleZ(z + radius) + 1
        integer runOn = cast(integer, math:Ceiling(radius / data:GetVertexSpacing()))
        TerrainStroke operation = BeginTerrainOperation(terrain, "erode", true, false, minimumX - runOn - 1, minimumZ - runOn - 1,
            maximumX + runOn + 1, maximumZ + runOn + 1)
        integer drops = (maximumX - minimumX + 1) * (maximumZ - minimumZ + 1)
        generator:Erode(data, minimumX, minimumZ, maximumX, maximumZ, minimumX - runOn, minimumZ - runOn, maximumX + runOn, maximumZ + runOn, drops)
        FinishTerrainOperation(terrain, operation, "Eroded under the brush, " + drops + " drops of rain. " + terrain:DescribeBrush())
    end

    /*
    This action auto paints the ground under a terrain's brush.
    It needs two or more materials, and can be undone.

    Attribute: Parameter terrain The terrain
    */
    action AutoPaintTerrainAtBrush(EditorTerrain terrain)
        if not CanOperateOn(terrain) or not BrushReady(terrain) or not CanAutoPaint(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number radius = terrain:GetBrush():GetSize()
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        integer minimumX = data:GetSampleX(x - radius)
        integer minimumZ = data:GetSampleZ(z - radius)
        integer maximumX = data:GetSampleX(x + radius) + 1
        integer maximumZ = data:GetSampleZ(z + radius) + 1
        TerrainStroke operation = BeginTerrainOperation(terrain, "auto paint", false, true, minimumX, minimumZ, maximumX, maximumZ)
        PaintArea(terrain, minimumX, minimumZ, maximumX, maximumZ)
        FinishTerrainOperation(terrain, operation, "Auto painted under the brush.")
    end

    /*
    This action makes a terrain one region bigger on every side, as far as
    the grid of regions allows. The new regions are shaped together from
    the terrain's edge (TerrainData's BlendRegions), so they join it
    without a step. It can be undone.

    Attribute: Parameter terrain The terrain
    */
    action GrowTerrain(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer size = data:GetRegionSize()
        integer firstX = data:GetRegionLocation(terrain:GetSampleEdge(true, true)) - 1
        integer firstZ = data:GetRegionLocation(terrain:GetSampleEdge(false, true)) - 1
        integer lastX = data:GetRegionLocation(terrain:GetSampleEdge(true, false)) + 1
        integer lastZ = data:GetRegionLocation(terrain:GetSampleEdge(false, false)) + 1
        TerrainStroke operation
        operation:BeginOperation(data, "grow", true, true)
        operation:CopyAreaIncludingEmpty(firstX * size, firstZ * size, lastX * size + size - 1, lastZ * size + size - 1)
        integer added = 0
        Array<TerrainRegion> grown
        integer locationZ = firstZ
        repeat while locationZ <= lastZ
            integer locationX = firstX
            repeat while locationX <= lastX
                if data:IsInRegionMap(locationX, locationZ) and not data:HasRegion(locationX, locationZ)
                    grown:Add(data:AddRegion(locationX, locationZ))
                    added = added + 1
                end
                locationX = locationX + 1
            end
            locationZ = locationZ + 1
        end
        if added = 0
            operation:Cancel()
            NotifyAccessibility(terrain, "The terrain can't grow: it reaches the edge of the grid of regions on every side.")
            return now
        end
        data:BlendRegions(grown)
        FinishTerrainOperation(terrain, operation, "Added " + added + " regions. The terrain is now " + terrain:DescribeSize())
    end

    /*
    This action returns true if a terrain's chosen tool is Add region or
    Remove region. Those tools work with whole regions, through a
    placeholder: a click puts down a rectangle of region slots, its edges
    can be dragged, and a click inside it adds or removes the regions.

    Attribute: Parameter terrain The terrain, which may be undefined
    Attribute: Returns True if the tool is a region tool
    */
    action IsRegionTool(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        integer tool = terrain:GetToolNumber()
        return tool = 8 or tool = 9
    end

    /*
    This action returns how wide one region is, in world units.
    */
    private action GetRegionWorldSize(TerrainData data) returns number
        return data:GetRegionSize() * data:GetVertexSpacing()
    end

    /*
    This action returns the region location a world position is in, along
    x or z. Both axes work the same way.
    */
    private action GetRegionLocationAt(TerrainData data, number world) returns integer
        return data:GetRegionLocation(data:GetSampleX(world))
    end

    /*
    This action returns where the pointer meets a flat level at a height,
    in the same screen coordinates as mouse events, or undefined if it
    points away from it.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    Attribute: Parameter height The level's height
    Attribute: Returns The point, or undefined
    */
    private action PickRegionPlane(number x, number y, number height) returns Vector3
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return undefined
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()
        // GetPickRay mirrors x across the view, as in PickPointerGround.
        number mirroredX = 2 * GetGlobalX() + camera:GetWidth() - x
        Ray ray = camera:GetPickRay(mirroredX, y, GetGlobalX(), GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        Vector3 direction = ray:GetDirection()
        Vector3 origin = ray:GetOrigin()
        if math:AbsoluteValue(direction:GetY()) < 0.0001
            return undefined
        end
        number distance = (height - origin:GetY()) / direction:GetY()
        if distance <= 0
            return undefined
        end
        Vector3 point
        point:Set(origin:GetX() + direction:GetX() * distance, height, origin:GetZ() + direction:GetZ() * distance)
        return point
    end

    /*
    This action returns where the pointer points for a region tool: the
    ground under it, or past the ground's edge, the level at height 0.
    */
    private action PickRegionPoint(EditorTerrain terrain, number x, number y) returns Vector3
        Vector3 hit = PickPointerGround(terrain, x, y)
        if hit = undefined
            hit = PickRegionPlane(x, y, 0)
        end
        return hit
    end

    /*
    This action returns the height to draw an outline around a rectangle of
    region slots at: the ground around it, or the highest ground in it, if
    that is higher, so the outline isn't hidden under the ground.
    */
    private action GetRegionRectangleHeight(TerrainData data, integer firstX, integer firstZ, integer lastX, integer lastZ) returns number
        number height = data:GetBlockEdgeHeight(firstX, firstZ, lastX, lastZ)
        integer locationZ = firstZ
        repeat while locationZ <= lastZ
            integer locationX = firstX
            repeat while locationX <= lastX
                TerrainRegion region = data:GetRegion(locationX, locationZ)
                if region not= undefined and region:GetHighestHeight() > height
                    height = region:GetHighestHeight()
                end
                locationX = locationX + 1
            end
            locationZ = locationZ + 1
        end
        return height
    end

    /*
    This action returns true if a terrain's region tool can act on a region
    slot: Add region where there is no region yet, Remove region where
    there is one, inside the grid of regions.
    */
    private action CanRegionToolActAt(EditorTerrain terrain, integer locationX, integer locationZ) returns boolean
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if not data:IsInRegionMap(locationX, locationZ)
            return false
        end
        if terrain:GetToolNumber() = 8
            return not data:HasRegion(locationX, locationZ)
        end
        return data:HasRegion(locationX, locationZ)
    end

    /*
    This action shows the slot outline around one region slot: green where
    the region tool can act, red where it can't.
    */
    private action ShowRegionSlot(EditorTerrain terrain, integer locationX, integer locationZ)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        boolean moved = not regionSlotShown or locationX not= regionSlotX or locationZ not= regionSlotZ
        if regionSlotOutline = undefined
            TerrainRegionOutline outline
            outline:SetName("Region Slot")
            outline:SetProperty(constants:EDITOR_TAG, undefined)
            // The outline lets clicks through to the scene editor.
            outline:SetAcceptsMouseInput(false)
            regionSlotOutline = outline
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(outline)
            moved = true
        end
        if moved
            number size = GetRegionWorldSize(data)
            regionSlotOutline:Place(locationX * size, locationZ * size, (locationX + 1) * size, (locationZ + 1) * size,
                GetRegionRectangleHeight(data, locationX, locationZ, locationX, locationZ))
        end
        if CanRegionToolActAt(terrain, locationX, locationZ)
            regionSlotOutline:SetLineColor(0.15, 0.85, 0.25)
        else
            regionSlotOutline:SetLineColor(0.95, 0.15, 0.1)
        end
        if not regionSlotShown
            regionSlotOutline:Show()
            regionSlotShown = true
        end
        regionSlotX = locationX
        regionSlotZ = locationZ
    end

    /*
    This action hides the slot outline. It is placed again when it next
    shows, so it takes any new ground height.
    */
    private action HideRegionSlot
        if regionSlotOutline not= undefined and regionSlotShown
            regionSlotOutline:Hide()
        end
        regionSlotShown = false
    end

    /*
    This action follows the pointer with a region tool: the slot under it is
    outlined, except over the placeholder, whose edges turn white where the
    pointer can grab them.
    */
    private action MoveRegionSlotToPointer(EditorTerrain terrain, number x, number y)
        HideTerrainGhost()
        slotFollowsPointer = true
        if placeholderDragging
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if placeholderTerrain = terrain and placeholderOutline not= undefined
            Vector3 point = PickRegionPlane(x, y, placeholderHeight)
            if point not= undefined
                if FindPlaceholderEdges(data, point)
                    placeholderOutline:SetLineColor(1, 1, 1)
                    HideRegionSlot()
                    return now
                end
                placeholderOutline:SetLineColor(1, 0.85, 0.1)
                if IsInsidePlaceholder(data, point)
                    HideRegionSlot()
                    return now
                end
            end
        end
        Vector3 hit = PickRegionPoint(terrain, x, y)
        if hit = undefined
            HideRegionSlot()
            return now
        end
        ShowRegionSlot(terrain, GetRegionLocationAt(data, hit:GetX()), GetRegionLocationAt(data, hit:GetZ()))
    end

    /*
    This action keeps the region tool's outlines up to date, once a frame:
    a placeholder on another terrain is dropped, and when the keys moved
    the terrain cursor last, the slot under the cursor is outlined.
    */
    private action UpdateRegionToolPreview
        EditorTerrain terrain = brushTerrain
        if placeholderTerrain not= undefined and placeholderTerrain not= terrain
            HidePlaceholder()
        end
        boolean cursorMoved = terrain:GetBrushX() not= slotCursorX or terrain:GetBrushZ() not= slotCursorZ
        slotCursorX = terrain:GetBrushX()
        slotCursorZ = terrain:GetBrushZ()
        if cursorMoved and not terrainCursorMovedByPointer
            slotFollowsPointer = false
        end
        if slotFollowsPointer or placeholderDragging
            return now
        end
        if not terrain:IsBrushPlaced()
            HideRegionSlot()
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer locationX = GetRegionLocationAt(data, terrain:GetBrushX())
        integer locationZ = GetRegionLocationAt(data, terrain:GetBrushZ())
        // Over the placeholder, the brush key commits it, so no slot shows.
        if placeholderTerrain = terrain and IsPlaceholderSlot(locationX, locationZ)
            HideRegionSlot()
            return now
        end
        ShowRegionSlot(terrain, locationX, locationZ)
    end

    /*
    This action returns true if a region slot is inside the placeholder.
    */
    private action IsPlaceholderSlot(integer locationX, integer locationZ) returns boolean
        return locationX >= placeholderFirstX and locationX <= placeholderLastX and
            locationZ >= placeholderFirstZ and locationZ <= placeholderLastZ
    end

    /*
    This action returns true if a point on the ground is inside the
    placeholder.
    */
    private action IsInsidePlaceholder(TerrainData data, Vector3 point) returns boolean
        number size = GetRegionWorldSize(data)
        return point:GetX() >= placeholderFirstX * size and point:GetX() <= (placeholderLastX + 1) * size and
            point:GetZ() >= placeholderFirstZ * size and point:GetZ() <= (placeholderLastZ + 1) * size
    end

    /*
    This action works out which of the placeholder's edges a point on the
    ground is close enough to grab, and notes them for a drag: one edge,
    or two at a corner. It returns true if it is near any.
    */
    private action FindPlaceholderEdges(TerrainData data, Vector3 point) returns boolean
        number size = GetRegionWorldSize(data)
        number grab = size * PLACEHOLDER_GRAB_SHARE
        number left = placeholderFirstX * size
        number right = (placeholderLastX + 1) * size
        number near = placeholderFirstZ * size
        number far = (placeholderLastZ + 1) * size
        number pointX = point:GetX()
        number pointZ = point:GetZ()
        dragLeft = false
        dragRight = false
        dragNear = false
        dragFar = false
        if pointX < left - grab or pointX > right + grab or pointZ < near - grab or pointZ > far + grab
            return false
        end
        if math:AbsoluteValue(pointX - left) <= grab
            dragLeft = true
        elseif math:AbsoluteValue(pointX - right) <= grab
            dragRight = true
        end
        if math:AbsoluteValue(pointZ - near) <= grab
            dragNear = true
        elseif math:AbsoluteValue(pointZ - far) <= grab
            dragFar = true
        end
        return dragLeft or dragRight or dragNear or dragFar
    end

    /*
    This action draws the placeholder's outline where its rectangle is now,
    at the height its regions would start at, and shows what it holds on
    the status line.
    */
    private action ShowPlaceholderOutline
        EditorTerrain terrain = placeholderTerrain
        EditorLayer layer = GetSelectedLayer()
        if terrain = undefined or not (layer is EditorLayer3D)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if placeholderOutline = undefined
            TerrainRegionOutline outline
            outline:SetName("Region Placeholder")
            outline:SetProperty(constants:EDITOR_TAG, undefined)
            // The outline lets clicks through to the scene editor.
            outline:SetAcceptsMouseInput(false)
            placeholderOutline = outline
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(outline)
        end
        number size = GetRegionWorldSize(data)
        placeholderHeight = GetRegionRectangleHeight(data, placeholderFirstX, placeholderFirstZ, placeholderLastX, placeholderLastZ)
        placeholderOutline:Place(placeholderFirstX * size, placeholderFirstZ * size, (placeholderLastX + 1) * size, (placeholderLastZ + 1) * size, placeholderHeight)
        placeholderOutline:SetLineColor(1, 0.85, 0.1)
        placeholderOutline:Show()
        text verb = "add"
        if terrain:GetToolNumber() = 9
            verb = "remove"
        end
        ShowPlacementStatus(DescribeRegionPlaceholder() + " Click inside to " + verb + ", drag an edge to resize, Esc to drop.")
        regionStatusShown = true
    end

    /*
    This action puts the placeholder away, with nothing added or removed.
    */
    private action HidePlaceholder
        placeholderTerrain = undefined
        placeholderDragging = false
        if placeholderOutline not= undefined
            placeholderOutline:Hide()
        end
        ShowPlacementStatus("")
        regionStatusShown = false
    end

    /*
    This action shows the placeholder on a terrain with a rectangle, or
    puts it away.
    */
    private action ApplyRegionPlaceholder(EditorTerrain terrain, boolean shown, integer firstX, integer firstZ, integer lastX, integer lastZ)
        if not shown
            HidePlaceholder()
            return now
        end
        placeholderTerrain = terrain
        placeholderFirstX = firstX
        placeholderFirstZ = firstZ
        placeholderLastX = lastX
        placeholderLastZ = lastZ
        ShowPlaceholderOutline()
    end

    /*
    This action sets the placeholder for undo and redo
    (SceneEditorRegionPlaceholderEdit). It does nothing unless the terrain
    has a region tool chosen.

    Attribute: Parameter terrain The terrain the placeholder is on
    Attribute: Parameter shown True for a placeholder, false for none
    Attribute: Parameter firstX Its first region location along x
    Attribute: Parameter firstZ Its first region location along z
    Attribute: Parameter lastX Its last region location along x
    Attribute: Parameter lastZ Its last region location along z
    Attribute: Parameter message What was done, such as "Undid resize region placeholder", or "" to say nothing
    */
    action SetRegionPlaceholderState(EditorTerrain terrain, boolean shown, integer firstX, integer firstZ, integer lastX, integer lastZ, text message)
        if terrain = undefined or terrain not= brushTerrain or not IsRegionTool(terrain)
            return now
        end
        ApplyRegionPlaceholder(terrain, shown, firstX, firstZ, lastX, lastZ)
        HideRegionSlot()
        if message not= ""
            if shown
                NotifyAccessibility(terrain, message + ". " + DescribeRegionPlaceholder())
            else
                NotifyAccessibility(terrain, message + ". No placeholder.")
            end
        end
    end

    /*
    This action describes the placeholder for screen readers and the status
    line, such as "Placeholder 3 by 2 regions, 5 new, 1 already there."

    Attribute: Returns The description
    */
    action DescribeRegionPlaceholder returns text
        if placeholderTerrain = undefined
            return "No placeholder."
        end
        TerrainData data = placeholderTerrain:GetWorldTerrain():GetData()
        boolean adding = placeholderTerrain:GetToolNumber() = 8
        integer width = placeholderLastX - placeholderFirstX + 1
        integer depth = placeholderLastZ - placeholderFirstZ + 1
        integer acting = CountPlaceholderSlots(data, adding)
        integer others = width * depth - acting
        text result = "Placeholder " + width + " by " + depth + " regions"
        if adding
            result = result + ", " + acting + " new"
            if others > 0
                result = result + ", " + others + " already there"
            end
        else
            result = result + ", " + acting + " to remove"
            if others > 0
                result = result + ", " + others + " empty"
            end
        end
        return result + "."
    end

    /*
    This action counts the slots in the placeholder the tool acts on: those
    with no region yet when adding, those with one when removing.
    */
    private action CountPlaceholderSlots(TerrainData data, boolean adding) returns integer
        integer count = 0
        integer locationZ = placeholderFirstZ
        repeat while locationZ <= placeholderLastZ
            integer locationX = placeholderFirstX
            repeat while locationX <= placeholderLastX
                if data:IsInRegionMap(locationX, locationZ)
                    boolean exists = data:HasRegion(locationX, locationZ)
                    if (adding and not exists) or (not adding and exists)
                        count = count + 1
                    end
                end
                locationX = locationX + 1
            end
            locationZ = locationZ + 1
        end
        return count
    end

    /*
    This action changes the placeholder as one undoable step: it is put
    down, moved, resized or dropped. Nothing is said; the caller says it.
    */
    private action ChangeRegionPlaceholder(EditorTerrain terrain, boolean shown, integer firstX, integer firstZ, integer lastX, integer lastZ, text name)
        SceneEditorRegionPlaceholderEdit edit
        edit:Create(me, terrain, name, undefined)
        edit:SetBefore(placeholderTerrain = terrain, placeholderFirstX, placeholderFirstZ, placeholderLastX, placeholderLastZ)
        edit:SetAfter(shown, firstX, firstZ, lastX, lastZ)
        editManager:Add(edit)
        ApplyRegionPlaceholder(terrain, shown, firstX, firstZ, lastX, lastZ)
        HideRegionSlot()
    end

    /*
    This action tells the user something about the region tool, both to a
    screen reader and on the status line.
    */
    private action TellRegionTool(EditorTerrain terrain, text message)
        NotifyAccessibility(terrain, message)
        ShowPlacementStatus(message)
        regionStatusShown = true
    end

    /*
    This action returns how to use the placeholder, said when one is put
    down.
    */
    private action DescribePlaceholderUse(EditorTerrain terrain) returns text
        text verb = "add"
        if terrain:GetToolNumber() = 9
            verb = "remove"
        end
        return "Click inside it, or use the brush there, to " + verb + " them. Drag an edge, or use the brush outside it, to stretch it. " +
            "The size keys grow and shrink it. Escape drops it."
    end

    /*
    This action handles a press of the left mouse button with a region
    tool. On the placeholder's edge or corner it starts a drag; inside the
    placeholder it adds or removes its regions; anywhere else it puts down
    a new placeholder of one region slot there.
    */
    private action PressRegionTool(EditorTerrain terrain, number x, number y)
        HideTerrainGhost()
        TerrainData data = terrain:GetWorldTerrain():GetData()
        if placeholderTerrain = terrain
            Vector3 point = PickRegionPlane(x, y, placeholderHeight)
            if point not= undefined
                if FindPlaceholderEdges(data, point)
                    placeholderDragging = true
                    dragHeight = placeholderHeight
                    dragStartFirstX = placeholderFirstX
                    dragStartFirstZ = placeholderFirstZ
                    dragStartLastX = placeholderLastX
                    dragStartLastZ = placeholderLastZ
                    HideRegionSlot()
                    return now
                end
                if IsInsidePlaceholder(data, point)
                    CommitRegionPlaceholder()
                    return now
                end
            end
        end
        Vector3 hit = PickRegionPoint(terrain, x, y)
        if hit = undefined
            return now
        end
        terrainCursorMovedByPointer = true
        terrain:SetBrushPosition(hit:GetX(), hit:GetZ())
        integer locationX = GetRegionLocationAt(data, hit:GetX())
        integer locationZ = GetRegionLocationAt(data, hit:GetZ())
        if not data:IsInRegionMap(locationX, locationZ)
            TellRegionTool(terrain, "A region can't go there: the grid of regions runs from -16 to 15 along each side.")
            return now
        end
        ChangeRegionPlaceholder(terrain, true, locationX, locationZ, locationX, locationZ, "place region placeholder")
        NotifyAccessibility(terrain, DescribeRegionPlaceholder() + " " + DescribePlaceholderUse(terrain))
    end

    /*
    This action returns true while an edge or corner of the region tool's
    placeholder is being dragged with the mouse.

    Attribute: Returns True during a drag
    */
    action IsDraggingRegionPlaceholder returns boolean
        return placeholderDragging
    end

    /*
    This action moves the dragged edges of the placeholder to the region
    slot under the pointer, given in the same screen coordinates as mouse
    events. It stays inside the grid of regions and at least one slot
    wide. The pointer listener calls it.

    Attribute: Parameter x The pointer's x on the screen
    Attribute: Parameter y The pointer's y on the screen
    */
    action DragRegionPlaceholder(number x, number y)
        if not placeholderDragging or placeholderTerrain = undefined
            return now
        end
        TerrainData data = placeholderTerrain:GetWorldTerrain():GetData()
        Vector3 point = PickRegionPlane(x, y, dragHeight)
        if point = undefined
            return now
        end
        integer locationX = GetRegionLocationAt(data, point:GetX())
        integer locationZ = GetRegionLocationAt(data, point:GetZ())
        integer firstX = placeholderFirstX
        integer firstZ = placeholderFirstZ
        integer lastX = placeholderLastX
        integer lastZ = placeholderLastZ
        // Each side only moves inside the grid, and not past the other side.
        if data:IsInRegionMap(locationX, firstZ)
            if dragLeft
                firstX = locationX
                if firstX > lastX
                    firstX = lastX
                end
            elseif dragRight
                lastX = locationX
                if lastX < firstX
                    lastX = firstX
                end
            end
        end
        if data:IsInRegionMap(firstX, locationZ)
            if dragNear
                firstZ = locationZ
                if firstZ > lastZ
                    firstZ = lastZ
                end
            elseif dragFar
                lastZ = locationZ
                if lastZ < firstZ
                    lastZ = firstZ
                end
            end
        end
        if firstX = placeholderFirstX and firstZ = placeholderFirstZ and lastX = placeholderLastX and lastZ = placeholderLastZ
            return now
        end
        placeholderFirstX = firstX
        placeholderFirstZ = firstZ
        placeholderLastX = lastX
        placeholderLastZ = lastZ
        ShowPlaceholderOutline()
        placeholderOutline:SetLineColor(1, 1, 1)
    end

    /*
    This action ends a drag of the placeholder once the button is let go,
    as one undoable step, and says the placeholder's new size.
    */
    private action UpdateRegionDrag
        if not placeholderDragging
            return now
        end
        if strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT)
            return now
        end
        placeholderDragging = false
        if placeholderTerrain = undefined
            return now
        end
        if placeholderFirstX = dragStartFirstX and placeholderFirstZ = dragStartFirstZ and
                placeholderLastX = dragStartLastX and placeholderLastZ = dragStartLastZ
            return now
        end
        SceneEditorRegionPlaceholderEdit edit
        edit:Create(me, placeholderTerrain, "resize region placeholder", undefined)
        edit:SetBefore(true, dragStartFirstX, dragStartFirstZ, dragStartLastX, dragStartLastZ)
        edit:SetAfter(true, placeholderFirstX, placeholderFirstZ, placeholderLastX, placeholderLastZ)
        editManager:Add(edit)
        NotifyAccessibility(placeholderTerrain, DescribeRegionPlaceholder())
    end

    /*
    This action uses a region tool at the terrain cursor, as the brush key
    does: with no placeholder, it puts one down at the cursor's slot;
    inside the placeholder, it adds or removes its regions; outside it, it
    stretches the placeholder to reach the cursor's slot.
    */
    private action UseRegionToolAtCursor(EditorTerrain terrain)
        if not terrain:IsBrushPlaced()
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer locationX = GetRegionLocationAt(data, terrain:GetBrushX())
        integer locationZ = GetRegionLocationAt(data, terrain:GetBrushZ())
        if not data:IsInRegionMap(locationX, locationZ)
            TellRegionTool(terrain, "A region can't go there: the grid of regions runs from -16 to 15 along each side.")
            return now
        end
        if placeholderTerrain not= terrain
            ChangeRegionPlaceholder(terrain, true, locationX, locationZ, locationX, locationZ, "place region placeholder")
            NotifyAccessibility(terrain, DescribeRegionPlaceholder() + " " + DescribePlaceholderUse(terrain))
            return now
        end
        if IsPlaceholderSlot(locationX, locationZ)
            CommitRegionPlaceholder()
            return now
        end
        integer firstX = placeholderFirstX
        integer firstZ = placeholderFirstZ
        integer lastX = placeholderLastX
        integer lastZ = placeholderLastZ
        if locationX < firstX
            firstX = locationX
        elseif locationX > lastX
            lastX = locationX
        end
        if locationZ < firstZ
            firstZ = locationZ
        elseif locationZ > lastZ
            lastZ = locationZ
        end
        ChangeRegionPlaceholder(terrain, true, firstX, firstZ, lastX, lastZ, "stretch region placeholder")
        NotifyAccessibility(terrain, DescribeRegionPlaceholder())
    end

    /*
    This action grows or shrinks the placeholder by one region slot on
    every side, as the size keys do. It stays inside the grid of regions,
    and a side that is one or two slots across doesn't shrink.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter amount 1 to grow, -1 to shrink
    */
    private action ResizeRegionPlaceholder(EditorTerrain terrain, integer amount)
        if placeholderTerrain not= terrain
            TellRegionTool(terrain, "Put down a placeholder first, with a click or the brush key. The size keys then grow and shrink it.")
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        integer firstX = placeholderFirstX
        integer firstZ = placeholderFirstZ
        integer lastX = placeholderLastX
        integer lastZ = placeholderLastZ
        if amount > 0
            if data:IsInRegionMap(firstX - 1, firstZ)
                firstX = firstX - 1
            end
            if data:IsInRegionMap(lastX + 1, firstZ)
                lastX = lastX + 1
            end
            if data:IsInRegionMap(firstX, firstZ - 1)
                firstZ = firstZ - 1
            end
            if data:IsInRegionMap(firstX, lastZ + 1)
                lastZ = lastZ + 1
            end
        else
            if lastX - firstX >= 2
                firstX = firstX + 1
                lastX = lastX - 1
            end
            if lastZ - firstZ >= 2
                firstZ = firstZ + 1
                lastZ = lastZ - 1
            end
        end
        if firstX = placeholderFirstX and firstZ = placeholderFirstZ and lastX = placeholderLastX and lastZ = placeholderLastZ
            if amount > 0
                TellRegionTool(terrain, "The placeholder can't grow: it reaches the edge of the grid of regions.")
            else
                TellRegionTool(terrain, "The placeholder can't shrink any more.")
            end
            return now
        end
        ChangeRegionPlaceholder(terrain, true, firstX, firstZ, lastX, lastZ, "resize region placeholder")
        NotifyAccessibility(terrain, DescribeRegionPlaceholder())
    end

    /*
    This action drops the placeholder, with nothing added or removed, as
    Escape does. It can be undone.

    Attribute: Returns True if there was a placeholder, so Escape did this
    */
    action DropRegionPlaceholder returns boolean
        if placeholderTerrain = undefined
            return false
        end
        EditorTerrain terrain = placeholderTerrain
        text verb = "added"
        if terrain:GetToolNumber() = 9
            verb = "removed"
        end
        ChangeRegionPlaceholder(terrain, false, 0, 0, 0, 0, "drop region placeholder")
        NotifyAccessibility(terrain, "Dropped the placeholder. Nothing was " + verb + ".")
        return true
    end

    /*
    This action adds the regions in the placeholder, or removes them for
    Remove region, as one undoable step, and puts the placeholder away.
    New regions are shaped together from the ground around them
    (TerrainData's BlendRegions). Undoing it brings the placeholder back.
    */
    private action CommitRegionPlaceholder
        EditorTerrain terrain = placeholderTerrain
        if terrain = undefined or not CanOperateOn(terrain)
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        boolean adding = terrain:GetToolNumber() = 8
        integer acting = CountPlaceholderSlots(data, adding)
        if acting = 0
            if adding
                TellRegionTool(terrain, "Every slot in the placeholder already has ground, so nothing was added.")
            else
                TellRegionTool(terrain, "The placeholder has no regions in it, so nothing was removed.")
            end
            return now
        end
        if not adding and acting >= data:GetRegionCount()
            TellRegionTool(terrain, "That would remove every region of the terrain. Leave at least one.")
            return now
        end
        text name = "add regions"
        if not adding
            name = "remove regions"
        end

        integer size = data:GetRegionSize()
        TerrainStroke operation
        operation:BeginOperation(data, name, true, true)
        operation:CopyAreaIncludingEmpty(placeholderFirstX * size, placeholderFirstZ * size, placeholderLastX * size + size - 1, placeholderLastZ * size + size - 1)
        Array<TerrainRegion> added
        integer locationZ = placeholderFirstZ
        repeat while locationZ <= placeholderLastZ
            integer locationX = placeholderFirstX
            repeat while locationX <= placeholderLastX
                if data:IsInRegionMap(locationX, locationZ)
                    if adding and not data:HasRegion(locationX, locationZ)
                        added:Add(data:AddRegion(locationX, locationZ))
                    elseif not adding and data:HasRegion(locationX, locationZ)
                        data:RemoveRegion(locationX, locationZ)
                    end
                end
                locationX = locationX + 1
            end
            locationZ = locationZ + 1
        end
        if adding
            data:BlendRegions(added)
        end
        data:AddToSplatEditedArea(placeholderFirstX * size, placeholderFirstZ * size, placeholderLastX * size + size - 1, placeholderLastZ * size + size - 1)
        TerrainStrokeEdit strokeEdit = operation:End()

        if strokeEdit not= undefined
            SceneEditorRegionPlaceholderEdit edit
            edit:Create(me, terrain, name, strokeEdit)
            edit:SetBefore(true, placeholderFirstX, placeholderFirstZ, placeholderLastX, placeholderLastZ)
            edit:SetAfter(false, 0, 0, 0, 0)
            editManager:Add(edit)
        end
        HidePlaceholder()
        HideRegionSlot()

        terrain:SetChanged(true)
        RedrawTerrain(terrain)
        TerrainFactsChanged(terrain)
        text regions = " regions."
        if acting = 1
            regions = " region."
        end
        text verb = "Added "
        if not adding
            verb = "Removed "
        end
        NotifyAccessibility(terrain, verb + acting + regions + " The terrain is now " + terrain:DescribeSize())
    end

    /*
    This action returns true if a terrain can be changed by an operation,
    and says why not otherwise. A stroke going on is finished first.
    */
    private action CanOperateOn(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so it can't be changed.")
            return false
        end
        if terrain:GetWorldTerrain():GetData():GetRegionCount() = 0
            NotifyAccessibility(terrain, "This terrain has no regions.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action returns true if a terrain's brush is chosen and on the
    ground, and says what to do otherwise.
    */
    private action BrushReady(EditorTerrain terrain) returns boolean
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool in the Brush section first, to place the brush.")
            return false
        end
        if not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "The brush is off the ground")
            return false
        end
        return true
    end

    /*
    This action returns true if a terrain has the two or more materials auto
    paint needs, and says so otherwise.
    */
    private action CanAutoPaint(EditorTerrain terrain) returns boolean
        if terrain:GetLayerCount() < 2
            NotifyAccessibility(terrain, "Auto paint needs two or more materials. Add them in the Materials section.")
            return false
        end
        return true
    end

    /*
    This action auto paints a rectangle of samples, then gives rules for
    layers the terrain doesn't have to its first layer.
    */
    private action PaintArea(EditorTerrain terrain, integer minimumX, integer minimumZ, integer maximumX, integer maximumZ)
        TerrainData data = terrain:GetWorldTerrain():GetData()
        generator:AutoPaint(data, minimumX, minimumZ, maximumX, maximumZ)
        data:FoldSplatLayers(terrain:GetLayerCount(), minimumX, minimumZ, maximumX, maximumZ)
    end

    /*
    This action starts an operation on a terrain, copying a rectangle of
    samples so it can be undone.
    */
    private action BeginTerrainOperation(EditorTerrain terrain, text name, boolean changesShape, boolean changesSplat,
            integer minimumX, integer minimumZ, integer maximumX, integer maximumZ) returns TerrainStroke
        TerrainStroke operation
        operation:BeginOperation(terrain:GetWorldTerrain():GetData(), name, changesShape, changesSplat)
        operation:CopyArea(minimumX, minimumZ, maximumX, maximumZ)
        return operation
    end

    /*
    This action finishes an operation: it goes into the undo list, the
    terrain is redrawn and marked changed, the Properties panel follows, and
    the message is announced.
    */
    private action FinishTerrainOperation(EditorTerrain terrain, TerrainStroke operation, text message)
        TerrainStrokeEdit strokeEdit = operation:End()
        if strokeEdit not= undefined
            SceneEditorTerrainEdit edit
            edit:Create(me, terrain, strokeEdit)
            editManager:Add(edit)
        end
        terrain:SetChanged(true)
        RedrawTerrain(terrain)
        TerrainFactsChanged(terrain)
        NotifyAccessibility(terrain, message)
    end

    /*
    This action rounds a number to one place after the point, for speaking.
    */
    private action RoundTenth(number value) returns number
        return math:Round(value, 1)
    end

    /*
    This action returns every terrain in the scene's 3D layers.

    Attribute: Returns The terrains
    */
    action GetEditorTerrains returns Array<EditorTerrain>
        Array<EditorTerrain> result
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        result:Add(cast(EditorTerrain, item))
                    end
                end
            end
            counter = counter + 1
        end
        return result
    end

    /*
    This action returns how many terrains in the scene use a terrain
    material.

    Attribute: Parameter material The terrain material
    Attribute: Returns How many terrains use it
    */
    action CountTerrainsUsing(TerrainMaterial material) returns integer
        if material = undefined
            return 0
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer count = 0
        integer i = 0
        repeat while i < terrains:GetSize()
            if terrains:Get(i):GetMaterial() = material
                count = count + 1
            end
            i = i + 1
        end
        return count
    end

    /*
    This action adds a material to a terrain as its next ground layer.
The file can be a material file, a texture set's color map,
    such as Ground037_1K-PNG_Color.png, or another image, used as a plain
    texture; for an image, a material file is written beside it. The first
    layer makes the terrain's terrain material file, in the project's
    Scenes/Materials folder, and covers the whole ground. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter chosen The file chosen
    */
    action AddTerrainLayer(EditorTerrain terrain, File chosen)
        if not CanChangeMaterials(terrain)
            return now
        end
        if terrain:GetLayerCount() >= 4
            NotifyAccessibility(terrain, "This terrain has four materials, which is the most it can have.")
            return now
        end
        Material material = MakeTerrainLayerMaterial(terrain, chosen)
        if material = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        text beforeFile = terrain:GetMaterialFile()
        text layerName = material:GetName()
        SceneEditorTerrainMaterialEdit edit
        if current = undefined
            TerrainMaterial created = CreateTerrainMaterial(terrain)
            created:AddLayer(layerName, material)
            created:Save(created:GetFile())
            terrain:SetMaterialFile(created:GetFile():GetPath())
            terrain:SetMaterial(created)
            edit:Create(me, terrain, "add " + layerName, undefined, beforeFile, created, terrain:GetMaterialFile())
        else
            TerrainMaterial before = current:Copy()
            current:AddLayer(layerName, material)
            edit:Create(me, terrain, "add " + layerName, current, beforeFile, current, beforeFile)
            edit:SetChangedLayers(current, before, current:Copy())
            terrain:RefreshMaterial()
        end
        editManager:Add(edit)
        integer count = terrain:GetLayerCount()
        // The new layer is the one painted next.
        terrain:GetBrush():SetLayer(count - 1)
        text message = "Added " + layerName + " as layer " + count + ", tiles " + RoundTenth(material:GetTextureScale()) + " units."
        if count = 1
            message = message + " It covers the whole ground. Add another material to paint with."
        else
            message = message + " Paint it with the Paint tool."
        end
        if layerMaterialNote not= ""
            message = message + " " + layerMaterialNote
        end
        TerrainMaterialEdited(terrain, current, message)
    end

    /*
    This action gives one of a terrain's ground layers a different
    material. Its painted places stay the same. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter chosen The file chosen, as for AddTerrainLayer
    */
    action ChooseTerrainLayer(EditorTerrain terrain, integer layer, File chosen)
        if not CanChangeMaterials(terrain) or layer < 0 or layer >= terrain:GetLayerCount()
            return now
        end
        Material material = MakeTerrainLayerMaterial(terrain, chosen)
        if material = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        TerrainMaterial before = current:Copy()
        current:SetLayer(layer, material:GetName(), material)
        SceneEditorTerrainMaterialEdit edit
        edit:Create(me, terrain, "choose " + material:GetName(), current, terrain:GetMaterialFile(), current, terrain:GetMaterialFile())
        edit:SetChangedLayers(current, before, current:Copy())
        editManager:Add(edit)
        terrain:RefreshMaterial()
        text chosenMessage = "Layer " + (layer + 1) + " is now " + material:GetName() + "."
        if layerMaterialNote not= ""
            chosenMessage = chosenMessage + " " + layerMaterialNote
        end
        TerrainMaterialEdited(terrain, current, chosenMessage)
    end

    /*
    This action moves one of a terrain's ground layers up or down one place,
    swapping it with its neighbor. The painting stays where it
    is, so where the layer was painted, its neighbor now shows, and the
    ground is drawn again. Every terrain sharing the terrain material
    changes. The brush's paint layer follows the material it named. It can
    be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer to move, from 0
    Attribute: Parameter up True to move it up (toward layer 1), false for down
    Attribute: Returns True if it moved
    */
    action MoveTerrainLayer(EditorTerrain terrain, integer layer, boolean up) returns boolean
        if not CanChangeMaterials(terrain)
            return false
        end
        integer count = terrain:GetLayerCount()
        integer target = layer + 1
        text direction = "down"
        if up
            target = layer - 1
            direction = "up"
        end
        if layer < 0 or layer >= count or target < 0 or target >= count
            return false
        end
        TerrainMaterial current = terrain:GetMaterial()
        TerrainMaterial before = current:Copy()
        text movedName = current:GetLayerName(layer)
        text otherName = current:GetLayerName(target)
        current:SwapLayers(layer, target)
        SceneEditorTerrainMaterialEdit edit
        edit:Create(me, terrain, "move " + movedName + " " + direction, current, terrain:GetMaterialFile(), current, terrain:GetMaterialFile())
        edit:SetChangedLayers(current, before, current:Copy())
        editManager:Add(edit)
        terrain:RefreshMaterial()
        TerrainBrush brush = terrain:GetBrush()
        if brush:GetLayer() = layer
            brush:SetLayer(target)
        elseif brush:GetLayer() = target
            brush:SetLayer(layer)
        end
        TerrainMaterialEdited(terrain, current, movedName + " moved " + direction + " to layer " + (target + 1) + ". "
            + otherName + " is now layer " + (layer + 1) + ".")
        return true
    end

    /*
    This action removes one of a terrain's ground layers. Its painted
    weight goes to the first layer, and the layers after it move down one,
    on every terrain sharing the terrain material. Removing the last layer
    makes the ground plain again: the painting is cleared, its files are
    deleted on the next save, and the scene stops naming a material. It can
    be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action RemoveTerrainLayer(EditorTerrain terrain, integer layer)
        if not CanChangeMaterials(terrain) or layer < 0 or layer >= terrain:GetLayerCount()
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        text layerName = current:GetLayerName(layer)
        text beforeFile = terrain:GetMaterialFile()
        SceneEditorTerrainMaterialEdit edit
        if current:GetLayerCount() = 1
            edit:Create(me, terrain, "remove " + layerName, current, beforeFile, undefined, "")
            edit:AddPaintingEdit(ClearTerrainPainting(terrain))
            terrain:SetMaterialFile("")
            terrain:SetMaterial(undefined)
            editManager:Add(edit)
            terrain:GetBrush():SetLayer(0)
            TerrainMaterialEdited(terrain, undefined, layerName + " removed. The ground is plain.")
            return now
        end

        TerrainMaterial before = current:Copy()
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain sharing = terrains:Get(i)
            if sharing:GetMaterial() = current
                edit:AddPaintingEdit(RemoveTerrainPaintingLayer(sharing, layer))
            end
            i = i + 1
        end
        current:RemoveLayer(layer)
        edit:Create(me, terrain, "remove " + layerName, current, beforeFile, current, beforeFile)
        edit:SetChangedLayers(current, before, current:Copy())
        editManager:Add(edit)
        terrain:RefreshMaterial()
        if terrain:GetBrush():GetLayer() >= current:GetLayerCount()
            terrain:GetBrush():SetLayer(current:GetLayerCount() - 1)
        end
        TerrainMaterialEdited(terrain, current, layerName + " removed. Where it was painted, " + current:GetLayerName(0) + " shows.")
    end

    /*
    This action sets how many world units one tile of a ground layer's
    material covers. It is saved into the material's file with the scene.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter size The tile size, more than 0
    */
    action SetTerrainLayerTileSize(EditorTerrain terrain, integer layer, number size)
        if terrain = undefined or layer < 0 or layer >= terrain:GetLayerCount() or size <= 0
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        current:GetLayerMaterial(layer):SetTextureScale(size)
        terrain:RefreshMaterial()
        TerrainMaterialEdited(terrain, current, "")
    end

    /*
    This action sets how softly a terrain's texture set layers blend where
    they meet, from 0.01 to 1. It is saved into the terrain material file
    with the scene.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter softness The softness
    */
    action SetTerrainBlendSoftness(EditorTerrain terrain, number softness)
        if terrain = undefined or terrain:GetMaterial() = undefined
            return now
        end
        TerrainMaterial current = terrain:GetMaterial()
        current:SetBlendSoftness(softness)
        terrain:RefreshMaterial()
        TerrainMaterialEdited(terrain, current, "")
    end

    /*
    This action returns a terrain layer's material, or undefined, for the
    Material details.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Returns The layer's Material
    */
    action GetTerrainLayerMaterial(EditorTerrain terrain, integer layer) returns Material
        if terrain = undefined or layer < 0 or layer >= terrain:GetLayerCount()
            return undefined
        end
        return terrain:GetMaterial():GetLayerMaterial(layer)
    end

    /*
    This action returns how many layers in the scene's terrains use a
    material, counting each layer once.

    Attribute: Parameter material The material
    Attribute: Returns How many layers use it
    */
    action CountLayersUsing(Material material) returns integer
        if material = undefined
            return 0
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        Array<TerrainMaterial> counted
        integer count = 0
        integer i = 0
        repeat while i < terrains:GetSize()
            TerrainMaterial terrainMaterial = terrains:Get(i):GetMaterial()
            if terrainMaterial not= undefined and not counted:Has(terrainMaterial)
                counted:Add(terrainMaterial)
                integer layer = 0
                repeat while layer < terrainMaterial:GetLayerCount()
                    if terrainMaterial:GetLayerMaterial(layer) = material
                        count = count + 1
                    end
                    layer = layer + 1
                end
            end
            i = i + 1
        end
        return count
    end

    /*
    This action gives a terrain layer's material a different image for one
    of its maps. The image must be the same size as the color map,
    or it is refused. Choosing a color map for a plain texture makes it a
    texture set. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter kind The map, such as Material's NORMAL_MAP
    Attribute: Parameter chosen The image
    */
    action SetTerrainLayerMap(EditorTerrain terrain, integer layer, integer kind, File chosen)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or chosen = undefined or not chosen:Exists()
            return now
        end
        text path = chosen:GetAbsolutePath()
        text lower = chosen:GetFileName():ToLowerCase()
        if not (lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg"))
            NotifyAccessibility(terrain, "A map is an image, a .png or .jpg file.")
            return now
        end
        // Every map in a set must be the size of its color map.
        text problem = ""
        if kind = material:COLOR_MAP
            Material trial = material:Copy()
            trial:SetMapPath(material:COLOR_MAP, path)
            integer other = material:NORMAL_MAP
            repeat while other <= material:HEIGHT_MAP and problem = ""
                if trial:GetMapPath(other) not= ""
                    problem = trial:GetMapSizeProblem(trial:GetMapPath(other))
                end
                other = other + 1
            end
        elseif kind not= material:TEXTURE
            problem = material:GetMapSizeProblem(path)
        end
        if problem not= ""
            NotifyAccessibility(terrain, problem)
            return now
        end

        Material before = material:Copy()
        if kind = material:COLOR_MAP and not material:UsesTextureSet()
            // A plain texture becomes a texture set with this color map.
            material:SetTexturePath("")
        end
        material:SetMapPath(kind, path)
        text message = material:GetMapName(kind) + " is now " + chosen:GetFileName() + "."
        message = message:GetSubtext(0, 1):ToUpperCase() + message:GetSubtext(1)
        if not IsInProject(chosen)
            message = message + " This map is outside the project, so it won't be copied with it."
        end
        RecordMaterialChange(material, before, material:GetMapName(kind), true, message)
    end

    /*
    This action clears one of a terrain layer's maps. A texture
    set's color map, and a plain texture's image, can't be cleared. It can
    be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter kind The map, such as Material's NORMAL_MAP
    */
    action ClearTerrainLayerMap(EditorTerrain terrain, integer layer, integer kind)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or material:GetMapPath(kind) = ""
            return now
        end
        if kind = material:COLOR_MAP
            NotifyAccessibility(terrain, "A texture set needs its color map. Choose another, or use Make plain.")
            return now
        end
        if kind = material:TEXTURE
            NotifyAccessibility(terrain, "A plain texture needs its image. Choose another, or remove the layer.")
            return now
        end
        Material before = material:Copy()
        material:SetMapPath(kind, "")
        text message = "Cleared the " + material:GetMapName(kind) + "."
        RecordMaterialChange(material, before, "clear " + material:GetMapName(kind), true, message)
    end

    /*
    This action sets whether a terrain layer's normal map uses the DirectX
    convention, rather than OpenGL's. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter directX True for DirectX
    */
    action SetTerrainLayerNormalConvention(EditorTerrain terrain, integer layer, boolean directX)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or material:IsNormalMapDirectX() = directX
            return now
        end
        Material before = material:Copy()
        material:SetNormalMapDirectX(directX)
        text convention = "OpenGL"
        if directX
            convention = "DirectX"
        end
        RecordMaterialChange(material, before, "normal map convention", true, "The normal map is now " + convention + ".")
    end

    /*
    This action sets a terrain layer's roughness (0) or metallic (1) value,
    from 0 to 1. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter valueKind 0 for roughness, 1 for metallic
    Attribute: Parameter value The value, from 0 to 1
    */
    action SetTerrainLayerValue(EditorTerrain terrain, integer layer, integer valueKind, number value)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or value < 0 or value > 1
            return now
        end
        Material before = material:Copy()
        text valueName = "roughness"
        if valueKind = 0
            if material:GetRoughness() = value
                return now
            end
            material:SetRoughness(value)
        else
            valueName = "metallic"
            if material:GetMetallic() = value
                return now
            end
            material:SetMetallic(value)
        end
        text message = valueName:GetSubtext(0, 1):ToUpperCase() + valueName:GetSubtext(1) + " " + RoundTenth(value) + "."
        if valueKind = 0 and material:GetRoughnessMapPath() not= ""
            message = message + " Not used: the roughness map sets it."
        end
        RecordMaterialChange(material, before, valueName, true, message)
    end

    /*
    This action renames a terrain layer's material. The layer's
    name in its terrain material follows. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    Attribute: Parameter newName The new name
    */
    action RenameTerrainLayerMaterial(EditorTerrain terrain, integer layer, text newName)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or newName = "" or newName = material:GetName()
            return now
        end
        Material before = material:Copy()
        material:SetName(newName)
        terrain:GetMaterial():SetLayer(layer, newName, material)
        RecordMaterialChange(material, before, "name", false, "")
    end

    /*
    This action fills in a terrain layer's empty maps from its color map's
    folder, by name, and says what it found. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action FindTerrainLayerMaps(EditorTerrain terrain, integer layer)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined
            return now
        end
        if not material:UsesTextureSet()
            NotifyAccessibility(terrain, "This is a plain texture. Choose a color map first to make it a texture set.")
            return now
        end
        Material before = material:Copy()
        // The color map's path is a full path, which File's SetPath
        // doesn't take.
        File colorMap = material:MakeFile(material:GetColorMapPath())
        text found = material:FindTextureSetMaps(colorMap, false)
        // A map found by name must still be the size of the color map.
        integer kind = material:NORMAL_MAP
        repeat while kind <= material:HEIGHT_MAP
            if material:GetMapPath(kind) not= "" and before:GetMapPath(kind) = ""
                text problem = material:GetMapSizeProblem(material:GetMapPath(kind))
                if problem not= ""
                    material:SetMapPath(kind, "")
                    found = found + " " + problem + " It was left out."
                end
            end
            kind = kind + 1
        end
        RecordMaterialChange(material, before, "find maps", true, found)
    end

    /*
    This action makes a terrain layer's texture set a plain texture, with
    its color map as its one image. It can be undone.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter layer The layer, from 0
    */
    action MakeTerrainLayerPlain(EditorTerrain terrain, integer layer)
        Material material = GetTerrainLayerMaterial(terrain, layer)
        if material = undefined or not material:UsesTextureSet()
            return now
        end
        Material before = material:Copy()
        material:MakePlain()
        RecordMaterialChange(material, before, "make plain", true, "Now a plain texture, with its color map.")
    end

    /*
    This action is called after a material changed, or the change was
    undone or redone: every terrain layer using it is given its
    new look, each terrain's materials are marked changed for the next
    save, the Properties panel follows, and the message is said.

    Attribute: Parameter material The material that changed
    Attribute: Parameter reload True if the layers must be given to the renderer again, false for a name
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action MaterialEdited(Material material, boolean reload, text message)
        if stroking
            EndTerrainStroke()
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        EditorTerrain shown = undefined
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain terrain = terrains:Get(i)
            TerrainMaterial terrainMaterial = terrain:GetMaterial()
            if terrainMaterial not= undefined
                boolean uses = false
                integer layer = 0
                repeat while layer < terrainMaterial:GetLayerCount()
                    if terrainMaterial:GetLayerMaterial(layer) = material
                        uses = true
                        // The layer's name follows the material's.
                        terrainMaterial:SetLayer(layer, material:GetName(), material)
                        if reload
                            terrain:RefreshMaterialLayer(layer)
                        end
                    end
                    layer = layer + 1
                end
                if uses
                    terrain:SetMaterialChanged(true)
                    shown = terrain
                end
            end
            i = i + 1
        end
        previewSize = -1
        if terrainMaterialsPropertiesDialog:IsShowing()
            terrainMaterialsPropertiesDialog:Refresh()
        end
        if shown not= undefined
            TerrainBrushChanged(shown)
            if message not= ""
                text said = message
                if reload
                    said = "Packing the texture set... " + message
                end
                NotifyAccessibility(shown, said)
            end
        end
    end

    /*
    This action adds a material change to the undo list and gives every
    layer using the material its new look.
    */
    private action RecordMaterialChange(Material material, Material before, text name, boolean reload, text message)
        SceneEditorMaterialEdit edit
        edit:Create(me, material, before, name, reload)
        editManager:Add(edit)
        MaterialEdited(material, reload, message)
    end

    /*
    This action returns true if a file is inside the scene's project.
    */
    private action IsInProject(File file) returns boolean
        if projectLocation = undefined
            return true
        end
        return file:GetAbsolutePath():StartsWith(projectLocation:GetAbsolutePath())
    end

    /*
    This action is called after a terrain's materials changed, or the
    change was undone or redone. The terrain was given its new
    look already; other terrains sharing the terrain material that changed
    are given theirs. Each is marked changed for the next save, the
    Properties panel follows, and the message is announced.

    Attribute: Parameter terrain The terrain whose materials changed
    Attribute: Parameter changed The terrain material whose layers changed, or undefined
    Attribute: Parameter message What happened, or an empty text to say nothing
    */
    action TerrainMaterialEdited(EditorTerrain terrain, TerrainMaterial changed, text message)
        if stroking
            CancelTerrainStroke()
        end
        Array<EditorTerrain> terrains = GetEditorTerrains()
        integer i = 0
        repeat while i < terrains:GetSize()
            EditorTerrain other = terrains:Get(i)
            if other not= terrain and changed not= undefined and other:GetMaterial() = changed
                other:RefreshMaterial()
                other:SetMaterialChanged(true)
                other:SetChanged(true)
            end
            i = i + 1
        end
        terrain:SetMaterialChanged(true)
        terrain:SetChanged(true)
        if terrain:GetBrush():GetLayer() >= terrain:GetLayerCount() and terrain:GetLayerCount() > 0
            terrain:GetBrush():SetLayer(terrain:GetLayerCount() - 1)
        end
        // The region models were made again, so the brush's ring is placed
        // again over them.
        previewSize = -1
        if terrainMaterialsPropertiesDialog:IsShowing()
            terrainMaterialsPropertiesDialog:SetTerrain(terrain)
        end
        TerrainBrushChanged(terrain)
        if message not= ""
            NotifyAccessibility(terrain, message)
        end
    end

    /*
    This action returns true if a terrain's materials can be changed, and
    says why not otherwise.
    */
    private action CanChangeMaterials(EditorTerrain terrain) returns boolean
        if terrain = undefined
            return false
        end
        if terrain:IsMissing()
            NotifyAccessibility(terrain, "This terrain's files weren't found, so its materials can't be changed.")
            return false
        end
        if stroking
            EndTerrainStroke()
        end
        return true
    end

    /*
    This action makes a ground layer's material from a chosen file: a
    material file is loaded; a texture set's color map, such as
    Ground037_1K-PNG_Color.png, or another image makes a new material,
    written beside it as a .json file named after it, unless that file is
    there already. It returns undefined, and says why, for other files.
    */
    private action MakeTerrainLayerMaterial(EditorTerrain terrain, File chosen) returns Material
        layerMaterialNote = ""
        if chosen = undefined or not chosen:Exists()
            return undefined
        end
        HashTable<text, Material> materials = GetLoadedMaterials()
        text fileName = chosen:GetFileName()
        text lower = fileName:ToLowerCase()
        if lower:EndsWith(".json")
            text jsonKey = chosen:GetAbsolutePath()
            if materials:HasKey(jsonKey)
                return materials:GetValue(jsonKey)
            end
            Material material
            boolean loaded = true
            check
                material:Load(chosen)
            detect e is Error
                loaded = false
            end
            if not loaded
                NotifyAccessibility(terrain, fileName + " isn't a material file.")
                return undefined
            end
            if material:GetName() = ""
                material:SetName(fileName:GetSubtext(0, fileName:GetSize() - 5))
            end
            materials:Add(jsonKey, material)
            return material
        end
        if not (lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg"))
            NotifyAccessibility(terrain, "Choose a material file, or an image: a texture set's color map, such as Ground037_1K-PNG_Color.png or rock_wall_diff_1k.png, or a plain texture.")
            return undefined
        end

        // An image with a color ending, such as _Color or _diff, is a texture
        // set, and its other maps are found by name. Others are
        // plain textures.
        Material made
        text folder = chosen:GetParentDirectory():GetAbsolutePath()
        text materialName = made:GetSetName(fileName)
        if made:IsColorMapName(fileName)
            layerMaterialNote = made:FindTextureSetMaps(chosen, true)
            made:SetTextureScale(3)
            // AmbientCG's sets end in a size and format, such as _1K-PNG,
            // which the material's name leaves out.
            text lowerName = materialName:ToLowerCase()
            if lowerName:EndsWith("-png") or lowerName:EndsWith("-jpg")
                integer last = -1
                integer i = 0
                repeat while i < materialName:GetSize()
                    if materialName:GetSubtext(i, i + 1) = "_"
                        last = i
                    end
                    i = i + 1
                end
                if last > 0
                    materialName = materialName:GetSubtext(0, last)
                end
            end
        else
            made:SetTexturePath(chosen:GetAbsolutePath())
            made:SetTextureScale(4)
        end
        made:SetName(materialName)

        // The folder is a full path, which File's SetPath doesn't take.
        File materialFile
        materialFile:SetAbsolutePath(folder + "/" + materialName + ".json")
        text key = materialFile:GetAbsolutePath()
        if materials:HasKey(key)
            layerMaterialNote = ""
            return materials:GetValue(key)
        end
        if materialFile:Exists()
            Material existing
            existing:Load(materialFile)
            materials:Add(key, existing)
            layerMaterialNote = ""
            return existing
        end
        made:Save(materialFile)
        materials:Add(key, made)
        return made
    end

    /*
    This action makes a terrain's terrain material, with its file in the
    project's Scenes/Materials folder, named after the terrain's folder,
    such as Scenes/Materials/Terrain1.json. The folder is made if needed.
    The file isn't written yet.
    */
    private action CreateTerrainMaterial(EditorTerrain terrain) returns TerrainMaterial
        SceneProperties sceneProperties
        text folderPath = sceneProperties:SCENES_FOLDER + "/" + sceneProperties:MATERIALS_FOLDER
        File folder = ConvertToProjectFile(folderPath)
        if not folder:Exists()
            boolean made = folder:CreateDirectories()
        end

        // The terrain's folder name, from "Scenes/Terrains/Terrain1/terrain.json".
        text baseName = "Terrain"
        text terrainPath = terrain:GetTerrainFile()
        Array<text> parts = terrainPath:Split("/")
        if parts:GetSize() >= 2
            baseName = parts:Get(parts:GetSize() - 2)
        end

        text candidate = baseName
        integer count = 2
        File file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        repeat while file:Exists()
            candidate = baseName + " " + count
            count = count + 1
            file = ConvertToProjectFile(folderPath + "/" + candidate + ".json")
        end

        TerrainMaterial material
        material:SetName(candidate)
        material:Save(file)
        return material
    end

    /*
    This action takes one ground layer out of a terrain's painting, keeping
    a copy for undo, and returns the edit that puts it back.
    */
    private action RemoveTerrainPaintingLayer(EditorTerrain terrain, integer layer) returns TerrainStrokeEdit
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation
        operation:BeginOperation(data, "remove layer", false, true)
        terrain:CopyAllRegions(operation)
        data:RemoveSplatLayer(layer)
        terrain:SetChanged(true)
        return operation:End()
    end

    /*
    This action clears a terrain's painting, keeping a copy for undo, and
    returns the edit that puts it back.
    */
    private action ClearTerrainPainting(EditorTerrain terrain) returns TerrainStrokeEdit
        TerrainData data = terrain:GetWorldTerrain():GetData()
        TerrainStroke operation
        operation:BeginOperation(data, "clear painting", false, true)
        terrain:CopyAllRegions(operation)
        data:ClearSplat()
        terrain:SetChanged(true)
        return operation:End()
    end

    /*
    This action moves a terrain's paint layer to the next layer that has a
    material, going back to the first after the last, and says which it is.

    Attribute: Parameter terrain The terrain
    */
    action NextTerrainPaintLayer(EditorTerrain terrain)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        // With the Foliage tool, the key cycles the brush between painting,
        // removing the chosen asset, and removing every asset.
        if terrain:GetToolNumber() = terrain:FOLIAGE_TOOL
            SetFoliageBrushMode(terrain, (terrain:GetFoliageBrushMode() + 1) mod 3)
            return now
        end
        integer count = terrain:GetLayerCount()
        if count = 0
            NotifyAccessibility(terrain, "No materials to paint. Add them in the Materials section.")
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        integer layer = brush:GetLayer() + 1
        if layer >= count
            layer = 0
        end
        brush:SetLayer(layer)
        NotifyAccessibility(terrain, "Paint layer " + (layer + 1) + ", " + terrain:GetMaterial():GetLayerName(layer))
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets one end of a terrain's ramp at its brush, and says it.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter isEnd True for the ramp's end, false for its start
    */
    action SetTerrainRampPoint(EditorTerrain terrain, boolean isEnd)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool first, with Alt and a number, to place the brush.")
            return now
        end
        if isEnd
            // The end makes the ramp, if its start is set.
            if terrain:HasRampStart()
                ApplyTerrainRamp(terrain)
            else
                NotifyAccessibility(terrain, "Set the ramp's start first.")
            end
            return now
        end
        NotifyAccessibility(terrain, terrain:SetRampPoint(false))
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets the next end of a terrain's ramp at its brush, for its
    key: the start, then the end; after both, a new start.

    Attribute: Parameter terrain The terrain
    */
    action SetNextTerrainRampPoint(EditorTerrain terrain)
        if terrain = undefined or not terrain:HasTool()
            return now
        end
        if not terrain:HasRampStart()
            text started = terrain:SetRampPoint(false)
            if terrain:HasRampStart()
                started = "Ramp start at " + RoundTenth(terrain:GetRampStartX()) + ", " + RoundTenth(terrain:GetRampStartZ()) +
                    ", height " + RoundTenth(terrain:GetRampStartHeight()) + ". Move to where it ends, and click or press Alt+G again."
            end
            NotifyAccessibility(terrain, started)
            TerrainBrushChanged(terrain)
            return now
        end
        ApplyTerrainRamp(terrain)
    end

    /*
    This action makes a whole ramp at once: a straight slope from
    the ramp's start, at its height, to the brush, at the ground's height
    there, as wide as the brush. The ground across the ramp is set to the
    slope, fading back to the ground over the brush's outer edge. It can be
    undone, and the ramp is cleared for the next one.

    Attribute: Parameter terrain The terrain
    */
    action ApplyTerrainRamp(EditorTerrain terrain)
        if not CanOperateOn(terrain)
            return now
        end
        if not terrain:HasRampStart()
            return now
        end
        if not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "The brush is off the ground, so the ramp can't end there.")
            return now
        end
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number startX = terrain:GetRampStartX()
        number startZ = terrain:GetRampStartZ()
        number startHeight = terrain:GetRampStartHeight()
        number endX = terrain:GetBrushX()
        number endZ = terrain:GetBrushZ()
        number endHeight = data:GetSurfaceHeight(endX, endZ)
        number halfWidth = terrain:GetBrush():GetSize()

        number lineX = endX - startX
        number lineZ = endZ - startZ
        number length = math:SquareRoot(lineX * lineX + lineZ * lineZ)
        if length < data:GetVertexSpacing()
            NotifyAccessibility(terrain, "The ramp's end is too close to its start. Move further away.")
            return now
        end
        number alongX = lineX / length
        number alongZ = lineZ / length

        number reach = halfWidth + 1
        integer minimumX = data:GetSampleX(math:MinimumOf(startX, endX) - reach)
        integer minimumZ = data:GetSampleZ(math:MinimumOf(startZ, endZ) - reach)
        integer maximumX = data:GetSampleX(math:MaximumOf(startX, endX) + reach) + 1
        integer maximumZ = data:GetSampleZ(math:MaximumOf(startZ, endZ) + reach) + 1
        TerrainStroke operation = BeginTerrainOperation(terrain, "ramp", true, false, minimumX, minimumZ, maximumX, maximumZ)

        number spacing = data:GetVertexSpacing()
        // Full strength across the middle of the ramp, fading to nothing at
        // its sides.
        number solid = halfWidth * 0.7
        integer z = minimumZ
        repeat while z <= maximumZ
            integer x = minimumX
            repeat while x <= maximumX
                if data:HasSample(x, z)
                    number offsetX = x * spacing - startX
                    number offsetZ = z * spacing - startZ
                    number along = offsetX * alongX + offsetZ * alongZ
                    number across = math:AbsoluteValue(offsetZ * alongX - offsetX * alongZ)
                    if along >= 0 and along <= length and across <= halfWidth
                        number weight = 1
                        if across > solid
                            number fade = (halfWidth - across) / (halfWidth - solid)
                            weight = fade * fade * (3 - 2 * fade)
                        end
                        number goal = startHeight + (endHeight - startHeight) * along / length
                        number height = data:GetSampleHeight(x, z)
                        data:SetSampleHeight(x, z, height + (goal - height) * weight)
                    end
                end
                x = x + 1
            end
            z = z + 1
        end

        terrain:ClearRamp()
        FinishTerrainOperation(terrain, operation, "Made a ramp from height " + RoundTenth(startHeight) + " to " + RoundTenth(endHeight) +
            ", " + RoundTenth(length) + " units long. Click again to start another.")
        TerrainBrushChanged(terrain)
    end

    /*
    This action clears a terrain's ramp, so the next two clicks (or Alt+G
    presses) set a new start and end.

    Attribute: Parameter terrain The terrain
    */
    action ClearTerrainRamp(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        terrain:ClearRamp()
        NotifyAccessibility(terrain, "Ramp cleared. With the Ramp tool, click where the next one starts.")
        TerrainBrushChanged(terrain)
    end

    /*
    This action sets what flatten evens the ground to: the height where each
    stroke starts, or a set height.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter toStart True for the height where each stroke starts
    */
    action SetTerrainFlattenToStart(EditorTerrain terrain, boolean toStart)
        if terrain = undefined
            return now
        end
        terrain:GetBrush():SetFlattenToStart(toStart)
        if toStart
            NotifyAccessibility(terrain, "Flatten to the height where each stroke starts")
        else
            NotifyAccessibility(terrain, "Flatten to height " + RoundTenth(terrain:GetBrush():GetTargetHeight()))
        end
    end

    /*
    This action sets the height flatten evens the ground to, and makes it
    flatten to that height rather than where each stroke starts.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter height The height
    */
    action SetTerrainFlattenHeight(EditorTerrain terrain, number height)
        if terrain = undefined
            return now
        end
        terrain:GetBrush():SetTargetHeight(height)
        terrain:GetBrush():SetFlattenToStart(false)
        TerrainBrushChanged(terrain)
    end

    /*
    This action takes the ground's height under a terrain's brush as the
    height flatten evens to.

    Attribute: Parameter terrain The terrain
    */
    action TakeTerrainFlattenHeight(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool() or not terrain:IsBrushOnGround()
            NotifyAccessibility(terrain, "Place the brush on the ground first, with a tool chosen.")
            return now
        end
        number height = terrain:GetWorldTerrain():GetData():GetSurfaceHeight(terrain:GetBrushX(), terrain:GetBrushZ())
        terrain:GetBrush():SetTargetHeight(height)
        terrain:GetBrush():SetFlattenToStart(false)
        NotifyAccessibility(terrain, "Flatten to height " + RoundTenth(height))
        TerrainBrushChanged(terrain)
    end

    /*
    This action says what the ground under a terrain's whole brush is like:
    its heights and how much of it each layer covers.
The Brush section's "Describe the area" button calls it.

    Attribute: Parameter terrain The terrain
    */
    action DescribeTerrainArea(EditorTerrain terrain)
        if terrain = undefined
            return now
        end
        if not terrain:HasTool()
            NotifyAccessibility(terrain, "Choose a tool first, with Alt and a number, to place the brush.")
            return now
        end
        NotifyAccessibility(terrain, terrain:DescribeArea())
    end

    /*
    This action makes a terrain's brush stronger or weaker, by one step, and
    says its new strength.

    Attribute: Parameter terrain The terrain
    Attribute: Parameter stronger True to strengthen the brush, false to weaken it
    */
    action ChangeTerrainStrength(EditorTerrain terrain, boolean stronger)
        // The strength is the brush's, as its size is, so it changes with or
        // without a tool chosen; the Brush section shows it either way.
        if terrain = undefined
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        number strength = brush:GetStrength()
        if stronger
            strength = strength * BRUSH_STRENGTH_STEP
        else
            strength = strength / BRUSH_STRENGTH_STEP
        end
        if strength < BRUSH_WEAKEST
            strength = BRUSH_WEAKEST
        elseif strength > BRUSH_STRONGEST
            strength = BRUSH_STRONGEST
        end
        brush:SetStrength(strength)
        NotifyAccessibility(terrain, "Brush strength " + (cast(integer, strength * 100 + 0.5) / 100.0))
        TerrainBrushChanged(terrain)
    end

    /*
    This action keeps the Brush section of the Properties panel in step with
    a terrain's brush, after a key or the pointer changed it.

    Attribute: Parameter terrain The terrain whose brush changed
    */
    action TerrainBrushChanged(EditorTerrain terrain)
        if terrainBrushPropertiesDialog:IsShowing()
            terrainBrushPropertiesDialog:SetTerrain(terrain)
            // The Stamp section shows only with the Stamp tool.
            terrainStampPropertiesDialog:ToolChanged(terrain)
        end
    end

    /*
    This action shows the ring for the terrain whose tool is chosen, placed
    again only when the brush moved or changed size, and hides it otherwise.
The ring is one of the editor's own items: it isn't saved,
    listed or picked.
    */
    private action UpdateBrushPreview
        // The region tools show region slots and their placeholder, not the
        // ring, since they act on whole regions, whatever the brush's size.
        if IsTerrainBrushActive() and IsRegionTool(brushTerrain)
            if brushPreviewShown
                brushPreview:Hide()
                brushPreviewShown = false
            end
            HideRampPreview()
            UpdateRegionToolPreview()
            return now
        end
        // Leaving a region tool drops its placeholder, with nothing added.
        if regionSlotShown
            HideRegionSlot()
        end
        if placeholderTerrain not= undefined
            HidePlaceholder()
        end
        if regionStatusShown
            ShowPlacementStatus("")
            regionStatusShown = false
        end

        // The ring shows the brush of the terrain whose tool is chosen, or,
        // with no tool, the terrain cursor, in the color of its beam and
        // crosshair (TerrainCursorSettings). Either way it is the brush's
        // size, so the size keys show.
        EditorTerrain shown = undefined
        boolean cursorOnly = false
        number size = 0
        if IsTerrainBrushActive()
            shown = brushTerrain
        elseif cursorTerrain not= undefined and not HasActivePreview()
            // While an item from the palette is being placed, its
            // placeholder shows where it goes, so the cursor hides.
            shown = cursorTerrain
            cursorOnly = true
        end
        if shown not= undefined
            size = shown:GetBrush():GetSize()
        end
        if shown = undefined or not shown:IsBrushOnGround()
            if brushPreviewShown
                brushPreview:Hide()
                brushPreviewShown = false
            end
            HideRampPreview()
            return now
        end
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        boolean moved = shown:GetBrushX() not= previewX or shown:GetBrushZ() not= previewZ or size not= previewSize
        if cursorOnly
            HideRampPreview()
        else
            UpdateRampPreview(cast(EditorLayer3D, layer))
        end
        if brushPreview = undefined
            TerrainBrushPreview preview
            preview:SetName("Terrain Brush")
            preview:SetProperty(constants:EDITOR_TAG, undefined)
            // The ring lets clicks through to the scene editor.
            preview:SetAcceptsMouseInput(false)
            preview:Place(shown:GetWorldTerrain():GetData(), shown:GetBrushX(), shown:GetBrushZ(), size)
            brushPreview = preview
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            layer3D:Add(preview)
            moved = false
        end
        if moved
            brushPreview:Place(shown:GetWorldTerrain():GetData(), shown:GetBrushX(), shown:GetBrushZ(), size)
            ResetRingBlink()
        end
        if cursorOnly
            brushPreview:SetRingColor(cursorSettings:GetRed(), cursorSettings:GetGreen(), cursorSettings:GetBlue())
        elseif brushTerrain:GetToolNumber() = 5 and brushTerrain:HasRampStart()
            // The brush turns red while it marks a ramp's end.
            brushPreview:SetRingColor(0.95, 0.15, 0.1)
        else
            brushPreview:SetRingColor(1, 0.85, 0.1)
        end
        if not brushPreviewShown
            brushPreview:Show()
            brushPreviewShown = true
            ResetRingBlink()
        end
        previewX = shown:GetBrushX()
        previewZ = shown:GetBrushZ()
        previewSize = size
    end

    // Shows the ring solid and starts its idle second again.
    private action ResetRingBlink
        ringBlinkTimer = RING_IDLE_TIME
        if ringBlinkHidden and brushPreview not= undefined
            brushPreview:Show()
        end
        ringBlinkHidden = false
    end

    /*
    This action blinks the ring like a text cursor. It doesn't change
    brushPreviewShown, which says whether the ring is in use at all; a
    blink only hides it for a moment. While a stroke is being made the
    ring stays solid.
    */
    private action BlinkBrushPreview(number seconds)
        if brushPreview = undefined or not brushPreviewShown
            ringBlinkHidden = false
            return now
        end
        // The ring stays solid unless blinking is turned on in the options
        // (TerrainCursorSettings, off by default), and while a stroke is made.
        if stroking or not cursorSettings:IsBlinking()
            ResetRingBlink()
            return now
        end
        ringBlinkTimer = ringBlinkTimer - seconds
        if ringBlinkTimer < 0
            ringBlinkTimer = RING_BLINK_TIME
            if ringBlinkHidden
                brushPreview:Show()
                ringBlinkHidden = false
            else
                brushPreview:Hide()
                ringBlinkHidden = true
            end
        end
    end

    /*
    This action sets how the terrain cursor is marked: its beam, crosshair,
    color and pulse. Quorum Studio gives every scene editor the same
    settings, so a change shows in every scene.

    Attribute: Parameter settings The terrain cursor's settings
    */
    action SetTerrainCursorSettings(TerrainCursorSettings settings)
        if settings not= undefined
            cursorSettings = settings
        end
    end

    /*
    This action returns how the terrain cursor is marked.

    Attribute: Returns The terrain cursor's settings
    */
    action GetTerrainCursorSettings returns TerrainCursorSettings
        return cursorSettings
    end

    /*
    This action shows the beam and crosshair wherever the ring shows: at
    the brush of the terrain whose tool is chosen, or at the terrain cursor.
    They are sized for the camera's distance each frame, so they stay about
    the same size on screen, and pulse as the settings say.
    */
    private action UpdateCursorMarks(number seconds)
        EditorTerrain shown = undefined
        if IsTerrainBrushActive()
            shown = brushTerrain
        elseif cursorTerrain not= undefined and not HasActivePreview()
            // Hidden while an item from the palette is being placed, as the
            // ring is (UpdateBrushPreview).
            shown = cursorTerrain
        end
        EditorLayer layer = GetSelectedLayer()
        if shown = undefined or not shown:IsBrushOnGround() or not (layer is EditorLayer3D)
            HideCursorMarks()
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        TerrainData data = shown:GetWorldTerrain():GetData()
        number x = shown:GetBrushX()
        number z = shown:GetBrushZ()
        number ground = 0
        if data:HasHeight(x, z)
            ground = data:GetSurfaceHeight(x, z)
        end
        Camera camera = layer3D:GetCamera()
        Vector3 eye = camera:GetPosition()
        number distance = eye:Distance(x, ground, z)

        if x not= markX or z not= markZ
            markSecondsSinceMove = 0
            markX = x
            markZ = z
        else
            markSecondsSinceMove = markSecondsSinceMove + seconds
        end
        markClock = markClock + seconds
        if markClock > 1000
            markClock = 0
        end

        // How strong the marks are now: steady; a flash twice a second for
        // two seconds after a move (under WCAG's three a second); or the
        // beam's slow breath.
        number linePulse = 1
        number beamPulse = 1
        number beamSpread = 1
        integer pulse = cursorSettings:GetPulse()
        if pulse = cursorSettings:PULSE_AFTER_MOVING and markSecondsSinceMove < MARK_FLASH_TIME
            number wave = math:Cosine(markSecondsSinceMove / MARK_FLASH_PERIOD * 2 * math:pi) * 0.5 + 0.5
            linePulse = 0.4 + 0.6 * wave
            beamPulse = linePulse
        elseif pulse = cursorSettings:PULSE_BREATHING
            // The glow swells around the beam and settles back. It changes
            // mostly in width: a larger change in brightness would move the
            // faded top of the glow up and down, which looks like sliding.
            number breath = math:Cosine(markClock / MARK_BREATH_PERIOD * 2 * math:pi) * 0.5 + 0.5
            beamPulse = 0.9 + 0.1 * breath
            beamSpread = 0.82 + 0.33 * breath
        end

        if cursorSettings:IsShowingBeam()
            if cursorBeam = undefined
                TerrainCursorBeam beam
                beam:SetName("Terrain Cursor Beam")
                cursorBeam = beam
                layer3D:Add(beam)
                cursorBeamShown = true
            end
            cursorBeam:Place(x, ground, z, eye, distance, cursorSettings)
            cursorBeam:Recolor(cursorSettings, beamPulse)
            cursorBeam:SetSpread(beamSpread)
            if not cursorBeamShown
                cursorBeam:Show()
                cursorBeamShown = true
            end
        elseif cursorBeam not= undefined and cursorBeamShown
            cursorBeam:Hide()
            cursorBeamShown = false
        end

        if cursorSettings:IsShowingCrosshair()
            if cursorCrosshair = undefined
                TerrainCursorCrosshair crosshair
                crosshair:SetName("Terrain Cursor Crosshair")
                cursorCrosshair = crosshair
                layer3D:Add(crosshair)
                cursorCrosshairShown = true
            end
            cursorCrosshair:Place(data, x, z, shown:GetMinimumX(), shown:GetMaximumX(), shown:GetMinimumZ(), shown:GetMaximumZ(), distance)
            cursorCrosshair:Recolor(cursorSettings:GetRed(), cursorSettings:GetGreen(), cursorSettings:GetBlue(), cursorSettings:GetCrosshairOpacity() / 100.0 * linePulse)
            if not cursorCrosshairShown
                cursorCrosshair:Show()
                cursorCrosshairShown = true
            end
        elseif cursorCrosshair not= undefined and cursorCrosshairShown
            cursorCrosshair:Hide()
            cursorCrosshairShown = false
        end
    end

    // Hides the beam and crosshair while there is no cursor on the ground.
    private action HideCursorMarks
        if cursorBeam not= undefined and cursorBeamShown
            cursorBeam:Hide()
            cursorBeamShown = false
        end
        if cursorCrosshair not= undefined and cursorCrosshairShown
            cursorCrosshair:Hide()
            cursorCrosshairShown = false
        end
    end

    /*
    This action shows a ramp being marked: a green ring at its
    start, and a green outline from the start, at its height, to the brush,
    at the ground's height there, as wide as the brush. They are the
    editor's own items, so they aren't saved, listed or picked.

    Attribute: Parameter layer The 3D layer the terrain is in
    */
    private action UpdateRampPreview(EditorLayer3D layer)
        boolean marking = brushTerrain:GetToolNumber() = 5 and brushTerrain:HasRampStart()
        if not marking
            HideRampPreview()
            return now
        end
        TerrainData data = brushTerrain:GetWorldTerrain():GetData()
        number size = brushTerrain:GetBrush():GetSize()
        number startX = brushTerrain:GetRampStartX()
        number startZ = brushTerrain:GetRampStartZ()
        if rampStartMarker = undefined
            TerrainBrushPreview marker
            marker:SetName("Ramp Start")
            marker:SetProperty(constants:EDITOR_TAG, undefined)
            marker:SetAcceptsMouseInput(false)
            marker:SetRingColor(0.15, 0.85, 0.25)
            marker:Place(data, startX, startZ, size)
            rampStartMarker = marker
            layer:Add(marker)

            TerrainRampPreview outline
            outline:SetName("Ramp")
            outline:SetProperty(constants:EDITOR_TAG, undefined)
            outline:SetAcceptsMouseInput(false)
            rampOutline = outline
            layer:Add(outline)
        end
        rampStartMarker:Place(data, startX, startZ, size)
        number endHeight = data:GetSurfaceHeight(brushTerrain:GetBrushX(), brushTerrain:GetBrushZ())
        rampOutline:Place(startX, startZ, brushTerrain:GetRampStartHeight(), brushTerrain:GetBrushX(), brushTerrain:GetBrushZ(),
            endHeight, size)
        if not rampShown
            rampStartMarker:Show()
            rampOutline:Show()
            rampShown = true
        end
    end

    /*
    This action hides a ramp's start ring and outline.
    */
    private action HideRampPreview
        if rampShown
            rampStartMarker:Hide()
            rampOutline:Hide()
            rampShown = false
        end
    end

    /*
    This action gives back what each terrain in the 3D layers holds in the
    renderer, such as its block of texture places. Call it when the scene is
    closed, after HideLayers, so reopening scenes doesn't use up places.
    */
    action ReleaseTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        item:Dispose()
                    end
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action keeps each terrain in the 3D layers up to date, once a frame,
    with the editor camera's place. Painted ground textures only show once
    the renderer has them ready, which this checks.
    */
    private action UpdateTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Camera camera = layer:GetCamera()
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        EditorTerrain terrain = cast(EditorTerrain, item)
                        terrain:Update(layer, camera:GetPosition():GetX(), camera:GetPosition():GetZ())
                    end
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action saves the files of each terrain whose ground has changed
    since it was last saved. Saving the scene calls it.
    */
    private action SaveChangedTerrains
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        EditorTerrain terrain = cast(EditorTerrain, item)
                        terrain:SaveIfChanged()
                    end
                end
            end
            counter = counter + 1
        end
    end

    action SelectEditorCamera(EditorLayer layer)
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            CameraItem2D item
            item:Load(layer:GetCamera(), me)
            layer2D:Add(item)
            SetSelection(layer2D, item)

            item:Focus()
        elseif layer is EditorLayer3D
            // The editor views through its own camera again.
            SelectCamera3D(cast(EditorLayer3D, layer), false, true)
        end
    end

    /*
        This action selects one of a 3D layer's cameras, the game's or the
        editor's own, and views the scene through it. The layer keeps viewing
        through it until the other is selected, so moving the view with the
        mouse or keys moves that camera, and the camera's properties show it.
        Each camera has one item, made the first time and kept.

        Attribute: Parameter layer The layer.
        Attribute: Parameter game True for the game camera, false for the editor's.
        Attribute: Parameter moveFocus True to move the focus to the camera, as
        activating it does; false to leave it, as selecting it in the Scene tab does.
    */
    action SelectCamera3D(EditorLayer3D layer, boolean game, boolean moveFocus)
        layer:ViewThroughGameCamera(game)
        CameraItem3D item = layer:GetCameraItem(game)
        if item = undefined
            CameraItem3D made
            item = made
            item:SetGameCamera(game)
            layer:SetCameraItem(game, item)
            layer:Add(item)
        end
        item:Load(layer:GetEditorCamera(), me)
        SetSelection(layer, item)
        // A followed car's game camera starts where the game's would.
        if game
            StartFollowCamera(layer)
        else
            followCameraActive = false
        end
        if moveFocus
            item:Focus()
        end
    end

    /*
    This action shows where the game's camera starts when a vehicle in a
    layer has Camera follows this: the layer's game camera is put at the
    car's follow place, looking at it. Moving it then changes where the car
    is followed from (UpdateFollowCamera). A layer with no followed vehicle
    keeps its game camera as it is.

    Attribute: Parameter layer The layer whose game camera was selected
    */
    private action StartFollowCamera(EditorLayer3D layer)
        followCameraActive = false
        followCameraModel = undefined
        Item3D followed = FindFollowedVehicle(layer)
        if followed = undefined
            return now
        end
        VehicleControllerSettings settings = GetControllerSettings(followed)
        followCameraModel = followed
        followCameraLayer = layer
        followCameraActive = true
        PlaceFollowCamera(settings)
        NotifyAccessibility(me, "The game camera follows " + followed:GetName() + ": " + DescribeFollow(settings) + ". Move it to change where it follows.")
    end

    /*
    Returns the first item in a layer with a Vehicle controller whose camera
    follows it, or undefined.
    */
    private action FindFollowedVehicle(EditorLayer3D layer) returns Item3D
        Iterator<Item3D> items = layer:GetIterator()
        repeat while items:HasNext()
            Item3D item = items:Next()
            if not item:HasProperty(constants:EDITOR_TAG)
                VehicleControllerSettings settings = GetControllerSettings(item)
                if settings not= undefined and settings:IsCameraFollowing()
                    return item
                end
            end
        end
        return undefined
    end

    /*
    Puts the game camera at the followed car's follow place, looking at the
    car, and its camera item with it.
    */
    private action PlaceFollowCamera(VehicleControllerSettings settings)
        if followCameraLayer = undefined or followCameraModel = undefined
            return now
        end
        EditorCamera3D camera = followCameraLayer:GetEditorCamera()
        Vector3 place = settings:GetFollowPosition(followCameraModel)
        camera:SetPosition(place)
        AimFollowCamera(camera, settings)
        camera:Update()
        followCameraLast:Set(place)
        followCameraCommitted:Set(place)
        CameraItem3D item = followCameraLayer:GetCameraItem(true)
        if item not= undefined
            item:Load(camera, me)
        end
    end

    /*
    Turns the game camera to look at the followed car, as a following camera
    does.
    */
    private action AimFollowCamera(EditorCamera3D camera, VehicleControllerSettings settings)
        Vector3 aim = settings:GetBodyPosition(followCameraModel)
        Vector3 look
        look:Set(aim)
        look:Subtract(camera:GetPosition())
        if look:Length() > 0.001
            camera:LookAlong(look)
            camera:MatchView()
        end
    end

    /*
    Returns the follow settings as words, such as "12 behind, 5 above".
    */
    private action DescribeFollow(VehicleControllerSettings settings) returns text
        text result = "" + settings:GetSetting(settings:CAMERA_BEHIND) + " behind, " + settings:GetSetting(settings:CAMERA_ABOVE) + " above"
        number angle = settings:GetSetting(settings:CAMERA_ANGLE)
        if angle not= 0
            result = result + ", " + angle + " degrees around"
        end
        return result
    end

    /*
    While the game camera of a followed car is viewed: after each move it
    turns back to the car, and once a move ends (no camera key or mouse
    button held), its place becomes the car's follow settings, as one step
    to undo.
    */
    private action UpdateFollowCamera
        if not followCameraActive
            return now
        end
        EditorLayer selected = GetSelectedLayer()
        if followCameraLayer = undefined or followCameraModel = undefined or selected = undefined or not selected:Equals(followCameraLayer) or not followCameraLayer:IsViewingGameCamera()
            followCameraActive = false
            return now
        end
        VehicleControllerSettings settings = GetControllerSettings(followCameraModel)
        if settings = undefined or not settings:IsCameraFollowing()
            followCameraActive = false
            return now
        end
        EditorCamera3D camera = followCameraLayer:GetEditorCamera()
        Vector3 place = camera:GetPosition()
        if place:Distance(followCameraLast) > 0.0001
            AimFollowCamera(camera, settings)
            followCameraLast:Set(place)
            return now
        end
        if place:Distance(followCameraCommitted) <= 0.01 or not cameraHeldKeys:IsEmpty()
            return now
        end
        if strokeMonitor:IsMouseButtonPressed(mouseButtons:LEFT) or strokeMonitor:IsMouseButtonPressed(mouseButtons:RIGHT) or strokeMonitor:IsMouseButtonPressed(mouseButtons:MIDDLE)
            return now
        end
        followCameraCommitted:Set(place)
        VehicleControllerSettings after = settings:Copy()
        after:SetFollowFrom(followCameraModel, place)
        if after:GetSetting(after:CAMERA_BEHIND) = settings:GetSetting(settings:CAMERA_BEHIND) and after:GetSetting(after:CAMERA_ABOVE) = settings:GetSetting(settings:CAMERA_ABOVE) and after:GetSetting(after:CAMERA_ANGLE) = settings:GetSetting(settings:CAMERA_ANGLE)
            return now
        end
        ChangeController(followCameraModel, after, "move the following camera", "Camera follows " + followCameraModel:GetName() + ": " + DescribeFollow(after) + ".")
    end


    /*
        This action selects a 3D layer's game camera, where a game using the
        scene starts looking, and views the scene through it. The layer keeps
        viewing through it until the editor camera is selected, so moving the
        view with the mouse or keys moves the game camera, and the camera's
        properties show it.

        Attribute: Parameter layer The layer.
    */
    action SelectGameCamera(EditorLayer layer)
        if layer is EditorLayer3D
            SelectCamera3D(cast(EditorLayer3D, layer), true, true)
        end
    end

    action DeselectEditorCamera
        // Was already empty
    end

    Matrix4 previewTransform = undefined
    action GetPreviewTransform returns Matrix4
        return previewTransform
    end

    action SetPreviewTransform(Matrix4 transform)
        previewTransform = transform
    end

    action GetDefaultItemName(integer type) returns text
        if type = 0
            return "Box"
        elseif type = 1
            return "Sphere"
        elseif type = 2
            return "Cylinder"
        end

        return "Item"
    end

    action ConfirmItemPreview(ItemPreview newItem)
        // Placing selects the new item; the camera stays where it is.
        keepCameraAfterPlacing = true
        Item result = undefined
        EditorLayer resultLayer = undefined

        if newItem:GetItemBlueprint() not= undefined
            IncrementNameCount(newItem:GetItemBlueprint():GetName())
        end

        if newItem is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, newItem)
            Model model = preview:ConvertToModel()
            result = model

            previewTransform = preview:GetTransform()
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(model)
            CopyPlacementPhysics(preview, model)
        elseif newItem is ItemPreview2D
            ItemPreview2D preview = cast(ItemPreview2D, newItem)
            Drawable drawable = preview:ConvertToDrawable()
            result = drawable

            EditorLayer2D layer = cast(EditorLayer2D, GetSelectedLayer())
            resultLayer = layer
            layer:Add(drawable)
        end

        // This Dispose call currently does nothing, but if there are any
        // resources that need to be cleaned up, it should be done here.
        //preview:Dispose()
        //Focus()

        NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, result, undefined, resultLayer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        if newItem:GetItemBlueprint() not= undefined
            text name = newItem:GetItemBlueprint():GetName()
            newItem:SetName(name + GetNextNamePostfix(name))
            if newItem is ModelPreview
                //item3dPropertiesDialog:SetFields(newItem)
            elseif newItem is PointLightPreview
                //pointLightPropertiesDialog:SetFields(newItem)
            elseif newItem is Audio3DPreview
                //audio3DPropertiesDialog:SetFields(newItem)
            elseif newItem is ItemPreview2D
                //item2dPropertiesDialog:SetFields(newItem)
            end
        end

        SceneEditorInsertEdit edit
        edit:Create(me, resultLayer, result)
        editManager:Add(edit)
        // The placeholder goes now. It was left in the scene for its losing
        // the focus to take it away, but a click in the view gives the
        // scene editor the focus, which keeps a placeholder, so it stayed,
        // as a ghost.
        boolean hadFocus = newItem:IsFocused()
        CancelItemPreview(newItem)
        if hadFocus
            Focus()
        end
    end

    action Add(EditorLayer layer, Item item)
        if layer is EditorLayer2D and item is Item2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            Item2D item2D = cast(Item2D, item)
            layer2D:Add(item2D)
        elseif layer is EditorLayer3D and item is Item3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            Item3D item3D = cast(Item3D, item)
            layer3D:Add(item3D)    
        else
            alert("I couldn't add the item " + item:GetName() + " because it's incompatible with the requested layer.")
        end

        // It's not clear if we should notify accessibility here, or allow a change in selection to handle that for us.
        //NotifyAccessibility(newItem, "Placed " + result:GetName())
        
        SceneEditorChangeEvent event
        event:Set(me, item, undefined, layer, event:ADDED)
        NotifySceneEditorChangeListeners(event)

        SceneEditorInsertEdit edit
        edit:Create(me, layer, item)
        editManager:Add(edit)
    end

    action AddLayer(EditorLayer layer)
        selection:SetSelection(layer)
        layer:SetSceneEditor(me)
        layers:Add(layer)
    end

    action SetYawDirection(integer direction)
        yawDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Yaw " + math:Round(GetSelectedLayer():GetCameraYaw(), 1))
        end
    end

    action GetYawDirection returns integer
        return yawDirection
    end

    action SetPitchDirection(integer direction)
        pitchDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Pitch " + math:Round(GetSelectedLayer():GetCameraPitch(), 1))
        end
    end

    action GetPitchDirection returns integer
        return pitchDirection
    end

    action SetRollDirection(integer direction)
        rollDirection = direction

        if direction = 0
            NotifyAccessibility(me, "Roll " + math:Round(GetSelectedLayer():GetCameraRoll(), 1))
        end
    end

    action GetRollDirection returns integer
        return rollDirection
    end

    /*
    This action starts one of the 3D camera's moves, while its key is held:
    SceneConstants' CAMERA_LOOK, CAMERA_SLIDE, CAMERA_ORBIT or CAMERA_ZOOM,
    with x -1 for left
    and 1 for right, and y -1 for down (or out) and 1 for up (or in). It
    moves a small step at once, so a tap moves a little.

    Attribute: Parameter move One of the CAMERA_ moves
    Attribute: Parameter x -1, 0 or 1
    Attribute: Parameter y -1, 0 or 1
    */
    action StartCameraMove(integer move, integer x, integer y)
        if not (GetSelectedLayer() is EditorLayer3D)
            return now
        end
        EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        if move = constants:CAMERA_LOOK
            if x not= 0
                cameraLookX = x
            end
            if y not= 0
                cameraLookY = y
            end
        elseif move = constants:CAMERA_SLIDE
            if x not= 0
                cameraSlideX = x
            end
            if y not= 0
                cameraSlideY = y
            end
        elseif move = constants:CAMERA_ORBIT
            if cameraOrbitX = 0 and cameraOrbitY = 0
                camera:StartOrbit()
            end
            if x not= 0
                cameraOrbitX = x
            end
            if y not= 0
                cameraOrbitY = y
            end
        elseif move = constants:CAMERA_ZOOM
            cameraZoom = y
        end
        MoveCameraByKeys(camera, CAMERA_KEY_TAP_SECONDS)
    end

    /*
    This action stops one of the 3D camera's moves, when its key comes up.
    It only stops the move if it is still going the key's way, so letting go
    of Left while Right is held keeps the camera going right.

    Attribute: Parameter move One of the CAMERA_ moves
    Attribute: Parameter x The key's x: -1, 0 or 1
    Attribute: Parameter y The key's y: -1, 0 or 1
    */
    action StopCameraMove(integer move, integer x, integer y)
        if move = constants:CAMERA_LOOK
            if x not= 0 and cameraLookX = x
                cameraLookX = 0
            end
            if y not= 0 and cameraLookY = y
                cameraLookY = 0
            end
        elseif move = constants:CAMERA_SLIDE
            if x not= 0 and cameraSlideX = x
                cameraSlideX = 0
            end
            if y not= 0 and cameraSlideY = y
                cameraSlideY = 0
            end
        elseif move = constants:CAMERA_ORBIT
            if x not= 0 and cameraOrbitX = x
                cameraOrbitX = 0
            end
            if y not= 0 and cameraOrbitY = y
                cameraOrbitY = 0
            end
            if cameraOrbitX = 0 and cameraOrbitY = 0 and GetSelectedLayer() is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
                layer:GetEditorCamera():EndOrbit()
            end
        elseif move = constants:CAMERA_ZOOM
            if cameraZoom = y
                cameraZoom = 0
            end
        end
    end

    /*
    This action moves the 3D camera by its held keys, for a time.
    */
    private action MoveCameraByKeys(EditorCamera3D camera, number seconds)
        if camera = undefined
            return now
        end
        if cameraLookX not= 0 or cameraLookY not= 0
            camera:LookBy(cameraLookX * CAMERA_KEY_TURN_SPEED * seconds, cameraLookY * CAMERA_KEY_TURN_SPEED * seconds)
        end
        if cameraSlideX not= 0 or cameraSlideY not= 0
            number slide = camera:GetViewDistance() * CAMERA_KEY_SLIDE_SHARE * seconds
            camera:SlideBy(cameraSlideX * slide, cameraSlideY * slide)
        end
        if cameraOrbitX not= 0 or cameraOrbitY not= 0
            camera:OrbitBy(cameraOrbitX * CAMERA_KEY_TURN_SPEED * seconds, cameraOrbitY * CAMERA_KEY_TURN_SPEED * seconds)
        end
        if cameraZoom not= 0
            camera:ZoomBy(cameraZoom * CAMERA_KEY_ZOOM_STEPS * seconds)
        end
    end

    /*
    This action runs one step of a scene key's action, such as Quorum
    Studio's Scenes menu asks for: one of SceneConstants' COMMAND_ numbers.
    It uses the same code as the keys. A key held down keeps going; a
    command does one step: the cursor or selection moves one grid unit, the
    selection turns 15 degrees, the camera looks or orbits 15 degrees,
    slides a tenth of the distance to what it looks at, or zooms one step.
    A command that doesn't apply, such as a selection command with nothing
    selected, or a camera command in a 2D layer, does nothing.

    Attribute: Parameter command One of SceneConstants' COMMAND_ numbers

    Attribute: Example
    use Libraries.Interface.Controls.Scenes.SceneEditor
    use Libraries.Interface.Controls.Scenes.SceneConstants

    SceneEditor editor
    SceneConstants constants
    editor:RunCommand(constants:COMMAND_ZOOM_IN)
    */
    action RunCommand(integer command)
        if layers:IsEmpty() or GetSelectedLayer() = undefined
            return now
        end
        if command >= constants:COMMAND_LOOK_LEFT and command <= constants:COMMAND_POINT_AT_SELECTION
            RunCameraCommand(command)
        elseif command >= constants:COMMAND_CURSOR_LEFT and command <= constants:COMMAND_CURSOR_SELECT
            RunCursorCommand(command)
        elseif command >= constants:COMMAND_SELECTION_LEFT and command <= constants:COMMAND_SELECTION_LEAVE
            RunSelectionCommand(command)
        elseif command >= constants:COMMAND_TERRAIN_TOOL and command <= constants:COMMAND_TERRAIN_TAKE_HEIGHT
            RunTerrainCommand(command)
        elseif command = constants:COMMAND_GRID_TOGGLE
            ToggleGridBehavior toggle
            RunBehaviorOn(toggle, me)
        elseif command = constants:COMMAND_GRID_LARGER
            IncreaseGridUnitBehavior larger
            RunBehaviorOn(larger, me)
        elseif command = constants:COMMAND_GRID_SMALLER
            DecreaseGridUnitBehavior smaller
            RunBehaviorOn(smaller, me)
        elseif command = constants:COMMAND_PROPERTIES_FOCUS
            FocusItemProperties()
        elseif command = constants:COMMAND_PROPERTIES_CLOSE_SECTION
            if propertiesPanel not= undefined
                propertiesPanel:CloseFocusedSection()
            end
        elseif command = constants:COMMAND_PROPERTIES_OPEN_SECTION
            if propertiesPanel not= undefined
                propertiesPanel:OpenFocusedSection()
            end
        elseif command = constants:COMMAND_FIND
            OpenSceneEditorFindDialogBehavior find
            RunBehaviorOn(find, me)
        elseif command = constants:COMMAND_SAY_LOCATION
            // Where the selection is, or the camera with nothing selected,
            // as the report key says.
            ReportLocationBehavior where
            if GetSelectedItem() not= undefined
                RunBehaviorOn(where, GetSelectedItem())
            else
                RunBehaviorOn(where, me)
            end
        elseif command = constants:COMMAND_SAY_CAMERA_DIRECTION
            ReportCameraDirectionBehavior direction
            RunBehaviorOn(direction, me)
        elseif command = constants:COMMAND_SAY_ITEMS_IN_VIEW
            if GetSelectedLayer() is EditorLayer3D
                ReportItemsInViewBehavior inView
                RunBehaviorOn(inView, me)
            end
        end
    end

    /*
    This action runs a key's behavior once, as if its key were pressed with
    an item focused.
    */
    private action RunBehaviorOn(Behavior behavior, Item item)
        BehaviorEvent event
        event:SetItem(item)
        behavior:Run(event)
    end

    /*
    This action runs one step of a camera command, in a 3D layer.
    */
    private action RunCameraCommand(integer command)
        if not (GetSelectedLayer() is EditorLayer3D)
            return now
        end
        EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        if camera = undefined
            return now
        end
        number turn = COMMAND_TURN_RADIANS
        number slide = camera:GetViewDistance() * COMMAND_SLIDE_SHARE
        if command = constants:COMMAND_LOOK_LEFT
            camera:LookBy(-turn, 0)
        elseif command = constants:COMMAND_LOOK_RIGHT
            camera:LookBy(turn, 0)
        elseif command = constants:COMMAND_LOOK_UP
            camera:LookBy(0, turn)
        elseif command = constants:COMMAND_LOOK_DOWN
            camera:LookBy(0, -turn)
        elseif command = constants:COMMAND_SLIDE_LEFT
            camera:SlideBy(-slide, 0)
        elseif command = constants:COMMAND_SLIDE_RIGHT
            camera:SlideBy(slide, 0)
        elseif command = constants:COMMAND_SLIDE_UP
            camera:SlideBy(0, slide)
        elseif command = constants:COMMAND_SLIDE_DOWN
            camera:SlideBy(0, -slide)
        elseif command >= constants:COMMAND_ORBIT_LEFT and command <= constants:COMMAND_ORBIT_DOWN
            camera:StartOrbit()
            if command = constants:COMMAND_ORBIT_LEFT
                camera:OrbitBy(-turn, 0)
            elseif command = constants:COMMAND_ORBIT_RIGHT
                camera:OrbitBy(turn, 0)
            elseif command = constants:COMMAND_ORBIT_UP
                camera:OrbitBy(0, turn)
            else
                camera:OrbitBy(0, -turn)
            end
            camera:EndOrbit()
        elseif command = constants:COMMAND_ZOOM_IN
            camera:ZoomBy(1)
        elseif command = constants:COMMAND_ZOOM_OUT
            camera:ZoomBy(-1)
        elseif command = constants:COMMAND_POINT_AT_SELECTION
            EditorItem selected = GetSelectedItem()
            if selected = undefined or not (selected is Item3D)
                NotifyAccessibility(me, "Nothing is selected to point the camera at.")
                return now
            end
            if selected is TerrainSelectionHighlight
                NotifyAccessibility(me, "A terrain is too big to point the camera at.")
                return now
            end
            // Pointing again at the same item still turns the camera to it.
            // EditorItem is an interface, so it is cast through Object.
            Object selectedObject = selected
            Item3D selected3D = cast(Item3D, selectedObject)
            camera:SetTarget(selected3D)
            camera:UpdateCameraPosition()
        end
    end

    /*
    This action runs one step of a cursor command.
    */
    private action RunCursorCommand(integer command)
        EditorLayer layer = GetSelectedLayer()
        Item cursorItem = layer:GetCursor()
        if command = constants:COMMAND_CURSOR_LARGER
            GetCursor():IncreaseSize()
            return now
        elseif command = constants:COMMAND_CURSOR_SMALLER
            GetCursor():DecreaseSize()
            return now
        elseif command = constants:COMMAND_CURSOR_SELECT
            SetFilteredItems(GetCursor():GetItemsAtCursor(), true)
            return now
        end
        integer x = 0
        integer y = 0
        integer z = 0
        if command = constants:COMMAND_CURSOR_LEFT
            x = -1
        elseif command = constants:COMMAND_CURSOR_RIGHT
            x = 1
        elseif command = constants:COMMAND_CURSOR_FORWARD
            z = 1
        elseif command = constants:COMMAND_CURSOR_BACKWARD
            z = -1
        elseif command = constants:COMMAND_CURSOR_UP
            y = 1
        elseif command = constants:COMMAND_CURSOR_DOWN
            y = -1
        end
        if StepItem(cursorItem, x, y, z)
            UpdateEditorCameraPosition()
            NotifyAccessibility(me, GetDescription())
        end
    end

    /*
    This action runs one step of a selection command, on the selected item.
    */
    private action RunSelectionCommand(integer command)
        EditorItem selected = GetSelectedItem()
        if selected = undefined
            return now
        end
        if command = constants:COMMAND_SELECTION_LEAVE
            if selected is TerrainSelectionHighlight
                ExitTerrainCursor(cast(TerrainSelectionHighlight, selected))
            else
                Array<Item> nothing
                SetFilteredItems(nothing, true)
            end
            return now
        elseif command = constants:COMMAND_SELECTION_DELETE
            if selected is SelectionHighlight
                Delete(cast(SelectionHighlight, selected))
            end
            return now
        elseif command = constants:COMMAND_SELECTION_DROP
            if selected is EditorItem3D
                DropOnGround(cast(EditorItem3D, selected))
            end
            return now
        elseif command = constants:COMMAND_SELECTION_RESET_SCALE
            selected:ResetScale()
            selected:NotifyAccessibility("Reset scale")
            return now
        elseif command >= constants:COMMAND_SELECTION_LARGER and command <= constants:COMMAND_SELECTION_SHRINK_Z
            SelectionScaleBehavior scaler
            number up = 1.1
            number down = 1.0 / 1.1
            if command = constants:COMMAND_SELECTION_LARGER
                scaler:SetScale(up, up, up)
            elseif command = constants:COMMAND_SELECTION_SMALLER
                scaler:SetScale(down, down, down)
            elseif command = constants:COMMAND_SELECTION_STRETCH_X
                scaler:SetScale(up, 1, 1)
            elseif command = constants:COMMAND_SELECTION_SHRINK_X
                scaler:SetScale(down, 1, 1)
            elseif command = constants:COMMAND_SELECTION_STRETCH_Y
                scaler:SetScale(1, up, 1)
            elseif command = constants:COMMAND_SELECTION_SHRINK_Y
                scaler:SetScale(1, down, 1)
            elseif command = constants:COMMAND_SELECTION_STRETCH_Z
                scaler:SetScale(1, 1, up)
            else
                scaler:SetScale(1, 1, down)
            end
            RunBehaviorOn(scaler, selected)
            UpdateActivePropertiesDialog(selected)
            return now
        elseif command >= constants:COMMAND_SELECTION_TURN_LEFT and command <= constants:COMMAND_SELECTION_ROLL_RIGHT
            TurnItem(selected, command)
            UpdateActivePropertiesDialog(selected)
            return now
        end
        integer x = 0
        integer y = 0
        integer z = 0
        if command = constants:COMMAND_SELECTION_LEFT
            x = -1
        elseif command = constants:COMMAND_SELECTION_RIGHT
            x = 1
        elseif command = constants:COMMAND_SELECTION_FORWARD
            z = 1
        elseif command = constants:COMMAND_SELECTION_BACKWARD
            z = -1
        elseif command = constants:COMMAND_SELECTION_UP
            y = 1
        elseif command = constants:COMMAND_SELECTION_DOWN
            y = -1
        end
        if StepItem(selected, x, y, z)
            UpdateActivePropertiesDialog(selected)
            UpdateEditorCameraPosition()
            ReportLocationBehavior where
            RunBehaviorOn(where, selected)
        end
    end

    /*
    This action turns an item one step, as the selection's turn and roll
    keys do while held: 15 degrees. In a 2D layer, only rolling turns it.
    */
    private action TurnItem(Item item, integer command)
        number yaw = 0
        number pitch = 0
        number roll = 0
        // The keys' directions: left is -1 yaw, up is -1 pitch, roll left
        // is 1.
        if command = constants:COMMAND_SELECTION_TURN_LEFT
            yaw = -1
        elseif command = constants:COMMAND_SELECTION_TURN_RIGHT
            yaw = 1
        elseif command = constants:COMMAND_SELECTION_TURN_UP
            pitch = -1
        elseif command = constants:COMMAND_SELECTION_TURN_DOWN
            pitch = 1
        elseif command = constants:COMMAND_SELECTION_ROLL_LEFT
            roll = 1
        elseif command = constants:COMMAND_SELECTION_ROLL_RIGHT
            roll = -1
        end
        if item is EditorItem3D and GetSelectedLayer() is EditorLayer3D
            EditorItem3D focus = cast(EditorItem3D, item)
            Vector3 angles
            angles:Set(focus:GetYaw() + yaw * COMMAND_TURN_DEGREES, focus:GetPitch() + pitch * COMMAND_TURN_DEGREES, focus:GetRoll() + roll * COMMAND_TURN_DEGREES)
            focus:SetRotation(angles)
        elseif item is EditorItem2D and roll not= 0
            EditorItem2D target = cast(EditorItem2D, item)
            target:SetRotation(target:GetRotation() + roll * COMMAND_TURN_DEGREES)
        end
    end

    /*
    This action moves an item one step, as the move keys do with the grid:
    one grid unit along each axis given, or for a terrain's cursor, a step
    over the ground. It returns true if something moved.
    */
    private action StepItem(Item item, integer x, integer y, integer z) returns boolean
        if x = 0 and y = 0 and z = 0
            return false
        end
        if GetSelectedLayer() is EditorLayer3D
            EditorLayer3D layer = cast(EditorLayer3D, GetSelectedLayer())
            EditorItem3D focus = cast(EditorItem3D, cast(Object, item))
            if focus is TerrainSelectionHighlight
                TerrainSelectionHighlight cursorHighlight = cast(TerrainSelectionHighlight, focus)
                StepTerrainCursor(cursorHighlight:GetEditorTerrain(), x, z)
                return true
            elseif focus is CameraItem3D
                CameraItem3D cameraItem = cast(CameraItem3D, focus)
                if x not= 0
                    cameraItem:SetYaw(cameraItem:GetYaw() + x * CAMERA_ROTATIONAL_SPEED_3D)
                end
                if y not= 0
                    cameraItem:SetPitch(cameraItem:GetPitch() + y * CAMERA_ROTATIONAL_SPEED_3D)
                end
                if z not= 0
                    cameraItem:SetDistance(cameraItem:GetDistance() - z * CAMERA_DIRECTIONAL_SPEED_3D)
                end
                return true
            end
            number newX = focus:GetGlobalX()
            number newY = focus:GetGlobalY()
            number newZ = focus:GetGlobalZ()
            if x < 0
                newX = layer:GetPreviousGridCoordinate(newX)
            elseif x > 0
                newX = layer:GetNextGridCoordinate(newX)
            end
            if y < 0
                newY = layer:GetPreviousGridCoordinate(newY)
            elseif y > 0
                newY = layer:GetNextGridCoordinate(newY)
            end
            if z < 0
                newZ = layer:GetPreviousGridCoordinate(newZ)
            elseif z > 0
                newZ = layer:GetNextGridCoordinate(newZ)
            end
            focus:Move(newX - focus:GetGlobalX(), newY - focus:GetGlobalY(), newZ - focus:GetGlobalZ())
            PlaceGridUnder(focus)
            return true
        elseif GetSelectedLayer() is EditorLayer2D
            // In 2D, forward and up both go up the screen.
            EditorLayer2D layer2D = cast(EditorLayer2D, GetSelectedLayer())
            Item2D target = cast(Item2D, cast(Object, item))
            integer upward = y + z
            number newX2D = target:GetGlobalX()
            number newY2D = target:GetGlobalY()
            if x < 0
                newX2D = layer2D:GetPreviousGridCoordinate(newX2D)
            elseif x > 0
                newX2D = layer2D:GetNextGridCoordinate(newX2D)
            end
            if upward < 0
                newY2D = layer2D:GetPreviousGridCoordinate(newY2D)
            elseif upward > 0
                newY2D = layer2D:GetNextGridCoordinate(newY2D)
            end
            target:Move(newX2D - target:GetGlobalX(), newY2D - target:GetGlobalY())
            return true
        end
        return false
    end

    /*
    This action runs one terrain command on the selected terrain: choosing
    a tool, or one use of its brush's keys. It does nothing unless a
    terrain is selected.
    */
    private action RunTerrainCommand(integer command)
        EditorItem selected = GetSelectedItem()
        if not (selected is TerrainSelectionHighlight)
            return now
        end
        TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selected)
        EditorTerrain terrain = highlight:GetEditorTerrain()
        if terrain = undefined
            return now
        end
        if command <= constants:COMMAND_TERRAIN_TOOL + terrain:LAST_TOOL
            SetTerrainTool(terrain, command - constants:COMMAND_TERRAIN_TOOL)
            return now
        end
        // The region tools don't use the brush's size, so the brush key
        // and the size keys work their placeholder.
        if terrain = brushTerrain and IsRegionTool(terrain)
            if command = constants:COMMAND_TERRAIN_USE_BRUSH
                UseRegionToolAtCursor(terrain)
                return now
            elseif command = constants:COMMAND_TERRAIN_LARGER
                ResizeRegionPlaceholder(terrain, 1)
                return now
            elseif command = constants:COMMAND_TERRAIN_SMALLER
                ResizeRegionPlaceholder(terrain, -1)
                return now
            end
        end
        // The brush's size and strength change with or without a tool.
        if command = constants:COMMAND_TERRAIN_STRONGER
            ChangeTerrainStrength(terrain, true)
            return now
        elseif command = constants:COMMAND_TERRAIN_WEAKER
            ChangeTerrainStrength(terrain, false)
            return now
        elseif command = constants:COMMAND_TERRAIN_LARGER
            ResizeTerrainBrush(terrain, true)
            return now
        elseif command = constants:COMMAND_TERRAIN_SMALLER
            ResizeTerrainBrush(terrain, false)
            return now
        end
        if not terrain:HasTool()
            highlight:NotifyAccessibility("Choose a tool first, from the Tools menu or with Alt and a number, to place the brush.")
            return now
        end
        if command = constants:COMMAND_TERRAIN_USE_BRUSH
            UseTerrainBrushOnce(terrain)
        elseif command = constants:COMMAND_TERRAIN_NEXT_LAYER
            NextTerrainPaintLayer(terrain)
        elseif command = constants:COMMAND_TERRAIN_RAMP_POINT
            SetNextTerrainRampPoint(terrain)
        elseif command = constants:COMMAND_TERRAIN_TAKE_HEIGHT
            TakeTerrainFlattenHeight(terrain)
        end
    end

    /*
    This action uses a terrain's brush once, as a short press of its key
    does: tools that act on a click act; a stroke makes one dab and ends,
    as one undo step.
    */
    private action UseTerrainBrushOnce(EditorTerrain terrain)
        BeginTerrainStroke(terrain, false, 0)
        if not stroking
            return now
        end
        if terrain:IsBrushOnGround()
            if foliageStroking
                number radius = terrain:GetBrush():GetSize()
                if foliageStroke:Apply(terrain:GetBrushX(), terrain:GetBrushZ(), radius, terrain:GetFoliageDensityScale())
                    terrain:RefreshFoliage(terrain:GetBrushX(), terrain:GetBrushZ(), radius)
                end
            elseif not waterStroking
                terrainStroke:Apply(terrain:GetBrushX(), terrain:GetBrushZ(), COMMAND_STROKE_SECONDS)
                RedrawTerrain(terrain)
            end
        end
        EndTerrainStroke()
    end

    action IsCameraRotating returns boolean
        return GetYawDirection() not= 0 or GetPitchDirection() not= 0
    end

    action GetYaw returns number
        return GetSelectedLayer():GetCameraYaw()
    end

    action GetPitch returns number
        return GetSelectedLayer():GetCameraPitch()
    end

    action GetRoll returns number
        return GetSelectedLayer():GetCameraRoll()
    end

    action SetForwardDirection(integer direction)
        forwardDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetForwardDirection returns integer
        return forwardDirection
    end
    action SetStrafeDirection(integer direction)
        strafeDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetStrafeDirection returns integer
        return strafeDirection
    end

    action SetVerticalDirection(integer direction)
        verticalDirection = direction

        if IsCameraMoving() = false
            if GetSelectedLayer() is EditorLayer2D
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 1)
                number y = math:Round(temp:GetY(), 1)
                NotifyAccessibility(me, "Camera " + x + ", " + y)
            else
                Vector3 temp = GetSelectedLayer():GetCamera():GetPosition()
                number x = math:Round(temp:GetX(), 2)
                number y = math:Round(temp:GetY(), 2)
                number z = math:Round(temp:GetZ(), 2)
                NotifyAccessibility(me, "Camera " + x + ", " + y + ", " + z)
            end
        end
    end

    action GetVerticalDirection returns integer
        return verticalDirection
    end

    action IsCameraMoving returns boolean
        return GetForwardDirection() not= 0 or GetStrafeDirection() not= 0 or GetVerticalDirection() not= 0
    end

    action SetCursorToItem(EditorItem item)
        // We don't want the cursor to jump to the camera item, so abort now.
        if item is CameraItem
            return now
        end
        // A terrain's middle may be far from where it was clicked, so the
        // cursor stays where it is when a terrain is selected.
        if item is TerrainSelectionHighlight
            return now
        end

        if item is EditorItem2D
            EditorCursor2D cursor = cast(EditorCursor2D, GetCursor())
            number x = item:GetGlobalX()
            number y = item:GetGlobalY()
            if not IsGridCoordinate(x)
                x = GetSelectedLayer():GetPreviousGridCoordinate(x)
            end
            if not IsGridCoordinate(y)
                y = GetSelectedLayer():GetPreviousGridCoordinate(y)
            end
            cursor:SetPosition(x, y)
        elseif item is EditorItem3D
            // The grid patch sits under the newly selected item.
            PlaceGridUnder(cast(Item3D, cast(Object, item)))
            EditorCursor3D cursor = cast(EditorCursor3D, GetCursor())
            number x = item:GetGlobalX()
            number y = item:GetGlobalY()
            number z = item:GetGlobalZ()
            cursor:SetPosition(x, y, z)
        end
    end

    // Used when moving an InteractableItem into a grid space to give information about what's under the item.
    // Doesn't include the item itself in the description.
    private action GetDescriptionAtItemPosition(EditorItem item) returns text
        SetCursorToItem(item)

        Item ignoredItem = undefined

        if item is SelectionHighlight
            SelectionHighlight highlight = cast(SelectionHighlight, item)
            ignoredItem = highlight:GetItem()
        end

        EditorCursor cursor = GetCursor()
        if cursor is EditorCursor2D
            EditorCursor2D cursor2D = cast(EditorCursor2D, cursor)
            text position = cast(integer, item:GetGlobalX()) + " " + cast(integer, item:GetGlobalY())
            Array<Item> items = cursor2D:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                    end
                end
                return names + position
            else
                integer counter = items:GetSize()
                integer used = 0
                text names = ""
                repeat while used < 3
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                        used = used + 1
                    end
                end
                return names + (items:GetSize() - 1) + " items, " + position
            end
        else
            EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
            text position = ""
            if cursor:GetGlobalX() = cast(integer, cursor:GetGlobalX())
                position = position + cast(integer, cursor:GetGlobalX())
            else
                position = position + cursor:GetGlobalX()
            end

            position = position + " "

            if cursor:GetGlobalY() = cast(integer, cursor:GetGlobalY())
                position = position + cast(integer, cursor:GetGlobalY())
            else
                position = position + cursor:GetGlobalY()
            end

            position = position + " "

            if cursor:GetGlobalZ() = cast(integer, cursor:GetGlobalZ())
                position = position + cast(integer, cursor:GetGlobalZ())
            else
                position = position + cursor:GetGlobalZ()
            end

            Array<Item> items = cursor3D:GetItemsAtCursor()
            if items:GetSize() = 0
                return position
            elseif items:GetSize() <= 3
                integer counter = items:GetSize()
                text names = ""
                repeat while counter > 0
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                    end
                end
                return names + position
            else
                integer counter = items:GetSize()
                integer used = 0
                text names = ""
                repeat while used < 3
                    counter = counter - 1
                    if ignoredItem = undefined or items:Get(counter):Equals(ignoredItem) = false
                        names = names + items:Get(counter):GetName() + ", "
                        used = used + 1
                    end
                end
                return names + (items:GetSize() - 1) + " items, " + position
            end
        end
        return item:GetGlobalX() + " " + item:GetGlobalY()
    end

    action SetSelectionXDirection(integer direction)
        selectionXDirection = direction

        // The terrain cursor isn't spoken: its description is read as the
        // terrain's value when it changes.
        if direction = 0
            if manager:GetFocus() is EditorItem and not (manager:GetFocus() is TerrainSelectionHighlight)
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionXDirection returns integer
        return selectionXDirection
    end

    action SetSelectionYDirection(integer direction)
        selectionYDirection = direction

        // The terrain cursor isn't spoken: its description is read as the
        // terrain's value when it changes.
        if direction = 0
            if manager:GetFocus() is EditorItem and not (manager:GetFocus() is TerrainSelectionHighlight)
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionYDirection returns integer
        return selectionYDirection
    end

    action SetSelectionZDirection(integer direction)
        selectionZDirection = direction

        // The terrain cursor isn't spoken: its description is read as the
        // terrain's value when it changes.
        if direction = 0
            if manager:GetFocus() is EditorItem and not (manager:GetFocus() is TerrainSelectionHighlight)
                EditorItem focus = cast(EditorItem, manager:GetFocus())
                NotifyAccessibility(focus, GetDescriptionAtItemPosition(focus))
            end
        end
    end

    action GetSelectionZDirection returns integer
        return selectionZDirection
    end

    action IsSelectionMoving returns boolean
        return GetSelectionXDirection() not= 0 or GetSelectionYDirection() not= 0 or GetSelectionZDirection() not= 0
    end

    action SetSelectionYawDirection(integer direction)
        selectionYawDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number yaw = math:Round(focus:GetYaw(), 1)
                NotifyAccessibility(focus, "yaw " + yaw)
            end
        end
    end

    action GetSelectionYawDirection returns integer
        return selectionYawDirection
    end

    action SetSelectionPitchDirection(integer direction)
        selectionPitchDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number pitch = math:Round(focus:GetPitch(), 1)
                NotifyAccessibility(focus, "pitch " + pitch)
            end
        end
    end

    action GetSelectionPitchDirection returns integer
        return selectionPitchDirection
    end

    action SetSelectionRollDirection(integer direction)
        selectionRollDirection = direction

        if direction = 0
            if manager:GetFocus() is EditorItem3D
                EditorItem3D focus = cast(EditorItem3D, manager:GetFocus())
                number roll = math:Round(focus:GetRoll(), 1)
                NotifyAccessibility(focus, "roll " + roll)
            elseif manager:GetFocus() is EditorItem2D
                EditorItem2D focus = cast(EditorItem2D, manager:GetFocus())
                number rotation = math:Round(focus:GetRotation(), 1)
                NotifyAccessibility(focus, rotation + " degrees")
            end
        end
    end

    action GetSelectionRollDirection returns integer
        return selectionRollDirection
    end

    action IsSelectionRotating returns boolean
        return GetSelectionYawDirection() not= 0 or GetSelectionPitchDirection() not= 0 or GetSelectionRollDirection() not= 0
    end

    action NotifyAccessibility(Item item, text message)
        if accessibility not= undefined
            accessibility:Notify(item, message)
        end
    end

    action SetGridSnapping(boolean enabled)
        EditorLayer layer = GetSelectedLayer()

        if layer:IsGridSnapping() = enabled
            return now
        end

        layer:SetGridSnapping(enabled)

        if enabled
            NotifyAccessibility(me, "Grid snapping enabled")
        else
            NotifyAccessibility(me, "Grid snapping disabled")
        end
    end

    action SetGridUnitSize(number units)
        EditorLayer layer = GetSelectedLayer()
        layer:SetGridUnitSize(units)
        
        NotifyAccessibility(me, "Grid size " + units)
    end

    action GetGridUnitSize returns number
        EditorLayer layer = GetSelectedLayer()
        return layer:GetGridUnitSize()
    end

    action IsGridSnapping returns boolean
        EditorLayer layer = GetSelectedLayer()
        return layer:IsGridSnapping()
    end

    private action IsGridCoordinate(number value) returns boolean
        return GetSelectedLayer():IsGridCoordinate(value)
    end

    action SetSelectedItem(EditorItem item)
        selection:SetSelection(item)
    end

    action SetSelectedLayer(EditorLayer layer)
        if layer = selection:GetSelectedLayer()
            return now
        end

        EmptyFilteredItems(false)

        selection:SetSelection(layer, undefined)
    end

    action SetSelection(EditorLayer layer, EditorItem item)
        if layer = selection:GetSelectedLayer() and item = selection:GetSelectedItem()
            return now
        end

        EmptyFilteredItems(false)
        selection:SetSelection(layer, item)
    end

    action GetSelectedItem returns EditorItem
        return selection:GetSelectedItem()
    end

    action GetSelectedLayer returns EditorLayer
        return selection:GetSelectedLayer()
    end

    action GetCursor returns EditorCursor
        EditorLayer layer = GetSelectedLayer()
        if layer = undefined
            return undefined
        end

        return layer:GetCursor()
    end

    action GetSceneLayers returns Array<EditorLayer>
        return layers
    end

    action GainedFocus(FocusEvent event)
        // A click in the view with a terrain's tool chosen is a stroke,
        // so the terrain stays selected, and its highlight gets
        // the focus back on the next update, for the brush's keys.
        if IsTerrainBrushActive() and GetSelectedItem() is TerrainSelectionHighlight
            refocusBrushHighlight = true
            parent:Control:GainedFocus(event)
            return now
        end
        SetSelectedItem(undefined)
        UpdateCursorVisibility()

        if accessibility not= undefined
            // Update the description for the controller in accessibility.
            accessibility:DescriptionChanged(me)
        end
        parent:Control:GainedFocus(event)
    end

    action LostFocus(FocusEvent event)
        Item item = event:GetNewFocus()
        integer value = dummyItem:GetHashCode()
        boolean goingToDummy = false
        if item not= undefined
            integer value1 = item:GetHashCode()
            goingToDummy = (value1 = value)
        end
        EditorLayer layer = GetSelectedLayer()
        if layer not= undefined and not goingToDummy
            layer:ShowCursor(false)
        end
        if not goingToDummy
            // "Left Terrain1" is said only on the way out of a terrain.
            terrainLeftMessage = ""
        end
        parent:Control:LostFocus(event)
    end

    /*
    If the given Item has a corresponding SelectionHighlight, this action
    will return the highlight. Otherwise, it will return undefined.
    */
    action GetSelectionHighlight(Item item) returns SelectionHighlight
        integer i = 0
        repeat while i < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(i)
            if highlight:GetItem() = item
                return highlight
            end
            i = i + 1
        end

        return undefined
    end

    /*
    This action sets the cursor to either be visible or hidden, as is appropriate
    based on the current editor context. For example, if a layer is active and no
    items are selected, it will show the cursor, or hide it if there are already
    selected items.

    This is called automatically by the SceneEditorSelection when the selection
    changes.
    */
    action UpdateCursorVisibility
        EditorLayer layer = selection:GetSelectedLayer()
        if layer = undefined
            return now
        end

        // If an item is selected, hide the cursor. Otherwise, show it.
        layer:ShowCursor(selection:GetSelectedItem() = undefined)
    end

    action GetNameCount(text name) returns integer
        if nameCounts:HasKey(name)
            return nameCounts:GetValue(name)
        end
        return 0
    end

    action IncrementNameCount(text name)
        nameCounts:Set(name, GetNameCount(name) + 1)
    end

    action GetNextNamePostfix(text name) returns text
        integer count = GetNameCount(name)
        if count = 0
            return ""
        end

        return " " + count
    end


    action AddSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Add(listener)
    end

    action RemoveSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Remove(listener)
    end

    private action NotifySceneEditorChangeListeners(SceneEditorChangeEvent event)
        integer i = 0
        repeat while i < sceneEditorChangeListeners:GetSize()
            if event:GetEventType() = event:ADDED
                sceneEditorChangeListeners:Get(i):SceneAddedItem(event)
            else
                sceneEditorChangeListeners:Get(i):SceneRemovedItem(event)
            end
            i = i + 1
        end
    end

/* 
    Overrides the action in DefaultSceneManager. Used to determine which layers
    should be used to match the layers described in the Scene.

    We always make new layers which are stored as part of the VisualSceneController.
    */
    private action SelectLayer(JavaScriptObjectNotation layerJson) returns Layer

        text name = layerJson:GetValue(properties:NAME)
        text classValue = layerJson:GetValue(properties:CLASS)
        EditorLayer current = undefined

        if classValue = "Layer3D"
            EditorLayer3D layer
            current = layer
        elseif classValue = "Layer2D"
            EditorLayer2D layer
            current = layer
        end

        current:SetName(name)
        AddLayer(current)

        return current
    end

    /*
    This action can be used to override a portion of the default camera loading.
    */
    private action CustomLoadCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE        
                Number32BitArray size = ConvertToNumber32BitArray(json:GetObject(key))
                layer2D:SetCameraPreviewSize(size:Get(0), size:Get(1))
                return true
            elseif key = "EDITOR_" + properties:POSITION
                Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                camera:SetPosition(position:Get(0), position:Get(1), camera:GetPosition():GetZ())
                return true
            elseif key = "EDITOR_" + properties:ZOOM
                camera:SetZoom(json:GetNumber(key))
                return true
            end
        elseif layer is EditorLayer3D
            // The scene's camera is the game camera. The editor's view is
            // under EDITOR_ keys; a scene saved before there was a game
            // camera has none, and its camera is the editor's view too.
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            EditorCamera3D gameCamera = layer3D:GetGameCamera()
            EditorCamera3D editorView = layer3D:GetEditorViewCamera()
            if IsViewKey(key)
                LoadViewKey(gameCamera, key, key, json)
                if not HasJsonKey(json, "EDITOR_" + properties:POSITION)
                    LoadViewKey(editorView, key, key, json)
                end
                return true
            end
            text editorPrefix = "EDITOR_"
            if key:StartsWith(editorPrefix)
                text plainKey = key:GetSubtext(editorPrefix:GetSize())
                if IsViewKey(plainKey)
                    LoadViewKey(editorView, key, plainKey, json)
                    return true
                end
            end
        end

        return false
    end

    // The camera keys a 3D layer saves for both its game camera and the
    // editor's view.
    private action IsViewKey(text key) returns boolean
        if key = properties:POSITION
            return true
        elseif key = properties:DIRECTION
            return true
        elseif key = properties:UP
            return true
        elseif key = properties:FIELD_OF_VIEW
            return true
        elseif key = properties:NEAR
            return true
        elseif key = properties:FAR
            return true
        end
        return false
    end

    private action HasJsonKey(JavaScriptObjectNotation json, text key) returns boolean
        Array<text> keys = json:GetKeys()
        integer index = 0
        repeat while index < keys:GetSize()
            if keys:Get(index) = key
                return true
            end
            index = index + 1
        end
        return false
    end

    // Loads one saved view value, stored under the key, into a camera.
    private action LoadViewKey(Camera target, text key, text plainKey, JavaScriptObjectNotation json)
        if plainKey = properties:POSITION
            Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
            target:SetPosition(position:Get(0), position:Get(1), position:Get(2))
        elseif plainKey = properties:DIRECTION
            Number32BitArray direction = ConvertToNumber32BitArray(json:GetObject(key))
            target:SetDirection(direction:Get(0), direction:Get(1), direction:Get(2))
            // The camera's own turn and tilt follow the direction.
            if target is EditorCamera3D
                EditorCamera3D editorCamera = cast(EditorCamera3D, target)
                editorCamera:MatchView()
            end
        elseif plainKey = properties:UP
            Number32BitArray up = ConvertToNumber32BitArray(json:GetObject(key))
            target:SetUp(up:Get(0), up:Get(1), up:Get(2))
        elseif plainKey = properties:FIELD_OF_VIEW
            if target is PerspectiveCamera
                PerspectiveCamera perspective = cast(PerspectiveCamera, target)
                perspective:SetFieldOfView(json:GetNumber(key))
            end
        elseif plainKey = properties:NEAR
            target:SetNear(json:GetNumber(key))
        elseif plainKey = properties:FAR
            target:SetFar(json:GetNumber(key))
        end
        target:Update()
    end

    private action CustomSaveCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        // A 3D layer saves its game camera as the scene's camera, and the
        // editor's view beside it under EDITOR_ keys. Comparing (whether the
        // scene changed) counts the game camera, not the editor's view.
        if layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            EditorCamera3D gameCamera = layer3D:GetGameCamera()
            // The editor's own camera, even while viewing through the game's.
            EditorCamera3D editorView = layer3D:GetEditorViewCamera()
            if key = properties:POSITION
                Vector3 gamePosition = gameCamera:GetPosition()
                json:Add(key, NewJsonArray(gamePosition:GetX(), gamePosition:GetY(), gamePosition:GetZ()))
                if not comparingText
                    Vector3 editorPosition = editorView:GetPosition()
                    json:Add("EDITOR_" + key, NewJsonArray(editorPosition:GetX(), editorPosition:GetY(), editorPosition:GetZ()))
                end
                return true
            elseif key = properties:DIRECTION
                Vector3 gameDirection = gameCamera:GetDirection()
                json:Add(key, NewJsonArray(gameDirection:GetX(), gameDirection:GetY(), gameDirection:GetZ()))
                if not comparingText
                    Vector3 editorDirection = editorView:GetDirection()
                    json:Add("EDITOR_" + key, NewJsonArray(editorDirection:GetX(), editorDirection:GetY(), editorDirection:GetZ()))
                end
                return true
            elseif key = properties:UP
                Vector3 gameUp = gameCamera:GetUp()
                json:Add(key, NewJsonArray(gameUp:GetX(), gameUp:GetY(), gameUp:GetZ()))
                if not comparingText
                    Vector3 editorUp = editorView:GetUp()
                    json:Add("EDITOR_" + key, NewJsonArray(editorUp:GetX(), editorUp:GetY(), editorUp:GetZ()))
                end
                return true
            elseif key = properties:FIELD_OF_VIEW
                json:Add(key, gameCamera:GetFieldOfView())
                if not comparingText
                    json:Add("EDITOR_" + key, editorView:GetFieldOfView())
                end
                return true
            elseif key = properties:NEAR
                // What a game draws, so it counts when comparing.
                json:Add(key, gameCamera:GetNear())
                if not comparingText
                    json:Add("EDITOR_" + key, editorView:GetNear())
                end
                return true
            elseif key = properties:FAR
                json:Add(key, gameCamera:GetFar())
                if not comparingText
                    json:Add("EDITOR_" + key, editorView:GetFar())
                end
                return true
            end
        end

        // Comparing: the rest of the camera is the editor's, so it is left out.
        if comparingText
            return true
        end
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE
                json:Add(properties:SIZE, NewJsonArray(layer2D:GetCameraPreviewWidth(), layer2D:GetCameraPreviewHeight()))
                return true
            elseif key = properties:POSITION
                CameraPreview2D preview = layer2D:GetCameraPreview()
                number x = preview:GetX() + preview:GetWidth() / 2.0
                number y = preview:GetY() + preview:GetHeight() / 2.0
                json:Add(properties:POSITION, NewJsonArray(x, y, camera:GetPosition():GetZ()))

                json:Add("EDITOR_" + properties:POSITION, NewJsonArray(camera:GetPosition():GetX(), camera:GetPosition():GetY()))

                return true
            elseif key = properties:ZOOM
                json:Add(properties:ZOOM, 1.0)

                json:Add("EDITOR_" + properties:ZOOM, camera:GetZoom())

                return true
            end
        end

        return false
    end

    action Save
        // A terrain's heights and painting live in its own files.
        SaveChangedTerrains()

        text sceneText = GetSceneText()
        file:Write(sceneText)
        savedText = GetComparableText()
    end

    /*
    This action returns true if the scene has changes that saving would
    write: its own file would come out different from when it was last
    loaded or saved, or one of its terrains has changed files. Studio asks
    before closing when this is true, and only saves scenes for which it is.

    Attribute: Returns True if the scene has unsaved changes
    */
    action HasUnsavedChanges returns boolean
        integer counter = 0
        repeat while counter < layers:GetSize()
            EditorLayer editorLayer = layers:Get(counter)
            if editorLayer is EditorLayer3D
                EditorLayer3D layer = cast(EditorLayer3D, editorLayer)
                Iterator<Item3D> items = layer:GetIterator()
                repeat while items:HasNext()
                    Item3D item = items:Next()
                    if item is EditorTerrain
                        EditorTerrain terrain = cast(EditorTerrain, item)
                        if terrain:HasUnsavedChanges()
                            return true
                        end
                    end
                end
            end
            counter = counter + 1
        end
        return GetComparableText() not= savedText
    end

    /*
    This action returns the scene's text without its cameras, to tell
    whether the scene itself changed.
    */
    private action GetComparableText returns text
        comparingText = true
        text result = GetSceneText()
        comparingText = false
        return result
    end

    /*
    This action returns the scene's file text as saving would write it.
    */
    private action GetSceneText returns text
        // A car drawn see-through under its guides is saved with its own
        // colors.
        Model faded = seeThroughModel
        if faded not= undefined
            ClearSeeThrough()
        end
        Array<EditorLayer> sceneLayers = GetSceneLayers()
        Scene scene = Save(sceneLayers)
        if not customModels:IsEmpty()
            scene:GetData():Add(properties:CUSTOM_MODELS, SaveCustomModels())
        end
        scene:GetData():SetPrettyPrint(true)
        text result = scene:GetData():ToText()
        if faded not= undefined
            MakeSeeThrough(faded)
        end
        return result
    end

    /*
    This action returns true if a layer is saved with physics on: its
    Physics card's setting (EditorLayer's IsGamePhysicsEnabled). The editor
    never runs physics itself.
    */
    private action LayerUsesPhysics(Layer layer) returns boolean
        if layer is EditorLayer
            EditorLayer editorLayer = cast(EditorLayer, layer)
            return editorLayer:IsGamePhysicsEnabled()
        end
        return layer:PhysicsEnabled()
    end

    /*
    The gravity a 3D layer is saved with: its Physics card's.
    */
    private action LayerGravity3D(Layer3D layer) returns Vector3
        if layer is EditorLayer3D
            EditorLayer3D editorLayer = cast(EditorLayer3D, layer)
            return editorLayer:GetGameGravity()
        end
        return layer:GetGravity()
    end

    /*
    The gravity a 2D layer is saved with: its Physics card's x and y.
    */
    private action LayerGravity2D(Layer2D layer) returns Vector2
        if layer is EditorLayer2D
            EditorLayer2D editorLayer = cast(EditorLayer2D, layer)
            Vector3 gravity = editorLayer:GetGameGravity()
            Vector2 flat
            flat:Set(gravity:GetX(), gravity:GetY())
            return flat
        end
        return layer:GetGravity()
    end

    /*
    A layer's physics, as the scene saved it, goes to its Physics card's
    settings, not to the layer: the editor never runs physics itself.
    */
    private action LoadPhysics3D(Layer3D layer, JavaScriptObjectNotation json)
        LoadGamePhysics(layer, json)
    end

    private action LoadPhysics2D(Layer2D layer, JavaScriptObjectNotation json)
        LoadGamePhysics(layer, json)
    end

    /*
    Reads a layer's saved physics into its Physics card's settings.
    */
    private action LoadGamePhysics(Layer layer, JavaScriptObjectNotation json)
        if not (layer is EditorLayer) or json = undefined
            return now
        end
        EditorLayer editorLayer = cast(EditorLayer, layer)
        if json:HasValue(properties:ENABLED)
            editorLayer:SetGamePhysicsEnabled(json:GetBoolean(properties:ENABLED))
        end
        JavaScriptObjectNotation gravityJson = json:GetObject(properties:GRAVITY)
        if gravityJson not= undefined
            Number32BitArray gravity = ConvertToNumber32BitArray(gravityJson)
            if gravity:GetSize() >= 3
                editorLayer:SetGameGravity(gravity:Get(0), gravity:Get(1), gravity:Get(2))
            elseif gravity:GetSize() = 2
                editorLayer:SetGameGravity(gravity:Get(0), gravity:Get(1), 0)
            end
        end
    end

    // We override the particular save item calls to ignore items with the editor tag.
    private action SaveItem3D(Item3D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        elseif item is EditorAudio3D
            JavaScriptObjectNotation json

            json:Add(properties:CLASS, "Audio3D")

            json:Add(properties:NAME, item:GetName())
            json:Add(properties:DESCRIPTION, item:GetDescription())
            json:Add(properties:POSITION, NewJsonArray(item:GetX(), item:GetY(), item:GetZ()))
            json:Add(properties:SIZE, NewJsonArray(item:GetWidth(), item:GetHeight(), item:GetDepth()))
    
            EditorAudio3D audio = cast(EditorAudio3D, item)
            json:Add(properties:FILE, audio:GetSource())
            json:Add(properties:VOLUME, audio:GetVolume())
            json:Add(properties:PITCH, audio:GetPitch())
            json:Add(properties:MAX_VOLUME_DISTANCE, audio:GetMaximumVolumeDistance())
            json:Add(properties:ROLLOFF_RATE, audio:GetRolloffRate())
            json:Add(properties:LOOPING, audio:GetLooping())
            json:Add(properties:DOPPLER_ENABLED, audio:GetDoppler())
            json:Add(properties:PLAY_ON_LOAD, audio:GetPlayOnLoad())

            return json
        else
            JavaScriptObjectNotation json = parent:DefaultSceneManager:SaveItem3D(item)
            return json
        end
    end

    private action SaveItem2D(Item2D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        end

        return parent:DefaultSceneManager:SaveItem2D(item)
    end

    private action CreateItem3D(text type) returns Item3D
        if type = "Model"
            EditorModel model
            return model
        elseif type = "PointLight"
            EditorPointLight light
            return light
        elseif type = "SpotLight"
            EditorSpotLight spot
            return spot
        elseif type = "Terrain"
            EditorTerrain terrain
            terrain:SetSceneEditor(me)
            return terrain
        end

        return parent:DefaultSceneManager:CreateItem3D(type)
    end

    private action LoadItem3D(JavaScriptObjectNotation json) returns Item3D
        if json:GetValue(properties:CLASS) = "Audio3D"
            EditorAudio3D item
            item:LoadPlaceholderBox()

            text file = ""
            JavaScriptObjectNotation children = undefined
            number volume = 0
            number pitch = 0
            number maxDistance = 0
            number rolloffRate = 0
            boolean looping = false
            boolean doppler = true
            boolean playOnLoad = false

            Array<text> keys = json:GetKeys()

            integer counter = 0
            repeat while counter < keys:GetSize()
                text key = keys:Get(counter)
    
                if CustomLoadProperty3D(item, key, json)
                    // If we custom loaded this property, we don't do the normal processing for that key.
                elseif key = properties:NAME
                    item:SetName(json:GetValue(key))
                elseif key = properties:POSITION
                    Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                    item:SetPosition(position:Get(0), position:Get(1), position:Get(2))
                elseif key = properties:FILE
                    item:SetSource(json:GetValue(key))
                elseif key = properties:DESCRIPTION
                    item:SetDescription(json:GetValue(key))
                elseif key = properties:CHILDREN
                    children = json:GetObject(key)
                elseif key = properties:VOLUME
                    item:SetVolume(json:GetNumber(key))
                elseif key = properties:PITCH
                    item:SetPitch(json:GetNumber(key))
                elseif key = properties:MAX_VOLUME_DISTANCE
                    item:SetMaximumVolumeDistance(json:GetNumber(key))
                elseif key = properties:ROLLOFF_RATE
                    item:SetRolloffRate(json:GetNumber(key))
                elseif key = properties:LOOPING
                    item:SetLooping(json:GetBoolean(key))
                elseif key = properties:DOPPLER_ENABLED
                    item:SetDoppler(json:GetBoolean(key))
                elseif key = properties:PLAY_ON_LOAD
                    item:SetPlayOnLoad(json:GetBoolean(key))
                end
    
                counter = counter + 1
            end

            return item
        else
            return parent:DefaultSceneManager:LoadItem3D(json)
        end
    end

    /*
    This action can be used to determine what working directory
    to use for file loading. This can be used to open model resources that
    exist in a different project, for example.
    */
    private action ConvertToProjectFile(text path) returns File
        File file
        file:SetWorkingDirectory(projectLocation:GetAbsolutePath())
        file:SetPath(path)
        return file
    end

    private action CustomLoadProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        elseif key = properties:CONTROLLER
            // Kept with the model for the Controller section and saving;
            // the editor never builds it.
            JavaScriptObjectNotation block = json:GetObject(key)
            if block not= undefined
                item:SetProperty(properties:CONTROLLER, CopyControllerBlock(block))
            end
            return true
        elseif key = constants:EULER_ANGLES
            
        end

        return false
    end

    private action CustomSaveProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:CLASS
            if item is EditorPointLight
                json:Add(key, "PointLight")
                return true
            elseif item is EditorSpotLight
                json:Add(key, "SpotLight")
                return true
            else
                return false
            end
        elseif key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        elseif key = constants:EULER_ANGLES
            if not (item is EditorModel)
                return false
            end
            EditorModel model = cast(EditorModel, item)

            JavaScriptObjectNotation angles
            angles:SetArray()
            angles:Add(model:GetYaw())
            angles:Add(model:GetPitch())
            angles:Add(model:GetRoll())
    
            json:Add(key, angles)
            return true
        end
        return false
    end

    private action CustomLoadProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        end

        return false
    end

    private action CustomSaveProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true

            // If physics is enabled but no responsiveness was selected, use the default responsiveness value (0 = UNMOVABLE).
            elseif item:HasProperty(properties:PHYSICS_ENABLED)
                json:Add(key, 0)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        end
        return false
    end

action HideLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:RemoveLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

    action ShowLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:AddLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

end