use Libraries.Interface.Undo.SceneEditorTerrainMaterialEdit
use Libraries.Interface.Undo.SceneEditorMaterialEdit
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainMaterialsPropertiesDialog
use Libraries.Game.Graphics.Worlds.TerrainMaterial
use Libraries.Game.Graphics.Worlds.TerrainData
use Libraries.Game.BoundingBox
