    end

    /*
        Shows or hides the preview of what the game camera sees, in the corner of a 3D scene.
    */
    action ToggleGamePreview
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            NotifyAccessibility(me, "The game camera preview is only available in 3D scenes")
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        boolean showing = not layer3D:IsGamePreviewShowing()
        layer3D:SetGamePreviewShowing(showing)
        if showing
            NotifyAccessibility(me, "Game camera preview on")
        else
            NotifyAccessibility(me, "Game camera preview off")
        end
    end

    /*
        Moves the editor camera to the next perspective: origin, then horizon, then top-down, then
        back to origin.
    */
    action NextCameraPerspective
        SetCameraPerspective((cameraPerspective + 1) mod 3)
    end

    /*
        Moves the editor camera to one of the perspectives. The game camera is not changed.

        The origin perspective is the editor's starting view: looking at the origin from above at a
        45 degree angle. The horizon perspective is level with the ground, and the top-down perspective
        looks straight down. Those two keep looking at the same point and facing the same way, and only
        tilt the camera.

        While a perspective is on, the arrow keys move the camera along the ground, relative to the way
        it faces, and Escape puts the camera and focus back the way they were before.

        Attribute: Parameter perspective ORIGIN_PERSPECTIVE, HORIZON_PERSPECTIVE, or TOP_DOWN_PERSPECTIVE.
    */
    action SetCameraPerspective(integer perspective)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            NotifyAccessibility(me, "Camera perspectives are only available in 3D scenes")
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()

        if not inCameraPerspective
            // Remember the camera and focus, so Escape can put them back.
            savedCameraTarget = camera:GetTarget()
            savedCameraDistance = camera:GetDistance()
            savedCameraYaw = camera:GetYaw()
            savedCameraPitch = camera:GetPitch()
            savedCameraRoll = camera:GetRoll()
            savedCameraPosition:Set(camera:GetPosition())
            // Only focus inside the scene editor is put back. From a menu, Escape focuses the editor.
            savedFocus = undefined
            Item focus = manager:GetFocus()
            if focus is EditorItem or IsFocused()
                savedFocus = focus
            end

            perspectiveCameraItem = undefined
            EditorItem selected = GetSelectedItem()
            if selected is CameraItem3D
                perspectiveCameraItem = cast(CameraItem3D, selected)
            end

            // The camera keeps looking at the same point, or the origin if it had no target.
            if savedCameraTarget not= undefined
                perspectiveCenter:SetPosition(savedCameraTarget:GetGlobalX(), savedCameraTarget:GetGlobalY(), savedCameraTarget:GetGlobalZ())
            else
                perspectiveCenter:SetPosition(0, 0, 0)
            end
            inCameraPerspective = true
        end

        number yaw = camera:GetYaw()
        number pitch = 0
        text name = "Horizon view"
        if perspective = ORIGIN_PERSPECTIVE
            perspectiveCenter:SetPosition(0, 0, 0)
            camera:SetDistance(10)
            yaw = 0
            pitch = 45
            name = "Origin view"
        elseif perspective = TOP_DOWN_PERSPECTIVE
            pitch = 90
            name = "Top-down view"
        end

        camera:SetTarget(perspectiveCenter)
        camera:SetRotation(yaw, pitch, 0)
        SyncPerspectiveCameraItem(camera)
        cameraPerspective = perspective
        perspectivePanX = 0
        perspectivePanZ = 0

        if perspectiveItem = undefined
            CameraPerspectiveItem item
            item:SetSceneEditor(me)
            item:SetProperty(constants:EDITOR_TAG, undefined)
            Add(item)
            perspectiveItem = item
        end

        perspectiveItem:SetName(name)
        perspectiveItem:SetDescription("Camera perspective. Arrow keys move the camera. Plus and minus zoom in and out. Escape returns to the previous view.")
        if perspectiveItem:IsFocused()
            NotifyAccessibility(perspectiveItem, name)
        else
            // Focusing the item announces its name and description.
            perspectiveItem:Focus()
        end
    end

    /*
        Returns true while a camera perspective is on.
    */
    action IsInCameraPerspective returns boolean
        return inCameraPerspective
    end

    /*
        Sets which way the camera moves along the ground while a perspective is on. Each value is -1, 0,
        or 1. X moves left and right, and Z moves forward and back, relative to the way the camera faces.
    */
    action SetCameraPerspectivePan(integer x, integer z)
        if not inCameraPerspective
            return now
        end

        boolean wasMoving = perspectivePanX not= 0 or perspectivePanZ not= 0
        perspectivePanX = x
        perspectivePanZ = z

        // When the camera stops, say where it is looking.
        if wasMoving and x = 0 and z = 0 and perspectiveItem not= undefined
            number centerX = math:Round(perspectiveCenter:GetGlobalX(), 1)
            number centerZ = math:Round(perspectiveCenter:GetGlobalZ(), 1)
            NotifyAccessibility(perspectiveItem, "Looking at " + centerX + ", " + centerZ)
        end
    end

    /*
        Starts or stops zooming while a perspective is on: 1 zooms in, -1 zooms out, and 0 stops.
        Zooming moves the camera closer to or farther from the point it looks at.
    */
    action SetCameraPerspectiveZoom(integer direction)
        if not inCameraPerspective
            return now
        end

        boolean wasZooming = perspectiveZoom not= 0
        perspectiveZoom = direction

        // When zooming stops, say how far away the camera is.
        if wasZooming and direction = 0 and perspectiveItem not= undefined
            EditorLayer layer = GetSelectedLayer()
            if layer is EditorLayer3D
                EditorLayer3D layer3D = cast(EditorLayer3D, layer)
                number distance = math:Round(layer3D:GetEditorCamera():GetDistance(), 1)
                NotifyAccessibility(perspectiveItem, "Distance " + distance)
            end
        end
    end

    /*
        Changes the camera's distance while a zoom key is held. The distance changes by the same share
        each second, so zooming feels the same up close and far away.
    */
    private action ZoomCameraPerspective(number seconds)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()

        number distance = camera:GetDistance()
        if perspectiveZoom > 0
            distance = distance / (1 + 1.5 * seconds)
        else
            distance = distance * (1 + 1.5 * seconds)
        end

        if distance < 1
            distance = 1
        elseif distance > 1000
            distance = 1000
        end

        camera:SetDistance(distance)
        SyncPerspectiveCameraItem(camera)
    end

    action GetCameraPerspectivePanX returns integer
        return perspectivePanX
    end

    action GetCameraPerspectivePanZ returns integer
        return perspectivePanZ
    end

    /*
        Leaves the camera perspective and puts the camera and focus back the way they were before it.
    */
    action ExitCameraPerspective
        if not inCameraPerspective
            return now
        end

        inCameraPerspective = false
        perspectivePanX = 0
        perspectivePanZ = 0
        perspectiveZoom = 0
        cameraPerspective = -1

        EditorLayer layer = GetSelectedLayer()
        if layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            EditorCamera3D camera = layer3D:GetEditorCamera()
            camera:SetTarget(savedCameraTarget)
            camera:SetDistance(savedCameraDistance)
            camera:SetRotation(savedCameraYaw, savedCameraPitch, savedCameraRoll)
            if savedCameraTarget = undefined
                camera:SetPosition(savedCameraPosition:GetX(), savedCameraPosition:GetY(), savedCameraPosition:GetZ())
            end
            SyncPerspectiveCameraItem(camera)
        end

        if savedFocus not= undefined
            savedFocus:Focus()
        else
            Focus()
        end
        AnnounceAfterFocus("Left camera perspective")
    end

    /*
        Called when focus leaves the perspective some other way than Escape, such as a click. The camera
        stays where it is, and the perspective is over.
    */
    action CameraPerspectiveLostFocus
        if not inCameraPerspective
            return now
        end
        inCameraPerspective = false
        perspectivePanX = 0
        perspectivePanZ = 0
        perspectiveZoom = 0
        cameraPerspective = -1
    end

    /*
        Moves the camera's center point along the ground while an arrow key is held in a perspective.
        Forward is the way the camera faces, flattened onto the ground, so in the top-down perspective
        it is up on the screen. The speed grows with the camera's distance, so far views move faster.
    */
    private action PanCameraPerspective(number seconds)
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            return now
        end
        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        EditorCamera3D camera = layer3D:GetEditorCamera()

        number yaw = math:DegreesToRadians(camera:GetYaw())
        number forwardX = math:Sine(yaw)
        number forwardZ = math:Cosine(yaw)
        number rightX = math:Cosine(yaw)
        number rightZ = -math:Sine(yaw)

        number distance = camera:GetDistance()
        if distance < 1
            distance = 1
        end
        number step = distance * seconds

        number moveX = (rightX * perspectivePanX + forwardX * perspectivePanZ) * step
        number moveZ = (rightZ * perspectivePanX + forwardZ * perspectivePanZ) * step
        perspectiveCenter:SetPosition(perspectiveCenter:GetGlobalX() + moveX, perspectiveCenter:GetGlobalY(), perspectiveCenter:GetGlobalZ() + moveZ)

        camera:UpdateCameraPosition()
        SyncPerspectiveCameraItem(camera)
    end

    /*
        If the camera's item was selected when the perspective started, keeps it where the camera is.
    */
    private action SyncPerspectiveCameraItem(EditorCamera3D camera)
        if perspectiveCameraItem not= undefined
            perspectiveCameraItem:SetPosition(camera:GetPosition())
        end
    end

    /*
        Sends a message to screen readers after the current focus change has been announced. Quorum
        announces focus changes on the next frame, and screen readers replace a message with any
        announcement that comes right after it, so a message sent right away would not be heard.
    */
    private action AnnounceAfterFocus(text message)
        pendingAnnouncement = message
        pendingAnnouncementDelay = 0.3
    end

    /*
        Moves the game camera preview to the next corner of the editor, going clockwise. If the
        preview is hidden, it is shown, so the move can be seen.
    */
    action MoveGamePreview
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            NotifyAccessibility(me, "The game camera preview is only available in 3D scenes")
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        layer3D:MoveGamePreviewToNextCorner()
        layer3D:SetGamePreviewShowing(true)
        NotifyAccessibility(me, "Game camera preview moved to the " + layer3D:GetGamePreviewCornerName())
    end

    /*
        Sets the game camera, which the scene starts with when it runs, to the current editor view.
    */
    action SetGameCameraToCurrentView
        EditorLayer layer = GetSelectedLayer()
        if not (layer is EditorLayer3D)
            NotifyAccessibility(me, "The game camera can only be set in 3D scenes")
            return now
        end

        EditorLayer3D layer3D = cast(EditorLayer3D, layer)
        layer3D:SetGameCameraToEditorView()
        NotifyAccessibility(me, "Game camera set to the current view")
    end

    action NotifyAccessibility(Item item, text message)
        if accessibility not= undefined
            accessibility:Notify(item, message)
        end
    end

    action SetGridSnapping(boolean enabled)
        EditorLayer layer = GetSelectedLayer()

        if layer:IsGridSnapping() = enabled
            return now
        end

        layer:SetGridSnapping(enabled)

        if enabled
            NotifyAccessibility(me, "Grid snapping enabled")
        else
            NotifyAccessibility(me, "Grid snapping disabled")
        end
    end

    action SetGridUnitSize(number units)
        EditorLayer layer = GetSelectedLayer()
        layer:SetGridUnitSize(units)
        
        NotifyAccessibility(me, "Grid size " + units)
    end

    action GetGridUnitSize returns number
        EditorLayer layer = GetSelectedLayer()
        return layer:GetGridUnitSize()
    end

    action IsGridSnapping returns boolean
        EditorLayer layer = GetSelectedLayer()
        return layer:IsGridSnapping()
    end

    private action IsGridCoordinate(number value) returns boolean
        return GetSelectedLayer():IsGridCoordinate(value)
    end

    action SetSelectedItem(EditorItem item)
        selection:SetSelection(item)
    end

    action SetSelectedLayer(EditorLayer layer)
        if layer = selection:GetSelectedLayer()
            return now
        end

        EmptyFilteredItems(false)

        selection:SetSelection(layer, undefined)
    end

    action SetSelection(EditorLayer layer, EditorItem item)
        if layer = selection:GetSelectedLayer() and item = selection:GetSelectedItem()
            return now
        end

        EmptyFilteredItems(false)
        selection:SetSelection(layer, item)
    end

    action GetSelectedItem returns EditorItem
        return selection:GetSelectedItem()
    end

    action GetSelectedLayer returns EditorLayer
        return selection:GetSelectedLayer()
    end

    action GetCursor returns EditorCursor
        EditorLayer layer = GetSelectedLayer()
        if layer = undefined
            return undefined
        end

        return layer:GetCursor()
    end

    action GetSceneLayers returns Array<EditorLayer>
        return layers
    end

    action GainedFocus(FocusEvent event)
        SetSelectedItem(undefined)
        UpdateCursorVisibility()

        if accessibility not= undefined
            // Update the description for the controller in accessibility.
            accessibility:DescriptionChanged(me)
        end
        parent:Control:GainedFocus(event)
    end

    action LostFocus(FocusEvent event)
        Item item = event:GetNewFocus()
        integer value = dummyItem:GetHashCode()
        boolean goingToDummy = false
        if item not= undefined
            integer value1 = item:GetHashCode()
            goingToDummy = (value1 = value)
        end
        EditorLayer layer = GetSelectedLayer()
        if layer not= undefined and not goingToDummy
            layer:ShowCursor(false)
        end
        parent:Control:LostFocus(event)
    end

    /*
    If the given Item has a corresponding SelectionHighlight, this action
    will return the highlight. Otherwise, it will return undefined.
    */
    action GetSelectionHighlight(Item item) returns SelectionHighlight
        integer i = 0
        repeat while i < filterHighlights:GetSize()
            SelectionHighlight highlight = filterHighlights:Get(i)
            if highlight:GetItem() = item
                return highlight
            end
            i = i + 1
        end

        return undefined
    end

    /*
    This action sets the cursor to either be visible or hidden, as is appropriate
    based on the current editor context. For example, if a layer is active and no
    items are selected, it will show the cursor, or hide it if there are already
    selected items.

    This is called automatically by the SceneEditorSelection when the selection
    changes.
    */
    action UpdateCursorVisibility
        EditorLayer layer = selection:GetSelectedLayer()
        if layer = undefined
            return now
        end

        // If an item is selected, hide the cursor. Otherwise, show it.
        layer:ShowCursor(selection:GetSelectedItem() = undefined)
    end

    action GetNameCount(text name) returns integer
        if nameCounts:HasKey(name)
            return nameCounts:GetValue(name)
        end
        return 0
    end

    action IncrementNameCount(text name)
        nameCounts:Set(name, GetNameCount(name) + 1)
    end

    action GetNextNamePostfix(text name) returns text
        integer count = GetNameCount(name)
        if count = 0
            return ""
        end

        return " " + count
    end


    action AddSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Add(listener)
    end

    action RemoveSceneEditorChangeListener(SceneEditorChangeListener listener)
        sceneEditorChangeListeners:Remove(listener)
    end

    private action NotifySceneEditorChangeListeners(SceneEditorChangeEvent event)
        integer i = 0
        repeat while i < sceneEditorChangeListeners:GetSize()
            if event:GetEventType() = event:ADDED
                sceneEditorChangeListeners:Get(i):SceneAddedItem(event)
            else
                sceneEditorChangeListeners:Get(i):SceneRemovedItem(event)
            end
            i = i + 1
        end
    end

/* 
    Overrides the action in DefaultSceneManager. Used to determine which layers
    should be used to match the layers described in the Scene.

    We always make new layers which are stored as part of the VisualSceneController.
    */
    private action SelectLayer(JavaScriptObjectNotation layerJson) returns Layer

        text name = layerJson:GetValue(properties:NAME)
        text classValue = layerJson:GetValue(properties:CLASS)
        EditorLayer current = undefined

        if classValue = "Layer3D"
            EditorLayer3D layer
            current = layer
        elseif classValue = "Layer2D"
            EditorLayer2D layer
            current = layer
        end

        current:SetName(name)
        AddLayer(current)

        return current
    end

    /*
    This action can be used to override a portion of the default camera loading.
    */
    private action CustomLoadCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE        
                Number32BitArray size = ConvertToNumber32BitArray(json:GetObject(key))
                layer2D:SetCameraPreviewSize(size:Get(0), size:Get(1))
                return true
            elseif key = "EDITOR_" + properties:POSITION
                Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                camera:SetPosition(position:Get(0), position:Get(1), camera:GetPosition():GetZ())
                return true
            elseif key = "EDITOR_" + properties:ZOOM
                camera:SetZoom(json:GetNumber(key))
                return true
            end
        elseif layer is EditorLayer3D
            return LoadCamera3DProperty(cast(EditorLayer3D, layer), camera, key, json)
        end

        return false
    end

    /*
        Loads one camera value for a 3D layer. The plain values belong to the game camera, and the
        values starting with "EDITOR_" belong to the editor camera. Scenes saved before the two
        cameras were separate only have the plain values, so the editor camera starts there too.
    */
    private action LoadCamera3DProperty(EditorLayer3D layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        text prefix = "EDITOR_"
        if key:StartsWith(prefix)
            text property = key:GetSubtext(prefix:GetSize())
            if IsSeparateCameraProperty(property)
                ApplyCameraProperty(camera, property, key, json)
                return true
            end
            return false
        end

        if not IsSeparateCameraProperty(key)
            return false
        end

        ApplyCameraProperty(layer:GetGameCamera(), key, key, json)
        if not json:HasValue(prefix + key)
            ApplyCameraProperty(camera, key, key, json)
        end
        return true
    end

    /*
        Returns true for the camera values that the game camera and editor camera each have their
        own copy of in a 3D scene.
    */
    private action IsSeparateCameraProperty(text property) returns boolean
        return property = properties:POSITION or property = properties:DIRECTION or property = properties:UP or
            property = properties:FIELD_OF_VIEW or property = properties:NEAR or property = properties:FAR
    end

    private action ApplyCameraProperty(Camera camera, text property, text key, JavaScriptObjectNotation json)
        if property = properties:POSITION
            Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
            camera:SetPosition(position:Get(0), position:Get(1), position:Get(2))
        elseif property = properties:DIRECTION
            Number32BitArray direction = ConvertToNumber32BitArray(json:GetObject(key))
            camera:SetDirection(direction:Get(0), direction:Get(1), direction:Get(2))
        elseif property = properties:UP
            Number32BitArray up = ConvertToNumber32BitArray(json:GetObject(key))
            camera:SetUp(up:Get(0), up:Get(1), up:Get(2))
        elseif property = properties:NEAR
            camera:SetNear(json:GetNumber(key))
        elseif property = properties:FAR
            camera:SetFar(json:GetNumber(key))
        elseif property = properties:FIELD_OF_VIEW and camera is PerspectiveCamera
            PerspectiveCamera perspective = cast(PerspectiveCamera, camera)
            perspective:SetFieldOfView(json:GetNumber(key))
        end
    end

    private action CustomSaveCameraProperty(Layer layer, Camera camera, text key, JavaScriptObjectNotation json) returns boolean
        if layer is EditorLayer2D
            EditorLayer2D layer2D = cast(EditorLayer2D, layer)
            if key = properties:SIZE
                json:Add(properties:SIZE, NewJsonArray(layer2D:GetCameraPreviewWidth(), layer2D:GetCameraPreviewHeight()))
                return true
            elseif key = properties:POSITION
                CameraPreview2D preview = layer2D:GetCameraPreview()
                number x = preview:GetX() + preview:GetWidth() / 2.0
                number y = preview:GetY() + preview:GetHeight() / 2.0
                json:Add(properties:POSITION, NewJsonArray(x, y, camera:GetPosition():GetZ()))

                json:Add("EDITOR_" + properties:POSITION, NewJsonArray(camera:GetPosition():GetX(), camera:GetPosition():GetY()))

                return true
            elseif key = properties:ZOOM
                json:Add(properties:ZOOM, 1.0)

                json:Add("EDITOR_" + properties:ZOOM, camera:GetZoom())

                return true
            end
        elseif layer is EditorLayer3D
            EditorLayer3D layer3D = cast(EditorLayer3D, layer)
            if IsSeparateCameraProperty(key)
                SaveCameraProperty(layer3D:GetGameCamera(), key, key, json)
                SaveCameraProperty(camera, key, "EDITOR_" + key, json)
                return true
            end
        end

        return false
    end

    private action SaveCameraProperty(Camera camera, text property, text key, JavaScriptObjectNotation json)
        if property = properties:POSITION
            Vector3 vector = camera:GetPosition()
            json:Add(key, NewJsonArray(vector:GetX(), vector:GetY(), vector:GetZ()))
        elseif property = properties:DIRECTION
            Vector3 vector = camera:GetDirection()
            json:Add(key, NewJsonArray(vector:GetX(), vector:GetY(), vector:GetZ()))
        elseif property = properties:UP
            Vector3 vector = camera:GetUp()
            json:Add(key, NewJsonArray(vector:GetX(), vector:GetY(), vector:GetZ()))
        elseif property = properties:NEAR
            json:Add(key, camera:GetNear())
        elseif property = properties:FAR
            json:Add(key, camera:GetFar())
        elseif property = properties:FIELD_OF_VIEW and camera is PerspectiveCamera
            PerspectiveCamera perspective = cast(PerspectiveCamera, camera)
            json:Add(key, perspective:GetFieldOfView())
        end
    end

    action Save
        Array<EditorLayer> layers = GetSceneLayers()
        Scene scene = Save(layers)
        scene:GetData():SetPrettyPrint(true)
        file:Write(scene:GetData():ToText())
    end

    // We override the particular save item calls to ignore items with the editor tag.
    private action SaveItem3D(Item3D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        elseif item is EditorAudio3D
            JavaScriptObjectNotation json

            json:Add(properties:CLASS, "Audio3D")

            json:Add(properties:NAME, item:GetName())
            json:Add(properties:DESCRIPTION, item:GetDescription())
            json:Add(properties:POSITION, NewJsonArray(item:GetX(), item:GetY(), item:GetZ()))
            json:Add(properties:SIZE, NewJsonArray(item:GetWidth(), item:GetHeight(), item:GetDepth()))
    
            EditorAudio3D audio = cast(EditorAudio3D, item)
            json:Add(properties:FILE, audio:GetSource())
            json:Add(properties:VOLUME, audio:GetVolume())
            json:Add(properties:PITCH, audio:GetPitch())
            json:Add(properties:MAX_VOLUME_DISTANCE, audio:GetMaximumVolumeDistance())
            json:Add(properties:ROLLOFF_RATE, audio:GetRolloffRate())
            json:Add(properties:LOOPING, audio:GetLooping())
            json:Add(properties:DOPPLER_ENABLED, audio:GetDoppler())
            json:Add(properties:PLAY_ON_LOAD, audio:GetPlayOnLoad())

            return json
        else
            JavaScriptObjectNotation json = parent:DefaultSceneManager:SaveItem3D(item)
            return json
        end
    end

    private action SaveItem2D(Item2D item) returns JavaScriptObjectNotation
        SceneConstants constants

        if item:HasProperty(constants:EDITOR_TAG)
            return undefined
        end

        return parent:DefaultSceneManager:SaveItem2D(item)
    end

    private action CreateItem3D(text type) returns Item3D
        if type = "Model"
            EditorModel model
            return model
        elseif type = "PointLight"
            EditorPointLight light
            return light
        end

        return parent:DefaultSceneManager:CreateItem3D(type)
    end

    private action LoadItem3D(JavaScriptObjectNotation json) returns Item3D
        if json:GetValue(properties:CLASS) = "Audio3D"
            EditorAudio3D item
            item:LoadPlaceholderBox()

            text file = ""
            JavaScriptObjectNotation children = undefined
            number volume = 0
            number pitch = 0
            number maxDistance = 0
            number rolloffRate = 0
            boolean looping = false
            boolean doppler = true
            boolean playOnLoad = false

            Array<text> keys = json:GetKeys()

            integer counter = 0
            repeat while counter < keys:GetSize()
                text key = keys:Get(counter)
    
                if CustomLoadProperty3D(item, key, json)
                    // If we custom loaded this property, we don't do the normal processing for that key.
                elseif key = properties:NAME
                    item:SetName(json:GetValue(key))
                elseif key = properties:POSITION
                    Number32BitArray position = ConvertToNumber32BitArray(json:GetObject(key))
                    item:SetPosition(position:Get(0), position:Get(1), position:Get(2))
                elseif key = properties:FILE
                    item:SetSource(json:GetValue(key))
                elseif key = properties:DESCRIPTION
                    item:SetDescription(json:GetValue(key))
                elseif key = properties:CHILDREN
                    children = json:GetObject(key)
                elseif key = properties:VOLUME
                    item:SetVolume(json:GetNumber(key))
                elseif key = properties:PITCH
                    item:SetPitch(json:GetNumber(key))
                elseif key = properties:MAX_VOLUME_DISTANCE
                    item:SetMaximumVolumeDistance(json:GetNumber(key))
                elseif key = properties:ROLLOFF_RATE
                    item:SetRolloffRate(json:GetNumber(key))
                elseif key = properties:LOOPING
                    item:SetLooping(json:GetBoolean(key))
                elseif key = properties:DOPPLER_ENABLED
                    item:SetDoppler(json:GetBoolean(key))
                elseif key = properties:PLAY_ON_LOAD
                    item:SetPlayOnLoad(json:GetBoolean(key))
                end
    
                counter = counter + 1
            end

            return item
        else
            return parent:DefaultSceneManager:LoadItem3D(json)
        end
    end

    /*
    This action can be used to determine what working directory
    to use for file loading. This can be used to open model resources that
    exist in a different project, for example.
    */
    private action ConvertToProjectFile(text path) returns File
        File file
        file:SetWorkingDirectory(projectLocation:GetAbsolutePath())
        file:SetPath(path)
        return file
    end

    private action CustomLoadProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        elseif key = constants:EULER_ANGLES
            
        end

        return false
    end

    private action CustomSaveProperty3D(Item3D item, text key, JavaScriptObjectNotation json) returns boolean
        SceneConstants constants
        if key = properties:CLASS
            if item is EditorPointLight
                json:Add(key, "PointLight")
                return true
            else
                return false
            end
        elseif key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        elseif key = constants:EULER_ANGLES
            if not (item is EditorModel)
                return false
            end
            EditorModel model = cast(EditorModel, item)

            JavaScriptObjectNotation angles
            angles:SetArray()
            angles:Add(model:GetYaw())
            angles:Add(model:GetPitch())
            angles:Add(model:GetRoll())
    
            json:Add(key, angles)
            return true
        end
        return false
    end

    private action CustomLoadProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            JavaScriptObjectNotation newJson
            boolean value = json:GetBoolean(key)
            newJson:SetBoolean(value)
            item:SetProperty(properties:PHYSICS_ENABLED, newJson)
            return true
        elseif key = properties:RESPONSIVENESS
            check
                integer value = json:GetInteger(key)
                JavaScriptObjectNotation newJson
                newJson:SetInteger(value)
                item:SetProperty(properties:RESPONSIVENESS, newJson)
                return true
            detect e is Error
                // An error occurs if there was no RESPONSIVENESS value to get. In that case we return silently.
                return false
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            check
                number value = json:GetNumber(key)
                JavaScriptObjectNotation newJson
                newJson:SetNumber(value)
                item:SetProperty(key, newJson)
                return true
            detect e is Error
                // An error occurs if there was no value to get. In that case we return silently.
                return false
            end
        end

        return false
    end

    private action CustomSaveProperty2D(Item2D item, text key, JavaScriptObjectNotation json) returns boolean
        if key = properties:PHYSICS_ENABLED
            if item:HasProperty(key)
                boolean value = item:GetProperty(key):GetBoolean()
                json:Add(key, value)
                return true
            end
        elseif key = properties:RESPONSIVENESS
            if item:HasProperty(key)
                integer value = item:GetProperty(key):GetInteger()
                json:Add(key, value)
                return true

            // If physics is enabled but no responsiveness was selected, use the default responsiveness value (0 = UNMOVABLE).
            elseif item:HasProperty(properties:PHYSICS_ENABLED)
                json:Add(key, 0)
                return true
            end
        elseif key = properties:MASS or key = properties:FRICTION or key = properties:RESTITUTION
            if item:HasProperty(key)
                number value = item:GetProperty(key):GetNumber()
                json:Add(key, value)
                return true
            end
        end
        return false
    end

action HideLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:RemoveLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

    action ShowLayers
        Array<EditorLayer> layers = GetSceneLayers()
        integer counter = 0
        repeat while counter < layers:GetSize()
            Layer layer = layers:Get(counter)
            Game game = manager:GetGame()
            game:AddLayer(layer)
            counter = counter + 1
        end

        HideDialogs()
    end

end