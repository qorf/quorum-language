package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Interface.Events.SelectionListener
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Controls.Control
use Libraries.Containers.Array
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.ButtonRowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.PropertiesPanel
use Libraries.Interface.Controls.Scenes.PropertiesSectionItem
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem
use Libraries.Game.Graphics.Label
use Libraries.Interface.Item2D
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.ColorGroup

/*
    The PropertiesDialog class is a parent class for most dialogs in the Scene Editor library. 
    This dialog is not a control in itself that can be added to the editor. This class only 
    provides actions that allow other dialogs to inherit from and use. This class only provides 
    basic initialization and blueprint functions for setting fields and managing focus. 
*/
class PropertiesDialog is Dialog, SelectionListener, TextChangeListener

    boolean initialized = false
    SceneEditor editor = undefined

    // The control holding the dialog's fields, made by Initialize.
    Control content = undefined

    // The panel the dialog is docked in, or undefined for a floating
    // dialog (step 4).
    PropertiesPanel dock = undefined

    // The first and last fields in the dialog's Tab order, so a panel can
    // link one section's fields to the next (step 5).
    Control firstFocus = undefined
    Control lastFocus = undefined

    // The section's controls, under its header (step 15). Closing the
    // section takes the body out, leaving the header.
    Control body = undefined
    boolean bodyShown = true

    // The header, shown when the panel shows two or more sections: a tree
    // of one item, so it works and reads like the scene tree.
    Control headerRow = undefined
    Tree headerTree = undefined
    PropertiesSectionItem headerItem = undefined
    boolean collapsible = false
    boolean sectionOpen = true

    // The heading the dialog adds itself, if it tells us with SetHeading.
    // It is hidden while the header shows, so the name isn't there twice.
    Label heading = undefined

    on create
        SetInputGroup("PropertiesDialog")

        SetPixelWidth(300)
        SetVerticalLayoutMode(parent:Libraries.Interface.Controls.Control:FIT_CONTENTS)
    end

    /*
        Initializes the dialog by making the dialog a selection listener of the given SceneEditor. 
        This action also calls the CreateInterface action which makes and adds controls to the 
        dialog. This action also sets up focus targets for the array to ensure the user can move 
        focus when in the dialog. 
    */
    action Initialize(SceneEditor controller)
        if initialized
            return now
        end

        initialized = true

        // Used to set focus order at the end of this action.
        Array<Control> focusArray

        me:editor = controller
        controller:AddSelectionListener(me)

        ControlShaderView view
        view:Initialize()
        Color color
        
        Control panel
        FlowLayout propertiesLayout
        panel:SetLayout(propertiesLayout)
        panel:SetPercentageWidth(1.0)
        panel:SetVerticalLayoutMode(panel:FIT_CONTENTS)
        panel:SetBorderColor(color:Black())
        panel:SetBorderThickness(1)
        panel:SetView2D(view)

        // The dialog's controls go in a body under the header (step 15).
        // Hidden controls in it take no room, such as the heading while the
        // header shows.
        Control sectionBody
        body = sectionBody
        FlowLayout bodyLayout
        bodyLayout:SetIgnoreHidden(true)
        body:SetLayout(bodyLayout)
        body:SetPercentageWidth(1.0)
        body:SetVerticalLayoutMode(body:FIT_CONTENTS)
        panel:Add(body)

        // Generate the contents of the panel and the tab-path.
        // Implemented on a per-dialog basis.
        CreateInterface(body, focusArray)
        MakeHeader()

        // A docked dialog's fields go into its panel when it shows.
        content = panel
        if dock = undefined
            Add(panel)
        end

        // Set up focus targets.
        focusArray:Get(0):SetPreviousFocus(focusArray:Get(focusArray:GetSize() - 1))
        focusArray:Get(0):SetNextFocus(focusArray:Get(1))

        integer i = 1
        repeat while i < focusArray:GetSize()
            Control control = focusArray:Get(i)
            control:SetPreviousFocus(focusArray:Get(i - 1))
            control:SetNextFocus(focusArray:Get((i + 1) mod focusArray:GetSize()))
            i = i + 1
        end   

        firstFocus = focusArray:Get(0)
        lastFocus = focusArray:Get(focusArray:GetSize() - 1)
    end

    /*
        Makes the section's header: its title, in a tree of one item, with
        the tree's arrow. The panel puts it in when it shows two or more
        sections.
    */
    private action MakeHeader
        Control row
        headerRow = row
        FlowLayout rowLayout
        headerRow:SetLayout(rowLayout)
        headerRow:SetPercentageWidth(1.0)
        headerRow:SetVerticalLayoutMode(headerRow:FIT_CONTENTS)
        headerRow:SetLeftMargin(10)
        headerRow:SetTopMargin(4)
        headerRow:SetBottomMargin(4)

        Tree tree
        headerTree = tree
        headerTree:SetName(GetSectionTitle())
        PropertiesSectionItem item
        headerItem = item
        headerItem:SetName(GetSectionTitle())
        headerItem:SetFontSize(18)
        headerItem:SetDialog(me)
        // Added as a TreeItem, so the tree's own Add for tree items is the
        // one used, not Item2D's.
        TreeItem treeItem = headerItem
        headerTree:Add(treeItem)
        headerRow:Add(headerTree)
    end

    /*
        Tells the section which label is its heading, such as "Materials".
        Its text is the section's title, and it is hidden while the section
        has a header, so the title isn't shown twice. Call it from
        CreateInterface.

        Attribute: Parameter label The heading
    */
    action SetHeading(Label label)
        heading = label
    end

    /*
        Adds a card to a section: a title in the theme's section title color,
        then a rounded panel in its card color (as Forms draws a titled
        grouping), which the section adds its lines to. A title of "" adds
        only the card. Lines in a card use a left and right margin of 12.

        Attribute: Parameter panel Where the card goes, such as the body CreateInterface is given
        Attribute: Parameter title The card's title, or "" for none
        Attribute: Returns The card, to add lines to
    */
    action AddCard(Control panel, text title) returns Control
        if title not= ""
            panel:Add(MakeCardTitle(title))
        end
        Control card = MakeCard()
        panel:Add(card)
        return card
    end

    /*
        Makes a card's title: a small label in the theme's section title
        color. It isn't a focus stop; the card's first control is.

        Attribute: Parameter title The title
        Attribute: Returns The label
    */
    action MakeCardTitle(text title) returns Label
        Label cardTitle
        cardTitle:SetSize(14)
        cardTitle:SetText(title)
        cardTitle:SetLeftMargin(22)
        cardTitle:SetTopMargin(10)
        cardTitle:SetBottomMargin(2)
        GameStateManager gameState
        ColorGroup titleColor = gameState:GetInterfaceOptions():GetFontColor("SectionTitle")
        if titleColor not= undefined
            cardTitle:SetFontColor(titleColor)
        end
        return cardTitle
    end

    /*
        Makes an empty card: a rounded panel in the theme's card color
        (FormCard), as wide as the section less 20 on each side, as tall as
        its lines. Hidden lines in it take no room.

        Attribute: Returns The card
    */
    action MakeCard returns Control
        ControlShaderView view
        view:Initialize()
        Control card
        card:SetView2D(view)
        FlowLayout layout
        layout:SetIgnoreHidden(true)
        card:SetLayout(layout)
        card:SetPercentageWidth(1.0)
        card:SetVerticalLayoutMode(card:FIT_CONTENTS)
        card:SetLeftMargin(20)
        card:SetRightMargin(20)
        card:SetTopMargin(2)
        card:SetBottomMargin(4)
        card:SetCornerPixelRounding(8, 8, 8, 8)
        card:SetBorderThickness(0)
        GameStateManager gameState
        ColorGroup cardColor = gameState:GetInterfaceOptions():GetBackgroundColor("FormCard")
        if cardColor not= undefined
            card:SetBackgroundColor(cardColor)
        end
        return card
    end

    /*
        Makes a line for a card: as wide as the card, as tall as what is in
        it, with a margin of 12 at the sides and 4 above and below. Controls
        added to it go side by side, such as a label and its field, or a row
        of buttons.

        Attribute: Returns The line
    */
    action MakeCardLine returns Control
        FlowLayout layout
        Control line
        line:SetLayout(layout)
        line:SetPercentageWidth(1.0)
        line:SetVerticalLayoutMode(line:FIT_CONTENTS)
        line:SetLeftMargin(12)
        line:SetRightMargin(12)
        line:SetTopMargin(4)
        line:SetBottomMargin(4)
        return line
    end

    /*
        Makes a line of buttons for a card: side by side when they fit, or
        each on its own line, the card's width, when they don't
        (ButtonRowLayout). Its margins are MakeCardLine's.

        Attribute: Returns The line
    */
    action MakeButtonRow returns Control
        ButtonRowLayout layout
        Control line
        line:SetLayout(layout)
        line:SetPercentageWidth(1.0)
        line:SetVerticalLayoutMode(line:FIT_CONTENTS)
        line:SetLeftMargin(12)
        line:SetRightMargin(12)
        line:SetTopMargin(4)
        line:SetBottomMargin(4)
        return line
    end

    /*
        Adds a choice (such as a radio button) to a group in a cell half the
        group's width, so choices go two to a row in their columns. The
        choice keeps its own size in the cell; a radio button's layout needs
        the width of its contents.

        Attribute: Parameter group The group the choice goes in
        Attribute: Parameter choice The choice
    */
    action AddHalfWidth(Control group, Control choice)
        FlowLayout layout
        Control cell
        cell:SetLayout(layout)
        cell:SetPercentageWidth(0.5)
        cell:SetVerticalLayoutMode(cell:FIT_CONTENTS)
        cell:Add(choice)
        group:Add(cell)
    end

    /*
        Returns the section's title: its heading's text, or its name if it
        has no heading. The panel remembers closed sections by title.

        Attribute: Returns The title
    */
    action GetSectionTitle returns text
        if heading not= undefined
            return heading:GetText()
        end
        return GetName()
    end

    /*
        Gives the section a header that opens and closes it, or takes it
        away. The panel gives one to each section when it shows two or
        more. Without a header, the section is always open.

        Attribute: Parameter value True for a header
    */
    action SetCollapsible(boolean value)
        if content = undefined or value = collapsible
            return now
        end
        collapsible = value
        if collapsible
            content:Add(0, headerRow)
            if heading not= undefined
                heading:Hide()
            end
            headerItem:ShowOpen(sectionOpen)
            ShowBody(sectionOpen)
        else
            content:Remove(headerRow)
            if heading not= undefined
                heading:Show()
            end
            ShowBody(true)
        end
        LinkHeaderFocus()
    end

    /*
        Returns true if the section has a header that opens and closes it.

        Attribute: Returns True with a header
    */
    action IsCollapsible returns boolean
        return collapsible
    end

    /*
        Opens or closes the section, as its header does, and tells the panel,
        which remembers it.

        Attribute: Parameter open True to open
    */
    action SetOpen(boolean open)
        ApplyOpen(open)
        if headerItem not= undefined
            headerItem:ShowOpen(open)
        end
        if dock not= undefined
            dock:SectionOpenChanged(me)
        end
    end

    /*
        Opens or closes the section without telling the panel, such as when
        the panel shows a section the way it was saved.

        Attribute: Parameter open True to open
    */
    action ApplyOpen(boolean open)
        sectionOpen = open
        if headerItem not= undefined
            headerItem:ShowOpen(open)
        end
        if collapsible
            ShowBody(open)
        end
        LinkHeaderFocus()
    end

    /*
        Opens the section.
    */
    action Open
        SetOpen(true)
    end

    /*
        Closes the section.
    */
    action Close
        SetOpen(false)
    end

    /*
        Returns true if the section is open. A section without a header is
        always shown open.

        Attribute: Returns True if open
    */
    action IsOpen returns boolean
        return sectionOpen
    end

    /*
        Moves the focus to the section's header, if it has one.
    */
    action FocusHeader
        if collapsible
            headerTree:Focus()
        end
    end

    /*
        Moves the focus into the section: to its first field when it is
        open, or to its header when it is closed, so the focus never goes
        to a field that isn't in the panel.
    */
    action FocusSection
        if IsCollapsible() and not IsOpen()
            FocusHeader()
        else
            FocusField()
        end
    end

    /*
        Returns true if an item is the section's header, or inside it.

        Attribute: Parameter item The item
        Attribute: Returns True for the header
    */
    action IsHeader(Item2D item) returns boolean
        return item not= undefined and headerTree not= undefined and (item:Equals(headerTree) or item:Equals(headerItem))
    end

    /*
        Puts the body in, or takes it out.
    */
    private action ShowBody(boolean show)
        if show and not bodyShown
            content:Add(body)
            bodyShown = true
        elseif not show and bodyShown
            content:Remove(body)
            bodyShown = false
        end
    end

    /*
        Links the header to the section's first control while the section
        is open with a header. The panel links the header to the sections
        around it.
    */
    private action LinkHeaderFocus
        if collapsible and sectionOpen and firstFocus not= undefined
            headerTree:SetNextFocus(firstFocus)
            firstFocus:SetPreviousFocus(headerTree)
        end
    end

    /*
    This action should be used to place controls on the provided panel to make up the
    UI of the dialog. The panel is already set with a FlowLayout and a view. Each 
    item that is keyboard navigable should also be added to the focus array to create
    the ordered tab-through path.
    */
    private blueprint action CreateInterface(Control panel, Array<Control> focusArray)

    /*
        Returns the SceneEditor this dialog is a part of. This SceneEditor is also the object
        firing selection events that the dialog is listening to. 
    */
    action GetSceneEditor returns SceneEditor
        return editor
    end

    /*
        Positions the dialog in the bottom right corner of the editor and then 
        shows the dialog. 
    */
    action Show
        // Docked: the fields go into the panel, and nothing floats.
        if dock not= undefined
            dock:ShowDialog(me)
            return now
        end

        if editor not= undefined
            LayoutProperties properties = GetDefaultLayoutProperties()
            properties:SetPercentageX(0)
            properties:SetPercentageY(0)
            properties:SetPercentageOriginX(1)
            //properties:SetPercentageOriginY(1)
            properties:SetPixelX(editor:GetGlobalX() + editor:GetWidth() - 5)
//            properties:SetPixelY(controller:GetGlobalY() + controller:GetHeight())
            properties:SetPixelY(editor:GetGlobalY())

            /*
            // Alternate approach, meant to top-align the box, but currently bugged for some reason.

            LayoutProperties properties = GetDefaultLayoutProperties()
            properties:SetPercentageX(0)
            properties:SetPercentageY(0)
            properties:SetPercentageOriginX(1)
            properties:SetPercentageOriginY(1)
            properties:SetPixelX(controller:GetGlobalX() + controller:GetWidth() - 5)
            properties:SetPixelY(controller:GetGlobalY() + controller:GetHeight())
            //properties:SetPixelY(controller:GetGlobalY())
            */
        end
        parent:Dialog:Show()
    end

    /*
        Hides the dialog. A docked dialog's fields are taken out of its
        panel instead.
    */
    action Hide
        if dock not= undefined
            dock:HideDialog(me)
            return now
        end
        parent:Dialog:Hide()
    end

    /*
        Returns true if the dialog is showing. A docked dialog is showing
        while its fields are in its panel.

        Attribute: Returns True if the dialog, or its fields in the panel, are showing
    */
    action IsShowing returns boolean
        if dock not= undefined
            return dock:IsShowingDialog(me)
        end
        return parent:Dialog:IsShowing()
    end

    /*
        Docks the dialog in a PropertiesPanel. From then on, showing it
        puts its fields into the panel, and it never floats. A dialog is
        docked once, and stays docked.

        Attribute: Parameter panel The panel to dock in
    */
    action DockIn(PropertiesPanel panel)
        if dock not= undefined
            return now
        end
        if parent:Dialog:IsShowing()
            parent:Dialog:Hide()
        end
        if content not= undefined
            Remove(content)
        end
        dock = panel
        panel:AddDockedDialog(me)
    end

    /*
        Returns true if the dialog is docked in a PropertiesPanel.

        Attribute: Returns True if docked
    */
    action IsDocked returns boolean
        return dock not= undefined
    end

    /*
        Returns the control holding the dialog's fields.

        Attribute: Returns The fields' control, or undefined before Initialize
    */
    action GetContent returns Control
        return content
    end

    /*
        Sets the last field in the section's Tab order, for a section that
        shows and hides its own controls (step 16), and has the panel link
        it to the next section.

        Attribute: Parameter control The last field
    */
    action SetLastFocus(Control control)
        lastFocus = control
        if dock not= undefined
            dock:SectionLayoutChanged()
        end
    end

    /*
        Sets the first field in the section's Tab order, for a section that
        shows and hides its own controls, such as a line shown only when it
        has something to say. The header and the panel link to it.

        Attribute: Parameter control The first field
    */
    action SetFirstFocus(Control control)
        if firstFocus = control
            return now
        end
        firstFocus = control
        LinkHeaderFocus()
        if dock not= undefined
            dock:SectionLayoutChanged()
        end
    end

    /*
        Returns the first field in the dialog's Tab order: its header, when
        it has one (step 15).

        Attribute: Returns The first field, or undefined before Initialize
    */
    action GetFirstFocus returns Control
        if collapsible
            return headerTree
        end
        return firstFocus
    end

    /*
        Returns the last field in the dialog's Tab order: its header, when
        it is closed (step 15).

        Attribute: Returns The last field, or undefined before Initialize
    */
    action GetLastFocus returns Control
        if collapsible and not sectionOpen
            return headerTree
        end
        return lastFocus
    end

    /*
    Moves the focus to one of the fields in the properties dialog. By default
    this is the name field (the first field in the panel), but it could also be
    changed to a different field, possibly context sensitive.
    */
    blueprint action FocusField

    blueprint action SetFields(EditorItem item)
end