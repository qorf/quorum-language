package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Interface.Events.SelectionListener
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Controls.TextField
use Libraries.Containers.Array
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Game.Graphics.Label
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Selections.ButtonGroupSelection
use Libraries.Game.Graphics.PerspectiveCamera
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Interface.Controls.Scenes.Items.CameraItem3D
use Libraries.Interface.Controls.Scenes.Dialogs.PropertiesDialog
use Libraries.Interface.Controls.SliderField
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Compute.Vector3

/*
    The Camera3DPropertiesDialog class is a dialog that appears when selecting 
    a CameraItem3D. Like other properties dialogs this dialog has several fields 
    and buttons to adjust its properties.
*/
class Camera3DPropertiesDialog is PropertiesDialog

    // The sliders, and their number fields, which SliderTaken is called with.
    SliderField xSlider = undefined
    SliderField ySlider = undefined
    SliderField zSlider = undefined
    TextField xField = undefined
    TextField yField = undefined
    TextField zField = undefined
    SliderField nearSlider = undefined
    SliderField farSlider = undefined
    SliderField turnSlider = undefined
    SliderField tiltSlider = undefined
    SliderField fovSlider = undefined
    TextField nearField = undefined
    TextField farField = undefined
    TextField yawField = undefined
    TextField pitchField = undefined
    TextField fovField = undefined

    // The label column's width, before the interface scale.
    constant number FIELD_LABEL_WIDTH = 120
    // The tilt stops short of straight up and down, where the camera can't
    // tell which way is up and the view breaks.
    constant number MOST_PITCH = 89
    // The near and far sliders' ends. Both are logarithmic, since small
    // changes matter close up and large ones far away. The far end stays a
    // little beyond the near end, so something is always drawn.
    constant number LEAST_NEAR = 0.01
    constant number MOST_NEAR = 100
    constant number LEAST_FAR = 10
    constant number MOST_FAR = 100000
    constant number NEAR_FAR_GAP = 0.01
    // The position sliders' ends. A camera farther out still shows its
    // position in the field.
    constant number FARTHEST_POSITION = 2000

    /*
        Creates and adds all the controls this dialog needs. Each property
        is a slider with its number beside it, as in the other properties
        panels, the same for the editor's camera and the game camera. There's
        no Zoom: a 3D camera's zoom narrows the field of view
        without saying so, and isn't saved with the scene, so Field of View
        is the one lens setting, and the editor's zoom keys and mouse wheel
        move the camera closer.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Camera Properties")

        Label basicPropertiesLabel
        basicPropertiesLabel:SetSize(18)
        basicPropertiesLabel:SetText("Camera Properties")
        basicPropertiesLabel:SetLeftMargin(20)
        panel:Add(basicPropertiesLabel)
        // Its text is the section's title, under a header that opens and
        // closes it when the panel shows several sections.
        SetHeading(basicPropertiesLabel)

        // Where the camera is, together in one card.
        Control positionCard = AddCard(panel, "Position")
        xSlider = MakePositionSlider("X:", "Position X", "Where the camera is, left and right")
        xField = xSlider:GetField()
        positionCard:Add(xSlider)
        ChainControl(focusArray, xField)

        ySlider = MakePositionSlider("Y:", "Position Y", "Where the camera is, up and down")
        yField = ySlider:GetField()
        positionCard:Add(ySlider)
        ChainControl(focusArray, yField)

        zSlider = MakePositionSlider("Z:", "Position Z", "Where the camera is, forward and back")
        zField = zSlider:GetField()
        positionCard:Add(zSlider)
        ChainControl(focusArray, zField)


        // Which way the camera looks, and how wide.
        Control viewCard = AddCard(panel, "View")
        turnSlider = MakeSliderField("Turn:", "Turn", "How far the camera is turned left or right, in degrees", -180, 180, 1, 15, FIELD_LABEL_WIDTH)
        turnSlider:SetUnits("degrees")
        turnSlider:SetDecimalPlaces(1)
        yawField = turnSlider:GetField()
        viewCard:Add(turnSlider)
        ChainControl(focusArray, yawField)

        tiltSlider = MakeSliderField("Tilt:", "Tilt", "How far the camera is tilted down, in degrees. Negative tilts it up.", -MOST_PITCH, MOST_PITCH, 1, 15, FIELD_LABEL_WIDTH)
        tiltSlider:SetUnits("degrees")
        tiltSlider:SetDecimalPlaces(1)
        pitchField = tiltSlider:GetField()
        viewCard:Add(tiltSlider)
        ChainControl(focusArray, pitchField)

        fovSlider = MakeSliderField("Field of View:", "Field of View", "How wide the camera sees, in degrees", 10, 120, 1, 10, FIELD_LABEL_WIDTH)
        fovSlider:SetUnits("degrees")
        fovField = fovSlider:GetField()
        viewCard:Add(fovSlider)
        ChainControl(focusArray, fovField)

        // What's drawn: nothing closer than Near or farther than Far.
        Control rangeCard = AddCard(panel, "Drawing Range")
        nearSlider = MakeSliderField("Near:", "Near", "The closest the camera draws. Anything nearer isn't drawn.", LEAST_NEAR, MOST_NEAR, 0.01, 1, FIELD_LABEL_WIDTH)
        nearSlider:SetLogarithmic(true)
        nearSlider:SetDecimalPlaces(2)
        nearSlider:SetAllowsValuesBeyondRange(true)
        nearField = nearSlider:GetField()
        rangeCard:Add(nearSlider)
        ChainControl(focusArray, nearField)

        farSlider = MakeSliderField("Far:", "Far", "The farthest the camera draws. Anything farther isn't drawn.", LEAST_FAR, MOST_FAR, 10, 1000, FIELD_LABEL_WIDTH)
        farSlider:SetLogarithmic(true)
        farSlider:SetDecimalPlaces(0)
        farSlider:SetAllowsValuesBeyondRange(true)
        farField = farSlider:GetField()
        rangeCard:Add(farSlider)
        ChainControl(focusArray, farField)
    end

    /*
        This action Shows or Hides the dialog based on what gains selection. Only if a CameraItem3D is selected
        will this dialog show. If there is no selection or the selected item is not a CameraItem3D then the dialog
        will hide or stay hidden.
    */
    action SelectionChanged(SelectionEvent event)
        // TO-DO: Consider change to Layer in VisualEditorSelection
        if event:GetSelection() is SceneEditorSelection
            SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
            if selection:IsItemSelected() = false
                if IsShowing()
                    Hide()
                end
            else
                if selection:GetSelectedItem() is CameraItem3D
                    SetFields(cast(CameraItem3D, selection:GetSelectedItem()))
                    if not IsShowing()
                        Show()
                    end
                else
                    if IsShowing()
                        Hide()
                    end
                end
            end
        end
    end

    /*
        This action takes an EditorItem and sets the fields in the dialog based on its
        properties. If the item is not a CameraItem3D then the item is ignored.
    */
    action SetFields(EditorItem item)
        if item is CameraItem3D = false
            return now
        end

        SetFields(cast(CameraItem3D, item))
    end

    /*
        This action takes a CameraItem3D and sets the sliders from it. Setting
        a slider's value doesn't tell its listeners, so nothing is sent back
        to the camera.
    */
    action SetFields(CameraItem3D cameraItem)
        EditorCamera3D camera = cameraItem:GetEditorCamera()
        Vector3 position = camera:GetPosition()
        xSlider:SetValue(position:GetX())
        ySlider:SetValue(position:GetY())
        zSlider:SetValue(position:GetZ())
        turnSlider:SetValue(WrapTurn(cameraItem:GetYaw()))
        tiltSlider:SetValue(cameraItem:GetPitch())
        fovSlider:SetValue(camera:GetFieldOfView())
        nearSlider:SetValue(camera:GetNear())
        farSlider:SetValue(camera:GetFar())
    end

    private action MakePositionSlider(text label, text name, text description) returns SliderField
        SliderField slider = MakeSliderField(label, name, description, -FARTHEST_POSITION, FARTHEST_POSITION, 1, 50, FIELD_LABEL_WIDTH)
        slider:SetDecimalPlaces(1)
        slider:SetAllowsValuesBeyondRange(true)
        return slider
    end

    // A turn between -180 and 180 degrees, the slider's range.
    private action WrapTurn(number degrees) returns number
        number value = degrees
        repeat while value > 180
            value = value - 360
        end
        repeat while value < -180
            value = value + 360
        end
        return value
    end

    /*
        This action is called when a slider's value is final: the slider was
        let go or moved with the keys, or a number was typed and the focus
        left the field. Text that isn't a number is put back.

        Attribute: Parameter field The slider's number field.
    */
    action SliderTaken(TextField field)
        SceneEditor sceneEditor = GetSceneEditor()
        if sceneEditor = undefined
            return now
        end
        EditorItem selected = sceneEditor:GetSelectedItem()
        if not (selected is CameraItem3D)
            return now
        end
        CameraItem3D cameraItem = cast(CameraItem3D, selected)
        EditorCamera3D camera = cameraItem:GetEditorCamera()

        number value = 0
        check
            value = field:GetText():Trim():ParseNumber()
        detect e is Error
            SetFields(cameraItem)
            return now
        end

        if field:Equals(xField) or field:Equals(yField) or field:Equals(zField)
            Vector3 position = camera:GetPosition()
            number x = position:GetX()
            number y = position:GetY()
            number z = position:GetZ()
            if field:Equals(xField)
                x = value
            elseif field:Equals(yField)
                y = value
            else
                z = value
            end
            // Placed by hand, the camera stops following what it was
            // looking at, so it stays where it was put.
            camera:SetTarget(undefined)
            camera:SetPosition(x, y, z)
            camera:Update()
            cameraItem:SetPosition(x, y, z)
        elseif field:Equals(nearField)
            // Near stays above zero and short of Far.
            if value < LEAST_NEAR
                value = LEAST_NEAR
            end
            if value > camera:GetFar() - NEAR_FAR_GAP
                value = camera:GetFar() - NEAR_FAR_GAP
            end
            camera:SetNear(value)
            camera:Update()
        elseif field:Equals(farField)
            if value < camera:GetNear() + NEAR_FAR_GAP
                value = camera:GetNear() + NEAR_FAR_GAP
            end
            camera:SetFar(value)
            camera:Update()
        elseif field:Equals(yawField)
            if value not= cameraItem:GetYaw()
                cameraItem:SetYaw(value)
            end
        elseif field:Equals(pitchField)
            if value > MOST_PITCH
                value = MOST_PITCH
            elseif value < -MOST_PITCH
                value = -MOST_PITCH
            end
            if value not= cameraItem:GetPitch()
                cameraItem:SetPitch(value)
            end
        elseif field:Equals(fovField)
            if value > 0 and value not= camera:GetFieldOfView()
                camera:SetFieldOfView(value)
            end
        end
        // Turn and tilt move the camera, so its position shows anew, and a
        // near or far that was kept in range shows what was taken.
        SetFields(cameraItem)
    end

    /*
    Moves the focus to one of the fields in the properties dialog. By default
    this is the name field (the first field in the panel), but it could also be
    changed to a different field, possibly context sensitive.
    */
    action FocusField
        xField:Focus()
        xField:Select(0, xField:GetSize(), true)
    end

end