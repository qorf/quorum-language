package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Events.SelectionListener
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Selections.ButtonGroupSelection
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.RadioButton
use Libraries.Game.Graphics.OrthographicCamera
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer2D
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.Items.CameraItem2D
use Libraries.Interface.Controls.Scenes.Dialogs.PropertiesDialog
use Libraries.Interface.Controls.SliderField
use Libraries.Interface.Controls.Scenes.SceneEditor

/*
    The Camera2DPropertiesDialog class is a dialog that appears when selecting 
    a CameraItem2D. Like other properties dialogs this dialog has several fields 
    and buttons to adjust its properties. This dialog only has 3 properties to 
    edit so there are not as many controls on the dialog as others.
*/
class Camera2DPropertiesDialog is PropertiesDialog

    // The sliders, and their number fields, which SliderTaken is called with.
    SliderField positionXSlider = undefined
    SliderField positionYSlider = undefined
    SliderField zoomSlider = undefined
    TextField positionXField = undefined
    TextField positionYField = undefined
    TextField zoomField = undefined

    // The label column's width, before the interface scale.
    constant number FIELD_LABEL_WIDTH = 120
    // The position sliders' ends. A camera farther out still shows its
    // position in the field.
    constant number FARTHEST_POSITION = 5000

    /*
        Creates and adds all the controls this dialog needs. Each property
        is a slider with its number beside it, as in the other properties
        panels.
    */
    action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Camera Properties")

        Label basicPropertiesLabel
        basicPropertiesLabel:SetSize(18)
        basicPropertiesLabel:SetText("Camera Properties")
        basicPropertiesLabel:SetLeftMargin(20)
        panel:Add(basicPropertiesLabel)
        // Its text is the section's title, under a header that opens and
        // closes it when the panel shows several sections.
        SetHeading(basicPropertiesLabel)

        positionXSlider = MakeSliderField("X:", "Position X", "Where the camera is, left and right", -FARTHEST_POSITION, FARTHEST_POSITION, 1, 100, FIELD_LABEL_WIDTH)
        positionXSlider:SetDecimalPlaces(1)
        positionXSlider:SetAllowsValuesBeyondRange(true)
        positionXField = positionXSlider:GetField()
        panel:Add(positionXSlider)
        ChainControl(focusArray, positionXField)

        positionYSlider = MakeSliderField("Y:", "Position Y", "Where the camera is, up and down", -FARTHEST_POSITION, FARTHEST_POSITION, 1, 100, FIELD_LABEL_WIDTH)
        positionYSlider:SetDecimalPlaces(1)
        positionYSlider:SetAllowsValuesBeyondRange(true)
        positionYField = positionYSlider:GetField()
        panel:Add(positionYSlider)
        ChainControl(focusArray, positionYField)

        zoomSlider = MakeSliderField("Zoom:", "Zoom", "How far the camera is zoomed in. 1 shows the scene at its size; more is closer.", 0.1, 10, 0.1, 1, FIELD_LABEL_WIDTH)
        zoomSlider:SetDecimalPlaces(2)
        zoomField = zoomSlider:GetField()
        panel:Add(zoomSlider)
        ChainControl(focusArray, zoomField)
    end

    /*
        This action Shows or Hides the dialog based on what gains selection. Only if a CameraItem2D is selected
        will this dialog show. If there is no selection or the selected item is not a CameraItem2D then the dialog
        will hide or stay hidden.
    */
    action SelectionChanged(SelectionEvent event)
        // TO-DO: Consider change to Layer in VisualEditorSelection
        if event:GetSelection() is SceneEditorSelection
            SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
            if selection:IsItemSelected() = false
                if IsShowing()
                    Hide()
                end
            else
                if selection:GetSelectedItem() is CameraItem2D
                    SetFields(cast(CameraItem2D, selection:GetSelectedItem()))
                    if not IsShowing()
                        Show()
                    end
                else
                    if IsShowing()
                        Hide()
                    end
                end
            end
        elseif event:GetSelection() is ButtonGroupSelection
            ButtonGroupSelection selection = cast(ButtonGroupSelection, event:GetSelection())
            EditorItem item = GetSceneEditor():GetSelectedItem()
            if item not= undefined
                item:SetEditorResponsiveness(selection:GetIndex())
            end
        end
    end

    /*
        This action takes an EditorItem and sets the fields in the dialog based on its
        properties. If the item is not a CameraItem2D then the item is ignored.
    */
    action SetFields(EditorItem item)
        if item is CameraItem2D = false
            return now
        end

        SetFields(cast(CameraItem2D, item))
    end

    /*
        This action takes a CameraItem2D and sets the sliders from it. Setting
        a slider's value doesn't tell its listeners, so nothing is sent back
        to the camera.
    */
    action SetFields(CameraItem2D cameraItem)
        OrthographicCamera camera = cast(OrthographicCamera, cameraItem:GetCamera())
        positionXSlider:SetValue(camera:GetPosition():GetX())
        positionYSlider:SetValue(camera:GetPosition():GetY())
        zoomSlider:SetValue(camera:GetZoom())
    end

    /*
        This action is called when a slider's value is final: the slider was
        let go or moved with the keys, or a number was typed and the focus
        left the field. Text that isn't a number is put back.

        Attribute: Parameter field The slider's number field.
    */
    action SliderTaken(TextField field)
        SceneEditor sceneEditor = GetSceneEditor()
        if sceneEditor = undefined
            return now
        end
        EditorItem selected = sceneEditor:GetSelectedItem()
        if not (selected is CameraItem2D)
            return now
        end
        CameraItem2D cameraItem = cast(CameraItem2D, selected)
        OrthographicCamera camera = cast(OrthographicCamera, cameraItem:GetCamera())

        number value = 0
        check
            value = field:GetText():Trim():ParseNumber()
        detect e is Error
            SetFields(cameraItem)
            return now
        end

        if field:Equals(positionXField)
            if value not= cameraItem:GetX()
                cameraItem:SetX(value)
            end
        elseif field:Equals(positionYField)
            if value not= cameraItem:GetY()
                cameraItem:SetY(value)
            end
        elseif field:Equals(zoomField)
            if value > 0 and value not= camera:GetZoom()
                camera:SetZoom(value)
                if cameraItem:GetLayer() is EditorLayer2D
                    EditorLayer2D layer = cast(EditorLayer2D, cameraItem:GetLayer())
                    layer:UpdateGridSize()
                end
            end
        end
    end

    /*
    Moves the focus to one of the fields in the properties dialog. By default
    this is the name field (the first field in the panel), but it could also be
    changed to a different field, possibly context sensitive.
    */
    action FocusField
        positionXField:Focus()
        positionXField:Select(0, positionXField:GetSize(), true)
    end

end