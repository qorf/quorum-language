package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Checkbox
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Item
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TerrainWaterFieldListener
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.PropertiesFoldItem
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.Items.Highlights.TerrainSelectionHighlight
use Libraries.Interface.Behaviors.Scenes.Properties.TerrainWaterButtonBehavior
use Libraries.Game.Graphics.Worlds.TerrainWater
use Libraries.Game.Graphics.Worlds.TerrainLake
use Libraries.Game.Graphics.Worlds.TerrainRiver
use Libraries.Game.Graphics.Worlds.WaterShaderProgram

/*
    The TerrainWaterPropertiesDialog is a selected terrain's Water section
    (Water plan W6, River plan R6): its sea, its lakes, its rivers, and the
    water's look.

    Its parts fold, each with a chevron, as the Properties panel's sections
    do (PropertiesFoldItem): Sea, Lakes, each lake, Rivers, each river, New
    rivers and Look. Each part's title says what it holds, with numbers
    rounded for reading, such as "Lake 1, level 28.8, about 131 by 120".

    - Sea turns the sea on or off and sets its level.
    - A lake has its name and level, and for a rectangle lake its middle
      and size, and Remove lake. Lakes are made with the Brush section's
      Fill water and Paint water tools.
    - A river has its name, width, depth and speed, Edit path, which
      chooses the River tool and the river's first point, and Remove river.
      Rivers are drawn with the River tool.
    - New rivers sets the width and depth the River tool draws with.
    - Look is the look every sheet of the terrain's water shares: its
      shallow and deep colors (red, green, blue and alpha, each from 0 to
      1; alpha is how much ground the water hides), clarity, shore fade,
      and its ripples' size, speed, roughness and strength.

    A field's value is taken when the focus leaves it. Every change can be
    undone.

    It shows in the scene editor's Properties panel, after the Foliage
    section.
*/
class TerrainWaterPropertiesDialog is PropertiesDialog
    // What a button does.
    public constant integer SEA = 0
    public constant integer REMOVE_LAKE = 2
    public constant integer REMOVE_RIVER = 5
    public constant integer EDIT_RIVER = 6

    // The parts that fold, by number (PropertiesFoldItem). A lake's part
    // is LAKE_PART plus its number, and a river's RIVER_PART plus its.
    constant integer SEA_PART = 0
    constant integer LAKES_PART = 1
    constant integer RIVERS_PART = 2
    constant integer NEW_RIVERS_PART = 3
    constant integer LOOK_PART = 4
    constant integer LAKE_PART = 100
    constant integer RIVER_PART = 200

    // How many lakes and rivers the section shows parts for.
    constant integer LAKES_SHOWN = 16
    constant integer RIVERS_SHOWN = 8

    // How wide the fields' labels are, so the fields line up.
    constant number FIELD_LABEL_WIDTH = 120

    // How far in a part's header is: a top part, and a lake or river
    // inside Lakes or Rivers. Its card is a little farther in.
    constant number TOP_INDENT = 14
    constant number INNER_INDENT = 34

    // A lake's fields, by place in its card.
    constant integer NAME_FIELD = 0
    constant integer LEVEL_FIELD = 1
    constant integer X_FIELD = 2
    constant integer Z_FIELD = 3
    constant integer WIDTH_FIELD = 4
    constant integer DEPTH_FIELD = 5
    constant integer LAKE_FIELDS = 6

    // A river's fields, by place in its card.
    constant integer RIVER_NAME_FIELD = 0
    constant integer RIVER_WIDTH_FIELD = 1
    constant integer RIVER_DEPTH_FIELD = 2
    constant integer RIVER_SPEED_FIELD = 3
    constant integer RIVER_FIELDS = 4

    Label statusLabel = undefined
    // Everything below the status line; its parts are put in and taken out
    // as they fold and as lakes and rivers come and go.
    Control body = undefined
    Array<Control> partsShown

    // Which parts are open.
    boolean seaOpen = true
    boolean lakesOpen = true
    boolean riversOpen = true
    boolean newRiversOpen = false
    boolean lookOpen = false
    Array<boolean> lakeOpen
    Array<boolean> riverOpen

    // The sea.
    PropertiesFoldItem seaFold
    Control seaFoldRow = undefined
    Control seaCard = undefined
    Checkbox seaCheckbox = undefined
    TextField seaLevelField = undefined

    // The lakes: the Lakes header, then each lake's header, card, fields
    // (LAKE_FIELDS each) and Remove lake.
    PropertiesFoldItem lakesFold
    Control lakesFoldRow = undefined
    Array<PropertiesFoldItem> lakeFolds
    Array<Control> lakeFoldRows
    Array<Control> lakeCards
    Array<TextField> lakeFields
    Array<Button> removeButtons
    integer rowsShown = 0

    // The rivers, the same way, with Edit path.
    PropertiesFoldItem riversFold
    Control riversFoldRow = undefined
    Array<PropertiesFoldItem> riverFolds
    Array<Control> riverFoldRows
    Array<Control> riverCards
    Array<TextField> riverFields
    Array<Button> riverEditButtons
    Array<Button> riverRemoveButtons
    integer riverRowsShown = 0

    // The River tool's width and depth for new rivers.
    PropertiesFoldItem newRiversFold
    Control newRiversFoldRow = undefined
    Control newRiversCard = undefined
    TextField newRiverWidthField = undefined
    TextField newRiverDepthField = undefined

    // The look, its fields in the order SceneEditor:SetTerrainWaterLook
    // numbers them.
    PropertiesFoldItem lookFold
    Control lookFoldRow = undefined
    Control lookCard = undefined
    Array<TextField> lookFields
    Array<text> lookLabels

    EditorTerrain terrain = undefined
    boolean updating = false

    /*
        Creates and adds the interface components for this dialog.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Terrain Water")

        Label headingLabel
        headingLabel:SetSize(18)
        headingLabel:SetText("Water")
        headingLabel:SetLeftMargin(20)
        panel:Add(headingLabel)
        SetHeading(headingLabel)

        Label status
        statusLabel = status
        statusLabel:SetText("")
        statusLabel:SetHorizontalLayoutMode(statusLabel:parent:Control:STANDARD)
        statusLabel:SetPercentageWidth(1.0)
        statusLabel:SetLeftMargin(20)
        statusLabel:SetRightMargin(20)
        statusLabel:SetTopMargin(6)
        statusLabel:SetBottomMargin(4)
        statusLabel:SetFocusable(true)
        panel:Add(statusLabel)
        focusArray:Add(statusLabel)

        Control parts
        body = parts
        FlowLayout bodyLayout
        body:SetLayout(bodyLayout)
        body:SetPercentageWidth(1.0)
        body:SetVerticalLayoutMode(body:FIT_CONTENTS)
        panel:Add(body)

        // The sea.
        seaFold:SetName("Sea")
        seaFold:ShowOpen(seaOpen)
        seaFoldRow = MakeFoldRow(seaFold, SEA_PART, TOP_INDENT)
        seaCard = MakeIndentedCard(TOP_INDENT + 6)
        Control seaLine = MakeCardLine()
        Checkbox sea
        seaCheckbox = sea
        seaCheckbox:SetName("Sea")
        seaCheckbox:SetDescription("Water at one level all around, out to the horizon, hidden wherever the ground is higher")
        TerrainWaterButtonBehavior seaBehavior
        seaBehavior:Setup(me, SEA, 0)
        seaBehavior:SetCheckbox(true)
        seaCheckbox:SetBehavior(seaBehavior)
        seaLine:Add(seaCheckbox)
        seaCard:Add(seaLine)
        seaLevelField = AddField(seaCard, "Sea level:", "Sea level")

        // The lakes.
        lakesFold:SetName("Lakes")
        lakesFold:ShowOpen(lakesOpen)
        lakesFoldRow = MakeFoldRow(lakesFold, LAKES_PART, TOP_INDENT)
        integer index = 0
        repeat while index < LAKES_SHOWN
            MakeLakePart(index)
            index = index + 1
        end

        // The rivers.
        riversFold:SetName("Rivers")
        riversFold:ShowOpen(riversOpen)
        riversFoldRow = MakeFoldRow(riversFold, RIVERS_PART, TOP_INDENT)
        index = 0
        repeat while index < RIVERS_SHOWN
            MakeRiverPart(index)
            index = index + 1
        end
        newRiversFold:SetName("New rivers")
        newRiversFold:ShowOpen(newRiversOpen)
        newRiversFoldRow = MakeFoldRow(newRiversFold, NEW_RIVERS_PART, INNER_INDENT)
        newRiversCard = MakeIndentedCard(INNER_INDENT + 6)
        newRiverWidthField = AddField(newRiversCard, "Width:", "A new river's width")
        newRiverDepthField = AddField(newRiversCard, "Depth:", "A new river's depth in its middle")

        // The look.
        lookFold:SetName("Look")
        lookFold:ShowOpen(lookOpen)
        lookFoldRow = MakeFoldRow(lookFold, LOOK_PART, TOP_INDENT)
        lookCard = MakeIndentedCard(TOP_INDENT + 6)
        AddLookField(lookCard, "Shallow red:", "Shallow water's red, from 0 to 1")
        AddLookField(lookCard, "Shallow green:", "Shallow water's green, from 0 to 1")
        AddLookField(lookCard, "Shallow blue:", "Shallow water's blue, from 0 to 1")
        AddLookField(lookCard, "Shallow alpha:", "How much ground shallow water hides, from 0 to 1")
        AddLookField(lookCard, "Deep red:", "Deep water's red, from 0 to 1")
        AddLookField(lookCard, "Deep green:", "Deep water's green, from 0 to 1")
        AddLookField(lookCard, "Deep blue:", "Deep water's blue, from 0 to 1")
        AddLookField(lookCard, "Deep alpha:", "How much ground deep water hides, from 0 to 1")
        AddLookField(lookCard, "Clarity:", "How murky the water is: 0 is perfectly clear")
        AddLookField(lookCard, "Shore fade:", "How deep the water is where it stops fading in at the shore")
        AddLookField(lookCard, "Ripple size:", "How large the ripples are")
        AddLookField(lookCard, "Ripple speed:", "How fast the ripples move")
        AddLookField(lookCard, "Roughness:", "How rough the surface is, from 0 to 1")
        AddLookField(lookCard, "Ripple strength:", "How strongly the ripples bend the light")
        AddLookField(lookCard, "Reflection:", "How strongly the sky is reflected, from 0 to 1")

        focusArray:Add(seaFold:GetTree())
    end

    /*
        Makes a card indented from the section's edge.
    */
    private action MakeIndentedCard(number indent) returns Control
        Control card = MakeCard()
        card:SetLeftMargin(indent)
        return card
    end

    /*
        Makes one lake's part: its header, and a card with its fields and
        Remove lake.
    */
    private action MakeLakePart(integer index)
        PropertiesFoldItem fold
        fold:SetName("Lake " + (index + 1))
        fold:ShowOpen(false)
        lakeOpen:Add(false)
        lakeFolds:Add(fold)
        lakeFoldRows:Add(MakeFoldRow(fold, LAKE_PART + index, INNER_INDENT))
        Control card = MakeIndentedCard(INNER_INDENT + 6)
        lakeFields:Add(AddField(card, "Name:", "Lake " + (index + 1) + " name"))
        lakeFields:Add(AddField(card, "Water level:", "Lake " + (index + 1) + " water level"))
        lakeFields:Add(AddField(card, "Middle x:", "Lake " + (index + 1) + " middle along x"))
        lakeFields:Add(AddField(card, "Middle z:", "Lake " + (index + 1) + " middle along z"))
        lakeFields:Add(AddField(card, "Width:", "Lake " + (index + 1) + " width, along x"))
        lakeFields:Add(AddField(card, "Depth:", "Lake " + (index + 1) + " size along z"))
        Control buttonLine = MakeButtonRow()
        Button removeButton = MakeButton(buttonLine, "Remove lake", "Remove lake " + (index + 1), REMOVE_LAKE, index)
        card:Add(buttonLine)
        lakeCards:Add(card)
        removeButtons:Add(removeButton)
    end

    /*
        Makes one river's part (River plan R6): its header, and a card with
        its fields, Edit path and Remove river.
    */
    private action MakeRiverPart(integer index)
        PropertiesFoldItem fold
        fold:SetName("River " + (index + 1))
        fold:ShowOpen(false)
        riverOpen:Add(false)
        riverFolds:Add(fold)
        riverFoldRows:Add(MakeFoldRow(fold, RIVER_PART + index, INNER_INDENT))
        Control card = MakeIndentedCard(INNER_INDENT + 6)
        riverFields:Add(AddField(card, "Name:", "River " + (index + 1) + " name"))
        riverFields:Add(AddField(card, "Width:", "River " + (index + 1) + " width"))
        riverFields:Add(AddField(card, "Depth:", "River " + (index + 1) + " depth in its middle"))
        riverFields:Add(AddField(card, "Speed:", "How fast river " + (index + 1) + " flows, in units a second"))
        Control buttonLine = MakeButtonRow()
        Button editButton = MakeButton(buttonLine, "Edit path", "Choose the River tool and the first point of river " + (index + 1), EDIT_RIVER, index)
        Button removeButton = MakeButton(buttonLine, "Remove river", "Remove river " + (index + 1), REMOVE_RIVER, index)
        card:Add(buttonLine)
        riverCards:Add(card)
        riverEditButtons:Add(editButton)
        riverRemoveButtons:Add(removeButton)
    end

    /*
        Adds one of the look's fields.
    */
    private action AddLookField(Control card, text label, text name)
        lookFields:Add(AddField(card, label, name))
        lookLabels:Add(label:GetSubtext(0, label:GetSize() - 1))
    end

    /*
        Adds a labelled field, taken when the focus leaves it.
    */
    private action AddField(Control card, text label, text name) returns TextField
        Control line = MakeCardLine()
        FlowLayout labelLayout
        Control labelBox
        labelBox:SetLayout(labelLayout)
        labelBox:SetPercentageWidth(0)
        labelBox:SetPixelWidth(FIELD_LABEL_WIDTH)
        labelBox:SetVerticalLayoutMode(labelBox:FIT_CONTENTS)
        labelBox:SetRightMargin(10)
        Label fieldLabel
        fieldLabel:SetText(label)
        labelBox:Add(fieldLabel)
        line:Add(labelBox)
        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:SetRightMargin(8)
        field:SetHorizontalLayoutMode(line:FILL)
        TerrainWaterFieldListener listener
        listener:Setup(me, field)
        field:AddFocusListener(listener)
        line:Add(field)
        card:Add(line)
        return field
    end

    /*
        Adds a button to a line.
    */
    private action MakeButton(Control line, text name, text description, integer kind, integer lake) returns Button
        Button button
        button:SetName(name)
        button:SetDescription(description)
        button:SetRightMargin(10)
        TerrainWaterButtonBehavior behavior
        behavior:Setup(me, kind, lake)
        button:SetBehavior(behavior)
        line:Add(button)
        return button
    end

    /*
        This action shows the dialog when a terrain is selected, and hides it
        otherwise.
    */
    action SelectionChanged(SelectionEvent event)
        if not (event:GetSelection() is SceneEditorSelection)
            return now
        end
        SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
        Item selectedItem = undefined
        if selection:IsItemSelected()
            selectedItem = selection:GetSelectedItem()
        end
        if selectedItem is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selectedItem)
            SetTerrain(highlight:GetEditorTerrain())
            if not IsShowing()
                Show()
            end
        else
            terrain = undefined
            if IsShowing()
                Hide()
            end
        end
    end

    /*
        This action sets the fields from a selected terrain's highlight.
    */
    action SetFields(EditorItem item)
        if item is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, item)
            SetTerrain(highlight:GetEditorTerrain())
        end
    end

    /*
        This action shows a terrain's water: the status line, then each part
        that is there, open or folded.

        Attribute: Parameter terrain The terrain
    */
    action SetTerrain(EditorTerrain terrain)
        me:terrain = terrain
        if terrain = undefined
            return now
        end
        updating = true
        TerrainWater water = terrain:GetWater()
        seaCheckbox:SetToggleState(water:HasSea())
        SetText(seaLevelField, "" + Round(water:GetSeaLevel()))
        if water:HasSea()
            seaFold:SetName("Sea, level " + Round(water:GetSeaLevel()))
        else
            seaFold:SetName("Sea, off")
        end

        integer count = water:GetLakeCount()
        integer shown = count
        if shown > LAKES_SHOWN
            shown = LAKES_SHOWN
        end
        integer riverCount = water:GetRiverCount()
        integer riversShown = riverCount
        if riversShown > RIVERS_SHOWN
            riversShown = RIVERS_SHOWN
        end

        // The status: "A sea, 2 lakes and 1 river." It stays one line,
        // since a wrapped label draws over the controls below it; the
        // description says more.
        Array<text> things
        if water:HasSea()
            things:Add("A sea")
        end
        if count = 1
            things:Add("1 lake")
        elseif count > 1
            things:Add("" + count + " lakes")
        end
        if riverCount = 1
            things:Add("1 river")
        elseif riverCount > 1
            things:Add("" + riverCount + " rivers")
        end
        text status = "No water yet."
        text more = "Turn on the sea, make lakes with the Brush section's Fill water and Paint water tools, or draw rivers with the River tool."
        if not things:IsEmpty()
            status = JoinList(things) + "."
            more = ""
            if count > LAKES_SHOWN
                more = "The first " + LAKES_SHOWN + " lakes are shown here."
            end
            if riverCount > RIVERS_SHOWN
                more = more + " The first " + RIVERS_SHOWN + " rivers are shown here."
            end
        end
        statusLabel:SetText(status)
        statusLabel:SetDescription(more)

        lakesFold:SetName("Lakes (" + count + ")")
        integer i = 0
        repeat while i < shown
            TerrainLake lake = water:GetLake(i)
            // A lake of water cells has its shape from its cells, so only its
            // name and level can be typed; its place and size are hidden.
            boolean masked = lake:IsMasked()
            if masked
                lakeFolds:Get(i):SetName(lake:GetName() + ", level " + Round(lake:GetLevel()) + ", about " + Round(lake:GetWidth()) + " by " + Round(lake:GetDepth()))
            else
                lakeFolds:Get(i):SetName(lake:GetName() + ", level " + Round(lake:GetLevel()) + ", " + Round(lake:GetWidth()) + " by " + Round(lake:GetDepth()))
            end
            integer shapeField = X_FIELD
            repeat while shapeField <= DEPTH_FIELD
                Control line = cast(Control, lakeFields:Get(i * LAKE_FIELDS + shapeField):GetParent())
                if masked
                    line:Hide()
                else
                    line:Show()
                end
                line:RequestLayout()
                shapeField = shapeField + 1
            end
            SetText(lakeFields:Get(i * LAKE_FIELDS + NAME_FIELD), lake:GetName())
            SetText(lakeFields:Get(i * LAKE_FIELDS + LEVEL_FIELD), "" + Round(lake:GetLevel()))
            SetText(lakeFields:Get(i * LAKE_FIELDS + X_FIELD), "" + Round(lake:GetX()))
            SetText(lakeFields:Get(i * LAKE_FIELDS + Z_FIELD), "" + Round(lake:GetZ()))
            SetText(lakeFields:Get(i * LAKE_FIELDS + WIDTH_FIELD), "" + Round(lake:GetWidth()))
            SetText(lakeFields:Get(i * LAKE_FIELDS + DEPTH_FIELD), "" + Round(lake:GetDepth()))
            removeButtons:Get(i):SetDescription("Remove " + lake:GetName())
            i = i + 1
        end

        riversFold:SetName("Rivers (" + riverCount + ")")
        integer riverIndex = 0
        repeat while riverIndex < riversShown
            TerrainRiver river = water:GetRiver(riverIndex)
            riverFolds:Get(riverIndex):SetName(river:GetName() + ", " + Round(river:GetLength()) + " long, water " +
                Round(river:GetStartLevel()) + " down to " + Round(river:GetEndLevel()))
            SetText(riverFields:Get(riverIndex * RIVER_FIELDS + RIVER_NAME_FIELD), river:GetName())
            SetText(riverFields:Get(riverIndex * RIVER_FIELDS + RIVER_WIDTH_FIELD), "" + Round(river:GetWidth()))
            SetText(riverFields:Get(riverIndex * RIVER_FIELDS + RIVER_DEPTH_FIELD), "" + Round(river:GetDepth()))
            SetText(riverFields:Get(riverIndex * RIVER_FIELDS + RIVER_SPEED_FIELD), "" + Round(river:GetSpeed()))
            riverEditButtons:Get(riverIndex):SetDescription("Choose the River tool and the first point of " + river:GetName())
            riverRemoveButtons:Get(riverIndex):SetDescription("Remove " + river:GetName())
            riverIndex = riverIndex + 1
        end
        newRiversFold:SetName("New rivers, " + Round(terrain:GetRiverWidth()) + " wide, " + Round(terrain:GetRiverDepth()) + " deep")
        SetText(newRiverWidthField, "" + Round(terrain:GetRiverWidth()))
        SetText(newRiverDepthField, "" + Round(terrain:GetRiverDepth()))

        if lookOpen
            WaterShaderProgram program = water:GetWaterProgram()
            Color shallow = program:GetShallowColor()
            Color deep = program:GetDeepColor()
            SetText(lookFields:Get(0), "" + shallow:GetRed())
            SetText(lookFields:Get(1), "" + shallow:GetGreen())
            SetText(lookFields:Get(2), "" + shallow:GetBlue())
            SetText(lookFields:Get(3), "" + shallow:GetAlpha())
            SetText(lookFields:Get(4), "" + deep:GetRed())
            SetText(lookFields:Get(5), "" + deep:GetGreen())
            SetText(lookFields:Get(6), "" + deep:GetBlue())
            SetText(lookFields:Get(7), "" + deep:GetAlpha())
            SetText(lookFields:Get(8), "" + program:GetClarity())
            SetText(lookFields:Get(9), "" + program:GetShoreFade())
            SetText(lookFields:Get(10), "" + program:GetWaveScale())
            SetText(lookFields:Get(11), "" + program:GetWaveSpeed())
            SetText(lookFields:Get(12), "" + program:GetRoughness())
            SetText(lookFields:Get(13), "" + program:GetNormalStrength())
            SetText(lookFields:Get(14), "" + program:GetReflectionStrength())
        end

        ShowParts(shown, riversShown)
        statusLabel:RequestLayout()
        LinkFocus(shown, riversShown)
        updating = false
    end

    /*
        Joins a list of words for the status line: "A sea, 2 lakes and 1
        river".
    */
    private action JoinList(Array<text> things) returns text
        text result = ""
        integer i = 0
        repeat while i < things:GetSize()
            if i > 0 and i = things:GetSize() - 1
                result = result + " and "
            elseif i > 0
                result = result + ", "
            end
            result = result + things:Get(i)
            i = i + 1
        end
        return result
    end

    /*
        Puts text in a field unless it already says it.
    */
    private action SetText(TextField field, text value)
        if field:GetText() not= value
            field:SetText(value)
        end
    end

    /*
        Puts the parts in the section's body in order, each header followed
        by its card when it is open: Sea; Lakes and each lake; Rivers, each
        river and New rivers; then Look.
    */
    private action ShowParts(integer count, integer riverCount)
        Array<Control> wanted
        wanted:Add(seaFoldRow)
        if seaOpen
            wanted:Add(seaCard)
        end
        if count > 0
            wanted:Add(lakesFoldRow)
            if lakesOpen
                integer i = 0
                repeat while i < count
                    wanted:Add(lakeFoldRows:Get(i))
                    if lakeOpen:Get(i)
                        wanted:Add(lakeCards:Get(i))
                    end
                    i = i + 1
                end
            end
        end
        wanted:Add(riversFoldRow)
        if riversOpen
            integer riverIndex = 0
            repeat while riverIndex < riverCount
                wanted:Add(riverFoldRows:Get(riverIndex))
                if riverOpen:Get(riverIndex)
                    wanted:Add(riverCards:Get(riverIndex))
                end
                riverIndex = riverIndex + 1
            end
            wanted:Add(newRiversFoldRow)
            if newRiversOpen
                wanted:Add(newRiversCard)
            end
        end
        wanted:Add(lookFoldRow)
        if lookOpen
            wanted:Add(lookCard)
        end

        boolean same = partsShown:GetSize() = wanted:GetSize()
        integer place = 0
        repeat while same and place < wanted:GetSize()
            if partsShown:Get(place) not= wanted:Get(place)
                same = false
            end
            place = place + 1
        end
        if not same
            place = 0
            repeat while place < partsShown:GetSize()
                boolean removed = body:Remove(partsShown:Get(place))
                place = place + 1
            end
            partsShown:Empty()
            place = 0
            repeat while place < wanted:GetSize()
                body:Add(wanted:Get(place))
                partsShown:Add(wanted:Get(place))
                place = place + 1
            end
        end
        rowsShown = count
        riverRowsShown = riverCount
    end

    /*
        Links the Tab order through what is shown: the status line, then
        each part's header, and its fields and buttons when it is open.
    */
    private action LinkFocus(integer count, integer riverCount)
        Array<Control> chain
        chain:Add(statusLabel)
        chain:Add(seaFold:GetTree())
        if seaOpen
            chain:Add(seaCheckbox)
            chain:Add(seaLevelField)
        end
        if count > 0
            chain:Add(lakesFold:GetTree())
            if lakesOpen
                integer i = 0
                repeat while i < count
                    chain:Add(lakeFolds:Get(i):GetTree())
                    if lakeOpen:Get(i)
                        // A lake of water cells shows only its name and level.
                        boolean masked = terrain:GetWater():GetLake(i):IsMasked()
                        integer field = 0
                        repeat while field < LAKE_FIELDS
                            if not masked or field = NAME_FIELD or field = LEVEL_FIELD
                                chain:Add(lakeFields:Get(i * LAKE_FIELDS + field))
                            end
                            field = field + 1
                        end
                        chain:Add(removeButtons:Get(i))
                    end
                    i = i + 1
                end
            end
        end
        chain:Add(riversFold:GetTree())
        if riversOpen
            integer riverIndex = 0
            repeat while riverIndex < riverCount
                chain:Add(riverFolds:Get(riverIndex):GetTree())
                if riverOpen:Get(riverIndex)
                    integer riverField = 0
                    repeat while riverField < RIVER_FIELDS
                        chain:Add(riverFields:Get(riverIndex * RIVER_FIELDS + riverField))
                        riverField = riverField + 1
                    end
                    chain:Add(riverEditButtons:Get(riverIndex))
                    chain:Add(riverRemoveButtons:Get(riverIndex))
                end
                riverIndex = riverIndex + 1
            end
            chain:Add(newRiversFold:GetTree())
            if newRiversOpen
                chain:Add(newRiverWidthField)
                chain:Add(newRiverDepthField)
            end
        end
        chain:Add(lookFold:GetTree())
        if lookOpen
            integer lookIndex = 0
            repeat while lookIndex < lookFields:GetSize()
                chain:Add(lookFields:Get(lookIndex))
                lookIndex = lookIndex + 1
            end
        end
        integer link = 0
        repeat while link < chain:GetSize() - 1
            chain:Get(link):SetNextFocus(chain:Get(link + 1))
            chain:Get(link + 1):SetPreviousFocus(chain:Get(link))
            link = link + 1
        end
        SetFirstFocus(chain:Get(0))
        SetLastFocus(chain:Get(chain:GetSize() - 1))
    end

    /*
        Shows the terrain's water again, after it changed.
    */
    action Refresh
        if terrain not= undefined
            SetTerrain(terrain)
        end
    end

    /*
        This action is called when one of the section's parts is opened or
        closed with its chevron: the part is shown or hidden.

        Attribute: Parameter partKey The part's number
        Attribute: Parameter open True if it was opened
    */
    action FoldChanged(integer partKey, boolean open)
        if partKey = SEA_PART
            seaOpen = open
        elseif partKey = LAKES_PART
            lakesOpen = open
        elseif partKey = RIVERS_PART
            riversOpen = open
        elseif partKey = NEW_RIVERS_PART
            newRiversOpen = open
        elseif partKey = LOOK_PART
            lookOpen = open
        elseif partKey >= RIVER_PART and partKey < RIVER_PART + RIVERS_SHOWN
            riverOpen:Set(partKey - RIVER_PART, open)
        elseif partKey >= LAKE_PART and partKey < LAKE_PART + LAKES_SHOWN
            lakeOpen:Set(partKey - LAKE_PART, open)
        end
        Refresh()
    end

    /*
        This action opens a river's part, such as after Edit path, so its
        settings show.

        Attribute: Parameter index The river, from 0
    */
    action OpenRiverPart(integer index)
        if index < 0 or index >= RIVERS_SHOWN
            return now
        end
        riversOpen = true
        riversFold:ShowOpen(true)
        riverOpen:Set(index, true)
        riverFolds:Get(index):ShowOpen(true)
        Refresh()
    end

    /*
        This action is called by the section's buttons and the Sea checkbox.

        Attribute: Parameter kind One of the button kinds, such as REMOVE_LAKE
        Attribute: Parameter lake The lake or river, from 0
    */
    action ButtonActivated(integer kind, integer lake)
        SceneEditor editor = GetSceneEditor()
        if terrain = undefined or editor = undefined or updating
            return now
        end
        if kind = SEA
            number level = ReadNumber(seaLevelField, terrain:GetWater():GetSeaLevel())
            editor:SetTerrainSea(terrain, seaCheckbox:GetToggleState(), level)
        elseif kind = REMOVE_LAKE
            editor:RemoveTerrainLake(terrain, lake)
            if rowsShown > 0
                lakesFold:GetTree():Focus()
            else
                riversFold:GetTree():Focus()
            end
        elseif kind = REMOVE_RIVER
            editor:RemoveTerrainRiver(terrain, lake)
            riversFold:GetTree():Focus()
        elseif kind = EDIT_RIVER
            editor:EditTerrainRiver(terrain, lake)
        end
    end

    /*
        This action is called when the focus leaves one of the section's
        fields: its value is taken. Text that isn't a number is ignored, and
        a number shown rounded and left as it was changes nothing.

        Attribute: Parameter field The field the focus left
    */
    action FieldLeft(TextField field)
        SceneEditor editor = GetSceneEditor()
        if terrain = undefined or updating or editor = undefined
            return now
        end
        TerrainWater water = terrain:GetWater()
        if field:Equals(seaLevelField)
            if water:HasSea()
                number level = ReadKept(seaLevelField, water:GetSeaLevel())
                if level not= water:GetSeaLevel()
                    editor:SetTerrainSea(terrain, true, level)
                end
            end
            return now
        end
        integer i = 0
        repeat while i < lookFields:GetSize()
            if field:Equals(lookFields:Get(i))
                number value = ReadNumber(field, -1)
                if value >= 0
                    editor:SetTerrainWaterLook(terrain, i, value, lookLabels:Get(i))
                end
                return now
            end
            i = i + 1
        end
        if field:Equals(newRiverWidthField)
            number riverWidthValue = ReadKept(field, terrain:GetRiverWidth())
            if riverWidthValue > 0 and riverWidthValue not= terrain:GetRiverWidth()
                terrain:SetRiverWidth(riverWidthValue)
                Refresh()
            end
            return now
        elseif field:Equals(newRiverDepthField)
            number riverDepthValue = ReadKept(field, terrain:GetRiverDepth())
            if riverDepthValue > 0 and riverDepthValue not= terrain:GetRiverDepth()
                terrain:SetRiverDepth(riverDepthValue)
                Refresh()
            end
            return now
        end
        integer riverPlace = 0
        repeat while riverPlace < riverRowsShown * RIVER_FIELDS
            if field:Equals(riverFields:Get(riverPlace))
                integer riverIndex = riverPlace / RIVER_FIELDS
                if riverIndex < water:GetRiverCount()
                    TerrainRiver river = water:GetRiver(riverIndex)
                    integer riverStart = riverIndex * RIVER_FIELDS
                    text riverName = riverFields:Get(riverStart + RIVER_NAME_FIELD):GetText():Trim()
                    if riverName = ""
                        riverName = river:GetName()
                    end
                    number newWidth = ReadKept(riverFields:Get(riverStart + RIVER_WIDTH_FIELD), river:GetWidth())
                    number newDepth = ReadKept(riverFields:Get(riverStart + RIVER_DEPTH_FIELD), river:GetDepth())
                    number newSpeed = ReadKept(riverFields:Get(riverStart + RIVER_SPEED_FIELD), river:GetSpeed())
                    if riverName not= river:GetName() or newWidth not= river:GetWidth() or newDepth not= river:GetDepth() or newSpeed not= river:GetSpeed()
                        editor:SetTerrainRiver(terrain, riverIndex, riverName, newWidth, newDepth, newSpeed)
                    end
                end
                return now
            end
            riverPlace = riverPlace + 1
        end
        integer place = 0
        repeat while place < rowsShown * LAKE_FIELDS
            if field:Equals(lakeFields:Get(place))
                integer index = place / LAKE_FIELDS
                if index < water:GetLakeCount()
                    TerrainLake lake = water:GetLake(index)
                    integer start = index * LAKE_FIELDS
                    text name = lakeFields:Get(start + NAME_FIELD):GetText():Trim()
                    if name = ""
                        name = lake:GetName()
                    end
                    number newX = ReadKept(lakeFields:Get(start + X_FIELD), lake:GetX())
                    number newZ = ReadKept(lakeFields:Get(start + Z_FIELD), lake:GetZ())
                    number newLakeWidth = ReadKept(lakeFields:Get(start + WIDTH_FIELD), lake:GetWidth())
                    number newLakeDepth = ReadKept(lakeFields:Get(start + DEPTH_FIELD), lake:GetDepth())
                    number newLevel = ReadKept(lakeFields:Get(start + LEVEL_FIELD), lake:GetLevel())
                    if name not= lake:GetName() or newX not= lake:GetX() or newZ not= lake:GetZ() or newLakeWidth not= lake:GetWidth() or newLakeDepth not= lake:GetDepth() or newLevel not= lake:GetLevel()
                        editor:SetTerrainLake(terrain, index, newX, newZ, newLakeWidth, newLakeDepth, newLevel, name)
                    end
                end
                return now
            end
            place = place + 1
        end
    end

    /*
        Returns the number in a field, or a fallback if it doesn't hold one.
    */
    private action ReadNumber(TextField field, number fallback) returns number
        number value = fallback
        check
            value = field:GetText():ParseNumber()
        detect e is Error
            value = fallback
        end
        return value
    end

    /*
        Returns the number in a field, or the value it shows rounded if the
        field still says that rounded number, so leaving a field unchanged
        changes nothing.
    */
    private action ReadKept(TextField field, number current) returns number
        number value = ReadNumber(field, current)
        if value = Round(current)
            return current
        end
        return value
    end

    /*
        Rounds a number to one place after the point, for reading.
    */
    private action Round(number value) returns number
        if value < 0
            return -Round(-value)
        end
        return cast(integer, value * 10 + 0.5) / 10.0
    end

    /*
        Moves the focus to the Sea part's header.
    */
    action FocusField
        seaFold:GetTree():Focus()
    end
end
