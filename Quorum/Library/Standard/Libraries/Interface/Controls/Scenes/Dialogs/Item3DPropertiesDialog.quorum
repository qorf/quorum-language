package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Events.SelectionListener
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Selections.ButtonGroupSelection
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.RadioButton
use Libraries.Game.Graphics.PointLight
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.Items.Highlights.ModelSelectionHighlight
use Libraries.Interface.Controls.Scenes.Items.Previews.ModelPreview
use Libraries.Interface.Controls.Scenes.Items.Previews.ItemPreview3D
use Libraries.Interface.Controls.Scenes.Items.Previews.Custom3DPrimitivePreview
use Libraries.Interface.Controls.Scenes.Dialogs.PropertiesDialog
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesEnablePhysicsBehavior
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesFollowGroundBehavior

class Item3DPropertiesDialog is PropertiesDialog

    // Controls used on the dialog itself
    Label nameLabel = undefined
    TextField nameField = undefined
    TextField positionXField = undefined
    TextField positionYField = undefined
    TextField positionZField = undefined
    TextField scaleXField = undefined
    TextField scaleYField = undefined
    TextField scaleZField = undefined
    TextField rotationYawField = undefined
    TextField rotationPitchField = undefined
    TextField rotationRollField = undefined
    TextField colorRedField = undefined
    TextField colorGreenField = undefined
    TextField colorBlueField = undefined
    Checkbox physicsEnabledCheckbox = undefined
    ButtonGroup responsivenessGroup = undefined
    TextField massField = undefined
    TextField frictionField = undefined
    TextField restitutionField = undefined
    // A new item's preview only: whether the arrow keys keep it at its
    // height above the ground.
    Control followGroundLine = undefined
    Checkbox followGroundCheckbox = undefined
    boolean settingFields = false

    // The width of the box each line's label sits in, so the fields after
    // the labels line up and are the same size (the terrain sections' way).
    constant number FIELD_LABEL_WIDTH = 90
    // The gap after each of a line's three fields, in pixels.
    constant integer CELL_GAP = 6

    /*
        Creates and adds the interface components for this dialog: the
        item's name, then cards for its place (position, scale and turn),
        its look (color) and its physics, as the terrain's sections are laid
        out.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Object Properties")

        Label basicPropertiesLabel
        basicPropertiesLabel:SetSize(18)
        basicPropertiesLabel:SetText("Basic Properties")
        basicPropertiesLabel:SetLeftMargin(20)
        panel:Add(basicPropertiesLabel)
        // Its text is the section's title, under a header that opens and
        // closes it when the panel shows several sections.
        SetHeading(basicPropertiesLabel)

        Control nameCard = AddCard(panel, "")
        nameField = AddField(nameCard, "Name", "Name", focusArray)

        Control placeCard = AddCard(panel, "Place")
        Array<TextField> position = AddTriple(placeCard, "Position", "X", "Y", "Z", "x", "y", "z", focusArray)
        positionXField = position:Get(0)
        positionYField = position:Get(1)
        positionZField = position:Get(2)
        Array<TextField> scale = AddTriple(placeCard, "Scale", "X Scale", "Y Scale", "Z Scale", "x", "y", "z", focusArray)
        scaleXField = scale:Get(0)
        scaleYField = scale:Get(1)
        scaleZField = scale:Get(2)
        Array<TextField> rotation = AddTriple(placeCard, "Rotation", "Yaw", "Pitch", "Roll", "yaw", "pitch", "roll", focusArray)
        rotationYawField = rotation:Get(0)
        rotationPitchField = rotation:Get(1)
        rotationRollField = rotation:Get(2)

        // For a new item's preview only (SetFields shows it).
        Control followLine = MakeCardLine()
        followGroundLine = followLine
        Checkbox followCheckbox
        followGroundCheckbox = followCheckbox
        followGroundCheckbox:SetName("Follow the ground")
        followGroundCheckbox:SetDescription("The arrow keys keep it the same height above the ground")
        PropertiesFollowGroundBehavior followBehavior
        followBehavior:SetDialog(me)
        followGroundCheckbox:SetBehavior(followBehavior)
        followGroundLine:Add(followGroundCheckbox)
        placeCard:Add(followGroundLine)
        focusArray:Add(followGroundCheckbox)

        Control lookCard = AddCard(panel, "Look")
        Array<TextField> color = AddTriple(lookCard, "Color", "Red", "Green", "Blue", "r", "g", "b", focusArray)
        colorRedField = color:Get(0)
        colorGreenField = color:Get(1)
        colorBlueField = color:Get(2)

        Control physicsCard = AddCard(panel, "Physics")
        Control physicsLine = MakeCardLine()
        Checkbox physicsCheckbox
        physicsEnabledCheckbox = physicsCheckbox
        physicsEnabledCheckbox:SetName("Physics Enabled")
        PropertiesEnablePhysicsBehavior propertiesEnablePhysicsBehavior
        propertiesEnablePhysicsBehavior:SetDialog3D(me)
        physicsEnabledCheckbox:SetBehavior(propertiesEnablePhysicsBehavior)
        physicsLine:Add(physicsEnabledCheckbox)
        physicsCard:Add(physicsLine)
        focusArray:Add(physicsEnabledCheckbox)

        // The three ways an item responds, side by side on one line.
        Control responsivenessLine = MakeCardLine()
        ButtonGroup group
        responsivenessGroup = group
        responsivenessGroup:SetName("Responsiveness")
        responsivenessGroup:SetHorizontalLayoutMode(responsivenessLine:FILL)
        responsivenessGroup:SetVerticalLayoutMode(responsivenessLine:FIT_CONTENTS)
        FlowLayout groupLayout
        responsivenessGroup:SetLayout(groupLayout)
        RadioButton unmovableButton
        unmovableButton:SetName("Unmovable")
        RadioButton nonResponsiveButton
        nonResponsiveButton:SetName("Nonresponsive")
        RadioButton responsiveButton
        responsiveButton:SetName("Responsive")
        AddChoice(unmovableButton)
        AddChoice(nonResponsiveButton)
        AddChoice(responsiveButton)
        responsivenessGroup:AddSelectionListener(me)
        responsivenessLine:Add(responsivenessGroup)
        physicsCard:Add(responsivenessLine)
        focusArray:Add(responsivenessGroup)

        massField = AddField(physicsCard, "Mass", "Mass", focusArray)
        frictionField = AddField(physicsCard, "Friction", "Friction", focusArray)
        restitutionField = AddField(physicsCard, "Restitution", "Restitution", focusArray)
    end

    /*
        Adds one of the responsiveness choices to its group, a third of the
        line wide, in the order SetFields counts them.
    */
    private action AddChoice(RadioButton button)
        button:SetPercentageWidth(0.333)
        button:SetPixelWidth(-CELL_GAP)
        button:SetRightMargin(CELL_GAP)
        responsivenessGroup:AddToGrouping(button)
        responsivenessGroup:Add(button)
    end

    /*
        Makes the start of a card's line: the line, and its label in a box
        of one width, so the fields after the labels line up.
    */
    private action MakeLabeledLine(text label) returns Control
        Control line = MakeCardLine()
        FlowLayout labelLayout
        Control labelBox
        labelBox:SetLayout(labelLayout)
        labelBox:SetPercentageWidth(0)
        labelBox:SetPixelWidth(FIELD_LABEL_WIDTH)
        labelBox:SetVerticalLayoutMode(labelBox:FIT_CONTENTS)
        labelBox:SetRightMargin(8)
        Label fieldLabel
        fieldLabel:SetText(label)
        labelBox:Add(fieldLabel)
        line:Add(labelBox)
        return line
    end

    /*
        Adds a line to a card with a label and one field filling the rest.

        Attribute: Parameter card The card
        Attribute: Parameter label The label shown
        Attribute: Parameter name The field's name, as a screen reader says it
        Attribute: Parameter focusArray The section's focus order
        Attribute: Returns The field
    */
    private action AddField(Control card, text label, text name, Array<Control> focusArray) returns TextField
        Control line = MakeLabeledLine(label)
        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:AddTextChangeListener(me)
        field:SetHorizontalLayoutMode(line:FILL)
        line:Add(field)
        card:Add(line)
        focusArray:Add(field)
        return field
    end

    /*
        Adds a label on its own line, then a line of three fields of the
        same width, each after a small tag, such as x, y and z. The label
        sits above, so the fields have the card's whole width.

        Attribute: Parameter card The card
        Attribute: Parameter label The label shown
        Attribute: Parameter firstName The first field's name, as a screen reader says it
        Attribute: Parameter secondName The second field's name
        Attribute: Parameter thirdName The third field's name
        Attribute: Parameter firstTag The small tag before the first field
        Attribute: Parameter secondTag The tag before the second field
        Attribute: Parameter thirdTag The tag before the third field
        Attribute: Parameter focusArray The section's focus order
        Attribute: Returns The three fields, in order
    */
    private action AddTriple(Control card, text label, text firstName, text secondName, text thirdName,
            text firstTag, text secondTag, text thirdTag, Array<Control> focusArray) returns Array<TextField>
        card:Add(MakeLabelLine(label))
        Control line = MakeCardLine()
        line:SetTopMargin(0)
        Array<TextField> made
        made:Add(AddTaggedField(line, firstName, firstTag, focusArray))
        made:Add(AddTaggedField(line, secondName, secondTag, focusArray))
        made:Add(AddTaggedField(line, thirdName, thirdTag, focusArray))
        card:Add(line)
        return made
    end

    /*
        Makes a line holding only a label, for the three-field rows, whose
        label sits above their fields.
    */
    private action MakeLabelLine(text label) returns Control
        Control line = MakeCardLine()
        line:SetBottomMargin(2)
        Label lineLabel
        lineLabel:SetText(label)
        line:Add(lineLabel)
        return line
    end

    /*
        Adds one of a line's three fields: a third of the line wide, less
        its margin so three always fit, with its small tag first, in the
        section title's color.
    */
    private action AddTaggedField(Control fields, text name, text tag, Array<Control> focusArray) returns TextField
        FlowLayout cellLayout
        Control cell
        cell:SetLayout(cellLayout)
        cell:SetPercentageWidth(0.333)
        cell:SetPixelWidth(-CELL_GAP)
        cell:SetVerticalLayoutMode(cell:FIT_CONTENTS)
        cell:SetRightMargin(CELL_GAP)
        Label tagLabel = MakeCardTitle(tag)
        tagLabel:SetSize(12)
        tagLabel:SetLeftMargin(0)
        tagLabel:SetTopMargin(0)
        tagLabel:SetBottomMargin(0)
        tagLabel:SetRightMargin(4)
        cell:Add(tagLabel)
        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:AddTextChangeListener(me)
        field:SetHorizontalLayoutMode(cell:FILL)
        cell:Add(field)
        fields:Add(cell)
        focusArray:Add(field)
        return field
    end

    /*
        This action Shows or Hides the dialog based on what gains selection. Only if a model or 3D primitive is selected
        will this dialog show. If there is no selection or the selected item is not a model then the dialog
        will hide or stay hidden.
    */
    action SelectionChanged(SelectionEvent event)
        // TO-DO: Consider change to Layer in VisualEditorSelection

        if event:GetSelection() is SceneEditorSelection
            SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
            if selection:IsItemSelected() = false
                if IsShowing()
                    Hide()
                end
            else
                Item selectedItem = selection:GetSelectedItem()
                if selectedItem is ModelSelectionHighlight or selectedItem is ModelPreview or selectedItem is Custom3DPrimitivePreview
                    SetFields(cast(EditorItem3D, selectedItem))
                    if not IsShowing()
                        Show()
                    end
                else
                    if IsShowing()
                        Hide()
                    end
                end
            end
        elseif event:GetSelection() is ButtonGroupSelection
            ButtonGroupSelection selection = cast(ButtonGroupSelection, event:GetSelection())
            EditorItem item = GetSceneEditor():GetSelectedItem()
            if item not= undefined
                integer index = selection:GetIndex()
                item:SetEditorResponsiveness(index)

                // If the item is responsive, adjust the default mass to be non-zero
                if index = 2 and item:GetEditorMass() = 0
                    item:SetEditorMass(1)
                    massField:SetText("" + item:GetEditorMass())
                end
            end
        end
    end

    /*
        This action takes an EditorItem and sets the fields in the dialog based on its
        properties
    */
    action SetFields(EditorItem item)
        if item is EditorItem3D = false
            return now
        end

        SetFields(cast(EditorItem3D, item))
    end

    /*
        This action takes an EditorItem2D and sets the fields in the dialog based on its
        properties
    */
    action SetFields(EditorItem3D item)
        // The Follow the ground line is only for a new item's preview.
        settingFields = true
        if item is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, item)
            followGroundCheckbox:SetToggleState(preview:IsFollowingGround())
            followGroundLine:Show()
        else
            followGroundLine:Hide()
        end
        settingFields = false
        nameField:SetText(item:GetName())
        positionXField:SetText("" + item:GetX())
        positionYField:SetText("" + item:GetY())
        positionZField:SetText("" + item:GetZ())
        scaleXField:SetText("" + item:GetScaleX())
        scaleYField:SetText("" + item:GetScaleY())
        scaleZField:SetText("" + item:GetScaleZ())
        rotationYawField:SetText("" + item:GetYaw())
        rotationPitchField:SetText("" + item:GetPitch())
        rotationRollField:SetText("" + item:GetRoll())
        
        Color color = item:GetColor()
        if color not= undefined
            colorRedField:SetText("" + color:GetRed())
            colorGreenField:SetText("" + color:GetGreen())
            colorBlueField:SetText("" + color:GetBlue())
        else
            colorRedField:SetText("")
            colorGreenField:SetText("")
            colorBlueField:SetText("")
        end

        physicsEnabledCheckbox:SetToggleState(item:IsEditorPhysicsEnabled())
        
        integer responsive = item:GetEditorResponsiveness()
        responsivenessGroup:GetButtonAt(responsive):SetToggleState(true)

        massField:SetText("" + item:GetEditorMass())
        frictionField:SetText("" + item:GetEditorFriction())
        restitutionField:SetText("" + item:GetEditorRestitution())
    end

    /*
        Updates the properties of the selected item as text is changed in any text field in the dialog.
        If the text is updated to any invalid values the text is ignored. 
    */
    action TextChanged(TextChangeEvent event)
        EditorItem3D currentItem = cast(EditorItem3D, GetSceneEditor():GetSelectedItem())
        Control control = event:GetControl()

        if currentItem = undefined
            return now
        end

        if control:Equals(nameField)
            if nameField:GetText() not= currentItem:GetName()
                currentItem:SetName(nameField:GetText())
            end
        elseif control:Equals(positionXField)
            check
                number value = positionXField:GetText():ParseNumber()
                if value not= currentItem:GetX()
                    currentItem:SetX(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(positionYField)
            check
                number value = positionYField:GetText():ParseNumber()
                if value not= currentItem:GetY()
                    currentItem:SetY(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(positionZField)
            check
                number value = positionZField:GetText():ParseNumber()
                if value not= currentItem:GetZ()
                    currentItem:SetZ(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleXField)
            check
                number value = scaleXField:GetText():ParseNumber()
                if value = 0
                    return now
                end

                if value not= currentItem:GetScaleX()
                    currentItem:SetScaleX(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleYField)
            check
                number value = scaleYField:GetText():ParseNumber()
                if value = 0
                    return now
                end

                if value not= currentItem:GetScaleY()
                    currentItem:SetScaleY(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleZField)
            check
                number value = scaleZField:GetText():ParseNumber()
                if value = 0
                    return now
                end

                if value not= currentItem:GetScaleZ()
                    currentItem:SetScaleZ(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationYawField)
            check
                number value = rotationYawField:GetText():ParseNumber()

                if value not= currentItem:GetYaw()
                    currentItem:SetRotation(value, currentItem:GetPitch(), currentItem:GetRoll())
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationPitchField)
            check
                number value = rotationPitchField:GetText():ParseNumber()

                if value not= currentItem:GetPitch()
                    currentItem:SetRotation(currentItem:GetYaw(), value, currentItem:GetRoll())
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationRollField)
            check
                number value = rotationRollField:GetText():ParseNumber()

                if value not= currentItem:GetRoll()
                    currentItem:SetRotation(currentItem:GetYaw(), currentItem:GetPitch(), value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(colorRedField)
            check
                number value = colorRedField:GetText():ParseNumber()
                Color color = currentItem:GetColor()
                if value not= color:GetRed()
                    color:SetRed(value)
                    currentItem:SetColor(color)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(colorGreenField)
            check
                number value = colorGreenField:GetText():ParseNumber()
                Color color = currentItem:GetColor()
                if value not= color:GetGreen()
                    color:SetGreen(value)
                    currentItem:SetColor(color)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(colorBlueField)
            check
                number value = colorBlueField:GetText():ParseNumber()
                Color color = currentItem:GetColor()
                if value not= color:GetBlue()
                    color:SetBlue(value)
                    currentItem:SetColor(color)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(massField)
            check
                number value = massField:GetText():ParseNumber()

                if value not= currentItem:GetEditorMass()
                    currentItem:SetEditorMass(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(frictionField)
            check
                number value = frictionField:GetText():ParseNumber()

                if value not= currentItem:GetEditorFriction()
                    currentItem:SetEditorFriction(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(restitutionField)
            check
                number value = restitutionField:GetText():ParseNumber()

                if value not= currentItem:GetEditorRestitution()
                    currentItem:SetEditorRestitution(value)
                end
            detect e is Error
                // Do nothing.
            end
        end
    end

    /*
        This action enables physics on the selected item. This action is called by the activation behavior
        of the physics enabled checkbox.
    */
    /*
        This action sets whether the selected new item's preview follows
        the ground with the arrow keys. The Follow the ground checkbox calls
        it.

        Attribute: Parameter follow True to follow the ground
    */
    action SetFollowGround(boolean follow)
        if settingFields
            return now
        end
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if item is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, item)
            preview:SetFollowingGround(follow)
        end
    end

    action SetPhysicsEnabled(boolean enabled)
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if item not= undefined and item:IsEditorPhysicsEnabled() not= enabled
            item:SetEditorPhysicsEnabled(enabled)
        end
    end

    /*
    Moves the focus to one of the fields in the properties dialog. By default
    this is the name field (the first field in the panel), but it could also be
    changed to a different field, possibly context sensitive.
    */
    action FocusField
        nameField:Focus()
        nameField:Select(0, nameField:GetSize(), true)
    end

    /*
        Sets the text of the name field. 
    */
    action SetNameField(text name)
        nameField:RemoveTextChangeListener(me)
        nameField:SetText(name)
        nameField:AddTextChangeListener(me)
    end
end