package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Events.SelectionListener
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Selections.ButtonGroupSelection
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.RadioButton
use Libraries.Game.Graphics.PointLight
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.Items.Highlights.ModelSelectionHighlight
use Libraries.Interface.Controls.Scenes.Items.Previews.ModelPreview
use Libraries.Interface.Controls.Scenes.Items.Previews.ItemPreview3D
use Libraries.Interface.Controls.Scenes.Items.Previews.Custom3DPrimitivePreview
use Libraries.Interface.Controls.Scenes.Dialogs.PropertiesDialog
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesEnablePhysicsBehavior
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesFollowGroundBehavior
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesLeanWithSlopeBehavior
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesOverrideColorBehavior
use Libraries.Interface.Events.PropertiesColorWellListener
use Libraries.Interface.Controls.ColorWell
use Libraries.Interface.Controls.SliderField
use Libraries.Interface.Controls.Scenes.Items.EditorModel
use Libraries.Interface.Behaviors.Scenes.Properties.PropertiesPartBehavior

class Item3DPropertiesDialog is PropertiesDialog

    // Controls used on the dialog itself
    Label nameLabel = undefined
    TextField nameField = undefined
    TextField positionXField = undefined
    TextField positionYField = undefined
    TextField positionZField = undefined
    TextField scaleXField = undefined
    TextField scaleYField = undefined
    TextField scaleZField = undefined
    TextField rotationYawField = undefined
    TextField rotationPitchField = undefined
    TextField rotationRollField = undefined
    // On: changing one scale changes the other two by the same ratio.
    Checkbox keepProportionsCheckbox = undefined
    // The Look card: whether a chosen color shows over the item's own
    // colors, and the color.
    Checkbox overrideColorCheckbox = undefined
    ColorWell colorWell = undefined
    Checkbox physicsEnabledCheckbox = undefined
    ButtonGroup responsivenessGroup = undefined
    TextField massField = undefined
    TextField frictionField = undefined
    TextField restitutionField = undefined
    // A model with a controller gets its physics from the Controller
    // section: its own Physics card is hidden and a note shown instead.
    Control physicsCardPart = undefined
    Control physicsNotePart = undefined
    Label physicsNote = undefined
    // The Parts card: one checkbox per part name of the selected model,
    // shown when it has two or more, such as a toy car's body, glass and
    // blanket. The model they are for.
    Label partsTitlePart = undefined
    Control partsCardPart = undefined
    Array<Checkbox> partCheckboxes
    Array<Control> partLines
    EditorModel partsModel = undefined
    // A new item's preview only: whether the arrow keys keep it at its
    // height above the ground.
    Control followGroundLine = undefined
    Checkbox followGroundCheckbox = undefined
    Control leanWithSlopeLine = undefined
    Checkbox leanWithSlopeCheckbox = undefined
    boolean settingFields = false

    // The width of the box each line's label sits in, so the fields after
    // the labels line up and are the same size (the terrain sections' way).
    constant number FIELD_LABEL_WIDTH = 90
    // The short labels before the scale and rotation sliders, such as "pitch".
    constant number PLACE_LABEL_WIDTH = 44
    // The gap after each of a line's three fields, in pixels.
    constant integer CELL_GAP = 6

    /*
        Creates and adds the interface components for this dialog: the
        item's name, then cards for its place (position, scale and turn),
        its look (color) and its physics, as the terrain's sections are laid
        out.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Object Properties")

        Label basicPropertiesLabel
        basicPropertiesLabel:SetSize(18)
        basicPropertiesLabel:SetText("Basic Properties")
        basicPropertiesLabel:SetLeftMargin(20)
        panel:Add(basicPropertiesLabel)
        // Its text is the section's title, under a header that opens and
        // closes it when the panel shows several sections.
        SetHeading(basicPropertiesLabel)

        Control nameCard = AddCard(panel, "")
        nameField = AddField(nameCard, "Name", "Name", focusArray)

        Control placeCard = AddCard(panel, "Place")
        Array<TextField> position = AddTriple(placeCard, "Position", "X", "Y", "Z", "x", "y", "z", focusArray)
        positionXField = position:Get(0)
        positionYField = position:Get(1)
        positionZField = position:Get(2)
        // Scale and rotation are sliders, each with a field for exact
        // numbers. Scale is spread by ratios, 0.01 to 1000 with 1 in the
        // middle; any other number but 0 can be typed. Rotation is in
        // degrees, and any number can be typed.
        placeCard:Add(MakeLabelLine("Scale"))
        Control proportionsLine = MakeCardLine()
        proportionsLine:SetTopMargin(0)
        Checkbox proportionsCheckbox
        keepProportionsCheckbox = proportionsCheckbox
        keepProportionsCheckbox:SetName("Keep proportions")
        keepProportionsCheckbox:SetDescription("Changing one scale changes the other two by the same amount, so the item keeps its shape")
        keepProportionsCheckbox:SetToggleState(true)
        proportionsLine:Add(keepProportionsCheckbox)
        placeCard:Add(proportionsLine)
        focusArray:Add(keepProportionsCheckbox)
        scaleXField = AddPlaceSlider(placeCard, focusArray, "x", "X Scale", "The item's size along x: 1 is its own size", 0.01, 1000, 1.05, 2, true, "")
        scaleYField = AddPlaceSlider(placeCard, focusArray, "y", "Y Scale", "The item's size along y: 1 is its own size", 0.01, 1000, 1.05, 2, true, "")
        scaleZField = AddPlaceSlider(placeCard, focusArray, "z", "Z Scale", "The item's size along z: 1 is its own size", 0.01, 1000, 1.05, 2, true, "")

        placeCard:Add(MakeLabelLine("Rotation"))
        rotationYawField = AddPlaceSlider(placeCard, focusArray, "yaw", "Yaw", "The turn left or right, in degrees", -180, 180, 1, 15, false, "degrees")
        rotationPitchField = AddPlaceSlider(placeCard, focusArray, "pitch", "Pitch", "The tilt up or down, in degrees", -90, 90, 1, 15, false, "degrees")
        rotationRollField = AddPlaceSlider(placeCard, focusArray, "roll", "Roll", "The lean to either side, in degrees", -180, 180, 1, 15, false, "degrees")

        // For a new item's preview only (SetFields shows it).
        Control followLine = MakeCardLine()
        followGroundLine = followLine
        Checkbox followCheckbox
        followGroundCheckbox = followCheckbox
        followGroundCheckbox:SetName("Follow the ground")
        followGroundCheckbox:SetDescription("The arrow keys keep it the same height above the ground")
        PropertiesFollowGroundBehavior followBehavior
        followBehavior:SetDialog(me)
        followGroundCheckbox:SetBehavior(followBehavior)
        followGroundLine:Add(followGroundCheckbox)
        placeCard:Add(followGroundLine)
        focusArray:Add(followGroundCheckbox)

        // For a new item's preview only, as Follow the ground is.
        Control leanLine = MakeCardLine()
        leanWithSlopeLine = leanLine
        Checkbox leanCheckbox
        leanWithSlopeCheckbox = leanCheckbox
        leanWithSlopeCheckbox:SetName("Lean with the slope")
        leanWithSlopeCheckbox:SetDescription("Set on the ground by the pointer, it leans with the ground's slope, as foliage can")
        PropertiesLeanWithSlopeBehavior leanBehavior
        leanBehavior:SetDialog(me)
        leanWithSlopeCheckbox:SetBehavior(leanBehavior)
        leanWithSlopeLine:Add(leanWithSlopeCheckbox)
        placeCard:Add(leanWithSlopeLine)
        focusArray:Add(leanWithSlopeCheckbox)

        // The Look card: Override color, and a well for the color. Choosing
        // a color in the well turns Override color on.
        Control lookCard = AddCard(panel, "Look")
        Control colorLine = MakeCardLine()
        Checkbox overrideCheckbox
        overrideColorCheckbox = overrideCheckbox
        overrideColorCheckbox:SetName("Override color")
        overrideColorCheckbox:SetDescription("Show the chosen color over the item's own colors; unchecked, its own colors come back")
        PropertiesOverrideColorBehavior overrideBehavior
        overrideBehavior:SetDialog(me)
        overrideColorCheckbox:SetBehavior(overrideBehavior)
        overrideColorCheckbox:SetRightMargin(12)
        colorLine:Add(overrideColorCheckbox)
        ColorWell well
        colorWell = well
        colorWell:SetName("Color")
        PropertiesColorWellListener wellListener
        wellListener:SetDialog(me)
        colorWell:AddColorWellListener(wellListener)
        colorLine:Add(colorWell)
        lookCard:Add(colorLine)
        focusArray:Add(overrideColorCheckbox)
        focusArray:Add(colorWell)

        // The Parts card, filled for each selected model (ShowPartsCard).
        partsTitlePart = MakeCardTitle("Parts")
        panel:Add(partsTitlePart)
        partsCardPart = MakeCard()
        panel:Add(partsCardPart)
        partsTitlePart:Hide()
        partsCardPart:Hide()

        panel:Add(MakeCardTitle("Physics"))
        Control physicsCard = MakeCard()
        panel:Add(physicsCard)
        physicsCardPart = physicsCard
        Control noteCard = MakeCard()
        Control noteLine = MakeCardLine()
        Label note
        physicsNote = note
        physicsNote:SetText("Set by the Vehicle controller, in the Controller section: mass, the physics box, tires and driving.")
        physicsNote:SetFocusable(true)
        noteLine:Add(physicsNote)
        noteCard:Add(noteLine)
        panel:Add(noteCard)
        physicsNotePart = noteCard
        physicsNotePart:Hide()
        Control physicsLine = MakeCardLine()
        Checkbox physicsCheckbox
        physicsEnabledCheckbox = physicsCheckbox
        physicsEnabledCheckbox:SetName("Physics Enabled")
        PropertiesEnablePhysicsBehavior propertiesEnablePhysicsBehavior
        propertiesEnablePhysicsBehavior:SetDialog3D(me)
        physicsEnabledCheckbox:SetBehavior(propertiesEnablePhysicsBehavior)
        physicsLine:Add(physicsEnabledCheckbox)
        physicsCard:Add(physicsLine)
        focusArray:Add(physicsEnabledCheckbox)

        // The three ways an item responds, side by side on one line.
        Control responsivenessLine = MakeCardLine()
        ButtonGroup group
        responsivenessGroup = group
        responsivenessGroup:SetName("Responsiveness")
        responsivenessGroup:SetHorizontalLayoutMode(responsivenessLine:FILL)
        responsivenessGroup:SetVerticalLayoutMode(responsivenessLine:FIT_CONTENTS)
        FlowLayout groupLayout
        responsivenessGroup:SetLayout(groupLayout)
        RadioButton unmovableButton
        unmovableButton:SetName("Unmovable")
        RadioButton nonResponsiveButton
        nonResponsiveButton:SetName("Nonresponsive")
        RadioButton responsiveButton
        responsiveButton:SetName("Responsive")
        AddChoice(unmovableButton)
        AddChoice(nonResponsiveButton)
        AddChoice(responsiveButton)
        responsivenessGroup:AddSelectionListener(me)
        responsivenessLine:Add(responsivenessGroup)
        physicsCard:Add(responsivenessLine)
        focusArray:Add(responsivenessGroup)

        massField = AddField(physicsCard, "Mass", "Mass", focusArray)
        frictionField = AddField(physicsCard, "Friction", "Friction", focusArray)
        restitutionField = AddField(physicsCard, "Restitution", "Restitution", focusArray)
    end

    /*
        Adds one of the responsiveness choices to its group, a third of the
        line wide, in the order SetFields counts them.
    */
    private action AddChoice(RadioButton button)
        button:SetPercentageWidth(0.333)
        button:SetPixelWidth(-CELL_GAP)
        button:SetRightMargin(CELL_GAP)
        responsivenessGroup:AddToGrouping(button)
        responsivenessGroup:Add(button)
    end

    /*
        Makes the start of a card's line: the line, and its label in a box
        of one width, so the fields after the labels line up.
    */
    private action MakeLabeledLine(text label) returns Control
        Control line = MakeCardLine()
        FlowLayout labelLayout
        Control labelBox
        labelBox:SetLayout(labelLayout)
        labelBox:SetPercentageWidth(0)
        labelBox:SetPixelWidth(FIELD_LABEL_WIDTH)
        labelBox:SetVerticalLayoutMode(labelBox:FIT_CONTENTS)
        labelBox:SetRightMargin(8)
        Label fieldLabel
        fieldLabel:SetText(label)
        labelBox:Add(fieldLabel)
        line:Add(labelBox)
        return line
    end

    /*
        Adds a line to a card with a label and one field filling the rest.

        Attribute: Parameter card The card
        Attribute: Parameter label The label shown
        Attribute: Parameter name The field's name, as a screen reader says it
        Attribute: Parameter focusArray The section's focus order
        Attribute: Returns The field
    */
    private action AddField(Control card, text label, text name, Array<Control> focusArray) returns TextField
        Control line = MakeLabeledLine(label)
        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:AddTextChangeListener(me)
        field:SetHorizontalLayoutMode(line:FILL)
        line:Add(field)
        card:Add(line)
        focusArray:Add(field)
        return field
    end

    /*
        Adds a label on its own line, then a line of three fields of the
        same width, each after a small tag, such as x, y and z. The label
        sits above, so the fields have the card's whole width.

        Attribute: Parameter card The card
        Attribute: Parameter label The label shown
        Attribute: Parameter firstName The first field's name, as a screen reader says it
        Attribute: Parameter secondName The second field's name
        Attribute: Parameter thirdName The third field's name
        Attribute: Parameter firstTag The small tag before the first field
        Attribute: Parameter secondTag The tag before the second field
        Attribute: Parameter thirdTag The tag before the third field
        Attribute: Parameter focusArray The section's focus order
        Attribute: Returns The three fields, in order
    */
    private action AddTriple(Control card, text label, text firstName, text secondName, text thirdName,
            text firstTag, text secondTag, text thirdTag, Array<Control> focusArray) returns Array<TextField>
        card:Add(MakeLabelLine(label))
        Control line = MakeCardLine()
        line:SetTopMargin(0)
        Array<TextField> made
        made:Add(AddTaggedField(line, firstName, firstTag, focusArray))
        made:Add(AddTaggedField(line, secondName, secondTag, focusArray))
        made:Add(AddTaggedField(line, thirdName, thirdTag, focusArray))
        card:Add(line)
        return made
    end

    /*
        Adds a slider line to the Place card: a short label, a slider and a
        field for exact numbers, both in the focus order. A number beyond the
        slider's range can still be typed, and is kept. Returns the field,
        which the dialog listens to as it does its other fields.

        Attribute: Parameter card The card
        Attribute: Parameter focusArray The section's focus order
        Attribute: Parameter label The short label before the slider, such as "x"
        Attribute: Parameter name The name screen readers say, such as "X Scale"
        Attribute: Parameter description What the setting does
        Attribute: Parameter minimum The slider's least value
        Attribute: Parameter maximum The slider's greatest value
        Attribute: Parameter step One key press's change, a factor if spread by ratio
        Attribute: Parameter pageStep Page Up's and Page Down's change, a factor if spread by ratio
        Attribute: Parameter byRatio True to spread the slider by ratios
        Attribute: Parameter units A word screen readers say after the value, or ""
        Attribute: Returns The field
    */
    private action AddPlaceSlider(Control card, Array<Control> focusArray, text label, text name, text description,
            number minimum, number maximum, number step, number pageStep, boolean byRatio, text units) returns TextField
        SliderField sliderField = MakeSliderField(label, name, description, minimum, maximum, step, pageStep, PLACE_LABEL_WIDTH)
        sliderField:SetAllowsValuesBeyondRange(true)
        if byRatio
            sliderField:SetLogarithmic(true)
            sliderField:SetDecimalPlaces(2)
        end
        if units not= ""
            sliderField:SetUnits(units)
        end
        TextField field = sliderField:GetField()
        field:AddTextChangeListener(me)
        card:Add(sliderField)
        focusArray:Add(sliderField:GetSlider())
        focusArray:Add(field)
        return field
    end

    /*
        Makes a line holding only a label, for the three-field rows, whose
        label sits above their fields.
    */
    private action MakeLabelLine(text label) returns Control
        Control line = MakeCardLine()
        line:SetBottomMargin(2)
        Label lineLabel
        lineLabel:SetText(label)
        line:Add(lineLabel)
        return line
    end

    /*
        Adds one of a line's three fields: a third of the line wide, less
        its margin so three always fit, with its small tag first, in the
        section title's color.
    */
    private action AddTaggedField(Control fields, text name, text tag, Array<Control> focusArray) returns TextField
        FlowLayout cellLayout
        Control cell
        cell:SetLayout(cellLayout)
        cell:SetPercentageWidth(0.333)
        cell:SetPixelWidth(-CELL_GAP)
        cell:SetVerticalLayoutMode(cell:FIT_CONTENTS)
        cell:SetRightMargin(CELL_GAP)
        Label tagLabel = MakeCardTitle(tag)
        tagLabel:SetSize(12)
        tagLabel:SetLeftMargin(0)
        tagLabel:SetTopMargin(0)
        tagLabel:SetBottomMargin(0)
        tagLabel:SetRightMargin(4)
        cell:Add(tagLabel)
        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:AddTextChangeListener(me)
        field:SetHorizontalLayoutMode(cell:FILL)
        cell:Add(field)
        fields:Add(cell)
        focusArray:Add(field)
        return field
    end

    /*
        This action Shows or Hides the dialog based on what gains selection. Only if a model or 3D primitive is selected
        will this dialog show. If there is no selection or the selected item is not a model then the dialog
        will hide or stay hidden.
    */
    action SelectionChanged(SelectionEvent event)
        // TO-DO: Consider change to Layer in VisualEditorSelection

        if event:GetSelection() is SceneEditorSelection
            SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
            if selection:IsItemSelected() = false
                if IsShowing()
                    Hide()
                end
            else
                Item selectedItem = selection:GetSelectedItem()
                if selectedItem is ModelSelectionHighlight or selectedItem is ModelPreview or selectedItem is Custom3DPrimitivePreview
                    SetFields(cast(EditorItem3D, selectedItem))
                    if not IsShowing()
                        Show()
                    end
                else
                    if IsShowing()
                        Hide()
                    end
                end
            end
        elseif event:GetSelection() is ButtonGroupSelection
            ButtonGroupSelection selection = cast(ButtonGroupSelection, event:GetSelection())
            EditorItem item = GetSceneEditor():GetSelectedItem()
            if item not= undefined
                integer index = selection:GetIndex()
                item:SetEditorResponsiveness(index)

                // If the item is responsive, adjust the default mass to be non-zero
                if index = 2 and item:GetEditorMass() = 0
                    item:SetEditorMass(1)
                    massField:SetText("" + item:GetEditorMass())
                end
            end
        end
    end

    /*
        This action takes an EditorItem and sets the fields in the dialog based on its
        properties
    */
    action SetFields(EditorItem item)
        if item is EditorItem3D = false
            return now
        end

        SetFields(cast(EditorItem3D, item))
    end

    /*
        This action takes an EditorItem2D and sets the fields in the dialog based on its
        properties
    */
    action SetFields(EditorItem3D item)
        // The Follow the ground line is only for a new item's preview.
        settingFields = true
        if item is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, item)
            followGroundCheckbox:SetToggleState(preview:IsFollowingGround())
            followGroundLine:Show()
            leanWithSlopeCheckbox:SetToggleState(preview:IsLeaningWithSlope())
            leanWithSlopeLine:Show()
        else
            followGroundLine:Hide()
            leanWithSlopeLine:Hide()
        end
        settingFields = false
        nameField:SetText(item:GetName())
        positionXField:SetText("" + item:GetX())
        positionYField:SetText("" + item:GetY())
        positionZField:SetText("" + item:GetZ())
        scaleXField:SetText("" + item:GetScaleX())
        scaleYField:SetText("" + item:GetScaleY())
        scaleZField:SetText("" + item:GetScaleZ())
        rotationYawField:SetText("" + item:GetYaw())
        rotationPitchField:SetText("" + item:GetPitch())
        rotationRollField:SetText("" + item:GetRoll())
        
        settingFields = true
        overrideColorCheckbox:SetToggleState(item:IsColorOverridden())
        Color color = item:GetColor()
        if color not= undefined
            Color shown = color:Copy()
            shown:SetAlpha(1.0)
            colorWell:SetColor(shown)
        end
        settingFields = false

        physicsEnabledCheckbox:SetToggleState(item:IsEditorPhysicsEnabled())
        
        integer responsive = item:GetEditorResponsiveness()
        responsivenessGroup:GetButtonAt(responsive):SetToggleState(true)

        massField:SetText("" + item:GetEditorMass())
        frictionField:SetText("" + item:GetEditorFriction())
        restitutionField:SetText("" + item:GetEditorRestitution())
        ShowPartsCard(item)
        ShowPhysicsPart(item)
    end

    /*
        Fills the Parts card with a checkbox for each part name of a selected
        model, checked if those parts are shown, or hides the card if the
        model has fewer than two names.
    */
    private action ShowPartsCard(EditorItem3D item)
        EditorModel model = undefined
        if item is ModelSelectionHighlight
            ModelSelectionHighlight highlight = cast(ModelSelectionHighlight, item)
            model = highlight:GetEditorModel()
        end
        Array<text> names
        if model not= undefined
            integer part = 0
            repeat while part < model:GetPartCount()
                text partName = model:GetPartName(part)
                if not names:Has(partName)
                    names:Add(partName)
                end
                part = part + 1
            end
        end
        // The checkboxes are made again for each model.
        integer i = 0
        repeat while i < partLines:GetSize()
            partsCardPart:Remove(partLines:Get(i))
            i = i + 1
        end
        partLines:Empty()
        partCheckboxes:Empty()
        partsModel = model
        if names:GetSize() < 2
            partsTitlePart:Hide()
            partsCardPart:Hide()
            partsCardPart:RequestLayout()
            return now
        end
        settingFields = true
        i = 0
        repeat while i < names:GetSize()
            text name = names:Get(i)
            text label = name
            if label = ""
                label = "unnamed parts"
            end
            Control line = MakeCardLine()
            Checkbox box
            box:SetName("Show " + label)
            box:SetDescription("Draw this part of the model. Hidden parts aren't drawn, and Fit to model leaves them out. The model's file isn't changed.")
            box:SetToggleState(IsNameShown(model, name))
            PropertiesPartBehavior behavior
            behavior:Setup(me, box, name)
            box:SetBehavior(behavior)
            line:Add(box)
            partsCardPart:Add(line)
            partLines:Add(line)
            partCheckboxes:Add(box)
            i = i + 1
        end
        settingFields = false
        partsTitlePart:Show()
        partsCardPart:Show()
        partsCardPart:RequestLayout()
    end

    /*
        Returns true if every part of a model with a name is shown.
    */
    private action IsNameShown(EditorModel model, text name) returns boolean
        integer part = 0
        repeat while part < model:GetPartCount()
            if model:GetPartName(part) = name and not model:IsPartShown(part)
                return false
            end
            part = part + 1
        end
        return true
    end

    /*
        This action is called when a part's checkbox in the Parts card is
        checked or unchecked: the part is shown or hidden, as one step to
        undo.

        Attribute: Parameter name The part's name in the model's file
        Attribute: Parameter shown True to draw it
    */
    action PartToggled(text name, boolean shown)
        if settingFields or partsModel = undefined or GetSceneEditor() = undefined
            return now
        end
        GetSceneEditor():SetModelPartShown(partsModel, name, shown)
    end

    /*
        Shows the Physics card, or, for a model with a controller, the note
        saying its physics is set in the Controller section, and puts the
        shown controls in Tab order.
    */
    private action ShowPhysicsPart(EditorItem3D item)
        boolean controlled = false
        if item is ModelSelectionHighlight and GetSceneEditor() not= undefined
            ModelSelectionHighlight highlight = cast(ModelSelectionHighlight, item)
            controlled = GetSceneEditor():GetControllerSettings(highlight:GetEditorModel()) not= undefined
        end
        Control first = GetFirstFocus()
        // After the Look card, the Parts card's checkboxes, if it shows.
        Control afterLook = colorWell
        integer i = 0
        repeat while i < partCheckboxes:GetSize()
            afterLook:SetNextFocus(partCheckboxes:Get(i))
            partCheckboxes:Get(i):SetPreviousFocus(afterLook)
            afterLook = partCheckboxes:Get(i)
            i = i + 1
        end
        if controlled
            physicsCardPart:Hide()
            physicsNotePart:Show()
            afterLook:SetNextFocus(physicsNote)
            physicsNote:SetPreviousFocus(afterLook)
            physicsNote:SetNextFocus(first)
            first:SetPreviousFocus(physicsNote)
            SetLastFocus(physicsNote)
        else
            physicsNotePart:Hide()
            physicsCardPart:Show()
            afterLook:SetNextFocus(physicsEnabledCheckbox)
            physicsEnabledCheckbox:SetPreviousFocus(afterLook)
            restitutionField:SetNextFocus(first)
            first:SetPreviousFocus(restitutionField)
            SetLastFocus(restitutionField)
        end
        physicsCardPart:RequestLayout()
        physicsNotePart:RequestLayout()
    end

    /*
        Updates the properties of the selected item as text is changed in any text field in the dialog.
        If the text is updated to any invalid values the text is ignored. 
    */
    action TextChanged(TextChangeEvent event)
        EditorItem3D currentItem = cast(EditorItem3D, GetSceneEditor():GetSelectedItem())
        Control control = event:GetControl()

        if currentItem = undefined
            return now
        end

        if control:Equals(nameField)
            if nameField:GetText() not= currentItem:GetName()
                currentItem:SetName(nameField:GetText())
            end
        elseif control:Equals(positionXField)
            check
                number value = positionXField:GetText():ParseNumber()
                if value not= currentItem:GetX()
                    currentItem:SetX(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(positionYField)
            check
                number value = positionYField:GetText():ParseNumber()
                if value not= currentItem:GetY()
                    currentItem:SetY(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(positionZField)
            check
                number value = positionZField:GetText():ParseNumber()
                if value not= currentItem:GetZ()
                    currentItem:SetZ(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleXField)
            check
                number value = scaleXField:GetText():ParseNumber()
                ChangeScale(currentItem, 0, value)
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleYField)
            check
                number value = scaleYField:GetText():ParseNumber()
                ChangeScale(currentItem, 1, value)
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(scaleZField)
            check
                number value = scaleZField:GetText():ParseNumber()
                ChangeScale(currentItem, 2, value)
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationYawField)
            check
                number value = rotationYawField:GetText():ParseNumber()

                if value not= currentItem:GetYaw()
                    currentItem:SetRotation(value, currentItem:GetPitch(), currentItem:GetRoll())
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationPitchField)
            check
                number value = rotationPitchField:GetText():ParseNumber()

                if value not= currentItem:GetPitch()
                    currentItem:SetRotation(currentItem:GetYaw(), value, currentItem:GetRoll())
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(rotationRollField)
            check
                number value = rotationRollField:GetText():ParseNumber()

                if value not= currentItem:GetRoll()
                    currentItem:SetRotation(currentItem:GetYaw(), currentItem:GetPitch(), value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(massField)
            check
                number value = massField:GetText():ParseNumber()

                if value not= currentItem:GetEditorMass()
                    currentItem:SetEditorMass(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(frictionField)
            check
                number value = frictionField:GetText():ParseNumber()

                if value not= currentItem:GetEditorFriction()
                    currentItem:SetEditorFriction(value)
                end
            detect e is Error
                // Do nothing.
            end
        elseif control:Equals(restitutionField)
            check
                number value = restitutionField:GetText():ParseNumber()

                if value not= currentItem:GetEditorRestitution()
                    currentItem:SetEditorRestitution(value)
                end
            detect e is Error
                // Do nothing.
            end
        end
    end

    /*
        This action enables physics on the selected item. This action is called by the activation behavior
        of the physics enabled checkbox.
    */
    /*
        This action sets whether the selected new item's preview follows
        the ground with the arrow keys. The Follow the ground checkbox calls
        it.

        Attribute: Parameter follow True to follow the ground
    */
    action SetFollowGround(boolean follow)
        if settingFields
            return now
        end
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if item is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, item)
            preview:SetFollowingGround(follow)
        end
    end

    /*
        This action sets whether the selected new item's preview leans with
        the ground's slope when the pointer sets it on the ground. The Lean
        with the slope checkbox calls it.

        Attribute: Parameter lean True to lean with the slope
    */
    action SetLeanWithSlope(boolean lean)
        if settingFields
            return now
        end
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if item is ItemPreview3D
            ItemPreview3D preview = cast(ItemPreview3D, item)
            preview:SetLeaningWithSlope(lean)
        end
    end

    /*
        Changes one of an item's scales, as its field or slider asks. A
        scale of 0 is ignored, as is no change. With Keep proportions on, the
        other two change by the same ratio, so the item keeps its shape, and
        their fields show them; the field being changed is left alone, so
        typing in it isn't interrupted.

        Attribute: Parameter item The item
        Attribute: Parameter axis 0 for x, 1 for y, 2 for z
        Attribute: Parameter value The new scale
    */
    private action ChangeScale(EditorItem3D item, integer axis, number value)
        number before = item:GetScaleX()
        if axis = 1
            before = item:GetScaleY()
        elseif axis = 2
            before = item:GetScaleZ()
        end
        if value = 0 or value = before
            return now
        end
        if keepProportionsCheckbox = undefined or not keepProportionsCheckbox:GetToggleState() or before = 0
            if axis = 0
                item:SetScaleX(value)
            elseif axis = 1
                item:SetScaleY(value)
            else
                item:SetScaleZ(value)
            end
            return now
        end
        number ratio = value / before
        number newX = item:GetScaleX() * ratio
        number newY = item:GetScaleY() * ratio
        number newZ = item:GetScaleZ() * ratio
        // The axis asked for gets exactly the number given.
        if axis = 0
            newX = value
        elseif axis = 1
            newY = value
        else
            newZ = value
        end
        // The item first, so the other fields' changes below find nothing
        // left to change.
        item:SetScaleX(newX)
        item:SetScaleY(newY)
        item:SetScaleZ(newZ)
        if axis not= 0
            scaleXField:SetText("" + newX)
        end
        if axis not= 1
            scaleYField:SetText("" + newY)
        end
        if axis not= 2
            scaleZField:SetText("" + newZ)
        end
    end

    /*
        This action turns Override color on or off for the selected item: on,
        the well's color shows over its own colors; off, its own colors come
        back. The Override color checkbox calls it.

        Attribute: Parameter override True to show the chosen color
    */
    action SetOverrideColor(boolean override)
        if settingFields
            return now
        end
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if not (item is EditorItem3D)
            return now
        end
        EditorItem3D item3D = cast(EditorItem3D, item)
        if override
            ShowChosenColor(item3D)
        else
            item3D:RestoreColor()
        end
    end

    /*
        This action is called as a color is chosen in the Look card's well:
        it shows over the selected item's own colors, and Override color
        turns on.

        Attribute: Parameter color The color chosen
    */
    action ColorChosen(Color color)
        if settingFields or color = undefined
            return now
        end
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if not (item is EditorItem3D)
            return now
        end
        if not overrideColorCheckbox:GetToggleState()
            settingFields = true
            overrideColorCheckbox:SetToggleState(true)
            settingFields = false
        end
        ShowChosenColor(cast(EditorItem3D, item))
    end

    /*
        Puts the well's color over an item's own colors. A new item's preview
        stays see-through, as it was made.
    */
    private action ShowChosenColor(EditorItem3D item)
        Color chosen = colorWell:GetColor():Copy()
        if item is ItemPreview3D and item:GetColor() not= undefined
            chosen:SetAlpha(item:GetColor():GetAlpha())
        else
            chosen:SetAlpha(1.0)
        end
        item:OverrideColor(chosen)
    end

    action SetPhysicsEnabled(boolean enabled)
        EditorItem item = GetSceneEditor():GetSelectedItem()
        if item not= undefined and item:IsEditorPhysicsEnabled() not= enabled
            item:SetEditorPhysicsEnabled(enabled)
            // An item with physics needs its layer's physics on in games.
            if enabled
                GetSceneEditor():TurnOnLayerPhysicsIfNeeded()
            end
        end
    end

    /*
    Moves the focus to one of the fields in the properties dialog. By default
    this is the name field (the first field in the panel), but it could also be
    changed to a different field, possibly context sensitive.
    */
    action FocusField
        nameField:Focus()
        nameField:Select(0, nameField:GetSize(), true)
    end

    /*
        Sets the text of the name field. 
    */
    action SetNameField(text name)
        nameField:RemoveTextChangeListener(me)
        nameField:SetText(name)
        nameField:AddTextChangeListener(me)
    end
end