package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Controls.FileChooser
use Libraries.Interface.Controls.FileFilter
use Libraries.Interface.Controls.SliderField
use Libraries.Interface.Events.SliderChangedEvent
use Libraries.Interface.Events.TerrainFoliageSliderListener
use Libraries.Game.Graphics.Label
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Item
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TerrainFoliageFieldListener
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.PropertiesFoldItem
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.Items.Highlights.TerrainSelectionHighlight
use Libraries.Interface.Behaviors.Scenes.Properties.TerrainFoliageButtonBehavior
use Libraries.Game.Graphics.Worlds.FoliageList
use Libraries.Game.Graphics.Worlds.FoliageAsset
use Libraries.Game.Graphics.Worlds.TerrainFoliage
use Libraries.Game.Graphics.Models.Data.Material
use Libraries.System.File

/*
    The TerrainFoliagePropertiesDialog is a selected terrain's Foliage
    section: the foliage assets it can be covered with,
    such as trees, rocks and grass. "Add asset..." adds a model file, drawn
    as itself, or a picture, drawn as a card; a terrain with no foliage list
    is given one in the project's Scenes/Foliage folder. Which asset the
    Foliage tool paints is chosen in the Brush section.

    Each asset is a part that folds, as the Water section's lakes do: a
    header with the asset's name, and a line under it saying whether it is
    a model or a card and how many copies it has. Assets are listed in
    alphabetical order; their order in the list file means nothing to how
    the foliage is drawn, so it can't be changed here. Opening an asset shows its name, its settings
    in groups that fold (Placement, Lean and turn, Color and wind, Levels
    of detail, Shadows) and Remove. One asset is open at a time. Settings
    are taken when the focus leaves a field. Settings with a bounded range,
    such as the slopes, lean, turn, tint, hue and wind, are a slider with a
    number field; they are taken on each key press, at the end of a drag,
    or when the focus leaves the number field.

    It shows in the scene editor's Properties panel, after the Materials
    section.
*/
class TerrainFoliagePropertiesDialog is PropertiesDialog
    // What a button does. PAINT, SETTINGS, CLOSE_SETTINGS, MOVE_UP and
    // MOVE_DOWN are no longer used by the section (its parts fold now, the
    // Brush section chooses the asset to paint, and assets are listed
    // alphabetically), and are kept so their numbers stay the same.
    public constant integer ADD = 0
    public constant integer PAINT = 1
    public constant integer SETTINGS = 2
    public constant integer REMOVE = 3
    public constant integer MOVE_UP = 4
    public constant integer MOVE_DOWN = 5
    public constant integer CLOSE_SETTINGS = 6
    public constant integer RANDOM_TURN = 7
    public constant integer CASTS_SHADOWS = 8
    public constant integer ALIGN_TO_NORMAL = 9
    // A level of detail's Choose... button; the button's asset number is
    // the level, from 1.
    public constant integer CHOOSE_LEVEL = 10

    // The parts that fold: an asset's is ASSET_PART plus its number, a
    // settings group's GROUP_PART plus its number.
    constant integer ASSET_PART = 100
    constant integer GROUP_PART = 200

    // The settings groups, by number.
    constant integer PLACEMENT_GROUP = 0
    constant integer LEAN_GROUP = 1
    constant integer COLOR_GROUP = 2
    constant integer LEVELS_GROUP = 3
    constant integer SHADOWS_GROUP = 4
    constant integer GROUP_COUNT = 5

    // How far in from the section's edge an asset's header and a group's
    // header are, in pixels before the interface scale.
    constant number TOP_INDENT = 14
    constant number INNER_INDENT = 34

    // How wide the settings' labels are, so the fields line up.
    constant number FIELD_LABEL_WIDTH = 120

    Control sectionPanel = undefined
    Label statusLabel = undefined
    Control assetsPanel = undefined
    Button addButton = undefined

    // Each asset's part, by the asset's number in the list: its header
    // row, its fold, and the line saying its kind and copies.
    Array<Control> titleLines
    Array<PropertiesFoldItem> assetFolds
    Array<Label> kindLabels
    Array<Control> assetsShown
    integer rowsShown = 0

    // The assets' numbers in alphabetical order of their names, as shown.
    Array<integer> shownOrder

    // The open asset, or -1. Its body (name, groups and Remove) is shown
    // under its kind line; there is one body, filled for the open asset.
    integer settingsAsset = -1
    Control bodyPanel = undefined
    Control nameCard = undefined
    Control removeLine = undefined
    Button removeButton = undefined
    Array<Control> bodyShown

    // The settings groups: each one's header row, fold, card, whether it is
    // open, and its controls in the order shown, for the Tab order.
    Array<Control> groupRows
    Array<PropertiesFoldItem> groupFolds
    Array<Control> groupCards
    Array<boolean> groupOpen
    Array<Control> groupControls
    Array<integer> groupOfControl

    // The settings fields, by place (the FIELD names below), and the
    // checkboxes. A setting with a bounded range is a slider with a number
    // field: its SliderField is at its place in
    // settingsSliders, and its number field at its place in settingsFields;
    // other places in settingsSliders are undefined.
    Array<TextField> settingsFields
    Array<SliderField> settingsSliders
    Checkbox randomTurnCheckbox = undefined
    Checkbox shadowsCheckbox = undefined
    Checkbox alignCheckbox = undefined

    // The settings fields, by place.
    constant integer NAME_FIELD = 0
    constant integer DENSITY_FIELD = 1
    constant integer SCALE_FIELD = 2
    constant integer RANDOM_SCALE_FIELD = 3
    constant integer SHADE_FIELD = 4
    constant integer LOWEST_SLOPE_FIELD = 5
    constant integer STEEPEST_SLOPE_FIELD = 6
    constant integer OFFSET_FIELD = 7
    constant integer DISTANCE_FIELD = 8
    // The wind and the levels of detail: each level has a
    // file field and a distance field, level 1's first.
    constant integer WIND_FIELD = 9
    constant integer FIRST_LEVEL_FIELD = 10
    constant integer LEVEL_FIELD_COUNT = 3
    // Shadow levels, placement and fading, after the levels' fields.
    constant integer LAST_SHADOW_FIELD = 16
    constant integer SHADOW_LEVEL_FIELD = 17
    constant integer TILT_FIELD = 18
    constant integer RANDOM_TILT_FIELD = 19
    constant integer TURN_FIELD = 20
    // The tint's red; its green and blue are TINT_GREEN_FIELD and
    // TINT_BLUE_FIELD, after FADE_FIELD, with the wind's direction.
    constant integer TINT_FIELD = 21
    constant integer HUE_FIELD = 22
    constant integer FADE_FIELD = 23
    constant integer TINT_GREEN_FIELD = 24
    constant integer TINT_BLUE_FIELD = 25
    constant integer WIND_DIRECTION_FIELD = 26
    constant integer FIELD_COUNT = 27

    // The terrain whose foliage is shown, or undefined.
    EditorTerrain terrain = undefined

    // True while the fields are being filled, so filling them isn't taken
    // as typing.
    boolean updating = false

    /*
        Creates and adds the interface components for this dialog.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Terrain Foliage")
        sectionPanel = panel

        Label headingLabel
        headingLabel:SetSize(18)
        headingLabel:SetText("Foliage")
        headingLabel:SetLeftMargin(20)
        panel:Add(headingLabel)
        SetHeading(headingLabel)

        Label status
        statusLabel = status
        statusLabel:SetText("")
        statusLabel:SetHorizontalLayoutMode(statusLabel:parent:Control:STANDARD)
        statusLabel:SetPercentageWidth(1.0)
        statusLabel:SetLeftMargin(20)
        statusLabel:SetRightMargin(20)
        statusLabel:SetTopMargin(6)
        statusLabel:SetBottomMargin(4)
        statusLabel:SetFocusable(true)
        panel:Add(statusLabel)
        focusArray:Add(statusLabel)

        Control assets
        assetsPanel = assets
        FlowLayout assetsLayout
        assetsPanel:SetLayout(assetsLayout)
        assetsPanel:SetPercentageWidth(1.0)
        assetsPanel:SetVerticalLayoutMode(assetsPanel:FIT_CONTENTS)
        panel:Add(assetsPanel)

        FoliageList sizes
        integer index = 0
        repeat while index < sizes:MAXIMUM_ASSETS
            MakeAssetPart(index)
            index = index + 1
        end

        MakeBody()

        Control addLine = MakeLine()
        addButton = MakeButton(addLine, "Add asset...", "Choose a model file, drawn as itself, or a picture, drawn as a card, to add as a foliage asset", ADD, 0)
        panel:Add(addLine)
        focusArray:Add(addButton)
    end

    /*
        Makes one asset's part: a header that folds, with the asset's name,
        and a line under it for its kind and copies.
    */
    private action MakeAssetPart(integer index)
        PropertiesFoldItem fold
        fold:SetName("Asset " + (index + 1))
        fold:ShowOpen(false)
        Control titleLine = MakeFoldRow(fold, ASSET_PART + index, TOP_INDENT)
        titleLine:SetTopMargin(6)

        Label kind
        kind:SetText("")
        kind:SetLeftMargin(TOP_INDENT + 26)
        kind:SetRightMargin(20)
        kind:SetBottomMargin(2)
        kind:SetFocusable(false)

        titleLines:Add(titleLine)
        assetFolds:Add(fold)
        kindLabels:Add(kind)
    end

    /*
        Makes the open asset's body: its name, the settings groups, each a
        part that folds with a card of its fields, and Remove. The fields
        are made in the order shown, each put at its place among the
        settings fields.
    */
    private action MakeBody
        Control panel
        bodyPanel = panel
        FlowLayout layout
        bodyPanel:SetLayout(layout)
        bodyPanel:SetPercentageWidth(1.0)
        bodyPanel:SetVerticalLayoutMode(bodyPanel:FIT_CONTENTS)

        integer i = 0
        repeat while i < FIELD_COUNT
            settingsFields:Add(undefined)
            settingsSliders:Add(undefined)
            i = i + 1
        end

        nameCard = MakeCard()
        nameCard:SetLeftMargin(INNER_INDENT)
        AddSettingsField(nameCard, NAME_FIELD, -1, "Name:", "Asset name")

        Control placement = MakeGroup(PLACEMENT_GROUP, "Placement")
        AddSettingsField(placement, DENSITY_FIELD, PLACEMENT_GROUP, "Density:", "Copies per square unit the brush places")
        AddSettingsField(placement, SCALE_FIELD, PLACEMENT_GROUP, "Scale:", "Each copy's base scale")
        AddSliderSetting(placement, RANDOM_SCALE_FIELD, PLACEMENT_GROUP, "Size varies", "How much each copy's size varies, as a share, from 0 to 1", 0, 1, 0.01, 0.1, "")
        AddSliderSetting(placement, LOWEST_SLOPE_FIELD, PLACEMENT_GROUP, "Lowest slope", "The least slope it grows on, in degrees", 0, 90, 1, 10, "degrees")
        AddSliderSetting(placement, STEEPEST_SLOPE_FIELD, PLACEMENT_GROUP, "Steepest slope", "The steepest slope it grows on, in degrees", 0, 90, 1, 10, "degrees")
        AddSettingsField(placement, OFFSET_FIELD, PLACEMENT_GROUP, "Height offset:", "How far above the ground each copy stands")

        Control lean = MakeGroup(LEAN_GROUP, "Lean and turn")
        alignCheckbox = AddCheckbox(lean, LEAN_GROUP, "Lean with slope", "Whether copies lean with the ground's slope, as grass and rocks often do", ALIGN_TO_NORMAL)
        AddSliderSetting(lean, TILT_FIELD, LEAN_GROUP, "Lean", "How far every copy leans, in degrees from upright", 0, 90, 1, 10, "degrees")
        AddSliderSetting(lean, RANDOM_TILT_FIELD, LEAN_GROUP, "Lean varies", "How much more each copy may lean at random, in degrees", 0, 90, 1, 10, "degrees")
        randomTurnCheckbox = AddCheckbox(lean, LEAN_GROUP, "Random turn", "Turn each copy a random amount about the up axis", RANDOM_TURN)
        AddSliderSetting(lean, TURN_FIELD, LEAN_GROUP, "Turn", "A turn every copy gets about the up axis, in degrees, added to its random turn", 0, 360, 1, 15, "degrees")

        Control color = MakeGroup(COLOR_GROUP, "Color and wind")
        AddSliderSetting(color, SHADE_FIELD, COLOR_GROUP, "Shade varies", "How much each copy's shade varies, from 0 to 1", 0, 1, 0.01, 0.1, "")
        AddSliderSetting(color, TINT_FIELD, COLOR_GROUP, "Tint red", "The tint's red, from 0 to 1; 1 for none", 0, 1, 0.01, 0.1, "")
        AddSliderSetting(color, TINT_GREEN_FIELD, COLOR_GROUP, "Tint green", "The tint's green, from 0 to 1; 1 for none", 0, 1, 0.01, 0.1, "")
        AddSliderSetting(color, TINT_BLUE_FIELD, COLOR_GROUP, "Tint blue", "The tint's blue, from 0 to 1; 1 for none", 0, 1, 0.01, 0.1, "")
        AddSliderSetting(color, HUE_FIELD, COLOR_GROUP, "Hue varies", "How far each copy's hue may turn either way, in degrees; it turns the tint", 0, 180, 1, 10, "degrees")
        AddSliderSetting(color, WIND_FIELD, COLOR_GROUP, "Wind", "How much copies sway in the wind: how far a point moves sideways per unit of height, such as 0.05 for grass, or 0 for none", 0, 0.3, 0.005, 0.05, "")
        AddSliderSetting(color, WIND_DIRECTION_FIELD, COLOR_GROUP, "Wind direction", "Which way the wind blows, in degrees about the up axis: 0 along x, 90 along z", 0, 360, 1, 15, "degrees")

        Control levels = MakeGroup(LEVELS_GROUP, "Levels of detail")
        AddSettingsField(levels, DISTANCE_FIELD, LEVELS_GROUP, "Draw distance:", "How far from the camera copies are drawn")
        integer level = 1
        repeat while level <= LEVEL_FIELD_COUNT
            integer place = FIRST_LEVEL_FIELD + (level - 1) * 2
            AddSettingsField(levels, place, LEVELS_GROUP, "Level " + level + " file:", "Level of detail " + level + ": a model, or a card picture (png or jpg), relative to the foliage list's file, or empty for none")
            AddChooseButton(levels, level)
            AddSettingsField(levels, place + 1, LEVELS_GROUP, "Level " + level + " from:", "The distance from the camera level of detail " + level + " is used from")
            level = level + 1
        end
        AddSettingsField(levels, FADE_FIELD, LEVELS_GROUP, "Fade margin:", "How far before a level of detail's distance copies start fading into it, or 0 to switch at once")

        Control shadows = MakeGroup(SHADOWS_GROUP, "Shadows")
        shadowsCheckbox = AddCheckbox(shadows, SHADOWS_GROUP, "Casts shadows", "Whether copies cast shadows. Grass usually doesn't.", CASTS_SHADOWS)
        AddSliderSetting(shadows, LAST_SHADOW_FIELD, SHADOWS_GROUP, "Last shadow level", "The farthest level of detail that casts shadows, from 0 to 3; levels past it cast none", 0, 3, 1, 1, "")
        AddSliderSetting(shadows, SHADOW_LEVEL_FIELD, SHADOWS_GROUP, "Shadow from level", "A simpler level of detail whose shadow stands in for nearer levels' shadows, or 0 for each level's own", 0, 3, 1, 1, "")

        Control line
        removeLine = line
        FlowLayout removeLayout
        removeLine:SetLayout(removeLayout)
        removeLine:SetPercentageWidth(1.0)
        removeLine:SetVerticalLayoutMode(removeLine:FIT_CONTENTS)
        removeLine:SetLeftMargin(INNER_INDENT)
        removeLine:SetTopMargin(6)
        removeLine:SetBottomMargin(6)
        removeButton = MakeButton(removeLine, "Remove", "Remove this asset and all its copies. It can't be undone.", REMOVE, 0)
    end

    /*
        Makes one settings group: a header that folds and a card for its
        fields, closed at first. Returns the card.
    */
    private action MakeGroup(integer group, text title) returns Control
        PropertiesFoldItem fold
        fold:SetName(title)
        fold:ShowOpen(false)
        groupFolds:Add(fold)
        groupRows:Add(MakeFoldRow(fold, GROUP_PART + group, INNER_INDENT))
        Control card = MakeCard()
        card:SetLeftMargin(INNER_INDENT + 6)
        groupCards:Add(card)
        groupOpen:Add(false)
        return card
    end

    /*
        Adds a setting with a bounded range to a group's card:
        its label, then a slider and a number field on one line,
        kept in step. Both are focus stops named after the setting. While
        the slider is dragged the field shows the number; the setting is
        taken, and the foliage rebuilt, when the drag ends, on each key
        press, or when the focus leaves the field.

        Attribute: Parameter card The group's card.
        Attribute: Parameter place The setting's place, such as WIND_FIELD.
        Attribute: Parameter group The group, such as COLOR_GROUP.
        Attribute: Parameter name The setting's name, shown with a colon.
        Attribute: Parameter description What the setting does.
        Attribute: Parameter minimum The least value.
        Attribute: Parameter maximum The greatest value.
        Attribute: Parameter step One key press's change.
        Attribute: Parameter pageStep Page Up's and Page Down's change.
        Attribute: Parameter units Said after the value, such as "degrees", or empty.
    */
    private action AddSliderSetting(Control card, integer place, integer group, text name, text description, number minimum, number maximum, number step, number pageStep, text units)
        // Its own layout lines up the label with the other settings' labels
        // and puts the slider under them when the panel is narrow. The
        // margins are a card line's.
        SliderField sliderField
        sliderField:Setup(name, description, minimum, maximum, step, pageStep)
        sliderField:SetUnits(units)
        sliderField:SetLabelText(name + ":")
        sliderField:SetLabelWidth(FIELD_LABEL_WIDTH)
        sliderField:SetLeftMargin(12)
        sliderField:SetRightMargin(12)
        sliderField:SetTopMargin(4)
        sliderField:SetBottomMargin(4)
        TerrainFoliageSliderListener listener
        listener:Setup(me, place)
        sliderField:AddSliderListener(listener)
        card:Add(sliderField)

        settingsSliders:Set(place, sliderField)
        settingsFields:Set(place, sliderField:GetField())
        groupControls:Add(sliderField:GetSlider())
        groupOfControl:Add(group)
        groupControls:Add(sliderField:GetField())
        groupOfControl:Add(group)
    end

    /*
        Adds a level of detail's Choose... button under its file field, lined
        up with the field, to pick the file instead of typing its path.
    */
    private action AddChooseButton(Control card, integer level)
        Control line = MakeCardLine()
        Button button
        button:SetName("Choose...")
        button:SetDescription("Choose the file for level of detail " + level + ": a model, or a picture drawn as a card")
        button:SetLeftMargin(FIELD_LABEL_WIDTH + 10)
        TerrainFoliageButtonBehavior behavior
        behavior:Setup(me, CHOOSE_LEVEL, level)
        button:SetBehavior(behavior)
        line:Add(button)
        card:Add(line)
        groupControls:Add(button)
        groupOfControl:Add(LEVELS_GROUP)
    end

    /*
        Adds a checkbox to a group's card, and returns it.
    */
    private action AddCheckbox(Control card, integer group, text name, text description, integer kind) returns Checkbox
        Control line = MakeCardLine()
        Checkbox box
        box:SetName(name)
        box:SetDescription(description)
        TerrainFoliageButtonBehavior behavior
        behavior:Setup(me, kind, 0)
        behavior:SetCheckbox(true)
        box:SetBehavior(behavior)
        line:Add(box)
        card:Add(line)
        groupControls:Add(box)
        groupOfControl:Add(group)
        return box
    end

    /*
        Adds one labelled settings field to a card, at its place among the
        settings fields, taken when the focus leaves it. The group is -1 for
        the name, which is in no group.
    */
    private action AddSettingsField(Control card, integer place, integer group, text label, text name)
        Control line = MakeCardLine()
        FlowLayout labelLayout
        Control labelBox
        labelBox:SetLayout(labelLayout)
        labelBox:SetPercentageWidth(0)
        labelBox:SetPixelWidth(FIELD_LABEL_WIDTH)
        labelBox:SetVerticalLayoutMode(labelBox:FIT_CONTENTS)
        labelBox:SetRightMargin(10)
        Label fieldLabel
        fieldLabel:SetText(label)
        labelBox:Add(fieldLabel)
        line:Add(labelBox)

        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:SetRightMargin(8)
        field:SetHorizontalLayoutMode(line:FILL)
        TerrainFoliageFieldListener listener
        listener:Setup(me, field)
        field:AddFocusListener(listener)
        line:Add(field)
        card:Add(line)
        settingsFields:Set(place, field)
        if group >= 0
            groupControls:Add(field)
            groupOfControl:Add(group)
        end
    end

    /*
        Adds a button to a line.
    */
    private action MakeButton(Control line, text name, text description, integer kind, integer asset) returns Button
        Button button
        button:SetName(name)
        button:SetDescription(description)
        button:SetRightMargin(10)
        TerrainFoliageButtonBehavior behavior
        behavior:Setup(me, kind, asset)
        button:SetBehavior(behavior)
        line:Add(button)
        return button
    end

    /*
        Makes a container for one line of controls, the width of the
        section.
    */
    private action MakeLine returns Control
        FlowLayout layout
        Control line
        line:SetLayout(layout)
        line:SetPercentageWidth(1.0)
        line:SetVerticalLayoutMode(line:FIT_CONTENTS)
        line:SetLeftMargin(20)
        line:SetRightMargin(30)
        line:SetTopMargin(4)
        line:SetBottomMargin(4)
        return line
    end

    /*
        This action shows the dialog when a terrain is selected, and hides it
        otherwise.
    */
    action SelectionChanged(SelectionEvent event)
        if not (event:GetSelection() is SceneEditorSelection)
            return now
        end
        SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
        Item selectedItem = undefined
        if selection:IsItemSelected()
            selectedItem = selection:GetSelectedItem()
        end
        if selectedItem is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selectedItem)
            SetTerrain(highlight:GetEditorTerrain())
            if not IsShowing()
                Show()
            end
        else
            terrain = undefined
            if IsShowing()
                Hide()
            end
        end
    end

    /*
        This action sets the fields from a selected terrain's highlight.
    */
    action SetFields(EditorItem item)
        if item is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, item)
            SetTerrain(highlight:GetEditorTerrain())
        end
    end

    /*
        This action shows a terrain's foliage assets: a part for each, and
        the open asset's body under it.

        Attribute: Parameter terrain The terrain
    */
    action SetTerrain(EditorTerrain terrain)
        if terrain not= me:terrain
            settingsAsset = -1
        end
        me:terrain = terrain
        if terrain = undefined
            return now
        end
        updating = true
        FoliageList list = terrain:GetFoliageList()
        integer count = 0
        if list not= undefined
            count = list:GetAssetCount()
        end
        if settingsAsset >= count
            settingsAsset = -1
        end

        TerrainFoliage foliage = terrain:GetTerrainFoliage()
        // The status stays one line, since a wrapped label draws over the
        // controls below it; the description says more.
        if list = undefined
            if terrain:GetFoliageFile() not= ""
                statusLabel:SetText("Foliage list not found.")
                statusLabel:SetDescription("The foliage list " + terrain:GetFoliageFile() + " wasn't found.")
            else
                statusLabel:SetText("No foliage yet.")
                statusLabel:SetDescription("Add a model or a picture, then paint it with the Foliage tool, chosen in the Brush section.")
            end
        elseif count = 0
            statusLabel:SetText("No foliage assets yet.")
            statusLabel:SetDescription("Add a model or a picture, then paint it with the Foliage tool, chosen in the Brush section.")
        else
            statusLabel:SetText("" + foliage:GetCopyCount() + " copies in all.")
            statusLabel:SetDescription("Choose the asset the Foliage tool paints in the Brush section.")
        end

        integer i = 0
        repeat while i < count
            FoliageAsset asset = list:GetAsset(i)
            PropertiesFoldItem fold = assetFolds:Get(i)
            if fold:GetName() not= asset:GetName()
                fold:SetName(asset:GetName())
            end
            fold:ShowOpen(i = settingsAsset)
            text kind = "Model"
            if asset:IsCard()
                kind = "Card"
            end
            integer copies = foliage:GetCopyCount(i)
            text copiesText = copies + " copies"
            if copies = 1
                copiesText = "1 copy"
            end
            kindLabels:Get(i):SetText(kind + ", " + copiesText)
            i = i + 1
        end
        SortByName(list, count)
        if settingsAsset >= 0
            FoliageAsset openAsset = list:GetAsset(settingsAsset)
            FillSettings(openAsset)
            removeButton:SetName("Remove " + openAsset:GetName())
        end
        ShowRows(count)
        statusLabel:RequestLayout()
        LinkFocus(count)
        updating = false
    end

    /*
        Puts each asset's header and kind line in the panel, and the open
        asset's body under its kind line, with its open groups' cards.
    */
    private action ShowRows(integer count)
        Array<Control> wanted
        integer i = 0
        repeat while i < count
            integer asset = shownOrder:Get(i)
            wanted:Add(titleLines:Get(asset))
            wanted:Add(kindLabels:Get(asset))
            if asset = settingsAsset
                wanted:Add(bodyPanel)
            end
            i = i + 1
        end
        ShowIn(assetsPanel, assetsShown, wanted)

        Array<Control> body
        body:Add(nameCard)
        integer group = 0
        repeat while group < GROUP_COUNT
            body:Add(groupRows:Get(group))
            if groupOpen:Get(group)
                body:Add(groupCards:Get(group))
            end
            group = group + 1
        end
        body:Add(removeLine)
        ShowIn(bodyPanel, bodyShown, body)
        rowsShown = count
    end

    /*
        Puts the assets' numbers in shownOrder in alphabetical order of
        their names, ignoring case; equal names keep the list's order.
    */
    private action SortByName(FoliageList list, integer count)
        shownOrder:Empty()
        integer i = 0
        repeat while i < count
            text name = list:GetAsset(i):GetName()
            integer place = shownOrder:GetSize()
            repeat while place > 0 and name:CompareIgnoringCase(list:GetAsset(shownOrder:Get(place - 1)):GetName()) < 0
                place = place - 1
            end
            shownOrder:Add(place, i)
            i = i + 1
        end
    end

    /*
        Makes a panel hold the wanted controls, in order, changing it only if
        they differ from what it shows.
    */
    private action ShowIn(Control panel, Array<Control> shown, Array<Control> wanted)
        boolean same = shown:GetSize() = wanted:GetSize()
        integer i = 0
        repeat while same and i < wanted:GetSize()
            if shown:Get(i) not= wanted:Get(i)
                same = false
            end
            i = i + 1
        end
        if same
            return now
        end
        i = 0
        repeat while i < shown:GetSize()
            boolean removed = panel:Remove(shown:Get(i))
            i = i + 1
        end
        shown:Empty()
        i = 0
        repeat while i < wanted:GetSize()
            panel:Add(wanted:Get(i))
            shown:Add(wanted:Get(i))
            i = i + 1
        end
    end

    /*
        This action is called when an asset's or a group's header is opened
        or closed. Opening an asset closes any other, so one is open at a
        time.

        Attribute: Parameter partKey The part's number
        Attribute: Parameter open True if it was opened
    */
    action FoldChanged(integer partKey, boolean open)
        if partKey >= GROUP_PART and partKey < GROUP_PART + GROUP_COUNT
            groupOpen:Set(partKey - GROUP_PART, open)
        elseif partKey >= ASSET_PART and partKey < ASSET_PART + assetFolds:GetSize()
            integer asset = partKey - ASSET_PART
            if open
                settingsAsset = asset
            elseif settingsAsset = asset
                settingsAsset = -1
            end
        end
        Refresh()
    end

    /*
        Fills the settings with an asset's values.
    */
    private action FillSettings(FoliageAsset asset)
        SetTextIfDifferent(settingsFields:Get(NAME_FIELD), asset:GetName())
        SetTextIfDifferent(settingsFields:Get(DENSITY_FIELD), "" + asset:GetDensity())
        SetTextIfDifferent(settingsFields:Get(SCALE_FIELD), "" + asset:GetBaseScale())
        ShowNumber(RANDOM_SCALE_FIELD, asset:GetRandomScale())
        ShowNumber(SHADE_FIELD, asset:GetShadeVariation())
        ShowNumber(LOWEST_SLOPE_FIELD, asset:GetMinimumSlope())
        ShowNumber(STEEPEST_SLOPE_FIELD, asset:GetMaximumSlope())
        SetTextIfDifferent(settingsFields:Get(OFFSET_FIELD), "" + asset:GetHeightOffset())
        SetTextIfDifferent(settingsFields:Get(DISTANCE_FIELD), "" + asset:GetDrawDistance())
        ShowNumber(WIND_FIELD, asset:GetWind())
        integer level = 1
        repeat while level <= LEVEL_FIELD_COUNT
            integer place = FIRST_LEVEL_FIELD + (level - 1) * 2
            if asset:HasLevel(level)
                SetTextIfDifferent(settingsFields:Get(place), asset:GetLevelPath(level))
                SetTextIfDifferent(settingsFields:Get(place + 1), "" + asset:GetLevelDistance(level))
            else
                SetTextIfDifferent(settingsFields:Get(place), "")
                SetTextIfDifferent(settingsFields:Get(place + 1), "")
            end
            level = level + 1
        end
        ShowNumber(LAST_SHADOW_FIELD, asset:GetLastShadowLevel())
        ShowNumber(SHADOW_LEVEL_FIELD, asset:GetShadowLevel())
        ShowNumber(TILT_FIELD, asset:GetFixedTilt())
        ShowNumber(RANDOM_TILT_FIELD, asset:GetRandomTilt())
        ShowNumber(TURN_FIELD, asset:GetFixedTurn())
        ShowNumber(TINT_FIELD, asset:GetTintRed())
        ShowNumber(TINT_GREEN_FIELD, asset:GetTintGreen())
        ShowNumber(TINT_BLUE_FIELD, asset:GetTintBlue())
        ShowNumber(WIND_DIRECTION_FIELD, asset:GetWindDirection())
        ShowNumber(HUE_FIELD, asset:GetRandomHue())
        SetTextIfDifferent(settingsFields:Get(FADE_FIELD), "" + asset:GetFadeMargin())
        randomTurnCheckbox:SetToggleState(asset:HasRandomTurn())
        shadowsCheckbox:SetToggleState(asset:CastsShadows())
        alignCheckbox:SetToggleState(asset:IsAlignedToNormal())
    end

    /*
        Shows a number setting: on its slider and number field, if it has a
        slider, or in its field.
    */
    private action ShowNumber(integer place, number value)
        SliderField sliderField = settingsSliders:Get(place)
        if sliderField not= undefined
            sliderField:SetValue(value)
        else
            SetTextIfDifferent(settingsFields:Get(place), "" + value)
        end
    end

    /*
        Puts text in a field unless it already says it, so a field being
        typed in isn't disturbed.
    */
    private action SetTextIfDifferent(TextField field, text value)
        if field:GetText() not= value
            field:SetText(value)
        end
    end

    /*
        Links the Tab order through the controls shown: the status line,
        each asset's header in the order shown, then, under the open asset, its
        name, each group's header and, if open, its controls, and Remove,
        then "Add asset...".
    */
    private action LinkFocus(integer count)
        Array<Control> chain
        chain:Add(statusLabel)
        integer i = 0
        repeat while i < count
            integer asset = shownOrder:Get(i)
            chain:Add(assetFolds:Get(asset):GetTree())
            if asset = settingsAsset
                chain:Add(settingsFields:Get(NAME_FIELD))
                integer group = 0
                repeat while group < GROUP_COUNT
                    chain:Add(groupFolds:Get(group):GetTree())
                    if groupOpen:Get(group)
                        integer control = 0
                        repeat while control < groupControls:GetSize()
                            if groupOfControl:Get(control) = group
                                chain:Add(groupControls:Get(control))
                            end
                            control = control + 1
                        end
                    end
                    group = group + 1
                end
                chain:Add(removeButton)
            end
            i = i + 1
        end
        chain:Add(addButton)
        i = 0
        repeat while i < chain:GetSize() - 1
            chain:Get(i):SetNextFocus(chain:Get(i + 1))
            chain:Get(i + 1):SetPreviousFocus(chain:Get(i))
            i = i + 1
        end
        SetFirstFocus(chain:Get(0))
    end

    /*
        Shows the terrain's foliage again, after it changed.
    */
    action Refresh
        if terrain not= undefined
            SetTerrain(terrain)
        end
    end

    /*
        This action is called by the section's buttons and checkboxes.

        Attribute: Parameter kind One of the button kinds, such as ADD
        Attribute: Parameter asset The asset, from 0, for an asset's buttons
    */
    action ButtonActivated(integer kind, integer asset)
        SceneEditor editor = GetSceneEditor()
        if terrain = undefined or editor = undefined or updating
            return now
        end
        FoliageList list = terrain:GetFoliageList()
        if kind = ADD
            FileChooser chooser
            FileFilter filter
            filter:Add("glb")
            filter:Add("gltf")
            filter:Add("fbx")
            filter:Add("obj")
            filter:Add("png")
            filter:SetAcceptAll(false)
            File chosen = chooser:OpenFileDialog(editor:GetProjectLocation(), filter)
            if chosen not= undefined
                editor:AddFoliageAsset(terrain, chosen)
            end
            return now
        elseif kind = REMOVE
            // The one Remove button is in the open asset's body.
            integer removed = settingsAsset
            if removed < 0
                return now
            end
            settingsAsset = -1
            editor:RemoveFoliageAsset(terrain, removed)
            if rowsShown > 0
                assetFolds:Get(shownOrder:Get(0)):GetTree():Focus()
            else
                addButton:Focus()
            end
            return now
        end
        if list = undefined or settingsAsset < 0 or settingsAsset >= list:GetAssetCount()
            return now
        end
        FoliageAsset settings = list:GetAsset(settingsAsset)
        if kind = CHOOSE_LEVEL
            ChooseLevelFile(editor, list, settings, asset)
            return now
        end
        if kind = RANDOM_TURN
            settings:SetRandomTurn(randomTurnCheckbox:GetToggleState())
            editor:FoliageAssetSettingsChanged(terrain)
        elseif kind = CASTS_SHADOWS
            settings:SetCastsShadows(shadowsCheckbox:GetToggleState())
            editor:FoliageAssetSettingsChanged(terrain)
        elseif kind = ALIGN_TO_NORMAL
            settings:SetAlignedToNormal(alignCheckbox:GetToggleState())
            editor:FoliageAssetSettingsChanged(terrain)
        end
    end

    /*
        This action is called when the focus leaves one of the settings'
        fields: its value is taken. A number out of range is ignored.

        Attribute: Parameter field The field the focus left
    */
    action FieldLeft(TextField field)
        SceneEditor editor = GetSceneEditor()
        if terrain = undefined or updating or editor = undefined or settingsAsset < 0
            return now
        end
        FoliageList list = terrain:GetFoliageList()
        if list = undefined or settingsAsset >= list:GetAssetCount()
            return now
        end
        FoliageAsset asset = list:GetAsset(settingsAsset)
        integer place = -1
        integer i = 0
        repeat while i < settingsFields:GetSize()
            if settingsFields:Get(i):Equals(field)
                place = i
            end
            i = i + 1
        end
        if place < 0
            return now
        end
        if place = NAME_FIELD
            text name = field:GetText():Trim()
            if name = "" or name = asset:GetName()
                return now
            end
            asset:SetName(name)
        elseif place >= FIRST_LEVEL_FIELD and place < FIRST_LEVEL_FIELD + LEVEL_FIELD_COUNT * 2
            if not TakeLevelField(asset, place, field)
                return now
            end
        else
            number value = 0
            boolean parsed = true
            check
                value = field:GetText():ParseNumber()
            detect e is Error
                // Not a number; ignored.
                parsed = false
            end
            if not parsed
                return now
            end
            if not ApplyNumber(asset, place, value)
                return now
            end
        end
        editor:FoliageAssetSettingsChanged(terrain)
        SetTerrain(terrain)
    end

    /*
        This action is called when one of the settings' sliders changes,
        by a key, the mouse, a screen reader, or a number typed in its
        field. While a drag goes on its field already shows the number, and
        nothing else is done, since each change rebuilds every cell of the
        foliage; the setting is taken once the change is final.

        Attribute: Parameter place The setting's place, such as WIND_FIELD.
        Attribute: Parameter event The change.
    */
    action SliderChanged(integer place, SliderChangedEvent event)
        if not event:IsFinal()
            return now
        end
        SceneEditor editor = GetSceneEditor()
        if terrain = undefined or updating or editor = undefined or settingsAsset < 0
            return now
        end
        FoliageList list = terrain:GetFoliageList()
        if list = undefined or settingsAsset >= list:GetAssetCount()
            return now
        end
        FoliageAsset asset = list:GetAsset(settingsAsset)
        if not ApplyNumber(asset, place, event:GetNewValue())
            return now
        end
        editor:FoliageAssetSettingsChanged(terrain)
        SetTerrain(terrain)
    end

    /*
        Gives an asset a number setting at its place, if it is in range.
        Returns false if nothing changed: the number is out of range, or
        the same as before for the settings that are only rebuilt on a
        change.
    */
    private action ApplyNumber(FoliageAsset asset, integer place, number value) returns boolean
        if value < 0 and place not= OFFSET_FIELD and place not= TURN_FIELD and place not= WIND_DIRECTION_FIELD
            return false
        end
        if place = DENSITY_FIELD and value > 0
            asset:SetDensity(value)
        elseif place = SCALE_FIELD and value > 0
            asset:SetBaseScale(value)
        elseif place = RANDOM_SCALE_FIELD and value <= 1
            asset:SetRandomScale(value)
        elseif place = SHADE_FIELD and value <= 1
            asset:SetShadeVariation(value)
        elseif place = LOWEST_SLOPE_FIELD and value <= 90
            asset:SetMinimumSlope(value)
        elseif place = STEEPEST_SLOPE_FIELD and value <= 90
            asset:SetMaximumSlope(value)
        elseif place = OFFSET_FIELD
            asset:SetHeightOffset(value)
        elseif place = DISTANCE_FIELD and value > 0
            asset:SetDrawDistance(value)
        elseif place = WIND_FIELD
            if value = asset:GetWind()
                return false
            end
            asset:SetWind(value)
        elseif place = LAST_SHADOW_FIELD and value <= asset:MAXIMUM_LEVELS
            asset:SetLastShadowLevel(cast(integer, value))
        elseif place = SHADOW_LEVEL_FIELD and value <= asset:MAXIMUM_LEVELS
            asset:SetShadowLevel(cast(integer, value))
        elseif place = TILT_FIELD and value <= 90
            asset:SetFixedTilt(value)
        elseif place = RANDOM_TILT_FIELD and value <= 90
            asset:SetRandomTilt(value)
        elseif place = TURN_FIELD
            asset:SetFixedTurn(value)
        elseif place = HUE_FIELD and value <= 180
            asset:SetRandomHue(value)
        elseif place = FADE_FIELD
            asset:SetFadeMargin(value)
        elseif place = TINT_FIELD and value <= 1
            if value = asset:GetTintRed()
                return false
            end
            asset:SetTint(value, asset:GetTintGreen(), asset:GetTintBlue())
        elseif place = TINT_GREEN_FIELD and value <= 1
            if value = asset:GetTintGreen()
                return false
            end
            asset:SetTint(asset:GetTintRed(), value, asset:GetTintBlue())
        elseif place = TINT_BLUE_FIELD and value <= 1
            if value = asset:GetTintBlue()
                return false
            end
            asset:SetTint(asset:GetTintRed(), asset:GetTintGreen(), value)
        elseif place = WIND_DIRECTION_FIELD
            if value = asset:GetWindDirection()
                return false
            end
            asset:SetWindDirection(value)
        else
            return false
        end
        return true
    end

    /*
        Lets the user choose a level of detail's file: a model, or a picture
        drawn as a card. The file's path is kept relative to the foliage
        list's file, as Add asset... keeps it, and taken as if typed into the
        level's file field.

        Attribute: Parameter editor The scene editor.
        Attribute: Parameter list The foliage list.
        Attribute: Parameter asset The open asset.
        Attribute: Parameter level The level, from 1.
    */
    private action ChooseLevelFile(SceneEditor editor, FoliageList list, FoliageAsset asset, integer level)
        if level < 1 or level > LEVEL_FIELD_COUNT or list:GetFile() = undefined
            return now
        end
        FileChooser chooser
        FileFilter filter
        filter:Add("glb")
        filter:Add("gltf")
        filter:Add("png")
        filter:Add("jpg")
        filter:Add("jpeg")
        filter:SetAcceptAll(false)
        File chosen = chooser:OpenFileDialog(list:GetFile():GetParentDirectory(), filter)
        if chosen = undefined
            return now
        end
        Material paths
        text listFolder = list:GetFile():GetParentDirectory():GetAbsolutePath()
        text relative = paths:GetRelativePath(listFolder, chosen:GetAbsolutePath())
        integer place = FIRST_LEVEL_FIELD + (level - 1) * 2
        TextField field = settingsFields:Get(place)
        field:SetText(relative)
        if TakeLevelField(asset, place, field)
            editor:FoliageAssetSettingsChanged(terrain)
        end
        SetTerrain(terrain)
    end

    /*
        Takes a level of detail's file or distance field.
        A file ending in .png, .jpg, .jpeg, .bmp or .tga is a card picture,
        any other a model; an empty file leaves the level unused. A level
        given a file before its distance is used from the draw distance's
        half, until a distance is typed.

        Attribute: Parameter asset The asset whose settings are open.
        Attribute: Parameter place The field's place.
        Attribute: Parameter field The field.
        Attribute: Returns True if the asset changed.
    */
    private action TakeLevelField(FoliageAsset asset, integer place, TextField field) returns boolean
        integer level = (place - FIRST_LEVEL_FIELD) / 2 + 1
        boolean isFile = (place - FIRST_LEVEL_FIELD) mod 2 = 0
        text value = field:GetText():Trim()
        if isFile
            if value = ""
                if not asset:HasLevel(level)
                    return false
                end
                asset:ClearLevel(level)
                return true
            end
            if asset:HasLevel(level) and asset:GetLevelPath(level) = value
                return false
            end
            boolean hadLevel = asset:HasLevel(level)
            text lower = value:ToLowerCase()
            if lower:EndsWith(".png") or lower:EndsWith(".jpg") or lower:EndsWith(".jpeg") or lower:EndsWith(".bmp") or lower:EndsWith(".tga")
                asset:SetLevelCardPicture(level, value)
            else
                asset:SetLevelModel(level, value)
            end
            if not hadLevel
                asset:SetLevelDistance(level, asset:GetDrawDistance() / 2)
            end
            return true
        end
        if not asset:HasLevel(level)
            return false
        end
        number distance = 0
        boolean parsed = true
        check
            distance = value:ParseNumber()
        detect e is Error
            // Not a number; ignored.
            parsed = false
        end
        if not parsed or distance < 0 or distance = asset:GetLevelDistance(level)
            return false
        end
        asset:SetLevelDistance(level, distance)
        return true
    end

    /*
        Moves the focus to the first asset's name, or to "Add asset..." when
        there are none.
    */
    action FocusField
        if rowsShown > 0
            assetFolds:Get(shownOrder:Get(0)):GetTree():Focus()
        else
            addButton:Focus()
        end
    end
end
