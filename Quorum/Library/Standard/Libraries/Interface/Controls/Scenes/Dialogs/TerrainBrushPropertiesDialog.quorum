package Libraries.Interface.Controls.Scenes.Dialogs

use Libraries.Containers.Array
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.RadioButton
use Libraries.Interface.Controls.Button
use Libraries.Interface.Behaviors.Scenes.Properties.TerrainDescribeAreaBehavior
use Libraries.Interface.Behaviors.Scenes.Properties.TerrainBrushButtonBehavior
use Libraries.Game.Graphics.Label
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Item
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Selections.SceneEditorSelection
use Libraries.Interface.Selections.ButtonGroupSelection
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.Items.Highlights.TerrainSelectionHighlight
use Libraries.Game.Graphics.Worlds.TerrainBrush

/*
    The TerrainBrushPropertiesDialog is a selected terrain's Brush section
    (step 7): which tool is chosen, and the brush's size, strength and
    falloff. Choosing a tool here does the same as Alt+1 to Alt+9: a ring
    shows the brush on the ground, and the arrow keys and pointer move it.
    "No tool" leaves the tool. Raise and lower make strokes, with Space held
    or a left drag (step 8), and so does Paint, on the paint layer chosen
    here, once the terrain has two or more materials (step 9); the other
    tools come in later steps.

    It shows in the scene editor's Properties panel, between the terrain's
    facts (TerrainPropertiesDialog) and its physics.
*/
class TerrainBrushPropertiesDialog is PropertiesDialog

    ButtonGroup toolGroup = undefined
    // The layer the Paint tool paints (step 9), named from the terrain's
    // materials.
    ButtonGroup layerGroup = undefined
    // Flatten's setting: the height where each stroke starts, or a set
    // height (step 8).
    ButtonGroup flattenGroup = undefined
    TextField flattenHeightField = undefined
    // The ramp's two ends (step 8).
    Label rampLabel = undefined

    // What the section's buttons do.
    public constant integer TAKE_HEIGHT = 0
    public constant integer RAMP_START = 1
    public constant integer RAMP_END = 2
    public constant integer NEW_RAMP = 3
    TextField sizeField = undefined
    TextField strengthField = undefined
    TextField falloffField = undefined

    // The terrain whose brush is shown, or undefined.
    EditorTerrain terrain = undefined

    // True while the fields are being filled, so filling them isn't taken
    // as the user choosing.
    boolean updating = false

    /*
        Creates and adds the interface components for this dialog.
    */
    private action CreateInterface(Control panel, Array<Control> focusArray)
        SetName("Terrain Brush")

        Label headingLabel
        headingLabel:SetSize(18)
        headingLabel:SetText("Brush")
        headingLabel:SetLeftMargin(20)
        panel:Add(headingLabel)

        Control toolPanel
        toolPanel:SetPercentageWidth(1.0)
        toolPanel:SetVerticalLayoutMode(toolPanel:FIT_CONTENTS)
        FlowLayout toolPanelLayout
        toolPanel:SetLayout(toolPanelLayout)
        toolPanel:SetLeftMargin(20)
        toolPanel:SetRightMargin(30)
        toolPanel:SetTopMargin(10)
        toolPanel:SetBottomMargin(10)

        ButtonGroup group
        toolGroup = group
        toolGroup:SetName("Tool")
        toolGroup:SetHorizontalLayoutMode(toolPanel:FILL)
        toolGroup:SetVerticalLayoutMode(toolPanel:FIT_CONTENTS)
        FlowLayout groupLayout
        toolGroup:SetLayout(groupLayout)

        // The buttons' places are the tools' numbers: 0 is no tool. The
        // names are EditorTerrain:GetToolName's.
        AddToolButton("No tool")
        AddToolButton("Raise")
        AddToolButton("Lower")
        AddToolButton("Smooth")
        AddToolButton("Flatten")
        AddToolButton("Ramp")
        AddToolButton("Paint")
        AddToolButton("Blend paint")
        AddToolButton("Add region")
        AddToolButton("Remove region")
        toolGroup:AddSelectionListener(me)

        toolPanel:Add(toolGroup)
        panel:Add(toolPanel)
        focusArray:Add(toolGroup)

        Control layerPanel
        layerPanel:SetPercentageWidth(1.0)
        layerPanel:SetVerticalLayoutMode(layerPanel:FIT_CONTENTS)
        FlowLayout layerPanelLayout
        layerPanel:SetLayout(layerPanelLayout)
        layerPanel:SetLeftMargin(20)
        layerPanel:SetRightMargin(30)
        layerPanel:SetBottomMargin(10)

        // The label is on its own line, with the buttons under it.
        Control layerLabelLine
        layerLabelLine:SetPercentageWidth(1.0)
        layerLabelLine:SetVerticalLayoutMode(layerLabelLine:FIT_CONTENTS)
        FlowLayout layerLabelLayout
        layerLabelLine:SetLayout(layerLabelLayout)
        layerLabelLine:SetLeftMargin(20)
        layerLabelLine:SetRightMargin(30)
        Label layerLabel
        layerLabel:SetText("Paint layer (the material the Paint tool paints):")
        layerLabelLine:Add(layerLabel)
        panel:Add(layerLabelLine)

        ButtonGroup layers
        layerGroup = layers
        layerGroup:SetName("Paint layer")
        layerGroup:SetDescription("The material the Paint tool paints, one of the terrain's materials")
        Control layoutValues
        layerGroup:SetHorizontalLayoutMode(layoutValues:FILL)
        layerGroup:SetVerticalLayoutMode(layoutValues:FIT_CONTENTS)
        FlowLayout layerGroupLayout
        layerGroup:SetLayout(layerGroupLayout)
        integer layer = 0
        repeat while layer < 4
            AddLayerButton(layer)
            layer = layer + 1
        end
        layerGroup:AddSelectionListener(me)
        layerPanel:Add(layerGroup)
        panel:Add(layerPanel)
        focusArray:Add(layerGroup)

        // Flatten: what it evens the ground to (step 8).
        AddCaption(panel, "Flatten to:")
        Control flattenPanel = MakeLine()
        ButtonGroup flattenChoices
        flattenGroup = flattenChoices
        flattenGroup:SetName("Flatten to")
        flattenGroup:SetHorizontalLayoutMode(layoutValues:FILL)
        flattenGroup:SetVerticalLayoutMode(layoutValues:FIT_CONTENTS)
        FlowLayout flattenLayout
        flattenGroup:SetLayout(flattenLayout)
        AddChoice(flattenGroup, "The height where each stroke starts")
        AddChoice(flattenGroup, "This height")
        flattenGroup:AddSelectionListener(me)
        flattenPanel:Add(flattenGroup)
        panel:Add(flattenPanel)
        focusArray:Add(flattenGroup)
        flattenHeightField = AddNumberField(panel, focusArray, "Height:", "Flatten height")
        Control takeLine = MakeLine()
        Button takeButton = AddBrushButton(takeLine, "Use the height under the brush", "Flatten to the ground's height where the brush is now", TAKE_HEIGHT)
        panel:Add(takeLine)
        focusArray:Add(takeButton)

        // Ramp: its two ends, set at the brush (step 8).
        AddCaption(panel, "Ramp:")
        Control rampLine = MakeLine()
        Label ramp
        rampLabel = ramp
        rampLabel:SetText("")
        rampLabel:SetFocusable(true)
        rampLine:Add(rampLabel)
        panel:Add(rampLine)
        focusArray:Add(rampLabel)
        Control rampButtons = MakeLine()
        Button startButton = AddBrushButton(rampButtons, "Set ramp start", "Set the ramp's start where the brush is, at the ground's height there", RAMP_START)
        Button endButton = AddBrushButton(rampButtons, "Set ramp end", "Set the ramp's end where the brush is, at the ground's height there", RAMP_END)
        panel:Add(rampButtons)
        focusArray:Add(startButton)
        focusArray:Add(endButton)
        Control newRampLine = MakeLine()
        Button newRampButton = AddBrushButton(newRampLine, "New ramp", "Clear the ramp, so the next two clicks with the Ramp tool set its start and end", NEW_RAMP)
        panel:Add(newRampLine)
        focusArray:Add(newRampButton)

        sizeField = AddNumberField(panel, focusArray, "Size:", "Size")
        strengthField = AddNumberField(panel, focusArray, "Strength:", "Strength")
        falloffField = AddNumberField(panel, focusArray, "Falloff:", "Falloff")

        // Says what the ground under the whole brush is like (step 12).
        FlowLayout describeLayout
        Control describeLine
        describeLine:SetLayout(describeLayout)
        describeLine:SetPercentageWidth(1.0)
        describeLine:SetVerticalLayoutMode(describeLine:FIT_CONTENTS)
        describeLine:SetLeftMargin(20)
        describeLine:SetTopMargin(6)
        describeLine:SetBottomMargin(10)
        Button describeButton
        describeButton:SetName("Describe the area")
        describeButton:SetDescription("Say the heights, steepest slope and layers under the whole brush")
        TerrainDescribeAreaBehavior describeBehavior
        describeBehavior:SetDialog(me)
        describeButton:SetBehavior(describeBehavior)
        describeLine:Add(describeButton)
        panel:Add(describeLine)
        focusArray:Add(describeButton)
    end

    /*
        Says what the ground under the whole brush is like. The section's
        "Describe the area" button calls it.
    */
    action DescribeArea
        if terrain not= undefined and GetSceneEditor() not= undefined
            GetSceneEditor():DescribeTerrainArea(terrain)
        end
    end

    /*
        Adds one tool's radio button to the tool group.
    */
    private action AddToolButton(text name)
        // FILL is read through a plain Control: the compiler finds a
        // Control's layout values only through that type.
        Control layoutValues
        RadioButton button
        button:SetName(name)
        button:SetHorizontalLayoutMode(layoutValues:FILL)
        toolGroup:AddToGrouping(button)
        toolGroup:Add(button)
    end

    /*
        Adds a caption on its own line.
    */
    private action AddCaption(Control panel, text value)
        Control line = MakeLine()
        Label caption
        caption:SetText(value)
        line:Add(caption)
        panel:Add(line)
    end

    /*
        Makes a container for one line, the width of the section.
    */
    private action MakeLine returns Control
        FlowLayout layout
        Control line
        line:SetLayout(layout)
        line:SetPercentageWidth(1.0)
        line:SetVerticalLayoutMode(line:FIT_CONTENTS)
        line:SetLeftMargin(20)
        line:SetRightMargin(30)
        line:SetTopMargin(4)
        line:SetBottomMargin(4)
        return line
    end

    /*
        Adds a radio button to a group.
    */
    private action AddChoice(ButtonGroup group, text name)
        Control layoutValues
        RadioButton button
        button:SetName(name)
        button:SetHorizontalLayoutMode(layoutValues:FILL)
        group:AddToGrouping(button)
        group:Add(button)
    end

    /*
        Adds a button to a line.
    */
    private action AddBrushButton(Control line, text name, text description, integer kind) returns Button
        Button button
        button:SetName(name)
        button:SetDescription(description)
        button:SetRightMargin(10)
        TerrainBrushButtonBehavior behavior
        behavior:Setup(me, kind)
        button:SetBehavior(behavior)
        line:Add(button)
        return button
    end

    /*
        This action is called by the section's buttons.

        Attribute: Parameter kind TAKE_HEIGHT, RAMP_START, RAMP_END or NEW_RAMP
    */
    action ButtonActivated(integer kind)
        if terrain = undefined or GetSceneEditor() = undefined
            return now
        end
        if kind = TAKE_HEIGHT
            GetSceneEditor():TakeTerrainFlattenHeight(terrain)
        elseif kind = RAMP_START
            GetSceneEditor():SetTerrainRampPoint(terrain, false)
        elseif kind = RAMP_END
            GetSceneEditor():SetTerrainRampPoint(terrain, true)
        elseif kind = NEW_RAMP
            GetSceneEditor():ClearTerrainRamp(terrain)
        end
    end

    /*
        Adds one paint layer's radio button. Its name is set from the
        terrain's materials.
    */
    private action AddLayerButton(integer layer)
        Control layoutValues
        RadioButton button
        button:SetName("Layer " + (layer + 1))
        button:SetHorizontalLayoutMode(layoutValues:FILL)
        layerGroup:AddToGrouping(button)
        layerGroup:Add(button)
    end

    /*
        Adds a labelled number field.
    */
    private action AddNumberField(Control panel, Array<Control> focusArray, text label, text name) returns TextField
        FlowLayout layout
        Control container
        container:SetLayout(layout)
        container:SetPercentageWidth(1.0)
        container:SetVerticalLayoutMode(container:FIT_CONTENTS)
        container:SetLeftMargin(20)
        container:SetTopMargin(10)
        container:SetRightMargin(30)
        container:SetBottomMargin(10)

        Label fieldLabel
        fieldLabel:SetText(label)
        fieldLabel:SetRightMargin(10)
        container:Add(fieldLabel)

        TextField field
        field:SetName(name)
        field:SetText("")
        field:SetFocusable(true)
        field:AddTextChangeListener(me)
        field:SetRightMargin(8)
        field:SetHorizontalLayoutMode(container:FILL)
        container:Add(field)
        focusArray:Add(field)
        panel:Add(container)
        return field
    end

    /*
        This action shows the dialog when a terrain is selected, and hides it
        otherwise. It also takes a tool chosen with the radio buttons.
    */
    action SelectionChanged(SelectionEvent event)
        if event:GetSelection() is ButtonGroupSelection
            if updating or terrain = undefined or GetSceneEditor() = undefined
                return now
            end
            ButtonGroupSelection choice = cast(ButtonGroupSelection, event:GetSelection())
            if choice:GetButtonGroup() = flattenGroup
                if choice:GetIndex() >= 0
                    GetSceneEditor():SetTerrainFlattenToStart(terrain, choice:GetIndex() = 0)
                end
                return now
            end
            if choice:GetButtonGroup() = layerGroup
                integer layer = choice:GetIndex()
                if layer >= 0 and layer < 4 and layer not= terrain:GetBrush():GetLayer()
                    terrain:GetBrush():SetLayer(layer)
                    GetSceneEditor():NotifyAccessibility(terrain, "Painting " + DescribeLayer(layer))
                end
                return now
            end
            integer tool = choice:GetIndex()
            if tool >= 0 and tool <= 9 and tool not= terrain:GetToolNumber()
                GetSceneEditor():SetTerrainTool(terrain, tool)
            end
            return now
        end

        if not (event:GetSelection() is SceneEditorSelection)
            return now
        end

        SceneEditorSelection selection = cast(SceneEditorSelection, event:GetSelection())
        Item selectedItem = undefined
        if selection:IsItemSelected()
            selectedItem = selection:GetSelectedItem()
        end

        if selectedItem is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, selectedItem)
            SetTerrain(highlight:GetEditorTerrain())
            if not IsShowing()
                Show()
            end
        else
            terrain = undefined
            if IsShowing()
                Hide()
            end
        end
    end

    /*
        This action sets the fields from a selected terrain's highlight.
    */
    action SetFields(EditorItem item)
        if item is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, item)
            SetTerrain(highlight:GetEditorTerrain())
        end
    end

    /*
        This action shows a terrain's tool and brush.

        Attribute: Parameter terrain The terrain
    */
    action SetTerrain(EditorTerrain terrain)
        me:terrain = terrain
        if terrain = undefined
            return now
        end
        updating = true
        toolGroup:GetButtonAt(terrain:GetToolNumber()):SetToggleState(true)
        TerrainBrush brush = terrain:GetBrush()
        integer layer = 0
        repeat while layer < 4
            layerGroup:GetButtonAt(layer):SetName(DescribeLayer(layer))
            layer = layer + 1
        end
        if brush:GetLayer() >= 0 and brush:GetLayer() < 4
            layerGroup:GetButtonAt(brush:GetLayer()):SetToggleState(true)
        end
        if brush:FlattensToStart()
            flattenGroup:GetButtonAt(0):SetToggleState(true)
        else
            flattenGroup:GetButtonAt(1):SetToggleState(true)
        end
        SetFieldText(flattenHeightField, brush:GetTargetHeight())
        rampLabel:SetText("Ramp " + terrain:DescribeRamp())
        SetFieldText(sizeField, brush:GetSize())
        SetFieldText(strengthField, brush:GetStrength())
        SetFieldText(falloffField, brush:GetGamma())
        updating = false
    end

    /*
        Names a paint layer from the terrain's materials, such as "layer 2,
        Rock", or "layer 3, no material".
    */
    private action DescribeLayer(integer layer) returns text
        text result = "Layer " + (layer + 1)
        if terrain not= undefined and layer < terrain:GetLayerCount()
            return result + ", " + terrain:GetMaterial():GetLayerName(layer)
        end
        return result + ", no material"
    end

    /*
        Puts a number into a field without it being taken as typing.
    */
    private action SetFieldText(TextField field, number value)
        field:RemoveTextChangeListener(me)
        field:SetText("" + value)
        field:AddTextChangeListener(me)
    end

    /*
        This action sets the brush as its numbers are typed. Text that isn't
        a number, or is out of range, is ignored: the size from 0.5 to 64,
        the strength 0 or more, and the falloff more than 0.
    */
    action TextChanged(TextChangeEvent event)
        if terrain = undefined or updating
            return now
        end
        TerrainBrush brush = terrain:GetBrush()
        Control control = event:GetControl()
        check
            if control:Equals(sizeField)
                number value = sizeField:GetText():ParseNumber()
                if value >= 0.5 and value <= 64
                    brush:SetSize(value)
                end
            elseif control:Equals(strengthField)
                number value = strengthField:GetText():ParseNumber()
                if value >= 0
                    brush:SetStrength(value)
                end
            elseif control:Equals(falloffField)
                number value = falloffField:GetText():ParseNumber()
                if value > 0
                    brush:SetGamma(value)
                end
            elseif control:Equals(flattenHeightField)
                // Typing a height chooses flattening to it. The field is
                // left as typed, so the typing isn't interrupted.
                number value = flattenHeightField:GetText():ParseNumber()
                brush:SetTargetHeight(value)
                brush:SetFlattenToStart(false)
                updating = true
                flattenGroup:GetButtonAt(1):SetToggleState(true)
                updating = false
            end
        detect e is Error
            // Not a number yet; do nothing.
        end
    end

    /*
        Moves the focus to the tool buttons.
    */
    action FocusField
        toolGroup:Focus()
    end
end
