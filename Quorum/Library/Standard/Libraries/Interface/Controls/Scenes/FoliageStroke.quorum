package Libraries.Interface.Controls.Scenes

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.Game.Graphics.Worlds.TerrainFoliage
use Libraries.Game.Graphics.Worlds.FoliageCoverage
use Libraries.Game.Graphics.Worlds.FoliageList

/*
    A FoliageStroke is one stroke of a terrain's Foliage tool in the scene
    editor: while it goes, each dab paints where one foliage asset grows,
    its coverage, under the brush, or lowers it. The copies are worked out
    from the coverage afterward (TerrainItem's RefreshFoliage), so the
    asset's settings, such as its density, can change later and the painted
    area follows. The stroke keeps each coverage it touched as it was
    before the stroke, and as it is after, so the whole stroke can be
    undone and redone as one step.

    A dab moves the coverage toward the brush's target: full near the
    middle, fading to nothing at the edge. The target is the brush's
    density scale, from 0 for none to 1 for the asset's full density, so a
    light brush paints sparse growth and a strong one thick growth. To keep
    a held brush from repeating the same dab, a new one is made only once
    the brush has moved half a radius from the last one.

    Attribute: Example
    use Libraries.Interface.Controls.Scenes.FoliageStroke
    use Libraries.Game.Graphics.Worlds.TerrainItem

    TerrainItem ground
    ground:Load("Scenes/Terrains/Terrain1/terrain.json")
    FoliageStroke stroke
    stroke:Begin(ground:GetTerrainFoliage(), ground:GetFoliageList(), 0, stroke:ADD_COPIES)
    if stroke:Apply(10, 20, 5, 1)
        ground:RefreshFoliage(10, 20, 5)
    end
    boolean changed = stroke:End()
*/
class FoliageStroke
    // What a stroke does: grow its asset, lower its asset's coverage, or
    // lower every asset's.
    public constant integer ADD_COPIES = 0
    public constant integer REMOVE_ASSET = 1
    public constant integer REMOVE_ALL = 2

    TerrainFoliage foliage = undefined
    FoliageList list = undefined
    integer asset = 0
    integer mode = 0
    Math math

    // Each coverage touched, and its values before and after.
    Array<FoliageCoverage> touched
    Array<Array<number>> before
    Array<Array<number>> after

    // The area the stroke touched, for drawing again after undo.
    number lowX = 0
    number lowZ = 0
    number highX = 0
    number highZ = 0
    boolean hasArea = false

    // Where the last dab was, so a held brush doesn't repeat it in place.
    number lastX = 0
    number lastZ = 0
    boolean dabbed = false

    // How many copies of the stroke's asset, or of every asset, there were
    // before the stroke and after it, and whether any coverage changed.
    integer countBefore = 0
    integer countAfter = 0
    boolean changedCoverage = false
    boolean going = false

    /*
        Starts a stroke.

        Attribute: Parameter terrainFoliage The terrain's foliage
        Attribute: Parameter foliageList The terrain's foliage list
        Attribute: Parameter assetNumber The asset painted or lowered, by its number in the list
        Attribute: Parameter strokeMode ADD_COPIES, REMOVE_ASSET or REMOVE_ALL
    */
    action Begin(TerrainFoliage terrainFoliage, FoliageList foliageList, integer assetNumber, integer strokeMode)
        foliage = terrainFoliage
        list = foliageList
        asset = assetNumber
        mode = strokeMode
        touched:Empty()
        before:Empty()
        after:Empty()
        hasArea = false
        dabbed = false
        changedCoverage = false
        countBefore = CountCopies()
        countAfter = countBefore
        going = true
    end

    /*
        Returns true while the stroke is going.

        Attribute: Returns True between Begin and End
    */
    action IsGoing returns boolean
        return going
    end

    /*
        Returns what the stroke does.

        Attribute: Returns ADD_COPIES, REMOVE_ASSET or REMOVE_ALL
    */
    action GetMode returns integer
        return mode
    end

    /*
        Makes a dab at the brush, if it is the first or the brush has moved
        half a radius since the last one. Draw the foliage there again
        afterward if it returns true (TerrainItem's RefreshFoliage).

        Attribute: Parameter x The brush's middle along x, in world units
        Attribute: Parameter z The brush's middle along z, in world units
        Attribute: Parameter radius The brush's radius, in world units
        Attribute: Parameter densityScale The coverage the brush paints toward, from 0 to 1; more is taken as 1
        Attribute: Returns True if any coverage changed
    */
    action Apply(number x, number z, number radius, number densityScale) returns boolean
        if not going or foliage = undefined or radius <= 0
            return false
        end
        if dabbed
            number movedX = x - lastX
            number movedZ = z - lastZ
            if movedX * movedX + movedZ * movedZ < radius * radius / 4
                return false
            end
        end
        boolean lower = mode not= ADD_COPIES
        if not lower and (list = undefined or asset < 0 or asset >= list:GetAssetCount())
            return false
        end
        dabbed = true
        lastX = x
        lastZ = z
        integer which = asset
        if mode = REMOVE_ALL
            which = -1
        end
        // Each coverage the dab reaches is kept first, for undo. A coverage
        // made by this dab has none yet, which is what it was before.
        Array<FoliageCoverage> reached = foliage:GetCoveragesNear(which, x, z, radius, not lower)
        integer i = 0
        repeat while i < reached:GetSize()
            FoliageCoverage coverage = reached:Get(i)
            if not IsTouched(coverage)
                touched:Add(coverage)
                before:Add(coverage:CopyValues())
            end
            i = i + 1
        end
        boolean changed = foliage:PaintCoverage(which, x, z, radius, densityScale, lower)
        if changed
            changedCoverage = true
            GrowArea(x, z, radius)
        end
        return changed
    end

    /*
        Returns true if a coverage was kept already.
    */
    private action IsTouched(FoliageCoverage coverage) returns boolean
        integer i = 0
        repeat while i < touched:GetSize()
            if touched:Get(i) = coverage
                return true
            end
            i = i + 1
        end
        return false
    end

    /*
        Returns how many copies there are of the stroke's asset, or of every
        asset when it lowers them all.
    */
    private action CountCopies returns integer
        if foliage = undefined
            return 0
        end
        if mode = REMOVE_ALL
            return foliage:GetCopyCount(-1)
        end
        return foliage:GetCopyCount(asset)
    end

    /*
        Grows the area the stroke touched to take in a dab.
    */
    private action GrowArea(number x, number z, number radius)
        if not hasArea
            lowX = x - radius
            highX = x + radius
            lowZ = z - radius
            highZ = z + radius
            hasArea = true
            return now
        end
        if x - radius < lowX
            lowX = x - radius
        end
        if x + radius > highX
            highX = x + radius
        end
        if z - radius < lowZ
            lowZ = z - radius
        end
        if z + radius > highZ
            highZ = z + radius
        end
    end

    /*
        Ends the stroke, keeping each touched coverage as it is now, for
        redo, and counting the copies now, so the foliage must have been
        drawn again since the last dab.

        Attribute: Returns True if the stroke changed any coverage
    */
    action End returns boolean
        going = false
        after:Empty()
        integer i = 0
        repeat while i < touched:GetSize()
            after:Add(touched:Get(i):CopyValues())
            i = i + 1
        end
        countAfter = CountCopies()
        return changedCoverage
    end

    /*
        Puts every touched coverage back as it was before the stroke. Draw
        the foliage there again afterward.
    */
    action Undo
        Restore(before)
    end

    /*
        Puts every touched coverage as it was after the stroke again. Draw
        the foliage there again afterward.
    */
    action Redo
        Restore(after)
    end

    /*
        Sets each touched coverage to kept values.
    */
    private action Restore(Array<Array<number>> kept)
        integer i = 0
        repeat while i < touched:GetSize() and i < kept:GetSize()
            touched:Get(i):SetValues(kept:Get(i))
            i = i + 1
        end
    end

    /*
        Returns how many more copies there were after the stroke than
        before, or 0 if there were fewer.

        Attribute: Returns The count
    */
    action GetAddedCount returns integer
        if countAfter > countBefore
            return countAfter - countBefore
        end
        return 0
    end

    /*
        Returns how many fewer copies there were after the stroke than
        before, or 0 if there were more.

        Attribute: Returns The count
    */
    action GetRemovedCount returns integer
        if countBefore > countAfter
            return countBefore - countAfter
        end
        return 0
    end

    /*
        Returns the middle of the area the stroke touched, along x.

        Attribute: Returns The x, in world units
    */
    action GetAreaMiddleX returns number
        return (lowX + highX) / 2
    end

    /*
        Returns the middle of the area the stroke touched, along z.

        Attribute: Returns The z, in world units
    */
    action GetAreaMiddleZ returns number
        return (lowZ + highZ) / 2
    end

    /*
        Returns how far the area the stroke touched reaches from its middle,
        at most.

        Attribute: Returns The distance, in world units
    */
    action GetAreaRadius returns number
        number halfX = (highX - lowX) / 2
        number halfZ = (highZ - lowZ) / 2
        return math:SquareRoot(halfX * halfX + halfZ * halfZ)
    end

    /*
        Returns the name of the asset the stroke painted or lowered, or
        "foliage" when it lowered them all.

        Attribute: Returns The name
    */
    action GetAssetName returns text
        if mode = REMOVE_ALL
            return "foliage"
        end
        if list = undefined or asset < 0 or asset >= list:GetAssetCount()
            return "foliage"
        end
        return list:GetAsset(asset):GetName()
    end
end
