package Libraries.Interface.Controls.Scenes.Items.Previews

use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Model
use Libraries.Interface.Controls.Scenes.Items.EditorCursor
use Libraries.Interface.Controls.Scenes.Blueprints.SpotLightBlueprint
use Libraries.Interface.Controls.Scenes.Items.Previews.ItemPreview3D
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.EditorCursor3D
use Libraries.Interface.Controls.Scenes.Items.EditorSpotLight

/*
    The SpotLightPreview is a spotlight being placed in the scene editor,
    shown as a small textured box at the cursor, as a point light's is.
    Placing it makes an EditorSpotLight with the blueprint's color,
    intensity and cone.
*/
class SpotLightPreview is ItemPreview3D
    number intensity = 0

    /*
        Loads the box, colored like the light, at the cursor.

        Attribute: Parameter controller The scene editor
        Attribute: Parameter schematic The spotlight's blueprint
    */
    action Load(SceneEditor controller, SpotLightBlueprint schematic)
        SetSceneEditor(controller)
        SetItemBlueprint(schematic)
        Color color
        color:SetColor(schematic:GetRed(), schematic:GetGreen(), schematic:GetBlue(), 0.75)
        SetName(schematic:GetName() + controller:GetNextNamePostfix(schematic:GetName()))
        SetDescription(schematic:GetDescription())
        LoadBox(0.5, 0.5, 0.5, schematic:GetModelTexture())
        SetColor(color)
        intensity = schematic:GetIntensity()
        EditorCursor cursor = controller:GetCursor()
        if cursor is EditorCursor3D
            EditorCursor3D cursor3D = cast(EditorCursor3D, cursor)
            SetPosition(cursor3D:GetX(), cursor3D:GetY(), cursor:GetZ())
        end
    end

    /*
        Returns the spotlight this preview places: an EditorSpotLight with
        the blueprint's color, intensity and cone, pointing down.

        Attribute: Returns The spotlight
    */
    action ConvertToModel returns Model
        EditorSpotLight light
        light:SetName(GetName())
        light:SetDescription(GetDescription())
        SpotLightBlueprint schematic = cast(SpotLightBlueprint, GetItemBlueprint())
        Color color = GetColor():Copy()
        color:SetAlpha(1.0)
        light:SetColor(color)
        light:SetPosition(GetPosition())
        light:SetDirection(0, -1, 0)
        light:SetConeAngles(schematic:GetInnerAngle(), schematic:GetOuterAngle())
        light:SetIntensity(intensity)
        // The light's size is the box the editor selects and picks it by.
        light:SetDimensions(0.5, 0.5, 0.5)
        return light
    end

    /*
        Sets how bright the light will be.

        Attribute: Parameter intensity The intensity
    */
    action SetIntensity(number intensity)
        me:intensity = intensity
    end

    /*
        Returns how bright the light will be.

        Attribute: Returns The intensity
    */
    action GetIntensity returns number
        return intensity
    end
end
