package Libraries.Interface.Controls.Scenes.Items.Highlights

use Libraries.Game.Graphics.Color
use Libraries.Compute.Vector3
use Libraries.Interface.Item
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.Controls.Scenes.SceneConstants
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.Items.Highlights.SelectionHighlight3D
use Libraries.Game.Graphics.Worlds.TerrainData
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Game.Graphics.Models.Data.Material
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Containers.Array
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Compute.Vector4
use Libraries.Compute.Math
use Libraries.Game.BoundingBox
use Libraries.Game.Shapes.Rectangle
use Libraries.Game.Graphics.Worlds.TerrainBrush
use Libraries.Game.Graphics.Worlds.TerrainDescriber

/*
    TerrainSelectionHighlight is the SelectionHighlight for a terrain. It is
    a border around the whole terrain, a little above the ground, so the
    terrain itself can still be seen. A terrain's
    heights are world positions, so the editor's move, turn and scale keys
    don't move it: they leave the terrain and its highlight where they are,
    and say so once each time the terrain is selected.
*/
class TerrainSelectionHighlight is SelectionHighlight3D

    EditorTerrain terrain = undefined

    // True while the highlight places itself, so its own moves go through.
    boolean placing = false

    // Whether the user has been told, since the terrain was selected, that
    // a terrain stays at the origin.
    boolean told = false

    // How far above the ground the cursor's ring is outlined for screen readers, in world units.
    constant number CURSOR_OUTLINE_LIFT = 0.25

    // How many short pieces the ring is cut into for its outline.
    constant integer CURSOR_OUTLINE_PIECES = 16

    // Says what the terrain and the spot under the cursor are like.
    TerrainDescriber describer

    // The cursor's reading (GetAccessibilityCursor), made again only when
    // the cursor moves, changes size or reaches the edge: where it was
    // made, and which piece the reading starts with: the place along x or
    // z, whichever changed last, or the size.
    text reading = ""
    boolean readPlaced = false
    number readX = 0
    number readZ = 0
    number readSize = 0
    boolean readEdge = false
    integer lead = 0
    constant integer LEAD_X = 0
    constant integer LEAD_Z = 1
    constant integer LEAD_SIZE = 2

    on create
        // The border spans the whole terrain, so it lets clicks through to
        // the scene editor, which picks the ground itself.
        SetAcceptsMouseInput(false)
        // What screen readers call it, instead of a generic item.
        SetAccessibilityRoleDescription("terrain")
    end

    // How many straight pieces make up each edge of the border.
    constant integer BORDER_SEGMENTS = 64

    // How far above the ground the border floats, in world units.
    constant number BORDER_LIFT = 0.15

    /*
        Loads a border around the whole terrain: a flat band just outside
        its edges, a little above the ground, following the ground's height
        along each edge. A box over the terrain would hide it, since the 3D
        view draws a highlight's color nearly solid.

        Attribute: Parameter terrain The terrain being selected
        Attribute: Parameter controller The scene editor
    */
    action LoadTerrain(EditorTerrain terrain, SceneEditor controller)
        Color color = undefined
        SceneConstants constants = GetConstants()
        if IsFocused()
            color = constants:SELECTION_HIGHLIGHT_SELECTED_COLOR
        else
            color = constants:SELECTION_HIGHLIGHT_UNSELECTED_COLOR
        end
        number padding = constants:SELECTION_HIGHLIGHT_PADDING_3D

        number minimumX = terrain:GetMinimumX()
        number maximumX = terrain:GetMaximumX()
        number minimumZ = terrain:GetMinimumZ()
        number maximumZ = terrain:GetMaximumZ()
        TerrainData data = terrain:GetWorldTerrain():GetData()

        LoadBorder(data, minimumX, maximumX, minimumZ, maximumZ, padding / 2, color)

        me:terrain = terrain
        SetSceneEditor(controller)
    end

    /*
        Builds the border's mesh and loads it. Each edge is a strip of quads,
        drawn from both sides, from the inside of the band to the outside.
        The band's ends reach past the corners, so the four strips overlap
        there and the corners are filled.
    */
    private action LoadBorder(TerrainData data, number minimumX, number maximumX, number minimumZ, number maximumZ, number gap, Color color)
        Math math
        number centerX = (minimumX + maximumX) / 2
        number centerZ = (minimumZ + maximumZ) / 2
        number band = math:MaximumOf(0.15, math:MaximumOf(maximumX - minimumX, maximumZ - minimumZ) * 0.004)
        number innerLeft = minimumX - gap
        number innerRight = maximumX + gap
        number innerNear = minimumZ - gap
        number innerFar = maximumZ + gap

        integer pointCount = BORDER_SEGMENTS + 1
        integer vertexCount = 4 * pointCount * 2
        Number32BitArray vertices
        Number32BitArray normals
        Number32BitArray tangents
        Number32BitArray bitangents
        Number32BitArray textureCoordinates
        Integer32BitArray indices
        vertices:SetSize(vertexCount * 3)
        normals:SetSize(vertexCount * 3)
        tangents:SetSize(vertexCount * 3)
        bitangents:SetSize(vertexCount * 3)
        textureCoordinates:SetSize(vertexCount * 2)
        indices:SetSize(4 * BORDER_SEGMENTS * 12)

        number lowest = 0
        number highest = 0
        boolean first = true
        number lastHeight = 0
        if data:HasHeight(centerX, centerZ)
            lastHeight = data:GetSurfaceHeight(centerX, centerZ)
        end

        number segmentCount = BORDER_SEGMENTS
        integer index = 0
        integer side = 0
        repeat while side < 4
            integer point = 0
            repeat while point < pointCount
                number along = point / segmentCount
                // Where the band's inside edge is, where its outside edge is,
                // and the ground point just inside the terrain whose height
                // the band takes.
                number innerX = 0
                number innerZ = 0
                number outerX = 0
                number outerZ = 0
                if side = 0
                    innerX = innerLeft - band + (innerRight - innerLeft + 2 * band) * along
                    outerX = innerX
                    innerZ = innerNear
                    outerZ = innerNear - band
                elseif side = 1
                    innerX = innerLeft - band + (innerRight - innerLeft + 2 * band) * along
                    outerX = innerX
                    innerZ = innerFar
                    outerZ = innerFar + band
                elseif side = 2
                    innerZ = innerNear - band + (innerFar - innerNear + 2 * band) * along
                    outerZ = innerZ
                    innerX = innerLeft
                    outerX = innerLeft - band
                else
                    innerZ = innerNear - band + (innerFar - innerNear + 2 * band) * along
                    outerZ = innerZ
                    innerX = innerRight
                    outerX = innerRight + band
                end

                number groundX = math:MinimumOf(math:MaximumOf(innerX, minimumX + 0.01), maximumX - 0.01)
                number groundZ = math:MinimumOf(math:MaximumOf(innerZ, minimumZ + 0.01), maximumZ - 0.01)
                if data:HasHeight(groundX, groundZ)
                    lastHeight = data:GetSurfaceHeight(groundX, groundZ)
                end
                if first or lastHeight < lowest
                    lowest = lastHeight
                end
                if first or lastHeight > highest
                    highest = lastHeight
                end
                first = false

                integer vertex = (side * pointCount + point) * 2
                SetBorderVertex(vertices, normals, tangents, bitangents, textureCoordinates, vertex, innerX - centerX, lastHeight, innerZ - centerZ)
                SetBorderVertex(vertices, normals, tangents, bitangents, textureCoordinates, vertex + 1, outerX - centerX, lastHeight, outerZ - centerZ)

                if point > 0
                    integer innerA = vertex - 2
                    integer outerA = vertex - 1
                    index = AddBorderQuad(indices, index, innerA, outerA, vertex, vertex + 1)
                    index = AddBorderQuad(indices, index, innerA, vertex, outerA, vertex + 1)
                end
                point = point + 1
            end
            side = side + 1
        end

        // The model sits halfway between the lowest and highest ground, so
        // its bounds are centered on it, and the heights become offsets.
        number middle = (lowest + highest) / 2
        integer place = 0
        repeat while place < vertexCount
            vertices:Set(place * 3 + 1, vertices:Get(place * 3 + 1) + BORDER_LIFT - middle)
            place = place + 1
        end

        MeshData mesh
        mesh:SetVertices(vertices)
        mesh:SetIndices(indices)
        mesh:SetNormals(normals)
        mesh:SetTangents(tangents)
        mesh:SetBitangents(bitangents)
        mesh:SetTextureCoordinates(textureCoordinates)
        mesh:SetMaterialIndex(0)

        Array<MeshData> meshes
        meshes:Add(mesh)
        Material material
        Vector4 diffuse
        diffuse:Set(1, 1, 1, 1)
        material:SetDiffuse(diffuse)
        Array<Material> materials
        materials:Add(material)
        ModelData modelData
        modelData:SetID("Terrain selection border " + GetHashCode())
        modelData:SetMeshes(meshes)
        modelData:SetMaterials(materials)

        ModelManagerVulkan manager
        ModelBlueprintVulkan borderBlueprint = manager:GetModelBlueprint(modelData)
        Load(borderBlueprint)
        parent:Model:SetColor(color)
        SetCastsShadows(false)

        placing = true
        SetPosition(centerX, middle, centerZ)
        placing = false
        SetWidth(innerRight - innerLeft + 2 * band)
        SetHeight(highest - lowest + 2 * BORDER_LIFT)
        SetDepth(innerFar - innerNear + 2 * band)
    end

    /*
        Sets one of the border's corners. Every corner faces up.
    */
    private action SetBorderVertex(Number32BitArray vertices, Number32BitArray normals, Number32BitArray tangents, Number32BitArray bitangents, Number32BitArray textureCoordinates, integer vertex, number x, number y, number z)
        vertices:Set(vertex * 3, x)
        vertices:Set(vertex * 3 + 1, y)
        vertices:Set(vertex * 3 + 2, z)
        normals:Set(vertex * 3, 0)
        normals:Set(vertex * 3 + 1, 1)
        normals:Set(vertex * 3 + 2, 0)
        tangents:Set(vertex * 3, 1)
        tangents:Set(vertex * 3 + 1, 0)
        tangents:Set(vertex * 3 + 2, 0)
        bitangents:Set(vertex * 3, 0)
        bitangents:Set(vertex * 3 + 1, 0)
        bitangents:Set(vertex * 3 + 2, 1)
        textureCoordinates:Set(vertex * 2, 0)
        textureCoordinates:Set(vertex * 2 + 1, 0)
    end

    /*
        Adds two triangles for one quad to the list of indices, and returns
        where the next ones go.
    */
    private action AddBorderQuad(Integer32BitArray indices, integer index, integer a, integer b, integer c, integer d) returns integer
        indices:Set(index, a)
        indices:Set(index + 1, b)
        indices:Set(index + 2, c)
        indices:Set(index + 3, c)
        indices:Set(index + 4, b)
        indices:Set(index + 5, d)
        return index + 6
    end

    /*
        Returns the terrain that is being selected.
    */
    action GetItem returns Item
        return terrain
    end

    /*
        Returns the terrain that is being selected.
    */
    action GetEditorTerrain returns EditorTerrain
        return terrain
    end

    action GainedSelection
        parent:SelectionHighlight3D:GainedSelection()
        told = false
    end

    /*
        When the terrain gets the focus, its cursor does: it is placed if it
        has no place yet, its ring shows, and the camera follows it.
    */
    action GainedFocus(FocusEvent event)
        parent:EditorItem:GainedFocus(event)
        if terrain not= undefined and GetSceneEditor() not= undefined
            GetSceneEditor():FocusTerrainCursor(me)
        end
    end

    /*
        A screen reader reads this as the terrain's help, after its name:
        what the whole terrain is like (TerrainDescriber:DescribeTerrain,
        measured again only after the terrain changes), then the cursor's
        size, its step with the grid on, and the tool if one is chosen.
        Where the cursor is, is read from its row instead
        (GetAccessibilityCursor).
    */
    action GetDescription returns text
        if terrain = undefined or GetSceneEditor() = undefined
            return parent:Item:GetDescription()
        end
        SceneEditor sceneEditor = GetSceneEditor()
        text settings = "Cursor size " + describer:FormatAmount(terrain:GetBrush():GetSize()) + "."
        if sceneEditor:IsGridSnapping()
            settings = settings + " Step " + describer:FormatAmount(sceneEditor:GetTerrainCursorStep(terrain)) + "."
        end
        if terrain:HasTool()
            settings = settings + " " + terrain:GetToolName(terrain:GetToolNumber()) + " tool."
        end
        text whole = describer:DescribeTerrain(terrain)
        if whole = ""
            return settings
        end
        return whole + " " + settings
    end

    /*
        Returns the terrain cursor's reading, which a screen reader reads as
        a newly selected row each time it changes while the terrain has the
        focus, with no message: "where am I" first, starting with what just
        changed, such as "13 x, 40 z. 18 high, grass, hillside" after a move
        along x, "41 z, 13 x. ..." after a move along z, and "Edge, 13 x,
        40 z. ..." when a move was stopped by the edge. It is made again only when
        the cursor moves, changes size or reaches the edge, so it is cheap
        to ask every frame, and an edit under a still cursor doesn't make it
        read again.

        Attribute: Returns The reading, or an empty text while the cursor isn't in use.
    */
    action GetAccessibilityCursor returns text
        if not CursorInUse() or not terrain:IsBrushPlaced()
            return ""
        end
        SceneEditor sceneEditor = GetSceneEditor()
        number x = terrain:GetBrushX()
        number z = terrain:GetBrushZ()
        TerrainBrush cursorBrush = terrain:GetBrush()
        number size = cursorBrush:GetSize()
        boolean atEdge = sceneEditor:IsTerrainCursorAtEdge()
        if readPlaced and x = readX and z = readZ and size = readSize and atEdge = readEdge
            return reading
        end
        if readPlaced
            Math leadMath
            number changeX = leadMath:AbsoluteValue(x - readX)
            number changeZ = leadMath:AbsoluteValue(z - readZ)
            if changeX > 0 or changeZ > 0
                if changeZ > changeX
                    lead = LEAD_Z
                else
                    lead = LEAD_X
                end
            elseif size not= readSize
                lead = LEAD_SIZE
            elseif lead = LEAD_SIZE
                // Only the edge changed: it leads, then the place.
                lead = LEAD_X
            end
        end
        readPlaced = true
        readX = x
        readZ = z
        readSize = size
        readEdge = atEdge
        reading = BuildCursorReading()
        return reading
    end

    /*
        Puts the cursor's reading together from its pieces, in the order
        they are heard: the edge if a move was stopped by it, the size if
        that is what changed, the place (GetCursorPlace), then what the spot
        is like (TerrainDescriber:DescribeSpot). Any piece that doesn't
        apply is left out.
    */
    private action BuildCursorReading returns text
        text result = ""
        if readEdge
            result = "Edge, "
        end
        if lead = LEAD_SIZE
            result = result + describer:FormatAmount(readSize) + " size, "
        end
        result = result + GetCursorPlace(lead = LEAD_Z)
        text spot = describer:DescribeSpot(terrain, readX, readZ)
        if spot not= ""
            result = result + ". " + spot
        elseif not terrain:IsBrushOnGround()
            result = result + ". No ground"
        end
        return result
    end

    /*
        Returns where the cursor is, as its place along x and z, value first,
        with the one that just changed first, such as "13 x, 40 z" or
        "41 z, 13 x". This is the one piece to change to say the place
        another way, such as by grid cell.
    */
    private action GetCursorPlace(boolean zFirst) returns text
        text placeX = describer:FormatAmount(readX) + " x"
        text placeZ = describer:FormatAmount(readZ) + " z"
        if zFirst
            return placeZ + ", " + placeX
        end
        return placeX + ", " + placeZ
    end

    /*
        Returns the part of the window a screen reader outlines: while the
        terrain cursor is in use and on the ground, the cursor's ring, so
        the outline follows the cursor; otherwise the border around the
        whole terrain, as for any item.

        Attribute: Returns The rectangle, or undefined if none of it shows.
    */
    action GetScreenBounds returns Rectangle
        if not CursorInUse() or not terrain:IsBrushPlaced() or not terrain:IsBrushOnGround()
            return parent:Item3D:GetScreenBounds()
        end
        return GetCursorScreenBounds()
    end

    /*
        Returns the part of the window the cursor's ring covers. The ring is
        cut into short pieces around its outside edge, at the ground's
        height as TerrainBrushPreview:Place draws it, and the boxes of the
        pieces are projected and joined. A square box around the whole ring
        reaches past it at the corners, which the camera's perspective
        widens further: about half as wide again as the ring.
    */
    private action GetCursorScreenBounds returns Rectangle
        Math ringMath
        TerrainData data = terrain:GetWorldTerrain():GetData()
        number centerX = terrain:GetBrushX()
        number centerZ = terrain:GetBrushZ()
        TerrainBrush cursorBrush = terrain:GetBrush()
        number radius = cursorBrush:GetSize()
        // The ring's outside edge, with its dark border, as drawn.
        number outer = radius + ringMath:MaximumOf(0.08, radius * 0.03) * 1.1
        number centerHeight = 0
        if data:HasHeight(centerX, centerZ)
            centerHeight = data:GetSurfaceHeight(centerX, centerZ)
        end

        number left = 0
        number bottom = 0
        number right = 0
        number top = 0
        boolean found = false
        number lastX = centerX + outer
        number lastZ = centerZ
        number lastHeight = GetGroundAt(data, lastX, lastZ, centerHeight)
        integer piece = 1
        repeat while piece <= CURSOR_OUTLINE_PIECES
            number angle = 2 * ringMath:pi * piece / CURSOR_OUTLINE_PIECES
            number pieceX = centerX + outer * ringMath:Cosine(angle)
            number pieceZ = centerZ + outer * ringMath:Sine(angle)
            number pieceHeight = GetGroundAt(data, pieceX, pieceZ, centerHeight)
            Vector3 minimum
            minimum:Set(ringMath:MinimumOf(lastX, pieceX), ringMath:MinimumOf(lastHeight, pieceHeight), ringMath:MinimumOf(lastZ, pieceZ))
            Vector3 maximum
            maximum:Set(ringMath:MaximumOf(lastX, pieceX), ringMath:MaximumOf(lastHeight, pieceHeight) + CURSOR_OUTLINE_LIFT, ringMath:MaximumOf(lastZ, pieceZ))
            BoundingBox pieceBox
            pieceBox:Set(minimum, maximum)
            Rectangle pieceBounds = GetScreenBoundsOfBox(pieceBox)
            if pieceBounds not= undefined
                number pieceRight = pieceBounds:GetX() + pieceBounds:GetWidth()
                number pieceTop = pieceBounds:GetY() + pieceBounds:GetHeight()
                if not found or pieceBounds:GetX() < left
                    left = pieceBounds:GetX()
                end
                if not found or pieceBounds:GetY() < bottom
                    bottom = pieceBounds:GetY()
                end
                if not found or pieceRight > right
                    right = pieceRight
                end
                if not found or pieceTop > top
                    top = pieceTop
                end
                found = true
            end
            lastX = pieceX
            lastZ = pieceZ
            lastHeight = pieceHeight
            piece = piece + 1
        end
        if not found
            return undefined
        end
        Rectangle bounds
        bounds:SetRectangle(left, bottom, right - left, top - bottom)
        return bounds
    end

    /*
        Returns the ground's height at a place, or the fallback where there
        is no ground, as the ring is drawn there.
    */
    private action GetGroundAt(TerrainData data, number x, number z, number fallback) returns number
        if data:HasHeight(x, z)
            return data:GetSurfaceHeight(x, z)
        end
        return fallback
    end

    /*
        When the terrain stops being selected, its tool is put aside and
        remembered, so the arrow keys and clicks act on the scene again, and
        the tool comes back when the user returns (Round 2).
    */
    action LostSelection
        parent:SelectionHighlight3D:LostSelection()
        if terrain not= undefined and GetSceneEditor() not= undefined
            // Leaves the tool quietly and hides the cursor's ring.
            GetSceneEditor():LeaveTerrainCursor(terrain)
        end
    end

    /*
        Returns true while the arrow keys move the terrain cursor, which is
        whenever the terrain is selected in an editor.
    */
    private action CursorInUse returns boolean
        return terrain not= undefined and GetSceneEditor() not= undefined
    end

    // A terrain isn't moved, turned or scaled. The Set calls use these
    // Move calls too, so they are covered.

    action MoveX(number x)
        // The move keys move the terrain cursor, which is the brush when a
        // tool is chosen.
        if CursorInUse()
            GetSceneEditor():MoveTerrainBrush(terrain, x, 0)
            return now
        end
        if placing
            parent:Model:MoveX(x)
        else
            TellStaysAtOrigin()
        end
    end

    action MoveY(number y)
        // A terrain's cursor stays on the ground, so up and down don't move it.
        if CursorInUse()
            return now
        end
        if placing
            parent:Model:MoveY(y)
        else
            TellStaysAtOrigin()
        end
    end

    action MoveZ(number z)
        // The move keys move the terrain cursor, which is the brush when a
        // tool is chosen.
        if CursorInUse()
            GetSceneEditor():MoveTerrainBrush(terrain, 0, -z)
            return now
        end
        if placing
            parent:Model:MoveZ(z)
        else
            TellStaysAtOrigin()
        end
    end

    action Move(number x, number y, number z)
        // The move keys move the terrain cursor, which is the brush when a
        // tool is chosen.
        if CursorInUse()
            GetSceneEditor():MoveTerrainBrush(terrain, x, -z)
            return now
        end
        if placing
            parent:Model:Move(x, y, z)
        else
            TellStaysAtOrigin()
        end
    end

    action Move(Vector3 vector)
        // The move keys move the terrain cursor, which is the brush when a
        // tool is chosen.
        if CursorInUse()
            GetSceneEditor():MoveTerrainBrush(terrain, vector:GetX(), -vector:GetZ())
            return now
        end
        if placing
            parent:Model:Move(vector)
        else
            TellStaysAtOrigin()
        end
    end

    action SetRotation(Vector3 rotation)
        TellStaysAtOrigin()
    end

    action SetRotation(number newYaw, number newPitch, number newRoll)
        TellStaysAtOrigin()
    end

    action Scale(Vector3 vector)
        Scale(vector:GetX(), vector:GetY(), vector:GetZ())
    end

    action Scale(number x, number y, number z)
        // The size keys size the brush, which is the terrain cursor's ring,
        // with or without a tool (Round 2). Only the keys that scale evenly
        // do; the one-axis keys say a terrain isn't scaled.
        if CursorInUse()
            if x > 1 and y > 1 and z > 1
                GetSceneEditor():ResizeTerrainBrush(terrain, true)
                return now
            elseif x < 1 and y < 1 and z < 1
                GetSceneEditor():ResizeTerrainBrush(terrain, false)
                return now
            end
        end
        TellStaysAtOrigin()
    end

    action ResetScale
    end

    /*
        Says, once each time the terrain is selected, that a terrain stays at
        the origin.
    */
    private action TellStaysAtOrigin
        if not told and GetSceneEditor() not= undefined
            told = true
            NotifyAccessibility("A terrain stays at the origin. It can't be moved, turned or scaled.")
        end
    end
end
