package Libraries.Interface.Controls.Scenes.Items.Highlights

use Libraries.Game.Scenes.SceneProperties
use Libraries.Interface.Item3D
use Libraries.Interface.Events.FocusEvent
use Libraries.Game.Graphics.Color
use Libraries.Compute.Vector3
use Libraries.Game.BoundingBox
use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Compute.Matrix4
use Libraries.Interface.Controls.Scenes.SceneConstants
use Libraries.Interface.Controls.Scenes.Items.EditorModel
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D
use Libraries.Interface.Controls.Scenes.Items.Highlights.SelectionHighlight
use Libraries.Interface.Controls.Scenes.SceneEditor

/*
    SelectionHighlight3D represents the SelectionHighlight of a 3D item. The selection
    will appear as a cube over the item. This class also contains actions to change
    properties specific to 3D items.
*/
class SelectionHighlight3D is EditorItem3D, SelectionHighlight
    
    EditorModel item = undefined

    // True while the box is drawn faint, such as over a vehicle whose
    // guides show inside it, and whether it is selected now.
    boolean faint = false
    boolean selectedNow = false
    constant number FAINT_SELECTED_OPACITY = 0.15
    constant number FAINT_UNSELECTED_OPACITY = 0.1

    on create
        SetInputGroup("SelectionHighlight3D")
    end

    action GetAccessibleParent returns Item
        return parent:EditorItem:GetAccessibleParent()
    end

    /*
        Loads a box that is big enough to contain the entire selected item.
    */
    action Load(EditorModel item, SceneEditor controller)
        Color color = undefined
        SceneConstants constants = GetConstants()

        selectedNow = IsFocused()
        if IsFocused()
            color = constants:SELECTION_HIGHLIGHT_SELECTED_COLOR
        else
            color = constants:SELECTION_HIGHLIGHT_UNSELECTED_COLOR
        end

        number padding = constants:SELECTION_HIGHLIGHT_PADDING_3D

        SceneProperties properties

        SetScale(item:GetScaleX(), item:GetScaleY(), item:GetScaleZ())

        // The box is scaled with the item, so the padding is divided by the
        // scale, to stay the same size in the world at any scale.
        number boxWidth = item:GetWidth() + padding / ScaleOrOne(item:GetScaleX())
        number boxHeight = item:GetHeight() + padding / ScaleOrOne(item:GetScaleY())
        number boxDepth = item:GetDepth() + padding / ScaleOrOne(item:GetScaleZ())

        boolean loadedShape = false
        if item is Model
            Model model = cast(Model, item)
            integer type = model:GetModelType()
            if type = properties:BOX
                LoadBox(boxWidth, boxHeight, boxDepth, color)
                loadedShape = true
            elseif type = properties:SPHERE
                LoadSphere(boxWidth, boxHeight, boxDepth, color)
                loadedShape = true
            elseif type = properties:CYLINDER
                LoadCylinder(boxWidth, boxHeight, boxDepth, color)
                loadedShape = true
            elseif type = properties:PLANE
                LoadBox(boxWidth, padding / ScaleOrOne(item:GetScaleY()), boxDepth, color)
                loadedShape = true
            end
        end

        if loadedShape = false
            LoadBox(boxWidth, boxHeight, boxDepth, color)
        end

        SetRotationTransform(item:GetRotationTransform())

        // The box goes over the middle of the model's shape, not its
        // origin. The item isn't set yet, so this moves only the box.
        SetPosition(GetItemMiddle(item))

        me:item = item
        SetSceneEditor(controller)
    end

    /*
        Returns the size of a scale, ignoring its sign, or 1 for a scale of
        0, so it can be divided by.
    */
    private action ScaleOrOne(number scale) returns number
        number size = scale
        if size < 0
            size = -size
        end
        if size = 0
            return 1
        end
        return size
    end

    /*
        Returns where the middle of an item's shape is in the world. A
        model's mesh is often not centered on the model's origin, such as a
        figure whose origin is at its feet, so the middle of its bounds is
        taken through the model's position, turn and scale.
    */
    private action GetItemMiddle(EditorModel item) returns Vector3
        Vector3 middle
        middle:Set(item:GetGlobalX(), item:GetGlobalY(), item:GetGlobalZ())
        if item:GetModelBlueprint() = undefined
            return middle
        end
        BoundingBox box = item:CalculateBoundingBox()
        if not box:IsValid()
            return middle
        end
        middle:Set(box:GetCenter())
        middle:Multiply(item:GetTransform())
        return middle
    end

    /*
        Moves the box, and not the item, back over the middle of the item's
        shape, such as after the item is turned or scaled, which turns or
        scales the box around its own middle.
    */
    action PlaceOverItem
        if item = undefined
            return now
        end
        Vector3 middle = GetItemMiddle(item)
        parent:Model:Move(middle:GetX() - GetGlobalX(), middle:GetY() - GetGlobalY(), middle:GetZ() - GetGlobalZ())
    end

    /*
        Returns the item that is being selected
    */
    action GetItem returns Item
        return item
    end

    /*
        This action changes the color of the highlight cube. When selection is gained the highlight
        is much brighter.
    */
    action GainedSelection
        selectedNow = true
        ShowColor()
    end

    /*
        This action changes the color of the highlight cube. When selection is lost the highlight
        is much dimmer.
    */
    action LostSelection
        selectedNow = false
        ShowColor()
    end

    /*
        This action draws the box faint, or as usual, such as so the vehicle
        guides inside a selected car show. A faint box keeps its color, so it
        still reads as selected or not.

        Attribute: Parameter value True to draw the box faint
    */
    action SetFaint(boolean value)
        faint = value
        ShowColor()
    end

    /*
        Gives the box its color: selected or not, and faint or not.
    */
    private action ShowColor
        Color color = GetConstants():SELECTION_HIGHLIGHT_UNSELECTED_COLOR
        number opacity = FAINT_UNSELECTED_OPACITY
        if selectedNow
            color = GetConstants():SELECTION_HIGHLIGHT_SELECTED_COLOR
            opacity = FAINT_SELECTED_OPACITY
        end
        if faint
            Color faded
            faded:SetColor(color:GetRed(), color:GetGreen(), color:GetBlue(), opacity)
            parent:Model:SetColor(faded)
        else
            parent:Model:SetColor(color)
        end
    end

    // Overriding the Move calls below also overrides the SetX/Y/Z/Position calls, which use Move in their implementation.

    /*
        Moves the 3D item 
    */
    action MoveX(number x)
        parent:Model:MoveX(x)
        if item not= undefined
            item:MoveX(x)
        end
    end

    action MoveY(number y)
        parent:Model:MoveY(y)
        if item not= undefined
            item:MoveY(y)
        end
    end

    action MoveZ(number z)
        parent:Model:MoveZ(z)
        if item not= undefined
            item:MoveZ(z)
        end
    end

    action Move(number x, number y, number z)
        parent:Model:Move(x, y, z)
        if item not= undefined
            item:Move(x, y, z)
        end
    end

    action Move(Vector3 vector)
        parent:Model:Move(vector)
        if item not= undefined
            item:Move(vector)
        end
    end
end