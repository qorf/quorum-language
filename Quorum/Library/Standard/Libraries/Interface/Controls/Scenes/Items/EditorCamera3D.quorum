package Libraries.Interface.Controls.Scenes.Items

use Libraries.Game.Graphics.PerspectiveCamera
use Libraries.Interface.Item3D
use Libraries.Compute.Matrix4
use Libraries.Compute.Quaternion
use Libraries.Compute.Vector3
use Libraries.Compute.Math

/*
    EditorCamera3D represents the PerspectiveCamera in a 3D scene that shows the objects in the 3D layer
    of the user's scene. This camera affects what is drawn when the game is ran which unlike the preview
    of an EditorLayer3D. The EditorCamera3D can be rotated like a 3D object and it can focus on a target
    in a 3D scene to make editing easier.
*/
class EditorCamera3D is PerspectiveCamera

    // The currently focused target. The camera tries to follow this.
    Item3D target = undefined

    // How far the camera tries to stay away from the focused object
    number distance = 10

    
    // A matrix storing the rotation component of the assigned yaw/pitch.
    Matrix4 rotationMatrix

    // A reusable quaternion used to recalculate the rotation matrix when the yaw/pitch changes.
    Quaternion calcQuaternion

    // Reusable vectors used for calculations.
    Vector3 calcVector1
    Vector3 calcVector2

    // Euler angle values used for rotation.
    number yaw = 0
    number pitch = 45
    number roll = 0

    // An orbit's point, distance and angles (StartOrbit, OrbitBy).
    Vector3 orbitPoint
    number orbitDistance = 10
    number orbitYaw = 0
    number orbitPitch = 0
    boolean orbitStarted = false

    // Zooming (ZoomBy): the share of the view distance one step moves, the
    // smallest step, and how close to the target the camera may come.
    constant number ZOOM_SHARE = 0.12
    constant number SMALLEST_ZOOM_STEP = 0.5
    constant number CLOSEST_ZOOM = 0.5
    constant number PITCH_OFFSET = 0.001

    on create
        calcQuaternion:SetEulerAngles(yaw, pitch, roll)
        rotationMatrix:Set(calcQuaternion)

        // The raw values are used to position the camera in UpdateCameraPosition.
        // We pass the negative values here to make the camera look back at the focus position.
        SetYawPitchRoll(-yaw, -pitch, -roll)

        calcVector1:Set(0, 0, -distance)
        // The position stored in calcVector1 is transformed by our precomputed rotations and stored in calcVector2.
        rotationMatrix:TransformWorldCoordinate(calcVector1, calcVector2)

        SetPosition(calcVector2)
    end

    /*
        SetTarget updates the camera's position so that is pointed towards a 3D item in the scene.
        The camera can not snap to itself so camera objects will be ignored. 

        Attribute: Parameter target The 3D item the camera should focus on
    */
    action SetTarget(Item3D target)
        // We don't want to allow the camera to try to snap to itself.
        // We ignore requests to target a CameraItem.
        if target is CameraItem
            return now
        end

        // The same target again, such as after a click that leaves the
        // selection as it was, keeps the view where the user put it.
        if target = me:target
            return now
        end

        me:target = target
        UpdateCameraPosition()
    end

    /*
        SetTargetWithoutMoving makes an item the camera's target, keeping the
        camera where it is: its angle and distance are matched to the view.
        When the target moves later, such as the cursor with the arrow keys,
        the camera follows it from there.

        Attribute: Parameter target The 3D item the camera should follow
    */
    action SetTargetWithoutMoving(Item3D target)
        if target is CameraItem
            return now
        end
        me:target = target
        MatchView()
    end

    /*
        MatchView makes the camera's own angle and distance match where it is
        and where it looks, after the mouse moved it directly: zooming with
        the wheel, panning, turning or orbiting. Moving to a new target then
        keeps the user's angle and zoom, instead of going back to the ones
        from before.
    */
    action MatchView
        Math math
        Vector3 direction = GetDirection()
        number directionY = direction:GetY()
        if directionY > 1
            directionY = 1
        elseif directionY < -1
            directionY = -1
        end
        // The inverse of UpdateCameraRotation, which looks along the yaw and
        // the negative pitch.
        yaw = math:RadiansToDegrees(math:InverseTangent2(direction:GetX(), direction:GetZ()))
        pitch = -math:RadiansToDegrees(math:InverseSine(directionY))
        calcQuaternion:SetEulerAngles(yaw, pitch, roll)
        rotationMatrix:Set(calcQuaternion)

        // The distance is how far ahead of the camera the target is.
        if target not= undefined
            Vector3 position = GetPosition()
            Vector3 targetPosition = target:GetPosition()
            number ahead = (targetPosition:GetX() - position:GetX()) * direction:GetX() +
                (targetPosition:GetY() - position:GetY()) * direction:GetY() +
                (targetPosition:GetZ() - position:GetZ()) * direction:GetZ()
            if ahead < 0.5
                ahead = 0.5
            end
            distance = ahead
        end
    end

    /*
        GetTarget returns what the EditorCamera is targeted on.

        Attribute: Returns The 3D object the camera is using as a target
    */
    action GetTarget returns Item3D
        return target
    end

    /*
        SetDistance sets how far away the camera is away from its target. The farther
        away the camera is from the target the more of the scene will be visible around
        the target.

        Attribute: Parameter distance The distance the camera should be away from the target
    */
    action SetDistance(number distance)
        me:distance = distance
        UpdateCameraPosition()
    end


    /*
        Returns how far away the camera is from the target. Returns a number but in 3D space
        the number does not represent a pixel but units in the 3D space.
    */
    action GetDistance returns number
        return distance
    end

    /*
        LookAlong turns the camera to look along a direction, keeping it
        level: its up is worked out again from the world's up, so turning
        never tips the horizon (roll). Setting only the direction kept the
        old up, which leaned once the camera was pitched, so the mouse's
        turns rolled the view.

        Attribute: Parameter newDirection The direction to look along
    */
    action LookAlong(Vector3 newDirection)
        Vector3 look = newDirection:Copy()
        look:Normalize()
        SetDirection(look)
        // Right is the look crossed with the world's up; up is right
        // crossed with the look. Straight up or down has no right, so the
        // up stays as it was.
        Vector3 worldUp
        worldUp:Set(0, 1, 0)
        Vector3 right = look:Copy():CrossProduct(worldUp)
        if right:Length() > 0.0001
            right:Normalize()
            Vector3 level = right:Copy():CrossProduct(look)
            level:Normalize()
            SetUp(level)
        end
    end

    /*
        GetViewDistance returns how far the camera is from what it looks at,
        for scaling how far the mouse moves it: the distance ahead to its
        target if it has one, else its height above the ground (height 0),
        kept between 2 and 400.

        Attribute: Returns The distance, in world units
    */
    action GetViewDistance returns number
        Math math
        number reference = 0
        Vector3 position = GetPosition()
        if target not= undefined
            Vector3 direction = GetDirection()
            Vector3 targetPosition = target:GetPosition()
            reference = (targetPosition:GetX() - position:GetX()) * direction:GetX() +
                (targetPosition:GetY() - position:GetY()) * direction:GetY() +
                (targetPosition:GetZ() - position:GetZ()) * direction:GetZ()
        else
            reference = math:AbsoluteValue(position:GetY())
        end
        if reference < 2
            reference = 2
        elseif reference > 400
            reference = 400
        end
        return reference
    end

    /*
        This actiopn takes the yaw, pitch, and roll to calculate the rotation matrix of the camera and
        rotates it properly.
    */
    private action UpdateCameraRotation
        calcQuaternion:SetEulerAngles(yaw, pitch, roll)
        rotationMatrix:Set(calcQuaternion)

        // The raw values are used to position the camera in UpdateCameraPosition.
        // We pass the negative values here to make the camera look back at the focus position.
        SetYawPitchRoll(yaw, -pitch, roll)

        UpdateCameraPosition()
    end

    /*
        UpdateCameraPosition repositions the camera so that it is positioned properly the set distance
        away from the target and rotates to face it. If there is no target then this action does nothing
        to the position.
    */
    action UpdateCameraPosition
        if target = undefined
            return now
        end

        calcVector1:Set(0, 0, -distance)
        calcVector2:Set(0, 0, 0)
        // The position stored in calcVector1 is transformed by our precomputed rotations and stored in calcVector2.
        rotationMatrix:TransformWorldCoordinate(calcVector1, calcVector2)

        calcVector1:Set(target:GetPosition())
        calcVector1:Add(calcVector2)

        SetPosition(calcVector1)
        Update()
    end

    /*
        Returns the yaw of the camera.
    */
    action GetYaw returns number
        return yaw
    end

    /*
        Sets the yaw of the camera.
    */
    action SetYaw(number yaw)
        me:yaw = yaw
        UpdateCameraRotation()
    end

    /*
        Returns the pitch of the camera.
    */
    action GetPitch returns number
        return pitch
    end

    /*
        Sets the pitch of the camera.
    */
    action SetPitch(number pitch)
        me:pitch = pitch
        UpdateCameraRotation()
    end

    /*
        Returns the roll of the camera.
    */
    action GetRoll returns number
        return roll
    end

    /*
        Sets the roll of the camera.
    */
    action SetRoll(number roll)
        me:roll = roll
        UpdateCameraRotation()
    end

    /*
        This action sets the orientation of the 3D object using yaw, pitch, and roll
        angles in degrees.
    
        The yaw describes how far the camera is rotated along the X/Z axis. It
        effectively controls how the camera turns left and right. A positive value
        will rotate the camera clockwise (typically to the right).
    
        The pitch describes how far the camera is angled up or down. The pitch value
        should typically be between -90 and 90 degrees. Larger values will cause the
        camera to look in the opposite direction specified by the yaw value. For
        pitch values between -90 and 90, positive values angle the camera upwards,
        and negative values angle it downwards.
    
        The roll describes how the top of the camera is oriented. A roll value of 0
        will angle the camera so the top of the camera points upward, towards the
        positive Y axis. A positive roll value "twists" the camera clockwise, and a
        negative value will twist it counter-clockwise.
    
        Attribute: Parameter yaw The yaw angle, measured in degrees.
        Attribute: Parameter pitch The pitch angle, measured in degrees.
        Attribute: Parameter roll The roll angle, measured in degrees.
    */
    action SetRotation(number yaw, number pitch, number roll)
        me:yaw = yaw
        me:pitch = pitch
        me:roll = roll
        UpdateCameraRotation()
    end


    /*
        LookBy turns the camera from where it stands: left and right (yaw)
        and up and down (pitch), staying level. The mouse's right drag, the
        look keys and the Scenes menu use it.

        Attribute: Parameter yawChange How far to turn left or right, in radians
        Attribute: Parameter pitchChange How far to turn up or down, in radians
    */
    action LookBy(number yawChange, number pitchChange)
        Math math
        Vector3 look = GetDirection():Copy()
        number turnYaw = math:InverseTangent2(look:GetX(), look:GetZ()) + yawChange
        number turnPitch = math:InverseSine(ClampUnit(look:GetY())) + pitchChange
        turnPitch = ClampPitch(turnPitch)
        look:SetX(math:Cosine(turnPitch) * math:Sine(turnYaw))
        look:SetY(math:Sine(turnPitch))
        look:SetZ(math:Cosine(turnPitch) * math:Cosine(turnYaw))
        LookAlong(look)
        MatchView()
    end

    /*
        SlideBy moves the camera across its view without turning it: right
        and left, and up and down as the view sees them.

        Attribute: Parameter rightAmount How far to move right, in world units; negative is left
        Attribute: Parameter upAmount How far to move up, in world units; negative is down
    */
    action SlideBy(number rightAmount, number upAmount)
        Vector3 look = GetDirection():Copy()
        Vector3 worldUp
        worldUp:Set(0, 1, 0)
        Vector3 right = look:Copy():CrossProduct(worldUp)
        if right:Length() < 0.0001
            return now
        end
        right:Normalize()
        Vector3 viewUp = right:Copy():CrossProduct(look)
        viewUp:Normalize()
        Vector3 moved = GetPosition():Copy()
        moved:SetX(moved:GetX() + right:GetX() * rightAmount + viewUp:GetX() * upAmount)
        moved:SetY(moved:GetY() + right:GetY() * rightAmount + viewUp:GetY() * upAmount)
        moved:SetZ(moved:GetZ() + right:GetZ() * rightAmount + viewUp:GetZ() * upAmount)
        SetPosition(moved)
        MatchView()
    end

    /*
        StartOrbit picks the point an orbit circles: straight ahead, as far
        as the camera is from what it looks at (GetViewDistance).
    */
    action StartOrbit
        Math math
        Vector3 position = GetPosition()
        Vector3 look = GetDirection()
        orbitDistance = GetViewDistance()
        orbitYaw = math:InverseTangent2(look:GetX(), look:GetZ()) + math:pi
        orbitPitch = -math:InverseSine(ClampUnit(look:GetY()))
        orbitPoint:SetX(position:GetX() + look:GetX() * orbitDistance)
        orbitPoint:SetY(position:GetY() + look:GetY() * orbitDistance)
        orbitPoint:SetZ(position:GetZ() + look:GetZ() * orbitDistance)
        orbitStarted = true
    end

    /*
        OrbitBy circles the camera around the point StartOrbit picked, still
        looking at it, and level. Without StartOrbit first, it starts one.

        Attribute: Parameter yawChange How far around, left or right, in radians
        Attribute: Parameter pitchChange How far over, up or down, in radians
    */
    action OrbitBy(number yawChange, number pitchChange)
        Math math
        if not orbitStarted
            StartOrbit()
        end
        orbitYaw = orbitYaw + yawChange
        orbitPitch = ClampPitch(orbitPitch + pitchChange)
        Vector3 moved
        moved:SetX(orbitPoint:GetX() + (orbitDistance * math:Cosine(orbitPitch) * math:Sine(orbitYaw)))
        moved:SetY(orbitPoint:GetY() + (orbitDistance * math:Sine(orbitPitch)))
        moved:SetZ(orbitPoint:GetZ() + (orbitDistance * math:Cosine(orbitPitch) * math:Cosine(orbitYaw)))
        SetPosition(moved)
        Vector3 toPoint
        toPoint:Set(orbitPoint:GetX() - moved:GetX(), orbitPoint:GetY() - moved:GetY(), orbitPoint:GetZ() - moved:GetZ())
        LookAlong(toPoint)
        MatchView()
    end

    /*
        EndOrbit forgets the orbit's point, so the next orbit picks a new
        one.
    */
    action EndOrbit
        orbitStarted = false
    end

    /*
        ZoomBy moves the camera toward what it looks at, or away: each step
        moves 12% of GetViewDistance, at least half a unit, and never closer
        than half a unit to the camera's target. The mouse wheel, the zoom
        keys and the Scenes menu use it.

        Attribute: Parameter steps How many steps in; negative steps zoom out
    */
    action ZoomBy(number steps)
        Math math
        if steps = 0
            return now
        end
        number reference = GetViewDistance()
        number size = math:AbsoluteValue(steps)
        number moveAmount = reference * ZOOM_SHARE * size
        // The floor scales with the steps, so held keys, which zoom a part
        // of a step each frame, move as smoothly as the wheel.
        if moveAmount < SMALLEST_ZOOM_STEP * size
            moveAmount = SMALLEST_ZOOM_STEP * size
        end
        if steps < 0
            moveAmount = -moveAmount
        end
        if target not= undefined and moveAmount > reference - CLOSEST_ZOOM
            moveAmount = reference - CLOSEST_ZOOM
        end
        Vector3 look = GetDirection()
        Vector3 moved = GetPosition():Copy()
        moved:SetX(moved:GetX() + look:GetX() * moveAmount)
        moved:SetY(moved:GetY() + look:GetY() * moveAmount)
        moved:SetZ(moved:GetZ() + look:GetZ() * moveAmount)
        SetPosition(moved)
        MatchView()
    end

    /*
        This action keeps a sine between -1 and 1.
    */
    private action ClampUnit(number value) returns number
        if value > 1
            return 1
        elseif value < -1
            return -1
        end
        return value
    end

    /*
        This action keeps a pitch just short of straight up or down, where
        the camera's level would be lost.
    */
    private action ClampPitch(number value) returns number
        Math math
        if value > math:piOver2 - PITCH_OFFSET
            return math:piOver2 - PITCH_OFFSET
        elseif value < -math:piOver2 + PITCH_OFFSET
            return -math:piOver2 + PITCH_OFFSET
        end
        return value
    end

end