package Libraries.Interface.Controls.Charts.ColorPalettes
use Libraries.Interface.Controls.Charts.ColorPalettes.ColorPalette
use Libraries.Game.Graphics.Color

class HuesAndContrastPalette is ColorPalette
    
    action BuildPalette()
        Color color
        //Dark Slate Blue
color:SetColor(59.0/255, 62.0/255, 172.0/255, 1)
        AddColor(color:Copy())
        
//Light Sea Green
color:SetColor(33.0/255, 166.0/255, 149.0/255, 1)
        AddColor(color:Copy())
        
        //Fire Brick Red
color:SetColor(184.0/255, 46.0/255, 46.0/255, 1)
        AddColor(color:Copy())
        
        //Dark GoldenRod
color:SetColor(214.0/255, 128.0/255, 0.0/255, 1)
        AddColor(color:Copy())
        
//Dark Magenta
color:SetColor(153.0/255, 0.0/255, 153.0/255, 1)
        AddColor(color:Copy())
        
//light sea green
color:SetColor(0.0/255, 153.0/255, 198.0/255, 1)
        AddColor(color:Copy())
        
//Red Brown
color:SetColor(221.0/255, 68.0/255, 119.0/255, 1)
        AddColor(color:Copy())
        
//Forest Green
color:SetColor(16.0/255, 150.0/255, 24.0/255, 1)
        AddColor(color:Copy())
        
//Slate Blue
color:SetColor(102.0/255, 51.0/255, 204.0/255, 1)
AddColor(color:Copy())
    end
end