package Libraries.Interface.Controls.Charts.Graphics

class PlotItem is ChartDrawable
private number plotValue = 0.0
    
    action SetPlotValue(number plotValue)
        me:plotValue = plotValue
    end

    action GetPlotValue returns number
        return plotValue
    end
    
    action BeginMouseOver
        GetContainer():RemoveSelectionVisual()
        GetContainer():ApplySelectionBoxAroundItem(me,5)
GetContainer():ShowSelectionAnnotation(me," " + GetPlotValue()+" ",GetWidth() + 2, GetHeight()/2-20)
    end
    
    action EndMouseOver
        //GetContainer():RemoveSelectionVisual()
    end

end
