package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Interface.Item2D
use Libraries.Interface.Controls.Control
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Views.View2D
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.TabBarFlowLayout
use Libraries.Interface.Layouts.HorizontalTabBarFlowLayout
use Libraries.Interface.Events.TabChangeEvent
use Libraries.Interface.Events.TabChangeListener
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Events.MouseWheelListener
use Libraries.Interface.Selections.TabPaneSelection
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Font
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Layouts.VerticalTabBarFlowLayout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LargeTabLayout
use Libraries.Interface.Layouts.AlignedTabFlowLayout

/*
The TabBar class is the row of Tabs at the top of a TabPane, or the column of
Tabs on its left side. Each TabPane makes its own TabBar, which can be
reached with the TabPane's GetTabBar action. The TabBar places the Tabs,
keeps track of them, and tells listeners when Tabs are added or removed.
When a horizontal TabBar has more Tabs than fit, it shows arrows at its ends
and can be scrolled with them or with the mouse wheel.

Attribute: Author William Allee

Attribute: Example
use Libraries.Game.Game
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.TabBar
use Libraries.Interface.Controls.Tab

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        TabPane pane
        Add(pane)

        Tab homeTab
        homeTab:SetName("Home")
        pane:Add(homeTab)

        Tab notesTab
        notesTab:SetName("Notes")
        pane:Add(notesTab)

        TabBar bar = pane:GetTabBar()
        bar:SetTabSpacing(8)
        output "The bar has " + bar:GetSize() + " tabs."
    end
end
*/
class TabBar is Control, MouseWheelListener
    
    Array<Tab> tabs
    TabBarFlowLayout layout = undefined
    TabPane pane = undefined
    boolean useLargeTabs = false

    Array<TabChangeListener> listeners
    
    // How much extra space should be added between tabs, in non-scaled pixels.
    // Only used if Tabs don't have their own margin values during layout.
    number tabSpacing = 0

    // The two arrows at the ends of a horizontal bar, shown when the tabs
    // don't all fit. They are the bar's last two children while horizontal.
    TabBarScrollArrow startArrow
    TabBarScrollArrow endArrow
    boolean scrollArrowsAdded = false

    // A Tab to bring into view once the bar has a size (FitTab was called first).
    Tab pendingFitTab = undefined
    // How many Resize calls on this bar are running, so the pending fit waits for the outermost.
    integer resizeDepth = 0

    // How far one notch of the mouse wheel scrolls the tabs, in points before the interface scale.
    constant number WHEEL_SCROLL_DISTANCE = 40
    // The most notches one wheel event counts, so a fast flick doesn't skip far past tabs.
    constant number MAXIMUM_WHEEL_NOTCHES = 3

    on create
        startArrow:Setup(me, false)
        endArrow:Setup(me, true)

        SetToHorizontal()

        SetClipping(true)
        SetName("Tab Bar")
        SetInterfaceOptionsKey("TabBar")
    end
    
    /*
    This action makes the TabBar a horizontal row of Tabs across the full
    width of its parent. A horizontal bar can be scrolled with the mouse
    wheel and with arrows at its ends when its Tabs don't all fit. This is
    the default. Most users should call TopAlignTabBar on the TabPane
    instead, which also sets up the view area.

    Attribute: Example
    use Libraries.Interface.Controls.TabPane
    use Libraries.Interface.Controls.TabBar
    TabPane pane
    TabBar bar = pane:GetTabBar()
    bar:SetToHorizontal()
    */
    action SetToHorizontal
HorizontalTabBarFlowLayout horizontalLayout
        layout = horizontalLayout
        
        LayoutProperties layoutProperties = GetDefaultLayoutProperties()
        layoutProperties:SetHorizontalLayoutMode(layoutProperties:STANDARD)
        layoutProperties:SetVerticalLayoutMode(layoutProperties:FIT_CONTENTS)
        layoutProperties:SetPercentageWidth(1.0)

        SetLayout(layout)

        // Horizontal bars scroll with the mouse wheel and the arrows.
        AddScrollArrows()
        RemoveMouseWheelListener(me)
        AddMouseWheelListener(me)
    end
    
    /*
    This action makes the TabBar a vertical column of Tabs, a fifth of its
    parent's width and its full height. A vertical bar has no scroll arrows
    and does not scroll with the mouse wheel. Most users should call
    LeftAlignTabBar on the TabPane instead, which also sets up the view
    area.

    Attribute: Example
    use Libraries.Interface.Controls.TabPane
    use Libraries.Interface.Controls.TabBar
    TabPane pane
    TabBar bar = pane:GetTabBar()
    bar:SetToVertical()
    */
    action SetToVertical
VerticalTabBarFlowLayout verticalLayout
        layout = verticalLayout
        
        LayoutProperties layoutProperties = GetDefaultLayoutProperties()
        layoutProperties:SetHorizontalLayoutMode(layoutProperties:FIT_CONTENTS)
        layoutProperties:SetVerticalLayoutMode(layoutProperties:STANDARD)
        layoutProperties:SetPercentageWidth(0.2)
        layoutProperties:SetPercentageHeight(1.0)

        SetLayout(layout)

        // Vertical bars keep their own scrolling (FitTab), with no arrows or wheel.
        RemoveScrollArrows()
        RemoveMouseWheelListener(me)
        pendingFitTab = undefined
    end

    /*
    This action adds the two scroll arrows to the bar as its last two
    children, if they aren't there already.
    */
    private action AddScrollArrows
        if scrollArrowsAdded
            return now
        end

        scrollArrowsAdded = true
        parent:Item2D:Add(startArrow)
        parent:Item2D:Add(endArrow)
    end

    /*
    This action hides the two scroll arrows and takes them out of the bar,
    if they are there.
    */
    private action RemoveScrollArrows
        if scrollArrowsAdded = false
            return now
        end

        scrollArrowsAdded = false
        startArrow:Hide()
        endArrow:Hide()
        parent:Item2D:Remove(startArrow)
        parent:Item2D:Remove(endArrow)
    end
    
    /*
    This action returns true if the TabBar is a horizontal row of Tabs.

    Attribute: Returns True if the bar is horizontal.

    Attribute: Example
    use Libraries.Interface.Controls.TabPane
    use Libraries.Interface.Controls.TabBar
    TabPane pane
    TabBar bar = pane:GetTabBar()
    boolean horizontal = bar:IsHorizontal()
    */
    action IsHorizontal returns boolean
        return GetLayout() is HorizontalTabBarFlowLayout
    end
    
    /*
    This action returns true if the TabBar is a vertical column of Tabs.

    Attribute: Returns True if the bar is vertical.

    Attribute: Example
    use Libraries.Interface.Controls.TabPane
    use Libraries.Interface.Controls.TabBar
    TabPane pane
    pane:LeftAlignTabBar()
    TabBar bar = pane:GetTabBar()
    boolean vertical = bar:IsVertical()
    */
    action IsVertical returns boolean
        return GetLayout() is VerticalTabBarFlowLayout
    end

    /*
    This action adds every Tab in the given array to the end of the bar, in
    order. Most users should add Tabs with the TabPane's Add action instead,
    which also connects each Tab to the TabPane.

    Attribute: Parameter array The Tabs to add.
    */
    action Add(Array<Tab> array)
        integer counter = 0
        repeat while counter < array:GetSize()
            Add(array:Get(counter))
            counter = counter + 1
        end
    end

    /*
    This action adds a Tab to the end of the bar. It links the Tab into the
    bar's focus order, so the keyboard can move from the last Tab back to the
    first, sets up the Tab's layout and font size to match the bar, lays the
    bar out again, and tells the tab change listeners that a Tab was opened.
    Most users should add Tabs with the TabPane's Add action instead, which
    also connects the Tab to the TabPane.

    Attribute: Parameter tab The Tab to add.

    Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                TabBar bar = pane:GetTabBar()
                Tab tab
                tab:SetName("Home")
                tab:SetTabPane(pane)
                bar:Add(tab)
            end
        end
    */
    action Add(Tab tab)
        if tabs:IsEmpty() = false
Tab firstTab = tabs:GetFromFront()
        Tab lastTab = tabs:GetFromEnd()
            
            firstTab:SetPreviousFocus(tab)
            lastTab:SetNextFocus(tab)
            tab:SetPreviousFocus(lastTab)
            tab:SetNextFocus(firstTab)
        end
        
        SetTabProperties(tab)
        
        tabs:Add(tab)
        if scrollArrowsAdded
            // The scroll arrows stay the last two children, so they draw over
            // the tabs and get the mouse first.
            parent:Item2D:Add(GetChildren():GetSize() - 2, tab)
        else
            parent:Item2D:Add(tab)
        end
        tab:SetTabBar(me)
        
        Resize()

        TabChangeEvent event
        event:Set(tab, pane, event:OPENED)
        NotifyTabChangeListeners(event)
    end
    
    /*
        This action gives every tab its layout and properties again. It is used
        when the tabs' size or the bar's orientation changes.
    */
    private action UpdateAllTabProperties
        integer i = 0
        repeat while i < tabs:GetSize()
            SetTabProperties(tabs:Get(i))
            i = i + 1
        end
    end
    
    /*
    This action sets up a Tab to match the bar: its font size, and a layout
    for large Tabs, for a vertical bar, or for a horizontal bar. In a
    vertical bar the Tab fills the bar's width, and in a horizontal bar it
    is as wide as its contents.

    Attribute: Parameter tab The Tab to set up.
    */
    private action SetTabProperties(Tab tab)
        tab:SetFontSize(GetFontSize())
        
        if IsUsingLargeTabs()
            LargeTabLayout largeLayout
            tab:SetLayout(largeLayout)
            tab:SetPercentageHeight(4.0)
        elseif IsVertical()
            AlignedTabFlowLayout alignedLayout
            tab:SetLayout(alignedLayout)
            tab:GetLabel():SetPositionOnBaseLine(false)
        else
FlowLayout flow
flow:SetIgnoreHidden(true)
        tab:SetLayout(flow)
        end
        
        if IsVertical()
tab:SetPercentageWidth(1.0)
        tab:SetHorizontalLayoutMode(tab:parent:Control:STANDARD)
            if tab:GetInterfaceOptionsKey() = "Tab"
tab:SetTopLeftRounding(0)
            tab:SetTopRightRounding(0)
            end
        else
tab:SetHorizontalLayoutMode(tab:parent:Control:FIT_CONTENTS)
        end
    end
    
    /* This action sets the TabBar to use large tabs if the given value is true, or to use
the default smaller tabs if the value is false. Default tabs place the icon, label, and
close button all together on a single horizontal line. Large tabs place the label at
the bottom of the tab, with a larger icon on top of it. */
    action SetLargeTabs(boolean enable)
        if enable = useLargeTabs
            return now
        end
        
        useLargeTabs = enable
        UpdateAllTabProperties()
    end
    
    /* This action returns whether or not the TabBar is using large tabs. By default,
this is false. */
    action IsUsingLargeTabs returns boolean
        return useLargeTabs
    end

    /*
    This action removes a Tab from the bar and disposes of it, so it can't be
    used again. The Tab's OnClose action is called first. If the removed Tab
    was selected, the Tab before it is selected instead; otherwise the
    selected Tab stays selected. The tab change listeners are told that a
    Tab was closed. The bar must belong to a TabPane. Nothing happens if the
    Tab is undefined.

    Attribute: Parameter tab The Tab to remove.

    Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        use Libraries.Interface.Controls.Tab

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                TabPane pane
                Add(pane)
                Tab tab
                tab:SetName("Home")
                pane:Add(tab)
                TabBar bar = pane:GetTabBar()
                bar:Remove(tab)
            end
        end
    */
    action Remove(Tab tab)
        if tab = undefined
            return now
        end

        tab:OnClose()

        TabPaneSelection selection = pane:GetSelection()
        boolean reselect = false

        
        integer index = selection:GetIndex()
        Tab currentTab = selection:GetTab()
        if currentTab = tab
            reselect = true
        end
        pane:Deselect()

        tabs:Remove(tab)
        parent:Item2D:Remove(tab)
        tab:SetTabBar(undefined)
        if pendingFitTab = tab
            pendingFitTab = undefined
        end

        // Lay out the remaining tabs before a Tab is selected again, so the
        // selected Tab is scrolled into view from where the tabs now are.
        Resize()

        if reselect
            if tabs:GetSize() > 0
                index = index - 1

                if index < 0
                    index = 0
                end
                pane:Select(index)
            else
                pane:UpdateSelection(undefined)
            end
        else
            pane:Select(currentTab)
        end

        tab:Dispose()

        TabChangeEvent event
        event:Set(tab, pane, event:CLOSED)
        NotifyTabChangeListeners(event)
    end

    /*
    This action returns the Tab at the given index. The first Tab is at
    index 0.

    Attribute: Parameter index The index of the Tab.

    Attribute: Returns The Tab at that index.
    */
    action Get(integer index) returns Tab
        return tabs:Get(index)
    end

    /*
    This action returns all of the Tabs in the bar, in order. The array is
    the bar's own, so add and remove Tabs with the TabPane's actions, not the
    array's.

    Attribute: Returns An array of the bar's Tabs.
    */
    action GetTabs returns Array<Tab>
        return tabs
    end

    /*
    This action sets the TabPane this bar belongs to, and takes on the font
    and font size from the bar's layout properties. The TabPane calls it
    when it is made, so most users won't need it.

    Attribute: Parameter tabPane The TabPane the bar belongs to.
    */
    action SetTabPane(TabPane tabPane)
        pane = tabPane
        LayoutProperties paneProperties = GetDefaultLayoutProperties()
        SetFont(paneProperties:GetFont())
        SetFontSize(paneProperties:GetFontSize())
    end

    /*
    This action returns the TabPane this bar belongs to.

    Attribute: Returns The TabPane, or undefined if the bar has none.
    */
    action GetTabPane returns TabPane
        return pane
    end

    /*
    This action scrolls the TabBar, if needed, so the given Tab is in full
    view. A Tab calls it when it is selected. In a horizontal bar, the Tab is
    brought just inside the edge it was past, and a Tab wider than the
    visible area shows its start. If the horizontal bar has no size yet, the
    Tab is brought into view after the next layout. A vertical bar scrolls as
    it always has.

    Attribute: Parameter tab The Tab to bring into view.

    Attribute: Example

        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        use Libraries.Interface.Controls.Tab
        TabPane pane
        Tab tab
        pane:Add(tab)
        TabBar bar = pane:GetTabBar()
        bar:FitTab(tab)
    */
    action FitTab(Tab tab)
        integer index = tabs:GetFirstLocation(tab)
        if tab = undefined or index = -1
            return now
        end

        if GetWidth() <= 0 or GetHeight() <= 0
            // Not laid out yet. Resize brings it into view once the bar has a size.
            if IsHorizontal()
                pendingFitTab = tab
            end
            return now
        end

        if IsHorizontal()
            pendingFitTab = undefined
            if layout:IsOverflowing()
                number distance = GetDistanceToShow(tab)
                if distance > 0.01 or distance < -0.01
                    ScrollTabs(distance)
                end
            end
        else
            if tab:GetY() <= 0
                BottomFitTab(index + 1.15)
            elseif tab:GetY() + tab:GetHeight() >= GetHeight()
                TopFitTab(index - 1.15)
            end
        end
    end

    /*
    This action scrolls a horizontal TabBar to show the given Tab, but only if
    the Tab is entirely out of view. A Tab calls it when it gains the focus.
    A Tab that is partly in view is left where it is, so a mouse press never
    moves a Tab out from under the pointer; the Tab then comes fully into view
    when it is selected. A vertical bar is not changed.

    Attribute: Parameter tab The Tab to show.

    Attribute: Example

        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        use Libraries.Interface.Controls.Tab
        TabPane pane
        Tab tab
        pane:Add(tab)
        TabBar bar = pane:GetTabBar()
        bar:FitHiddenTab(tab)
    */
    action FitHiddenTab(Tab tab)
        if tab = undefined or tabs:Has(tab) = false or IsHorizontal() = false
            return now
        end

        if GetWidth() <= 0 or GetHeight() <= 0
            pendingFitTab = tab
            return now
        end

        if layout:IsOverflowing() = false
            return now
        end

        if tab:GetX() + tab:GetWidth() <= layout:GetVisibleStart() or tab:GetX() >= layout:GetVisibleEnd()
            FitTab(tab)
        end
    end

    /*
    This action scrolls the tabs of a horizontal TabBar by the given distance.
    A positive distance shows tabs further toward the end of the bar, and a
    negative distance shows tabs toward the start. The scrolling stops at
    either end. It does nothing if all of the tabs fit, or if the bar is
    vertical.

    Attribute: Parameter distance How far to scroll, in pixels.

    Attribute: Example

        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        TabPane pane
        TabBar bar = pane:GetTabBar()
        bar:ScrollTabs(100)
    */
    action ScrollTabs(number distance)
        if IsHorizontal() = false or layout:IsOverflowing() = false
            return now
        end

        // The layout keeps the offset between 0 and its largest useful value.
        layout:SetOffset(layout:GetOffset() + distance)
        Resize()
    end

    /*
    This action scrolls a horizontal TabBar toward its end, far enough to show
    the next Tab that is hidden or cut off at the end. The arrow at the end of
    the bar calls it. It does nothing if all of the tabs fit.

    Attribute: Example

        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        TabPane pane
        TabBar bar = pane:GetTabBar()
        bar:ScrollTabsTowardEnd()
    */
    action ScrollTabsTowardEnd
        if IsHorizontal() = false or layout:IsOverflowing() = false
            return now
        end

        number visibleFinish = layout:GetVisibleEnd()
        integer counter = 0
        repeat while counter < tabs:GetSize()
            Tab tab = tabs:Get(counter)
            if tab:GetX() + tab:GetWidth() > visibleFinish + 0.5
                number distance = GetDistanceToShow(tab)
                if distance < 0.5
                    // A Tab wider than the visible area: move half a view instead.
                    distance = (visibleFinish - layout:GetVisibleStart()) / 2
                end
                ScrollTabs(distance)
                return now
            end
            counter = counter + 1
        end
    end

    /*
    This action scrolls a horizontal TabBar toward its start, far enough to
    show the previous Tab that is hidden or cut off at the start. The arrow at
    the start of the bar calls it. It does nothing if all of the tabs fit.

    Attribute: Example

        use Libraries.Interface.Controls.TabPane
        use Libraries.Interface.Controls.TabBar
        TabPane pane
        TabBar bar = pane:GetTabBar()
        bar:ScrollTabsTowardStart()
    */
    action ScrollTabsTowardStart
        if IsHorizontal() = false or layout:IsOverflowing() = false
            return now
        end

        number visibleStart = layout:GetVisibleStart()
        integer counter = tabs:GetSize() - 1
        repeat while counter >= 0
            Tab tab = tabs:Get(counter)
            if tab:GetX() < visibleStart - 0.5
                number distance = GetDistanceToShow(tab)
                if distance > -0.5
                    // A Tab wider than the visible area: move half a view instead.
                    distance = (visibleStart - layout:GetVisibleEnd()) / 2
                end
                ScrollTabs(distance)
                return now
            end
            counter = counter - 1
        end
    end

    /*
    Returns how far a horizontal bar must scroll to show the Tab in full,
    from the Tab's real position after the last layout (so the gaps and
    margins between tabs count). Positive scrolls toward the end. A Tab wider
    than the visible area is lined up with the start of the area.
    */
    private action GetDistanceToShow(Tab tab) returns number
        number visibleStart = layout:GetVisibleStart()
        number visibleFinish = layout:GetVisibleEnd()
        number left = tab:GetX()
        number right = left + tab:GetWidth()

        number distance = 0
        if right > visibleFinish
            distance = right - visibleFinish
        end
        if left - distance < visibleStart
            distance = left - visibleStart
        end
        return distance
    end

    /*
    This action scrolls a horizontal TabBar when the mouse wheel turns over it,
    if the tabs don't all fit. Turning the wheel up shows tabs toward the
    start, and turning it down shows tabs toward the end. Otherwise, the event
    goes on to the bar's parent, as it would without this listener.

    Attribute: Parameter event The MouseEvent describing the wheel movement.
    */
    action ScrolledMouse(MouseEvent event)
        if IsHorizontal() and layout:IsOverflowing()
            number notches = event:scrollAmount
            if notches > MAXIMUM_WHEEL_NOTCHES
                notches = MAXIMUM_WHEEL_NOTCHES
            elseif notches < MAXIMUM_WHEEL_NOTCHES * -1
                notches = MAXIMUM_WHEEL_NOTCHES * -1
            end
            ScrollTabs(notches * -1 * WHEEL_SCROLL_DISTANCE * GetInterfaceScale())
        else
            Item2D holder = GetParent()
            if holder not= undefined
                holder:ProcessMouseEvent(event)
            end
        end
    end

    /*
    The Resize action lays out the tabs again. After the outermost Resize, a
    Tab that asked to be brought into view before the bar had a size is
    brought into view.
    */
    action Resize
        resizeDepth = resizeDepth + 1
        parent:Control:Resize()
        resizeDepth = resizeDepth - 1

        if resizeDepth = 0 and pendingFitTab not= undefined and GetWidth() > 0 and GetHeight() > 0
            Tab target = pendingFitTab
            pendingFitTab = undefined
            FitTab(target)
        end
    end

    /*
    This action sets the key used to find this TabBar's colors and other
    properties in the InterfaceOptions. The scroll arrows use the same key,
    so they match the bar.

    Attribute: Parameter key The interface options key.
    */
    action SetInterfaceOptionsKey(text key)
        parent:Control:SetInterfaceOptionsKey(key)
        startArrow:SetInterfaceOptionsKey(key)
        endArrow:SetInterfaceOptionsKey(key)
    end

    /*
    This action scrolls the bar so the Tab at the given index starts at the
    bar's left edge. The index can have a fraction: 2.5 lines up the middle
    of the Tab at index 2 with the left edge. Indexes outside the Tabs are
    moved to the first or last Tab.

    Attribute: Parameter index The index of the Tab to line up, which can have a fraction.
    */
    action LeftFitTab(number index)
        Array<Tab> children = tabs
        if index < 0
            index = 0
        elseif index >= children:GetSize()
            index = children:GetSize() - 1
        end

        integer counter = 0
        number offset = 0
        integer intIndex = cast(integer, index)
        repeat while counter < intIndex
            Item2D item = children:Get(counter)
            offset = offset + item:GetWidth()
            counter = counter + 1
        end

        // Include a percentage of the width of the next item, if we have any remainder.
        if counter < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter):GetWidth()
        // If there's no next item, offset it by the last item, if there is one.
        elseif counter - 1 < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter - 1):GetWidth()
        end

        layout:SetOffset(offset)
        Resize()
    end

    /*
    This action scrolls the bar so the Tab at the given index ends at the
    bar's right edge. The index can have a fraction, which adds that part of
    the next Tab's width. Indexes outside the Tabs are moved to the first or
    last Tab.

    Attribute: Parameter index The index of the Tab to line up, which can have a fraction.
    */
    action RightFitTab(number index)
        Array<Tab> children = tabs
        if index < 0
            index = 0
        elseif index >= children:GetSize()
            index = children:GetSize() - 1
        end

        integer counter = 0
        number offset = 0
        integer intIndex = cast(integer, index)
        repeat while counter <= intIndex
            Item2D item = children:Get(counter)
            offset = offset + item:GetWidth()
            counter = counter + 1
        end

        // Include a percentage of the width of the next item, if we have any remainder.
        if counter < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter):GetWidth()
        // If there's no next item, offset it by the last item, if there is one.
        elseif counter - 1 < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter - 1):GetWidth()
        end

        layout:SetOffset(offset - GetWidth())
        Resize()
    end
    
/*
    This action scrolls a vertical bar so the Tab at the given index starts
    at the bar's top edge. The index can have a fraction: 2.5 lines up the
    middle of the Tab at index 2 with the top edge. Indexes outside the Tabs
    are moved to the first or last Tab.

    Attribute: Parameter index The index of the Tab to line up, which can have a fraction.
*/
action TopFitTab(number index)
        Array<Tab> children = tabs
        if index < 0
            index = 0
        elseif index >= children:GetSize()
            index = children:GetSize() - 1
        end

        integer counter = 0
        number offset = 0
        integer intIndex = cast(integer, index)
        repeat while counter < intIndex
            Item2D item = children:Get(counter)
            offset = offset + item:GetHeight()
            counter = counter + 1
        end

        // Include a percentage of the height of the next item, if we have any remainder.
        if counter < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter):GetHeight()
        // If there's no next item, offset it by the last item, if there is one.
        elseif counter - 1 < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter - 1):GetHeight()
        end

        layout:SetOffset(offset)
        Resize()
    end

    /*
    This action scrolls a vertical bar so the Tab at the given index ends at
    the bar's bottom edge. The index can have a fraction, which adds that
    part of the next Tab's height. Indexes outside the Tabs are moved to the
    first or last Tab. FitTab uses it to bring a Tab below the visible area
    into view.

    Attribute: Parameter index The index of the Tab to line up, which can have a fraction.
    */
    action BottomFitTab(number index)
        Array<Tab> children = tabs
        if index < 0
            index = 0
        elseif index >= children:GetSize()
            index = children:GetSize() - 1
        end

        integer counter = 0
        number offset = 0
        integer intIndex = cast(integer, index)
        repeat while counter <= intIndex
            Item2D item = children:Get(counter)
            offset = offset + item:GetHeight()
            counter = counter + 1
        end

        // Include a percentage of the height of the next item, if we have any remainder.
        if counter < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter):GetHeight()
        // If there's no next item, offset it by the last item, if there is one.
        elseif counter - 1 < children:GetSize()
            offset = offset + (index - intIndex) * children:Get(counter - 1):GetHeight()
        end

        layout:SetOffset(offset - GetHeight())
        Resize()
    end

    /*
    This action returns how many Tabs are in the bar.

    Attribute: Returns The number of Tabs.
    */
    action GetSize returns integer
        return tabs:GetSize()
    end

    /*
    This action returns true if the bar has no Tabs.

    Attribute: Returns True if there are no Tabs.
    */
    action IsEmpty returns boolean
        return tabs:IsEmpty()
    end

    /*
    This action adds a listener that is told whenever a Tab is added to or
    removed from this bar. The TabPane's AddTabChangeListener calls it.

    Attribute: Parameter listener The TabChangeListener to add.
    */
    action AddTabChangeListener(TabChangeListener listener)
        listeners:Add(listener)
    end

    /*
    This action removes a listener added with AddTabChangeListener.

    Attribute: Parameter listener The TabChangeListener to remove.
    */
    action RemoveTabChangeListener(TabChangeListener listener)
        listeners:Remove(listener)
    end

    /*
    This action tells the game's input and every listener added to this bar
    that a Tab was opened or closed, calling OpenedTab or ClosedTab to match
    the event's type.

    Attribute: Parameter event The event describing the Tab that was opened or closed.
    */
    private action NotifyTabChangeListeners(TabChangeEvent event)
        GameStateManager manager
        manager:GetInput():NotifyTabChangeListeners(event)

        integer counter = 0
        if event:GetEventType() = event:OPENED
            repeat while counter < listeners:GetSize()
                listeners:Get(counter):OpenedTab(event)
                counter = counter + 1
            end
        elseif event:GetEventType() = event:CLOSED
            repeat while counter < listeners:GetSize()
                listeners:Get(counter):ClosedTab(event)
                counter = counter + 1
            end
        end
    end

    /*
    This action is used to load the graphical components of the Control. This is
    handled automatically by the Game engine as needed, and most users shouldn't
    need to use this action directly.
    */
    action LoadGraphics(LayoutProperties properties)
        if properties = undefined
            return now
        end

        View2D view = properties:GetView2D()
        if view = undefined
            if GetView2D() = undefined
                ControlShaderView content
                content:SetName("TabBar View")
                content:Initialize()
                view = content
            end
        end

        if view not= undefined
            SetView2D(view)
        end

        parent:Control:LoadGraphics(properties)
    end

    /*
    This action sets the Font to be used by this Control. How this Font is used
    varies between Controls, and in some cases the Control will ignore it 
    entirely (for example, ScrollPanes), but typically this sets the font that's
    used for the default label on many Controls, such as Buttons. If the Font
    is undefined, many Controls will omit their default label.

    Attribute: Parameter font The Font to use for this Control.
    */
    action SetFont(Font font)
        parent:Control:SetFont(font)
        integer counter = 0
        repeat while counter < tabs:GetSize()
            tabs:Get(counter):SetFont(font)
            counter = counter + 1
        end
    end

    /*
    This action sets the base Font size to be used by this Control, if the
    Control uses a Font.
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        integer counter = 0
        repeat while counter < tabs:GetSize()
            tabs:Get(counter):SetFontSize(size)
            counter = counter + 1
        end
    end

    /*
    This action deselects every Tab in the bar. A Tab calls it just before
    it is selected, so only one Tab is selected at a time.

    Attribute: Example
    use Libraries.Interface.Controls.TabPane
    use Libraries.Interface.Controls.TabBar
    TabPane pane
    TabBar bar = pane:GetTabBar()
    bar:DeselectAll()
    */
    action DeselectAll
        integer i = 0
        repeat while i < tabs:GetSize()
            tabs:Get(i):SetToggleState(false)
            i = i + 1
        end
    end
    
    /*This action returns the amount of spacing, in non-scaled pixels, that will be placed
between each Tab in the TabBar. If a Tab has its own margin values set, then this
will be ignored for that Tab.

Attribute: Returns The default amount of pixels between each Tab.*/
    action GetTabSpacing returns number
        return tabSpacing
    end

/*This action sets the amount of spacing, in non-scaled pixels, that will be placed
between each Tab in the TabBar. If a Tab has its own margin values set, then this
will be ignored for that Tab.

Attribute: Parameter tabSpacing The default amount of pixels between each Tab.*/
    action SetTabSpacing(number tabSpacing)
        me:tabSpacing = tabSpacing
    end

end