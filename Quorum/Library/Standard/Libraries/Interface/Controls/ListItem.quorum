package Libraries.Interface.Controls

use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Views.SelectionHighlightView
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.ControlActivationEvent
use Libraries.Interface.Views.ControlShaderView
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.ColorGroup

/*
The ListItem class is used internally to represent an entry in a list. Users
typically won't need to interact with this class unless they want to create a
unique way of representing an entry in the list. For simple use cases, use the
actions in List to add and remove entries.

Attribute: Author William Allee

Attribute: Example
use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.List
use Libraries.Interface.Controls.ListItem

Form form
Page page = form:GetMainPage()

List fruits = page:AddList("Fruits")
fruits:Add("Apples")
fruits:Add("Bananas")

ListItem item = fruits:GetListItem(1)
item:Select()

form:Display()
*/
class ListItem is Control

    Label label
    // The label's color before the selection changed it.
    ColorGroup restingColor = undefined
    boolean restingColorSaved = false
    Icon icon

    // The Behavior to use when the item is activated (e.g. by double click).
    // If this is undefined, the item will attempt to use a Behavior defined by
    // the List instead.
    Behavior activationBehavior = undefined

    on create
label:SetAccessibilityCode(label:parent:Item:NOT_ACCESSIBLE)
        
        FlowLayout layout
        layout:SetIgnoreHidden(true)
        layout:SetSingleLine(true)
        SetLayout(layout)

        LayoutProperties properties = GetDefaultLayoutProperties()
        properties:SetHorizontalLayoutMode(properties:STANDARD)
        properties:SetPercentageWidth(1.0)
        properties:SetVerticalLayoutMode(properties:FIT_FONT)

        Font font = GetDefaultFont()
        if font not= undefined
            integer defaultFontSize = GetDefaultFontSize()
            properties:SetFont(font)
            properties:SetFontSize(defaultFontSize)
        end

        Add(icon)
        Add(label)

        label:SetPositionOnBaseLine(false)
        label:SetLeftMargin(4)
        icon:SetLeftMargin(4)
        icon:SetHorizontalLayoutMode(icon:parent:Control:MAINTAIN_ASPECT_RATIO)
        icon:SetVerticalLayoutMode(icon:parent:Control:STANDARD)
        icon:SetPercentageWidth(1.0)
        icon:SetPercentageHeight(1.0)

        SetInputGroup("ListItem")
        SetName("List Item")
        SetInterfaceOptionsKey("ListItem")
        SetAccessibilityCode(parent:Item:LIST_ITEM)
    end

    /*
    This action sets the text shown by this entry.

    Attribute: Parameter value The new text of the entry.

    Attribute: Example
    use Libraries.Interface.Controls.ListItem
    ListItem item
    item:SetText("Apples")
    */
    action SetText(text value)
        label:SetText(value)
    end

    /*
    This action returns the text shown by this entry.

    Attribute: Returns The entry's text.

    Attribute: Example
    use Libraries.Interface.Controls.ListItem
    ListItem item
    item:SetText("Apples")
    text value = item:GetText()
    */
    action GetText returns text
        return label:GetText()
    end

    /*
    This action is called when the user clicks the entry. It does what any
    control does on a click and then selects the entry in its List.
    */
    action ClickedMouse
        parent:Control:ClickedMouse()
        Select()
    end

    /*
    This action selects this entry. It asks the List the entry is in to
    select it, so the List can deselect the old entry and scroll this one
    into view. If the entry is not in a List, nothing happens.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    ListItem item
    item:SetText("Apples")
    fruits:Add(item)
    item:Select()
    */
    action Select
        // Don't actually select here! Go to the List and ask it to 
        // select us. We do this to allow the List to update the
        // selection and deselect the old selection.
        List list = GetList()
        if list not= undefined
            list:Select(me)
        end
    end

    /*
    This action clears the selection of the List the entry is in, so no entry
    is selected. If the entry is not in a List, nothing happens.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    ListItem item
    item:SetText("Apples")
    fruits:Add(item)
    item:Select()
    item:Deselect()
    */
    action Deselect
        // Don't actually select here! Go to the List and ask it to 
        // select us. We do this to allow the List to update the
        // selection and deselect the old selection.
        List list = GetList()
        if list not= undefined
            list:Deselect()
        end
    end

    /*
    This action is called when the entry becomes the List's selection. It
    marks the entry as selected and changes its text color to the selection
    color, which depends on whether the List has the focus.
    */
    action GainedSelection
        parent:Control:GainedSelection()
        RefreshSelectionText()
    end

    /*
        This action returns whether this item shows its selection with the focused
        look. A selected item uses the focused look while its List has the focus,
        and the unfocused look otherwise. It returns false when no game is running
        or the item is not in a List.

        Attribute: Returns True if the item shows the focused look, or false if it does not.
    */
    action IsRenderingFocus returns boolean
        GameStateManager focusState
        if focusState:GetGame() = undefined
            return false
        end
        List list = GetList()
        if list = undefined
            return false
        end
        return list:IsRenderingFocus()
    end

    /*
        This action sets the item's text color for its selection: the selection's
        text color while its List has the focus, and the unfocused selection's text
        color otherwise. The first time, it saves the label's own color, so that
        color can be put back when the item is no longer selected.
    */
    action RefreshSelectionText
        // The label's own color, so it comes back when the selection leaves.
        if not restingColorSaved
            restingColor = label:GetFontColor()
            restingColorSaved = true
        end
        if IsRenderingFocus()
            if GetSelectionFontColor() not= undefined
                label:SetColor(GetSelectionFontColor())
            end
        elseif GetUnfocusedSelectionFontColor() not= undefined
            label:SetColor(GetUnfocusedSelectionFontColor())
        end
    end

    /*
    This action is called when the entry stops being the List's selection.
    It puts the text back to the color it had before it was selected.
    */
    action LostSelection
        parent:Control:LostSelection()

        if restingColorSaved and restingColor not= undefined
            label:SetColor(restingColor)
        elseif GetFontColor() not= undefined
            label:SetColor(GetFontColor())
        end
        restingColorSaved = false
    end

    /*
    This action sets up the entry's graphics from the given layout
    properties. It loads the icon and its color, hides the icon if there is
    none, and sets the label's font and font size.

    Attribute: Parameter properties The layout properties to load the graphics from.
    */
    action LoadGraphics(LayoutProperties properties)
        parent:Control:LoadGraphics(properties)

        if GetView2D() = undefined
            ControlShaderView view
            view:Initialize()
            SetView2D(view)
        end

        if properties:GetIcon() not= undefined and icon:GetTexture() not= properties:GetIcon():GetTextureField()
            icon:Load(properties:GetIcon():GetTextureField())
        end

        if properties:GetIconColor() not= undefined
            icon:SetColor(properties:GetIconColor())
        end

        if icon:GetTexture() = undefined
            icon:Hide()
            if icon:GetHorizontalLayoutMode() = icon:parent:Control:MAINTAIN_ASPECT_RATIO
                icon:SetPercentageWidth(icon:GetRegionWidth() / cast(number, icon:GetRegionHeight()))
            end
        else
            icon:Show()
        end

        if properties:GetFont() not= label:GetFont()
            label:SetFont(properties:GetFont())
        end

        if label:GetFont() not= undefined
            if properties:GetFontSize() not= label:GetSize()
                label:SetSize(properties:GetFontSize())
            end
        end
    end

    /*
    This action sets the font size of the entry's text.

    Attribute: Parameter size The new font size.

    Attribute: Example
    use Libraries.Interface.Controls.ListItem
    ListItem item
    item:SetText("Apples")
    item:SetFontSize(20)
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        if label not= undefined
            label:SetFontSize(size)
        end
    end

    /*
    This action returns the List that this ListItem has been added to, if such a
    List is present. If this ListItem's parent isn't a List, or if it has no
    parent Item, this action returns undefined instead.

    Attribute: Returns The parent List containing this ListItem.
    */
    action GetList returns List
        Item2D candidate = GetParent()

        repeat until candidate is List or candidate = undefined
            candidate = candidate:GetParent()
        end

        return cast(List, candidate)
    end

    /*
    This action returns the behavior this entry runs when it is activated,
    such as by a double-click. If it is undefined, the List's item activation
    behavior is used instead.

    Attribute: Returns The entry's own activation behavior, or undefined.
    */
    action GetActivationBehavior returns Behavior
        return activationBehavior
    end

    /*
    This action returns how deep this row sits when a List is drawn as a
    tree: 0 for a top row, 1 for a row under it, and so on. Screen readers
    use it to give a row's place among the rows at its own depth ("1 of
    3") rather than in the whole list. Rows of an ordinary list are all
    0. Classes that draw rows as a tree override it.

    Attribute: Returns The row's depth, from 0.
    */
    action GetAccessibilityLevel returns integer
        return 0
    end

    /*
    This action returns true if the row opens and closes to show rows under
    it, in a List treated as a tree (List:SetTreeAccessibility). Screen
    readers then say "expanded" or "collapsed" (IsAccessibilityExpanded).
    It is false unless a class overrides it.

    Attribute: Returns True if the row opens and closes.
    */
    action IsAccessibilityExpandable returns boolean
        return false
    end

    /*
    This action returns true if the row is open, showing the rows under it
    (see IsAccessibilityExpandable). It is false unless a class overrides it.

    Attribute: Returns True if the row is open.
    */
    action IsAccessibilityExpanded returns boolean
        return false
    end

    /*
    This action sets the behavior this entry runs when it is activated, such
    as by a double-click. An entry with its own behavior does not use the
    List's item activation behavior.

    Attribute: Parameter behavior The behavior to run, or undefined to use the List's behavior.

    Attribute: Example
    use Libraries.Interface.Controls.ListItem
    use Libraries.Interface.Behaviors.Behavior
    ListItem item
    item:SetText("Apples")
    Behavior openItem
    item:SetActivationBehavior(openItem)
    */
    action SetActivationBehavior(Behavior behavior)
        activationBehavior = behavior
    end

    /*
    This action activates the entry, such as when it is double-clicked. If
    the entry has its own activation behavior, that behavior runs. Otherwise
    the List's item activation behavior runs with this entry as the event's
    item, and the control activation listeners are told. If neither has a
    behavior, nothing happens.

    Attribute: Parameter event The event that caused the activation.
    */
    action Activate(BehaviorEvent event)
        if GetActivationBehavior() not= undefined
            parent:Control:Activate(event)
        else
            List list = GetList()
            if list = undefined or list:GetItemActivationBehavior() = undefined
                return now
            end

            Behavior behavior = list:GetItemActivationBehavior()

            if not event:GetItem():Equals(me)
                event = event:Copy()
                event:SetItem(me)
            end
            behavior:Run(event)

            ControlActivationEvent controlEvent
            controlEvent:Set(me, event)
            NotifyControlActivationListeners(controlEvent)
        end
    end
end