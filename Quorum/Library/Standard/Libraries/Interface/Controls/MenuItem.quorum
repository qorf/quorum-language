package Libraries.Interface.Controls

use Libraries.Interface.Item2D
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Selections.Selection
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.MenuChangeEvent
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Layouts.VerticalMenuLayout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.MenuItemLayout
use Libraries.Interface.Views.ControlView
use Libraries.Interface.Views.View2D
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Views.MenuItemView
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Containers.Support.Pair
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Gradient
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Font
use Libraries.Game.InputSet
use Libraries.Game.GameStateManager
use Libraries.Game.InputTable
use Libraries.Interface.Behaviors.Controls.MenuItemShortcutBehavior
use Libraries.Game.Graphics.TextureRegion
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Views.ChevronTexture

/*
    The MenuItem class is one entry in a menu. A MenuItem can be a choice the user
    picks, such as Save or Copy, or it can be a menu itself: once other MenuItems
    are added to it, it opens a panel that lists them. MenuItems added to a
    MenuBar become the menu titles along the bar, and MenuItems added to a
    PopupMenu become its choices. The text shown is the item's name, set with
    SetName. Each item can also show a keyboard shortcut, set with SetShortcut, and
    can have a mnemonic letter, set with SetMnemonic, that chooses it when typed
    while the menu is in use. When the user chooses an item, the Behavior given to
    it with SetBehavior runs.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.InputSet
    use Libraries.Interface.Events.KeyboardEvent
    use Libraries.Interface.Controls.MenuBar
    use Libraries.Interface.Controls.MenuItem

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            MenuBar bar

            MenuItem file
            file:SetName("File")
            file:SetMnemonic("F")

            MenuItem save
            save:SetName("Save")
            KeyboardEvent keys
            InputSet saveKeys
            saveKeys:SetKeyboardInput(keys:S)
            saveKeys:AddModifier(saveKeys:CONTROL)
            save:SetShortcut(saveKeys)

            // A MenuItem with items of its own is a submenu.
            MenuItem recent
            recent:SetName("Open Recent")
            MenuItem first
            first:SetName("Notes.txt")
            recent:Add(first)

            file:Add(save)
            file:Add(recent)
            bar:Add(file)
            Add(bar)
        end
    end
*/
class MenuItem is Control
    
    /*
    A panel which contains all of the submenu options for this MenuItem, if this
    MenuItem is a menu. The anchor is used to position the panel depending on
    what direction the panel is expected to open in.
    */
    MenuPanelBlueprint panel = undefined
    Control panelAnchor
    Layout panelLayout = undefined
    LayoutProperties panelProperties = undefined

    /*
    An array containing all elements added to the panel. This is redundant to
    the children list of the panel, but keeping it in this form makes it easier
    to retrieve without constant casting.
    */
    Array<MenuItem> menuItems

    MenuItem parentMenu = undefined
    MenuRoot menuRoot = undefined

    public constant integer DEFAULT = 0
    public constant integer LEFT = 1
    public constant integer RIGHT = 2
    public constant integer DOWN = 3
    public constant integer UP = 4

    integer direction = DEFAULT

    // The default appearance of MenuItems which are elements of this menu.
    ControlView submenuView = undefined

    boolean open = false

    Behavior activationBehavior = undefined

    Icon icon
    MnemonicLabel label
    Label shortcutLabel
    Icon arrow

    /*
    Layouts for this MenuItem. Which one is used depends on if this MenuItem is
    a child of another MenuItem.
    */
    FlowLayout rootLayout
    MenuItemLayout menuItemLayout

    text mnemonic = undefined

    on create
        SetInputGroup("MenuItem")
        SetAccessibilityCode(parent:Item:MENU_ITEM)
        // Mnemonics show only on the item under the mouse or selected.
        label:HideUnderline()

        MenuPanel panel
        me:panel = panel

        LayoutProperties defaultProperties = GetDefaultLayoutProperties()
        defaultProperties:SetBackgroundColor(undefined)

        panelProperties = panel:GetDefaultLayoutProperties()
        panelAnchor:Add(panel)
        ManualLayout layout
        layout:ApplyToContainer(true)
        panelAnchor:SetLayout(layout)
        panelAnchor:SetName("Panel Anchor")

        LayoutProperties iconProperties = icon:GetDefaultLayoutProperties()
        LayoutProperties labelProperties = label:GetDefaultLayoutProperties()
        LayoutProperties shortcutProperties = shortcutLabel:GetDefaultLayoutProperties()
        LayoutProperties arrowProperties = arrow:GetDefaultLayoutProperties()
        LayoutProperties menuProperties = GetDefaultLayoutProperties()

        Font font = GetDefaultFont()
        if font not= undefined
            integer defaultFontSize = GetDefaultFontSize()
            menuProperties:SetFont(font)
            menuProperties:SetFontSize(defaultFontSize)
        end
        menuProperties:SetVerticalLayoutMode(menuProperties:FIT_FONT)

        menuProperties:SetBorderThickness(1)

        iconProperties:SetHorizontalLayoutMode(iconProperties:MAINTAIN_ASPECT_RATIO)
        iconProperties:SetVerticalLayoutMode(iconProperties:STANDARD)
        iconProperties:SetPercentageWidth(1.0)
        iconProperties:SetPercentageHeight(1)
        // Clear of the selected item's 3-point tag.
        iconProperties:SetLeftMargin(12)
        iconProperties:SetTopMargin(4)
        iconProperties:SetBottomMargin(4)

        labelProperties:SetVerticalLayoutMode(labelProperties:FIT_CONTENTS)
        // The text starts clear of the tag, with a little room above and
        // below it.
        labelProperties:SetLeftMargin(12)
        labelProperties:SetRightMargin(6)
        labelProperties:SetTopMargin(3)
        labelProperties:SetBottomMargin(5)

        shortcutProperties:SetVerticalLayoutMode(shortcutProperties:FIT_CONTENTS)
        // A clear gap between the names and the shortcuts.
        shortcutProperties:SetLeftMargin(24)
        shortcutProperties:SetRightMargin(12)
        shortcutProperties:SetTopMargin(3)
        shortcutProperties:SetBottomMargin(5)

        arrowProperties:SetHorizontalLayoutMode(arrowProperties:MAINTAIN_ASPECT_RATIO)
        arrowProperties:SetVerticalLayoutMode(arrowProperties:STANDARD)
        arrowProperties:SetPercentageWidth(1.0)
        arrowProperties:SetPercentageHeight(0.5)
        arrowProperties:SetRightMargin(6)
        arrowProperties:SetTopMargin(4)
        arrowProperties:SetBottomMargin(4)

        label:SetName("Label")
        icon:SetName("Icon")
        shortcutLabel:SetName("Shortcut")
        shortcutLabel:SetText("")
        arrow:SetName("Arrow")
        arrow:Hide()
        
shortcutLabel:SetAccessibilityCode(shortcutLabel:parent:Item:NOT_ACCESSIBLE)
label:SetAccessibilityCode(label:parent:Item:NOT_ACCESSIBLE)

        Add(icon)
        Add(label)
        Add(shortcutLabel)
        Add(arrow)

        SetInterfaceOptionsKey("MenuItem")
    end

    /*
        This action returns the font size a MenuItem uses unless its layout
        properties set another one.

        Attribute: Returns The default font size, which is 14.
    */
    action GetDefaultFontSize returns integer
        return 14
    end

    /*
        This action gives the item a keyboard shortcut. The keys are added to the
        game's default input table, so pressing them anywhere in the game chooses this
        item, even when its menu is closed. If the item is a menu, the shortcut opens
        it and selects its first item instead. The name of the keys, such as
        "Control + S", is shown at the right side of the item.

        Attribute: Parameter set The InputSet that describes the keys of the shortcut.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Game.InputSet
        use Libraries.Interface.Events.KeyboardEvent
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem open
                open:SetName("Open")

                KeyboardEvent keys
                InputSet openKeys
                openKeys:SetKeyboardInput(keys:O)
                openKeys:AddModifier(openKeys:CONTROL)
                open:SetShortcut(openKeys)

                file:Add(open)
                bar:Add(file)
                Add(bar)
            end
        end
    */
    action SetShortcut(InputSet set)
        text name = set:GetDisplayName()
        GameStateManager manager
        InputTable table = manager:GetGame():GetDefaultInputTable()
        MenuItemShortcutBehavior behave
        behave:SetMenuItem(me)
        table:Add(set, behave)
        SetShortcut(name)
    end

    /*
        This action adds a MenuItem to the bottom of this item's menu, which makes
        this item a menu. The added item is connected to this item and to the same
        MenuRoot. When this item is inside another menu, or in a PopupMenu, an arrow
        appears on it to show it opens a submenu.

        Attribute: Parameter item The MenuItem to add to this item's menu.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem edit
                edit:SetName("Edit")
                MenuItem undo
                undo:SetName("Undo")
                MenuItem redo
                redo:SetName("Redo")
                edit:Add(undo)
                edit:Add(redo)
                bar:Add(edit)
                Add(bar)
            end
        end
    */
    action Add(MenuItem item)

        MenuItemView menuView = undefined
        boolean noBar = GetMenuRoot() not= undefined and GetMenuRoot():HasBar() = false

        if menuItems:IsEmpty() and (GetParentMenu() not= undefined or noBar)
            arrow:Show()
        end

        item:SetMenuRoot(menuRoot)
        item:SetParentMenu(me)
        panel:Add(item)
        menuItems:Add(item)

        if item:GetMenuDirection() = DEFAULT
            item:SetMenuDirection(DEFAULT)
        end
    end

    /*
        This action adds each MenuItem in the array to the bottom of this item's menu,
        in order.

        Attribute: Parameter items The MenuItems to add to this item's menu.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Containers.Array
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuItem undo
                undo:SetName("Undo")
                MenuItem redo
                redo:SetName("Redo")
                Array<MenuItem> items
                items:Add(undo)
                items:Add(redo)

                MenuItem edit
                edit:SetName("Edit")
                edit:Add(items)

                MenuBar bar
                bar:Add(edit)
                Add(bar)
            end
        end
    */
    action Add(Array<MenuItem> items)
        integer counter = 0
        repeat while counter < items:GetSize()
            Add(items:Get(counter))
            counter = counter + 1
        end
    end

    /*
        This action takes a MenuItem out of this item's menu, so it is no longer
        shown there.

        Attribute: Parameter item The MenuItem to remove.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem edit
                edit:SetName("Edit")
                MenuItem undo
                undo:SetName("Undo")
                MenuItem redo
                redo:SetName("Redo")
                edit:Add(undo)
                edit:Add(redo)

                edit:RemoveMenuItem(redo)

                bar:Add(edit)
                Add(bar)
            end
        end
    */
    action RemoveMenuItem(MenuItem item)
        menuItems:Remove(item)
        panel:Remove(item)
    end

    /*
        This action removes every MenuItem from this item's menu, so it is no longer
        a menu.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem recent
                recent:SetName("Recent")
                MenuItem notes
                notes:SetName("Notes.txt")
                recent:Add(notes)

                // Clear the list of recent files.
                recent:Empty()

                bar:Add(recent)
                Add(bar)
            end
        end
    */
    action Empty
        menuItems:Empty()
        panel:Empty()
    end

    /*
        This action tells whether this item's menu has no MenuItems in it. An empty
        item is a plain choice, not a menu.

        Attribute: Returns true if the item has no items in its menu, or false if it has at least one.
    */
    action IsEmpty returns boolean
        return menuItems:IsEmpty()
    end

    /*
        This action sets which side of the item its menu opens on. The value is one
        of the MenuItem constants LEFT, RIGHT, DOWN or UP. DEFAULT opens down for a
        title on a menu bar and to the right for anything else. The menu is placed
        against that side of the item. Note that when the item loads its graphics, it
        sets its own direction this way, down on a menu bar and right elsewhere.

        Attribute: Parameter direction The side to open the menu on: DEFAULT, LEFT, RIGHT, DOWN or UP.
    */
    action SetMenuDirection(integer direction)
        if panelLayout = undefined
            VerticalMenuLayout layout
            panelLayout = layout
        end

        me:direction = direction

        if direction = DEFAULT
            if GetParentMenu() = undefined and (GetMenuRoot()not= undefined and GetMenuRoot():HasBar() = true)
                direction = DOWN
            else
                direction = RIGHT
            end
        end

        LayoutProperties anchorProperties = panelAnchor:GetDefaultLayoutProperties()

        if direction = LEFT
            anchorProperties:SetPercentageX(0)
            anchorProperties:SetPercentageY(1)

            panelProperties:SetPercentageOriginX(1)
            panelProperties:SetPercentageOriginY(1)
            panelProperties:SetPercentageX(0)
            panelProperties:SetPercentageY(1)
        elseif direction = RIGHT
            anchorProperties:SetPercentageX(1)
            anchorProperties:SetPercentageY(1)

            panelProperties:SetPercentageOriginX(0)
            panelProperties:SetPercentageOriginY(1)
            panelProperties:SetPercentageX(1)
            panelProperties:SetPercentageY(1)
        elseif direction = DOWN
            anchorProperties:SetPercentageX(0)
            anchorProperties:SetPercentageY(0)

            panelProperties:SetPercentageOriginX(0)
            panelProperties:SetPercentageOriginY(1)
            panelProperties:SetPercentageY(0)
            panelProperties:SetPercentageX(0)
            // A title inset from the bar's bottom edge (its bottom margin)
            // still opens its panel at that edge, not over the bar.
            number drop = GetDefaultLayoutProperties():GetBottomMargin() * GetInterfaceScale()
            panelProperties:SetPixelY(-drop)
        elseif direction = UP
            anchorProperties:SetPercentageX(0)
            anchorProperties:SetPercentageY(1)

            panelProperties:SetPercentageOriginX(0)
            panelProperties:SetPercentageOriginY(0)
            panelProperties:SetPercentageX(0)
            panelProperties:SetPercentageY(1)
        end
    end

    /*
        This action returns which side of the item its menu opens on, as one of the
        MenuItem constants DEFAULT, LEFT, RIGHT, DOWN or UP.

        Attribute: Returns The direction the menu opens in.
    */
    action GetMenuDirection returns integer
        return direction
    end

    /*
        This action opens the item's menu, showing the panel of items inside it. It
        does nothing if the menu is already open or the item has no items in it. When
        the menu opens, the MenuRoot tells its MenuChangeListeners.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem quit
                quit:SetName("Quit")
                file:Add(quit)
                bar:Add(file)
                Add(bar)

                file:Open()
            end
        end
    */
    action Open
        if not open and (not menuItems:IsEmpty())
            if panel:GetInterfaceScale() not= GetInterfaceScale()
                panel:SetInterfaceScale(GetInterfaceScale())
            end

            open = true
            Add(panelAnchor)
            panel:Resize()
            
            MenuRoot bar = GetMenuRoot()
            if bar not= undefined
                MenuChangeEvent event
                event:Set(bar, me, event:OPENED)
                bar:NotifyMenuChangeListeners(event)
            end
        end
    end

    /*
        This action closes the item's menu, along with any of its submenus that are
        open. If the menu was open, the MenuRoot tells its MenuChangeListeners that it
        closed.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem quit
                quit:SetName("Quit")
                file:Add(quit)
                bar:Add(file)
                Add(bar)

                file:Open()
                file:Close()
            end
        end
    */
    action Close
        if open
            integer counter = 0

            repeat while counter < menuItems:GetSize()
                MenuItem item = menuItems:Get(counter)
                item:Close()
                counter = counter +  1
            end

            open = false
            Remove(panelAnchor)

            MenuRoot bar = GetMenuRoot()
            if bar not= undefined
                MenuChangeEvent event
                event:Set(bar, me, event:CLOSED)
                bar:NotifyMenuChangeListeners(event)
            end
        end
        
        selectionIndex = 0
    end

    /*
        This action tells whether the item's menu is open.

        Attribute: Returns true if the menu is open, or false if it is closed.
    */
    action IsOpen returns boolean
        return open
    end

    /*
        This action sets the shortcut text shown at the right side of the item, such
        as "Ctrl + C". It only changes what is shown. To make the keys work, use the
        version of SetShortcut that takes an InputSet.

        Attribute: Parameter shortcut The text to show as the item's shortcut.
    */
    action SetShortcut(text shortcut)
        shortcutLabel:SetText(shortcut)
    end
    
    /*
        This action returns the shortcut text shown at the right side of the item, or
        an empty text if it has no shortcut.

        Attribute: Returns The item's shortcut text.
    */
    action GetShortcut returns text
        return shortcutLabel:GetText()
    end

    /*
        This action fills a MenuItemView with this item's name and shortcut, turns on
        the view's submenu arrow if the item has items in its menu, and sizes the item
        to fit the view.

        Attribute: Parameter content The MenuItemView to show the item with.
    */
    action SetAppearance(MenuItemView content)
        content:SetText(GetName())
        content:SetShortcut(GetShortcut())
        if not (menuItems:IsEmpty()) and GetMenuRoot() not= undefined
            content:EnableMenuArrow(true)
            GetMenuRoot():Resize()
        else
            content:EnableMenuArrow(false)
        end

        SetSize(content:GetViewWidth(), content:GetViewHeight())
    end

    /*
        This action gives every item in this item's menu, and in all of its submenus,
        its own copy of the given MenuItemView, filled in with that item's name and
        shortcut. It does nothing if the view is undefined.

        Attribute: Parameter menuView The MenuItemView to copy for each item.
    */
    action SetMenuAppearance(MenuItemView menuView)

        if menuView = undefined
            return now
        end

        integer counter = 0
        repeat while counter < menuItems:GetSize()
            Item2D i = menuItems:Get(counter)
            
            if i is MenuItem
                MenuItem item = cast(MenuItem, i)
                MenuItemView copy = cast(MenuItemView, menuView:Copy())
                item:SetAppearance(copy)
                item:SetMenuAppearance(menuView)
            end
            counter = counter + 1
        end
    end

    /*
        This action returns the MenuRoot this item belongs to, such as the MenuBar or
        PopupMenu it was added to, directly or through other menus. It returns
        undefined if the item is not in a MenuRoot yet.

        Attribute: Returns The MenuRoot this item belongs to, or undefined.
    */
    action GetMenuRoot returns MenuRoot
        return menuRoot
    end

    /*
        This action sets the MenuRoot this item belongs to, and passes it on to every
        item in this item's menu. Adding an item to a MenuBar, a PopupMenu or another
        MenuItem sets this automatically.

        Attribute: Parameter root The MenuRoot this item belongs to.
    */
    action SetMenuRoot(MenuRoot root)
        menuRoot = root

        integer counter = 0
        repeat while counter < menuItems:GetSize()
            MenuItem child = menuItems:Get(counter)
            child:SetMenuRoot(root)
            counter = counter + 1
        end
    end

    /*
        This action returns the MenuItem whose menu this item is in, or undefined if
        the item is on the top level of a MenuBar or PopupMenu.

        Attribute: Returns The MenuItem that holds this item, or undefined.
    */
    action GetParentMenu returns MenuItem
        return parentMenu
    end

    /*
        This action sets the MenuItem whose menu this item is in. If this item already
        has items of its own, its submenu arrow is shown. Adding an item to another
        MenuItem sets this automatically.

        Attribute: Parameter menu The MenuItem that holds this item.
    */
    action SetParentMenu(MenuItem menu)
        parentMenu = menu
        // A submenu given its items before it was put in its menu shows its
        // arrow now, as one given them after does (Add).
        if menu not= undefined and not menuItems:IsEmpty()
            arrow:Show()
        end
    end

    /*
        This action sets the Behavior that runs when the user chooses this item, by
        clicking it, pressing Enter on it, or using its shortcut or mnemonic. The
        Behavior is normally a class of your own that extends Behavior and does its
        work in its Run action.

        Attribute: Parameter behavior The Behavior to run when the item is chosen.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Behaviors.Behavior
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem save
                save:SetName("Save")

                // In a real program, this would be a subclass of Behavior
                // whose Run action saves the file.
                Behavior saveBehavior
                save:SetBehavior(saveBehavior)

                file:Add(save)
                bar:Add(file)
                Add(bar)
            end
        end
    */
    action SetBehavior(Behavior behavior)
        activationBehavior = behavior
    end

    /*
        This action returns the Behavior that runs when the user chooses this item,
        or undefined if none was set.

        Attribute: Returns The item's Behavior, or undefined.
    */
    action GetActivationBehavior returns Behavior
        return activationBehavior
    end

    /*
        This action is called when the user clicks the item. If the menu is already
        in use, the item is activated. Otherwise the click selects the item, which
        starts using the menu. An item that is not in a MenuRoot is activated right
        away. This is called automatically by the Game engine.
    */
    action ClickedMouse
        parent:Control:ClickedMouse()

        MenuRoot bar = GetMenuRoot()
        if bar not= undefined
            if bar:IsSelecting()
                Activate()
            else
                Select()
            end
        else
            Activate()
        end
    end

    /*
        This action is called when the mouse moves onto the item. It shows the
        underline under the item's mnemonic and colors its text. If the menu is in
        use, the item is selected and its menu, if it has one, opens. This is called
        automatically by the Game engine.
    */
    action BeginMouseOver
        parent:Control:BeginMouseOver()
        label:ShowUnderline()
        // The theme's hover text color, if it has one, or the selection
        // color when selected.
        RefreshLabelColor()
        MenuRoot bar = GetMenuRoot()
        if bar not= undefined and bar:IsSelecting()
            if not open
                Open()
            end
            Select()
        end
    end

    /*
        This action is called when the mouse moves off the item. It hides the
        mnemonic underline unless the item is selected, and colors its text again for
        its current state. This is called automatically by the Game engine.
    */
    action EndMouseOver
        parent:Control:EndMouseOver()
        if not IsSelected()
            label:HideUnderline()
        end
        // Always colored again from the item's state, so the hover color is
        // never left behind, even when the item counts as selected.
        RefreshLabelColor()
    end

    /*
    Colors the label from the item's state: the selection font color when
    selected, the theme's hover font color while the mouse is over it (if
    the theme has one), and the plain font color otherwise. Every change of
    hover or selection calls this, so a color is never left behind.
    */
    private action RefreshLabelColor
        ColorLabel(IsSelected())
    end

    /*
    Colors the label as RefreshLabelColor does, for a selection state given
    directly. GainedSelection and LostSelection use it, since MenuRoot sets
    its selection path after telling the items, so IsSelected doesn't yet
    give the new state while they run.
    */
    private action ColorLabel(boolean selected)
        LayoutProperties properties = GetDefaultLayoutProperties()
        if selected
            label:SetColor(properties:GetSelectionFontColor())
        elseif IsRenderingMouseOver() and properties:GetMouseOverFontColor() not= undefined
            label:SetColor(properties:GetMouseOverFontColor())
        else
            label:SetColor(properties:GetFontColor())
        end
    end

    /*
        This action is called when the item becomes selected. It shows the mnemonic
        underline, colors the name and shortcut with the selection colors, and marks
        the MenuRoot as in use. This is called automatically as the selection changes,
        so most users shouldn't need to call it.
    */
    action GainedSelection
        parent:Control:GainedSelection()
        label:ShowUnderline()
        LayoutProperties properties = GetDefaultLayoutProperties()
        ColorLabel(true)
        shortcutLabel:SetColor(properties:GetSelectionFontColor())

        MenuRoot menuRoot = GetMenuRoot()
        if menuRoot not= undefined
            menuRoot:SetSelectingState(true)
        end
    end

    /*
        This action is called when the item stops being selected. It hides the
        mnemonic underline, colors the name and shortcut back to normal, and closes
        the item's menu if it is open. This is called automatically as the selection
        changes, so most users shouldn't need to call it.
    */
    action LostSelection
        parent:Control:LostSelection()
        label:HideUnderline()
        LayoutProperties properties = GetDefaultLayoutProperties()
        ColorLabel(false)
        ColorShortcut(properties, false)

        if open
            Close()
        end
    end

    /*
        This action selects this item. It asks the MenuRoot to select the path from
        the top level of the menu down to this item, so the old selection is cleared
        first and the MenuRoot keeps track of what is selected. It does nothing if the
        item is not in a MenuRoot.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem quit
                quit:SetName("Quit")
                file:Add(quit)
                bar:Add(file)
                Add(bar)

                file:Open()
                quit:Select()
            end
        end
    */
    action Select
        // Don't actually select here! Go to MenuRoot and ask it to select us.
        // We do this to allow the MenuRoot to fully update its information,
        // deselect the previous selection, and prevent infinite loops.
        if menuRoot not= undefined
            menuRoot:Select(GetMenuPath())
        end
    end

    /*
        This action clears the selection of the MenuRoot this item is in, so nothing
        in the menu is selected. It does nothing if the item is not in a MenuRoot.
    */
    action Deselect
        // Don't actually select here! Go to MenuRoot and ask it to deselect us.
        // We do this to allow the MenuRoot to fully update its information,
        // deselect this, and prevent infinite loops.
        if menuRoot not= undefined
            menuRoot:Deselect()
        end
    end

    /*
        This action returns an Iterator that goes through the MenuItems in this
        item's menu, from top to bottom.

        Attribute: Returns An Iterator over the items in this item's menu.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Containers.Iterator
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem edit
                edit:SetName("Edit")
                MenuItem undo
                undo:SetName("Undo")
                MenuItem redo
                redo:SetName("Redo")
                edit:Add(undo)
                edit:Add(redo)
                bar:Add(edit)
                Add(bar)

                Iterator<MenuItem> iterator = edit:GetMenuItems()
                repeat while iterator:HasNext()
                    MenuItem item = iterator:Next()
                    output item:GetName()
                end
            end
        end
    */
    action GetMenuItems returns Iterator<MenuItem>
        return menuItems:GetIterator()
    end

    /*
        This action moves the selection inside this item's menu from one path to
        another. It compares the first item of each path: if they are the same, it
        passes the rest of the paths on to that item, and if they differ, the old item
        and everything after it lose the selection and the new item and everything
        after it gain it. The MenuRoot uses this when the selection changes, and it
        removes items from the front of both arrays as it goes. Most users shouldn't
        need to call it.

        Attribute: Parameter oldPath The rest of the old selection path, below this item.

        Attribute: Parameter newPath The rest of the new selection path, below this item.
    */
    action UpdateSelection(Array<MenuItem> oldPath, Array<MenuItem> newPath)

        MenuItem oldItem = undefined
        MenuItem newItem = undefined

        if not oldPath:IsEmpty()
            oldItem = oldPath:RemoveFromFront()
        end

        if not newPath:IsEmpty()
            newItem = newPath:RemoveFromFront()
        end

        if oldItem = newItem
            if oldItem = undefined
                return now
            else
                if oldItem not= undefined
                    oldItem:UpdateSelection(oldPath, newPath)
                end
            end
        else
            if oldItem not= undefined
                oldItem:RecursiveDeselect(oldPath)
            end
            if newItem not= undefined
                newItem:RecursiveSelect(newPath)
            end
        end
    end

    /*
        This action marks this item as selected, then does the same for each item in
        the given path, in order. The MenuRoot uses this to select every item from the
        top of the menu down to the selected item. It removes items from the front of
        the array as it goes. Most users shouldn't need to call it.

        Attribute: Parameter path The items below this one that should also be selected.
    */
    action RecursiveSelect(Array<MenuItem> path)
        GainedSelection()
        if not path:IsEmpty()
            MenuItem item = path:RemoveFromFront()
            if item not= undefined
                item:RecursiveSelect(path)
            end
        end
    end

    /*
        This action removes the selection from each item in the given path, starting
        from the deepest, then from this item. The MenuRoot uses this to clear an old
        selection. It removes items from the front of the array as it goes. Most users
        shouldn't need to call it.

        Attribute: Parameter path The items below this one that should also lose the selection.
    */
    action RecursiveDeselect(Array<MenuItem> path)
        if not path:IsEmpty()
            MenuItem item = path:RemoveFromFront()
            if item not= undefined
                item:RecursiveDeselect(path)
            end
        end
        LostSelection()
    end

    /*
        This action returns how much width the item's icon needs, including its
        margins. The icon is drawn as tall as a line of the font. The menu's layout
        uses this to line up the icons of every item in a menu.

        Attribute: Returns The width the icon needs, or 0 if the item shows no icon.
    */
    action GetIconWidth returns number
        if icon:IsShowing()
            Font font = GetDefaultLayoutProperties():GetFont()
            if font not= undefined
                number aspectRatio = 1.0
                LayoutProperties iconProperties = icon:GetDefaultLayoutProperties()
                if iconProperties:GetHorizontalLayoutMode() = iconProperties:MAINTAIN_ASPECT_RATIO
                    aspectRatio = iconProperties:GetPercentageWidth()
                end

                return (font:GetLineHeight() * aspectRatio) + iconProperties:GetLeftMargin() + iconProperties:GetRightMargin()
            end
        end
        return 0
    end

    /*
        This action returns how much width the item's name needs, including its
        margins. The menu's layout uses this to line up the names of every item in a
        menu.

        Attribute: Returns The width the name needs, or 0 if the name is hidden.
    */
    action GetNameWidth returns number
        if label:IsShowing()
            LayoutProperties properties = label:GetDefaultLayoutProperties()
            return label:GetWidth() + properties:GetLeftMargin() + properties:GetRightMargin()
        else
            return 0
        end
    end

    /*
        This action returns how much width the item's shortcut text needs, including
        its margins. The menu's layout uses this to line up the shortcuts of every
        item in a menu.

        Attribute: Returns The width the shortcut needs, or 0 if the item has no shortcut.
    */
    action GetShortcutWidth returns number
        if shortcutLabel:IsShowing() and shortcutLabel:GetText() not= ""
            // The shortcut's own margins, which MenuItemLayout places it by.
            LayoutProperties properties = shortcutLabel:GetDefaultLayoutProperties()
            return shortcutLabel:GetWidth() + properties:GetLeftMargin() + properties:GetRightMargin()
        else
            return 0
        end
    end

    /*
    Colors the shortcut: the selection font color on the selected item, and
    otherwise the MenuItem accent color (a muted text color), or the font
    color when the theme has no accent.
    */
    private action ColorShortcut(LayoutProperties properties, boolean selected)
        if selected
            shortcutLabel:SetColor(properties:GetSelectionFontColor())
            return now
        end
        ColorGroup muted = properties:GetAccentColor()
        if muted = undefined
            muted = properties:GetFontColor()
        end
        shortcutLabel:SetColor(muted)
    end

    /*
        This action returns how much width the item's submenu arrow needs, including
        its margins. The menu's layout uses this to make room for the arrows at the
        right side of a menu.

        Attribute: Returns The width the arrow needs, or 0 if the item shows no arrow.
    */
    action GetSubmenuIconWidth returns number
        if arrow:IsShowing()
            Font font = GetDefaultLayoutProperties():GetFont()
            if font not= undefined
                number aspectRatio = 1.0
                LayoutProperties arrowProperties = arrow:GetDefaultLayoutProperties()
                if arrowProperties:GetHorizontalLayoutMode() = arrowProperties:MAINTAIN_ASPECT_RATIO
                    aspectRatio = arrowProperties:GetPercentageWidth()
                end

                return (font:GetLineHeight() * aspectRatio) + arrowProperties:GetLeftMargin() + arrowProperties:GetRightMargin()
            end
        end
        return 0
    end

    /*
        This action tells whether this item is a menu, meaning it has at least one
        MenuItem in it.

        Attribute: Returns true if the item has items in its menu, or false if it is a plain choice.
    */
    action IsMenu returns boolean
        return not menuItems:IsEmpty()
    end

    /*
        This action returns how many MenuItems are directly in this item's menu. It
        does not count the items inside submenus.

        Attribute: Returns The number of items in this item's menu.
    */
    action GetSize returns integer
        return menuItems:GetSize()
    end

    /*
        This action moves the selection down from this item, as the down arrow key
        does. If this item is inside a menu, the item below it is selected, wrapping
        around from the bottom to the top. If this item is a title at the top of a
        menu, its menu opens and its first item is selected. The MenuRoot calls this,
        so most users shouldn't need to.
    */
    action MenuSelectionDown
        if GetParentMenu() not= undefined
            GetParentMenu():MenuSelectionDown(me)
        elseif menuItems:GetSize() > 0
            if not open
                Open()
            end
            menuItems:Get(0):Select()
        end
    end

    /*
        This action selects the item below the given one in this item's menu,
        wrapping around from the bottom to the top.

        Attribute: Parameter previous The item in this menu that the selection moves down from.
    */
    private action MenuSelectionDown(MenuItem previous)
        integer counter = 0
        repeat while counter < menuItems:GetSize()
            Item2D item = menuItems:Get(counter)
            if item:Equals(previous)

                // Select next item in the list, wrap if needed
                integer index = (counter + 1) mod menuItems:GetSize()
                menuItems:Get(index):Select()

                return now
            end
            counter = counter + 1
        end
    end

    /*
        This action moves the selection up from this item, as the up arrow key does.
        If this item is inside a menu, the item above it is selected, wrapping around
        from the top to the bottom. If this item is a title at the top of a menu, its
        menu opens and its first item is selected. The MenuRoot calls this, so most
        users shouldn't need to.
    */
    action MenuSelectionUp
        if GetParentMenu() not= undefined
            GetParentMenu():MenuSelectionUp(me)
        elseif menuItems:GetSize() > 0
            if not open
                Open()
            end
            menuItems:Get(0):Select()
        end
    end

    /*
        This action selects the item above the given one in this item's menu,
        wrapping around from the top to the bottom.

        Attribute: Parameter previous The item in this menu that the selection moves up from.
    */
    private action MenuSelectionUp(MenuItem previous)
        integer counter = 0
        repeat while counter < menuItems:GetSize()
            Item2D item = menuItems:Get(counter)
            if item:Equals(previous)

                // Select the previous element in the menu, wrap if needed
                integer index = counter - 1
                if index < 0
                    index = menuItems:GetSize() - 1
                end
                menuItems:Get(index):Select()

                return now
            end
            counter = counter + 1
        end
    end

    /*
        This action returns the path from the top of the menu down to this item. The
        first item in the array is the top level item, such as File, and the last is
        this item, such as Exit. This is the path the MenuRoot uses for its selection.

        Attribute: Returns The MenuItems from the top level of the menu down to this item.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Containers.Array
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem exit
                exit:SetName("Exit")
                file:Add(exit)
                bar:Add(file)
                Add(bar)

                Array<MenuItem> path = exit:GetMenuPath()
                output "The path has " + path:GetSize() + " items."
            end
        end
    */
    action GetMenuPath returns Array<MenuItem>
        Array<MenuItem> path
        path:Add(me)
        if parentMenu not= undefined
            Array<MenuItem> a = parentMenu:GetMenuPath(path)
            return a
        end
        return path
    end

    /*
        This action adds this item to the front of the given path, then asks the item
        that holds this one to do the same, building the path up to the top level of
        the menu.

        Attribute: Parameter array The part of the path built so far, below this item.

        Attribute: Returns The path from the top level of the menu down to the original item.
    */
    private action GetMenuPath(Array<MenuItem> array) returns Array<MenuItem>
        array:AddToFront(me)
        if parentMenu not= undefined
            return parentMenu:GetMenuPath(array)
        end

        return array
    end

    /*
        Returns whether or not the menu item is selected.

        Attribute: Returns true if the item is selected.
    */
    action IsSelected returns boolean
        if GetMenuRoot() = undefined
            return false
        end
        Array<MenuItem> path = GetMenuRoot():GetSelection():GetPath()
        return path:Has(me)
    end

    /*
        This action chooses the item. If the item is a menu, its menu opens, or if it
        is already open, the whole menu closes. If the item is a plain choice, the
        menu stops being used and the focus goes back to whatever had it before the
        menu. Then the item's Behavior, if it has one, runs.

        Attribute: Parameter event The BehaviorEvent that describes what activated the item.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Behaviors.Behavior
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem
        use Libraries.Interface.Events.BehaviorEvent

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                MenuItem save
                save:SetName("Save")
                Behavior saveBehavior
                save:SetBehavior(saveBehavior)
                file:Add(save)
                bar:Add(file)
                Add(bar)

                // Choose Save as if the user had clicked it.
                BehaviorEvent event
                event:SetItem(save)
                save:Activate(event)
            end
        end
    */
    action Activate(BehaviorEvent event)
        if IsMenu()
            if open
                if menuRoot not= undefined
                    menuRoot:Close()
                else
                    Close()
                end
            else
                Open()
            end
        end

        if IsMenu() = false and menuRoot not= undefined and menuRoot:IsSelecting()
            menuRoot:SetSelectingState(false)
            menuRoot:RestoreLastFocus()
        end
        parent:Control:Activate(event)
    end

    /*
    This action is used to load the graphical components of the Control. This is
    handled automatically by the Game engine as needed, and most users shouldn't
    need to use this action directly.
    */
    action LoadGraphics(LayoutProperties properties)
        if GetParentMenu() = undefined and (GetMenuRoot() not= undefined and GetMenuRoot():HasBar())
            if GetLayout() = undefined or GetLayout():Equals(rootLayout) = false
                rootLayout:SetIgnoreHidden(true)
                SetLayout(rootLayout)
            end

            shortcutLabel:Hide()
            arrow:Hide()

            SetMenuDirection(DOWN)

            properties:SetHorizontalLayoutMode(properties:FIT_CONTENTS)
            // Titles on the bar never show the tag.
            properties:SetBorderStyle(properties:NONE)
        else
            if GetLayout() = undefined or GetLayout():Equals(menuItemLayout) = false
                SetLayout(menuItemLayout)
            end

            properties:SetHorizontalLayoutMode(properties:STANDARD)
            properties:SetPercentageWidth(1.0)
            // The selected item's tag: its left border, drawn only while
            // selected (the MenuItem selection border, M4).
            properties:SetBorderStyle(properties:LEFT)

            SetMenuDirection(RIGHT)

            if shortcutLabel:GetText() = ""
                shortcutLabel:Hide()
            else
                shortcutLabel:Show()
            end
        end

        panel:SetName(GetName() + " Menu Panel")
        // The panel keeps its own border, not the items' (whose border
        // is the tag).
        if not panelProperties:HasBorderThickness()
            panel:SetBorderThickness(1)
        end
        // A rounded panel has its edge all the way round.
        panel:SetBorderStyle(properties:ALL)

        if properties:GetIcon() not= undefined
            TextureRegion region = properties:GetIcon()
            if icon:GetTextureField() not= region:GetTextureField()
                icon:Load(properties:GetIcon())
            end
            if properties:GetIconColor() not= undefined
                icon:SetColor(properties:GetIconColor())
            end
            icon:Show()
        else
            icon:Hide()
        end

        arrow:SetColor(properties:GetFontColor())

        // A submenu's arrow is a chevron, ">", the same as a tree's,
        // drawn for half the font's line height, the arrow's size.
        if arrow:IsLoaded() = false
            integer chevronSize = cast(integer, properties:GetFont():GetLineHeight() / 2)
            if chevronSize < 8
                chevronSize = 8
            end
            ChevronTexture chevrons
            arrow:Load(chevrons:GetTexture(chevronSize))
        end

        arrow:SetColor(properties:GetFontColor():GetBottomLeft())

        text labelText = properties:GetLabelText()
        if labelText = ""
            labelText = GetName()
        end

        Font font = properties:GetFont()
        integer fontSize = cast(integer, properties:GetFontSize() * properties:GetInterfaceScale())
        if font:GetSize() not= fontSize
            font:SetSize(fontSize)
        end

        boolean selected = IsSelected()

        label:SetFont(font)
        label:SetSize(properties:GetFontSize())
        label:SetText(labelText)

        if selected
            label:SetColor(properties:GetSelectionFontColor())
        else
            label:SetColor(properties:GetFontColor())
        end
        // A theme's muted shortcut color applies from the start.
        if properties:GetAccentColor() not= undefined
            ColorShortcut(properties, selected)
        end

        shortcutLabel:SetSize(properties:GetFontSize())

        //This is a box with a border on it that is the background of the menu
        if GetView2D() = undefined
            ControlShaderView view
            view:Initialize()
            SetView2D(view)
        end

        parent:Control:LoadGraphics(properties)
    end

    /*
    The Resize action is used to recalculate the size and position of Controls
    that are being controlled by a Layout. Calling Resize on an Item2D won't
    have a direct effect on it, but if the Item's children hierarchy contains
    any Controls, those Controls will be resized.
    */
    action Resize
        if parent:Item2D:isResizing
            return now
        end

        parent:Item2D:Resize()

        // We need to resize the panel anchor to allow it to re-lay itself out
        // in the correct position, because the parent's layout will otherwise
        // override the anchor's ManualLayout.
        panelAnchor:Resize()
    end

    /*
        This action returns the item's mnemonic, the letter that chooses the item
        when typed while its menu is in use, or undefined if it has none.

        Attribute: Returns The item's mnemonic letter, or undefined.
    */
    action GetMnemonic returns text
        return mnemonic
    end

    /*
        This action sets the item's mnemonic, a letter that chooses the item when it
        is typed while the menu is in use. Typing the letter opens the item's menu if
        it has one, or activates it if not. Matching ignores upper and lower case. The
        letter is underlined in the item's name while the item is selected or under
        the mouse.

        Attribute: Parameter mnemonic The letter that chooses this item.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.MenuBar
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                MenuBar bar
                MenuItem file
                file:SetName("File")
                file:SetMnemonic("F")
                MenuItem exit
                exit:SetName("Exit")
                exit:SetMnemonic("x")
                file:Add(exit)
                bar:Add(file)
                Add(bar)
            end
        end
    */
    action SetMnemonic(text mnemonic)
        label:SetMnemonic(mnemonic)
        me:mnemonic = mnemonic
    end

end
