package Libraries.Interface.Controls

use Libraries.Interface.Controls.TreeItemContent
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.TextureRegion
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.Graphics.Drawable
use Libraries.Interface.Views.View2D
use Libraries.Interface.Views.DefaultTreeMenuView
use Libraries.Interface.Behaviors.Controls.ToggleTreeViewBehavior
use Libraries.Interface.Layouts.TreeLayout

/*
The DefaultTreeItemContent class is the standard row drawn for a TreeItem:
an arrow button that opens and closes the item, the item's icon, and its
name. A TreeItem makes one automatically the first time it is drawn, so
most programs never create it. The arrow is only shown when the item has
children, and it is hidden from screen readers, which open and close the
item directly. On a selected row, the name and the arrow are drawn in the
selection text color; the band behind the row is drawn by the TreeItem.

Attribute: Author William Allee

Attribute: Example

use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem
use Libraries.Interface.Controls.DefaultTreeItemContent

Form form
Page page = form:GetMainPage()
Tree tree = page:AddTree("Files")

TreeItem item
item:SetName("Main.quorum")
DefaultTreeItemContent content
item:SetTreeItemContent(content)
tree:Add(item)

form:Display()
*/
class DefaultTreeItemContent is TreeItemContent

    ControlLabel label = undefined
    ToggleButton expandButton = undefined
    Icon icon = undefined

    // Used to ensure the font isn't loaded until the TreeItem's graphics are.
    boolean fontInitialized = false

    // The arrow's color while the row is selected, or undefined to use the
    // accent color (UpdateArrowColor).
    ColorGroup selectedArrowColor = undefined

    on create
        FlowLayout flow
        flow:SetVerticalCentering(true)
        SetLayout(flow)

        LayoutProperties itemStructureProperties = GetDefaultLayoutProperties()
        itemStructureProperties:SetHorizontalLayoutMode(itemStructureProperties:FIT_CONTENTS)
        itemStructureProperties:SetVerticalLayoutMode(itemStructureProperties:FIT_FONT)
    end

    /*
    This action sets the TreeItem whose row this content draws and shows that
    item's name. TreeItem's SetTreeItemContent calls it, so most programs never
    call it directly.

    Attribute: Parameter item The TreeItem this content belongs to.
    */
    action SetTreeItem(TreeItem item)
        parent:TreeItemContent:SetTreeItem(item)
        UpdateText(item:GetName())
    end

    /*
    This action shows the given text as the row's name, but only once the
    label has been made and while it has no text yet. After that, the label is
    set from the item's name each time the row's graphics are loaded. The
    TreeItem calls this action when its name is set.

    Attribute: Parameter name The text to show.
    */
    action UpdateText(text name)
        if label not= undefined and label:GetText() = ""
            label:SetText(name)
        end
    end

    /*
    This action hides the arrow button, if it has been made. The TreeItem calls
    it when its last child is removed.
    */
    action HideExpandButton
        if expandButton not= undefined
            expandButton:Hide()
        end
    end

    /*
    This action shows the arrow button, if it has been made. The TreeItem calls
    it when its first child is added.
    */
    action ShowExpandButton
        if expandButton not= undefined
            expandButton:Show()
        end
    end

    /*
    This action sets the arrow button to show whether the item is open, if the
    button has been made. Setting it doesn't open or close the item; the
    TreeItem calls this action when it opens or closes.

    Attribute: Parameter expand True if the item is open, false if it is closed.
    */
    action SetExpandState(boolean expand)
        if expandButton not= undefined
            if expand
                expandButton:SetToggleState(true)
            else
                expandButton:SetToggleState(false)
            end
        end
    end

    /*
    This action is called when the row's item is selected. It draws the name
    and the arrow in the selection text color.
    */
    action GainedSelection
        parent:Control:GainedSelection()
        if label not= undefined
            label:GainedSelection()
        end
        selectedArrowColor = GetSelectionFontColor()
        UpdateArrowColor()
    end

    /*
    This action is called when the row's item stops being selected. It draws
    the name in its normal color and the arrow in the accent color again.
    */
    action LostSelection
        parent:Control:LostSelection()
        if label not= undefined
            label:LostSelection()
        end
        selectedArrowColor = undefined
        UpdateArrowColor()
    end

    /*
    This action is called when the row's item is selected but its Tree loses
    the focus. It draws the name and the arrow in the unfocused selection text
    color.
    */
    action UnfocusedSelection
        if label not= undefined
            label:UnfocusedSelection()
        end
        selectedArrowColor = GetUnfocusedSelectionFontColor()
        UpdateArrowColor()
    end

    /*
        This action colors the open and close arrow to match the row's name: the
        selection's text color while the row is selected, focused or not, and the
        accent color otherwise.
    */
    private action UpdateArrowColor
        if expandButton = undefined or not (expandButton:GetView2D() is DefaultTreeMenuView)
            return now
        end
        DefaultTreeMenuView arrowView = cast(DefaultTreeMenuView, expandButton:GetView2D())
        if selectedArrowColor not= undefined
            arrowView:SetColor(selectedArrowColor)
        else
            arrowView:SetColor(GetAccentColor())
        end
    end

    /*
    This action is used to load the graphics of the row. The first time, it
    loads the item's default font if the item has none, and makes the arrow
    button, the icon and the name's label. Each time, it updates the font, the
    colors, the icon and the name. This is handled automatically, and most
    programs never call it directly.

    Attribute: Parameter properties The layout properties used to draw the row.
    */
    action LoadGraphics(LayoutProperties properties)
        TreeItem treeItem = GetTreeItem()

        if fontInitialized = false
            fontInitialized = true
            if treeItem:GetFont() = undefined

                Font font
                text defaultFontName = treeItem:GetDefaultFontName()
                if defaultFontName not= undefined
                    font:LoadFont(defaultFontName)
                    // The item keeps the size it has: its tree's, or the
                    // default for an item that was never given one.
                    font:SetSize(treeItem:GetFontSize())
                    treeItem:SetFont(font)
                end
            end
        end

        Color color

        Font font = treeItem:GetFont()
        // Height uses a default fall-back value of 10 if height can't be
        // derived from the Font.
        integer height = 10
        if font not= undefined
            height = font:GetLineHeight()

            if GetFont() not= font
                SetFont(font)
            end
            if GetFontSize() not= treeItem:GetFontSize()
                SetFontSize(treeItem:GetFontSize())
            end
        end

        if expandButton = undefined
            ToggleButton button
            expandButton = button

            View2D buttonView = properties:GetView2D()
            if buttonView = undefined
                View2D currentView = expandButton:GetView2D()
                if currentView = undefined
                    DefaultTreeMenuView content
                    content:Initialize(height, height * 2)
                    buttonView = content

                    expandButton:SetView2D(buttonView)
                else
                    buttonView = currentView
                end
            end

            LayoutProperties buttonProperties = expandButton:GetDefaultLayoutProperties()
            buttonProperties:SetView2D(buttonView)
            buttonProperties:SetVerticalLayoutMode(buttonProperties:STANDARD)
            buttonProperties:SetHorizontalLayoutMode(buttonProperties:MAINTAIN_ASPECT_RATIO)
            buttonProperties:SetPercentageHeight(1.0)
            buttonProperties:SetPercentageWidth(1.0)
            buttonProperties:SetTopMargin(4)
            buttonProperties:SetBottomMargin(4)
            buttonProperties:SetLeftMargin(4)
            buttonProperties:SetLabelText("")
            buttonProperties:SetFont(undefined)
    
            ToggleTreeViewBehavior buttonBehavior
            buttonBehavior:SetTreeItem(treeItem)
            expandButton:SetBehavior(buttonBehavior)
    
            if treeItem:GetSize() = 0
                expandButton:Hide()
            else
                expandButton:Show()
            end

            /*
            We don't want the expand button to appear in accessibility hierarchies.
            The button is purely for visual use -- non-visual access can manipulate
            the tree item directly to close/expand it.
            */
            expandButton:SetAccessibilityCode(parent:Item:NOT_ACCESSIBLE)

            Add(expandButton)
        end

        expandButton:SetBackgroundColor(GetAccentColor())
        UpdateArrowColor()

        if icon = undefined
            Icon newIcon
            icon = newIcon
            Add(icon)
        end

        TextureRegion region = treeItem:GetIcon()
        ColorGroup iconColor = treeItem:GetIconColor()
        if region = undefined and icon:GetTexture() not= undefined
            Drawable drawable
            drawable:LoadFilledRectangle(1, 1, color:CustomColor(1, 1, 1, 0))
            region = drawable
            iconColor = color:CustomColor(1, 1, 1, 0)
            treeItem:SetIcon(region)
            treeItem:SetIconColor(iconColor)
        elseif iconColor = undefined
            iconColor = color:White()
        end

        if region not= undefined and icon:GetTexture() not= region:GetTextureField()
            icon:Load(region)
            number aspectRatio = icon:GetWidth() / icon:GetHeight()
    
            LayoutProperties iconProperties = icon:GetDefaultLayoutProperties()
            iconProperties:SetVerticalLayoutMode(iconProperties:STANDARD)
            iconProperties:SetHorizontalLayoutMode(iconProperties:MAINTAIN_ASPECT_RATIO)
            iconProperties:SetPercentageHeight(1.0)
            iconProperties:SetPercentageWidth(aspectRatio)
            iconProperties:SetLeftMargin(5)
            iconProperties:SetRightMargin(5)
        end

        icon:SetColor(iconColor)

        if label = undefined
            ControlLabel newLabel
            label = newLabel
label:SetAccessibilityCode(label:parent:Item:NOT_ACCESSIBLE)
            label:SetInterfaceOptionsKey(GetInterfaceOptionsKey())
            label:SetHorizontalMargins(4)

            // The row's highlight (TreeRowHighlight, in the TreeItem) shows
            // the selection as a band across the tree, so the label only
            // changes its text color and draws no box of its own.
            label:SetSelectionColor(color:CustomColor(0, 0, 0, 0))
            label:SetUnfocusedSelectionColor(color:CustomColor(0, 0, 0, 0))

            LayoutProperties labelProperties = label:GetDefaultLayoutProperties()
            labelProperties:SetPercentageHeight(1.0)
            labelProperties:SetHorizontalLayoutMode(labelProperties:FIT_CONTENTS)

            Add(label)
        end

        if font not= undefined
            label:SetFont(font)
            label:SetSize(properties:GetFontSize())
            label:SetInterfaceScale(properties:GetInterfaceScale())
            label:SetBackgroundColor(properties:GetBackgroundColor())
            text labelText = properties:GetLabelText()
            if labelText = ""
                labelText = treeItem:GetName()
            end

            if label:GetText() not= labelText
                label:SetText(labelText)
            end
        end
        
        parent:Control:LoadGraphics(properties)
    end

    /*
    This action returns the label that shows the item's name, or undefined if
    the row hasn't been drawn yet.

    Attribute: Returns The label showing the name, or undefined.
    */
    action GetLabel returns ControlLabel
        return label
    end

end