package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Game.Graphics.Font
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Selections.ListSelection
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Views.View2D
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Controls.Support.FirstLetterNavigator
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Events.FocusEvent
use Libraries.Game.Graphics.Color

/*
The List class is a control that shows a column of text entries, one per
line, that the user can scroll through and select. Each entry is a ListItem.
The user can move the selection with the arrow keys, jump to an entry by
typing its first letters, and activate an entry, such as by double-clicking
it. Screen readers read the list and its selected entry.

Attribute: Author William Allee

Attribute: Example
use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.List

Form form
Page page = form:GetMainPage()

List fruits = page:AddList("Fruits")
fruits:Add("Apples")
fruits:Add("Bananas")
fruits:Add("Cherries")
fruits:Select(0)

form:Display()
*/
class List is ScrollableLineControl, FirstLetterNavigator

    ListSelection selection

    // The itemBehavior is called when a ListItem would be activated if it 
    // doesn't have an activation behavior of its own defined.
    Behavior itemBehavior = undefined

    ListRenderer renderer

    // True if screen readers should treat the list as a tree (SetTreeAccessibility).
    boolean treeAccessibility = false

    // What opens and closes a row for a screen reader (SetAccessibilityExpandBehaviors).
    Behavior accessibilityExpandBehavior = undefined
    Behavior accessibilityCollapseBehavior = undefined

    // A thick accent line along the list's left edge while it has the
    // focus, like a focused text field's.
    Control focusLine = undefined
    // When above 0, every line is this many pixels tall, and heights are
    // worked out without laying out lines off screen. 0, the default, measures each line.
    number fixedLineHeight = 0
    constant number FOCUS_LINE_THICKNESS = 4
    
    on create
        LayoutProperties properties = GetDefaultLayoutProperties()
        properties:SetHorizontalLayoutMode(properties:STANDARD)
        properties:SetVerticalLayoutMode(properties:STANDARD)

        SetInterfaceOptionsKey("List")

        SetInputGroup("List")

        SetFocusable(true)
        selection:Initialize(me)
        // TO-DO: This needs to be changed to something more appropriate.
        SetAccessibilityCode(parent:Item:LIST)
        SetName("List")

        SetLayoutRows(5)
    end

    /*
    This action returns true, because a List is a parent for accessibility:
    screen readers treat its items as children of the list.

    Attribute: Returns True, since a List is an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
    This action is called when the list gains the focus. It shows the focus
    line along the list's left edge and redraws the selected item so it looks
    focused.

    Attribute: Parameter event The event describing the focus change.
    */
    action GainedFocus(FocusEvent event)
        parent:ScrollableLineControl:GainedFocus(event)
        ShowFocusLine(true)
        RefreshSelectedItem()
    end

    /*
    This action is called when the list loses the focus. It hides the focus
    line along the list's left edge and redraws the selected item so it no
    longer looks focused.

    Attribute: Parameter event The event describing the focus change.
    */
    action LostFocus(FocusEvent event)
        parent:ScrollableLineControl:LostFocus(event)
        ShowFocusLine(false)
        RefreshSelectedItem()
    end

    /*
        This action shows or hides the line along the list's left edge that marks
        it as focused, drawn in the focus border color. The line is made the first
        time it is shown, once the list's graphics exist.

        Attribute: Parameter show True to show the focus line, or false to hide it.
    */
    private action ShowFocusLine(boolean show)
        if focusLine = undefined
            if not show
                return now
            end
            Control line
            focusLine = line
            focusLine:SetName("Focus Line")
            focusLine:SetAccessibilityCode(focusLine:parent:Item:NOT_ACCESSIBLE)
            focusLine:SetFocusable(false)
            // A drawing only: clicks pass through to the rows under it.
            focusLine:SetAcceptsMouseInput(false)
            ControlShaderView lineView
            lineView:Initialize()
            focusLine:SetView2D(lineView)
            LayoutProperties lineLayout = focusLine:GetDefaultLayoutProperties()
            lineLayout:SetPercentageWidth(1)
            lineLayout:SetPercentageHeight(1)
            Color clear
            clear:SetColor(0, 0, 0, 0)
            focusLine:SetBackgroundColor(clear)
            focusLine:SetBorderStyle(lineLayout:LEFT)
            focusLine:SetBorderThickness(FOCUS_LINE_THICKNESS)
            focusLine:SetCornerPixelRounding(GetBottomLeftPixelRounding(), GetBottomRightPixelRounding(),
                GetTopLeftPixelRounding(), GetTopRightPixelRounding())
            // Not a list item: the Control's own Add, as the scroll bars are.
            parent:Control:Add(focusLine)
            RequestLayout()
        end
        focusLine:SetBorderColor(GetFocusBorderColor())
        if show
            focusLine:Show()
        else
            focusLine:Hide()
        end
        focusLine:RequestVerticesUpdate()
    end

    /*
        This action updates the selected item's text color and drawing, so its look
        follows whether the list has the focus. It does nothing if no item is
        selected.
    */
    private action RefreshSelectedItem
        ListItem item = selection:GetListItem()
        if item not= undefined
            item:RefreshSelectionText()
            item:RequestVerticesUpdate()
        end
    end

    /*
    This action adds a new entry with the given text to the end of the list.

    Attribute: Parameter entry The text of the new entry.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    */
    action Add(text entry)
        Add(NewListItem(entry))
    end

    /*
    This action adds a new entry with the given text at the given position in
    the list. Position 0 is the top of the list, and entries at or after the
    position move down by one.

    Attribute: Parameter position The index the new entry will have.

    Attribute: Parameter entry The text of the new entry.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Bananas")
    fruits:Add(0, "Apples")
    */
    action Add(integer position, text entry)
        Add(position, NewListItem(entry))
    end

    /*
    This action adds a new entry with the given text and icon to the end of
    the list. The icon is drawn next to the entry's text.

    Attribute: Parameter entry The text of the new entry.

    Attribute: Parameter icon The icon to show with the entry.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.Icon

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            List files
            Icon icon
            icon:Load("Resources/FileIcon.png")
            files:Add("Notes.txt", icon)
            Add(files)
        end
    end
    */
    action Add(text entry, Icon icon)
        Add(NewListItem(entry, icon))
    end

    /*
    This action adds a new entry with the given text and icon at the given
    position in the list. Position 0 is the top of the list, and entries at
    or after the position move down by one.

    Attribute: Parameter position The index the new entry will have.

    Attribute: Parameter entry The text of the new entry.

    Attribute: Parameter icon The icon to show with the entry.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.Icon

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            List files
            files:Add("Notes.txt")
            Icon icon
            icon:Load("Resources/FileIcon.png")
            files:Add(0, "Readme.txt", icon)
            Add(files)
        end
    end
    */
    action Add(integer position, text entry, Icon icon)
        Add(position, NewListItem(entry, icon))
    end

    /*
    This action adds an item to the end of the list. The item must be a
    ListItem; any other kind of item raises an error. Use it to add a ListItem
    you made and set up yourself, such as one with its own activation
    behavior.

    Attribute: Parameter item The ListItem to add.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    ListItem item
    item:SetText("Apples")
    fruits:Add(item)
    */
    action Add(Item2D item)
        if not (item is ListItem)
            alert("I could not add the item called " + item:GetName() + " to the List -- only ListItems can be added to Lists.")
        end
        // An item kept and added again may still be hidden from an earlier
        // scroll. A hidden item isn't added to the Mac's accessibility tree,
        // and the renderer hides it again if it's off screen.
        item:Show()
        renderer:Add(item)
    end

    /*
    This action adds an item at the given position in the list. The item must
    be a ListItem; any other kind of item raises an error. Position 0 is the
    top of the list, and items at or after the position move down by one.

    Attribute: Parameter index The index the new item will have.

    Attribute: Parameter item The ListItem to add.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    fruits:Add("Bananas")
    ListItem item
    item:SetText("Apples")
    fruits:Add(0, item)
    */
    action Add(integer index, Item2D item)
        if not (item is ListItem)
            alert("I could not add the item called " + item:GetName() + " to the List -- only ListItems can be added to Lists.")
        end
        // An item kept and added again may still be hidden from an earlier
        // scroll. A hidden item isn't added to the Mac's accessibility tree,
        // and the renderer hides it again if it's off screen.
        item:Show()
        renderer:Add(index, item)
    end

    /*
    This action removes the first entry whose text matches the given text.

    Attribute: Parameter entry The text of the entry to remove.

    Attribute: Returns The ListItem that was removed, or undefined if no entry had that text.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    ListItem removed = fruits:Remove("Apples")
    */
    action Remove(text entry) returns ListItem
        integer i = 0
        repeat while i < GetSize()
            ListItem item = renderer:GetListItem(i)
            if item:GetText() = entry
                Remove(item)
                return item
            end
            i = i + 1
        end

        return undefined
    end

    /*
    This action removes the entry at the given index. Entries after it move
    up by one.

    Attribute: Parameter index The index of the entry to remove.

    Attribute: Returns The item that was removed.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Item2D
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    Item2D removed = fruits:Remove(0)
    */
    action Remove(integer index) returns Item2D
        return renderer:Remove(index)
    end

    /*
    This action removes the given item from the list.

    Attribute: Parameter item The item to remove.

    Attribute: Returns True if the item was in the list and was removed, or false if not.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    fruits:Add("Apples")
    ListItem item = fruits:GetListItem(0)
    boolean removed = fruits:Remove(item)
    */
    action Remove(Item2D item) returns boolean
        return renderer:Remove(item)
    end

    /*
    This action makes a new ListItem with the given text and no icon, using
    the list's font size.

    Attribute: Parameter value The text of the new item.

    Attribute: Returns The new ListItem.
    */
    private action NewListItem(text value) returns Control
        return NewListItem(value, undefined)
    end

    /*
    This action makes a new ListItem with the given text and icon, using the
    list's font size. If the icon is undefined, the item has no icon.

    Attribute: Parameter value The text of the new item.

    Attribute: Parameter icon The icon to show with the item, or undefined.

    Attribute: Returns The new ListItem.
    */
    private action NewListItem(text value, Icon icon) returns Control
        LayoutProperties properties = GetDefaultLayoutProperties()

        ListItem newItem
        newItem:SetText(value)
        newItem:SetFontSize(GetFontSize())

        if icon not= undefined
            newItem:SetIcon(icon)
        end

        return newItem
    end

    /*
    This action sets the font size of the list and of every entry already in
    it. Entries added later use this size too.

    Attribute: Parameter size The new font size.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:SetFontSize(20)
    */
    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        integer i = 0
        repeat while i < GetSize()
            GetListItem(i):SetFontSize(size)
            i = i + 1
        end
    end

    /*
    This action returns the text of the entry at the given index.

    Attribute: Parameter index The index of the entry.

    Attribute: Returns The entry's text.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    text first = fruits:Get(0)
    */
    action Get(integer index) returns text
        return GetListItem(index):GetText()
    end

    /*
    This action returns the ListItem at the given index. Use it to change one
    entry, such as to give it its own activation behavior.

    Attribute: Parameter index The index of the entry.

    Attribute: Returns The ListItem at that index.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    fruits:Add("Apples")
    ListItem item = fruits:GetListItem(0)
    */
    action GetListItem(integer index) returns ListItem
        return renderer:GetListItem(index)
    end

    /*
    This action returns the list's selection, which says which entry, if any,
    is selected.

    Attribute: Returns The ListSelection of this list.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Selections.ListSelection
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    fruits:Select(1)
    ListSelection selection = fruits:GetSelection()
    integer index = selection:GetIndex()
    */
    action GetSelection returns ListSelection
        return selection
    end

    /*
    This action tells screen readers to treat the list as a tree: its rows
    are nested by ListItem:GetAccessibilityLevel, each says its place among
    the rows at its depth ("2 of 5"), and rows that open and close say so
    (ListItem:IsAccessibilityExpandable). Use it for a list drawn as a
    tree. Set it before adding the list to the screen; it is false by
    default.

    Attribute: Parameter tree True to treat the list as a tree.

    Attribute: Example

        use Libraries.Interface.Controls.List

        List results
        results:SetTreeAccessibility(true)
    */
    action SetTreeAccessibility(boolean tree)
        treeAccessibility = tree
    end

    /*
    This action returns true if screen readers treat the list as a tree
    (see SetTreeAccessibility).

    Attribute: Returns True if the list is treated as a tree.
    */
    action HasTreeAccessibility returns boolean
        return treeAccessibility
    end

    /*
    This action gives a list treated as a tree (SetTreeAccessibility) the
    behaviors that open and close one of its rows, so a screen reader can
    open and close rows itself, such as with VoiceOver's VO-\ on the Mac.
    Each behavior runs with the row as the event's item, and only when the
    row's state is the other one (ListItem:IsAccessibilityExpanded): the
    expand behavior on a closed row, the collapse behavior on an open one.
    Without them, screen readers can only read whether a row is open.

    Attribute: Parameter expand The behavior that opens a row, or undefined.
    Attribute: Parameter collapse The behavior that closes a row, or undefined.

    Attribute: Example

        use Libraries.Interface.Controls.List
        use Libraries.Interface.Behaviors.Behavior

        List results
        Behavior openFile
        Behavior closeFile
        results:SetTreeAccessibility(true)
        results:SetAccessibilityExpandBehaviors(openFile, closeFile)
    */
    action SetAccessibilityExpandBehaviors(Behavior expand, Behavior collapse)
        accessibilityExpandBehavior = expand
        accessibilityCollapseBehavior = collapse
    end

    /*
    This action returns the behavior that opens a row for a screen reader
    (see SetAccessibilityExpandBehaviors), or undefined.

    Attribute: Returns The behavior, or undefined.
    */
    action GetAccessibilityExpandBehavior returns Behavior
        return accessibilityExpandBehavior
    end

    /*
    This action returns the behavior that closes a row for a screen reader
    (see SetAccessibilityExpandBehaviors), or undefined.

    Attribute: Returns The behavior, or undefined.
    */
    action GetAccessibilityCollapseBehavior returns Behavior
        return accessibilityCollapseBehavior
    end

    /*
    This action returns the index of the given ListItem in the list.

    Attribute: Parameter item The ListItem to look for.

    Attribute: Returns The item's index, or -1 if it is not in the list.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    ListItem item = fruits:GetListItem(1)
    integer index = fruits:GetIndexOf(item)
    */
    action GetIndexOf(ListItem item) returns integer
        return renderer:GetChildren():GetFirstLocation(item)
    end

    /*
    This action returns how many entries are in the list.

    Attribute: Returns The number of entries.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    integer size = fruits:GetSize()
    */
    action GetSize returns integer
        return renderer:GetItemCount()
    end

    /*
    This action selects the given ListItem, if it is present in this List.
    */
    action Select(ListItem item)
        ListItem oldSelection = selection:GetListItem()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        if item not= undefined
            item:GainedSelection()

            integer itemIndex = GetIndexOf(item)
            if not IsLineVisible(itemIndex, item)
                GoToItem(itemIndex)
            end
        end

        selection:Set(item)
    end

    /*
    This action selects the ListItem at the given index.
    */
    action Select(integer index)
        ListItem oldSelection = selection:GetListItem()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        ListItem item = GetListItem(index)
        if item not= undefined
            item:GainedSelection()
            if not IsLineVisible(index, item)
                GoToItem(index)
            end
        end

        selection:Set(index)
    end

    /*
        This action returns whether a line is wholly inside the list's visible area
        at the current scroll. It uses GetLineY, where RefreshContents would draw the
        line, because an item's own position is out of date while it is off screen.

        Attribute: Parameter index The index of the line.

        Attribute: Parameter item The list item on that line. Its place comes from the index, not from the item.

        Attribute: Returns True if the whole line can be seen, or false if it cannot.
    */
    private action IsLineVisible(integer index, ListItem item) returns boolean
        number y = GetLineY(index)
        return y >= 0 and y + GetLineHeight(index) <= renderer:GetHeight()
    end

    /*
    This action clears the selection, so no entry is selected.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:Select(0)
    fruits:Deselect()
    */
    action Deselect
        ListItem oldSelection = selection:GetListItem()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        selection:Empty()
    end

    /*
    This action selects the entry just above the selected one. If the top
    entry is already selected, nothing changes. The list scrolls if the new
    selection is off screen.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    fruits:Select(1)
    fruits:MoveSelectionUp()
    */
    action MoveSelectionUp
        integer index = selection:GetIndex()
        
        if index > 0
            Select(index - 1)
        end
    end

    /*
    This action selects the entry just below the selected one. If the bottom
    entry is already selected, nothing changes. The list scrolls if the new
    selection is off screen.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    fruits:Select(0)
    fruits:MoveSelectionDown()
    */
    action MoveSelectionDown
        integer index = selection:GetIndex()
        
        if index < GetSize() - 1
            Select(index + 1)
        end
    end

    /*
    This action sets the item activation Behavior for this List. If a ListItem
    would ever be activated (such as by a double-click), if it doesn't have
    its own activation Behavior, the List's item activation Behavior will
    be used instead.
    */
    action SetItemActivationBehavior(Behavior behavior)
        itemBehavior = behavior
    end

    /*
    This action returns the item activation Behavior for this List. If a
    ListItem would ever be activated (such as by a double-click), if it doesn't 
    have its own activation Behavior, the List's cell activation Behavior will
    be used instead.
    */
    action GetItemActivationBehavior returns Behavior
        return itemBehavior
    end

    /*
    This action returns all of the entries in the list, in order. The array is
    the list's own, so add and remove entries with the list's actions, not
    the array's.

    Attribute: Returns An array of the list's ListItems.

    Attribute: Example
    use Libraries.Interface.Controls.List
    use Libraries.Interface.Controls.ListItem
    use Libraries.Containers.Array
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    Array<ListItem> items = fruits:GetListItems()
    */
    action GetListItems returns Array<ListItem>
        return cast(Array<ListItem>, renderer:GetChildren())
    end

    /*
    This action selects an item using first letter navigation. The incoming letters
    should be lower case only.
    */
    action SelectByFirstLetters(text firstLetters)
        Array<ListItem> items = GetListItems()
        ListItem originalSelection = selection:GetListItem()

        boolean originalFound = false
        if originalSelection = undefined
            originalFound = true
        end

        ListItem firstValid = undefined
        integer counter = 0
        repeat while counter < items:GetSize()
            ListItem current = items:Get(counter)
            if current = originalSelection
                originalFound = true
            end

            if current:GetText():ToLowerCase():StartsWith(firstLetters)
                if originalFound = true
                    current:Select()
                    return now
                elseif firstValid = undefined
                    firstValid = current
                end
            end

            counter = counter + 1
        end

        if firstValid not= undefined
            firstValid:Select()
        end
    end

    /*
    This action returns the total width of the content contained inside
    the scrollable region of this Control. If the content's width is larger
    than the width of the Control, then horizontal scrolling can be used.
    */
    action GetTotalContentWidth returns number
        // TO-DO: Optimize this so it isn't an O(n) check every time. This could be cached, if nothing else.
        number result = 0

        integer i = 0
        repeat while i < GetLineCount()
            ListItem item = GetListItem(i)
            number width = item:GetWidth()

            if width > result
                result = width
            end

            i = i + 1
        end

        return result
    end

    /*
    This action returns the total height of the content contained inside
    the scrollable region of this Control. If the content's height is larger
    than the height of the Control, then vertical scrolling can be used.
    */
    action GetTotalContentHeight returns number
        if fixedLineHeight > 0
            return fixedLineHeight * GetLineCount()
        end
        // TO-DO: Optimize this so it isn't an O(n) summation every time. This could be cached, if nothing else.
        number result = 0

        integer i = 0
        repeat while i < GetLineCount()
            // An item off screen may never have been sized; GetLineHeight
            // sizes it first, so the total counts every line.
            result = result + GetLineHeight(i)
            i = i + 1
        end

        return result
    end

    /*
    This action returns the Control that represents the main content of the
    scrollable control. This is most commonly a pane or a specialized renderer
    used to display other elements inside of it.
    */
    action GetScrollableRegion returns Control
        return renderer
    end
    
    /*
    This action returns how far the scrollable region should scroll vertically for
    a single "tick" of mouse scrolling on the y-axis. This value is returned as a
    percentage of the total content height (represented between 0 and 1).
    */
    action GetScrollIncrement returns number
        return 1.0 / GetLineCount()
    end

    /*
    This action occurs just after the scroll positions are updated and just before Resizing occurs.
    It can be used to adjust any layout properties that need to be modified on the scrollable region
    before processing a resize.
    */
    private action RefreshScrollableRegion
        renderer:RefreshContents()
    end

    /*
    This action returns the height of the requested line in pixels. This action
    is 0-indexed, so the first line of a control is line 0.

    Attribute: Parameter line The line to get the height of.
    Attribute: Returns The height of the line in pixels.
    */
    action GetLineHeight(integer line) returns number
        if line >= GetLineCount()
            return 0
        end
        // One height for all: the line is laid out when it is drawn.
        if fixedLineHeight > 0
            return fixedLineHeight
        end

        ListItem item = GetListItem(line)

        if item:GetDefaultLayoutProperties():NeedsRendering()
            item:LoadGraphics(item:GetDefaultLayoutProperties())
        end

        if item:NeedsLayout()
            item:Resize()
        end

        return item:GetHeight()
    end

    /*
    This action returns the y value of the requested line. This value is measured in pixels
    relative to the bottom of the ScrollableLineControl. Lines which are currently off the
    top of the scrolling region will return a value exceeding the control's height, and if 
    they're off the bottom of the region, this value will be negative.

    Attribute: Parameter line The requested line
    Attribute: Returns The y-position of the bottom of the line, relative to the bottom of the control.
    */
    action GetLineY(integer line) returns number
        number contentHeight = GetTotalContentHeight()

        // Rows can differ in height, so each sits below the real heights of
        // the rows above it, not the average.
        number baseY = GetHeight() - GetHeightThrough(line)
        number scrollOffset = GetScrollPercentageY() * contentHeight

        return baseY + scrollOffset
    end

    /*
    This action returns the total height of lines 0 through the given line,
    in pixels.
    */
    private action GetHeightThrough(integer line) returns number
        if fixedLineHeight > 0
            integer lines = line + 1
            if lines > GetLineCount()
                lines = GetLineCount()
            end
            if lines < 0
                lines = 0
            end
            return fixedLineHeight * lines
        end
        number result = 0
        integer i = 0
        repeat while i <= line and i < GetLineCount()
            result = result + GetLineHeight(i)
            i = i + 1
        end
        return result
    end

    /*
    This action returns how many lines are in this control.

    Attribute: Returns The total number of lines currently in this control.
    */
    action GetLineCount returns integer
        return renderer:GetItemCount()
    end

    /*
    This action returns the index of the first visible line in the scrollable control.

    Attribute: Returns The index of the first visible line.
    */
    action GetFirstVisibleLine returns integer
        if fixedLineHeight > 0
            if GetLineCount() = 0
                return 0
            end
            number scrolled = GetScrollPercentageY() * GetTotalContentHeight()
            integer first = cast(integer, scrolled / fixedLineHeight)
            if first >= GetLineCount()
                first = GetLineCount() - 1
            end
            if first < 0
                first = 0
            end
            return first
        end
        // The first line whose bottom is below the scrolled-off part.
        number offset = GetScrollPercentageY() * GetTotalContentHeight()
        number bottom = 0
        integer i = 0
        repeat while i < GetLineCount()
            bottom = bottom + GetLineHeight(i)
            if bottom > offset
                return i
            end
            i = i + 1
        end
        return 0
    end

    /*
    This action makes every line of the list one height, in pixels, so the
    list never has to lay out its lines to know how tall it is: only the
    lines on screen are laid out, as they are drawn. Use it for a list of
    one-line rows, such as files. A line taller than this overlaps the next
    one, so choose the tallest row's height. 0 measures each line again,
    the default.

    Attribute: Parameter height The height of every line, in pixels, or 0 to measure each line.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List files
    files:SetFixedLineHeight(28)
    */
    action SetFixedLineHeight(number height)
        if height < 0
            height = 0
        end
        if fixedLineHeight = height
            return now
        end
        fixedLineHeight = height
        RequestLayout()
    end

    /*
    This action returns the fixed height of every line, or 0 if each line is
    measured.

    Attribute: Returns The height in pixels, or 0.
    */
    action GetFixedLineHeight returns number
        return fixedLineHeight
    end

    /*
    This action scrolls the list so the entry at the given index is near the
    middle of the list's visible area. Select uses it to bring an entry that
    is off screen into view.

    Attribute: Parameter index The index of the entry to scroll to.

    Attribute: Example
    use Libraries.Interface.Controls.List
    List fruits
    fruits:Add("Apples")
    fruits:Add("Bananas")
    fruits:GoToItem(1)
    */
    action GoToItem(integer index)
        // ScrollPercentY = (y - (height - heightThroughLine)) / contentHeight
        number height = renderer:GetHeight()
        number contentHeight = GetTotalContentHeight()
        number targetY = height / 2.0
        number result = (targetY - (height - GetHeightThrough(index))) / contentHeight
        SetScrollPercentageY(result)
    end

end