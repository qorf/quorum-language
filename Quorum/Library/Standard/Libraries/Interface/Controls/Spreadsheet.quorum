package Libraries.Interface.Controls

use Libraries.Containers.Array
use Libraries.Containers.Support.Pair
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.Layouts.SpreadsheetLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Selections.SpreadsheetSelection
use Libraries.Interface.Behaviors.Behavior

/*
The Spreadsheet class is a control that shows a grid of text Cells, arranged
in Columns. The user can select a Cell with the mouse or move the selection
with the arrow keys, and can activate a Cell, such as by double-clicking it.
Screen readers read the Spreadsheet as a table. To fill it, make Columns,
add Cells to them, and add the Columns to the Spreadsheet.

Attribute: Author William Allee

Attribute: Example
use Libraries.Game.Game
use Libraries.Interface.Controls.Spreadsheet
use Libraries.Interface.Controls.Column
use Libraries.Interface.Controls.Cell

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        Spreadsheet sheet

        Column names
        Cell ada
        ada:SetText("Ada")
        names:Add(ada)
        Cell grace
        grace:SetText("Grace")
        names:Add(grace)
        sheet:Add(names)

        Column years
        Cell adaYear
        adaYear:SetText("1815")
        years:Add(adaYear)
        Cell graceYear
        graceYear:SetText("1906")
        years:Add(graceYear)
        sheet:Add(years)

        sheet:SetPosition(50, 50)
        Add(sheet)
        sheet:Select(0, 0)
    end
end
*/
class Spreadsheet is Control
    Array<Column> columns
    SpreadsheetSelection selection

    // The cellBehavior is called when a Cell would be activated if it doesn't
    // have an activation behavior of its own defined.
    Behavior cellBehavior = undefined
    
    on create
        SpreadsheetLayout layout
        SetLayout(layout)

        LayoutProperties properties = GetDefaultLayoutProperties()
        properties:SetHorizontalLayoutMode(properties:FIT_CONTENTS)
        properties:SetVerticalLayoutMode(properties:FIT_CONTENTS)

        SetInputGroup("Spreadsheet")

        SetFocusable(true)
        selection:Initialize(me)
        SetAccessibilityCode(parent:Item:TABLE)
        SetName("Table")
    end

    /*
    This action returns true, because a Spreadsheet is a parent for
    accessibility: screen readers treat its Cells as parts of the table.

    Attribute: Returns True, since a Spreadsheet is an accessible parent.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
    This action adds a Column to the right side of the Spreadsheet and
    connects the Column to it, so the Column's Cells can be selected.

    Attribute: Parameter column The Column to add.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    */
    action Add(Column column)
        columns:Add(column)
        column:SetSpreadsheet(me)
        parent:Item2D:Add(column)
    end

    /*
    This action adds a Column to the Spreadsheet's list of Columns at the
    given position. Position 0 is the leftmost Column. Unlike Add with only
    a Column, this action does not connect the Column to the Spreadsheet, so
    call the Column's SetSpreadsheet action as well.

    Attribute: Parameter position The index the new Column will have.

    Attribute: Parameter column The Column to add.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column years
    sheet:Add(years)
    Column names
    names:SetSpreadsheet(sheet)
    sheet:Add(0, names)
    */
    action Add(integer position, Column column)
        columns:Add(position, column)

        parent:Item2D:Add(column)
    end

    /*
    This action returns the Column at the given index. The leftmost Column
    is at index 0.

    Attribute: Parameter i The index of the Column.

    Attribute: Returns The Column at that index.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column names
    sheet:Add(names)
    Column first = sheet:GetColumn(0)
    */
    action GetColumn(integer i) returns Column
        return columns:Get(i)
    end

    /*
    This action removes the given Column, with its Cells, from the
    Spreadsheet.

    Attribute: Parameter column The Column to remove.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column names
    sheet:Add(names)
    sheet:RemoveColumn(names)
    */
    action RemoveColumn(Column column)
        columns:Remove(column)
        column:SetSpreadsheet(undefined)
        parent:Item2D:Remove(column)
    end

    /*
    This action removes the Column at the given index, with its Cells, from
    the Spreadsheet. Columns to its right move left by one.

    Attribute: Parameter column The index of the Column to remove.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column names
    sheet:Add(names)
    sheet:RemoveColumnAt(0)
    */
    action RemoveColumnAt(integer column)
        Column c = columns:RemoveAt(column)
        parent:Item2D:Remove(c)
    end

    /*
    This action returns how many Columns the Spreadsheet has.

    Attribute: Returns The number of Columns.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column names
    sheet:Add(names)
    integer columns = sheet:GetColumnsSize()
    */
    action GetColumnsSize returns integer
        return columns:GetSize()
    end

    /*
    This action returns how many rows the Spreadsheet has, which is the
    number of Cells in its longest Column.

    Attribute: Returns The number of rows.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    integer rows = sheet:GetRowsSize()
    */
    action GetRowsSize returns integer
        integer max = 0
        integer counter = 0
        repeat while counter < GetColumnsSize()
            Column column = columns:Get(counter)
            if column:GetSize() > max
                max = column:GetSize()
            end
            counter = counter + 1
        end

        return max
    end

    /*
    This action returns the Spreadsheet's selection, which says which Cell,
    if any, is selected, and at which row and column.

    Attribute: Returns The SpreadsheetSelection of this Spreadsheet.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    use Libraries.Interface.Selections.SpreadsheetSelection
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    sheet:Select(0, 0)
    SpreadsheetSelection selection = sheet:GetSelection()
    integer row = selection:GetRow()
    */
    action GetSelection returns SpreadsheetSelection
        return selection
    end

    /*
    This action returns true if the Spreadsheet has no Columns.

    Attribute: Returns True if there are no Columns.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    Spreadsheet sheet
    boolean empty = sheet:IsColumnsEmpty()
    */
    action IsColumnsEmpty returns boolean
        return columns:IsEmpty()
    end

    /*
    This action removes every Column and Cell from the Spreadsheet and
    clears the selection.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    Spreadsheet sheet
    Column names
    sheet:Add(names)
    sheet:Empty()
    */
    action Empty
        selection:Empty()
        columns:Empty()
        parent:Item2D:Empty()
    end

    /*
    This action selects a single cell in the spreadsheet.
    */
    action Select(Cell cell)
        Cell oldSelection = selection:Get()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        if cell not= undefined
            cell:GainedSelection()
        end

        selection:Set(cell)
    end

    /*
    This action selects a single Cell at the provided x and y coordinates,
    where the x coordinate represents the column and the y coordinate represents
    the row.
    */
    action Select(integer row, integer column)
        Cell oldSelection = selection:Get()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        Cell cell = GetCell(row, column)
        if cell not= undefined
            cell:GainedSelection()
        end

        selection:Set(row, column)
    end

    /*
    This action clears the selection, so no Cell is selected.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    sheet:Select(0, 0)
    sheet:Deselect()
    */
    action Deselect
        Cell oldSelection = selection:Get()
        if oldSelection not= undefined
            oldSelection:LostSelection()
        end

        selection:Empty()
    end

    /*
    This action selects the Cell just above the selected one, in the same
    Column. If the selection is already in the top row, nothing changes.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    Cell grace
    grace:SetText("Grace")
    names:Add(grace)
    sheet:Add(names)
    sheet:Select(1, 0)
    sheet:MoveSelectionUp()
    */
    action MoveSelectionUp
        integer row = selection:GetRow()
        integer column = selection:GetColumn()
        
        if row > 0
            Select(row - 1, column)
        end
    end

    /*
    This action selects the Cell just below the selected one, in the same
    Column. If the selection is already the last Cell in its Column,
    nothing changes.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    Cell grace
    grace:SetText("Grace")
    names:Add(grace)
    sheet:Add(names)
    sheet:Select(0, 0)
    sheet:MoveSelectionDown()
    */
    action MoveSelectionDown
        integer row = selection:GetRow()
        integer col = selection:GetColumn()
        
        if col >= 0 and col < columns:GetSize()
            Column column = columns:Get(col)
            if row < column:GetSize() - 1
                Select(row + 1, col)
            end
        end
    end

    /*
    This action selects the Cell just left of the selected one, in the same
    row. If the selection is already in the leftmost Column, nothing
    changes.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    Column years
    Cell year
    year:SetText("1815")
    years:Add(year)
    sheet:Add(years)
    sheet:Select(0, 1)
    sheet:MoveSelectionLeft()
    */
    action MoveSelectionLeft
        integer row = selection:GetRow()
        integer column = selection:GetColumn()

        if selection:GetColumn() > 0
            Select(row, column - 1)
        end
    end

    /*
    This action selects the Cell just right of the selected one, in the
    same row. If the selection is already in the rightmost Column, nothing
    changes.

    Attribute: Example
    use Libraries.Interface.Controls.Spreadsheet
    use Libraries.Interface.Controls.Column
    use Libraries.Interface.Controls.Cell
    Spreadsheet sheet
    Column names
    Cell ada
    ada:SetText("Ada")
    names:Add(ada)
    sheet:Add(names)
    Column years
    Cell year
    year:SetText("1815")
    years:Add(year)
    sheet:Add(years)
    sheet:Select(0, 0)
    sheet:MoveSelectionRight()
    */
    action MoveSelectionRight
        integer row = selection:GetRow()
        integer column = selection:GetColumn()
        
        if selection:GetColumn() < columns:GetSize() - 1
            Select(row, column + 1)
        end
    end

    /*
    This action returns the coordinates of a cell within the Spreadsheet within
    a Pair object. The first value of the Pair is the x coordinate, representing
    which column contains the cell. The second value of the Pair is the y
    coordinate, representing which row contains the cell.

    This action can potentially iterate over every cell in the Spreadsheet, and
    should be used sparingly if working with lots of cells.
    */
    action GetCellCoordinates(Cell cell) returns Pair<integer>
        integer col = 0
        Pair<integer> pair

        repeat while col < columns:GetSize()
            Column column = columns:Get(col)
            integer row = column:GetCellIndex(cell)
            if row > -1
                pair:Set(row, col)
                return pair
            end
            col = col + 1
        end

        // If the cell couldn't be found, return -1 for each coordinate.
        pair:Set(-1, -1)
        return pair
    end

    /*
    This action returns the index of the column within the Spreadsheet, or
    returns -1 if the column is not a part of this Spreadsheet.
    */
    action GetColumnIndex(Column column) returns integer
        return columns:GetFirstLocation(column)
    end

    /*
    This action gets the cell located at the given coordinates, specified 
    as a row and then a column.
    */
    action GetCell(integer row, integer column) returns Cell
        return columns:Get(column):GetCell(row)
    end

    /*
    This action sets the cell activation Behavior for this Spreadsheet. If a
    cell would ever be activated (such as by a double-click), if it doesn't have
    its own activation Behavior, the Spreadsheet's cell activation Behavior will
    be used instead.
    */
    action SetCellActivationBehavior(Behavior behavior)
        cellBehavior = behavior
    end

    /*
    This action returns the cell activation Behavior for this Spreadsheet. If a
    cell would ever be activated (such as by a double-click), if it doesn't have
    its own activation Behavior, the Spreadsheet's cell activation Behavior will
    be used instead.
    */
    action GetCellActivationBehavior returns Behavior
        return cellBehavior
    end

    /*

    */
    action GainedFocus(FocusEvent event)
        if selection:IsEmpty()
            if columns:IsEmpty() = false and columns:Get(0):IsEmpty() = false
                Select(0, 0)
            end
        end
        parent:Control:GainedFocus(event)
    end
end