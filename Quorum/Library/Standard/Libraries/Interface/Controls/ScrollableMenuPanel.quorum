package Libraries.Interface.Controls

use Libraries.Compute.Vector2
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Painter2D
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.DrawableView
use Libraries.Interface.Views.ControlShaderView

/*
    The ScrollableMenuPanel class is a menu panel that shows only some of its items
    at a time. It is useful for a menu with a long list of items, which might
    otherwise run off the edge of the screen. A scroll bar on the right side of the
    panel shows which part of the list is in view, and the user can drag it, use
    the mouse wheel, or move through the items with the keyboard to bring other
    items into view. The easiest way to get one is to call SetScrollable(true) on a
    PopupMenu.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Interface.Controls.PopupMenu
    use Libraries.Interface.Controls.MenuItem

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            PopupMenu menu
            // Use a ScrollableMenuPanel that shows 5 items at a time.
            menu:SetScrollable(true)
            menu:SetItemsInView(5)

            integer counter = 1
            repeat while counter <= 20
                MenuItem item
                item:SetName("Item " + counter)
                menu:Add(item)
                counter = counter + 1
            end

            menu:OpenAt(100, 400)
        end
    end
*/
class ScrollableMenuPanel is MenuPanelBlueprint

    number itemsInView = 10
    number scrollIndex = 0
    number barThickness = 20

    Control scrollBar
    Control scrollControl

    // Whether or not the scroll bar is currently being dragged with the mouse.
    boolean dragging = false

    // Whether the scroll bars have had their graphics loaded yet.
    boolean scrollGraphicsLoaded = false

    Vector2 scrollClickPoint

    on create
        SetClipping(true)
        SetCustomDrawing(true)
        SetChildrenProcessingMouseEvents(true)

        SetName("Scroll Menu Panel")
        SetInputGroup("ScrollableMenuPanel")
        SetInterfaceOptionsKey("ScrollPane")

        scrollBar:SetName("Scroll Bar")
        scrollControl:SetName("Scroll Control")

        Add(scrollBar)
        scrollBar:Add(scrollControl)
    end

    /*
        This action tells whether this panel scrolls through its items. A
        ScrollableMenuPanel always scrolls, so this always returns true.

        Attribute: Returns true, because a ScrollableMenuPanel always scrolls.
    */
    action IsScrollable returns boolean
        return true
    end

    /*
        This action draws the panel. It draws the panel's background, then only the
        items that are in view, then the scroll bar. Items that are scrolled out of
        view are skipped. This is called automatically by the Game engine each frame,
        and most users shouldn't need to call it directly.

        Attribute: Parameter painter The Painter2D used to draw the panel.
    */
    action Draw(Painter2D painter)
        if not IsShowing()
            return now
        end

        if GetView2D() not= undefined
            GetView2D():Draw(painter)
        end

        integer intIndex = cast(integer, scrollIndex)
        number last = scrollIndex + itemsInView

        if last >= GetSize()
            last = GetSize() - 1
        end

        integer counter = intIndex
        repeat while counter <= last
            MenuItem item = Get(counter)
            item:Draw(painter)
            counter = counter + 1
        end

        scrollBar:Draw(painter)
    end

    /*
        This action sets how many items the panel shows at once. The panel's height
        fits this many items, and the rest can be reached by scrolling. If the panel
        has fewer items than this, it shows all of them and hides its scroll bar. The
        default is 10.

        Attribute: Parameter itemCount How many items to show at once.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.ScrollableMenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                ScrollableMenuPanel panel
                panel:SetItemsInView(3)

                integer counter = 1
                repeat while counter <= 8
                    MenuItem item
                    item:SetName("Item " + counter)
                    panel:Add(item)
                    counter = counter + 1
                end
            end
        end
    */
    action SetItemsInView(number itemCount)
        if itemCount = itemsInView
            return now
        end

        itemsInView = itemCount
        // Setting the scroll index again triggers a resize, possibly updating
        // the index to a new value if the old value is no longer valid.
        SetScrollIndex(scrollIndex)
    end

    /*
        This action returns how many items the panel shows at once.

        Attribute: Returns How many items are shown at once.
    */
    action GetItemsInView returns number
        return itemsInView
    end

    /*
    This action returns the index of the first MenuItem visible in the scroll
    pane. This can return non-integer values to indicate the first item is
    partially offscreen -- for example, a returned value of 8.4 would indicate
    that the first visible item in the scroll pane is the 8th indexed item, and
    it is 40% of the way off of the top of the pane.

    Attribute: Returns The index of the first item visible in the scroll pane, with a decimal component describing how much of it is off the top of the panel (if any).
    */
    action GetScrollIndex returns number
        return scrollIndex
    end

    /*
        This action scrolls the panel so the item at the given index is the first one
        in view, then lays the panel out again. Index 0 is the top of the list. A value
        with a decimal part, such as 2.5, leaves the first visible item partly scrolled
        off the top. A value below 0 is treated as 0, and a value too large to fill the
        panel is pulled back so the last item sits at the bottom.

        Attribute: Parameter index The index of the item to show first.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.ScrollableMenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                ScrollableMenuPanel panel
                panel:SetItemsInView(3)

                integer counter = 1
                repeat while counter <= 8
                    MenuItem item
                    item:SetName("Item " + counter)
                    panel:Add(item)
                    counter = counter + 1
                end

                // Show Item 5, Item 6 and Item 7.
                panel:SetScrollIndex(4)
            end
        end
    */
    action SetScrollIndex(number index)
        if index < 0
            index = 0
        end
        scrollIndex = index
        Resize()
    end

    /*
        This action works out the size and position of the panel and its items. Items
        outside the current view are hidden and the ones in view are shown, each item
        is placed from the bottom of the view upward, every item is given the width of
        the widest one, and the scroll bar is sized to show how much of the list is in
        view. The panel does this itself instead of using a Layout, so that it only
        lays out the items in view. It is called automatically as needed, and most
        users shouldn't need to call it directly.
    */
    action Resize
        /*
        We manually override the Resize call here to do special work.
        This is more convenient than using a Layout because we're doing
        custom rendering on our components anyway and we want to limit the
        amount of layout work we're doing to only the relevant MenuItems.
        */

        // If we're already resizing, return immediately from a recursive call.
        if parent:Item2D:isResizing
            return now
        end

        if IsEmpty()
            return now
        end

        if scrollIndex + itemsInView > GetSize()
            scrollIndex = GetSize() - itemsInView
        end

        if scrollIndex < 0
            scrollIndex = 0
        end

        parent:Item2D:isResizing = true

        LayoutProperties containerProperties = GetDefaultLayoutProperties()

        number leftBorder = 0
        number rightBorder = 0
        number topBorder = 0
        number bottomBorder = 0

        number thickness = containerProperties:GetBorderThickness()

        if containerProperties:HasLeftBorder()
             leftBorder = thickness
        end
        if containerProperties:HasRightBorder()
            rightBorder = thickness
        end
        if containerProperties:HasTopBorder()
            topBorder = thickness
        end
        if containerProperties:HasBottomBorder()
            bottomBorder = thickness
        end

        number longestWidth = 0
        integer i = 0

        integer intIndex = cast(integer, scrollIndex)
        integer itemsToView = cast(integer, itemsInView)

        repeat while i < GetSize()
            MenuItem menuItem = Get(i)
            LayoutProperties properties = menuItem:GetDefaultLayoutProperties()

            if i < intIndex or i > scrollIndex + itemsInView
                menuItem:Hide()
            else
                menuItem:Show()
            end

            if properties:NeedsRendering()
                menuItem:LoadGraphics(properties)
            end

            if menuItem:GetIconWidth() > GetIconRegionWidth()
                SetIconRegionWidth(menuItem:GetIconWidth())
            end
            if menuItem:GetNameWidth() > GetLabelRegionWidth()
                SetLabelRegionWidth(menuItem:GetNameWidth())
            end
            if menuItem:GetShortcutWidth() > GetShortcutRegionWidth()
                SetShortcutRegionWidth(menuItem:GetShortcutWidth())
            end
            if menuItem:GetSubmenuIconWidth() > GetArrowRegionWidth()
                SetArrowRegionWidth(menuItem:GetSubmenuIconWidth())
            end

            i = i + 1
        end
 
        integer last = cast(integer, scrollIndex + itemsInView)

        if last >= GetSize()
            last = GetSize() - 1
        end

        number offset = (scrollIndex + itemsInView) - last
        if itemsInView > GetSize()
            offset = 1
        end

        MenuItem lastItem = Get(last)
        lastItem:Resize()

        if longestWidth < lastItem:GetWidth()
            longestWidth = lastItem:GetWidth()
        end

        number y = -(1 - offset) * lastItem:GetHeight()
        lastItem:SetPosition(leftBorder, y)
        y = y + lastItem:GetHeight()

        number largestHeight = 0

        if GetSize() = 1
            MenuItem kid = Get(0)
            kid:Resize()
            longestWidth = kid:GetWidth()
            kid:SetPosition(leftBorder, y - kid:GetHeight())
            largestHeight = kid:GetHeight()
        else
            i = last
            repeat while i > intIndex
                i = i - 1
                MenuItem kid = Get(i)
                kid:Resize()
    
                if longestWidth < kid:GetWidth()
                    longestWidth = kid:GetWidth()
                end
    
                kid:SetPosition(leftBorder, y)
    
                y = y + kid:GetHeight()
    
                if kid:GetHeight() > largestHeight
                    largestHeight = kid:GetHeight()
                end
            end
        end

        // Set the size of the menu panel to fit the items in view, and adjust the position so the top remains in the same place.
        number oldHeight = GetHeight()

        repeat while i < GetSize()
            Item2D kid = Get(i)
            kid:SetWidth(longestWidth)
            i = i + 1
        end

        scrollBar:SetPosition(longestWidth, 0)
        scrollBar:SetSize(barThickness, GetHeight())

        number controlRatio = itemsInView / GetSize()
        if controlRatio >= 1.0
            SetSize(longestWidth + leftBorder + rightBorder, largestHeight * GetSize())

            scrollControl:Hide()
            scrollBar:Hide()
        else
            SetSize(longestWidth + leftBorder + rightBorder + barThickness, bottomBorder + topBorder + largestHeight * itemsInView)

            scrollControl:Show()
            scrollBar:Show()

            scrollControl:SetSize(barThickness, GetHeight() * controlRatio)
            scrollControl:SetPosition(0, GetHeight() * (GetSize() - (scrollIndex + itemsInView)) / GetSize())
        end

        SetY(-GetHeight())

        /*
        We need to reset our layout flag to indicate we don't need resizing
        until more changes occur, and reset our resizing flag to allow future calls.
        */
        ResetLayoutFlag()
        parent:Item2D:isResizing = false
    end

    /*
        This action is used to load the graphical components of the panel, including
        the views for the scroll bar and the part of it that is dragged, and colors
        them from the panel's foreground and accent colors. This is handled
        automatically by the Game engine as needed, and most users shouldn't need to
        use this action directly.

        Attribute: Parameter properties The layout properties to load the graphics with.
    */
    action LoadGraphics(LayoutProperties properties)
        if scrollGraphicsLoaded = false
            ControlShaderView scrollBarView
            ControlShaderView scrollControlView

            scrollBarView:Initialize()
            scrollControlView:Initialize()

            scrollBar:SetView2D(scrollBarView)
            scrollControl:SetView2D(scrollControlView)
        end

        scrollBar:SetBackgroundColor(GetForegroundColor())
        scrollControl:SetBackgroundColor(GetAccentColor())

        scrollGraphicsLoaded = true
        parent:MenuPanelBlueprint:LoadGraphics(properties)
    end

    /*
    This action returns true if the user is currently dragging the scroll bar
    with the mouse, or false otherwise.

    Attribute: Returns Whether or not the scroll bar is being dragged with the mouse.
    */
    action IsDragging returns boolean
        return dragging
    end

    /*
        This action sets whether the user is dragging the scroll bar with the mouse.
        The panel's mouse behaviors set it to true when the user presses on the panel
        and to false when they let go, and DragScrollControlTo only scrolls while it is
        true.

        Attribute: Parameter drag true if the scroll bar is being dragged, or false if not.
    */
    action SetDragging(boolean drag)
        dragging = drag
    end

    /*
        This action records the point where the user pressed the mouse to start
        dragging the scroll bar. DragScrollControlTo measures each mouse movement from
        this point.

        Attribute: Parameter x The x coordinate of the point, in pixels.

        Attribute: Parameter y The y coordinate of the point, in pixels.
    */
    action SetScrollClickPoint(number x, number y)
        scrollClickPoint:Set(x, y)
    end

    /*
        This action returns the point recorded by SetScrollClickPoint, where the
        current drag of the scroll bar is measured from.

        Attribute: Returns The point the current drag is measured from.
    */
    private action GetScrollClickPoint returns Vector2
        return scrollClickPoint
    end

    /*
        This action scrolls the panel to follow the mouse while the user drags the
        scroll bar. It moves the view by how far the mouse has moved up or down since
        the last drag point, then records the new point. Dragging past the top of the
        bar shows the start of the list, and dragging past the bottom shows the end.
        It does nothing unless IsDragging returns true. The panel's mouse behaviors
        call it, so most users shouldn't need to call it directly.

        Attribute: Parameter x The x coordinate of the mouse, in pixels. Only the y coordinate affects the scrolling.

        Attribute: Parameter y The y coordinate of the mouse, in pixels.
    */
    action DragScrollControlTo(number x, number y)
        if not IsDragging()
            return now
        end

        number offset = y - scrollClickPoint:GetY()
        if scrollControl:GetY() + scrollControl:GetHeight() + offset > scrollBar:GetHeight()
            SetScrollIndex(0)
        elseif scrollControl:GetY() + offset <= 0
            SetScrollIndex(GetSize() - itemsInView)
        else
            number value = (1.0 - ((scrollControl:GetY() + offset) / (GetHeight() - scrollControl:GetHeight()))) * (GetSize() - itemsInView)
            SetScrollIndex(value)
        end

        scrollClickPoint:SetY(y)
    end

    /*
        This action scrolls the panel just far enough to bring the given item into
        view. If the item is above the view, it becomes the first item shown. If it is
        below the view, it becomes the last item shown. If it is already in view, or
        is not in this panel, nothing changes. A PopupMenu calls this when the
        selection moves, so the selected item is always visible.

        Attribute: Parameter item The MenuItem to bring into view.

        Attribute: Example
        use Libraries.Game.Game
        use Libraries.Interface.Controls.ScrollableMenuPanel
        use Libraries.Interface.Controls.MenuItem

        class Main is Game
            action Main
                StartGame()
            end

            action CreateGame
                ScrollableMenuPanel panel
                panel:SetItemsInView(3)

                MenuItem last = undefined
                integer counter = 1
                repeat while counter <= 8
                    MenuItem item
                    item:SetName("Item " + counter)
                    panel:Add(item)
                    last = item
                    counter = counter + 1
                end

                panel:ScrollToView(last)
            end
        end
    */
    action ScrollToView(MenuItem item)
        integer index = parent:MenuPanelBlueprint:menuItems:GetFirstLocation(item)
        if index < 0
            return now
        end

        if index < scrollIndex
            SetScrollIndex(index)
        elseif index + 1 > scrollIndex + itemsInView
            SetScrollIndex(index + 1 - itemsInView)
        end
    end
end