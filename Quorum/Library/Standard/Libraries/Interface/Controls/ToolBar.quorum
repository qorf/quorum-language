package Libraries.Interface.Controls

use Libraries.Game.Graphics.Gradient
use Libraries.Game.Graphics.Color
use Libraries.Interface.Item
use Libraries.Interface.Item2D
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.LabelBoxView
use Libraries.Interface.Views.ControlShaderView

/*
The ToolBar class is a strip of controls, usually buttons, along the top
of a window. It places its controls in a row with a FlowLayout, fills the
full width of its container, and is 30 pixels tall by default. Screen
readers present it as a toolbar that groups the controls inside it.

Attribute: Author William Allee

Attribute: Example

use Libraries.Game.Game
use Libraries.Interface.Item2D
use Libraries.Interface.Controls.ToolBar
use Libraries.Interface.Controls.Button

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        ToolBar toolbar
        Button open
        open:SetName("Open")
        Button save
        save:SetName("Save")
        toolbar:Add(open)
        toolbar:Add(save)
        Add(toolbar)
    end
end
*/
class ToolBar is Control
    on create
        SetFocusable(true)
        SetName("Toolbar")

        FlowLayout toolbarLayout
        SetLayout(toolbarLayout)

        LayoutProperties toolbarProperties = GetDefaultLayoutProperties()
        toolbarProperties:SetHorizontalLayoutMode(toolbarProperties:STANDARD)
        toolbarProperties:SetVerticalLayoutMode(toolbarProperties:STANDARD)
        toolbarProperties:SetPercentageWidth(1)
        toolbarProperties:SetPixelHeight(30)
        SetAccessibilityCode(parent:Item:TOOLBAR)
        SetInputGroup("ToolBar")
        SetInterfaceOptionsKey("ToolBar")
    end

    /*
        This action returns true, which tells accessibility tools that a ToolBar
        is a parent of the controls inside it. Screen readers can then present
        the buttons on the bar as one group.

        Attribute: Returns True, since a ToolBar groups the controls it holds.
    */
    action IsAccessibleParent returns boolean
        return true
    end

    /*
        This action adds an item to the ToolBar. A button or other control on a
        ToolBar shows a tooltip by default, since a toolbar's buttons are often
        only icons; call SetTooltipEnabled(false) on it after adding it to turn
        that off.

        Attribute: Parameter newItem The item to add.

        Attribute: Example
        use Libraries.Interface.Controls.ToolBar
        use Libraries.Interface.Controls.Button

        ToolBar toolbar
        Button open
        open:SetName("Open")
        open:SetDescription("Opens a file")
        toolbar:Add(open)
    */
    action Add(Item2D newItem)
        EnableTooltip(newItem)
        LinkFocus(newItem)
        parent:Control:Add(newItem)
    end

    /*
        This action adds an item to the ToolBar at a position among its items. A
        control added this way shows a tooltip by default, as with Add.

        Attribute: Parameter index Where the item goes, counting from 0.
        Attribute: Parameter newItem The item to add.

        Attribute: Example
        use Libraries.Interface.Controls.ToolBar
        use Libraries.Interface.Controls.Button

        ToolBar toolbar
        Button open
        open:SetName("Open")
        open:SetDescription("Opens a file")
        toolbar:Add(0, open)
    */
    action Add(integer index, Item2D newItem)
        EnableTooltip(newItem)
        LinkFocus(newItem)
        parent:Control:Add(index, newItem)
    end

    /*
        This action sets the item that gets the focus after the ToolBar. Tab
        moves there from the ToolBar or from any control on it, unless that
        control has been given a next item of its own.

        Attribute: Parameter nextItem The item to focus after the ToolBar.
    */
    action SetNextFocus(Item nextItem)
        Item oldNext = GetNextFocus()
        parent:Item:SetNextFocus(nextItem)
        integer i = 0
        repeat while i < GetItemCount()
            Item2D child = GetItem(i)
            if IsSameItem(child:GetNextFocus(), oldNext)
                child:SetNextFocus(nextItem)
            end
            i = i + 1
        end
    end

    /*
        This action sets the item that gets the focus before the ToolBar.
        Shift+Tab moves there from the ToolBar or from any control on it, unless
        that control has been given a previous item of its own.

        Attribute: Parameter previousItem The item to focus before the ToolBar.
    */
    action SetPreviousFocus(Item previousItem)
        Item oldPrevious = GetPreviousFocus()
        parent:Item:SetPreviousFocus(previousItem)
        integer i = 0
        repeat while i < GetItemCount()
            Item2D child = GetItem(i)
            if IsSameItem(child:GetPreviousFocus(), oldPrevious)
                child:SetPreviousFocus(previousItem)
            end
            i = i + 1
        end
    end

    // Returns true if both items are undefined, or both are the same item.
    private action IsSameItem(Item first, Item second) returns boolean
        if first = undefined
            return second = undefined
        end
        if second = undefined
            return false
        end
        return first:Equals(second)
    end

    // Gives an added control the ToolBar's next and previous items, so Tab and
    // Shift+Tab leave the ToolBar from it. Links the control already has are kept.
    private action LinkFocus(Item2D item)
        if item:GetNextFocus() = undefined
            item:SetNextFocus(GetNextFocus())
        end
        if item:GetPreviousFocus() = undefined
            item:SetPreviousFocus(GetPreviousFocus())
        end
    end

    private action EnableTooltip(Item2D item)
        if item is Control
            Control control = cast(Control, item)
            control:SetTooltipEnabled(true)
        end
    end

    /*
        This action loads the graphics for the ToolBar. It gives the bar a
        ControlShaderView, which draws its background and border, and then lets
        Control finish loading. The game engine calls this as needed, so most
        users won't need to call it directly.

        Attribute: Parameter properties The LayoutProperties used to draw the ToolBar.
    */
    action LoadGraphics(LayoutProperties properties)
        ControlShaderView view
        view:Initialize()
        SetView2D(view)

        parent:Control:LoadGraphics(properties)
    end
end
