package Libraries.Interface.Controls

use Libraries.Containers.Array

/*
The TreeTableRow class is one row of a TreeTable. A row can hold other rows
under it, which the TreeTable shows indented below it while the row is
open. The row keeps track of its child rows, its parent row, the TreeTable
it belongs to, whether it is open, and how deep it is in the hierarchy. A
TreeTableRow holds no values of its own: a program usually makes its own
row class that stores the row's information, and its column classes read
that information in their SetCell action to fill in each cell.

Attribute: Author William Allee

Attribute: Example

// In the file FileRow.quorum:
use Libraries.Interface.Controls.TreeTableRow

class FileRow is TreeTableRow
    text fileName = ""

    action SetFileName(text value)
        fileName = value
    end

    action GetFileName returns text
        return fileName
    end
end

// In the file NameColumn.quorum:
use Libraries.Interface.Controls.TreeTableColumn
use Libraries.Interface.Controls.TreeTableCell
use Libraries.Interface.Controls.TreeTableRow

class NameColumn is TreeTableColumn
    action CreateCell returns TreeTableCell
        TreeTableCell cell
        return cell
    end

    action SetCell(integer index, TreeTableRow row)
        if row is FileRow
            FileRow file = cast(FileRow, row)
            GetCell(index):SetText(file:GetFileName())
        end
    end
end

// In the file Main.quorum:
use Libraries.Interface.Controls.TreeTable
use Libraries.Game.Game

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        TreeTable table
        NameColumn names
        table:Add(names)

        FileRow folder
        folder:SetFileName("Scripts")
        FileRow script
        script:SetFileName("Main.quorum")
        folder:AddRow(script)
        table:Add(folder)

        table:SetPosition(50, 300)
        Add(table)
        table:ExpandRow(folder)
    end
end
*/
class TreeTableRow
    
    TreeTableRow parentRow = undefined
    TreeTable parentTable = undefined
    Array<TreeTableRow> children
    boolean expanded = false

    // How far down a tree hierarchy this is. A top-level TreeRow has a depth
    // of 0, its children have a depth of 1, and so on.
    // Used for padding elements.
    integer treeDepth = 0

    /*
    This action returns true if this row has no child rows.

    Attribute: Returns True if the row has no child rows, false otherwise.
    */
    action IsEmpty returns boolean
        return children:IsEmpty()
    end

    /*
    This action returns how many child rows have been added directly to this
    row. Rows under those children are not counted.

    Attribute: Returns The number of child rows of this row.
    */
    action GetSize returns integer
        return children:GetSize()
    end

    /*
    This action returns true if this row is open in its TreeTable, so its child
    rows are shown below it.

    Attribute: Returns True if the row is open, false if it is closed.
    */
    action IsExpanded returns boolean
        return expanded
    end

    /*
    This action is used internally to allow the TreeTableRow to track whether or
    not it is currently expanded inside a TreeTable. This action is called
    automatically as necessary by the TreeTable and shouldn't be called manually
    by users.
    */
    action SetExpandFlag(boolean expand)
        expanded = expand
    end

    /*
    This action returns how deep this row is in the hierarchy. A top-level row
    has a depth of 0, its children have a depth of 1, and so on. The first
    column uses it to indent a row's cell.

    Attribute: Returns The depth of this row, starting at 0 for a top-level row.
    */
    action GetTreeDepth returns integer
        return treeDepth
    end

    /*
    This action adds a row as a child of this row, after its other children.
    If this row is already in a TreeTable and is open, the TreeTable shows the
    new row right away; otherwise it appears when this row is opened.

    Attribute: Parameter row The row to add under this row.

    Attribute: Example
    use Libraries.Interface.Controls.TreeTable
    use Libraries.Interface.Controls.TreeTableRow
    TreeTable table
    TreeTableRow folder
    TreeTableRow file
    folder:AddRow(file)
    table:Add(folder)
    */
    action AddRow(TreeTableRow row)
        children:Add(row)
        row:SetParent(me)
        
        if parentTable not= undefined
            parentTable:Add(row, me, children:GetSize() - 1)
        end
    end

    /*
    This action is called automatically by the TreeTable when removing a row from
    the tree. This action alone does not fully remove a row from a TreeTable
    */
    action RemoveRow(TreeTableRow row)
        children:Remove(row)
        row:SetParent(undefined)
    end

    /*
    This action sets a reference to the parent TreeTableRow. It is called 
    automatically when a TreeTableRow is added as a child to another item. 
    Most users will not need to use this action directly.
    */
    action SetParent(TreeTableRow item)
        parentRow = item

        if item = undefined
            treeDepth = 0
        else
            TreeTableRow parentRow = cast(TreeTableRow, item)
            treeDepth = parentRow:GetTreeDepth() + 1
        end
    end

    /*
    This action returns the row this row was added to, or undefined if this is
    a top-level row.

    Attribute: Returns The parent row, or undefined.
    */
    action GetParent returns TreeTableRow
        return parentRow
    end

    /*
    This action returns the array of rows added directly to this row. The
    array is the row's own, not a copy. If it is changed, call the TreeTable's
    Refresh action so the table shows the change.

    Attribute: Returns The child rows of this row.
    */
    action GetChildren returns Array<TreeTableRow>
        return children
    end

    /*
    This action sets a reference to the TreeTable that this TreeTableRow is a
    part of. This is called automatically by the system as needed, and shouldn't
    be called directly.
    */
    action SetParentTreeTable(TreeTable parentTreeTable)
        parentTable = parentTreeTable
    end

    /*
    This action returns the TreeTable this row belongs to, or undefined if it
    hasn't been added to one.

    Attribute: Returns The TreeTable holding this row, or undefined.
    */
    action GetParentTreeTable returns TreeTable
        return parentTable
    end
end