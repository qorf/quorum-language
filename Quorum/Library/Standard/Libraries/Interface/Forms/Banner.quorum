package Libraries.Interface.Forms

use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.ColorGroup
use Libraries.Interface.Events.FocusEvent

/*

    This class represents a banner which is a grouping of a title and subtitle. 
    It provides a generic banner template that can be added to a page easily.

    Attribute: Author Andreas Stefik

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Forms.Banner

    class Main
        action Main
            // create the app
            Form form
            Page homePage = form:GetMainPage() 
            
            Banner banner
            banner:Initialize("Hello World", "Today is a great day!")
            homePage:Add(banner)

            form:Display()
        end
    end
*/
class Banner is Grouping

    Label label = undefined

    // Whether the banner's background reaches the screen's edges when it is
    // the first item on its page (SetExtendToScreenEdges).
    boolean extendToScreenEdges = false

    on create
        CenterAlignTitle()
        CenterAlignContent()
        SetTitleSizeLarge()

        SetInterfaceOptionsKey("Banner")
    end

    /*
        The SetExtendToScreenEdges action sets whether this banner's
        background reaches the edges of the screen when the banner is the
        first item on its page and the page keeps its content in the display's
        safe region (see Layer:SetUseSafeRegion). The background then fills
        the space behind a camera cutout, such as the Dynamic Island on an
        iPhone, while the banner's text stays in the safe region below it. It
        is off by default.

        Attribute: Parameter enabled True to stretch the banner's background to the screen's edges.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                Form form
                Page homePage = form:GetMainPage()

                Banner banner = homePage:AddBanner("Hello World", "Today is a great day!")
                banner:SetExtendToScreenEdges(true)

                form:Display()
            end
        end
    */
    action SetExtendToScreenEdges(boolean enabled)
        extendToScreenEdges = enabled
        RequestLayout()
    end

    /*
        The ExtendsToScreenEdges action returns whether this banner's
        background reaches the screen's edges (see SetExtendToScreenEdges).

        Attribute: Returns True if the banner stretches to the screen's edges.
    */
    action ExtendsToScreenEdges returns boolean
        return extendToScreenEdges
    end
    /*
        This action sets up and fills in the banners title.

        Attribute: Parameter title The text title in the banner grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 
                
                Banner banner
                banner:Initialize("Hello World")

                homePage:Add(banner)
                output banner:GetTitle()

                form:Display()
            end
        end
    */
    action Initialize(text title)
        Initialize(title, "")
    end
    /*
        This action sets up and fills in the banners title and subtitle.

        Attribute: Parameter title The text title in the banner grouping.
        Attribute: Parameter label The text label (subtitle) in the banner grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 
                
                Banner banner
                banner:Initialize("Hello World", "Today is a great day!")

                homePage:Add(banner)
                output banner:GetTitle()

                form:Display()
            end
        end
    */
    action Initialize(text title, text label)
        SetTitle(title)
        if label not= ""
            me:label = AddLabel(title + " Label", label)
        end
    end
    /*
        This action sets the subtitle of the banner grouping.

        Attribute: Parameter value The text subtitle to set in the banner grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 
                
                Banner banner
                banner:Initialize("Hello World")
                banner:SetSubtitle("Today is a great day!")

                homePage:Add(banner)
                output banner:GetSubtitle()

                form:Display()
            end
        end
    */
    action SetSubtitle(text value)
        Label label = GetLabel()
        if label not= undefined 
            label:SetText(value) 
        else
            me:label = AddLabel(GetTitle() + " Label", value)
        end
    end
    /*
        This action gets the subtitle of the banner grouping and returns undefined it the subtitle is not found.

        Attribute: Returns The text subtitle on the banner grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 
                
                Banner banner
                banner:Initialize("Hello World")
                banner:SetSubtitle("Today is a great day!")

                homePage:Add(banner)
                output banner:GetSubtitle()

                form:Display()
            end
        end
    */
    action GetSubtitle returns text
        Label label = GetLabel()
        if label not= undefined 
            return label:GetText() 
        end
        return undefined
    end
    /*
        This action gets the subtitle label object on the banner grouping.

        Attribute: Returns The Label object subtitle on the banner grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Banner

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 
                
                Banner banner
                banner:Initialize("Hello World")
                banner:SetSubtitle("Today is a great day!")

                homePage:Add(banner)
                output banner:GetLabel():GetText()

                form:Display()
            end
        end
    */
    action GetLabel returns Label
        return label
    end

    action GainedFocus(FocusEvent event)
        Label title = GetTitleLabel()
        if title not= undefined
            title:Focus()
        end
    end
end