package Libraries.Interface.Forms
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Controls.RadioButton
use Libraries.Containers.Array
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.ToggleButton
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Item2D
use Libraries.Game.Graphics.ColorGroup
use Libraries.Game.GameStateManager
use Libraries.Interface.Options.InterfaceOptions
use Libraries.Interface.Forms.FormRowSeparator
use Libraries.Interface.Events.FocusEvent

/*

    This class represents a grouping of elements and is a form container control. 
    This class provides a generic grouping for positioning and controlling 
    page elements. These elements include elements that are optionally grouped 
    (e.g., Buttons, Labels, Text Boxes) or required to be grouped (e.g., Toggle Buttons, Radio Buttons).

    Attribute: Author Andreas Stefik, William Allee

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Forms.Grouping
    class Main
        action Main

            Form form
            Page homePage = form:GetMainPage() 

            Grouping toggleGroup = homePage:AddGrouping("switch")
            toggleGroup:AddToggleButton("On")
            toggleGroup:AddToggleButton("Off")

            toggleGroup:SelectNext()  
            
            form:Display()
        end
    end

*/
class Grouping is FormContainerControl, ButtonGroup

    // Set by the form's layout when this card rises into a banner above it,
    // so its heading takes the banner's text color.
    boolean overlappingBanner = false

    on create
        SetVerticalLayoutMode(parent:Control:FIT_CONTENTS)
        SetInterfaceOptionsKey("Grouping")
        // Titles read as section headings (FormRowLayout). Banners set their
        // own, larger size.
        FormConstants formConstants
        SetTitleFontSize(formConstants:SMALL_FONT_SIZE)
    end
    /*
        An integer constant used to indicate the top position in the grouping.
    */
    public constant integer TOP_POSITION = 0
    /*
        An integer constant used to indicate the bottom position in the grouping.
    */
    public constant integer BOTTOM_POSITION = 1
    /*
        An integer constant used to indicate the center position in the grouping.
    */
    public constant integer CENTER_POSITION = 2

    integer verticalPosition = TOP_POSITION
    integer columns = 0
    
    boolean isUsingCustomLayout = false

    /*
    How FormRowLayout draws this grouping: plain (no background of its own),
    as a card behind its rows, as a page's footer (a line above it), or as a
    subsection inside a card. The layout sets it; programs don't need to.
    */
    public constant integer PLAIN_STYLE = 0
    public constant integer CARD_STYLE = 1
    public constant integer FOOTER_STYLE = 2
    public constant integer SUBSECTION_STYLE = 3
    // A grouping of only choices beside a label, drawn as a shaded track (G3).
    public constant integer CHOICE_STYLE = 4
    constant number CHOICE_ROUNDING = 8

    // The group's 3-point left line while one of its choices has the focus
    // (G3), like a focused text field's.
    boolean choiceFocus = false
    constant number CHOICE_FOCUS_THICKNESS = 3
    integer drawStyle = PLAIN_STYLE
    // In a footer, how many of the first buttons sit at the left.
    integer leadingButtonCount = 0

    // How round a card's corners are, in points before the interface scale.
    constant number CARD_ROUNDING = 8

    // The thin lines between a card's rows, made as FormRowLayout needs them.
    Array<FormRowSeparator> rowSeparators

    action SetDrawStyle(integer style)
        if drawStyle = style
            return now
        end
        drawStyle = style
        LayoutProperties properties = GetDefaultLayoutProperties()
        if style = FOOTER_STYLE
            SetBorderStyle(properties:TOP)
        else
            SetBorderStyle(properties:ALL)
        end
        if style not= CARD_STYLE
            HideRowSeparatorsFrom(0)
        end
        RequestVerticesUpdate()
    end

    action GetDrawStyle returns integer
        return drawStyle
    end

    /*
    This action sets how many of this grouping's first buttons sit at the
    left when the grouping is a page's footer (an untitled grouping of
    buttons placed at the bottom). The rest sit at the right. Use it for a
    button like Back, which goes apart from Cancel and OK. The default is 0.

    Attribute: Parameter count How many of the first buttons go at the left.

    Attribute: Example
    use Libraries.Interface.Forms.Form
    use Libraries.Interface.Forms.Page
    use Libraries.Interface.Forms.Grouping

    Form form
    Page page = form:GetMainPage()
    Grouping footer = page:AddGrouping("Buttons")
    footer:AddButton("Back")
    footer:AddButton("Cancel")
    footer:AddButton("Create")
    footer:PositionFromBottom()
    footer:SetLeadingButtonCount(1)
    form:Display()
    */
    action SetLeadingButtonCount(integer count)
        leadingButtonCount = count
    end

    /*
    This action returns how many of this grouping's first buttons sit at the
    left when the grouping is a page's footer.

    Attribute: Returns How many of the first buttons go at the left.
    */
    action GetLeadingButtonCount returns integer
        return leadingButtonCount
    end

    /*
        For radio buttons: sets whether one of this group's choices has the
        focus, which draws the group's left line (G3).

        Attribute: Parameter focused True while a choice in this group has the focus.
    */
    action SetChoiceFocus(boolean focused)
        choiceFocus = focused
        if focused
            SetBorderStyle(GetDefaultLayoutProperties():LEFT)
        else
            SetBorderStyle(GetDefaultLayoutProperties():ALL)
        end
        RequestVerticesUpdate()
    end

    // A group of radio buttons takes the focus itself (G3): its left line,
    // and the selected button's circle edge and underline.
    action GainedFocus(FocusEvent event)
        parent:ButtonGroup:GainedFocus(event)
        if GetSize() > 0
            SetChoiceFocus(true)
            RefreshChoiceButtons()
        end
    end

    action LostFocus(FocusEvent event)
        parent:Control:LostFocus(event)
        if GetSize() > 0
            SetChoiceFocus(false)
            RefreshChoiceButtons()
        end
    end

    private action RefreshChoiceButtons
        Array<ToggleButton> choices = GetButtons()
        integer index = 0
        repeat while index < choices:GetSize()
            if choices:Get(index) is RadioButton
                RadioButton radio = cast(RadioButton, choices:Get(index))
                radio:RefreshChoiceFocus()
            end
            index = index + 1
        end
    end

    action GetBackgroundColor returns ColorGroup
        if drawStyle = CHOICE_STYLE and not HasColorPropertyOverride("backgroundColor")
            ColorGroup track = GetStyleOptions():GetBackgroundColor("ChoiceGroup")
            if track not= undefined
                return track
            end
        end
        if drawStyle = CARD_STYLE and not HasColorPropertyOverride("backgroundColor")
            ColorGroup card = GetStyleOptions():GetBackgroundColor("FormCard")
            if card not= undefined
                return card
            end
        end
        return parent:Control:GetBackgroundColor()
    end

    action GetBorderColor returns ColorGroup
        if choiceFocus
            ColorGroup focusLine = GetStyleOptions():GetFocusBorderColor("RadioButton")
            if focusLine not= undefined
                return focusLine
            end
        end
        if drawStyle = FOOTER_STYLE and not HasColorPropertyOverride("borderColor")
            ColorGroup line = GetStyleOptions():GetBorderColor("FormFooter")
            if line not= undefined
                return line
            end
        end
        return parent:Control:GetBorderColor()
    end

    action GetBorderThickness returns number
        if choiceFocus
            return CHOICE_FOCUS_THICKNESS
        end
        if not HasNumberPropertyOverride("borderThickness")
            if drawStyle = CARD_STYLE or drawStyle = CHOICE_STYLE
                return 0
            elseif drawStyle = FOOTER_STYLE
                return 1
            end
        end
        return parent:Control:GetBorderThickness()
    end

    action GetTopLeftPixelRounding returns number
        if drawStyle = CARD_STYLE
            return CARD_ROUNDING
        end
        if drawStyle = CHOICE_STYLE
            return CHOICE_ROUNDING
        end
        return parent:Control:GetTopLeftPixelRounding()
    end

    action GetTopRightPixelRounding returns number
        if drawStyle = CARD_STYLE
            return CARD_ROUNDING
        end
        if drawStyle = CHOICE_STYLE
            return CHOICE_ROUNDING
        end
        return parent:Control:GetTopRightPixelRounding()
    end

    action GetBottomLeftPixelRounding returns number
        if drawStyle = CARD_STYLE
            return CARD_ROUNDING
        end
        if drawStyle = CHOICE_STYLE
            return CHOICE_ROUNDING
        end
        return parent:Control:GetBottomLeftPixelRounding()
    end

    action GetBottomRightPixelRounding returns number
        if drawStyle = CARD_STYLE
            return CARD_ROUNDING
        end
        if drawStyle = CHOICE_STYLE
            return CHOICE_ROUNDING
        end
        return parent:Control:GetBottomRightPixelRounding()
    end

    private action GetStyleOptions returns InterfaceOptions
        GameStateManager gameState
        return gameState:GetInterfaceOptions()
    end

    /*
    Returns the separator line with this index, making it (and any before it)
    if it doesn't exist yet. FormRowLayout positions them between a card's
    rows.
    */
    action GetRowSeparator(integer index) returns FormRowSeparator
        repeat while rowSeparators:GetSize() <= index
            FormRowSeparator separator
            rowSeparators:Add(separator)
            parent:Item2D:Add(separator)
        end
        FormRowSeparator result = rowSeparators:Get(index)
        result:Show()
        return result
    end

    // Hides the separator lines from this index on.
    action HideRowSeparatorsFrom(integer index)
        integer counter = index
        repeat while counter < rowSeparators:GetSize()
            rowSeparators:Get(counter):Hide()
            counter = counter + 1
        end
    end

    /*
    The children FormRowLayout lays out: all of them except the row separator
    lines.
    */
    action GetLayoutChildren returns Array<Item2D>
        Array<Item2D> result
        Array<Item2D> children = GetChildren()
        integer counter = 0
        repeat while counter < children:GetSize()
            if not (children:Get(counter) is FormRowSeparator)
                result:Add(children:Get(counter))
            end
            counter = counter + 1
        end
        return result
    end

    /*
    This action adds a grouping inside this grouping. A titled grouping
    inside another draws as a subsection of the outer one's card; an untitled
    one is a row of its own children (see FormRowLayout).

    Attribute: Parameter name The name of the new grouping.
    Attribute: Returns The new grouping.
    */
    action AddGrouping(text name) returns Grouping
        Grouping grouping
        grouping:SetForm(GetForm())
        grouping:SetName(name)
        grouping:SetSkipLabelsInFocus(GetSkipLabelsInFocus())
        Add(grouping)
        return grouping
    end

    action LoadGraphics(LayoutProperties properties)
        if GetView2D() = undefined
            ControlShaderView view
            view:Initialize()
            SetView2D(view)
        end

        parent:Control:LoadGraphics(properties)
    end
    /*
        This action positions the grouping at the vertical top of the form.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                toggleGroup:AddToggleButton("Off")

                toggleGroup:PositionFromTop() 
                
                form:Display()
            end
        end
    */
    action PositionFromTop
        SetVerticalPosition(TOP_POSITION)
    end
    /*
        This action positions the grouping at the vertical center of the form.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                toggleGroup:AddToggleButton("Off")

                toggleGroup:PositionFromCenter() 
                
                form:Display()
            end
        end
    */
    action PositionFromCenter
        SetVerticalPosition(CENTER_POSITION)
    end
    /*
        This action positions the grouping at the vertical bottom of the form.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                toggleGroup:AddToggleButton("Off")

                toggleGroup:PositionFromBottom() 
                
                form:Display()
            end
        end
    */
    action PositionFromBottom
        SetVerticalPosition(BOTTOM_POSITION)
    end
    /*
        This action gets the vertical position of the grouping on the form.

        Attribute: Returns The integer represents the vertical position of the Grouping. This 
        value should be compared to the position constants (e.g., BOTTOM_POSITION, TOP_POSITION, CENTER_POSITION).

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                toggleGroup:AddToggleButton("Off")

                output toggleGroup:GetVerticalPosition()
                
                form:Display()
            end
        end
    */
    action GetVerticalPosition returns integer
        return verticalPosition
    end
    /*
        This action sets the vertical position of the grouping on the form.

        Attribute: Parameter verticalPosition The integer represents the vertical position of the Grouping (e.g., BOTTOM_POSITION, TOP_POSITION, CENTER_POSITION).

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                toggleGroup:AddToggleButton("Off")

                toggleGroup:SetVerticalPosition(toggleGroup:CENTER_POSITION)
                
                form:Display()
            end
        end
    */
    action SetVerticalPosition(integer verticalPosition)
        me:verticalPosition = verticalPosition
        RequestLayout()
    end
    /*
        This action adds a toggle button to the grouping.

        Attribute: Parameter name The text represents the identifier of the toggle button.
        Attribute: Returns The toggle button object that was added to the grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.ToggleButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                ToggleButton off = toggleGroup:AddToggleButton("Off")
                
                form:Display()
            end
        end
    */
    action AddToggleButton(text name) returns ToggleButton
        ToggleButton button
        button:SetName(name)
        button:SetToDefaultFontSize()
        //button:SetHorizontalLayoutMode(button:parent:Control:STANDARD)
        //button:SetVerticalLayoutMode(button:parent:Control:STANDARD)

        AddToGrouping(button)
        Add(button)
        return button
    end    
    /*
        This action removes the toggle button with the matching name (identifier) from the grouping.

        Attribute: Parameter name The text represents the identifier of the toggle button.
        Attribute: Returns The toggle button object that was removed from the grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.ToggleButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping toggleGroup = homePage:AddGrouping("switch")
                toggleGroup:AddToggleButton("On")
                ToggleButton off = toggleGroup:AddToggleButton("Off")

                toggleGroup:RemoveToggleButton(off:GetName())

                form:Display()
            end
        end
    */
    action RemoveToggleButton(text name) returns ToggleButton
        ToggleButton button = GetToggleButton(name)
        if button not= undefined
            Remove(button)
            RemoveFromGrouping(button)
            return button
        end
        alert("I couldn't find a ToggleButton named " + name + ". Are you looking for the right item?")
    end
    /*
        This action adds a radio button to the grouping.

        Attribute: Parameter name The text represents the identifier of the radio button.
        Attribute: Returns The radio button object that was added to the grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.RadioButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping radioGroup = homePage:AddGrouping("switch")
                radioGroup:AddRadioButton("On")
                RadioButton off = radioGroup:AddRadioButton("Off")
                
                form:Display()
            end
        end
    */
    action AddRadioButton(text name) returns RadioButton
        RadioButton button
        button:SetName(name)
        button:SetToDefaultFontSize()

        AddToGrouping(button)
        Add(button)
        return button
    end    
    /*
        This action removes the radio button with the matching name (identifier) from the grouping.

        Attribute: Parameter name The text represents the identifier of the radio button.
        Attribute: Returns The radio button object that was removed from the grouping.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.RadioButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping radioGroup = homePage:AddGrouping("switch")
                radioGroup:AddRadioButton("On")
                RadioButton off = radioGroup:AddRadioButton("Off")

                radioGroup:RemoveRadioButton(off:GetName())
                
                form:Display()
            end
        end
    */
    action RemoveRadioButton(text name) returns RadioButton
        RadioButton button = GetRadioButton(name)
        if button not= undefined
            Remove(button)
            RemoveFromGrouping(button)
            return button
        end
        alert("I couldn't find a RadioButton named " + name + ". Are you looking for the right item?")
    end
    /*
        This action gets the number of columns in the grouping. A grouping has a default of 0 columns.

        Attribute: Returns The integer represents the number of columns in the grouping

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.RadioButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping radioGroup = homePage:AddGrouping("switch")
                radioGroup:AddRadioButton("On")
                RadioButton off = radioGroup:AddRadioButton("Off")

                output radioGroup:GetColumns()
                radioGroup:SetColumns(1)
                output radioGroup:GetColumns()

                form:Display()
            end
        end
    */    
    action GetColumns returns integer
        return columns
    end
    /*
        This action sets the number of columns in the grouping. This allows each element in 
        the grouping to be arranged into visual columns. A grouping has a default of 0 columns.

        Attribute: columns The integer represents the number of columns to arrange the elements in the grouping into.

        Attribute: Example
        use Libraries.Interface.Forms.Form
        use Libraries.Interface.Forms.Page
        use Libraries.Interface.Forms.Grouping
        use Libraries.Interface.Controls.RadioButton

        class Main
            action Main
                // create the app
                Form form
                Page homePage = form:GetMainPage() 

                Grouping radioGroup = homePage:AddGrouping("switch")
                radioGroup:AddRadioButton("On")
                RadioButton off = radioGroup:AddRadioButton("Off")

                output radioGroup:GetColumns()
                radioGroup:SetColumns(1)
                output radioGroup:GetColumns()

                form:Display()
            end
        end
    */
    action SetColumns(integer columns)
        me:columns = columns
    end

    /*
        Get the Item2D elements from the grouping.

        Attribute: Parameter Array<Item2D> the form children.
    */
    action GetFormChildren returns Array<Item2D>
        return GetChildren()
    end
    
    action SetLayout(Layout layout)
        isUsingCustomLayout = true
        parent:Control:SetLayout(layout)
    end
    
    /*
        Returns if this Grouping is handling the layout of its children on its own or by the 
        form's layout.

        Attribute: Returns boolean true if a custom layout has been set, false otherwise.
    */
    action IsUsingCustomLayout returns boolean
        return me:isUsingCustomLayout
    end
    

    /*
        For the form's layout: sets whether this card rises into a banner
        above it (Banner:SetOverlapNextCard).

        Attribute: Parameter overlapping True if the card overlaps a banner.
    */
    action SetOverlappingBanner(boolean overlapping)
        overlappingBanner = overlapping
    end

    /*
        This action returns whether this card rises into a banner above it.

        Attribute: Returns True if the card overlaps a banner.
    */
    action IsOverlappingBanner returns boolean
        return overlappingBanner
    end
end
