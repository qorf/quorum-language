package Libraries.Interface.Layouts

use Libraries.Containers.Array
use Libraries.Interface.Item2D
use Libraries.Interface.Controls.Control
use Libraries.Interface.Forms.FormContainerControl
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Forms.Banner
use Libraries.Game.Graphics.Font
use Libraries.Interface.Controls.ScrollPaneRendererAnchor
use Libraries.Interface.Forms.FormConstants
use Libraries.Game.Graphics.Label
use Libraries.Interface.Controls.Tree
use Libraries.Game.Layer2D
use Libraries.Game.GameStateManager
use Libraries.Game.GameDisplay
use Libraries.Game.Shapes.Rectangle
use Libraries.Containers.HashTable
use Libraries.Game.Graphics.Glyph
use Libraries.Game.Graphics.ColorGroup
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.ToggleButton
use Libraries.Interface.Controls.RadioButton
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Forms.FormRowSeparator

class FormRowLayout is Layout

    // Default values for the layout. These will likely be moved elsewhere as the design matures.

    // How wide each row is, as a percentage of the screen, by default. Any space not taken by the width is applied as padding (half on the left, half on the right)
    constant number DEFAULT_ROW_PERCENTAGE_WIDTH = 0.8

    // Sizes in points, before the interface scale.
    // The space between items in a row (A6).
    constant number IN_ROW_GAP = 12
    // A text field with no width of its own is at most this wide (A3).
    constant number MAX_FIELD_WIDTH = 480
    // A label and its control share a row (A8) when the space is at least
    // this wide and the label fits in this share of it.
    constant number ROW_LAYOUT_MIN_WIDTH = 400
    constant number ROW_LABEL_SHARE = 0.45
    // A text field's width beside its label, when it has none of its own.
    constant number ROW_FIELD_WIDTH = 160
    // A field holding more characters than this goes under its label at full
    // width instead (a file path, for example).
    constant integer LONG_FIELD_TEXT = 24
    // Cards (A7): padding inside on the left and right, and above and below
    // each row.
    constant number CARD_PADDING = 12
    constant number CARD_ROW_PADDING = 6
    // The space between choices stacked top to bottom.
    constant number CHOICE_STACK_GAP = 4
    // Footer buttons are at least this wide (A5).
    constant number MIN_FOOTER_BUTTON_WIDTH = 88

    // Labels currently drawn as captions above their field (A2), so they go
    // back to normal when there is room for a row again.
    HashTable<Label, Label> captionLabels

    constant integer TOP_AREA = 0
    constant integer BOTTOM_AREA = 1
    constant integer CENTER_AREA = 2

    // Items are separated into three sets, based on whether they're positioned from the top, center, or bottom.
    Array<Array<Item2D>> areaItems
    Array<number> areaHeights

    FormConstants constants

    on create
        integer i = 0
        repeat while i < 3
            Array<Item2D> items
            areaItems:Add(items)
            i = i + 1
        end

        areaHeights:SetSize(3)
    end

    action Layout(Control parentControl, Array<Item2D> childItems, number containerWidth, number containerHeight)
        FormContainerControl container = undefined

        number minimumResultHeight = containerHeight

        if parentControl is FormContainerControl
            container = cast(FormContainerControl, parentControl)
        elseif parentControl is ScrollPaneRendererAnchor
            ScrollPaneRendererAnchor anchor = cast(ScrollPaneRendererAnchor, parentControl)
            container = cast(FormContainerControl, cast(Object, anchor:GetScrollPane()))
            minimumResultHeight = container:GetHeight()
        end
        
        integer titleAlignment = container:GetTitleAlignment()
        integer contentAlignment = container:GetContentAlignment()

        if contentAlignment = constants:DEFAULT_ALIGN
            contentAlignment = constants:CENTER_ALIGN
        end
        if titleAlignment = constants:DEFAULT_ALIGN
            titleAlignment = contentAlignment
        end

        Font containerFont = container:GetDefaultFont():Copy()
        containerFont:SetSize(constants:LARGE_FONT_SIZE)

        number defaultRowWidth = DEFAULT_ROW_PERCENTAGE_WIDTH * containerWidth
        number defaultRowStartX = (containerWidth - defaultRowWidth) / 2.0
        number defaultRowEndX = defaultRowStartX + defaultRowWidth
        number scale = container:GetInterfaceScale()
        number defaultInRowPadding = IN_ROW_GAP * scale
        number defaultRowHeight = containerFont:GetLineHeight()
        number defaultRowVerticalPadding = cast(integer, defaultRowHeight * 0.4)

        // Reset the area arrays to defaults before assigning items to them.
        integer counter = 0
        repeat while counter < 3
            areaItems:Get(counter):Empty()
            areaHeights:Set(counter, 0)
            counter = counter + 1
        end
        
        // Separate items into their areas.
        counter = 0
        repeat while counter < childItems:GetSize()
            Item2D item = childItems:Get(counter)
            
            if item is Grouping
                Grouping group = cast(Grouping, item)
                if group:GetVerticalPosition() = group:BOTTOM_POSITION
                    areaItems:Get(BOTTOM_AREA):Add(group)
                elseif group:GetVerticalPosition() = group:CENTER_POSITION
                    areaItems:Get(CENTER_AREA):Add(group)
                else
                    areaItems:Get(TOP_AREA):Add(group)
                end
            else
                // By default, everything is positioned from the top.
                areaItems:Get(TOP_AREA):Add(item)
            end

            counter = counter + 1
        end

        integer areaCounter = 0
        repeat while areaCounter < areaItems:GetSize()
            Array<Item2D> items = areaItems:Get(areaCounter)

            integer i = 0
            number rowTopY = containerHeight - defaultRowHeight
            // The bottom area (such as a footer) has no space above its
            // first row: the areas' heights add up to the page's height, so
            // that space would make a page that fits scroll anyway.
            if areaCounter = BOTTOM_AREA
                rowTopY = containerHeight
            end
            repeat while i < items:GetSize()
                Item2D item = items:Get(i)
                boolean isTitle = (i = 0 and container:GetTitle() not= "")
                boolean isGrouping = (item is Grouping)
        
                integer currentAlignment = contentAlignment
                if isTitle
                    currentAlignment = titleAlignment
                end
    
                boolean groupNeedsLayout = true
                boolean isFooter = false
                boolean isCard = false
                if isGrouping
                    Grouping group = cast(Grouping, item)
                    if group:IsUsingCustomLayout()
                        groupNeedsLayout = false
                    else
                        isFooter = IsFooter(group)
                        isCard = not isFooter and IsCard(group)
                    end
                end

                if isFooter
                    rowTopY = LayoutFooter(cast(Grouping, item), rowTopY, containerWidth, defaultRowStartX, defaultRowEndX, defaultRowVerticalPadding, containerHeight, containerFont)
                elseif isCard
                    Grouping cardGroup = cast(Grouping, item)
                    number cardWidth = defaultRowWidth
                    if cardGroup:GetPixelWidth() not= 0 or cardGroup:GetPercentageWidth() not= 0
                        cardWidth = cardGroup:GetPixelWidth() + containerWidth * cardGroup:GetPercentageWidth()
                    end
                    rowTopY = LayoutCard(cardGroup, (containerWidth - cardWidth) / 2.0, cardWidth, rowTopY, defaultRowVerticalPadding, containerHeight, containerFont)
                elseif item is Label and not isTitle and PairsWithNextOnPage(items, i)
                    // A label and the field after it (A2, A8).
                    Label pairLabel = cast(Label, item)
                    Control pairControl = cast(Control, items:Get(i + 1))
                    FormRow pairRow = BuildPairRow(pairLabel, pairControl, defaultRowWidth, defaultRowVerticalPadding, containerHeight, containerFont)
                    PlaceRow(pairRow, defaultRowStartX, rowTopY - pairRow:height, defaultRowWidth, defaultRowVerticalPadding)
                    rowTopY = rowTopY - pairRow:height - defaultRowVerticalPadding
                    // The control was laid out with its label.
                    i = i + 1
                elseif isGrouping and groupNeedsLayout
                    // An untitled grouping (or one with columns) keeps the
                    // old layout, with no card.
                    Grouping plainGroup = cast(Grouping, item)
                    plainGroup:SetDrawStyle(plainGroup:PLAIN_STYLE)
                    // If the item is a group, layout its title on a row, if it has one, then place all following children on a single row.
                    Grouping group = cast(Grouping, item)
    
                    if group:GetDefaultLayoutProperties():NeedsRendering()
                        group:LoadGraphics(group:GetDefaultLayoutProperties())
                    end

                    Array<Item2D> groupItems = group:GetLayoutChildren()
                    integer j = 0
    
                    number groupTitleHeightOffset = 0

                    // The numberOfRowItems is how many items go into each row.
                    // The totalItemsInRows is the number of items across all of the rows (i.e. how many items there are other other than the title)
                    integer numberOfRowItems = group:GetColumns()
                    integer totalItemsInRows = groupItems:GetSize()

                    if group:GetTitle() not= ""
                        // The title doesn't contribute to the number of elements in rows, because it's handled as its own special case.
                        totalItemsInRows = totalItemsInRows - 1
                    end
                    
                    // If there aren't a set number of columns, everything goes in one row, so the number of row items and total items is the same.
                    if numberOfRowItems <= 0
                        numberOfRowItems = totalItemsInRows
                    end
    
                    number rowWidth = defaultRowWidth
                    if group:GetPixelWidth() not= 0 or group:GetPercentageWidth() not= 0
                        rowWidth = group:GetPixelWidth() + containerWidth * group:GetPercentageWidth()
                    end

                    number elementWidth = (rowWidth - defaultInRowPadding * (numberOfRowItems - 1)) / numberOfRowItems

                    // Groupings can separate elements into multiple rows if there's more elements than columns.
                    // We'll need to track which elements are in which row, and what the height of each row is.
                    Array<Array<Item2D>> groupRowItems
                    Array<number> groupRowHeights
                    number totalRowHeights = 0

                    // Figure out how many rows it takes to store our items. If the division has a remainder, then we have an additional, partially-filled row
                    integer rowCount = 0
                    if numberOfRowItems > 0
                        rowCount = totalItemsInRows / numberOfRowItems
                        if totalItemsInRows mod numberOfRowItems not= 0
                            rowCount = rowCount + 1
                        end
                    end

                    // Initialize the row arrays.
                    repeat rowCount times
                        Array<Item2D> rowItemArray
                        groupRowItems:Add(rowItemArray)
                        groupRowHeights:Add(0)
                    end

                    // Now that the potential title has been handled, handle the content that shares the rows.
                    // Unfortunately, we have to iterate quickly through the elements to determine the tallest in each row.
                    integer k = 0
                    integer titleIndexingOffset = 0

                    // Skip the title, if there is one
                    if group:GetTitle() not= ""
                        k = k + 1
                        titleIndexingOffset = 1
                    end

                    repeat while k < groupItems:GetSize()
                        integer rowArrayIndex = (k - titleIndexingOffset) / numberOfRowItems
                        Array<Item2D> rowItemArray = groupRowItems:Get(rowArrayIndex)
                        rowItemArray:Add(groupItems:Get(k))

                        if groupItems:Get(k) is Control
                            Control control = cast(Control, groupItems:Get(k))
                            Font font = control:GetFont()
                            if font = undefined
                                font = containerFont:Copy()
                            else
                                font = font:Copy()
                            end
        
                            font:SetSize(cast(integer, control:GetFontSize() * control:GetInterfaceScale()))
        
                            number height = font:GetLineHeight()
        
                            if control:GetPixelHeight() not= 0 or control:GetPercentageHeight() not= 0
                                height = control:GetPixelHeight() + containerHeight * control:GetPercentageHeight()
                            end
        
                            height = height * control:GetLayoutRows() + (control:GetTopPadding() + control:GetBottomPadding()) * control:GetInterfaceScale()

                            // As a special case, if the grouping contains only 1 item per row, allow controls to set themselves to use a percentage of the width, if they request it.
                            if numberOfRowItems = 1 and control:GetPercentageWidth() > 0 and control:GetHorizontalLayoutMode() not= control:MAINTAIN_ASPECT_RATIO
                                
                                if control is Label
                                    Label label = cast(Label, control)
                                    label:SetMaximumWidth(cast(integer, elementWidth * control:GetPercentageWidth()))
                                end
                                
                                control:SetSize(cast(integer, elementWidth * control:GetPercentageWidth()), cast(integer, height))

                            // If the control is trying to maintain an aspect ratio, do our best to respect that.
                            elseif control:GetHorizontalLayoutMode() = control:MAINTAIN_ASPECT_RATIO and control:GetPercentageWidth() > 0
                                number idealWidth = height * control:GetPercentageWidth()

                                if idealWidth <= elementWidth
                                    control:SetSize(cast(integer, idealWidth), cast(integer, height))
                                else
                                    control:SetSize(cast(integer, elementWidth), cast(integer, elementWidth / control:GetPercentageWidth()))
                                end
                            else
                                if control is Label
                                    Label label = cast(Label, control)
                                    label:SetMaximumWidth(cast(integer, elementWidth))
                                end
                                
                                control:SetSize(cast(integer, elementWidth), cast(integer, height))
                            end

                            // Set the height to match the Control's actual height.
                            // This might differ from what we expected if the Control has its own special height calculations, e.g. a multi-line Label.
                            height = control:GetHeight()

                            if height > groupRowHeights:Get(rowArrayIndex)
                                groupRowHeights:Set(rowArrayIndex, height)
                            end
                        end

                        k = k + 1
                    end

                    k = 0
                    repeat while k < groupRowHeights:GetSize()
                        if groupRowHeights:Get(k) <= 0
                            groupRowHeights:Set(k, defaultRowHeight)
                        end

                        totalRowHeights = totalRowHeights + groupRowHeights:Get(k)

                        // If there's more than one row, we need to also include the padding between rows.
                        if k > 0
                            totalRowHeights = totalRowHeights + defaultRowVerticalPadding
                        end

                        k = k + 1
                    end

                    if group:GetPixelHeight() not= 0 or group:GetPercentageHeight() not= 0
                        number calcHeight = group:GetPixelHeight() + containerHeight * group:GetPercentageHeight()
                        if calcHeight > totalRowHeights
                            totalRowHeights = calcHeight
                        end
                    end

                    number bannerPadding = 0

                    // How far a banner that extends to the screen's edges
                    // reaches past the page: the safe region's insets.
                    number bannerLeft = 0
                    number bannerRight = 0
                    number bannerTop = 0
                    if group is Banner and i = 0 and areaCounter = 0 and parentControl is FormContainerControl
                        Banner banner = cast(Banner, group)
                        Layer2D layer = parentControl:GetLayer()
                        if banner:ExtendsToScreenEdges() and layer not= undefined and layer:UsesSafeRegion()
                            Rectangle region = layer:GetContentRegion()
                            GameStateManager gameManager
                            GameDisplay display = gameManager:GetGameDisplay()
                            bannerLeft = region:GetX()
                            bannerRight = display:GetWidth() - region:GetX() - region:GetWidth()
                            bannerTop = display:GetHeight() - region:GetY() - region:GetHeight()
                        end
                    end

                    // The title gets its own row, if there is one.
                    if group:GetTitle() not= ""
                        currentAlignment = group:GetTitleAlignment()
    
                        if currentAlignment = constants:DEFAULT_ALIGN
                            currentAlignment = titleAlignment
                        end
    
                        Control control = cast(Control, groupItems:Get(0))
                        if control:GetDefaultLayoutProperties():NeedsRendering()
                            control:LoadGraphics(control:GetDefaultLayoutProperties())
                        end
                        
                        if control is Label
                            Label label = cast(Label, control)
                            label:SetMaximumWidth(rowWidth)
                        end
    
                        // The label's width and height are known quantities. There's nothing to set, so just fetch them now.
                        number width = control:GetWidth()
                        number height = control:GetHeight()
        
                        number x = 0
                        if currentAlignment = constants:LEFT_ALIGN
                            if width > rowWidth
                                x = (rowWidth - width) / 2.0
                            else
                                x = 0
                            end
                        elseif currentAlignment = constants:CENTER_ALIGN
                            x = (rowWidth - width) / 2.0
                        elseif currentAlignment = constants:RIGHT_ALIGN
                            if width > rowWidth
                                x = (rowWidth - width) / 2.0
                            else
                                x = rowWidth - width
                            end
                        end

                        // We need to offset the title of a Banner since it'll stretch all the way left-to-right, and we'd like a little extra space at the bottom
                        if group is Banner
                            x = x + (containerWidth - rowWidth) / 2 + bannerLeft
                            bannerPadding = defaultRowVerticalPadding
                        end
        
                        groupTitleHeightOffset = rowTopY
                        number y = rowTopY - height - bannerPadding
                        
                        number labelMultiLineOffset = 0
                        if control is Label
                            Label label = cast(Label, control)
                            if label:GetLineCount() > 1
                                labelMultiLineOffset = label:GetLineHeight() * (label:GetLineCount() - 1)
                            end
                        end
        
                        // If the title is the only item in the grouping, there won't be a row beneath it, so it doesn't need to be pushed further up.
                        if groupItems:GetSize() = 1
                            control:SetPosition(x, defaultRowVerticalPadding + bannerPadding + labelMultiLineOffset)
                        else
                            control:SetPosition(x, totalRowHeights + defaultRowVerticalPadding + bannerPadding + labelMultiLineOffset)
                        end
        
                        rowTopY = y - defaultRowVerticalPadding
                        groupTitleHeightOffset = groupTitleHeightOffset - rowTopY
    
                        j = j + 1
                    end
    
                    currentAlignment = group:GetContentAlignment()
    
                    if currentAlignment = constants:DEFAULT_ALIGN
                        currentAlignment = contentAlignment
                    end
    
                    number groupX = 0
                    if currentAlignment = constants:LEFT_ALIGN
                        if rowWidth > defaultRowWidth
                            x = (containerWidth - rowWidth) / 2.0
                        else
                            x = defaultRowStartX
                        end
                    elseif currentAlignment = constants:CENTER_ALIGN
                        x = (containerWidth - rowWidth) / 2.0
                    elseif currentAlignment = constants:RIGHT_ALIGN
                        if rowWidth > defaultRowWidth
                            x = (containerWidth - rowWidth) / 2.0
                        else
                            x = defaultRowEndX - rowWidth
                        end
                    end
    
                    // If there's no content besides the title, the rowHeight won't contribute to the height
                    // of the group beyond what's already calculated in the groupTitleHeightOffset
                    number contentRowHeight = totalRowHeights
                    if j = 1 and j = groupItems:GetSize()
                        contentRowHeight = 0
                    end
                    

                    // Banners have special rules about their positioning. They always stretch the whole width of their container.
                    // Their positioning info is actually used to offset the children within them.
                    if group is Banner
                        number bannerY = rowTopY - contentRowHeight
                        number bannerHeight = contentRowHeight + groupTitleHeightOffset
                        if bannerTop > 0 or bannerLeft > 0 or bannerRight > 0
                            // Up to the top of the screen, over the gap above
                            // the first row too.
                            bannerHeight = containerHeight + bannerTop - bannerY
                        end
                        group:SetSize(containerWidth + bannerLeft + bannerRight, bannerHeight)
                        group:SetPosition(-bannerLeft, bannerY)
                    else
                        group:SetSize(rowWidth, contentRowHeight + groupTitleHeightOffset)
                        group:SetPosition((containerWidth - rowWidth) / 2, rowTopY - contentRowHeight)
                    end
    
                    rowTopY = rowTopY - contentRowHeight - defaultRowVerticalPadding
  
                    integer subRowCounter = groupRowItems:GetSize()
                    number previousRowHeights = 0
                    repeat while subRowCounter > 0
                        subRowCounter = subRowCounter - 1
                        Array<Item2D> currentRowItems = groupRowItems:Get(subRowCounter)
                        number currentRowHeight = groupRowHeights:Get(subRowCounter)

                        number elementX = 0

                        if group is Banner
                            elementX = (containerWidth - rowWidth) / 2 + bannerLeft
                        end

                        integer rowItemCounter = 0
                        repeat while rowItemCounter < currentRowItems:GetSize()
                            if currentRowItems:Get(rowItemCounter) is Control
                                Control control = cast(Control, currentRowItems:Get(rowItemCounter))
                                if control:GetDefaultLayoutProperties():NeedsRendering()
                                    control:LoadGraphics(control:GetDefaultLayoutProperties())
                                end
        
                                control:SetPosition(cast(integer, elementX + (elementWidth - control:GetWidth()) / 2.0), cast(integer, (currentRowHeight - control:GetHeight()) / 2.0) + bannerPadding + previousRowHeights)
    
                                elementX = elementX + elementWidth + defaultInRowPadding
                            end
        
                            rowItemCounter = rowItemCounter + 1
                        end

                        previousRowHeights = previousRowHeights + currentRowHeight + defaultRowVerticalPadding
                    end
    
                elseif item is Control
                    Control control = cast(Control, item)
                    if control:GetDefaultLayoutProperties():NeedsRendering()
                        control:LoadGraphics(control:GetDefaultLayoutProperties())
                    end
    
                    number width = defaultRowWidth
                    if control:GetPixelWidth() not= 0 or control:GetPercentageWidth() not= 0
                        width = control:GetPixelWidth() + containerWidth * control:GetPercentageWidth()
                    elseif control is TextField and width > MAX_FIELD_WIDTH * scale
                        // A field with no width of its own isn't wider than
                        // its text could need (A3).
                        width = MAX_FIELD_WIDTH * scale
                    end

                    Font font = control:GetFont()
                    if font = undefined
                        font = containerFont:Copy()
                    else
                        font = font:Copy()
                    end

                    font:SetSize(cast(integer, control:GetFontSize() * control:GetInterfaceScale()))
                    number height = font:GetLineHeight()

                    if height <= 0
                        height = defaultRowHeight
                    end

                    if control:GetPixelHeight() not= 0 or control:GetPercentageHeight() not= 0
                        height = control:GetPixelHeight() + containerHeight * control:GetPercentageHeight()
                    end

                    height = height * control:GetLayoutRows() + (control:GetTopPadding() + control:GetBottomPadding()) * control:GetInterfaceScale()
    
                    if control:GetHorizontalLayoutMode() = control:MAINTAIN_ASPECT_RATIO
                        width = height * control:GetPercentageWidth()
                    elseif control:GetVerticalLayoutMode() = control:MAINTAIN_ASPECT_RATIO
                        height = width * control:GetPercentageHeight()
                    end

                    if control is Label
                        Label label = cast(Label, control)
                        label:SetMaximumWidth(width)
                    end
                    
                    control:SetSize(width, height)

                    // Set the height to match the Control's actual height.
                    // This might differ from what we expected if the Control has its own special height calculations, e.g. a multi-line Label.
                    height = control:GetHeight()
    
                    /*
                    Reassign the width and height based on the "real" width and height, which might differ from our request based on
                    the control's own ability to lay itself out during the resize. For example, Labels will entirely ignore our height
                    request, as they strictly derive their height from their text and how many lines the text requires.
                    */
                    width = control:GetWidth()
    
                    number x = 0
                    if control is Tree and currentAlignment not= constants:RIGHT_ALIGN
                        /*
                        A tree's width is its widest open item, so centering
                        it would move it sideways each time an item opens or
                        closes. It stays at the row's left edge instead, moved
                        in only as far as needed to stay on screen.
                        */
                        x = defaultRowStartX
                        if x + width > containerWidth
                            x = containerWidth - width
                        end
                        if x < 0
                            x = 0
                        end
                    elseif currentAlignment = constants:LEFT_ALIGN
                        if width > defaultRowWidth
                            x = (containerWidth - width) / 2.0
                        else
                            x = defaultRowStartX
                        end
                    elseif currentAlignment = constants:CENTER_ALIGN
                        x = (containerWidth - width) / 2.0
                    elseif currentAlignment = constants:RIGHT_ALIGN
                        if width > defaultRowWidth
                            x = (containerWidth - width) / 2.0
                        else
                            x = defaultRowEndX - width
                        end
                    end
    
                    number y = rowTopY - height
    
                    control:SetPosition(x, y)

                    rowTopY = y - defaultRowVerticalPadding
                end
    
                i = i + 1
            end

            /*
            The height can be determined from how far we've traveled away from the top of the container.
            */
            number areaHeight = containerHeight - rowTopY
            // An empty area takes no room.
            if items:IsEmpty()
                areaHeight = 0
            end

            areaHeights:Set(areaCounter, areaHeight)
            areaCounter = areaCounter + 1
        end

        number resultHeight = containerHeight
        number newContainerHeightOffset = 0

        // If the container is depending on us to figure out the height, use our calculated heights instead of assuming the containerHeight is trustworthy.
        if parentControl:GetVerticalLayoutMode() = parentControl:FIT_CONTENTS
            resultHeight = areaHeights:Get(TOP_AREA) + areaHeights:Get(CENTER_AREA) + areaHeights:Get(BOTTOM_AREA)
            if resultHeight < minimumResultHeight
                resultHeight = minimumResultHeight
            end

            // This is how much each item needs to be moved to maintain positions relative to the new top of the control.
            newContainerHeightOffset = resultHeight - parentControl:GetHeight()

            // Set the parent control to match the new height, if it isn't already.
            if parentControl:GetHeight() not= resultHeight
                parentControl:SetHeight(resultHeight)
            end
        end

        // After setting the regions, the top set only needs to move if the height of the container changed.
        if newContainerHeightOffset not= 0
            Array<Item2D> topItems = areaItems:Get(TOP_AREA)
            integer i = 0
            repeat while i < topItems:GetSize()
                Item2D item = topItems:Get(i)
                item:MoveY(newContainerHeightOffset)
                i = i + 1
            end
        end

        
        // The bottom and center areas need adjusting regardless of whether or not the container height changed.
        Array<Item2D> bottomItems = areaItems:Get(BOTTOM_AREA)
        integer i = 0
        number bottomOffset = newContainerHeightOffset - cast(integer, resultHeight - areaHeights:Get(BOTTOM_AREA))
        repeat while i < bottomItems:GetSize()
            Item2D item = bottomItems:Get(i)
            item:MoveY(bottomOffset)
            i = i + 1
        end

        // Finally position the center items between the top and bottom areas.
        Array<Item2D> centerItems = areaItems:Get(CENTER_AREA)
        i = 0
        number centerTarget = (resultHeight - areaHeights:Get(TOP_AREA) + areaHeights:Get(BOTTOM_AREA)) / 2.0
        number centerOfItems = resultHeight - areaHeights:Get(CENTER_AREA) / 2.0
        number centerOffset = newContainerHeightOffset - cast(integer, centerOfItems - centerTarget)
        repeat while i < centerItems:GetSize()
            Item2D item = centerItems:Get(i)
            item:MoveY(centerOffset)
            i = i + 1
        end
    end


    // Whether a grouping is a page's footer (A5): from the bottom, untitled,
    // and holding only plain buttons.
    private action IsFooter(Grouping group) returns boolean
        if group is Banner or group:GetTitle() not= "" or group:GetVerticalPosition() not= group:BOTTOM_POSITION
            return false
        end
        Array<Item2D> children = group:GetLayoutChildren()
        if children:IsEmpty()
            return false
        end
        integer index = 0
        repeat while index < children:GetSize()
            Item2D child = children:Get(index)
            if not (child is Button) or child is ToggleButton
                return false
            end
            index = index + 1
        end
        return true
    end

    // Whether a grouping draws as a card (A7): titled, not a banner, and not
    // laid out in set columns.
    private action IsCard(Grouping group) returns boolean
        return group:GetTitle() not= "" and not (group is Banner) and group:GetColumns() <= 0
    end

    // At the page level, a label pairs with a following text field or text box.
    private action PairsWithNextOnPage(Array<Item2D> items, integer index) returns boolean
        if index + 1 >= items:GetSize()
            return false
        end
        Item2D next = items:Get(index + 1)
        if next is TextField or next is TextBox
            return true
        end
        // A field with buttons beside it, such as a path and Browse (L1).
        if next is Grouping
            Grouping nextGroup = cast(Grouping, next)
            return nextGroup:GetTitle() = "" and not nextGroup:IsUsingCustomLayout() and HasField(nextGroup)
        end
        return false
    end

    // Whether an untitled grouping has a text field or text box in it.
    private action HasField(Grouping group) returns boolean
        Array<Item2D> children = group:GetLayoutChildren()
        integer index = 0
        repeat while index < children:GetSize()
            Item2D child = children:Get(index)
            if child is TextField or child is TextBox
                return true
            end
            index = index + 1
        end
        return false
    end

    /*
    A button's width at its words' size: the words plus the button's
    padding, at least MIN_FOOTER_BUTTON_WIDTH.
    */
    private action NaturalButtonWidth(Button button, Font fallback) returns number
        number scale = button:GetInterfaceScale()
        button:SetAutomaticFontSizing(false)
        text words = button:GetDefaultLayoutProperties():GetLabelText()
        number buttonWidth = MeasureText(button, words, fallback) + (button:GetLeftPadding() + button:GetRightPadding()) * scale
        if buttonWidth < MIN_FOOTER_BUTTON_WIDTH * scale
            buttonWidth = MIN_FOOTER_BUTTON_WIDTH * scale
        end
        return buttonWidth
    end

    // Inside a card, a label also pairs with an untitled grouping, or with a
    // control the program gave a fixed width.
    private action PairsWithNextInCard(Array<Item2D> items, integer index) returns boolean
        if index + 1 >= items:GetSize()
            return false
        end
        Item2D next = items:Get(index + 1)
        if next is TextField or next is TextBox
            return true
        end
        if next is Grouping
            Grouping nextGroup = cast(Grouping, next)
            return nextGroup:GetTitle() = "" and not nextGroup:IsUsingCustomLayout()
        end
        if next is Control and not (next is Label) and not (next is ToggleButton)
            Control nextControl = cast(Control, next)
            return nextControl:GetPixelWidth() > 0
        end
        return false
    end

    // Radio and toggle buttons are choices. Checkboxes are not; they list one
    // per row.
    private action IsChoice(Item2D item) returns boolean
        return item is RadioButton or (item is ToggleButton and not (item is Checkbox))
    end

    // Whether every item from first on is a choice (and there is at least one).
    private action AllChoices(Array<Item2D> items, integer first) returns boolean
        if items:GetSize() <= first
            return false
        end
        integer scanIndex = first
        repeat while scanIndex < items:GetSize()
            if not IsChoice(items:Get(scanIndex))
                return false
            end
            scanIndex = scanIndex + 1
        end
        return true
    end

    /*
    A choice's width at its words' size: its round icon (about a line
    high), the margins around the icon and words (4 and 8 points, from
    RadioButton), its padding, and its words.
    */
    private action ChoiceWidth(Control choice, Font fallback) returns number
        number scale = choice:GetInterfaceScale()
        Font font = choice:GetFont()
        if font = undefined
            font = fallback:Copy()
        else
            font = font:Copy()
        end
        font:SetSize(cast(integer, choice:GetFontSize() * scale))
        text words = choice:GetDefaultLayoutProperties():GetLabelText()
        return MeasureText(choice, words, fallback) + font:GetLineHeight()
            + (12 + choice:GetLeftPadding() + choice:GetRightPadding()) * scale
    end

    /*
    The choices from first on as one row, each at its own width, or
    undefined if together they're wider than the row.
    */
    private action ChoiceRow(Array<Item2D> items, integer first, number width, number containerHeight, Font fallback) returns FormRow
        Control firstChoice = cast(Control, items:Get(first))
        number gapWidth = IN_ROW_GAP * firstChoice:GetInterfaceScale()
        Array<number> choiceWidths
        number total = 0
        integer measureIndex = first
        repeat while measureIndex < items:GetSize()
            number measuredWidth = ChoiceWidth(cast(Control, items:Get(measureIndex)), fallback)
            choiceWidths:Add(measuredWidth)
            total = total + measuredWidth
            if measureIndex > first
                total = total + gapWidth
            end
            measureIndex = measureIndex + 1
        end
        if total > width
            return undefined
        end

        FormRow choiceRow
        choiceRow:kind = choiceRow:INLINE
        integer placeIndex = first
        repeat while placeIndex < items:GetSize()
            Control choice = cast(Control, items:Get(placeIndex))
            number placedWidth = choiceWidths:Get(placeIndex - first)
            number choiceHeight = SizeControl(choice, placedWidth, containerHeight, fallback)
            choiceRow:items:Add(choice)
            choiceRow:widths:Add(placedWidth)
            choiceRow:heights:Add(choiceHeight)
            if choiceHeight > choiceRow:height
                choiceRow:height = choiceHeight
            end
            placeIndex = placeIndex + 1
        end
        return choiceRow
    end

    // Gives a control its view the first time it's laid out.
    private action LoadIfNeeded(Control control)
        if control:GetDefaultLayoutProperties():NeedsRendering()
            control:LoadGraphics(control:GetDefaultLayoutProperties())
        end
    end

    // The width of a line of text in a control's font at its drawn size.
    private action MeasureText(Control control, text value, Font fallback) returns number
        Font font = control:GetFont()
        if font = undefined
            font = fallback:Copy()
        else
            font = font:Copy()
        end
        font:SetSize(cast(integer, control:GetFontSize() * control:GetInterfaceScale()))
        number width = 0
        integer index = 0
        repeat while index < value:GetSize()
            Glyph glyph = font:GetGlyph(value:GetCharacter(index))
            if glyph not= undefined
                width = width + glyph:horizontalAdvance
            end
            index = index + 1
        end
        return width
    end

    // Sets a control's width and returns the height it takes, by the same
    // rule as a top-level control: one line of its font times its rows, plus
    // its padding, unless it has a height of its own.
    private action SizeControl(Control control, number width, number containerHeight, Font fallback) returns number
        if control:GetDefaultLayoutProperties():NeedsRendering()
            control:LoadGraphics(control:GetDefaultLayoutProperties())
        end
        Font font = control:GetFont()
        if font = undefined
            font = fallback:Copy()
        else
            font = font:Copy()
        end
        font:SetSize(cast(integer, control:GetFontSize() * control:GetInterfaceScale()))
        number height = font:GetLineHeight()
        if control:GetPixelHeight() not= 0 or control:GetPercentageHeight() not= 0
            height = control:GetPixelHeight() + containerHeight * control:GetPercentageHeight()
        end
        height = height * control:GetLayoutRows() + (control:GetTopPadding() + control:GetBottomPadding()) * control:GetInterfaceScale()
        if control is Label
            Label label = cast(Label, control)
            label:SetMaximumWidth(width)
        end
        control:SetSize(width, height)
        return control:GetHeight()
    end

    // A field's width in a row of the given width: its own if it has one,
    // otherwise the whole width, at most MAX_FIELD_WIDTH (A3).
    private action FieldWidth(Control control, number available) returns number
        if control:GetPixelWidth() > 0
            return control:GetPixelWidth() * control:GetInterfaceScale()
        end
        if control is TextField and available > MAX_FIELD_WIDTH * control:GetInterfaceScale()
            return MAX_FIELD_WIDTH * control:GetInterfaceScale()
        end
        return available
    end

    /*
    Draws a label as a caption above its field (A2), or back as a normal
    label. Only labels at the Forms default size with no color of their own
    are changed, and the change is undone when the label goes back to a row.
    */
    private action UseCaptionStyle(Label label, boolean caption)
        boolean ours = captionLabels:HasKey(label)
        if caption
            if ours
                return now
            end
            if label:GetFontSize() not= constants:DEFAULT_FONT_SIZE or label:HasColorPropertyOverride("fontColor")
                return now
            end
            GameStateManager gameState
            ColorGroup captionColor = gameState:GetInterfaceOptions():GetFontColor("FieldCaption")
            label:SetFontSize(constants:SMALL_FONT_SIZE)
            if captionColor not= undefined
                label:SetFontColor(captionColor)
            end
            captionLabels:Add(label, label)
        elseif ours
            label:SetFontSize(constants:DEFAULT_FONT_SIZE)
            label:SetFontColor(undefined)
            captionLabels:RemoveKey(label)
        end
    end

    /*
    A label and its control as one row: side by side when there's room (A8),
    otherwise the label as a caption above (A2). Sizes both, and returns the
    row for PlaceRow.
    */
    private action BuildPairRow(Label label, Control control, number width, number gap, number containerHeight, Font fallback) returns FormRow
        FormRow row
        number scale = label:GetInterfaceScale()
        number labelWidth = MeasureText(label, label:GetText(), fallback)

        boolean side = width >= ROW_LAYOUT_MIN_WIDTH * scale and labelWidth <= width * ROW_LABEL_SHARE
        if control is TextBox
            side = false
        elseif control is TextField
            TextField field = cast(TextField, control)
            if field:GetText():GetSize() > LONG_FIELD_TEXT
                side = false
            end
        elseif control is Grouping
            // A field with buttons beside it, such as a path and Browse,
            // needs the whole row, so its label goes above it as a caption.
            if HasField(cast(Grouping, control))
                side = false
            end
        end

        row:items:Add(label)
        row:items:Add(control)
        if side
            row:kind = row:PAIR
            UseCaptionStyle(label, false)
            labelWidth = MeasureText(label, label:GetText(), fallback)
            number available = width - labelWidth - IN_ROW_GAP * scale
            number controlWidth = ROW_FIELD_WIDTH * scale
            if control:GetPixelWidth() > 0
                controlWidth = control:GetPixelWidth() * scale
            end
            if control is Grouping
                controlWidth = available * 0.6
            end
            if controlWidth > available
                controlWidth = available
            end
            number labelHeight = SizeControl(label, labelWidth + 1, containerHeight, fallback)
            number controlHeight = 0
            if control is Grouping
                controlHeight = SizeInline(cast(Grouping, control), controlWidth, containerHeight, fallback, row)
            else
                controlHeight = SizeControl(control, controlWidth, containerHeight, fallback)
            end
            row:widths:Add(labelWidth + 1)
            row:widths:Add(controlWidth)
            row:heights:Add(labelHeight)
            row:heights:Add(controlHeight)
            row:height = labelHeight
            if controlHeight > row:height
                row:height = controlHeight
            end
        else
            row:kind = row:STACK
            UseCaptionStyle(label, true)
            number labelHeight = SizeControl(label, width, containerHeight, fallback)
            // Under a caption, a field runs to the same right edge as the
            // fields beside labels, unless it has a width of its own.
            number controlWidth = width
            if control:GetPixelWidth() > 0
                controlWidth = control:GetPixelWidth() * scale
            end
            number controlHeight = 0
            if control is Grouping
                controlHeight = SizeInline(cast(Grouping, control), controlWidth, containerHeight, fallback, row)
            else
                controlHeight = SizeControl(control, controlWidth, containerHeight, fallback)
            end
            row:widths:Add(width)
            row:widths:Add(controlWidth)
            row:heights:Add(labelHeight)
            row:heights:Add(controlHeight)
            row:height = labelHeight + gap / 4.0 + controlHeight
        end
        return row
    end

    /*
    Sizes an untitled grouping's children side by side in the given width,
    in equal shares (as Forms always has), and returns the tallest. The
    grouping and its children are noted on the row for PlaceRow.
    */
    private action SizeInline(Grouping group, number width, number containerHeight, Font fallback, FormRow row) returns number
        group:SetDrawStyle(group:PLAIN_STYLE)
        LoadIfNeeded(group)
        row:group = group
        Array<Item2D> children = group:GetLayoutChildren()
        number gapWidth = IN_ROW_GAP * group:GetInterfaceScale()
        integer count = children:GetSize()
        if count = 0
            return 0
        end

        // Choices that don't fit side by side at their own widths go top to
        // bottom, each across the whole width.
        row:stackedChoices = false
        if AllChoices(children, 0)
            number neededWidth = gapWidth * (count - 1)
            integer choiceIndex = 0
            repeat while choiceIndex < count
                neededWidth = neededWidth + ChoiceWidth(cast(Control, children:Get(choiceIndex)), fallback)
                choiceIndex = choiceIndex + 1
            end
            if neededWidth > width
                row:stackedChoices = true
                number stackHeight = 0
                integer stackIndex = 0
                repeat while stackIndex < count
                    stackHeight = stackHeight + SizeControl(cast(Control, children:Get(stackIndex)), width, containerHeight, fallback)
                    if stackIndex > 0
                        stackHeight = stackHeight + CHOICE_STACK_GAP * group:GetInterfaceScale()
                    end
                    stackIndex = stackIndex + 1
                end
                return stackHeight
            end
        end

        // Plain buttons take the width of their words, and the other
        // children share what's left (L1). A row of only buttons, such as
        // Add and Remove under a list, leaves the rest of the row empty.
        // Choices (toggle and radio buttons) share the row evenly. A width
        // below zero means "a share".
        Array<number> childWidths
        number fixedWidth = 0
        integer sharingCount = 0
        integer measureIndex = 0
        repeat while measureIndex < count
            Item2D measured = children:Get(measureIndex)
            if measured is Button and not (measured is ToggleButton)
                number buttonWidth = NaturalButtonWidth(cast(Button, measured), fallback)
                childWidths:Add(buttonWidth)
                fixedWidth = fixedWidth + buttonWidth
            else
                childWidths:Add(-1.0)
                sharingCount = sharingCount + 1
            end
            measureIndex = measureIndex + 1
        end
        number share = 0
        if sharingCount > 0
            share = (width - gapWidth * (count - 1) - fixedWidth) / sharingCount
        end

        number tallest = 0
        integer index = 0
        repeat while index < count
            if children:Get(index) is Control
                number childWidth = childWidths:Get(index)
                if childWidth < 0
                    childWidth = share
                end
                number childHeight = SizeControl(cast(Control, children:Get(index)), childWidth, containerHeight, fallback)
                if childHeight > tallest
                    tallest = childHeight
                end
            end
            index = index + 1
        end
        return tallest
    end

    /*
    Builds and sizes the rows of a card or a subsection: label pairs (A8 or
    A2), choice groupings and untitled groupings on one row, titled groupings
    as subsections (A9), and any other control alone across the row.
    */
    private action BuildRows(Array<Item2D> items, integer first, number width, number gap, number containerHeight, Font fallback) returns Array<FormRow>
        Array<FormRow> rows

        // Choices (radio and toggle buttons) go on one row when they all fit
        // at their own widths, and otherwise one per row, top to bottom.
        if AllChoices(items, first)
            FormRow choiceRow = ChoiceRow(items, first, width, containerHeight, fallback)
            if choiceRow not= undefined
                rows:Add(choiceRow)
                return rows
            end
        end

        integer index = first
        repeat while index < items:GetSize()
            Item2D item = items:Get(index)
            if item is Label and PairsWithNextInCard(items, index)
                rows:Add(BuildPairRow(cast(Label, item), cast(Control, items:Get(index + 1)), width, gap, containerHeight, fallback))
                index = index + 1
            elseif item is Grouping
                Grouping inner = cast(Grouping, item)
                FormRow innerRow
                if inner:GetTitle() not= ""
                    // A subsection (A9): its title, then its own rows, with
                    // no card of its own.
                    innerRow:kind = innerRow:SUBSECTION
                    innerRow:group = inner
                    inner:SetDrawStyle(inner:SUBSECTION_STYLE)
                    Array<Item2D> innerItems = inner:GetLayoutChildren()
                    Item2D innerTitle = innerItems:Get(0)
                    innerRow:groupTitle = innerTitle
                    number titleHeight = SizeControl(cast(Control, innerTitle), width, containerHeight, fallback)
                    innerRow:groupRows = BuildRows(innerItems, 1, width, gap, containerHeight, fallback)
                    number innerHeight = titleHeight + gap / 4.0
                    integer innerIndex = 0
                    repeat while innerIndex < innerRow:groupRows:GetSize()
                        innerHeight = innerHeight + innerRow:groupRows:Get(innerIndex):height + CARD_ROW_PADDING * inner:GetInterfaceScale() * 2
                        innerIndex = innerIndex + 1
                    end
                    innerRow:heights:Add(titleHeight)
                    innerRow:height = innerHeight
                else
                    // An untitled grouping is one row of its children (A9).
                    innerRow:kind = innerRow:INLINE
                    innerRow:height = SizeInline(inner, width, containerHeight, fallback, innerRow)
                end
                rows:Add(innerRow)
            elseif item is Control
                FormRow single
                single:kind = single:SINGLE
                Control control = cast(Control, item)
                number controlWidth = FieldWidth(control, width)
                number controlHeight = SizeControl(control, controlWidth, containerHeight, fallback)
                single:items:Add(control)
                single:widths:Add(controlWidth)
                single:heights:Add(controlHeight)
                single:height = controlHeight
                rows:Add(single)
            end
            index = index + 1
        end
        return rows
    end

    /*
    Positions one row's items, with the row's bottom at y and its left edge
    at x, in the coordinates of whatever holds the items.
    */
    private action PlaceRow(FormRow row, number x, number y, number width, number gap)
        if row:kind = row:PAIR
            Control label = cast(Control, row:items:Get(0))
            Control control = cast(Control, row:items:Get(1))
            label:SetPosition(x, y + (row:height - row:heights:Get(0)) / 2.0)
            number controlX = x + width - row:widths:Get(1)
            number controlY = y + (row:height - row:heights:Get(1)) / 2.0
            if control is Grouping
                PlaceInline(cast(Grouping, control), row, controlX, controlY, row:widths:Get(1), row:heights:Get(1))
            else
                control:SetPosition(controlX, controlY)
            end
        elseif row:kind = row:STACK
            Control label = cast(Control, row:items:Get(0))
            Control control = cast(Control, row:items:Get(1))
            control:SetPosition(x, y)
            if control is Grouping
                PlaceInline(cast(Grouping, control), row, x, y, row:widths:Get(1), row:heights:Get(1))
            end
            label:SetPosition(x, y + row:heights:Get(1) + gap / 4.0)
        elseif row:kind = row:SINGLE
            Control control = cast(Control, row:items:Get(0))
            control:SetPosition(x, y + (row:height - row:heights:Get(0)) / 2.0)
        elseif row:kind = row:INLINE
            if row:group not= undefined
                PlaceInline(row:group, row, x, y, width, row:height)
            else
                // A grouping of only choices: its children, side by side.
                number childX = x
                integer index = 0
                repeat while index < row:items:GetSize()
                    Control child = cast(Control, row:items:Get(index))
                    child:SetPosition(childX, y + (row:height - row:heights:Get(index)) / 2.0)
                    childX = childX + row:widths:Get(index) + IN_ROW_GAP * child:GetInterfaceScale()
                    index = index + 1
                end
            end
        elseif row:kind = row:SUBSECTION
            Grouping inner = row:group
            inner:SetSize(width, row:height)
            inner:SetPosition(x, y)
            Control innerTitle = cast(Control, row:groupTitle)
            innerTitle:SetPosition(0, row:height - row:heights:Get(0))
            number rowPadding = CARD_ROW_PADDING * inner:GetInterfaceScale()
            number top = row:height - row:heights:Get(0) - gap / 4.0
            integer index = 0
            repeat while index < row:groupRows:GetSize()
                FormRow innerRow = row:groupRows:Get(index)
                top = top - innerRow:height - rowPadding * 2
                PlaceRow(innerRow, 0, top + rowPadding, width, gap)
                index = index + 1
            end
        end
    end

    // Sizes an untitled grouping to its row and places its children side by
    // side inside it.
    private action PlaceInline(Grouping group, FormRow row, number x, number y, number width, number height)
        group:SetSize(width, height)
        group:SetPosition(x, y)
        Array<Item2D> children = group:GetLayoutChildren()
        integer count = children:GetSize()
        if count = 0
            return now
        end
        // Choices too wide for one row: top to bottom (SizeInline).
        if row:stackedChoices
            number stackGap = CHOICE_STACK_GAP * group:GetInterfaceScale()
            number childTop = height
            integer stackIndex = 0
            repeat while stackIndex < count
                Item2D stacked = children:Get(stackIndex)
                childTop = childTop - stacked:GetHeight()
                stacked:SetPosition(0, childTop)
                childTop = childTop - stackGap
                stackIndex = stackIndex + 1
            end
            return now
        end

        // Each child already has its width from SizeInline.
        number gapWidth = IN_ROW_GAP * group:GetInterfaceScale()
        number childX = 0
        integer index = 0
        repeat while index < count
            Item2D child = children:Get(index)
            child:SetPosition(childX, (height - child:GetHeight()) / 2.0)
            childX = childX + child:GetWidth() + gapWidth
            index = index + 1
        end
    end

    /*
    Lays out a titled grouping as a card (A7): its title above, as a section
    heading with one and a half row gaps over it, then its rows on a rounded
    panel with thin lines between them. Returns the top of the next row.
    */
    private action LayoutCard(Grouping group, number x, number width, number rowTopY, number gap, number containerHeight, Font fallback) returns number
        number scale = group:GetInterfaceScale()
        group:SetDrawStyle(group:CARD_STYLE)
        LoadIfNeeded(group)

        Array<Item2D> children = group:GetLayoutChildren()
        Control title = cast(Control, children:Get(0))
        number padding = CARD_PADDING * scale
        number rowPadding = CARD_ROW_PADDING * scale
        number innerWidth = width - padding * 2

        Array<FormRow> rows = BuildRows(children, 1, innerWidth, gap, containerHeight, fallback)
        number cardHeight = 0
        integer index = 0
        repeat while index < rows:GetSize()
            cardHeight = cardHeight + rows:Get(index):height + rowPadding * 2
            index = index + 1
        end

        number titleHeight = SizeControl(title, width, containerHeight, fallback)

        number top = rowTopY - gap / 2.0
        group:SetSize(width, cardHeight)
        group:SetPosition(x, top - titleHeight - gap / 2.0 - cardHeight)
        title:SetPosition(0, cardHeight + gap / 2.0)

        // The rows, top to bottom, with a line above each but the first.
        number rowTop = cardHeight
        index = 0
        repeat while index < rows:GetSize()
            FormRow row = rows:Get(index)
            if index > 0
                FormRowSeparator line = group:GetRowSeparator(index - 1)
                LoadIfNeeded(line)
                number thickness = scale
                if thickness < 1
                    thickness = 1
                end
                line:SetSize(innerWidth, thickness)
                line:SetPosition(padding, rowTop)
            end
            number rowBottom = rowTop - row:height - rowPadding * 2
            PlaceRow(row, padding, rowBottom + rowPadding, innerWidth, gap)
            rowTop = rowBottom
            index = index + 1
        end
        if rows:GetSize() > 0
            group:HideRowSeparatorsFrom(rows:GetSize() - 1)
        else
            group:HideRowSeparatorsFrom(0)
        end

        return top - titleHeight - gap / 2.0 - cardHeight - gap
    end

    /*
    Lays out a page's footer (A5): across the page with a line above, and
    its buttons right-aligned at their natural widths, in the order added.
    Returns the top of the next row.
    */
    private action LayoutFooter(Grouping group, number rowTopY, number containerWidth, number rowStartX, number rowEndX, number gap, number containerHeight, Font fallback) returns number
        group:SetDrawStyle(group:FOOTER_STYLE)
        LoadIfNeeded(group)
        Array<Item2D> buttons = group:GetLayoutChildren()
        number scale = group:GetInterfaceScale()

        // The first GetLeadingButtonCount() buttons sit at the left, such
        // as Back. The rest sit at the right, and only they count in total.
        integer leading = group:GetLeadingButtonCount()
        Array<number> widths
        number tallest = 0
        number total = 0
        integer index = 0
        repeat while index < buttons:GetSize()
            Button button = cast(Button, buttons:Get(index))
            // Footer words stay at their size instead of growing to fill.
            button:SetAutomaticFontSizing(false)
            text words = button:GetDefaultLayoutProperties():GetLabelText()
            number buttonWidth = MeasureText(button, words, fallback) + (button:GetLeftPadding() + button:GetRightPadding()) * scale
            if buttonWidth < MIN_FOOTER_BUTTON_WIDTH * scale
                buttonWidth = MIN_FOOTER_BUTTON_WIDTH * scale
            end
            number buttonHeight = SizeControl(button, buttonWidth, containerHeight, fallback)
            widths:Add(buttonWidth)
            if buttonHeight > tallest
                tallest = buttonHeight
            end
            if index >= leading
                total = total + buttonWidth
                if index > leading
                    total = total + IN_ROW_GAP * scale
                end
            end
            index = index + 1
        end

        number footerHeight = tallest + gap * 2
        group:SetSize(containerWidth, footerHeight)
        group:SetPosition(0, rowTopY - footerHeight)

        number leadingX = rowStartX
        number buttonX = rowEndX - total
        index = 0
        repeat while index < buttons:GetSize()
            Item2D button = buttons:Get(index)
            if index < leading
                button:SetPosition(leadingX, (footerHeight - button:GetHeight()) / 2.0)
                leadingX = leadingX + widths:Get(index) + IN_ROW_GAP * scale
            else
                button:SetPosition(buttonX, (footerHeight - button:GetHeight()) / 2.0)
                buttonX = buttonX + widths:Get(index) + IN_ROW_GAP * scale
            end
            index = index + 1
        end
        return rowTopY - footerHeight - gap
    end

end