package Libraries.Interface.Events

use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainFoliagePropertiesDialog

/*
    The TerrainFoliageFieldListener tells a terrain's Foliage section when the
    focus leaves one of a foliage asset's settings fields,
    so a value is taken once it's typed, not on each key.
*/
class TerrainFoliageFieldListener is FocusListener
    TerrainFoliagePropertiesDialog dialog = undefined
    TextField field = undefined

    /*
        Sets the section and the field this listens to.

        Attribute: Parameter dialog The Foliage section
        Attribute: Parameter field The field
    */
    action Setup(TerrainFoliagePropertiesDialog dialog, TextField field)
        me:dialog = dialog
        me:field = field
    end

    action GainedFocus(FocusEvent event)
    end

    action LostFocus(FocusEvent event)
        if dialog not= undefined
            dialog:FieldLeft(field)
        end
    end
end
