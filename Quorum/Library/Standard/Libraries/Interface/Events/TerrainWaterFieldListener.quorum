package Libraries.Interface.Events

use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainWaterPropertiesDialog

/*
    The TerrainWaterFieldListener tells a terrain's Water section when the
    focus leaves one of its fields, so a value is taken once
    it's typed, not on each key.
*/
class TerrainWaterFieldListener is FocusListener
    TerrainWaterPropertiesDialog dialog = undefined
    TextField field = undefined

    /*
        Sets the section and the field this listens to.

        Attribute: Parameter dialog The Water section
        Attribute: Parameter field The field
    */
    action Setup(TerrainWaterPropertiesDialog dialog, TextField field)
        me:dialog = dialog
        me:field = field
    end

    action GainedFocus(FocusEvent event)
    end

    action LostFocus(FocusEvent event)
        if dialog not= undefined
            dialog:FieldLeft(field)
        end
    end
end
