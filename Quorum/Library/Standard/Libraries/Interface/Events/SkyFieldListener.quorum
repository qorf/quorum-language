package Libraries.Interface.Events

use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Scenes.Dialogs.SkyPropertiesDialog

/*
    The SkyFieldListener tells a 3D layer's Sky section when the focus
    leaves its Turn field (QuincyWorld demo D3), so the value is taken once
    it's typed, not on each key.
*/
class SkyFieldListener is FocusListener
    SkyPropertiesDialog dialog = undefined
    TextField field = undefined

    /*
        Sets the section and the field this listens to.

        Attribute: Parameter dialog The Sky section
        Attribute: Parameter field The field
    */
    action Setup(SkyPropertiesDialog dialog, TextField field)
        me:dialog = dialog
        me:field = field
    end

    action GainedFocus(FocusEvent event)
    end

    action LostFocus(FocusEvent event)
        if dialog not= undefined
            dialog:FieldLeft(field)
        end
    end
end
