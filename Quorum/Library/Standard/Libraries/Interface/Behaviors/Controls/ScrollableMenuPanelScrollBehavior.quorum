package Libraries.Interface.Behaviors.Controls

use Libraries.Compute.Math
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.ScrollableMenuPanel
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.MouseEvent

class ScrollableMenuPanelScrollBehavior is Behavior

    Math math
    // How many items one unit of the wheel scrolls, as for other controls.
    constant number ITEMS_PER_WHEEL_UNIT = 3
    // The part of an item scrolled but not yet moved, since a menu moves
    // whole items: small amounts add up instead of being lost.
    number carry = 0

    action Run(BehaviorEvent event)
        if event:GetItem() is ScrollableMenuPanel
            ScrollableMenuPanel menu = cast(ScrollableMenuPanel, event:GetItem())
            MouseEvent mouseEvent = event:GetMouseEvent()
            if mouseEvent not= undefined
                carry = carry + mouseEvent:scrollAmount * ITEMS_PER_WHEEL_UNIT
                // Whole items, toward zero; the rest waits for the next turn.
                integer lines = cast(integer, carry)
                carry = carry - lines

                menu:SetScrollIndex(menu:GetScrollIndex() - lines)
            end
        end
    end

end