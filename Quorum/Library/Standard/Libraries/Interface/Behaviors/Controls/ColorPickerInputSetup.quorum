package Libraries.Interface.Behaviors.Controls

use Libraries.Game.GameInput
use Libraries.Game.InputSet
use Libraries.Game.InputTable
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Interface.Events.MouseEvent
use Libraries.Containers.Array
use Libraries.Containers.Iterator

/*
    The ColorPickerInputSetup class adds the input of a ColorPicker's parts
    to a game's input:

    - "HueRing": the keys of a Slider (the "Slider" input group), with the
      mouse and fingers setting the hue from the angle of the pointer
      around the ring's center.
    - "SaturationBrightnessSquare": Right and Left raise and lower the
      saturation, Up and Down the brightness, with Shift for a tenth of a
      step; the mouse and fingers set both from the place of the pointer.
    - "ColorPicker": Enter keeps the color and Escape puts the old one back,
      anywhere in the picker where the focused part doesn't use the key.

    DefaultInputSets calls Setup when the game starts, so most users won't
    need to.

    Attribute: Author William Allee

    Attribute: Example

    use Libraries.Game.GameStateManager
    use Libraries.Interface.Behaviors.Controls.ColorPickerInputSetup

    GameStateManager manager
    ColorPickerInputSetup setup
    setup:Setup(manager:GetInput())
*/
class ColorPickerInputSetup
    KeyboardEvent keys
    MouseEvent mouse

    /*
        This action adds the "HueRing", "SaturationBrightnessSquare" and
        "ColorPicker" input tables to the game's input. The "Slider" table
        should be added first, since the ring copies its keys.

        Attribute: Parameter gameInput The game's input.

        Attribute: Example
        use Libraries.Game.GameStateManager
        use Libraries.Interface.Behaviors.Controls.ColorPickerInputSetup

        GameStateManager manager
        ColorPickerInputSetup setup
        setup:Setup(manager:GetInput())
    */
    action Setup(GameInput gameInput)
        SetupHueRing(gameInput)
        SetupSquare(gameInput)
        SetupPicker(gameInput)
    end

    /*
        The ring's table: a copy of the slider's, with its pointer input
        going to the ring's own behavior. Without a slider table, the
        slider's keys are added here.
    */
    private action SetupHueRing(GameInput gameInput)
        InputTable ringTable = undefined
        InputTable sliderTable = gameInput:GetInputTable("Slider")
        if sliderTable not= undefined
            ringTable = sliderTable:Copy()
        else
            InputTable newTable
            ringTable = newTable
            AddSliderKeys(ringTable)
        end
        ringTable:SetIdentifier("HueRing")

        // The slider's pointer input is taken out; the ring's goes in.
        Array<InputSet> pointerSets
        Iterator<InputSet> iterator = ringTable:GetInputSets()
        repeat while iterator:HasNext()
            InputSet set = iterator:Next()
            Behavior behavior = ringTable:GetValue(set)
            if behavior is SliderPointerBehavior
                pointerSets:Add(set)
            end
        end
        integer i = 0
        repeat while i < pointerSets:GetSize()
            ringTable:RemoveKey(pointerSets:Get(i))
            i = i + 1
        end

        HueRingPointerBehavior pointerBehavior
        AddPointerInput(ringTable, pointerBehavior)
        gameInput:AddInputTable(ringTable)
    end

    /*
        Adds a slider's keys, as DefaultInputSets does for the "Slider"
        table.
    */
    private action AddSliderKeys(InputTable table)
        SliderKeyBehavior temp
        AddSliderKey(table, keys:RIGHT, false, temp:STEP_UP)
        AddSliderKey(table, keys:UP, false, temp:STEP_UP)
        AddSliderKey(table, keys:LEFT, false, temp:STEP_DOWN)
        AddSliderKey(table, keys:DOWN, false, temp:STEP_DOWN)
        AddSliderKey(table, keys:RIGHT, true, temp:FINE_STEP_UP)
        AddSliderKey(table, keys:UP, true, temp:FINE_STEP_UP)
        AddSliderKey(table, keys:LEFT, true, temp:FINE_STEP_DOWN)
        AddSliderKey(table, keys:DOWN, true, temp:FINE_STEP_DOWN)
        AddSliderKey(table, keys:PAGE_UP, false, temp:PAGE_UP)
        AddSliderKey(table, keys:PAGE_DOWN, false, temp:PAGE_DOWN)
        AddSliderKey(table, keys:HOME, false, temp:TO_MINIMUM)
        AddSliderKey(table, keys:END, false, temp:TO_MAXIMUM)
    end

    /*
        Adds one of a slider's keys, with or without Shift.
    */
    private action AddSliderKey(InputTable table, integer key, boolean shift, integer move)
        SliderKeyBehavior behavior
        behavior:Setup(move)
        table:Add(MakeKey(key, shift), behavior)
    end

    /*
        The square's table: the four arrows, with Shift for small steps, and
        the pointer.
    */
    private action SetupSquare(GameInput gameInput)
        InputTable squareTable
        squareTable:SetIdentifier("SaturationBrightnessSquare")

        SaturationBrightnessKeyBehavior temp
        AddSquareKey(squareTable, keys:RIGHT, false, temp:SATURATION_UP)
        AddSquareKey(squareTable, keys:LEFT, false, temp:SATURATION_DOWN)
        AddSquareKey(squareTable, keys:UP, false, temp:BRIGHTNESS_UP)
        AddSquareKey(squareTable, keys:DOWN, false, temp:BRIGHTNESS_DOWN)
        AddSquareKey(squareTable, keys:RIGHT, true, temp:SATURATION_UP)
        AddSquareKey(squareTable, keys:LEFT, true, temp:SATURATION_DOWN)
        AddSquareKey(squareTable, keys:UP, true, temp:BRIGHTNESS_UP)
        AddSquareKey(squareTable, keys:DOWN, true, temp:BRIGHTNESS_DOWN)

        SaturationBrightnessPointerBehavior pointerBehavior
        AddPointerInput(squareTable, pointerBehavior)
        gameInput:AddInputTable(squareTable)
    end

    /*
        Adds one of the square's arrow keys, with or without Shift.
    */
    private action AddSquareKey(InputTable table, integer key, boolean shift, integer move)
        SaturationBrightnessKeyBehavior behavior
        behavior:Setup(move, shift)
        table:Add(MakeKey(key, shift), behavior)
    end

    /*
        The picker's table: Enter and the keypad's Enter keep the color, and
        Escape puts the old one back.
    */
    private action SetupPicker(GameInput gameInput)
        InputTable pickerTable
        pickerTable:SetIdentifier("ColorPicker")

        ColorPickerCloseBehavior keep
        keep:Setup(keep:OK)
        pickerTable:Add(MakeKey(keys:ENTER, false), keep)
        pickerTable:Add(MakeKey(keys:NUMPAD_ENTER, false), keep)

        ColorPickerCloseBehavior cancel
        cancel:Setup(cancel:CANCEL)
        pickerTable:Add(MakeKey(keys:ESCAPE, false), cancel)

        gameInput:AddInputTable(pickerTable)
    end

    /*
        A key, with or without Shift.
    */
    private action MakeKey(integer key, boolean shift) returns InputSet
        InputSet set
        set:SetKeyboardInput(key)
        if shift
            set:AddModifier(set:SHIFT)
        end
        return set
    end

    /*
        Adds the pointer input that sets a value from where the pointer is:
        the left mouse button going down, a drag starting and going on, and
        a finger going down and moving.
    */
    private action AddPointerInput(InputTable table, Behavior behavior)
        InputSet pressSet
        pressSet:SetMouseInput(mouse:LEFT)
        table:Add(pressSet, behavior)

        InputSet dragStartSet
        dragStartSet:SetDragItemInput()
        dragStartSet:SetInputTrigger(dragStartSet:BEGIN)
        table:Add(dragStartSet, behavior)
        InputSet dragSet
        dragSet:SetDragItemInput()
        dragSet:SetInputTrigger(dragSet:CONTINUE)
        table:Add(dragSet, behavior)

        InputSet touchDown
        touchDown:SetInputType(touchDown:TOUCH_INPUT)
        table:Add(touchDown, behavior)
        InputSet touchMove
        touchMove:SetInputType(touchMove:TOUCH_MOVEMENT_INPUT)
        touchMove:SetInputTrigger(touchMove:CONTINUE)
        table:Add(touchMove, behavior)
    end
end
