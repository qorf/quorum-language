package Libraries.Interface.Behaviors.Controls

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Spreadsheet
use Libraries.Game.GameStateManager
use Libraries.Game.Game

/*
    This class is the Paste key of a Spreadsheet: tab-separated text from the clipboard goes into the cells from the top left of the selection, as one step that can be undone. SpreadsheetInputSetup
    gives it its key, so most users won't need it.

    Attribute: Author William Allee

    Attribute: Example
    use Libraries.Interface.Behaviors.Controls.SpreadsheetPasteBehavior
    SpreadsheetPasteBehavior behavior
*/
class SpreadsheetPasteBehavior is Behavior
    GameStateManager manager

    /*
    This action carries out the key on the spreadsheet with the focus.

    Attribute: Parameter event The key event, whose item is the spreadsheet.
    */
    action Run(BehaviorEvent event)
        if not (event:GetItem() is Spreadsheet)
            return now
        end
        Spreadsheet sheet = cast(Spreadsheet, event:GetItem())
        if sheet:IsEditing()
            return now
        end
        sheet:ForgetIgnoredSpace()
        Game game = manager:GetGame()
        text value = game:GetClipboard()
        if value not= undefined
            sheet:PasteAsUser(value)
        end
    end

    /*
    This action returns true: the key's work is done at once.

    Attribute: Returns True.
    */
    action IsFinished returns boolean
        return true
    end
end
