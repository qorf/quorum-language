package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.CameraPerspectiveItem

/*
    This behavior starts or stops the camera moving while a camera perspective is on. Pressing an
    arrow key starts moving in that direction, and releasing it stops. Sideways is left and right,
    and otherwise it is forward and back.
*/
class CameraPerspectivePanBehavior is Behavior
    boolean sideways = false
    integer direction = 0

    action SetDirection(boolean isSideways, integer value)
        sideways = isSideways
        direction = value
    end

    action Run(BehaviorEvent event)
        if not (event:GetItem() is CameraPerspectiveItem)
            return now
        end

        CameraPerspectiveItem item = cast(CameraPerspectiveItem, event:GetItem())
        SceneEditor editor = item:GetSceneEditor()
        if editor = undefined
            return now
        end

        if sideways
            editor:SetCameraPerspectivePan(direction, editor:GetCameraPerspectivePanZ())
        else
            editor:SetCameraPerspectivePan(editor:GetCameraPerspectivePanX(), direction)
        end
    end
end
