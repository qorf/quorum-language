package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.CameraPerspectiveItem

/*
    This behavior leaves the camera perspective when Escape is pressed, putting the camera and focus
    back the way they were before it.
*/
class ExitCameraPerspectiveBehavior is Behavior
    action Run(BehaviorEvent event)
        if event:GetItem() is CameraPerspectiveItem
            CameraPerspectiveItem item = cast(CameraPerspectiveItem, event:GetItem())
            SceneEditor editor = item:GetSceneEditor()
            if editor not= undefined
                editor:ExitCameraPerspective()
            end
        end
    end
end
