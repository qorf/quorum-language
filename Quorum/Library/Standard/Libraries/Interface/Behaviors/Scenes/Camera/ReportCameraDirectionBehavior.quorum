package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Compute.Math
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Items.SceneViewCue
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior notifies the screen reader of the yaw, pitch, and roll of the camera. 
    The angles are given in degrees and the order will always be yaw, pitch, and then 
    roll. It is said through a view cue (SceneEditor:SayThroughViewCue), so you need to be 
    using a screen reader to see the notify.
*/
class ReportCameraDirectionBehavior is Behavior

    Math math

    action Run(BehaviorEvent event)
        // The key may come to the scene editor itself, or to the item with
        // the focus in its 3D layer: a selection, the camera item or a new
        // item's placeholder.
        SceneEditor controller = undefined
        if event:GetItem() is SceneEditor
            controller = cast(SceneEditor, event:GetItem())
        elseif event:GetItem() is EditorItem
            EditorItem focusedItem = cast(EditorItem, event:GetItem())
            controller = focusedItem:GetSceneEditor()
        elseif event:GetItem() is SceneViewCue
            SceneViewCue cue = cast(SceneViewCue, event:GetItem())
            controller = cue:GetSceneEditor()
        end
        if controller not= undefined
            // Said through a view cue, a focus change, since an announcement often isn't read.
            controller:SayThroughViewCue("Camera yaw is " + math:Round(controller:GetYaw(), 1) + ", pitch is " + math:Round(controller:GetPitch(), 1), undefined)
        end
    end
end