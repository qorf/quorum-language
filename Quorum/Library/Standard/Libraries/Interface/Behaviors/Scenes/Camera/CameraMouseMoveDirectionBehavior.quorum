package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Events.DragAndDropEvent
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Compute.Vector3
use Libraries.Compute.Math
use Libraries.Game.InputSet

class CameraMouseMoveDirectionBehavior is Behavior
    Math math
    constant number SENSITIVITY = 0.002
    constant number PITCH_OFFSET = 0.001
    
    // used for orbit
    Vector3 pivotPoint
    number pivotDistance = 10.0
    number orbitYaw = 0
    number orbitPitch = 0

    action Run(BehaviorEvent event)
        SceneEditor editor = cast(SceneEditor, event:GetItem())
        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        
        
        MouseEvent mouseEvent = event:GetMouseEvent()    
    
        if mouseEvent:eventType = mouseEvent:DRAGGED_MOUSE and mouseEvent:mouseButton = mouseEvent:RIGHT
            integer deltaX = mouseEvent:GetMovementX()
            integer deltaY = mouseEvent:GetMovementY()
            Vector3 cameraDirection = camera:GetDirection():Copy()
            number yaw = math:InverseTangent2(cameraDirection:GetX(), cameraDirection:GetZ())
            number pitch = math:InverseSine(cameraDirection:GetY())
            
            yaw = yaw + (deltaX * SENSITIVITY)
            pitch = pitch + (deltaY * SENSITIVITY)
            if pitch > math:piOver2 - PITCH_OFFSET
                pitch = math:piOver2 - PITCH_OFFSET
            end
            if pitch < -math:piOver2 + PITCH_OFFSET
                pitch = -math:piOver2 + PITCH_OFFSET
            end
            
            cameraDirection:SetX(math:Cosine(pitch) * math:Sine(yaw))
            cameraDirection:SetY(math:Sine(pitch))
            cameraDirection:SetZ(math:Cosine(pitch) * math:Cosine(yaw))
            camera:SetDirection(cameraDirection)
        elseif mouseEvent:mouseButton = mouseEvent:MIDDLE
if mouseEvent:IsClicked() 
                Vector3 cameraPosition = camera:GetPosition():Copy()
                Vector3 cameraDirection = camera:GetDirection():Copy()
                me:orbitYaw = math:InverseTangent2(cameraDirection:GetX(), cameraDirection:GetZ()) + math:pi
            me:orbitPitch = math:InverseSine(cameraDirection:GetY())
                //pivotPoint = cameraPosition:Add(cameraDirection:Scale(pivotDistance))
                number dirX = cameraDirection:GetX()
number dirY = cameraDirection:GetY()
number dirZ = cameraDirection:GetZ()

pivotPoint:SetX(cameraPosition:GetX() + dirX * pivotDistance)
pivotPoint:SetY(cameraPosition:GetY() + dirY * pivotDistance)
pivotPoint:SetZ(cameraPosition:GetZ() + dirZ * pivotDistance)
                cameraPosition = camera:GetPosition():Copy()
                cameraDirection= camera:GetDirection():Copy()
            elseif mouseEvent:IsDragged()
                integer deltaX = mouseEvent:GetMovementX()
            integer deltaY = mouseEvent:GetMovementY()
            
                Vector3 newCameraPosition
            
            me:orbitYaw = orbitYaw + (deltaX * SENSITIVITY)
            me:orbitPitch = orbitPitch + (deltaY * SENSITIVITY)
            if orbitPitch > math:piOver2 - PITCH_OFFSET
                orbitPitch = math:piOver2 - PITCH_OFFSET
            end
            if orbitPitch < -math:piOver2 + PITCH_OFFSET
                orbitPitch = -math:piOver2 + PITCH_OFFSET
            end
            
                newCameraPosition:SetX(pivotPoint:GetX() + (pivotDistance * math:Cosine(orbitPitch) * math:Sine(orbitYaw)))
                newCameraPosition:SetY(pivotPoint:GetY() + (pivotDistance * math:Sine(orbitPitch)))
                newCameraPosition:SetZ(pivotPoint:GetZ() + (pivotDistance * math:Cosine(orbitPitch) * math:Cosine(orbitYaw)))
                camera:SetPosition(newCameraPosition)
                
                number dirX = pivotPoint:GetX() - newCameraPosition:GetX()
number dirY = pivotPoint:GetY() - newCameraPosition:GetY()
number dirZ = pivotPoint:GetZ() - newCameraPosition:GetZ()

// normalize
number length = math:SquareRoot(dirX*dirX + dirY*dirY + dirZ*dirZ)
dirX = dirX / length
dirY = dirY / length
dirZ = dirZ / length

Vector3 newCameraDirection
newCameraDirection:SetX(dirX)
newCameraDirection:SetY(dirY)
newCameraDirection:SetZ(dirZ)
camera:SetDirection(newCameraDirection)
            end
        end
        
    end
end