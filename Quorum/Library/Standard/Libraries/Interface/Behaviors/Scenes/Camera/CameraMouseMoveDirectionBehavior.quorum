package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D

/*
The CameraMouseMoveDirectionBehavior moves the scene editor's 3D camera with
the mouse:
- dragging with the right button turns it to look around, left and right
  (yaw) and up and down (pitch), from where it stands, without tipping the
  horizon (roll);
- dragging with the middle button slides it across the view: drag right and
  it moves right, drag up and it moves up, without turning. It slides
  farther the farther the camera is from what it looks at.
Shift and the middle button orbit around a point ahead
(CameraMousePanBehavior). The keys and the Scenes menu make the same moves
through the same EditorCamera3D actions.
*/
class CameraMouseMoveDirectionBehavior is Behavior
    // How far the view turns per pixel the mouse moves, in radians.
    constant number SENSITIVITY = 0.002
    // How far the camera slides per pixel, as a share of its distance from
    // what it looks at (EditorCamera3D:GetViewDistance).
    constant number SLIDE_SHARE = 0.0015

    action Run(BehaviorEvent event)
        SceneEditor editor = cast(SceneEditor, event:GetItem())
        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        MouseEvent mouseEvent = event:GetMouseEvent()

        if mouseEvent:eventType = mouseEvent:DRAGGED_MOUSE and mouseEvent:mouseButton = mouseEvent:RIGHT
            camera:LookBy(mouseEvent:GetMovementX() * SENSITIVITY, mouseEvent:GetMovementY() * SENSITIVITY)
        elseif mouseEvent:mouseButton = mouseEvent:MIDDLE and mouseEvent:IsDragged()
            number unitsPerPixel = camera:GetViewDistance() * SLIDE_SHARE
            camera:SlideBy(mouseEvent:GetMovementX() * unitsPerPixel, mouseEvent:GetMovementY() * unitsPerPixel)
        end
    end
end
