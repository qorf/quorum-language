package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Compute.Math

/*
The CameraMousePanBehavior zooms the scene editor's 3D camera with the mouse
wheel, and orbits it with Shift and the middle button: pressing picks a
point ahead, as far as the camera is from what it looks at, and dragging
circles the camera around that point, staying level. The keys and the
Scenes menu make the same moves through the same EditorCamera3D actions.
*/
class CameraMousePanBehavior is Behavior
    Math math
    // How far the orbit turns per pixel the mouse moves, in radians.
    constant number ORBIT_SENSITIVITY = 0.002
    // The most zoom steps one wheel event counts, so a fast spin never jumps
    // wildly.
    constant number MOST_STEPS = 2

    action Run(BehaviorEvent event)
        SceneEditor editor = cast(SceneEditor, event:GetItem())
        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        MouseEvent mouseEvent = event:GetMouseEvent()

        if mouseEvent:IsScrolled()
            number scrollDelta = mouseEvent:scrollAmount
            // Faster wheel turns zoom farther, but only as the log of the
            // amount: 1 is one step, 3 is two, and no more than MOST_STEPS.
            number steps = math:Logarithm(1 + math:AbsoluteValue(scrollDelta)) / math:Logarithm(2)
            if steps > MOST_STEPS
                steps = MOST_STEPS
            end
            if scrollDelta < 0
                steps = -steps
            end
            camera:ZoomBy(steps)
        elseif mouseEvent:IsDragged()
            camera:OrbitBy(mouseEvent:GetMovementX() * ORBIT_SENSITIVITY, mouseEvent:GetMovementY() * ORBIT_SENSITIVITY)
        elseif mouseEvent:IsClicked()
            camera:StartOrbit()
        end
    end
end
