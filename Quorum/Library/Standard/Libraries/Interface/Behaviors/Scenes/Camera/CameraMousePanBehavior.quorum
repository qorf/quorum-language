package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Events.DragAndDropEvent
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Compute.Vector3
use Libraries.Compute.Math

class CameraMousePanBehavior is Behavior
    Math math
    constant number PAN_SENSITIVITY = 0.05
    constant number SCROLL_SPEED = 0.2
    
    action Run(BehaviorEvent event)
        SceneEditor editor = cast(SceneEditor, event:GetItem())
        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        
        
        MouseEvent mouseEvent = event:GetMouseEvent()    
        
        if mouseEvent:IsScrolled()
            number scrollDelta = mouseEvent:scrollAmount
            Vector3 cameraPosition = camera:GetPosition():Copy()
Vector3 cameraDirection = camera:GetDirection():Copy()

            number moveAmount = scrollDelta * SCROLL_SPEED

            cameraPosition:SetX(cameraPosition:GetX() + cameraDirection:GetX() * moveAmount)
            cameraPosition:SetY(cameraPosition:GetY() + cameraDirection:GetY() * moveAmount)
            cameraPosition:SetZ(cameraPosition:GetZ() + cameraDirection:GetZ() * moveAmount)

            camera:SetPosition(cameraPosition)
        elseif mouseEvent:IsDragged()
            integer deltaX = mouseEvent:GetMovementX()
    integer deltaY = mouseEvent:GetMovementY()
    
    Vector3 cameraDirection = camera:GetDirection():Copy()
    Vector3 worldUp
    worldUp:SetX(0)
    worldUp:SetY(1)
    worldUp:SetZ(0)
    
    // right vector = direction crossed with world up
    Vector3 right = cameraDirection:CrossProduct(worldUp)
    right = right:Normalize()
    
    // up vector = right crossed with direction (gives a true camera-local up)
    Vector3 up = right:Copy():CrossProduct(camera:GetDirection():Copy())
    up = up:Normalize()
    
    Vector3 cameraPosition = camera:GetPosition():Copy()
    
    number panX = (right:GetX() * -deltaX + up:GetX() * deltaY) * PAN_SENSITIVITY
    number panY = (right:GetY() * -deltaX + up:GetY() * deltaY) * PAN_SENSITIVITY
    number panZ = (right:GetZ() * -deltaX + up:GetZ() * deltaY) * PAN_SENSITIVITY
    
    Vector3 newCameraPosition
    newCameraPosition:SetX(cameraPosition:GetX() + panX)
    newCameraPosition:SetY(cameraPosition:GetY() + panY)
    newCameraPosition:SetZ(cameraPosition:GetZ() + panZ)
    
    camera:SetPosition(newCameraPosition)
        end
        
    end
end