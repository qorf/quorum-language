package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Items.SceneViewCue
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior is Enter on a scene view cue. While stepping through the
    items in view (Tab), it selects the item the cue is on, as Enter at the
    cursor does: its highlight takes the focus. Otherwise the key goes to
    the item the cue came from, as any other key does
    (PassKeyFromViewCueBehavior).
*/
class SelectViewCueItemBehavior is Behavior
    PassKeyFromViewCueBehavior passKey

    action Run(BehaviorEvent event)
        if event:GetItem() is SceneViewCue
            SceneViewCue cue = cast(SceneViewCue, event:GetItem())
            SceneEditor editor = cue:GetSceneEditor()
            if editor not= undefined and editor:SelectBrowsedItem()
                return now
            end
        end
        passKey:Run(event)
    end
end
