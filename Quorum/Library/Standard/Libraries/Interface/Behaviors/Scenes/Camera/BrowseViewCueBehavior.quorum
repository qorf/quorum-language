package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Items.SceneViewCue
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior steps through the items in the camera's view from a scene
    view cue (the item a screen reader reads from after the camera or the
    arrow keys move): Tab for the next, left to right, and Shift+Tab for the
    one before (SceneEditor:BrowseView).

    Attribute: Example
    use Libraries.Interface.Behaviors.Scenes.Camera.BrowseViewCueBehavior

    BrowseViewCueBehavior previous
    previous:SetStep(-1)
*/
class BrowseViewCueBehavior is Behavior
    integer step = 1

    /*
        Sets which way this behavior steps: 1 for the next item, -1 for the
        one before.

        Attribute: Parameter value 1 or -1
    */
    action SetStep(integer value)
        step = value
    end

    action Run(BehaviorEvent event)
        if event:GetItem() is SceneViewCue
            SceneViewCue cue = cast(SceneViewCue, event:GetItem())
            if cue:GetSceneEditor() not= undefined
                cue:GetSceneEditor():BrowseView(step)
            end
        end
    end
end
