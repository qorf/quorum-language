package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Items.Highlights.SelectionHighlight
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior selects every item in the scene editor's current layer (Ctrl+A, or Cmd+A on a
    Mac). It works whether the scene editor or a selected item has focus. Focus moves to the
    first selected item, and Tab moves through the rest.
*/
class SelectAllItemsBehavior is Behavior
    action Run(BehaviorEvent event)
        if event:GetItem() is SelectionHighlight
            SelectionHighlight highlight = cast(SelectionHighlight, event:GetItem())
            if highlight:GetSceneEditor() not= undefined
                highlight:GetSceneEditor():SelectAllItems()
            end
        elseif event:GetItem() is SceneEditor
            SceneEditor editor = cast(SceneEditor, event:GetItem())
            editor:SelectAllItems()
        end
    end
end
