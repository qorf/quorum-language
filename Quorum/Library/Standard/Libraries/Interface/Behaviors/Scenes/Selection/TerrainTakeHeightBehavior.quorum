package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.Items.Highlights.TerrainSelectionHighlight

/*
    The TerrainTakeHeightBehavior takes the ground's height under a selected
    terrain's brush as the height flatten evens to, when a tool is chosen
    (step 8). Alt+M by default.
*/
class TerrainTakeHeightBehavior is Behavior
    action Run(BehaviorEvent event)
        if event:GetItem() is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, event:GetItem())
            EditorTerrain terrain = highlight:GetEditorTerrain()
            if terrain not= undefined and terrain:HasTool() and highlight:GetSceneEditor() not= undefined
                highlight:GetSceneEditor():TakeTerrainFlattenHeight(terrain)
            end
        end
    end
end
