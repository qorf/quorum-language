package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D

/*
    The ItemDropToGroundBehavior drops the focused item, or a new item's
    preview, onto the terrain under the middle of its base, once (Items on
    terrain, phase 1). The item isn't a child of the terrain and doesn't
    follow the ground afterward. Shift+Alt+B by default.
*/
class ItemDropToGroundBehavior is Behavior
    action Run(BehaviorEvent event)
        if event:GetItem() is EditorItem3D
            EditorItem3D focus = cast(EditorItem3D, event:GetItem())
            if focus:GetSceneEditor() not= undefined
                focus:GetSceneEditor():DropOnGround(focus)
            end
        end
    end
end
