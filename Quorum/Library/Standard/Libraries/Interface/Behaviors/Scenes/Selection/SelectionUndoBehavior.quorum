package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Items.Highlights.SelectionHighlight
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Undo.SceneEditorEditManager
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior is used by the selection system in the scene editor to undo or redo the last
    change while a selected item has focus. Without it, undo only works when the scene editor
    itself has focus, so a move, paste, or other change could not be undone right after making
    it. If the behavior is set to redo, it redoes the last undone change instead.
*/
class SelectionUndoBehavior is Behavior
    boolean redo = false

    action SetRedo(boolean value)
        redo = value
    end

    action IsRedo returns boolean
        return redo
    end

    action Run(BehaviorEvent event)
        if not (event:GetItem() is SelectionHighlight)
            return now
        end

        SelectionHighlight highlight = cast(SelectionHighlight, event:GetItem())
        SceneEditor editor = highlight:GetSceneEditor()
        if editor = undefined
            return now
        end

        SceneEditorEditManager manager = editor:GetEditManager()
        if manager = undefined
            return now
        end

        if redo
            if manager:CanRedo()
                manager:Redo()
            end
        elseif manager:CanUndo()
            manager:Undo()
        end
    end
end
