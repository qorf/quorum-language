package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior

/*
    This behavior is used by the scene editor to drag selected 3D items with the left mouse
    button. The item is grabbed when the mouse is pressed on it, by SelectScene3DItemBehavior.
    While the mouse is dragged, the grabbed item and every other selected item follow it.
    When the mouse is released, the drag ends. If the behavior is set to vertical, dragging
    moves the items up and down instead of along the ground.
*/
class SelectionMouseDragBehavior is Behavior
    boolean vertical = false

    action SetVertical(boolean value)
        vertical = value
    end

    action IsVertical returns boolean
        return vertical
    end

    action Run(BehaviorEvent event)
        if not (event:GetItem() is SceneEditor)
            return now
        end

        SceneEditor editor = cast(SceneEditor, event:GetItem())
        MouseEvent mouse = event:GetMouseEvent()
        if mouse = undefined
            return now
        end

        if mouse:IsDragged()
            editor:ContinueMouseDrag(mouse, vertical)
        elseif mouse:IsReleased()
            editor:FinishMouseDrag()
        end
    end
end
