package Libraries.Interface.Behaviors.Scenes.Selection

use Libraries.Containers.Array
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Item
use Libraries.Game.Layer
use Libraries.Interface.Item2D
use Libraries.Interface.Item3D
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.MouseEvent
use Libraries.Compute.Ray
use Libraries.Compute.Vector3
use Libraries.Compute.Matrix4
use Libraries.Compute.Math
use Libraries.Interface.Controls.Scenes.Items.EditorCursor3D
use Libraries.Game.Graphics.Camera
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color
use Libraries.Containers.Iterator
use Libraries.Interface.Controls.Scenes.Items.Highlights.SelectionHighlight3D
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D
use Libraries.Interface.Controls.Scenes.SceneConstants
use Libraries.Interface.Controls.Scenes.Items.EditorCursor
use Libraries.Game.Item3DDepthComparison
use Libraries.Game.Graphics.Worlds.TerrainItem
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain

/*
    This behavior is used to select an item in the scene editor. The input expected 
    by the scene editor to use this behavior is a left mouse click. If the user clicks 
    on the scene editor and there is a scene item there then the scene editor will try 
    to select that item. 
*/
class SelectScene3DItemBehavior is Behavior
    SceneConstants constants
    Item3DDepthComparison depthSorter

    action Run(BehaviorEvent event)
        MouseEvent mouse = event:GetMouseEvent()
        
        SceneEditor editor = cast(SceneEditor, event:GetItem())
        // While a terrain's tool is chosen, a click belongs to its cursor:
        // outside the ring it moves the cursor there; inside, it applies, as
        // a stroke while the button is held; holding anywhere applies too.
        // Escape leaves the tool; the scene tree still selects.
        // A new item's preview: a click on it places it; anywhere else
        // moves it there.
        if editor:HasActivePreview()
            editor:PressPreview(mouse:GetX(), mouse:GetY())
            return now
        end
        if editor:IsTerrainBrushActive()
            editor:PressTerrainCursor(mouse:GetX(), mouse:GetY())
            return now
        end
        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())

        EditorCamera3D camera = layer:GetEditorCamera()
        
        //Ray ray = camera:GetPickRay(mouse:GetX() - editor:GetGlobalX(), camera:GetHeight() - mouse:GetY() - editor:GetGlobalY())
        // GetPickRay mirrors x across the view, so the pointer's x is
        // mirrored first, as the terrain brush's picking does; otherwise the
        // click tests the mirrored place.
        number mirroredX = 2 * editor:GetGlobalX() + camera:GetWidth() - mouse:GetX()
        Ray ray = camera:GetPickRay(mirroredX, mouse:GetY(), editor:GetGlobalX(), editor:GetGlobalY(), camera:GetWidth(), camera:GetHeight())
        
        
        Vector3 origin = ray:GetOrigin()
        number viewportX = editor:GetGlobalX()
        number viewportY = editor:GetGlobalY()
        number viewportWidth = camera:GetWidth()
        number viewportHeight = camera:GetHeight()

        integer counter = 0
        Item3D temp = undefined
        Array<Item> targetArray
        
        // A terrain is picked where the ray meets its ground, not by a box:
        // its box would be all its regions.
        TerrainItem nearestTerrain = undefined
        number nearestTerrainDistance = 0
        Vector3 nearestTerrainHit = undefined

        Iterator<Item3D> items = layer:GetIterator()
        repeat while items:HasNext()
            temp = items:Next()
            if temp:HasProperty(constants:EDITOR_TAG) = false
                if temp is TerrainItem
                    TerrainItem terrain = cast(TerrainItem, temp)
                    Vector3 hit = terrain:GetWorldTerrain():GetData():RayCast(origin, ray:GetDirection(), camera:GetFar())
                    if hit not= undefined
                        number distance = hit:Distance(origin)
                        if nearestTerrain = undefined or distance < nearestTerrainDistance
                            nearestTerrain = terrain
                            nearestTerrainDistance = distance
                            nearestTerrainHit = hit
                        end
                    end
                elseif RayIntersectsItem(ray, temp)
                    targetArray:Add(temp)
                end
            end
        end
        
        Array<Item> result
        if targetArray:GetSize() not= 0
            depthSorter:SetOrigin(origin)
            targetArray:Sort(depthSorter)
            Item3D nearest = cast(Item3D, targetArray:Get(0))

            // The nearest item wins, unless the ground is hit before the
            // item's center.
            if nearestTerrain not= undefined and nearestTerrainDistance < origin:Distance(nearest:GetGlobalX(), nearest:GetGlobalY(), nearest:GetGlobalZ())
                result:Add(nearestTerrain)
            else
                result:Add(nearest)
            end
        elseif nearestTerrain not= undefined
            result:Add(nearestTerrain)
        end
        
        // A selected terrain with no tool: a click on its own ground, or on
        // nothing, moves its cursor; a click on another item selects it.
        if editor:IsTerrainCursorActive()
            if result:IsEmpty() or result:Get(0):Equals(editor:GetPointerTerrain())
                editor:PressTerrainCursor(mouse:GetX(), mouse:GetY())
                return now
            end
        end

        if not result:IsEmpty()
            // A click on the ground puts the cursor where it landed, rather
            // than at the terrain's middle, which may be far away.
            if result:Get(0) is TerrainItem and nearestTerrainHit not= undefined
                EditorCursor3D cursor = cast(EditorCursor3D, layer:GetCursor())
                cursor:SetPosition(nearestTerrainHit:GetX(), nearestTerrainHit:GetY(), nearestTerrainHit:GetZ())
                // The terrain cursor starts where the click landed.
                if result:Get(0) is EditorTerrain
                    EditorTerrain clickedTerrain = cast(EditorTerrain, result:Get(0))
                    clickedTerrain:SetBrushPosition(nearestTerrainHit:GetX(), nearestTerrainHit:GetZ())
                end
            end
            // A click selects without moving the camera; moving it is up
            // to the user.
            editor:SetKeepCameraOnSelection(true)
            editor:SetFilteredItems(result, true)
            editor:SetKeepCameraOnSelection(false)
        end
    end
    
    /*
    This action will test if the given ray intersects with an Item3D. This
    intersection is tested using the item's size times its scale, and its
    parents' scale, as an axis-aligned box. It does not turn with the item's
    rotation, and assumes the Item is a box-like shape.
    */
    private action RayIntersectsItem(Ray ray, Item3D item) returns boolean
        number divX = 1.0 / ray:GetDirection():GetX()
        number divY = 1.0 / ray:GetDirection():GetY()
        number divZ = 1.0 / ray:GetDirection():GetZ()

        // The item's size as it shows: its own size times its scale, and its
        // parents' scale, read from the lengths of its world transform's axes.
        Math math
        Matrix4 transform = item:GetTransform()
        number halfWidth = item:GetWidth() * 0.5 * math:SquareRoot(transform:row0column0 * transform:row0column0 + transform:row1column0 * transform:row1column0 + transform:row2column0 * transform:row2column0)
        number halfHeight = item:GetHeight() * 0.5 * math:SquareRoot(transform:row0column1 * transform:row0column1 + transform:row1column1 * transform:row1column1 + transform:row2column1 * transform:row2column1)
        number halfDepth = item:GetDepth() * 0.5 * math:SquareRoot(transform:row0column2 * transform:row0column2 + transform:row1column2 * transform:row1column2 + transform:row2column2 * transform:row2column2)

        number minX = ((item:GetGlobalX() - halfWidth) - ray:GetOrigin():GetX()) * divX
        number maxX = ((item:GetGlobalX() + halfWidth) - ray:GetOrigin():GetX()) * divX
        
        if minX > maxX
            number temp = minX
            minX = maxX
            maxX = temp
        end

        number minY = ((item:GetGlobalY() - halfHeight) - ray:GetOrigin():GetY()) * divY
        number maxY = ((item:GetGlobalY() + halfHeight) - ray:GetOrigin():GetY()) * divY

        if minY > maxY
            number temp = minY
            minY = maxY
            maxY = temp
        end

        number minZ = ((item:GetGlobalZ() - halfDepth) - ray:GetOrigin():GetZ()) * divZ
        number maxZ = ((item:GetGlobalZ() + halfDepth) - ray:GetOrigin():GetZ()) * divZ

        if minZ > maxZ
            number temp = minZ
            minZ = maxZ
            maxZ = temp
        end

        number min = minX
        if minY > min
            min = minY
        end
        if minZ > min
            min = minZ
        end

        number max = maxX
        if maxY < max
            max = maxY
        end
        if maxZ < max
            max = maxZ
        end

        return max >= 0 and max >= min
    end

end