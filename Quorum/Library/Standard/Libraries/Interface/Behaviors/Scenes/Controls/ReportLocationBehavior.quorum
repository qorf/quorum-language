package Libraries.Interface.Behaviors.Scenes.Controls

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Compute.Vector3
use Libraries.Interface.Item3D
use Libraries.Interface.Controls.Scenes.Items.EditorItem2D
use Libraries.Interface.Controls.Scenes.Items.EditorItem3D
use Libraries.Interface.Controls.Scenes.Items.Highlights.TerrainSelectionHighlight
use Libraries.Interface.Controls.Scenes.Items.EditorTerrain
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior
use Libraries.Game.Graphics.Worlds.TerrainDescriber

/*
    This behavior says where things are in the scene (Ctrl+Shift+1). With
    just the scene editor focused and nothing selected, it says the camera's
    position in the current layer. With an item focused, it says the item's
    position; with a terrain, its cursor's place. Positions are x, y and
    then z, each to one decimal place, as the terrain cursor says its
    place. In a 3D layer it is said through a view cue, a focus change,
    since an announcement often isn't read (SceneEditor:SayThroughViewCue).
*/
class ReportLocationBehavior is Behavior

    TerrainDescriber words

    action Run(BehaviorEvent event)
        if event:GetItem() is SceneEditor
            SceneEditor editor = cast(SceneEditor, event:GetItem())
            Vector3 position = editor:GetSelectedLayer():GetCamera():GetPosition()
            editor:SayThroughViewCue("Camera at " + FormatPlace(position:GetX(), position:GetY(), position:GetZ()), undefined)
        elseif event:GetItem() is TerrainSelectionHighlight
            TerrainSelectionHighlight highlight = cast(TerrainSelectionHighlight, event:GetItem())
            EditorTerrain terrain = highlight:GetEditorTerrain()
            text message = "Terrain"
            if terrain not= undefined
                // The same as the focus and a key's release.
                message = terrain:DescribeCursor()
            end
            Say(highlight:GetSceneEditor(), highlight, message)
        elseif event:GetItem() is EditorItem3D
            EditorItem3D item = cast(EditorItem3D, event:GetItem())
            Vector3 position = item:GetGlobalPosition()
            Say(item:GetSceneEditor(), item, item:GetName() + ", " + FormatPlace(position:GetX(), position:GetY(), position:GetZ()))
        elseif event:GetItem() is EditorItem2D
            EditorItem2D item = cast(EditorItem2D, event:GetItem())
            // A 2D layer has no view cues, so this is still announced.
            item:NotifyAccessibility(words:FormatAmount(item:GetGlobalX()) + ", " + words:FormatAmount(item:GetGlobalY()))
        end
    end

    /* Says a message about a 3D item through a view cue outlined on it, or announces it with no scene editor. */
    private action Say(SceneEditor editor, EditorItem3D item, text message)
        if editor not= undefined
            editor:SayThroughViewCue(message, item)
        else
            item:NotifyAccessibility(message)
        end
    end

    /* A 3D place, each number to one decimal place with no ".0": "41.3, 0.8, -7.5". */
    private action FormatPlace(number x, number y, number z) returns text
        return words:FormatAmount(x) + ", " + words:FormatAmount(y) + ", " + words:FormatAmount(z)
    end
end
