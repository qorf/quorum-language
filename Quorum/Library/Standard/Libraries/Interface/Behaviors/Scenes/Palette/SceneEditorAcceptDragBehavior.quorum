package Libraries.Interface.Behaviors.Scenes.Palette

use Libraries.Interface.Controls.Scenes.Blueprints.TerrainBlueprint
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.DragAndDropEvent
use Libraries.Interface.Item
use Libraries.Interface.Item2D
use Libraries.Interface.Item3D
use Libraries.Game.Graphics.Drawable
use Libraries.Containers.Array
use Libraries.Compute.Vector3
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer
use Libraries.Interface.Controls.Scenes.Blueprints.ItemBlueprint
use Libraries.Interface.Controls.Scenes.Blueprints.DrawableBlueprint
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer2D
use Libraries.Interface.Controls.Scenes.ScenePalette
use Libraries.Interface.Controls.Scenes.ScenePaletteItem
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.Previews.ItemPreview
use Libraries.Interface.Controls.Scenes.Items.Previews.ItemPreview3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Compute.Ray

class SceneEditorAcceptDragBehavior is Behavior
    
    ItemPreview currentPreview = undefined
    

action Run(BehaviorEvent event)
        DragAndDropEvent dropEvent = event:GetDragAndDropEvent()
        Item received = dropEvent:GetDestination()
        SceneEditor editor = undefined
        
        if received is SceneEditor
            editor = cast(SceneEditor, received)
        else
            return now
        end
        
        
        Item source = dropEvent:GetSource()
        Item2D item = undefined
        if source is Item2D
            item = cast(Item2D, dropEvent:GetSource())
            repeat until item = undefined or item is ScenePaletteItem
                item = item:GetParent()
            end
        end

        if item = undefined
            return now
        end

        ScenePaletteItem paletteItem = cast(ScenePaletteItem, item)
        ScenePalette palette = paletteItem:GetPalette()
        ItemBlueprint schematic = paletteItem:GetItemBlueprint()
        
        if dropEvent:eventType = dropEvent:DRAGGING_CONTINUED
            if currentPreview not= undefined and editor:GetSelectedLayer() is EditorLayer3D
                // for now we're assuming the preview was made at the cursor position
                // and we're only go to move the X and Z and leave Y alone
                EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
                EditorCamera3D camera = layer:GetEditorCamera()
                number planeY = currentPreview:GetY()
                number hitX = 0
                number hitZ = 0
                //Ray pickRay = camera:GetPickRay(dropEvent:GetX(),dropEvent:GetY())
                // GetPickRay mirrors x across the view, so the pointer's x is
                // mirrored first, or the item lands on the mirrored side.
                number mirroredX = 2 * editor:GetGlobalX() + camera:GetWidth() - dropEvent:GetX()
                Ray pickRay = camera:GetPickRay(mirroredX, dropEvent:GetY(), editor:GetGlobalX(), editor:GetGlobalY(), camera:GetWidth(), camera:GetHeight())
if pickRay:GetDirection():GetY() not= 0
                    number t = (planeY - pickRay:GetOrigin():GetY()) / pickRay:GetDirection():GetY()
                    if t >= 0
                        hitX = pickRay:GetOrigin():GetX() + pickRay:GetDirection():GetX() * t
                        hitZ = pickRay:GetOrigin():GetZ() + pickRay:GetDirection():GetZ() * t
end
end
                // Over a terrain, the item goes where the pointer meets the
                // ground and rests on it (Items on terrain, phase 1).
                Vector3 groundHit = editor:PickGround(dropEvent:GetX(), dropEvent:GetY())
                if groundHit not= undefined
                    hitX = groundHit:GetX()
                    hitZ = groundHit:GetZ()
                end
                hitX = layer:GetPreviousGridCoordinate(hitX)
                hitZ = layer:GetPreviousGridCoordinate(hitZ)
                
                currentPreview:SetX(hitX)
                currentPreview:SetZ(hitZ)
                if groundHit not= undefined and currentPreview is ItemPreview3D
                    ItemPreview3D groundPreview = cast(ItemPreview3D, currentPreview)
                    editor:PutOnGround(groundPreview, groundPreview)
                end
            end
        elseif schematic is TerrainBlueprint
            // A terrain has no preview to move around: its icon follows the
            // pointer, and dropping it adds the terrain, flat, at the origin.
            if dropEvent:eventType = dropEvent:DROPPED
                if palette:GetDraggedItem() not= undefined
                    palette:GetDraggedItem():Show()
                end
                editor:AddTerrain(cast(TerrainBlueprint, schematic))
            end
        elseif dropEvent:eventType = dropEvent:DRAGGED_OFF_DESTINATION
            if editor:GetSelectedLayer() is EditorLayer3D
                if currentPreview not= undefined
                    editor:CancelItemPreview(currentPreview)
                    currentPreview = undefined
                    if palette:GetDraggedItem() not= undefined
                        palette:GetDraggedItem():Show()
                    end
                end
            end
        elseif dropEvent:eventType = dropEvent:DRAGGED_ONTO_DESTINATION
            if editor:GetSelectedLayer() is EditorLayer3D
                currentPreview = editor:CreateItemPreview(schematic)
                if palette:GetDraggedItem() not= undefined
                    palette:GetDraggedItem():Hide()
                end
            end
        elseif dropEvent:eventType = dropEvent:DROPPED
            if editor:GetSelectedLayer() is EditorLayer3D
                if currentPreview not= undefined
                    editor:ConfirmItemPreview(currentPreview)
                    editor:CancelItemPreview(currentPreview)
                    currentPreview = undefined
                end
            end
    end
    end

end