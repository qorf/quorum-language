package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Dialogs.LayerPhysicsPropertiesDialog

/*
    The LayerPhysicsButtonBehavior is the Physics in games checkbox in a
    layer's Physics section. It tells the section when it is checked or
    unchecked.
*/
class LayerPhysicsButtonBehavior is Behavior
    LayerPhysicsPropertiesDialog dialog = undefined

    /*
        Sets the section the checkbox is in.

        Attribute: Parameter dialog The layer's Physics section
    */
    action SetDialog(LayerPhysicsPropertiesDialog dialog)
        me:dialog = dialog
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:CheckboxChanged()
        end
    end

    /*
        A checkbox runs its behavior only when it is checked, and calls
        Dispose when it is unchecked, so unchecking is passed on the same
        way. The section reads the checkbox's state.
    */
    action Dispose
        if dialog not= undefined
            dialog:CheckboxChanged()
        end
    end
end
