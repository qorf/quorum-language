package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Dialogs.SkyPropertiesDialog

/*
    The SkyButtonBehavior is a button in a 3D layer's Sky section
    (QuincyWorld demo D3): "Choose sky folder..." or "Remove sky". It tells
    the section which was pressed.
*/
class SkyButtonBehavior is Behavior
    SkyPropertiesDialog dialog = undefined
    integer kind = 0

    /*
        Sets which section and button this is.

        Attribute: Parameter dialog The Sky section
        Attribute: Parameter kind One of the section's button kinds, such as CHOOSE_FOLDER
    */
    action Setup(SkyPropertiesDialog dialog, integer kind)
        me:dialog = dialog
        me:kind = kind
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:ButtonActivated(kind)
        end
    end
end
