package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainWaterPropertiesDialog

/*
    The TerrainWaterButtonBehavior is a button or checkbox in a terrain's
    Water section: the Sea checkbox, "Add lake", a lake's
    "Remove", or "Look..." and its Close. It tells the section which was
    pressed.
*/
class TerrainWaterButtonBehavior is Behavior
    // True for a checkbox's behavior, which also passes on unchecking.
    boolean checkbox = false
    TerrainWaterPropertiesDialog dialog = undefined
    integer kind = 0
    integer lake = 0

    /*
        Sets which section and button this is.

        Attribute: Parameter dialog The Water section
        Attribute: Parameter kind One of the section's button kinds, such as REMOVE_LAKE
        Attribute: Parameter lake The lake, from 0, for a lake's button
    */
    action Setup(TerrainWaterPropertiesDialog dialog, integer kind, integer lake)
        me:dialog = dialog
        me:kind = kind
        me:lake = lake
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:ButtonActivated(kind, lake)
        end
    end

    /*
        A checkbox runs its behavior only when it is checked, and calls
        Dispose when it is unchecked, so unchecking is passed on the same
        way. The section reads the checkbox's state, so it sees the change.
    */
    action Dispose
        if checkbox and dialog not= undefined
            dialog:ButtonActivated(kind, lake)
        end
    end

    /*
        Marks the behavior as a checkbox's, so unchecking is passed on too.
        A button's behavior may be disposed with its button, which mustn't
        press it.

        Attribute: Parameter value True for a checkbox's behavior
    */
    action SetCheckbox(boolean value)
        checkbox = value
    end
end
