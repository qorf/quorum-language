package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainFoliagePropertiesDialog

/*
    The TerrainFoliageButtonBehavior is a button or checkbox in a terrain's
    Foliage section (Terrain plan F3): "Add asset...", an asset's "Paint",
    "Settings..." or "Remove", its arrows, or one of its settings' checkboxes.
    It tells the section which was pressed.
*/
class TerrainFoliageButtonBehavior is Behavior
    // True for a checkbox's behavior, which also passes on unchecking.
    boolean checkbox = false
    TerrainFoliagePropertiesDialog dialog = undefined
    integer kind = 0
    integer asset = 0

    /*
        Sets which section and button this is.

        Attribute: Parameter dialog The Foliage section
        Attribute: Parameter kind One of the section's button kinds, such as ADD
        Attribute: Parameter asset The asset, from 0, for an asset's buttons
    */
    action Setup(TerrainFoliagePropertiesDialog dialog, integer kind, integer asset)
        me:dialog = dialog
        me:kind = kind
        me:asset = asset
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:ButtonActivated(kind, asset)
        end
    end

    /*
        A checkbox runs its behavior only when it is checked, and calls
        Dispose when it is unchecked, so unchecking is passed on the same
        way. The section reads the checkbox's state, so it sees the change.
    */
    action Dispose
        if checkbox and dialog not= undefined
            dialog:ButtonActivated(kind, asset)
        end
    end

    /*
        Marks the behavior as a checkbox's, so unchecking is passed on too.
        A button's behavior may be disposed with its button, which mustn't
        press it.

        Attribute: Parameter value True for a checkbox's behavior
    */
    action SetCheckbox(boolean value)
        checkbox = value
    end
end
