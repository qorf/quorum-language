package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Scenes.Dialogs.Item3DPropertiesDialog

/*
    This behavior is the "Lean with the slope" checkbox in a new item's
    preview's Properties: checked, the preview leans with the ground's
    slope when the pointer sets it on the ground. A checkbox runs its behavior when checked and
    calls Dispose when unchecked, so both pass the change on.
*/
class PropertiesLeanWithSlopeBehavior is Behavior
    Item3DPropertiesDialog dialog = undefined

    /*
        Sets the dialog the checkbox is in.

        Attribute: Parameter properties The dialog
    */
    action SetDialog(Item3DPropertiesDialog properties)
        dialog = properties
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:SetLeanWithSlope(true)
        end
    end

    action Dispose
        if dialog not= undefined
            dialog:SetLeanWithSlope(false)
        end
    end
end
