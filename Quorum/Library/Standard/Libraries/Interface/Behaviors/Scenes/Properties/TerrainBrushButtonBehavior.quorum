package Libraries.Interface.Behaviors.Scenes.Properties

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.Dialogs.TerrainBrushPropertiesDialog

/*
    The TerrainBrushButtonBehavior is a button in a terrain's Brush section
    (step 8): "Use Height Under Brush". It tells the section it was
    pressed.
*/
class TerrainBrushButtonBehavior is Behavior
    TerrainBrushPropertiesDialog dialog = undefined
    integer kind = 0

    /*
        Sets which section and button this is.

        Attribute: Parameter dialog The Brush section
        Attribute: Parameter kind The section's TAKE_HEIGHT
    */
    action Setup(TerrainBrushPropertiesDialog dialog, integer kind)
        me:dialog = dialog
        me:kind = kind
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:ButtonActivated(kind)
        end
    end
end
