package Libraries.Interface.Undo

use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Game.Graphics.Models.Vulkan.EnvironmentVulkan

/*
    The SceneEditorLinearLightingEdit is one change to a 3D layer's linear
    lighting in the scene editor's undo list: turned
    on or off. It holds the setting before and after, gives the layer's
    environment one or the other, then has the scene editor show it and say
    what happened.
*/
class SceneEditorLinearLightingEdit is Edit
    SceneEditor controller = undefined
    EditorLayer3D layer = undefined
    boolean before = true
    boolean after = true
    text name = ""

    /*
        Sets up the edit.

        Attribute: Parameter controller The scene editor
        Attribute: Parameter layer The layer whose lighting changed
        Attribute: Parameter before Whether lighting was linear before
        Attribute: Parameter after Whether it is linear after
        Attribute: Parameter changeName What changed, such as "turn on linear lighting"
    */
    action Create(SceneEditor controller, EditorLayer3D layer, boolean before, boolean after, text changeName)
        me:controller = controller
        me:layer = layer
        me:before = before
        me:after = after
        name = changeName
    end

    action Undo
        Put(before)
        controller:SkyEdited(layer, "Undid " + name)
    end

    action Redo
        Put(after)
        controller:SkyEdited(layer, "Redid " + name)
    end

    /*
        Gives the layer's environment a setting.
    */
    private action Put(boolean linear)
        if layer:GetEnvironment() is EnvironmentVulkan
            EnvironmentVulkan environment = cast(EnvironmentVulkan, layer:GetEnvironment())
            environment:SetLinearLighting(linear)
        end
    end

    action GetUndoName returns text
        return "Undo " + name
    end

    action GetRedoName returns text
        return "Redo " + name
    end

    action Dispose
    end
end
