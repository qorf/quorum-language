package Libraries.Interface.Options

use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Gradient

/*
    This is the default set of options for a light mode style color approach. 
*/
class LightModeOptions is InterfaceOptions
    on create
        Color color
        constant number MAX = 255.0
        SetFontColor(color:Black())
        SetSelectionFontColor(color:White())
        Color defaultSelectionColor = color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1)
        //Color defaultSelectionColor = color:CustomColor(87.0 / MAX, 145.0 / MAX, 245.0 / MAX, 1)
        SetSelectionColor(defaultSelectionColor)
        SetBorderColor(color:Black())
        SetIconColor(color:White())
        SetForegroundColor(color:White())

        Gradient backgroundGradient
        Color gray = color:LightGray()
        Color lightGray = color:CustomColor(234.0 / MAX, 234.0 / MAX, 234.0 / MAX, 1)
        backgroundGradient:Set(lightGray, lightGray, lightGray, lightGray)
        SetBackgroundColor(backgroundGradient)

        Gradient mouseOverGradient
        Color mouseOver = color:CustomColor(224.0 / MAX, 220.0 / MAX, 224.0 / MAX, 1)
        mouseOverGradient:Set(mouseOver, mouseOver, mouseOver, mouseOver)
        SetMouseOverColor(mouseOverGradient)

        // Default shadow values.
        SetShadowColor(color:CustomColor(0, 0, 0, 0.5))
        SetShadowX(6)
        SetShadowY(-6)
        SetShadowEdgeFade(3)

        // Button specific colors.
        Color acceptBlue = color:CustomColor(1.0/MAX, 115.0/MAX, 163.0/MAX, 1)
        Color greyBorder = color:CustomColor(110.0/MAX, 110.0/MAX, 110.0/MAX, 1)
        Color darkFont = color:CustomColor(32.0 / MAX, 32.0 / MAX, 32.0 / MAX, 1)
        Color lightFont = color:CustomColor(246.0 / MAX, 246.0 / MAX, 246.0 / MAX, 1)
        Color controlBackground = color:CustomColor(215.0 / MAX, 215.0 / MAX, 215.0 / MAX, 1)
        Color hoverBlue = color:CustomColor(179.0 / MAX, 208.0 / MAX, 221.0 / MAX, 1)
        Color darkBlue = color:CustomColor(49.0/MAX, 113.0/MAX, 159.0/MAX, 1)

        Color blackFont = color:Black()
        Color white = color:White()
        Color darkBorder = color:CustomColor(32.0 / MAX, 32.0 / MAX, 32.0 / MAX, 1)

        number defaultButtonRounding = 0.5
        //Buttons (L2): a white-to-light-gray gradient, a thin gray edge, a
        //2-point accent line along the top (its own shape, hidden while
        //focused), and a soft shadow below. Focus draws a 2-point ring all
        //the way around.
        Color sideEdge = color:CustomColor(140.0 / MAX, 147.0 / MAX, 156.0 / MAX, 1)
        Color accentLine = color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1)
        Color focusRing = color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1)
        Gradient buttonFill
        buttonFill:Set(color:CustomColor(238.0 / MAX, 240.0 / MAX, 243.0 / MAX, 1), color:CustomColor(238.0 / MAX, 240.0 / MAX, 243.0 / MAX, 1),
            color:CustomColor(255.0 / MAX, 255.0 / MAX, 255.0 / MAX, 1), color:CustomColor(255.0 / MAX, 255.0 / MAX, 255.0 / MAX, 1))
        Gradient buttonHover
        buttonHover:Set(color:CustomColor(226.0 / MAX, 231.0 / MAX, 238.0 / MAX, 1), color:CustomColor(226.0 / MAX, 231.0 / MAX, 238.0 / MAX, 1),
            color:CustomColor(248.0 / MAX, 250.0 / MAX, 253.0 / MAX, 1), color:CustomColor(248.0 / MAX, 250.0 / MAX, 253.0 / MAX, 1))
        Gradient buttonDown
        buttonDown:Set(color:CustomColor(240.0 / MAX, 242.0 / MAX, 245.0 / MAX, 1), color:CustomColor(240.0 / MAX, 242.0 / MAX, 245.0 / MAX, 1),
            color:CustomColor(214.0 / MAX, 219.0 / MAX, 226.0 / MAX, 1), color:CustomColor(214.0 / MAX, 219.0 / MAX, 226.0 / MAX, 1))
        SetButtonBorderThickness(1)
        SetButtonFocusBorderThickness(2)
        SetButtonBackgroundColor(buttonFill)
        SetButtonBorderColor(sideEdge)
        SetButtonFontColor(blackFont)
        SetButtonTopLeftRounding(defaultButtonRounding)
        SetButtonTopRightRounding(defaultButtonRounding)
        SetButtonBottomLeftRounding(defaultButtonRounding)
        SetButtonBottomRightRounding(defaultButtonRounding)
        SetButtonMouseOverColor(buttonHover)
        SetButtonMouseOverBorderColor(sideEdge)
        SetButtonMouseDownColor(buttonDown)
        SetButtonFocusColor(buttonFill)
        SetButtonFocusFontColor(blackFont)
        SetButtonFocusBorderColor(focusRing)
        SetButtonTopAccent(true)
        SetButtonTopAccentColor(accentLine)
        SetButtonRaised(true)
        SetButtonShadowColor(color:CustomColor(0, 0, 0, 0.15))
        SetButtonShadowX(0)
        SetButtonShadowY(-2)
        SetButtonShadowWidth(0)
        SetButtonShadowHeight(0)
        SetButtonShadowEdgeFade(3)

        // ToggleButton properties.
        SetToggleButtonBorderThickness(1)
        SetToggleButtonBackgroundColor(white)
        SetToggleButtonBorderColor(darkBorder)
        SetToggleButtonFontColor(blackFont)
        SetToggleButtonTopLeftRounding(defaultButtonRounding)
        SetToggleButtonTopRightRounding(defaultButtonRounding)
        SetToggleButtonBottomLeftRounding(defaultButtonRounding)
        SetToggleButtonBottomRightRounding(defaultButtonRounding)
        SetToggleButtonMouseOverColor(hoverBlue)

        // The color when the button is focused but not selected.
        SetToggleButtonFocusColor(darkBlue)
        SetToggleButtonFocusFontColor(lightFont)
        SetToggleButtonFocusBorderColor(acceptBlue)

        // The color when the button is selected but not focused.
        SetToggleButtonUnfocusedSelectionColor(acceptBlue)
        SetToggleButtonUnfocusedSelectionFontColor(lightFont)

        // The color when the button is focused and selected.
        SetToggleButtonSelectionColor(color:Blue())

        // Cell specific colors.
        SetCellBackgroundColor(color:White())

        // Checkbox specific colors.
        SetCheckboxBorderThickness(2)
        SetCheckboxTopLeftRounding(defaultButtonRounding)
        SetCheckboxTopRightRounding(defaultButtonRounding)
        SetCheckboxBottomLeftRounding(defaultButtonRounding)
        SetCheckboxBottomRightRounding(defaultButtonRounding)
        // box color
        SetCheckboxBackgroundColor(color:White())
        // box color while checked
        // Checks and radio choices use the accent, like main buttons (K3).
        SetCheckboxSelectionColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetCheckboxFocusColor(color:CustomColor(0,0,0,0))
        // CD: the focused box's edge and the line under its label.
        SetCheckboxFocusBorderColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetCheckboxUnfocusedSelectionColor(color:CustomColor(0,0,0,0))
        // border color for box
        SetCheckboxBorderColor(color:CustomColor(118.0 / MAX,118.0 / MAX,118.0 / MAX,1))
        // checkmark color
        SetCheckboxSelectionBorderColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetCheckboxAccentColor(color:CustomColor(0.0 / MAX, 0.0 / MAX, 0.0 / MAX, 1))

        // ScrollPane specific colors.
        Color sidePanel = color:CustomColor(244.0 / MAX, 243.0 / MAX, 243.0 / MAX, 1)
        SetScrollPaneBackgroundColor(lightGray)
        SetScrollPaneForegroundColor(sidePanel)
        SetScrollPaneAccentColor(color:CustomColor(121.0 / MAX, 121.0 / MAX, 121.0 / MAX, 1))

        // ProgressBar (P3): an outlined pill with the accent fill. Focus
        // keeps the track's color and adds the 2-point ring.
        Color progressTrack = color:CustomColor(242.0 / MAX, 243.0 / MAX, 245.0 / MAX, 1)
        SetProgressBarBackgroundColor(progressTrack)
        SetProgressBarBorderColor(color:CustomColor(140.0 / MAX, 147.0 / MAX, 156.0 / MAX, 1))
        SetProgressBarForegroundColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetFocusColor("ProgressBar", progressTrack)
        SetFocusBorderColor("ProgressBar", color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetFocusBorderThickness("ProgressBar", 2)

        // RadioButton specific colors.
        SetRadioButtonBackgroundColor(color:CustomColor(211.0/255.0, 211.0/255.0, 211.0/255.0, 1))
        SetRadioButtonBorderColor(color:CustomColor(118.0/255.0, 118.0/255.0, 118.0/255.0, 1))
        SetRadioButtonSelectionColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetRadioButtonSelectionBorderColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetRadioButtonFontColor(color:Black())
        SetRadioButtonSelectionFontColor(color:Black())
        SetRadioButtonBorderThickness(1)
        // G3: a group of choices sits on a faint track; focus marks the
        // group (left line) and the option (circle edge and underline).
        SetBackgroundColor("ChoiceGroup", color:CustomColor(242.0 / MAX, 243.0 / MAX, 245.0 / MAX, 1))
        SetFocusBorderColor("RadioButton", color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))

        // TabBar specific colors.
        SetTabBarBackgroundColor(color:CustomColor(224.0 / MAX, 224.0 / MAX, 224.0 / MAX, 1))
        SetTabBarBorderColor(color:Black())

        //TABS
        SetTabBackgroundColor(color:CustomColor(229.0 / MAX, 229.0 / MAX, 229.0 / MAX, 1))
        //The selected tab joins the panel below it: white, like the editor,
        //with an accent line across its top (gray when its pane doesn't have
        //the focus). The others sit back with dimmer text, are tinted under
        //the mouse, and have a quiet gray close button (the foreground is the
        //close button's circle, the accent its X).
        Color tabMutedText = color:CustomColor(90.0 / MAX, 90.0 / MAX, 90.0 / MAX, 1)
        SetTabFontColor(tabMutedText)
        SetTabSelectionColor(color:White())
        // The selected tab's name has a hint of the accent blue (T3) while
        // its file has the focus.
        SetTabSelectionFontColor(color:CustomColor(24.0 / MAX, 58.0 / MAX, 102.0 / MAX, 1))
        SetTabFocusColor(color:CustomColor(126.0 / MAX, 167.0 / MAX, 191.0 / MAX, 1))
        SetTabForegroundColor(color:CustomColor(0, 0, 0, 0))
        SetTabAccentColor(color:CustomColor(107.0 / MAX, 107.0 / MAX, 107.0 / MAX, 1))
        SetTabUnfocusedSelectionColor(color:White())
        SetTabUnfocusedSelectionFontColor(color:Black())
        SetTabMouseOverColor(color:CustomColor(214.0 / MAX, 214.0 / MAX, 214.0 / MAX, 1))

        SetTabBorderThickness(0)
        SetTabSelectionBorderThickness(2)
        SetTabSelectionBorderColor(defaultSelectionColor)
        SetTabUnfocusedSelectionBorderColor(color:CustomColor(180.0 / MAX, 180.0 / MAX, 180.0 / MAX, 1))
        SetTabTopLeftRounding(0.5)
        SetTabTopRightRounding(0.5)

        //TREES
        //Trees use the control label to represent their selection when
        //they do not have the focus. 
        SetTreeItemUnfocusedSelectionFontColor(color:Black())
        SetTreeItemUnfocusedSelectionColor(color:CustomColor(213.0 / MAX, 213.0 / MAX, 213.0 / MAX, 1))

        //The arrow to the tree uses the accent color.
        SetTreeItemAccentColor(color:CustomColor(124.0 / MAX, 127.0 / MAX, 134.0 / MAX, 1))

        //A row's selection and hover are a rounded band across the tree
        //(TreeRowHighlight). The hover is a soft neutral tint.
        SetTreeItemMouseOverColor(color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1))
        SetTreeItemTopLeftRounding(0.3)
        SetTreeItemTopRightRounding(0.3)
        SetTreeItemBottomLeftRounding(0.3)
        SetTreeItemBottomRightRounding(0.3)


        //MENUS
        SetMenuItemBackgroundColor(color:CustomColor(0.0 / MAX, 0.0 / MAX, 0.0 / MAX, 0))
        SetMenuItemBorderColor(color:CustomColor(0.0 / MAX, 0.0 / MAX, 0.0 / MAX, 0))
        // M4: the trees' hover gray for hover and selection, with the
        // selected item's 3-point accent tag at its left.
        Color menuHover = color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1)
        SetMenuItemSelectionColor(menuHover)
        SetMenuItemMouseOverColor(menuHover)
        SetSelectionFontColor("MenuItem", color:Black())
        SetBorderThickness("MenuItem", 0)
        SetSelectionBorderThickness("MenuItem", 3)
        SetSelectionBorderColor("MenuItem", color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetTopLeftRounding("MenuItem", 0.3)
        SetTopRightRounding("MenuItem", 0.3)
        SetBottomLeftRounding("MenuItem", 0.3)
        SetBottomRightRounding("MenuItem", 0.3)
        // The menu panel's rounded corners (M4).
        SetTopLeftPixelRounding("MenuPanel", 6)
        SetTopRightPixelRounding("MenuPanel", 6)
        SetBottomLeftPixelRounding("MenuPanel", 6)
        SetBottomRightPixelRounding("MenuPanel", 6)

        //TEXTBOX
        SetTextBoxBackgroundColor(color:White())
        SetTextBoxFontColor(color:Black())
        SetTextBoxForegroundColor(sidePanel)
        SetTextBoxAccentColor(color:CustomColor(121.0 / MAX, 121.0 / MAX, 121.0 / MAX, 1))
        SetTextBoxIconColor(GetTextBoxFontColor())

        //TEXT FIELD
        // A 1.5-point edge that reads on white (4.2 to 1). Focus adds the
        // accent edge and the thick line on the left (FD).
        SetTextFieldBorderThickness(1.5)
        SetTextFieldTopLeftRounding(defaultButtonRounding)
        SetTextFieldTopRightRounding(defaultButtonRounding)
        SetTextFieldBottomLeftRounding(defaultButtonRounding)
        SetTextFieldBottomRightRounding(defaultButtonRounding)
        SetTextFieldBorderColor(color:CustomColor(118.0 / MAX, 124.0 / MAX, 132.0 / MAX, 1))
        SetTextFieldFocusBorderColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        SetTextFieldBackgroundColor(color:White())
        // H3 hover: a soft band behind a checkbox or radio button and its
        // label, and a firmer edge on the box, circle or field.
        Color hoverBand = color:CustomColor(236.0 / MAX, 236.0 / MAX, 236.0 / MAX, 1)
        Color hoverEdge = color:CustomColor(63.0 / MAX, 68.0 / MAX, 74.0 / MAX, 1)
        SetCheckboxMouseOverColor(hoverBand)
        SetCheckboxMouseOverBorderColor(hoverEdge)
        SetRadioButtonMouseOverColor(hoverBand)
        SetRadioButtonMouseOverBorderColor(hoverEdge)
        SetTextFieldMouseOverBorderColor(hoverEdge)
        // The field's own background, so only its edge changes.
        SetTextFieldMouseOverColor(color:White())
        SetTextFieldFontColor(color:Black())
        SetTextFieldIconColor(GetTextFieldFontColor())

        // CodeEditor specific options.
        SetCodeEditorBackgroundColor(color:White())
        SetCodeEditorFontColor(color:Black())
        SetCodeEditorForegroundColor(sidePanel)
        SetCodeEditorAccentColor(color:CustomColor(121.0 / MAX, 121.0 / MAX, 121.0 / MAX, 1))
        SetCodeEditorIconColor(GetTextBoxFontColor())
SetCodeEditorSelectionColor(color:Black())

        // TreeTableCell specific colors.
        SetTreeTableCellBackgroundColor(color:White())
        SetTreeTableCellSelectionColor(color:CustomColor(9.0 / 255.0, 80.0/255.0, 208.0/255.0, 1))
        SetTreeTableCellFontColor(color:Black())
        SetTreeTableCellSelectionFontColor(color:White())
        SetTreeTableCellBorderColor(color:Black())
        SetTreeTableCellUnfocusedSelectionColor(color:CustomColor(190.0 / 255.0, 190.0 / 255.0, 228.0 / 255.0, 1))
        SetTreeTableCellUnfocusedSelectionFontColor(color:Black())

        // Gutter specific colors.
        SetGutterBackgroundColor(color:CustomColor(229.0/255.0, 229.0/255.0, 229.0/255.0, 1))
        SetGutterBorderColor(color:CustomColor(142.0/255.0, 142.0/255.0, 142.0/255.0, 1))
        SetGutterFontColor(color:Black())
        SetGutterAccentColor(color:CustomColor(237.0 / MAX, 113.0 / MAX, 107.0 / MAX, 1))
        SetGutterSelectionColor(color:CustomColor(0.5, 0.75, 0.59, 1))

        // List specific colors.
        SetListBackgroundColor(GetTextBoxBackgroundColor())
        SetListForegroundColor(GetTextBoxForegroundColor())
        SetListAccentColor(GetTextBoxAccentColor())
        SetListSelectionColor(GetTextBoxSelectionColor())

        // ListItem specific colors.
        SetListItemBackgroundColor(color:CustomColor(1, 1, 1, 0))

        // A list's box is slightly rounded, and its items' selection and
        // hover are rounded bands inside it, as tree rows are. The hover is a
        // soft neutral tint over the list's background.
        SetListItemMouseOverColor(color:CustomColor(237.0 / MAX, 237.0 / MAX, 237.0 / MAX, 1))
        // LS5: a selected item is a faint accent wash while its list has
        // the focus, and the trees' gray when it doesn't.
        SetSelectionColor("ListItem", color:CustomColor(220.0 / MAX, 233.0 / MAX, 246.0 / MAX, 1))
        SetSelectionFontColor("ListItem", color:CustomColor(24.0 / MAX, 58.0 / MAX, 102.0 / MAX, 1))
        SetUnfocusedSelectionColor("ListItem", color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1))
        SetUnfocusedSelectionFontColor("ListItem", GetTextBoxFontColor())
        SetFocusBorderColor("List", color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        // A fixed radius, so the box's corners show however tall it is.
        SetListTopLeftPixelRounding(8)
        SetListTopRightPixelRounding(8)
        SetListBottomLeftPixelRounding(8)
        SetListBottomRightPixelRounding(8)
        SetListItemTopLeftRounding(0.3)
        SetListItemTopRightRounding(0.3)
        SetListItemBottomLeftRounding(0.3)
        SetListItemBottomRightRounding(0.3)

        // Dialog colors.
        SetDialogShadowColor(color:CustomColor(0, 0, 0, 0.5))
        SetDialogShadowX(6)
        SetDialogShadowY(-6)
        SetDialogShadowEdgeFade(3)
        SetDialogBorderColor(greyBorder)
        SetDialogBorderThickness(1)
        SetDialogTopLeftRounding(0.04)
        SetDialogTopRightRounding(0.04)
        SetDialogBottomLeftRounding(0.04)
        SetDialogBottomRightRounding(0.04)

        // Dialog bar specific colors.
        SetDialogBarBackgroundColor(color:CustomColor(234.0 / MAX, 234.0 / MAX, 234.0 / MAX, 1))
        SetDialogBarBorderThickness(1)
        SetDialogBarBorderColor(greyBorder)
        SetDialogBarTopRightPixelRounding(8)
        SetDialogBarTopLeftPixelRounding(8)
        SetDialogBarForegroundColor(color:CustomColor(237.0 / MAX, 113.0 / MAX, 107.0 / MAX, 1))
        SetDialogBarAccentColor(color:White())
        SetDialogBarFontColor(color:Black())

        // The dialog close button: no fill until hovered or focused.
        Color closeClear = color:CustomColor(0, 0, 0, 0)
        SetBackgroundColor("DialogClose", closeClear)
        SetBorderColor("DialogClose", closeClear)
        SetBorderThickness("DialogClose", 2)
        // X1: the trees' and menus' hover gray behind the X.
        SetMouseOverColor("DialogClose", color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1))
        SetMouseOverBorderColor("DialogClose", color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1))
        SetFocusColor("DialogClose", closeClear)
        SetFocusBorderColor("DialogClose", focusRing)
        SetTopLeftPixelRounding("DialogClose", 6)
        SetTopRightPixelRounding("DialogClose", 6)
        SetBottomLeftPixelRounding("DialogClose", 6)
        SetBottomRightPixelRounding("DialogClose", 6)
        // A tab's close X gets the same hover square, with smaller corners.
        Color tabCloseClear = color:CustomColor(0, 0, 0, 0)
        SetBackgroundColor("TabClose", tabCloseClear)
        SetBorderColor("TabClose", tabCloseClear)
        SetBorderThickness("TabClose", 0)
        SetMouseOverColor("TabClose", color:CustomColor(218.0 / MAX, 218.0 / MAX, 218.0 / MAX, 1))
        SetTopLeftPixelRounding("TabClose", 4)
        SetTopRightPixelRounding("TabClose", 4)
        SetBottomLeftPixelRounding("TabClose", 4)
        SetBottomRightPixelRounding("TabClose", 4)

        // Dialog accept button (the main action): the accent fill, white
        // text, and a ring when focused.
        Color acceptFill = color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1)
        Color acceptHover = color:CustomColor(31.0 / MAX, 102.0 / MAX, 168.0 / MAX, 1)
        Gradient acceptGradient
        acceptGradient:Set(color:CustomColor(31.0 / MAX, 103.0 / MAX, 181.0 / MAX, 1), color:CustomColor(31.0 / MAX, 103.0 / MAX, 181.0 / MAX, 1),
            color:CustomColor(59.0 / MAX, 134.0 / MAX, 214.0 / MAX, 1), color:CustomColor(59.0 / MAX, 134.0 / MAX, 214.0 / MAX, 1))
        Gradient acceptHoverGradient
        acceptHoverGradient:Set(color:CustomColor(40.0 / MAX, 112.0 / MAX, 190.0 / MAX, 1), color:CustomColor(40.0 / MAX, 112.0 / MAX, 190.0 / MAX, 1),
            color:CustomColor(70.0 / MAX, 144.0 / MAX, 222.0 / MAX, 1), color:CustomColor(70.0 / MAX, 144.0 / MAX, 222.0 / MAX, 1))
        SetDialogAcceptButtonBorderThickness(2)
        SetDialogAcceptButtonTopLeftRounding(defaultButtonRounding)
        SetDialogAcceptButtonTopRightRounding(defaultButtonRounding)
        SetDialogAcceptButtonBottomLeftRounding(defaultButtonRounding)
        SetDialogAcceptButtonBottomRightRounding(defaultButtonRounding)
        SetDialogAcceptButtonBackgroundColor(acceptGradient)
        SetDialogAcceptButtonBorderColor(acceptFill)
        SetDialogAcceptButtonFontColor(color:White())
        SetDialogAcceptButtonMouseOverColor(acceptHoverGradient)
        SetDialogAcceptButtonMouseOverBorderColor(acceptHover)
        SetDialogAcceptButtonMouseDownColor(color:CustomColor(26.0 / MAX, 88.0 / MAX, 146.0 / MAX, 1))
        SetDialogAcceptButtonFocusColor(acceptGradient)
        SetDialogAcceptButtonFocusFontColor(color:White())
        SetDialogAcceptButtonFocusBorderColor(color:CustomColor(20.0 / MAX, 60.0 / MAX, 110.0 / MAX, 1))
        // Raised like the other buttons, without the accent line.
        SetDialogAcceptButtonRaised(true)
        SetShadowColor("DialogAcceptButton", color:CustomColor(0, 0, 0, 0.25))
        SetShadowX("DialogAcceptButton", 0)
        SetShadowY("DialogAcceptButton", -2)
        SetShadowWidth("DialogAcceptButton", 0)
        SetShadowHeight("DialogAcceptButton", 0)
        SetShadowEdgeFade("DialogAcceptButton", 3)

        // Forms (FormRowLayout): section titles, captions, cards and the
        // footer's line.
        SetFontColor("SectionTitle", color:CustomColor(102.0 / MAX, 102.0 / MAX, 102.0 / MAX, 1))
        SetFontColor("FieldCaption", color:CustomColor(85.0 / MAX, 85.0 / MAX, 85.0 / MAX, 1))
        SetBackgroundColor("FormCard", color:White())
        SetBorderColor("FormCard", color:CustomColor(228.0 / MAX, 228.0 / MAX, 228.0 / MAX, 1))
        SetBorderColor("FormFooter", color:CustomColor(208.0 / MAX, 208.0 / MAX, 208.0 / MAX, 1))


        // Chart specific properties.
        SetChartBackgroundColor(color:White())
        SetChartForegroundColor(color:White())
        SetChartBorderColor(color:CustomColor(153.0/255.0, 153.0/255.0, 153.0/255.0, 1))
        SetChartAccentColor(color:CustomColor(227.0/255.0, 221.0/255.0, 221.0/255.0, 1))
        SetChartSelectionColor(color:CustomColor(240.0/255.0, 94.0/255.0, 93.0/255.0, 1))
        SetChartForegroundSelectionColor(color:CustomColor(0.5, 0.5, 1, 1))
        SetChartIconColor(color:CustomColor(32.0/255.0, 32.0/255.0, 32.0/255.0, 1))
        SetChartFontColor(color:Black())
        SetChartSelectionFontColor(color:White())
        SetChartSelectionBorderColor(color:CustomColor(153.0/255.0, 153.0/255.0, 153.0/255.0, 1))
//SetChartSelectionBorderColor(color:CustomColor(240.0/255.0, 94.0/255.0, 93.0/255.0, 1))

        // Label specific properties.
        SetLabelBackgroundColor(color:CustomColor(1, 1, 1, 0))
        SetLabelBorderThickness(2)
SetLabelBottomLeftPixelRounding(6)
SetLabelBottomRightPixelRounding(6)
SetLabelTopLeftPixelRounding(6)
SetLabelTopRightPixelRounding(6)
        // The accent blue: the bar beside a focused label (LC).
        SetLabelFocusColor(color:CustomColor(38.0 / MAX, 117.0 / MAX, 191.0 / MAX, 1))
        
        // Values for ControlLabels.
        SetBackgroundColor("ControlLabel", color:CustomColor(1, 1, 1, 0))

        // Flowchart and flowchart element properties.
        SetFlowchartBackgroundColor(color:White())
        
        SetFlowchartNodeBackgroundColor(color:CustomColor(0.8, 0.92, 1.0, 1.0))
        SetFlowchartNodeSelectionColor(color:CustomColor(0.65, 0.77, 0.85, 1.0))
        SetFlowchartNodeSelectionBorderColor(color:Blue())
        SetFlowchartNodeBorderThickness(3)
        SetFlowchartNodeTopLeftRounding(0.2)
        SetFlowchartNodeTopRightRounding(0.2)
        SetFlowchartNodeBottomLeftRounding(0.2)
        SetFlowchartNodeBottomRightRounding(0.2)

        SetFlowchartArrowBackgroundColor(color:Black())
        SetFlowchartArrowIconColor(color:Black())
        SetFlowchartArrowSelectionColor(color:Blue())

        // Grouping specific values.
        SetGroupingBackgroundColor(color:CustomColor(1, 1, 1, 0))
        SetGroupingBorderThickness(0)

        // Banner specific values.
        // B4: the Ok button's blue, with white text and a white focus ring.
        SetBannerBackgroundColor(color:CustomColor(31.0 / MAX, 103.0 / MAX, 181.0 / MAX, 1))
        SetBannerFontColor(color:White())
        SetFocusBorderColor("Banner", color:White())
        // The banner's title draws its focus ring in the focus color.
        SetFocusColor("Banner", color:White())
        SetBannerBorderThickness(0)

        // StartButtonGrouping specific values.
        SetStartButtonGroupingBackgroundColor(color:CustomColor(0.92, 0.92, 0.92, 1.0))
        SetStartButtonGroupingBorderColor(color:White())
        SetStartButtonGroupingBorderThickness(1)
        SetStartButtonGroupingTopLeftRounding(0.2)
        SetStartButtonGroupingTopRightRounding(0.2)
        SetStartButtonGroupingBottomLeftRounding(0.2)
        SetStartButtonGroupingBottomRightRounding(0.2)

        // ChartPoint specific values.
        SetChartPointBottomLeftRounding(1)
        SetChartPointBottomRightRounding(1)
        SetChartPointTopLeftRounding(1)
        SetChartPointTopRightRounding(1)
    end
end