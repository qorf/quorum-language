package Libraries.Interface.Options

use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Gradient

/*
    This is the default set of options for a dark mode style color approach. 
*/
class DarkModeOptions is InterfaceOptions
    on create
        Color color
        constant number MAX = 255.0
        SetFontColor(color:White())
        SetSelectionFontColor(color:White())
        Color defaultSelectionColor = color:CustomColor(47.0 / MAX, 91.0 / MAX, 187.0 / MAX, 1)
        SetSelectionColor(defaultSelectionColor)
        SetBorderColor(color:CustomColor(122.0 / MAX, 124.0 / MAX, 126.0 / MAX, 1))
        SetIconColor(color:White())
        
        

        Color commonFontColor = color:CustomColor(186.0 / MAX, 197.0 / MAX, 210.0 / MAX, 1)
        Gradient backgroundGradient
        Color darkGray = color:CustomColor(60.0 / MAX, 63.0 / MAX, 65.0 / MAX, 1)
        backgroundGradient:Set(darkGray, darkGray, darkGray, darkGray)
        SetBackgroundColor(backgroundGradient)
        SetForegroundColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))

        Gradient mouseOverGradient
        Color mouseOver = color:CustomColor(76.0 / MAX, 80.0 / MAX, 82.0 / MAX, 1)
        mouseOverGradient:Set(mouseOver, mouseOver, mouseOver, mouseOver)
        SetMouseOverColor(mouseOverGradient)

        // Default shadow values.
        SetShadowColor(color:CustomColor(0, 0, 0, 0.5))
        SetShadowX(6)
        SetShadowY(-6)
        SetShadowEdgeFade(3)

        // Button specific colors.
        Color acceptBlue = color:CustomColor(131.0/MAX, 186.0/MAX, 217.0/MAX, 1)
        Color darkFont = color:CustomColor(32.0 / MAX, 32.0 / MAX, 32.0 / MAX, 1)
        Color lightFont = color:CustomColor(246.0 / MAX, 246.0 / MAX, 246.0 / MAX, 1)
        Color controlBackground = color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1)
        Color hoverBlue = color:CustomColor(78.0 / MAX, 139.0 / MAX, 175.0 / MAX, 1)
        number defaultButtonRounding = 0.5
        //Buttons (F4): a soft top-to-bottom gradient, a 2-point accent line
        //along the top (its own shape, hidden while focused), and a soft
        //shadow below. The 2-point border is the fill's top color, so it
        //only shows as the focus ring.
        Color buttonEdge = color:CustomColor(92.0 / MAX, 98.0 / MAX, 105.0 / MAX, 1)
        Color buttonHoverEdge = color:CustomColor(104.0 / MAX, 111.0 / MAX, 119.0 / MAX, 1)
        Color accentLine = color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1)
        Color focusRing = color:CustomColor(125.0 / MAX, 176.0 / MAX, 255.0 / MAX, 1)
        Gradient buttonFill
        buttonFill:Set(color:CustomColor(71.0 / MAX, 76.0 / MAX, 82.0 / MAX, 1), color:CustomColor(71.0 / MAX, 76.0 / MAX, 82.0 / MAX, 1),
            color:CustomColor(92.0 / MAX, 98.0 / MAX, 105.0 / MAX, 1), color:CustomColor(92.0 / MAX, 98.0 / MAX, 105.0 / MAX, 1))
        Gradient buttonHover
        buttonHover:Set(color:CustomColor(82.0 / MAX, 88.0 / MAX, 95.0 / MAX, 1), color:CustomColor(82.0 / MAX, 88.0 / MAX, 95.0 / MAX, 1),
            color:CustomColor(104.0 / MAX, 111.0 / MAX, 119.0 / MAX, 1), color:CustomColor(104.0 / MAX, 111.0 / MAX, 119.0 / MAX, 1))
        Gradient buttonDown
        buttonDown:Set(color:CustomColor(78.0 / MAX, 84.0 / MAX, 90.0 / MAX, 1), color:CustomColor(78.0 / MAX, 84.0 / MAX, 90.0 / MAX, 1),
            color:CustomColor(64.0 / MAX, 68.0 / MAX, 73.0 / MAX, 1), color:CustomColor(64.0 / MAX, 68.0 / MAX, 73.0 / MAX, 1))
        SetButtonBorderThickness(2)
        SetButtonBackgroundColor(buttonFill)
        SetButtonBorderColor(buttonEdge)
        SetButtonFontColor(lightFont)
        SetButtonTopLeftRounding(defaultButtonRounding)
        SetButtonTopRightRounding(defaultButtonRounding)
        SetButtonBottomLeftRounding(defaultButtonRounding)
        SetButtonBottomRightRounding(defaultButtonRounding)
        SetButtonMouseOverColor(buttonHover)
        SetButtonMouseOverBorderColor(buttonHoverEdge)
        SetButtonMouseDownColor(buttonDown)
        SetButtonFocusColor(buttonFill)
        SetButtonFocusFontColor(lightFont)
        SetButtonFocusBorderColor(focusRing)
        SetButtonTopAccent(true)
        SetButtonTopAccentColor(accentLine)
        SetButtonRaised(true)
        SetButtonShadowColor(color:CustomColor(0, 0, 0, 0.45))
        SetButtonShadowX(0)
        SetButtonShadowY(-2)
        SetButtonShadowWidth(0)
        SetButtonShadowHeight(0)
        SetButtonShadowEdgeFade(3)

        // ToggleButton properties.
        SetToggleButtonBorderThickness(1)
        SetToggleButtonBackgroundColor(controlBackground)
        SetToggleButtonFontColor(lightFont)
        SetToggleButtonTopLeftRounding(defaultButtonRounding)
        SetToggleButtonTopRightRounding(defaultButtonRounding)
        SetToggleButtonBottomLeftRounding(defaultButtonRounding)
        SetToggleButtonBottomRightRounding(defaultButtonRounding)
        SetToggleButtonMouseOverColor(hoverBlue)

        // The color when the button is focused but not selected.
        SetToggleButtonFocusColor(color:CustomColor(78.0 / MAX, 139.0 / MAX, 205.0 / MAX, 1))
        SetToggleButtonFocusFontColor(lightFont)
        SetToggleButtonFocusBorderColor(acceptBlue)

        // The color when the button is selected but not focused.
        SetToggleButtonUnfocusedSelectionColor(acceptBlue)
        SetToggleButtonUnfocusedSelectionFontColor(lightFont)

        // The color when the button is focused and selected.
        SetToggleButtonSelectionColor(color:CustomColor(141.0/MAX, 196.0/MAX, 237.0/MAX, 1))



        // Cell specific colors.
        SetCellBackgroundColor(darkGray)

        // Checkbox specific colors.
        SetCheckboxBorderThickness(2)
        SetCheckboxTopLeftRounding(defaultButtonRounding)
        SetCheckboxTopRightRounding(defaultButtonRounding)
        SetCheckboxBottomLeftRounding(defaultButtonRounding)
        SetCheckboxBottomRightRounding(defaultButtonRounding)
        
        SetCheckboxBackgroundColor(controlBackground)
        // Checks and radio choices use the accent, like main buttons (K3).
        SetCheckboxSelectionColor(color:CustomColor(58.0 / MAX, 115.0 / MAX, 214.0 / MAX, 1))
        SetCheckboxFocusColor(color:CustomColor(0,0,0,0))
        SetCheckboxUnfocusedSelectionColor(color:CustomColor(0,0,0,0))
        // CD: the focused box's edge and the line under its label.
        SetCheckboxFocusBorderColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        
        SetCheckboxBorderColor(color:CustomColor(215.0 / MAX, 215.0 / MAX, 215.0 / MAX, 1))
        SetCheckboxSelectionBorderColor(color:CustomColor(58.0 / MAX, 115.0 / MAX, 214.0 / MAX, 1))
        SetCheckboxAccentColor(controlBackground)

        // ProgressBar (P3): an outlined pill with the accent fill. Focus
        // keeps the track's color and adds the 2-point ring.
        Color progressTrack = color:CustomColor(47.0 / MAX, 50.0 / MAX, 53.0 / MAX, 1)
        SetProgressBarBackgroundColor(progressTrack)
        SetProgressBarBorderColor(color:CustomColor(150.0 / MAX, 157.0 / MAX, 166.0 / MAX, 1))
        SetProgressBarForegroundColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        SetFocusColor("ProgressBar", progressTrack)
        SetFocusBorderColor("ProgressBar", color:CustomColor(125.0 / MAX, 176.0 / MAX, 255.0 / MAX, 1))
        SetFocusBorderThickness("ProgressBar", 2)

        // ScrollPane specific colors.
        SetScrollPaneBackgroundColor(darkGray)
        SetScrollPaneForegroundColor(color:CustomColor(53.0 / MAX, 54.0 / MAX, 59.0 / MAX, 1))
        SetScrollPaneAccentColor(color:CustomColor(154.0 / MAX, 155.0 / MAX, 157.0 / MAX, 1))

        // RadioButton specific colors.
        SetRadioButtonBackgroundColor(color:CustomColor(211.0/255.0, 211.0/255.0, 211.0/255.0, 1))
        SetRadioButtonBorderColor(color:CustomColor(178.0/255.0, 178.0/255.0, 178.0/255.0, 1))
        // G3: a selected radio button is a ring in the accent.
        SetRadioButtonSelectionColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        SetRadioButtonSelectionBorderColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        // Radio text matches checkbox text.
        SetRadioButtonFontColor(lightFont)
        SetRadioButtonSelectionFontColor(lightFont)

        SetRadioButtonBorderThickness(1)
        // G3: a group of choices sits on a faint track; focus marks the
        // group (left line) and the option (circle edge and underline).
        SetBackgroundColor("ChoiceGroup", color:CustomColor(61.0 / MAX, 64.0 / MAX, 68.0 / MAX, 1))
        SetFocusBorderColor("RadioButton", color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))

        // TabBar specific colors.
        SetTabBarBackgroundColor(darkGray)
        SetTabBarBorderColor(color:CustomColor(50.0 / MAX, 50.0 / MAX, 50.0 / MAX, 1))

        //TABS
        SetTabBarBackgroundColor(color:CustomColor(80.0 / MAX, 83.0 / MAX, 85.0 / MAX, 1))
        //The selected tab joins the panel below it: the editor's background,
        //with an accent line across its top (gray when its pane doesn't have
        //the focus). The others sit back with dimmer text, are tinted under
        //the mouse, and have a quiet gray close button (the foreground is the
        //close button's circle, the accent its X).
        Color tabMutedText = color:CustomColor(138.0 / MAX, 147.0 / MAX, 158.0 / MAX, 1)
        SetTabFontColor(tabMutedText)
        SetTabSelectionColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        // The selected tab's name has a hint of the accent blue (T3) while
        // its file has the focus.
        SetTabSelectionFontColor(color:CustomColor(194.0 / MAX, 215.0 / MAX, 245.0 / MAX, 1))
        SetTabFocusColor(color:CustomColor(30.0 / MAX, 61.0 / MAX, 92.0 / MAX, 1))
        SetTabForegroundColor(color:CustomColor(0, 0, 0, 0))
        SetTabAccentColor(tabMutedText)
        SetTabUnfocusedSelectionFontColor(commonFontColor)
        SetTabUnfocusedSelectionColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        SetTabMouseOverColor(color:CustomColor(65.0 / MAX, 71.0 / MAX, 78.0 / MAX, 1))

        SetTabBorderThickness(0)
        SetTabSelectionBorderThickness(2)
        SetTabSelectionBorderColor(color:CustomColor(74.0 / MAX, 136.0 / MAX, 224.0 / MAX, 1))
        SetTabUnfocusedSelectionBorderColor(color:CustomColor(95.0 / MAX, 99.0 / MAX, 104.0 / MAX, 1))
        SetTabTopLeftRounding(0.5)
        SetTabTopRightRounding(0.5)

        //TREES
        SetTreeItemUnfocusedSelectionFontColor(commonFontColor)
        SetTreeItemUnfocusedSelectionColor(color:CustomColor(13.0 / MAX, 41.0 / MAX, 62.0 / MAX, 1))

        //The arrow to the tree uses the accent color.
        SetTreeItemAccentColor(color:CustomColor(124.0 / MAX, 127.0 / MAX, 134.0 / MAX, 1))
        SetTreeItemFontColor(commonFontColor)
        SetTreeItemSelectionColor(color:CustomColor(47.0 / MAX, 101.0 / MAX, 202.0 / MAX, 1))
        SetTreeItemSelectionFontColor(color:White())

        //A row's selection and hover are a rounded band across the tree
        //(TreeRowHighlight). The hover is a soft neutral tint.
        SetTreeItemMouseOverColor(color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1))
        SetTreeItemTopLeftRounding(0.3)
        SetTreeItemTopRightRounding(0.3)
        SetTreeItemBottomLeftRounding(0.3)
        SetTreeItemBottomRightRounding(0.3)

        //MENUS
        SetMenuItemBackgroundColor(color:CustomColor(0.0 / MAX, 0.0 / MAX, 0.0 / MAX, 0))
        SetMenuItemBorderColor(color:CustomColor(0.0 / MAX, 0.0 / MAX, 0.0 / MAX, 0))
        // M4: the trees' hover gray for hover and selection, with the
        // selected item's 3-point accent tag at its left.
        Color menuHover = color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1)
        SetMenuItemSelectionColor(menuHover)
        SetMenuItemMouseOverColor(menuHover)
        SetMenuItemFontColor(commonFontColor)
        SetSelectionFontColor("MenuItem", commonFontColor)
        SetBorderThickness("MenuItem", 0)
        SetSelectionBorderThickness("MenuItem", 3)
        SetSelectionBorderColor("MenuItem", color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        SetTopLeftRounding("MenuItem", 0.3)
        SetTopRightRounding("MenuItem", 0.3)
        SetBottomLeftRounding("MenuItem", 0.3)
        SetBottomRightRounding("MenuItem", 0.3)
        // The menu panel's rounded corners (M4).
        SetTopLeftPixelRounding("MenuPanel", 6)
        SetTopRightPixelRounding("MenuPanel", 6)
        SetBottomLeftPixelRounding("MenuPanel", 6)
        SetBottomRightPixelRounding("MenuPanel", 6)


        //TEXTBOX
        SetTextBoxBackgroundColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        SetTextBoxFontColor(commonFontColor)
        SetTextBoxForegroundColor(color:CustomColor(53.0 / MAX, 54.0 / MAX, 59.0 / MAX, 1))
        SetTextBoxAccentColor(color:CustomColor(154.0 / MAX, 155.0 / MAX, 157.0 / MAX, 1))
        SetTextBoxIconColor(GetTextBoxFontColor())

        //TEXT FIELD
        // A 1.5-point edge (4.6 to 1 on the field). Focus adds the accent
        // edge and the thick line on the left (FD).
        SetTextFieldBorderThickness(1.5)
        SetTextFieldTopLeftRounding(defaultButtonRounding)
        SetTextFieldTopRightRounding(defaultButtonRounding)
        SetTextFieldBottomLeftRounding(defaultButtonRounding)
        SetTextFieldBottomRightRounding(defaultButtonRounding)
        SetTextFieldBorderColor(color:CustomColor(140.0 / MAX, 147.0 / MAX, 156.0 / MAX, 1))
        SetTextFieldFocusBorderColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        SetTextFieldBackgroundColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        // H3 hover: a soft band behind a checkbox or radio button and its
        // label, and a firmer edge on the box, circle or field.
        Color hoverBand = color:CustomColor(85.0 / MAX, 89.0 / MAX, 94.0 / MAX, 1)
        Color hoverEdge = color:CustomColor(201.0 / MAX, 206.0 / MAX, 212.0 / MAX, 1)
        SetCheckboxMouseOverColor(hoverBand)
        SetCheckboxMouseOverBorderColor(hoverEdge)
        SetRadioButtonMouseOverColor(hoverBand)
        SetRadioButtonMouseOverBorderColor(hoverEdge)
        SetTextFieldMouseOverBorderColor(hoverEdge)
        // The field's own background, so only its edge changes.
        SetTextFieldMouseOverColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        SetTextFieldFontColor(commonFontColor)
        SetTextFieldIconColor(GetTextBoxFontColor())

        // CodeEditor specific options.
        SetCodeEditorBackgroundColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        SetCodeEditorFontColor(commonFontColor)
        SetCodeEditorForegroundColor(color:CustomColor(53.0 / MAX, 54.0 / MAX, 59.0 / MAX, 1))
        SetCodeEditorAccentColor(color:CustomColor(154.0 / MAX, 155.0 / MAX, 157.0 / MAX, 1))
        SetCodeEditorIconColor(GetTextBoxFontColor())
        SetCodeEditorSelectionColor(color:White())
        // TreeTableCell specific colors.
        SetTreeTableCellSelectionColor(color:CustomColor(47.0 / MAX, 101.0 / MAX, 202.0 / MAX, 1))
        SetTreeTableCellFontColor(commonFontColor)
        SetTreeTableCellSelectionFontColor(color:White())
        SetTreeTableCellUnfocusedSelectionColor(color:CustomColor(13.0 / MAX, 41.0 / MAX, 62.0 / MAX, 1))
        SetTreeTableCellUnfocusedSelectionFontColor(color:CustomColor(187.0 / MAX, 187.0 / MAX, 187.0 / MAX, 1))

        //Gutter defaults
        SetGutterBackgroundColor(color:CustomColor(50.0/MAX, 53.0/MAX, 55.0/MAX, 1))
        SetGutterFontColor(color:CustomColor(177.0/MAX, 177.0/MAX, 177.0/MAX, 1))
        SetTabBackgroundColor(color:CustomColor(52.0 / MAX, 58.0 / MAX, 64.0 / MAX, 1))
        SetGutterAccentColor(color:CustomColor(230.0 / MAX, 78.0 / MAX, 88.0 / MAX, 1))
        SetGutterSelectionColor(color:CustomColor(0.5, 0.75, 0.59, 1))

        // List specific colors.
        SetListBackgroundColor(GetTextBoxBackgroundColor())
        SetListForegroundColor(GetTextBoxForegroundColor())
        SetListAccentColor(GetTextBoxAccentColor())
        SetListSelectionColor(GetTextBoxSelectionColor())

        // ListItem specific colors.
        SetListItemBackgroundColor(color:CustomColor(1, 1, 1, 0))
        SetListItemFontColor(GetTextBoxFontColor())

        // A list's box is slightly rounded, and its items' selection and
        // hover are rounded bands inside it, as tree rows are. The hover is a
        // soft neutral tint over the list's background.
        SetListItemMouseOverColor(color:CustomColor(62.0 / MAX, 62.0 / MAX, 62.0 / MAX, 1))
        // LS5: a selected item is a faint accent wash while its list has
        // the focus, and the trees' gray when it doesn't.
        SetSelectionColor("ListItem", color:CustomColor(51.0 / MAX, 68.0 / MAX, 92.0 / MAX, 1))
        SetSelectionFontColor("ListItem", color:White())
        SetUnfocusedSelectionColor("ListItem", color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1))
        SetUnfocusedSelectionFontColor("ListItem", GetTextBoxFontColor())
        SetFocusBorderColor("List", color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        // A fixed radius, so the box's corners show however tall it is.
        SetListTopLeftPixelRounding(8)
        SetListTopRightPixelRounding(8)
        SetListBottomLeftPixelRounding(8)
        SetListBottomRightPixelRounding(8)
        SetListItemTopLeftRounding(0.3)
        SetListItemTopRightRounding(0.3)
        SetListItemBottomLeftRounding(0.3)
        SetListItemBottomRightRounding(0.3)

        // Dialog colors.
        SetDialogShadowColor(color:CustomColor(0, 0, 0, 0.5))
        SetDialogShadowX(4)
        SetDialogShadowY(-4)
        SetDialogShadowWidth(8)
        SetDialogShadowHeight(8)
        SetDialogShadowEdgeFade(11)
        SetDialogTopLeftRounding(0.04)
        SetDialogTopRightRounding(0.04)
        SetDialogBottomLeftRounding(0.04)
        SetDialogBottomRightRounding(0.04)

        // Dialog bar specific colors.
        SetDialogBarBackgroundColor(darkGray)
        SetDialogBarBorderColor(color:CustomColor(74.0 / MAX, 78.0 / MAX, 82.0 / MAX, 1))
        SetDialogBarBorderThickness(1)
        SetDialogBarForegroundColor(color:CustomColor(230.0 / MAX, 78.0 / MAX, 88.0 / MAX, 1))
        SetDialogBarAccentColor(color:White())
        SetDialogBarFontColor(commonFontColor)

        // The dialog close button: no fill until hovered or focused.
        Color closeClear = color:CustomColor(0, 0, 0, 0)
        SetBackgroundColor("DialogClose", closeClear)
        SetBorderColor("DialogClose", closeClear)
        SetBorderThickness("DialogClose", 2)
        // X1: the trees' and menus' hover gray behind the X.
        SetMouseOverColor("DialogClose", color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1))
        SetMouseOverBorderColor("DialogClose", color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1))
        SetFocusColor("DialogClose", closeClear)
        SetFocusBorderColor("DialogClose", focusRing)
        SetTopLeftPixelRounding("DialogClose", 6)
        SetTopRightPixelRounding("DialogClose", 6)
        SetBottomLeftPixelRounding("DialogClose", 6)
        SetBottomRightPixelRounding("DialogClose", 6)
        // A tab's close X gets the same hover square, with smaller corners.
        Color tabCloseClear = color:CustomColor(0, 0, 0, 0)
        SetBackgroundColor("TabClose", tabCloseClear)
        SetBorderColor("TabClose", tabCloseClear)
        SetBorderThickness("TabClose", 0)
        SetMouseOverColor("TabClose", color:CustomColor(78.0 / MAX, 81.0 / MAX, 84.0 / MAX, 1))
        SetTopLeftPixelRounding("TabClose", 4)
        SetTopRightPixelRounding("TabClose", 4)
        SetBottomLeftPixelRounding("TabClose", 4)
        SetBottomRightPixelRounding("TabClose", 4)
        SetDialogBarTopRightPixelRounding(8)
        SetDialogBarTopLeftPixelRounding(8)

        // Dialog accept button (the main action): the accent fill, white
        // text, and a ring when focused.
        Color acceptFill = color:CustomColor(58.0 / MAX, 115.0 / MAX, 214.0 / MAX, 1)
        Color acceptHover = color:CustomColor(74.0 / MAX, 132.0 / MAX, 230.0 / MAX, 1)
        Gradient acceptGradient
        acceptGradient:Set(color:CustomColor(47.0 / MAX, 100.0 / MAX, 194.0 / MAX, 1), color:CustomColor(47.0 / MAX, 100.0 / MAX, 194.0 / MAX, 1),
            color:CustomColor(76.0 / MAX, 135.0 / MAX, 232.0 / MAX, 1), color:CustomColor(76.0 / MAX, 135.0 / MAX, 232.0 / MAX, 1))
        Gradient acceptHoverGradient
        acceptHoverGradient:Set(color:CustomColor(60.0 / MAX, 114.0 / MAX, 208.0 / MAX, 1), color:CustomColor(60.0 / MAX, 114.0 / MAX, 208.0 / MAX, 1),
            color:CustomColor(90.0 / MAX, 148.0 / MAX, 240.0 / MAX, 1), color:CustomColor(90.0 / MAX, 148.0 / MAX, 240.0 / MAX, 1))
        SetDialogAcceptButtonBorderThickness(2)
        SetDialogAcceptButtonTopLeftRounding(defaultButtonRounding)
        SetDialogAcceptButtonTopRightRounding(defaultButtonRounding)
        SetDialogAcceptButtonBottomLeftRounding(defaultButtonRounding)
        SetDialogAcceptButtonBottomRightRounding(defaultButtonRounding)
        SetDialogAcceptButtonBackgroundColor(acceptGradient)
        SetDialogAcceptButtonBorderColor(acceptFill)
        SetDialogAcceptButtonFontColor(color:White())
        SetDialogAcceptButtonMouseOverColor(acceptHoverGradient)
        SetDialogAcceptButtonMouseOverBorderColor(acceptHover)
        SetDialogAcceptButtonMouseDownColor(color:CustomColor(46.0 / MAX, 96.0 / MAX, 184.0 / MAX, 1))
        SetDialogAcceptButtonFocusColor(acceptGradient)
        SetDialogAcceptButtonFocusFontColor(color:White())
        SetDialogAcceptButtonFocusBorderColor(color:CustomColor(169.0 / MAX, 203.0 / MAX, 255.0 / MAX, 1))
        // Raised like the other buttons, without the accent line.
        SetDialogAcceptButtonRaised(true)
        SetShadowColor("DialogAcceptButton", color:CustomColor(0, 0, 0, 0.45))
        SetShadowX("DialogAcceptButton", 0)
        SetShadowY("DialogAcceptButton", -2)
        SetShadowWidth("DialogAcceptButton", 0)
        SetShadowHeight("DialogAcceptButton", 0)
        SetShadowEdgeFade("DialogAcceptButton", 3)
        
// Label specific properties.
        SetLabelBackgroundColor(color:CustomColor(1, 1, 1, 0))
        SetLabelBorderThickness(2)
        SetLabelBottomLeftPixelRounding(6)
SetLabelBottomRightPixelRounding(6)
SetLabelTopLeftPixelRounding(6)
SetLabelTopRightPixelRounding(6)
        // The accent blue: the bar beside a focused label (LC).
        SetLabelFocusColor(color:CustomColor(111.0 / MAX, 163.0 / MAX, 255.0 / MAX, 1))
        
// Values for ControlLabels.
        SetBackgroundColor("ControlLabel", color:CustomColor(1, 1, 1, 0))

        // Forms (FormRowLayout): section titles above cards, captions above
        // fields on narrow pages, cards behind titled groupings, and the
        // line above a page's footer.
        SetFontColor("SectionTitle", color:CustomColor(176.0 / MAX, 184.0 / MAX, 194.0 / MAX, 1))
        SetFontColor("FieldCaption", color:CustomColor(186.0 / MAX, 197.0 / MAX, 210.0 / MAX, 1))
        SetBackgroundColor("FormCard", color:CustomColor(70.0 / MAX, 73.0 / MAX, 77.0 / MAX, 1))
        SetBorderColor("FormCard", color:CustomColor(86.0 / MAX, 90.0 / MAX, 95.0 / MAX, 1))
        SetBorderColor("FormFooter", color:CustomColor(86.0 / MAX, 90.0 / MAX, 95.0 / MAX, 1))


        // Flowchart and flowchart element properties.
        SetFlowchartBackgroundColor(color:CustomColor(43.0 / MAX, 43.0 / MAX, 43.0 / MAX, 1))
        
        SetFlowchartNodeBackgroundColor(color:CustomColor(86.0 / MAX, 86.0 / MAX, 86.0 / MAX, 1))
        SetFlowchartNodeSelectionColor(color:CustomColor(126.0 / MAX, 126.0 / MAX, 126.0 / MAX, 1))
        SetFlowchartNodeSelectionBorderColor(defaultSelectionColor)
        SetFlowchartNodeFontColor(commonFontColor)
        SetFlowchartNodeBorderThickness(3)
        SetFlowchartNodeTopLeftRounding(0.2)
        SetFlowchartNodeTopRightRounding(0.2)
        SetFlowchartNodeBottomLeftRounding(0.2)
        SetFlowchartNodeBottomRightRounding(0.2)

        SetFlowchartArrowBackgroundColor(commonFontColor)
        SetFlowchartArrowIconColor(commonFontColor)
        SetFlowchartArrowSelectionColor(defaultSelectionColor)

        // Grouping specific values.
        SetGroupingBackgroundColor(color:CustomColor(1, 1, 1, 0))
        SetGroupingBorderThickness(0)

        // Banner specific values.
        // B4: the Ok button's blue, with white text and a white focus ring.
        SetBannerBackgroundColor(color:CustomColor(47.0 / MAX, 100.0 / MAX, 194.0 / MAX, 1))
        SetBannerFontColor(color:White())
        SetFocusBorderColor("Banner", color:White())
        // The banner's title draws its focus ring in the focus color.
        SetFocusColor("Banner", color:White())
        SetBannerBorderThickness(0)

        // StartButtonGrouping specific values.
        SetStartButtonGroupingBackgroundColor(color:CustomColor(0.92, 0.92, 0.92, 1.0))
        SetStartButtonGroupingBorderColor(color:White())
        SetStartButtonGroupingBorderThickness(1)
        SetStartButtonGroupingTopLeftRounding(0.2)
        SetStartButtonGroupingTopRightRounding(0.2)
        SetStartButtonGroupingBottomLeftRounding(0.2)
        SetStartButtonGroupingBottomRightRounding(0.2)

        // ChartPoint specific values.
        SetChartPointBottomLeftRounding(1)
        SetChartPointBottomRightRounding(1)
        SetChartPointTopLeftRounding(1)
        SetChartPointTopRightRounding(1)
    end
end