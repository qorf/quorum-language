package Libraries.Interface.Accessibility

use Libraries.Interface.Item
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.Events.SelectionEvent
use Libraries.Interface.Events.MenuChangeEvent
use Libraries.Interface.Events.TreeChangeEvent
use Libraries.Interface.Events.TreeTableChangeEvent
use Libraries.Interface.Events.ControlActivationEvent
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Events.WindowFocusEvent
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.ToggleButton
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Events.ProgressBarValueChangedEvent
use Libraries.Interface.Events.SliderChangedEvent
use Libraries.Interface.Controls.Tooltip
use Libraries.Interface.Controls.ComboBox
use Libraries.Interface.Controls.ColorWell
use Libraries.Interface.Controls.Calendar
use Libraries.Interface.Accessibility
use Libraries.Game.GameStateManager
use Libraries.Interface.Selections.TextBoxSelection
use Libraries.Interface.Selections.TextFieldSelection

class MacAccessibility is Accessibility
    action Update
        parent:Accessibility:Update()
        NativeUpdate()
    end

    system action NativeUpdate

    system action NameChanged(Item item)

    system action DescriptionChanged(Item item)

    system action BoundsChanged(Item item)

    system action TextFieldUpdatePassword(TextField field)

    system action TextSelectionChanged(TextBoxSelection selection)

    system action TextSelectionChanged(TextFieldSelection selection)

    system action Select(Item item) returns boolean

    system action NativeAdd(Item item) returns boolean

    system action NativeRemove(Item item) returns boolean

    system action ProgressBarValueChanged(ProgressBarValueChangedEvent progress)

    /*
        A slider's value changed. Its node is built again on the next
        update, as a name change does, so VoiceOver gets the new value
        (SliderKit).
    */
    action SliderValueChanged(SliderChangedEvent event)
        if event:GetSlider() not= undefined
            NameChanged(event:GetSlider())
        end
    end

    /*
        A tooltip opened: VoiceOver gets a node for it (TooltipKit), and its
        control's node is described by it, on the next update.
    */
    action TooltipShown(Tooltip tooltip)
        if tooltip not= undefined
            NativeTooltipShown(tooltip)
        end
    end

    /*
        A tooltip is closing: its control's node is no longer described by it.
    */
    action TooltipHidden(Tooltip tooltip)
        if tooltip not= undefined
            NativeTooltipHidden(tooltip)
        end
    end

    private system action NativeTooltipShown(Tooltip tooltip)

    private system action NativeTooltipHidden(Tooltip tooltip)

    /*
        A combo box's list opened. Its node is built again on the next
        update, so VoiceOver hears that it is expanded (ComboBoxKit).
    */
    action ComboBoxOpened(ComboBox box)
        if box not= undefined
            NameChanged(box)
        end
    end

    /*
        A combo box's list closed. Its node is built again on the next
        update, so VoiceOver hears that it is collapsed.
    */
    action ComboBoxClosed(ComboBox box)
        if box not= undefined
            NameChanged(box)
        end
    end

    /*
        A color well's color changed. Its node is built again on the next
        update, so VoiceOver gets the new color's words (ColorWellKit).
    */
    action ColorWellChanged(ColorWell well)
        if well not= undefined
            NameChanged(well)
        end
    end

    /*
        A calendar changed: its current day moved, its month changed or a day
        was chosen. Its grid, rows and days are built again on the next
        update, and the focus moves to the current day (CalendarKit).
    */
    action CalendarChanged(Calendar calendar)
        if calendar not= undefined
            NativeCalendarChanged(calendar)
        end
    end

    private system action NativeCalendarChanged(Calendar calendar)

    system action ButtonActivated(Button button)

    system action ToggleButtonToggled(ToggleButton button)

    system action FocusChanged(FocusEvent event)

    system action MenuChanged(MenuChangeEvent event)

    system action TreeChanged(TreeChangeEvent event)

    system action TreeTableChanged(TreeTableChangeEvent event)

    system action ControlActivated(ControlActivationEvent event)

    system action TextChanged(TextChangeEvent event)

    system action WindowFocusChanged(WindowFocusEvent event)

    system action Notify(Item item, text value)

    system action Notify(Item item, text value, integer notificationType)

    system action Shutdown

    action IsScreenReaderListening returns boolean return false end
end
