    end

    /*
    This action makes the cube map's Texture the first time a side is
    loaded. Under OpenGL it becomes a GL cube texture; under Vulkan it waits
    for all six sides.
    */
    private action PrepareCubeMap
        if cubeMap not= undefined
            return now
        end
        Texture texture
        cubeMap = texture
        cubeSides:SetSize(6)
    end

    /*
    This action loads one side, given by its OpenGL constant as the load
    actions always have, onto the face the renderer needs:
    - Vulkan: the side's pixels are kept, and once all six are in, the
      texture manager makes the cube.
    - OpenGL on the desktop: front and back are swapped onto positive and
      negative z, which Quorum's left-handed world needs; the other sides
      are unchanged.
    - The web: unchanged, since it still draws with its own skybox shader.

    Attribute: Parameter file The image file.
    Attribute: Parameter side One of the GL_TEXTURE_CUBE_MAP constants above.
    */
    private action LoadCubeSide(File file, integer side)
        cubeSides:Set(GetTranslatedSide(side), file)
        GameStateManager manager
        if HasAllSides()
                cubeMap:LoadCubemapFromFiles(cubeSides)
            end
    end

    /*
    This action returns a translates an OpenGL cube face constant into an array index for the cubeSides array.
    These are ordered +x, -x, +y, -y, +z, -z (right, left, up, down, front, back).

    Attribute: Parameter side One of the GL_TEXTURE_CUBE_MAP constants above.
    Attribute: Returns The layer, 0 to 5.
    */
    private action GetTranslatedSide(integer side) returns integer
        if side = GL_TEXTURE_CUBE_MAP_POSITIVE_X
            return 0
        elseif side = GL_TEXTURE_CUBE_MAP_NEGATIVE_X
            return 1
        elseif side = GL_TEXTURE_CUBE_MAP_POSITIVE_Y
            return 2
        elseif side = GL_TEXTURE_CUBE_MAP_NEGATIVE_Y
            return 3
        elseif side = GL_TEXTURE_CUBE_MAP_POSITIVE_Z
            return 4
        end
        return 5
    end

    /*
    This action returns true once every side's pixels are in.

    Attribute: Returns True if all six sides are loaded.
    */
    private action HasAllSides returns boolean
        integer i = 0
        repeat while i < 6
            if cubeSides:Get(i) = undefined
                return false
            end
            i = i + 1
        end
        return true
    end

    /*
    Whether this Skybox has been loaded or not yet. On most platforms, this is
    true immediately after calling the Load action. On the web, this is true at
    some point in time after Load is called, due to the nature of how image
    loading is handled during online execution.
    */
    action IsLoaded returns boolean
        if cubeSides = undefined or cubeSides:IsEmpty()
            return false
        end
        
        integer i = 0
        repeat while i < cubeSides:GetSize()
            if cubeSides:Get(i) = undefined
                return false
            end
            i = i + 1
        end
        
        return true
    end

    /*
    This action returns the cube map texture holding the six sides. It is
    used by the painters to draw the sky.

    Attribute: Returns The cube map, or undefined if no side is loaded yet.
    */
    action GetCubeMap returns Texture
        return cubeMap
    end

    /*
    This action returns the Skybox's rotation, as set by Rotate and
    SetToRotation.

    Attribute: Returns The rotation.
    */
    action GetRotation returns Matrix4
        return transform
    end

    /*
    This action works out, from a camera, the three vectors the painters'
    sky shaders need to find the direction through each pixel: the camera's
    forward direction, and its right and up directions, each as long as the
    view reaches at a distance of 1. A pixel at screen position (x, y), each
    from -1 at the left or bottom to 1 at the right or top, looks along
    forward + x × right + y × up. Using the camera's directions instead of
    its matrices keeps the sky the same in every renderer, and moving the
    camera never moves the sky. The painters call it each time they draw the
    sky; read the results with GetViewRight, GetViewUp and GetViewForward.

    Attribute: Parameter camera The camera the sky is seen from.
    Attribute: Returns True if the camera can show a sky, false for an orthographic camera.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox

    class Main is Game
        Skybox skybox

        action Main
            StartGame()
        end

        action CreateGame
            skybox:Load("Skybox/right.jpg", "Skybox/left.jpg", "Skybox/top.jpg", "Skybox/bottom.jpg", "Skybox/front.jpg", "Skybox/back.jpg")
            SetSkybox(skybox)
            if skybox:UpdateView(GetCamera3D())
                output "The camera looks along z " + skybox:GetViewForward():GetZ()
            end
        end
    end
    */
    action UpdateView(Camera camera) returns boolean
        PerspectiveCamera perspective = cast(PerspectiveCamera, camera)
        number zoom = 1
        if camera is PerspectiveCamera
            zoom = perspective:GetZoom()
            if zoom <= 0
            zoom = 1
        end
        end
        
        // The same field of view the camera's projection uses (vertical).
        number halfHeight = math:Tangent(math:DegreesToRadians(perspective:GetFieldOfView() / zoom) / 2)
        number aspect = 1
        if camera:GetHeight() > 0
            aspect = camera:GetWidth() / camera:GetHeight()
        end

        viewForward:Set(camera:GetDirection())
        viewForward:Normalize()
        // In Quorum's left-handed world, up × forward points right.
        viewRight:Set(camera:GetUp())
        viewRight:CrossProduct(viewForward)
        viewRight:Normalize()
        // Made again from the other two, in case the camera's up isn't
        // exactly square to its direction.
        viewUp:Set(viewForward)
        viewUp:CrossProduct(viewRight)
        viewUp:Normalize()

        viewRight:Scale(halfHeight * aspect)
        viewUp:Scale(halfHeight)
        return true
    end

    /*
    This action returns the camera's right direction from the last
    UpdateView, as long as the view reaches sideways at a distance of 1.

    Attribute: Returns The right vector.
    */
    action GetViewRight returns Vector3
        return viewRight
    end

    /*
    This action returns the camera's up direction from the last UpdateView,
    as long as the view reaches upward at a distance of 1.

    Attribute: Returns The up vector.
    */
    action GetViewUp returns Vector3
        return viewUp
    end

    /*
    This action returns the camera's forward direction from the last
    UpdateView, of length 1.

    Attribute: Returns The forward vector.
    */
    action GetViewForward returns Vector3
        return viewForward
    end

    /*
    This action releases all the memory used to store the Skybox's texture. Once
    this has been called, it won't be initialized anymore, so it will need to be
    loaded again to be used.
    */
    action Dispose
        cubeMap:Dispose()
        cubeMap = undefined
        cubeSides:Empty()
    end

    /*
    This action will rotate the Skybox about an axis represented by the given
    numbers. The axis is essentially a ray that starts at the center of the
    Skybox and points in the direction of the provided x, y, and z values. The
    Skybox will then rotate clockwise around that ray. The Skybox will be 
    rotated by an angle given in degrees. 

    Attribute: Parameter x How far the ray points along the x-axis.
    Attribute: Parameter y How far the ray points along the y-axis.
    Attribute: Parameter z How far the ray points along the z-axis.
    Attribute: Parameter degrees How many degrees to rotate (clockwise).

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox

    class Main is Game

        Skybox skybox

        action Main
            StartGame()
        end

        action CreateGame
            // Assuming we have a folder named "skybox" containing our six images.
            skybox:Load("skybox/right.jpg", "skybox/left.jpg", "skybox/top.jpg", "skybox/bottom.jpg", "skybox/front.jpg", "skybox/back.jpg")
            SetSkybox(skybox)
        end

        action Update(number seconds)
            // The Skybox will rotate around the y-axis at a rate of 2 degrees per second.
            skybox:Rotate(0, 1, 0, 2 * seconds)
        end
    end
    */
    action Rotate(number x, number y, number z, number degrees)
        transform:Rotate(x, y, z, degrees)
    end

    /*
    This action will rotate the Skybox about an axis represented by the given
    Vector3. The axis is essentially a ray that starts at the center of the
    Skybox and points outward. The Skybox will then rotate clockwise around that
    ray. The Skybox will be rotated by an angle given in degrees. 

    Attribute: Parameter axis The axis or ray to rotate around.
    Attribute: Parameter degrees How many degrees to rotate (clockwise).

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox
    use Libraries.Compute.Vector3

    class Main is Game

        Skybox skybox
        Vector3 axis

        action Main
            StartGame()
        end

        action CreateGame
            // Assuming we have a folder named "skybox" containing our six images.
            skybox:Load("skybox/right.jpg", "skybox/left.jpg", "skybox/top.jpg", "skybox/bottom.jpg", "skybox/front.jpg", "skybox/back.jpg")
            SetSkybox(skybox)

            axis:Set(0, 1, 0)
        end

        action Update(number seconds)
            // The Skybox will rotate around the axis at a rate of 2 degrees per second.
            skybox:Rotate(axis, 2 * seconds)
        end
    end
    */
    action Rotate(Vector3 axis, number degrees)
        Rotate(axis:GetX(), axis:GetY(), axis:GetZ(), degrees)
    end

    /*
    The SetToRotation action will rotate the Skybox from its base orientation,
    ignoring any previous rotations that have been applied to it. The rotation
    is measured as a number of degrees rotated clockwise around the given axis.
    The axis is essentially a ray that begins in the center of the Skybox and 
    extends outward.

    Attribute: Parameter x How far the ray points along the x-axis.
    Attribute: Parameter y How far the ray points along the y-axis.
    Attribute: Parameter z How far the ray points along the z-axis.
    Attribute: Parameter degrees The number of degrees to rotate the Skybox.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Skybox skybox
            // Assuming we have a folder named "skybox" containing our six images.
            skybox:Load("skybox/right.jpg", "skybox/left.jpg", "skybox/top.jpg", "skybox/bottom.jpg", "skybox/front.jpg", "skybox/back.jpg")
            SetSkybox(skybox)

            skybox:SetToRotation(0, 1, 0, 90)
        end
    end
    */
    action SetToRotation(number x, number y, number z, number degrees)
        transform:SetToRotation(x, y, z, degrees)
    end

    /*
    The SetToRotation action will rotate the Skybox from its base orientation,
    ignoring any previous rotations that have been applied to it. The rotation
    is measured as a number of degrees rotated clockwise around the given axis.
    The axis is essentially a ray that begins in the center of the Skybox and 
    extends outward.

    Attribute: Parameter axis The ray to rotate the Skybox around.
    Attribute: Parameter degrees The number of degrees to rotate the Skybox.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox
    use Libraries.Compute.Vector3

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Skybox skybox
            // Assuming we have a folder named "skybox" containing our six images.
            skybox:Load("skybox/right.jpg", "skybox/left.jpg", "skybox/top.jpg", "skybox/bottom.jpg", "skybox/front.jpg", "skybox/back.jpg")
            SetSkybox(skybox)

            Vector3 axis
            axis:Set(0, 1, 0)
            skybox:SetToRotation(axis, 90)
        end
    end
    */
    action SetToRotation(Vector3 axis, number degrees)
        SetToRotation(axis:GetX(), axis:GetY(), axis:GetZ(), degrees)
    end

    /*
    This action returns the file that was used to load the right side of the skybox.
    */
    action GetRightFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(0)
    end

    /*
    This action returns the file that was used to load the left side of the skybox.
    */
    action GetLeftFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(1)
    end

    /*
    This action returns the file that was used to load the top side of the skybox.
    */
    action GetTopFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(2)
    end

    /*
    This action returns the file that was used to load the bottom side of the skybox.
    */
    action GetBottomFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(3)
    end

    /*
    This action returns the file that was used to load the front side of the skybox.
    */
    action GetFrontFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(4)
    end

    /*
    This action returns the file that was used to load the back side of the skybox.
    */
    action GetBackFile returns File
        if cubeSides = undefined or cubeSides:IsEmpty()
            return undefined
        end
        
        return cubeSides:Get(5)
    end

    /*
    This action turns the Skybox about the up axis, from its base
    orientation, by a number of degrees, and remembers the number so it can
    be saved with a scene (QuincyWorld demo D3). It replaces any rotation
    set before. GetTurn returns it.

    Attribute: Parameter degrees How far to turn the sky about the up axis.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            Skybox skybox
            skybox:Load("Skybox/right.jpg", "Skybox/left.jpg", "Skybox/top.jpg", "Skybox/bottom.jpg", "Skybox/front.jpg", "Skybox/back.jpg")
            skybox:SetTurn(45)
            SetSkybox(skybox)
        end
    end
    */
    action SetTurn(number degrees)
        turn = degrees
        transform:SetToRotation(0, 1, 0, degrees)
    end

    /*
    This action returns the turn about the up axis set by SetTurn, in
    degrees. Rotations made with Rotate or SetToRotation aren't counted.

    Attribute: Returns The turn, in degrees.
    */
    action GetTurn returns number
        return turn
    end

    /*
    This action loads the six sides from the pictures in a folder, found by
    their names, ignoring case and the kind of picture (png, jpg and so on)
    (QuincyWorld demo D3):
    - right: right, px, posx or positivex
    - left: left, nx, negx or negativex
    - up: top, up, py, posy or positivey
    - down: bottom, down, ny, negy or negativey
    - front: front, pz, posz or positivez
    - back: back, nz, negz or negativez
    A name may also end with one of these after an underscore or a dash,
    such as "sky_right.png". The sides' files keep the folder's working
    directory, so a folder given relative to a project stays relative.

    Attribute: Parameter folder The folder holding the six pictures.
    Attribute: Returns True if all six were found and loading began, or false if one is missing (nothing is loaded then).

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.Graphics.Skybox
    use Libraries.System.File

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            File folder
            folder:SetPath("Skybox")
            Skybox skybox
            if skybox:LoadFolder(folder)
                SetSkybox(skybox)
            end
        end
    end
    */
    action LoadFolder(File folder) returns boolean
        if folder = undefined or not folder:IsDirectory()
            return false
        end
        Array<File> listing = folder:GetDirectoryListing()
        Array<File> found
        found:SetSize(6)
        integer i = 0
        repeat while i < listing:GetSize()
            File candidate = listing:Get(i)
            if not candidate:IsDirectory()
                integer side = GetSideFromName(candidate)
                if side >= 0 and found:Get(side) = undefined
                    File sideFile
                    sideFile:SetWorkingDirectory(folder:GetWorkingDirectory())
                    text folderPath = folder:GetPath()
                    if folderPath = "" or folderPath:EndsWith("/") or folderPath:EndsWith("\")
                        sideFile:SetPath(folderPath + candidate:GetFileName())
                    else
                        sideFile:SetPath(folderPath + "/" + candidate:GetFileName())
                    end
                    found:Set(side, sideFile)
                end
            end
            i = i + 1
        end
        i = 0
        repeat while i < 6
            if found:Get(i) = undefined
                return false
            end
            i = i + 1
        end
        Load(found:Get(0), found:Get(1), found:Get(2), found:Get(3), found:Get(4), found:Get(5))
        return true
    end

    /*
    This action returns which side a picture's name says it is, from 0 to 5
    (right, left, up, down, front, back), or -1 if it isn't a sky picture.
    */
    private action GetSideFromName(File file) returns integer
        text extension = file:GetFileExtension():ToLowerCase()
        if not (extension = "png" or extension = "jpg" or extension = "jpeg" or extension = "bmp" or extension = "tga")
            return -1
        end
        text name = file:GetFileName():ToLowerCase()
        name = name:GetSubtext(0, name:GetSize() - extension:GetSize() - 1)
        if NameIs(name, "right") or NameIs(name, "px") or NameIs(name, "posx") or NameIs(name, "positivex")
            return 0
        elseif NameIs(name, "left") or NameIs(name, "nx") or NameIs(name, "negx") or NameIs(name, "negativex")
            return 1
        elseif NameIs(name, "top") or NameIs(name, "up") or NameIs(name, "py") or NameIs(name, "posy") or NameIs(name, "positivey")
            return 2
        elseif NameIs(name, "bottom") or NameIs(name, "down") or NameIs(name, "ny") or NameIs(name, "negy") or NameIs(name, "negativey")
            return 3
        elseif NameIs(name, "front") or NameIs(name, "pz") or NameIs(name, "posz") or NameIs(name, "positivez")
            return 4
        elseif NameIs(name, "back") or NameIs(name, "nz") or NameIs(name, "negz") or NameIs(name, "negativez")
            return 5
        end
        return -1
    end

    /*
    This action returns true if a picture's name is a side's name, or ends
    with it after an underscore or a dash.
    */
    private action NameIs(text name, text side) returns boolean
        return name = side or name:EndsWith("_" + side) or name:EndsWith("-" + side)
    end
end
