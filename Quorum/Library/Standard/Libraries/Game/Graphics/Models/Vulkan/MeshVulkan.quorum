package Libraries.Game.Graphics.Models.Vulkan

use Libraries.Game.Graphics.Vulkan.VulkanBuffer
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Game.Graphics.Vulkan.VulkanDevice
use Libraries.Game.Graphics.Vulkan.VulkanNumber32BitMappedMemory
use Libraries.Game.Graphics.Vulkan.VulkanInteger32BitMappedMemory
use Libraries.Game.Graphics.Vulkan.VulkanConstants
use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.Commands.CopyBufferCommand
use Libraries.Game.Graphics.Models.Data.AnimationMeshData
use Libraries.Game.NumberUtilities

class MeshVulkan
    
    VulkanDevice device = undefined
    
    VulkanBuffer vertexStagingBuffer = undefined
    VulkanBuffer indexStagingBuffer = undefined
    VulkanBuffer animationDataStagingBuffer = undefined
    VulkanBuffer vertexBuffer = undefined
    VulkanBuffer indexBuffer = undefined
    VulkanBuffer animationDataBuffer = undefined
    
    boolean dataTransferred = false
    
    /*
Each vertex is made of 14 32-bit components:
- Position (Vector3)
- Normal (Vector3)
- Tangent (Vector3)
- Bitangent (Vector3)
- Texture Coordinates (Vector2)
*/
    public constant integer DEFAULT_VERTEX_SIZE = 14
    integer vertexSize = DEFAULT_VERTEX_SIZE
    
    integer vertexCount = 0
    integer indexCount = 0
    
    integer globalVertexBufferIndex = -1
    integer globalIndexBufferIndex = -1
    
    MaterialVulkan material = undefined
    
    action Load(VulkanDevice device, MeshData data, AnimationMeshData animationData)
        if IsReady()
            alert("I cannot load data into this mesh because it has already been loaded!")
        elseif HasData()
            alert("I cannot set this mesh's data because the data was already set!")
        end
        
        me:device = device
        VulkanConstants constants
        
        Number32BitArray vertices = data:GetVertices()
        Number32BitArray normals = data:GetNormals()
    Number32BitArray tangents = data:GetTangents()
    Number32BitArray bitangents = data:GetBitangents()
    Number32BitArray textureCoordinates = data:GetTextureCoordinates()
    Integer32BitArray indices = data:GetIndices()
        
        VulkanBuffer vertexStagingBuffer
        VulkanBuffer indexStagingBuffer
        me:vertexStagingBuffer = vertexStagingBuffer
        me:indexStagingBuffer = indexStagingBuffer
        
        vertexCount = vertices:GetSize() / 3
        indexCount = indices:GetSize()
        
        integer vertexBufferSize = vertexCount * vertexSize
        vertexStagingBuffer:CreateTransferSourceBuffer(device, vertexBufferSize * 4)
        indexStagingBuffer:CreateTransferSourceBuffer(device, indexCount * 4)
        
        Number32BitArray vertexArray
        vertexArray:SetSize(vertexBufferSize)
        integer counter = 0
        repeat while counter < vertexCount
            integer arrayIndex = counter * vertexSize
            vertexArray:Set(arrayIndex, vertices:Get(counter * 3))
            vertexArray:Set(arrayIndex + 1, vertices:Get(counter * 3 + 1))
            vertexArray:Set(arrayIndex + 2, vertices:Get(counter * 3 + 2))
            
            vertexArray:Set(arrayIndex + 3, normals:Get(counter * 3))
            vertexArray:Set(arrayIndex + 4, normals:Get(counter * 3 + 1))
            vertexArray:Set(arrayIndex + 5, normals:Get(counter * 3 + 2))
            
            vertexArray:Set(arrayIndex + 6, tangents:Get(counter * 3))
            vertexArray:Set(arrayIndex + 7, tangents:Get(counter * 3 + 1))
            vertexArray:Set(arrayIndex + 8, tangents:Get(counter * 3 + 2))
            
            vertexArray:Set(arrayIndex + 9, bitangents:Get(counter * 3))
            vertexArray:Set(arrayIndex + 10, bitangents:Get(counter * 3 + 1))
            vertexArray:Set(arrayIndex + 11, bitangents:Get(counter * 3 + 2))
            
            vertexArray:Set(arrayIndex + 12, textureCoordinates:Get(counter * 2))
            vertexArray:Set(arrayIndex + 13, textureCoordinates:Get(counter * 2 + 1))
            
            counter = counter + 1
        end
        
        VulkanNumber32BitMappedMemory vertexMapping = vertexStagingBuffer:MapToNumber32BitMemory()
        VulkanInteger32BitMappedMemory indexMapping = indexStagingBuffer:MapToInteger32BitMemory()
        
        vertexMapping:Set(vertexArray)
        indexMapping:Set(indices)
        
        VulkanBuffer vertexBuffer
        VulkanBuffer indexBuffer
        me:vertexBuffer = vertexBuffer
        me:indexBuffer = indexBuffer
        
        //vertexBuffer:CreateTransferDestinationBuffer(device, vertexStagingBuffer:GetSize(), constants:BUFFER_USAGE_VERTEX_BUFFER_BIT)
        //indexBuffer:CreateTransferDestinationBuffer(device, indexStagingBuffer:GetSize(), constants:BUFFER_USAGE_INDEX_BUFFER_BIT)
        vertexBuffer:CreateTransferDestinationBuffer(device, vertexStagingBuffer:GetSize(), constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        indexBuffer:CreateTransferDestinationBuffer(device, indexStagingBuffer:GetSize(), constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        
        // If animation data has been provided, load a buffer with the weights and bone IDs.
        if animationData not= undefined
            NumberUtilities utility
            Number32BitArray weights = animationData:GetWeights()
            Integer32BitArray boneIDs = animationData:GetBoneIDs()
            
            Number32BitArray transferArray
            transferArray:SetSize(weights:GetSize() + boneIDs:GetSize())
            
            VulkanBuffer animationDataStagingBuffer
            me:animationDataStagingBuffer = animationDataStagingBuffer
            animationDataStagingBuffer:CreateTransferSourceBuffer(device, transferArray:GetSize() * 4)
            
            integer entryCount = weights:GetSize() / 4
            integer i = 0
            repeat while i < transferArray:GetSize()
                integer sourceIndex = i / 2
                
                transferArray:Set(i, weights:Get(sourceIndex))
                transferArray:Set(i + 1, weights:Get(sourceIndex + 1))
                transferArray:Set(i + 2, weights:Get(sourceIndex + 2))
                transferArray:Set(i + 3, weights:Get(sourceIndex + 3))
                
                transferArray:Set(i + 4, boneIDs:Get(sourceIndex))
                transferArray:Set(i + 5, boneIDs:Get(sourceIndex + 1))
                transferArray:Set(i + 6, boneIDs:Get(sourceIndex + 2))
                transferArray:Set(i + 7, boneIDs:Get(sourceIndex + 3))
                
                i = i + 8
            end
            
            VulkanNumber32BitMappedMemory animationMapping = animationDataStagingBuffer:MapToNumber32BitMemory()
            animationMapping:Set(transferArray)
            
            VulkanBuffer animationDataBuffer
            me:animationDataBuffer = animationDataBuffer
            
            animationDataBuffer:CreateTransferDestinationBuffer(device, animationDataStagingBuffer:GetSize(), constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        end
        
        //TODO: These cause a crash in some cases, for reasons unclear. Go back and figure this out later.
        //vertexStagingBuffer:StopMapping()
        //indexStagingBuffer:StopMapping()
        //animationDataStagingBuffer:StopMapping()
    end
    
    action HasData returns boolean
        return vertexStagingBuffer not= undefined or vertexBuffer not= undefined
    end
    
    action IsReady returns boolean
        return vertexBuffer not= undefined and dataTransferred
    end
    
    action HasAnimations returns boolean
        return animationDataStagingBuffer not= undefined or animationDataBuffer not= undefined
    end
    
    action GetDevice returns VulkanDevice
        return device
    end
    
    action TransferBuffers(VulkanCommandBuffer buffer)
        if dataTransferred
            return now
        end
        
        CopyBufferCommand vertexCopyCommand
        vertexCopyCommand:SetSourceBuffer(vertexStagingBuffer)
        vertexCopyCommand:SetDestinationBuffer(vertexBuffer)
        vertexCopyCommand:SetSize(vertexStagingBuffer:GetSize())        

        CopyBufferCommand indexCopyCommand
        indexCopyCommand:SetSourceBuffer(indexStagingBuffer)
        indexCopyCommand:SetDestinationBuffer(indexBuffer)
        indexCopyCommand:SetSize(indexStagingBuffer:GetSize())

        buffer:Record(vertexCopyCommand)
        buffer:Record(indexCopyCommand)
        
        if animationDataStagingBuffer not= undefined
            CopyBufferCommand animationCopyCommand
            animationCopyCommand:SetSourceBuffer(animationDataStagingBuffer)
            animationCopyCommand:SetDestinationBuffer(animationDataBuffer)
            animationCopyCommand:SetSize(animationDataStagingBuffer:GetSize())
            
            buffer:Record(animationCopyCommand)
        end
        
        dataTransferred = true
    end

    action GetGlobalVertexBufferIndex returns integer
        return globalVertexBufferIndex
    end

    action SetGlobalVertexBufferIndex(integer globalVertexBufferIndex)
        me:globalVertexBufferIndex = globalVertexBufferIndex
    end

    action GetGlobalIndexBufferIndex returns integer
        return globalIndexBufferIndex
    end

    action SetGlobalIndexBufferIndex(integer globalIndexBufferIndex)
        me:globalIndexBufferIndex = globalIndexBufferIndex
    end

    action GetVertexBuffer returns VulkanBuffer
        return vertexBuffer
    end

    action GetIndexBuffer returns VulkanBuffer
        return indexBuffer
    end

    action GetMaterial returns MaterialVulkan
        return material
    end

    action SetMaterial(MaterialVulkan material)
        me:material = material
    end

    action GetVertexCount returns integer
        return vertexCount
    end

    action GetIndexCount returns integer
        return indexCount
    end
    
    /*Returns the size of the vertex buffer in bytes.*/
    action GetVertexBufferSize returns integer
        if dataTransferred
            return vertexBuffer:GetSize()
        elseif vertexStagingBuffer not= undefined
            return vertexStagingBuffer:GetSize()
        else
            return 0
        end
    end
    
    /*Returns the size of the index buffer in bytes.*/
    action GetIndexBufferSize returns integer
        if dataTransferred
            return indexBuffer:GetSize()
        elseif indexStagingBuffer not= undefined
            return indexStagingBuffer:GetSize()
        else
            return 0
        end
    end

    action GetAnimationDataBuffer returns VulkanBuffer
        return animationDataBuffer
    end

end