package Libraries.Game.Graphics.Models.Vulkan

use Libraries.Game.Graphics.Models.ModelResources
use Libraries.Containers.Array
use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Game.Graphics.Renderable
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Vulkan.VulkanBuffer
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Vulkan.VulkanDevice
use Libraries.Game.Graphics.Vulkan.VulkanConstants

class ModelResourcesVulkan is ModelResources
    
    // ModelBlueprints already contain default color and textures per mesh, but they can be overridden on individual models (especially for simple models like primitives).
    // These arrays correspond to the array of meshes in a model, e.g. the diffuse color at index 1 is applied to the model's mesh at index 1.
    // If these values are undefined, the default value from the blueprint is used instead.
    Array<Color> diffuseColors
    Array<Texture> textures
    // True for each part (mesh) that is hidden: not drawn, casting no
    // shadow, and left out of the model's bounds. Parts past the end are
    // shown.
    Array<boolean> hiddenParts
    
    /*An array of VulkanBuffers representing the vertices of this model after animation has been applied. 
If this model doesn't have animations, the array will be undefined. Otherwise, the array will contain
one buffer per mesh in the model. */
    Array<VulkanBuffer> postAnimationVertexBuffers = undefined
    
    /*
    This action sets the diffuse color of a primitive model. If the model did not
    previously have a color applied to it, it will add a color to it.
    */
    action SetColor(Color color)
        SetColor(0, color)
end
    
    action SetColor(integer meshIndex, Color color)
        if meshIndex >= diffuseColors:GetSize()
            Model model = GetModel()
            integer meshCount = model:GetMeshCount()
            if meshIndex < meshCount
                // Increase the size of the array to fit the request. Extra values are initialized to undefined.
                diffuseColors:SetSize(meshIndex + 1)
            else
                alert("I cannot set the color of the mesh at index " + meshIndex + " because this model only contains " + meshCount + " meshes.")
            end
        end
        diffuseColors:Set(meshIndex, color)
    end
    
    action GetColor returns Color
        return GetColor(0)
    end
    
    action GetColor(integer meshIndex) returns Color
        if meshIndex >= diffuseColors:GetSize()
            return undefined
        end
        return diffuseColors:Get(meshIndex)
    end
    
    /*
    This action sets the texture of a primitive model. If the model did not
    previously have a texture applied to it, it will add a texture to it.
    */
    action SetTexture(Texture texture)
        SetTexture(0, texture)
end
    
    action SetTexture(integer meshIndex, Texture texture)
        if meshIndex >= textures:GetSize()
            Model model = GetModel()
            integer meshCount = model:GetMeshCount()
            if meshIndex < meshCount
                // Increase the size of the array to fit the request. Extra values are initialized to undefined.
                textures:SetSize(meshIndex + 1)
            else
                alert("I cannot set the texture of the mesh at index " + meshIndex + " because this model only contains " + meshCount + " meshes.")
            end
        end
        textures:Set(meshIndex, texture)
    end
    
    action GetTexture returns Texture
        return GetTexture(0)
    end
    
    action GetTexture(integer meshIndex) returns Texture
        if meshIndex >= textures:GetSize()
            return undefined
        end
        return textures:Get(meshIndex)
    end
    
    /*
    This action returns true if a part (mesh) of the model is drawn.

    Attribute: Parameter part The part, from 0.
    Attribute: Returns True if it is shown.
    */
    action IsPartShown(integer part) returns boolean
        if part < 0 or part >= hiddenParts:GetSize()
            return true
        end
        return not hiddenParts:Get(part)
    end

    /*
    This action shows or hides a part (mesh) of the model.

    Attribute: Parameter part The part, from 0.
    Attribute: Parameter shown True to draw it.
    */
    action SetPartShown(integer part, boolean shown)
        if part < 0
            return now
        end
        repeat while hiddenParts:GetSize() <= part
            hiddenParts:Add(false)
        end
        hiddenParts:Set(part, not shown)
    end

    /*
    This action returns true if any part of the model is hidden.

    Attribute: Returns True if a part is hidden.
    */
    action HasHiddenParts returns boolean
        integer i = 0
        repeat while i < hiddenParts:GetSize()
            if hiddenParts:Get(i)
                return true
            end
            i = i + 1
        end
        return false
    end

    action SetFromBlueprint(ModelBlueprint schematic)
        // Buffers made for a previous blueprint go first.
        Release()
        // Every part of a new blueprint starts shown.
        hiddenParts:Empty()

        // If the blueprint has animations, create one buffer per mesh to store post-animation transformed vertices.
        if schematic:HasAnimations()
            GameStateManager manager
            VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
            VulkanDevice device = graphics:GetDevice()
            VulkanConstants constants
            
            Array<VulkanBuffer> vertexBuffers
            postAnimationVertexBuffers = vertexBuffers
            
            ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, schematic)
            Array<MeshVulkan> meshes = vulkanBlueprint:GetMeshes()
            
            integer i = 0
            repeat while i < meshes:GetSize()
                MeshVulkan mesh = meshes:Get(i)
                
                VulkanBuffer newBuffer
                newBuffer:Create(device, mesh:GetVertexBufferSize(), constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,
constants:MEMORY_USAGE_AUTO, 0, 0, 0, false)
                vertexBuffers:Add(newBuffer)
                
                i = i + 1
            end
        end
end
    
    action GetRenderables(Array<Renderable> renderables)
        // Do nothing. Renderables are used for OpenGL resources.
end
    
    action GetPostAnimationVertexBuffers returns Array<VulkanBuffer>
        return postAnimationVertexBuffers
    end


    /*
    This action frees the model's own GPU buffers (the vertices of an
    animated model after animation) once no frame on the GPU still uses
    them. Model:Dispose calls it, and so does loading another blueprint.
    */
    action Release
        if postAnimationVertexBuffers = undefined
            return now
        end
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        integer i = 0
        repeat while i < postAnimationVertexBuffers:GetSize()
            graphics:Retire(postAnimationVertexBuffers:Get(i))
            i = i + 1
        end
        postAnimationVertexBuffers = undefined
    end

end