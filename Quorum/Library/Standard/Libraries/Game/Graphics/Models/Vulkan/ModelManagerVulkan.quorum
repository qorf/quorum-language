                //indexResourcesInfo:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
                //indexResourcesInfo:SetDestinationArrayElement(mesh:GetGlobalIndexBufferIndex())
                //indexResourcesInfo:AddBufferInfo(mesh:GetIndexBuffer(), 0, mesh:GetIndexBuffer():GetSize())
                //resourcesInfos:Add(indexResourcesInfo)
                //
                //globalMeshDescriptorSet:LinkResources(resourcesInfos)

                i = i + 1
            end

            pendingMeshes:Empty()
        end
        
        materialManager:ProcessPendingResources()
    end
    
action GetModelBlueprint(File file) returns ModelBlueprintVulkan
        text filePath = file:GetAbsolutePath()
        if cachedBlueprints:HasKey(filePath)
            return cachedBlueprints:GetValue(filePath)
        else
            ModelData data = modelLoader:Load(file)
            data:SetID(filePath)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(filePath, result)
            return result
        end
end
    
    action GetModelBlueprint(text filePath) returns ModelBlueprintVulkan
        File file
        file:SetPath(filePath)
        return GetModelBlueprint(file)
    end
    
    private action ConvertToBlueprint(ModelData data) returns ModelBlueprintVulkan
        ModelBlueprintVulkan result
        result:SetKey(data:GetID())
        result:SetData(data)
        
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanDevice device = graphics:GetDevice()
        
        Array<Material> materialData = data:GetMaterials()
        Array<MaterialVulkan> materials
        integer i = 0
        repeat while i < materialData:GetSize()
            MaterialVulkan material = materialManager:GetMaterial(materialData:Get(i))
            //material:Load(device, materialData:Get(i))
            materials:Add(material)
            materialManager:AddPendingMaterial(material)
            i = i + 1
        end
        result:SetMaterials(materials)
        
        Array<MeshData> meshData = data:GetMeshes()
        Array<MeshVulkan> meshes
        i = 0
        repeat while i < meshData:GetSize()
            MeshVulkan mesh
            mesh:Load(device, meshData:Get(i))
            mesh:SetMaterial(materials:Get(meshData:Get(i):GetMaterialIndex()))
            meshes:Add(mesh)
            pendingMeshes:Add(mesh)
            i = i + 1
        end
        result:SetMeshes(meshes)
        
        return result
    end
    
