package Libraries.Game.Graphics.Models.Vulkan

use Libraries.System.File
use Libraries.Containers.HashTable
use Libraries.Game.Graphics.Models.Data.ModelLoader
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Containers.Array
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Game.Graphics.Vulkan.VulkanDevice
use Libraries.Containers.Queue
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSet
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSetLayout
use Libraries.Game.Graphics.Vulkan.VulkanConstants
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSetManager
use Libraries.Game.Graphics.Vulkan.VulkanPhysicalDevice
use Libraries.Game.Graphics.Vulkan.VulkanPhysicalDeviceLimits
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSetLayoutBinding
use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.VulkanBuffer
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorResourcesInfo
use Libraries.Game.Graphics.Models.Data.Material
use Libraries.Game.Graphics.Models.Data.ModelBuilder
use Libraries.Game.Graphics.Models.Data.Animations
use Libraries.Game.Graphics.Models.Data.Animation
use Libraries.Game.Graphics.Models.Data.AnimationFrame
use Libraries.Compute.Vector4
use Libraries.Game.Graphics.Models.Data.AnimationMeshData
use Libraries.Compute.Matrix4
use Libraries.Game.Graphics.Vulkan.VulkanMemoryBarrier
use Libraries.Game.Graphics.Vulkan.VulkanSwapchain
use Libraries.Game.Graphics.Vulkan.Commands.PipelineBarrierCommand

shared class ModelManagerVulkan
    
    // A table containing cached ModelBlueprints. The key is the file path to the model file, or a generated key for primitives.
    HashTable<text, ModelBlueprintVulkan> cachedBlueprints
    ModelLoader modelLoader
    ModelBuilder modelBuilder
    
    constant text DELIMITER = ":"
    constant text PRIMITIVE_KEY = DELIMITER + "PRIMITIVE" + DELIMITER
    constant text PLANE_KEY = "PLANE" + DELIMITER
    constant text BOX_KEY = "BOX" + DELIMITER
    constant text SPHERE_KEY = "SPHERE" + DELIMITER
    constant text CYLINDER_KEY = "CYLINDER" + DELIMITER
    
    GameStateManager gameState
    
    // An array containing any meshes that are awaiting data transfers to GPU.
    Array<MeshVulkan> pendingMeshes
    // Meshes that already live on the GPU and have new vertex data waiting.
    Array<MeshVulkan> pendingUpdates

    // How many blueprints have been released. Painters compare it with the
    // count they last saw, to drop batches for released blueprints (Item 33).
    integer releaseCount = 0

    VulkanDevice device = undefined

    // Hash tables for retrieving the vertex buffer and index buffer indices in the global mesh arrays.
    HashTable<MeshVulkan, integer> meshToVertexBufferTable
    HashTable<MeshVulkan, integer> meshToIndexBufferTable
    // The next index to store a vertex/index buffer at in the global arrays.
    integer nextVertexBufferID = 0
    integer nextIndexBufferID = 0
    // TO-DO: NYI, whenever a mesh is disposed, store its index here. New meshes should reuse previously freed IDs before using a new index.
    Queue<integer> recycledVertexIDs
    Queue<integer> recycledIndexIDs
    
    AnimationManagerVulkan animationManager
    MaterialManagerVulkan materialManager
    
    on create
        modelLoader:UseLeftHandedCoordinates(true)
    end
    
    action Create(VulkanDevice device, VulkanGraphics graphics)
        me:device = device
        materialManager:Create(device)
        animationManager:Create(device)
    end
    
    action ProcessPendingResources
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        
        // While the window is minimized, the frame's command buffer is not
        // recording, so nothing can be recorded. Keep all waiting work for the
        // next frame that really draws.
        if graphics:IsRenderingPaused()
            return now
        end
        
        boolean copied = false
        VulkanConstants constants
        VulkanCommandBuffer commandBuffer = graphics:GetCurrentRenderCommandBuffer()
        
        if pendingUpdates:IsEmpty() = false
            // Earlier frames may still be drawing from these vertex buffers.
            // Make the copies wait until those reads are done.
            VulkanMemoryBarrier beforeCopy
            beforeCopy:SetSourceStageMask(constants:PIPELINE_STAGE_VERTEX_INPUT_BIT + constants:PIPELINE_STAGE_VERTEX_SHADER_BIT)
            beforeCopy:SetSourceAccessMask(0)
            beforeCopy:SetDestinationStageMask(constants:PIPELINE_STAGE_TRANSFER_BIT)
            beforeCopy:SetDestinationAccessMask(constants:ACCESS_TRANSFER_WRITE_BIT)
            PipelineBarrierCommand beforeCommand
            beforeCommand:SetMemoryBarrier(beforeCopy)
            commandBuffer:Record(beforeCommand)
            
            integer slot = graphics:GetCurrentResourceIndex()
            VulkanSwapchain swapchain = graphics:GetSwapchain()
            integer slotCount = swapchain:GetImageCount()
            integer u = 0
            repeat while u < pendingUpdates:GetSize()
                MeshVulkan updated = pendingUpdates:Get(u)
                updated:RecordUpdate(commandBuffer, slot, slotCount)
                u = u + 1
            end
            pendingUpdates:Empty()
            copied = true
        end
        
        if pendingMeshes:IsEmpty() = false
            integer i = 0
            repeat while i < pendingMeshes:GetSize()
                MeshVulkan mesh = pendingMeshes:Get(i)
                if mesh:HasData()
                    mesh:TransferBuffers(commandBuffer)
                end

                // Also store the vertex buffer in our global array and associate our resources.
                if not recycledVertexIDs:IsEmpty()
                    // TO-DO: Handle this case. This gets complicated by the question of releasing IDs that might be in use for previous frames.
                else
                    //globalVertexBufferArray:Add(mesh:GetVertexBuffer())
                    mesh:SetGlobalVertexBufferIndex(nextVertexBufferID)
                    nextVertexBufferID = nextVertexBufferID + 1
                end
                if not recycledIndexIDs:IsEmpty()
                    // TO-DO: Handle this case. This gets complicated by the question of releasing IDs that might be in use for previous frames.
                else
                    //globalIndexBufferArray:Add(mesh:GetIndexBuffer())
                    mesh:SetGlobalIndexBufferIndex(nextIndexBufferID)
                    nextIndexBufferID = nextIndexBufferID + 1
                end

                i = i + 1
            end

            pendingMeshes:Empty()
            copied = true
        end
        
        if copied
            // Drawing in this frame must wait until the copies are finished.
            VulkanMemoryBarrier afterCopy
            afterCopy:SetSourceStageMask(constants:PIPELINE_STAGE_TRANSFER_BIT)
            afterCopy:SetSourceAccessMask(constants:ACCESS_TRANSFER_WRITE_BIT)
            afterCopy:SetDestinationStageMask(constants:PIPELINE_STAGE_VERTEX_INPUT_BIT + constants:PIPELINE_STAGE_VERTEX_SHADER_BIT)
            afterCopy:SetDestinationAccessMask(constants:ACCESS_VERTEX_ATTRIBUTE_READ_BIT + constants:ACCESS_SHADER_READ_BIT + constants:ACCESS_MEMORY_READ_BIT)
            PipelineBarrierCommand afterCommand
            afterCommand:SetMemoryBarrier(afterCopy)
            commandBuffer:Record(afterCommand)
        end
        
        materialManager:ProcessPendingResources()
        animationManager:ProcessPendingResources()
    end
    
    /*
    This action adds a mesh to the list of meshes whose new vertex data is
    copied at the start of the next frame. MeshVulkan:UpdateVertices calls it;
    other code should not need to.

    Attribute: Parameter mesh The mesh with waiting vertex data.
    */
    action QueueMeshUpdate(MeshVulkan mesh)
        pendingUpdates:Add(mesh)
    end
    
action GetModelBlueprint(File file) returns ModelBlueprintVulkan
        text filePath = file:GetAbsolutePath()
        if cachedBlueprints:HasKey(filePath)
            return cachedBlueprints:GetValue(filePath)
        else
            ModelData data = modelLoader:Load(file)
            data:SetID(filePath)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(filePath, result)
            return result
        end
end
    
    action GetModelBlueprint(ModelData data) returns ModelBlueprintVulkan
        text key = data:GetID()
        if cachedBlueprints:HasKey(key)
            return cachedBlueprints:GetValue(key)
        else
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(key, result)
            return result
        end
 end
    
    action GetModelBlueprint(text filePath) returns ModelBlueprintVulkan
        File file
        file:SetPath(filePath)
        return GetModelBlueprint(file)
    end
    
    private action ConvertToBlueprint(ModelData data) returns ModelBlueprintVulkan
        ModelBlueprintVulkan result
        result:SetKey(data:GetID())
        result:SetData(data)
        
        boolean hasAnimations = data:GetAnimations() not= undefined
        
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanDevice device = graphics:GetDevice()
        
        Array<Material> materialData = data:GetMaterials()
        Array<MaterialVulkan> materials
        integer i = 0
        repeat while i < materialData:GetSize()
            MaterialVulkan material = materialManager:GetMaterial(materialData:Get(i))
            materials:Add(material)
            i = i + 1
        end
        result:SetMaterials(materials)
        
        Array<MeshData> meshData = data:GetMeshes()
        Array<MeshVulkan> meshes
        i = 0
        repeat while i < meshData:GetSize()
            MeshVulkan mesh
            AnimationMeshData animationData = undefined
            if hasAnimations
                animationData = data:GetAnimations():GetAnimationMeshData():Get(i)
            end
            
            mesh:Load(device, meshData:Get(i), animationData)
            mesh:SetMaterial(materials:Get(meshData:Get(i):GetMaterialIndex()))
            meshes:Add(mesh)
            pendingMeshes:Add(mesh)
            i = i + 1
        end
        result:SetMeshes(meshes)
        
        //Now if the model has animations, add them to a pending spot
        if hasAnimations
            Array<Animation> animations = data:GetAnimations():GetAnimations()
            Array<Array<AnimationFrameVulkan>> allFrames
            integer jointCount = -1
            if animations:IsEmpty() = false
                // Identify how many joints are stored in an arbitrary frame of animation.
                jointCount = animations:Get(0):GetFrames():Get(0):GetJoints():GetSize()
            end
            
            i = 0
            repeat while i < animations:GetSize()
                Array<AnimationFrameVulkan> frames = animationManager:GetAnimationFrames(animations:Get(i))
                allFrames:Add(frames)
                i = i + 1
            end
            
            // Create a frame with no animation, used to transform the bind pose when no other animation is playing.
            AnimationFrame bindPoseFrame = data:GetAnimations():GetBindPoseFrame()
            AnimationFrameVulkan bindPoseFrameVulkan = animationManager:GetAnimationFrame(bindPoseFrame)
            
            result:SetAnimationFrames(allFrames)
            result:SetBindPoseAnimationFrame(bindPoseFrameVulkan)
        end
        return result
    end
    
    action GetBoxBlueprint(number width, number height, number depth) returns ModelBlueprintVulkan
        text key = PRIMITIVE_KEY + BOX_KEY + width + DELIMITER + height + DELIMITER + depth
        if cachedBlueprints:HasKey(key)
            return cachedBlueprints:GetValue(key)
        else
            ModelData data = modelBuilder:CreateBox(width, height, depth)
            data:SetID(key)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(key, result)
            return result
        end
    end
    
    action GetCylinderBlueprint(number width, number height, number depth, integer divisions) returns ModelBlueprintVulkan
        text key = PRIMITIVE_KEY + CYLINDER_KEY + width + DELIMITER + height + DELIMITER + depth + DELIMITER + divisions
        if cachedBlueprints:HasKey(key)
            return cachedBlueprints:GetValue(key)
        else
            ModelData data = modelBuilder:CreateCylinder(width, height, depth, divisions)
            data:SetID(key)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(key, result)
            return result
        end
    end
    
    action GetSphereBlueprint(number width, number height, number depth, integer horizontalDivisions, integer verticalDivisions) returns ModelBlueprintVulkan
        text key = PRIMITIVE_KEY + SPHERE_KEY + width + DELIMITER + height + DELIMITER + depth + DELIMITER + horizontalDivisions + DELIMITER + verticalDivisions
        if cachedBlueprints:HasKey(key)
            return cachedBlueprints:GetValue(key)
        else
            ModelData data = modelBuilder:CreateSphere(width, height, depth, horizontalDivisions, verticalDivisions)
            data:SetID(key)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(key, result)
            return result
        end
    end
    
    action GetPlaneBlueprint(number width, number depth, boolean doubleSided) returns ModelBlueprintVulkan
        return GetPlaneBlueprint(width, depth, undefined, doubleSided)
    end
    
    action GetPlaneBlueprint(number width, number depth, Vector4 textureCoordinates, boolean doubleSided) returns ModelBlueprintVulkan
        number left = 0
        number right = 1
        number bottom = 0
        number top = 1
        if textureCoordinates not= undefined
            left = textureCoordinates:GetX()
            bottom = textureCoordinates:GetY()
            right = textureCoordinates:GetZ()
            top = textureCoordinates:GetW()
        else
            Vector4 new
            textureCoordinates = new
            new:Set(left, bottom, right, top)
        end
        text key = PRIMITIVE_KEY + PLANE_KEY + width + DELIMITER + depth + DELIMITER +
left + DELIMITER + bottom + DELIMITER + right + DELIMITER + top + DELIMITER + doubleSided
        if cachedBlueprints:HasKey(key)
            return cachedBlueprints:GetValue(key)
        else
            ModelData data = modelBuilder:CreatePlane(width, depth, textureCoordinates, doubleSided)
            data:SetID(key)
            ModelBlueprintVulkan result = ConvertToBlueprint(data)
            cachedBlueprints:Add(key, result)
            return result
        end
    end
    
    /*
    This action counts a model as using a blueprint. Model:Load calls it.

    Attribute: Parameter schematic The blueprint the model loaded.
    */
    action AddUser(ModelBlueprintVulkan schematic)
        schematic:AddUser()
    end

    /*
    This action counts one fewer model using a blueprint. When no model
    uses it, it is taken out of the cache and its GPU memory is freed, once
    no frame on the GPU still uses it. Primitive blueprints (boxes, planes,
    spheres and cylinders) stay cached, since they are small and often used
    again. Model:Load and Model:Dispose call it.

    Attribute: Parameter schematic The blueprint a model no longer uses.
    */
    action RemoveUser(ModelBlueprintVulkan schematic)
        if schematic:RemoveUser() > 0 or schematic:IsReleased()
            return now
        end
        text key = schematic:GetKey()
        if key not= undefined and key:StartsWith(PRIMITIVE_KEY)
            return now
        end

        if key not= undefined and cachedBlueprints:HasKey(key)
            if cachedBlueprints:GetValue(key) = schematic
                cachedBlueprints:RemoveKey(key)
            end
        end

        // Meshes and frames never copied must not be copied now.
        Array<MeshVulkan> meshes = schematic:GetMeshes()
        if meshes not= undefined
            integer i = 0
            repeat while i < meshes:GetSize()
                pendingMeshes:Remove(meshes:Get(i))
                pendingUpdates:Remove(meshes:Get(i))
                i = i + 1
            end
        end
        Array<Array<AnimationFrameVulkan>> allFrames = schematic:GetAnimationFrames()
        if allFrames not= undefined
            integer k = 0
            repeat while k < allFrames:GetSize()
                Array<AnimationFrameVulkan> frames = allFrames:Get(k)
                integer j = 0
                repeat while j < frames:GetSize()
                    animationManager:RemovePendingAnimationFrame(frames:Get(j))
                    j = j + 1
                end
                k = k + 1
            end
        end
        if schematic:GetBindPoseAnimationFrame() not= undefined
            animationManager:RemovePendingAnimationFrame(schematic:GetBindPoseAnimationFrame())
        end

        schematic:Release()
        releaseCount = releaseCount + 1
    end

    /*
    This action returns how many blueprints have been released so far.

    Attribute: Returns The number of released blueprints.
    */
    action GetReleaseCount returns integer
        return releaseCount
    end

    /*
    This action returns how many blueprints are cached.

    Attribute: Returns The number of cached blueprints.
    */
    action GetCachedBlueprintCount returns integer
        return cachedBlueprints:GetSize()
    end

    action GetMaterialManager returns MaterialManagerVulkan
        return materialManager
    end

end