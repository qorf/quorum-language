package Libraries.Game.Graphics.Models.Vulkan

use Libraries.Game.Graphics.Vulkan.VulkanDevice
use Libraries.Game.Graphics.Vulkan.VulkanBuffer
use Libraries.Game.Graphics.Models.Data.Material
use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.VulkanConstants
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Array
use Libraries.Game.NumberUtilities
use Libraries.Compute.Vector4
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Vulkan.VulkanTextureManager
use Libraries.Game.Graphics.SharedTextureManager
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Vulkan.VulkanNumber32BitMappedMemory
use Libraries.Game.Graphics.Vulkan.Commands.CopyBufferCommand
use Libraries.Game.Graphics.PixelMap
use Libraries.Game.Graphics.Format
use Libraries.Game.Graphics.Color
use Libraries.System.File
use Libraries.Compute.Math

class MaterialVulkan
    
    VulkanDevice device = undefined
    
    boolean dataTransferred = false
    
    /*The buffer for an individual material holds this data:
Diffuse color (RGBA8888, 4 bytes)
Texture index (uint, 4 bytes); for a texture set, its albedo-height texture
Has Normal Map? (uint, 4 bytes, 0 or 1 for boolean logic)
Has Rough Map? (uint, 4 bytes, 0 or 1 for boolean logic)
Normal map index (uint, 4 bytes); for a texture set, its normal-roughness texture
Rough map index (uint, 4 bytes)
Roughness Factor (float, 4 bytes)
Metallic Factor (float, 4 bytes)
Flags (uint, 4 bytes): the FLAG constants below added together
Texture scale (float, 4 bytes): world units per tile, for terrain
Emissive color (RGBA8888, 4 bytes): the light the surface gives off
Emissive map index (uint, 4 bytes)
Emissive strength (float, 4 bytes): 1 for the color as it is
Ambient occlusion map index (uint, 4 bytes); its red channel is used
Alpha cutoff (float, 4 bytes): pixels with less alpha aren't drawn
Normal strength (float, 4 bytes): how strongly the normal map bends light
Texture offset x and y, scale x and y, and turn in radians (5 floats)
Sway strength (float, 4 bytes): with the SWAY flag, how far a point moves
sideways per unit of height above its model's origin
Sway direction (float, 4 bytes): the wind's direction about the up axis, in
radians from +x toward +z. A per-material angle was chosen
over two packed halves: it is one number, and the shader turns it with cos
and sin.
Transmission (uint, 4 bytes): with the TRANSMISSION flag, how much light goes
through the surface, 0 to 255 in the low 8 bits; bit 8 set if there is a
transmission texture; and that texture's index in the bits above.
The emissive and later words hold the light the surface gives off, and
the maps and settings that model files bring.*/
    constant integer DIFFUSE_INDEX = 0
    constant integer TEXTURE_INDEX = 1
    constant integer HAS_NORMAL_MAP_INDEX = 2
    constant integer HAS_ROUGH_MAP_INDEX = 3
    constant integer NORMAL_MAP_INDEX = 4
    constant integer ROUGH_MAP_INDEX = 5
    constant integer ROUGH_FACTOR_INDEX = 6
    constant integer METALLIC_FACTOR_INDEX = 7
    constant integer FLAGS_INDEX = 8
    constant integer TEXTURE_SCALE_INDEX = 9
    constant integer EMISSIVE_COLOR_INDEX = 10
    constant integer EMISSIVE_MAP_INDEX = 11
    constant integer EMISSIVE_STRENGTH_INDEX = 12
    constant integer OCCLUSION_MAP_INDEX = 13
    constant integer ALPHA_CUTOFF_INDEX = 14
    constant integer NORMAL_STRENGTH_INDEX = 15
    constant integer UV_OFFSET_X_INDEX = 16
    constant integer UV_OFFSET_Y_INDEX = 17
    constant integer UV_SCALE_X_INDEX = 18
    constant integer UV_SCALE_Y_INDEX = 19
    constant integer UV_ROTATION_INDEX = 20
    constant integer SWAY_STRENGTH_INDEX = 21
    constant integer SWAY_DIRECTION_INDEX = 22
    constant integer TRANSMISSION_INDEX = 23

    // The flags. The shaders test the same numbers.
    constant integer TEXTURE_SET_FLAG = 1
    constant integer EMISSIVE_MAP_FLAG = 2
    constant integer OCCLUSION_MAP_FLAG = 4
    constant integer UNLIT_FLAG = 8
    constant integer TWO_SIDED_FLAG = 16
    constant integer TEXTURE_TRANSFORM_FLAG = 32
    constant integer ALPHA_RELATIVE_FLAG = 64
    // The vertex shaders move the material's points sideways in the wind.
    constant integer SWAY_FLAG = 128
    // Light goes through the surface.
    constant integer TRANSMISSION_FLAG = 256

    constant integer MATERIAL_BYTE_SIZE = 4 * 24
    
    VulkanBuffer stagingBuffer = undefined
    VulkanBuffer materialBuffer = undefined
    
    integer globalMaterialIndex = -1
    
    Material preloadData = undefined
    Texture preloadTexture = undefined
    Texture preloadNormalMap = undefined
    Texture preloadRoughMap = undefined
    Texture preloadEmissiveMap = undefined
    Texture preloadOcclusionMap = undefined
    Texture preloadTransmissionMap = undefined

    // Whether both sides of each face are drawn, kept
    // after loading so the painter can draw the model without culling.
    boolean twoSided = false

    // Whether the material is drawn after the lighting, back to front: it
    // is less than opaque, blends ("BLEND"), or lets light through.
    // Kept after loading, so the painter can draw a
    // model's see-through meshes apart from its opaque ones.
    boolean seeThrough = false
    // Whether light goes through it, so the painter
    // copies what is behind before drawing it.
    boolean transmissive = false

    // For a texture set: whether this material is one, and its two packed
    // textures, kept after loading so terrain can find their places.
    boolean usesTextureSet = false
    Texture albedoHeightTexture = undefined
    Texture normalRoughnessTexture = undefined
    number textureScale = 1
    
    integer textureGroupIndex = -1

    // When the material's textures are not all in one texture group, a
    // block of places in one group that holds them all: its first place in the global array, or -1, and the textures
    // linked into it, in order. The shader binds one group and finds every
    // map inside it, so a map in another group would read another texture.
    integer blockStart = -1
    Array<Texture> blockTextures

    // The textures this material uses that it got from the material
    // manager (files and texture sets, not the unit texture), given back
    // in Release.
    Array<Texture> usedTextures

    // A texture set's packed pixels, disposed once both textures are
    // copied.
    PixelMap packedAlbedoHeight = undefined
    PixelMap packedNormalRoughness = undefined

    boolean released = false

    // The wind's sway: its strength, its direction in
    // radians, the flags without the sway's, and the words last loaded, so
    // a change of sway can send the material again.
    number swayStrength = 0
    number swayDirection = 0
    integer loadedFlags = 0
    Number32BitArray loadedWords = undefined
    
    // Ensures all data in the material that needs to be pre-processed, such as textures, are sent to their appropriate managers.
    action Preload(VulkanDevice device, Material data)
        me:device = device
        preloadData = data
        twoSided = data:IsTwoSided()
        text mode = data:GetAlphaMode()
        transmissive = data:GetTransmission() > 0
        seeThrough = data:GetOpaque() < 1 or transmissive
        if mode not= undefined and mode = "BLEND"
            seeThrough = true
        end
        // The wind's sway.
        Math swayMath
        swayStrength = data:GetSway()
        swayDirection = data:GetSwayDirection() * swayMath:pi / 180

        if data:UsesTextureSet()
            PreloadTextureSet(data)
            return now
        end
        
        text texturePath = data:GetTexturePath()
        text normalPath = data:GetNormalMapPath()
        text roughPath = data:GetMetalRoughMap()
        
        if texturePath = undefined or texturePath = ""
            // Simply requesting the unit texture from the manager is enough to ensure it will be sent to the texture manager for loading, if it hasn't been already.
            // The game's one shared manager, so every material uses the same
            // unit texture. Declaring a SharedTextureManager here made a new
            // manager, and a new white texture, for every material.
            GameStateManager unitState
            SharedTextureManager sharedTextures = unitState:GetSharedTextureManager()
            preloadTexture = sharedTextures:GetUnitTexture()
        else
            // Mipmaps keep distant models from shimmering.
            preloadTexture = UseFileTexture(texturePath, false)
        end
        if normalPath = undefined or normalPath = ""
            // Do nothing, no normal map is used.
        else
            // A normal map's mipmaps average directions, so far normals
            // stay real normals.
            preloadNormalMap = UseFileTexture(normalPath, true)
        end
        if roughPath = undefined or roughPath = ""
            // Do nothing, no rough map is used.
        else
            preloadRoughMap = UseFileTexture(roughPath, false)
        end

        // The emissive and ambient occlusion maps.
        // A texture set packs its own occlusion, so this is only for other
        // materials, such as those loaded from model files.
        text emissivePath = data:GetEmissiveMapPath()
        if emissivePath not= undefined and emissivePath not= ""
            preloadEmissiveMap = UseFileTexture(emissivePath, false)
        end
        text occlusionPath = data:GetAmbientOcclusionMapPath()
        if occlusionPath not= undefined and occlusionPath not= ""
            preloadOcclusionMap = UseFileTexture(occlusionPath, false)
        end
        // The transmission texture.
        text transmissionPath = data:GetTransmissionMapPath()
        if data:GetTransmission() > 0 and transmissionPath not= undefined and transmissionPath not= ""
            preloadTransmissionMap = UseFileTexture(transmissionPath, false)
        end
        
        
    end
    
    /*
    This action packs a texture set into two textures, as Terrain3D does,
    and sends them to the texture manager:
    - albedo-height: the color map's red, green and blue, and the height
      map's gray in alpha (middle gray if there's none);
    - normal-roughness: the normal map (flat if there's none, and turned to
      the OpenGL convention if it's DirectX), with the ambient occlusion map
      folded into the normals' length, and the roughness map's gray in alpha
      (the roughness factor if there's none).
    All maps must be the same size as the color map.

    Attribute: Parameter data The material, a texture set.
    */
    private action PreloadTextureSet(Material data)
        usesTextureSet = true
        textureScale = data:GetTextureScale()

        // A set already packed for another material is shared.
        ModelManagerVulkan models
        MaterialManagerVulkan materials = models:GetMaterialManager()
        text setKey = "set:" + data:GetColorMapPath() + "|" + data:GetHeightMapPath() + "|" +
            data:GetNormalMapPath() + "|" + data:IsNormalMapDirectX() + "|" +
            data:GetAmbientOcclusionMapPath() + "|" + data:GetRoughnessMapPath() + "|" + data:GetRoughness()
        Texture sharedAlbedo = materials:UseSharedTexture(setKey + ":albedo")
        if sharedAlbedo not= undefined
            albedoHeightTexture = sharedAlbedo
            normalRoughnessTexture = materials:UseSharedTexture(setKey + ":normal")
            usedTextures:Add(albedoHeightTexture)
            usedTextures:Add(normalRoughnessTexture)
            preloadTexture = albedoHeightTexture
            preloadNormalMap = normalRoughnessTexture
            return now
        end

        PixelMap albedoHeight = LoadMap(data:GetColorMapPath())
        integer width = albedoHeight:GetWidth()
        integer height = albedoHeight:GetHeight()

        if data:GetHeightMapPath() = ""
            albedoHeight:SetChannel(3, 128)
        else
            PixelMap heights = LoadMatchingMap(data:GetHeightMapPath(), width, height)
            albedoHeight:CopyGrayValue(heights, 3)
            heights:Dispose()
        end

        PixelMap normalRoughness = undefined
        if data:GetNormalMapPath() = ""
            PixelMap flat
            Format format
            format:SetValue(format:RGBA8888)
            flat:CreatePixelMap(width, height, format)
            Color color
            flat:Fill(color:CustomColor(128 / 255.0, 128 / 255.0, 1, 1))
            normalRoughness = flat
        else
            normalRoughness = LoadMatchingMap(data:GetNormalMapPath(), width, height)
            if data:IsNormalMapDirectX()
                normalRoughness:InvertChannel(1)
            end
        end

        if data:GetAmbientOcclusionMapPath() not= ""
            PixelMap occlusion = LoadMatchingMap(data:GetAmbientOcclusionMapPath(), width, height)
            normalRoughness:ScaleNormalsByOcclusion(occlusion)
            occlusion:Dispose()
        end

        if data:GetRoughnessMapPath() = ""
            Math math
            normalRoughness:SetChannel(3, cast(integer, math:Round(math:Clamp(data:GetRoughness(), 0, 1) * 255)))
        else
            PixelMap roughness = LoadMatchingMap(data:GetRoughnessMapPath(), width, height)
            normalRoughness:CopyGrayValue(roughness, 3)
            roughness:Dispose()
        end

        // The material frees these pixels itself, once both textures are
        // copied (Load) or when it is released first (Release), so the
        // texture manager mustn't free them as it copies them.
        albedoHeight:SetDisposeAfterTextureLoad(false)
        normalRoughness:SetDisposeAfterTextureLoad(false)

        // Both get mipmaps. The normals' mipmaps keep the
        // ambient occlusion carried in their length.
        Texture albedo
        albedo:LoadFromPixelMap(albedoHeight, albedoHeight:GetFormat(), true)
        Texture normals
        normals:SetPackedNormalMipMaps(true)
        normals:LoadFromPixelMap(normalRoughness, normalRoughness:GetFormat(), true)
        albedoHeightTexture = albedo
        normalRoughnessTexture = normals
        preloadTexture = albedo
        preloadNormalMap = normals
        materials:AddSharedTexture(setKey + ":albedo", albedo)
        materials:AddSharedTexture(setKey + ":normal", normals)
        usedTextures:Add(albedo)
        usedTextures:Add(normals)
        packedAlbedoHeight = albedoHeight
        packedNormalRoughness = normalRoughness
    end

    /*
    This action loads an image file into a PixelMap.

    Attribute: Parameter path The file's path.
    Attribute: Returns The PixelMap.
    */
    private action LoadMap(text path) returns PixelMap
        // A map's path may be a full path, as a material file's maps are
        // (Material's Load), and File's SetPath doesn't take those.
        Material paths
        File file = paths:MakeFile(path)
        if not file:Exists()
            alert("I couldn't find the texture set map " + path + ".")
        end
        PixelMap map
        map:LoadPixelMap(file)
        return map
    end

    /*
    This action loads an image file into a PixelMap, and checks it is the
    expected size.

    Attribute: Parameter path The file's path.
    Attribute: Parameter width The width it must have.
    Attribute: Parameter height The height it must have.
    Attribute: Returns The PixelMap.
    */
    private action LoadMatchingMap(text path, integer width, integer height) returns PixelMap
        PixelMap map = LoadMap(path)
        if map:GetWidth() not= width or map:GetHeight() not= height
            alert("The texture set map " + path + " is " + map:GetWidth() + " by " + map:GetHeight() +
                ", but the color map is " + width + " by " + height + ". All maps in a set must be the same size.")
        end
        return map
    end

    /*Loads the material's data into host-visible memory, in preparation for transfer to the GPU later. Must be done after preload,
because texture information must be processed in advance to prevent placeholder texture IDs from being inserted into the buffer.
Ensure the VulkanTextureManager processes its pending resources between calling Preload and Load (this happens automatically when using the
default material loading system, as part of the model load system).*/
    action Load
        if preloadData = undefined
            alert("I couldn't load this data because Preload wasn't called first. Call Preload and allow the TextureManager to process pending requests before loading.")
        end
        if IsReady()
            alert("I cannot load data into this mesh because it has already been loaded!")
        elseif HasData()
            alert("I cannot set this mesh's data because the data was already set!")
        end
        
        Material data = preloadData
        
        VulkanConstants constants
        NumberUtilities utility
        
        VulkanBuffer stagingBuffer
        me:stagingBuffer = stagingBuffer
        
        stagingBuffer:CreateTransferSourceBuffer(device, MATERIAL_BYTE_SIZE)
        
        Vector4 diffuse = data:GetDiffuse()
        
        Number32BitArray dataArray
        dataArray:SetSize(MATERIAL_BYTE_SIZE / 4)
        // If no diffuse color is used, use a default white.
        if diffuse not= undefined
            Libraries.Compute.BitwiseOperations ops
            
            integer a = ops:ShiftLeft(cast(integer, diffuse:GetW() * 255), 24)
        integer b = ops:ShiftLeft(cast(integer, diffuse:GetZ() * 255), 16)
        integer g = ops:ShiftLeft(cast(integer, diffuse:GetY() * 255), 8)
        integer r = cast(integer, diffuse:GetX() * 255)

        integer result = ops:Or(ops:Or(a, b), ops:Or(g, r))
            
            dataArray:Set(DIFFUSE_INDEX, utility:PackNormalizedVector4(diffuse:GetX(), diffuse:GetY(), diffuse:GetZ(), diffuse:GetW()))
            
        else
            dataArray:Set(DIFFUSE_INDEX, utility:PackNormalizedVector4(1.0, 1.0, 1.0, 1.0))
        end
        
        // All the material's textures in one group, in a block of its own
        // if they are spread over more than one.
        KeepTexturesInOneGroup()

        // There is always a texture, whether its custom or the default unit texture.
        dataArray:Set(TEXTURE_INDEX, utility:EncodeIntegerAsNumber(GetPlaceInGroup(preloadTexture)))

        textureGroupIndex = preloadTexture:GetVulkanTextureGroupIndex()
        if blockStart >= 0
            textureGroupIndex = blockStart / GetTextureManager():GetDescriptorSetEntries()
        end

        if preloadNormalMap = undefined
            dataArray:Set(HAS_NORMAL_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
            dataArray:Set(NORMAL_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
        else
            dataArray:Set(HAS_NORMAL_MAP_INDEX, utility:EncodeIntegerAsNumber(1))
            dataArray:Set(NORMAL_MAP_INDEX, utility:EncodeIntegerAsNumber(GetPlaceInGroup(preloadNormalMap)))
        end
        if preloadRoughMap = undefined
            dataArray:Set(HAS_ROUGH_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
            dataArray:Set(ROUGH_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
        else
            dataArray:Set(HAS_ROUGH_MAP_INDEX, utility:EncodeIntegerAsNumber(1))
            dataArray:Set(ROUGH_MAP_INDEX, utility:EncodeIntegerAsNumber(GetPlaceInGroup(preloadRoughMap)))
        end
        dataArray:Set(ROUGH_FACTOR_INDEX, data:GetRoughness())
        dataArray:Set(METALLIC_FACTOR_INDEX, data:GetMetallic())
        dataArray:Set(TEXTURE_SCALE_INDEX, data:GetTextureScale())

        integer flags = 0
        if usesTextureSet
            flags = flags + TEXTURE_SET_FLAG
        end

        // The light the surface gives off.
        Vector4 emissive = data:GetEmissive()
        if emissive = undefined
            dataArray:Set(EMISSIVE_COLOR_INDEX, utility:PackNormalizedVector4(0, 0, 0, 0))
        else
            dataArray:Set(EMISSIVE_COLOR_INDEX, utility:PackNormalizedVector4(Clamp(emissive:GetX()), Clamp(emissive:GetY()), Clamp(emissive:GetZ()), 1.0))
        end
        if preloadEmissiveMap = undefined
            dataArray:Set(EMISSIVE_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
        else
            flags = flags + EMISSIVE_MAP_FLAG
            dataArray:Set(EMISSIVE_MAP_INDEX, utility:EncodeIntegerAsNumber(GetPlaceInGroup(preloadEmissiveMap)))
        end
        dataArray:Set(EMISSIVE_STRENGTH_INDEX, data:GetEmissiveStrength())

        // What model files bring.
        if preloadOcclusionMap = undefined
            dataArray:Set(OCCLUSION_MAP_INDEX, utility:EncodeIntegerAsNumber(0))
        else
            flags = flags + OCCLUSION_MAP_FLAG
            dataArray:Set(OCCLUSION_MAP_INDEX, utility:EncodeIntegerAsNumber(GetPlaceInGroup(preloadOcclusionMap)))
        end
        if data:IsUnlit()
            flags = flags + UNLIT_FLAG
        end
        if twoSided
            flags = flags + TWO_SIDED_FLAG
        end
        // How transparent pixels are cut out. "OPAQUE" cuts out nothing;
        // "MASK" cuts out below its cutoff. A material that doesn't say
        // keeps the old rule: the texture's alpha below half. "BLEND" uses
        // the old rule too until see-through drawing.
        text alphaMode = data:GetAlphaMode()
        if alphaMode = "OPAQUE"
            dataArray:Set(ALPHA_CUTOFF_INDEX, 0.0)
        elseif alphaMode = "MASK"
            dataArray:Set(ALPHA_CUTOFF_INDEX, data:GetAlphaCutoff())
        else
            flags = flags + ALPHA_RELATIVE_FLAG
            dataArray:Set(ALPHA_CUTOFF_INDEX, 0.5)
        end
        dataArray:Set(NORMAL_STRENGTH_INDEX, data:GetBumpShading())
        if data:GetTextureOffsetX() not= 0 or data:GetTextureOffsetY() not= 0 or data:GetTextureScaleX() not= 1 or data:GetTextureScaleY() not= 1 or data:GetTextureRotation() not= 0
            flags = flags + TEXTURE_TRANSFORM_FLAG
        end
        dataArray:Set(UV_OFFSET_X_INDEX, data:GetTextureOffsetX())
        dataArray:Set(UV_OFFSET_Y_INDEX, data:GetTextureOffsetY())
        dataArray:Set(UV_SCALE_X_INDEX, data:GetTextureScaleX())
        dataArray:Set(UV_SCALE_Y_INDEX, data:GetTextureScaleY())
        dataArray:Set(UV_ROTATION_INDEX, data:GetTextureRotation())

        // How much light goes through: the amount in
        // the low 8 bits, the texture's place in the rest.
        integer transmissionWord = 0
        if data:GetTransmission() > 0
            flags = flags + TRANSMISSION_FLAG
            integer amount = cast(integer, Clamp(data:GetTransmission()) * 255 + 0.5)
            transmissionWord = amount
            if preloadTransmissionMap not= undefined
                transmissionWord = GetPlaceInGroup(preloadTransmissionMap) * 512 + 256 + amount
            end
        end
        dataArray:Set(TRANSMISSION_INDEX, utility:EncodeIntegerAsNumber(transmissionWord))
        // The flags, with the sway's flag and its two words. The words are kept so SetSway can send them again.
        loadedFlags = flags
        WriteSwayWords(dataArray)
        loadedWords = dataArray
        
        VulkanNumber32BitMappedMemory mapping = stagingBuffer:MapToNumber32BitMemory()
        mapping:Set(dataArray)
        stagingBuffer:StopMapping()

        // A texture set's packed pixels have been copied by now. The PixelMaps are automatically disposed after texture load,
        // so now we just release the Quorum objects so they can be garbage collected.
        if packedAlbedoHeight not= undefined and albedoHeightTexture:GetVulkanTextureIndex() >= 0
            packedAlbedoHeight = undefined
        end
        if packedNormalRoughness not= undefined and normalRoughnessTexture:GetVulkanTextureIndex() >= 0
            packedNormalRoughness = undefined
        end
        
        preloadData = undefined
        preloadTexture = undefined
        preloadNormalMap = undefined
        preloadRoughMap = undefined
        preloadEmissiveMap = undefined
        preloadOcclusionMap = undefined
        preloadTransmissionMap = undefined
    end

    /*
    This action makes sure all the material's textures can be found in one
    texture group. The painter binds one group for the
    material, its color texture's, and the shader finds every map by its
    place inside that group, so a map whose texture is in another group
    would read whatever texture is at that place. Usually all are in one
    group and nothing is done. Otherwise a block of places in one group is
    reserved, each texture is linked into it as well as its own place, and
    the material uses the block's places (GetPlaceInGroup). The block is
    given back in Release.
    */
    private action KeepTexturesInOneGroup
        Array<Texture> textures
        AddUsedTexture(textures, preloadTexture)
        AddUsedTexture(textures, preloadNormalMap)
        AddUsedTexture(textures, preloadRoughMap)
        AddUsedTexture(textures, preloadEmissiveMap)
        AddUsedTexture(textures, preloadOcclusionMap)
        AddUsedTexture(textures, preloadTransmissionMap)
        if textures:GetSize() < 2
            return now
        end

        integer group = textures:Get(0):GetVulkanTextureGroupIndex()
        boolean split = false
        integer i = 0
        repeat while i < textures:GetSize()
            Texture texture = textures:Get(i)
            if texture:GetVulkanTextureIndex() < 0 or texture:GetVulkanTextureGroupIndex() not= group
                split = true
            end
            i = i + 1
        end
        if not split
            return now
        end

        VulkanTextureManager manager = GetTextureManager()
        integer first = manager:ReserveBlock(textures:GetSize())
        boolean linked = true
        i = 0
        repeat while i < textures:GetSize()
            if not manager:LinkTextureAt(textures:Get(i), first + i)
                linked = false
            end
            i = i + 1
        end

        text name = ""
        if preloadData not= undefined and preloadData:GetName() not= undefined
            name = preloadData:GetName()
        end
        if not linked
            // A texture without an image yet can't be linked; the material
            // keeps the places it had.
            manager:ReleaseBlock(first, textures:GetSize())
            output "Texture groups: the material '" + name + "' has textures in more than one group, but not all were loaded, so they could not be put together."
            return now
        end

        blockStart = first
        blockTextures:Empty()
        i = 0
        repeat while i < textures:GetSize()
            blockTextures:Add(textures:Get(i))
            i = i + 1
        end
    end

    /*
    This action adds a texture to a list if it is used and not already in it.

    Attribute: Parameter textures The list.
    Attribute: Parameter texture The texture, or undefined.
    */
    private action AddUsedTexture(Array<Texture> textures, Texture texture)
        if texture = undefined
            return now
        end
        integer i = 0
        repeat while i < textures:GetSize()
            if textures:Get(i) = texture
                return now
            end
            i = i + 1
        end
        textures:Add(texture)
    end

    /*
    This action returns a texture's place inside the material's group: its
    place in the material's block if it has one (KeepTexturesInOneGroup),
    or else its own place inside its own group.

    Attribute: Parameter texture One of the material's textures.
    Attribute: Returns Its place inside the group the material is drawn with.
    */
    private action GetPlaceInGroup(Texture texture) returns integer
        if blockStart >= 0
            integer i = 0
            repeat while i < blockTextures:GetSize()
                if blockTextures:Get(i) = texture
                    return (blockStart + i) mod GetTextureManager():GetDescriptorSetEntries()
                end
                i = i + 1
            end
        end
        return texture:GetVulkanTextureLocalIndex()
    end

    // The Vulkan texture manager.
    private action GetTextureManager returns VulkanTextureManager
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        return graphics:GetTextureManager()
    end

    /*
    This action keeps a color part between 0 and 1, as a packed color holds.

    Attribute: Parameter value The part.
    Attribute: Returns The part, from 0 to 1.
    */
    private action Clamp(number value) returns number
        if value < 0
            return 0
        elseif value > 1
            return 1
        end
        return value
    end

    /*
    This action returns true if both sides of the material's faces are
    drawn, as for leaves and cards.

    Attribute: Returns True for two-sided.
    */
    action IsTwoSided returns boolean
        return twoSided
    end

    /*
    This action returns true if the material is drawn see-through, after
    the lighting: it is less than opaque, blends ("BLEND"), or lets light
    through.

    Attribute: Returns True for a see-through material.
    */
    action IsSeeThrough returns boolean
        return seeThrough
    end

    /*
    This action returns true if light goes through the material.

    Attribute: Returns True if the material has transmission.
    */
    action IsTransmissive returns boolean
        return transmissive
    end
    
    action IsPreloaded returns boolean
        return preloadData not= undefined
    end
    
    action HasData returns boolean
        return stagingBuffer not= undefined or materialBuffer not= undefined
    end
    
    action IsReady returns boolean
        return materialBuffer not= undefined and dataTransferred
    end
    
    action GetDevice returns VulkanDevice
        return device
    end
    
    action TransferBuffers(VulkanCommandBuffer commandBuffer)
        if dataTransferred
            return now
        end

        // A material sent again after its sway changed
        // gets a new buffer; frames already recorded may still read the
        // old one, so it is retired.
        if materialBuffer not= undefined
            GameStateManager retireState
            VulkanGraphics retireGraphics = cast(VulkanGraphics, retireState:GetGameGraphics())
            retireGraphics:Retire(materialBuffer)
            materialBuffer = undefined
        end
        
        VulkanBuffer destination
        materialBuffer = destination
        
        VulkanConstants constants
        materialBuffer:CreateTransferDestinationBuffer(device, MATERIAL_BYTE_SIZE, constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        
        CopyBufferCommand copyCommand
        copyCommand:SetSourceBuffer(stagingBuffer)
        copyCommand:SetDestinationBuffer(materialBuffer)
        copyCommand:SetSize(materialBuffer:GetSize())        

        commandBuffer:Record(copyCommand)
        
        dataTransferred = true

        // The copy is the staging buffer's only use.
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        graphics:Retire(stagingBuffer)
        stagingBuffer = undefined
    end
    
    action GetBuffer returns VulkanBuffer
        return materialBuffer
    end
    
    action GetGlobalMaterialIndex returns integer
        return globalMaterialIndex
    end

    action SetGlobalMaterialIndex(integer globalMaterialIndex)
        me:globalMaterialIndex = globalMaterialIndex
    end

    action GetTextureGroupIndex returns integer
        return textureGroupIndex
    end

    /*
    This action returns true if the material was loaded from a texture set.

    Attribute: Returns True for a texture set.
    */
    action UsesTextureSet returns boolean
        return usesTextureSet
    end

    /*
    This action returns a texture set's packed albedo-height texture: color
    in red, green and blue, height in alpha.

    Attribute: Returns The texture, or undefined if the material isn't a texture set.
    */
    action GetAlbedoHeightTexture returns Texture
        return albedoHeightTexture
    end

    /*
    This action returns a texture set's packed normal-roughness texture:
    the normal in red, green and blue (its length carrying ambient
    occlusion), roughness in alpha.

    Attribute: Returns The texture, or undefined if the material isn't a texture set.
    */
    action GetNormalRoughnessTexture returns Texture
        return normalRoughnessTexture
    end

    /*
    This action returns how many world units one tile of the material covers
    on terrain.

    Attribute: Returns The size of one tile, in world units.
    */
    action GetTextureScale returns number
        return textureScale
    end

    /*
    This action returns the texture for an image file, shared with every
    material using the same file, loading it the first time.

    Attribute: Parameter path The file's path.
    Attribute: Parameter packedNormals True for a normal map.
    Attribute: Returns The texture.
    */
    private action UseFileTexture(text path, boolean packedNormals) returns Texture
        ModelManagerVulkan models
        MaterialManagerVulkan materials = models:GetMaterialManager()
        text key = path
        if packedNormals
            key = path + ":normal"
        end
        Texture texture = materials:UseSharedTexture(key)
        if texture = undefined
            Texture loaded
            loaded:SetPackedNormalMipMaps(packedNormals)
            loaded:LoadFromFile(path, true)
            materials:AddSharedTexture(key, loaded)
            texture = loaded
        end
        usedTextures:Add(texture)
        return texture
    end

    /*
    This action writes the flags and the sway's two words into the
    material's words: the SWAY flag is added when the
    strength is more than 0.

    Attribute: Parameter words The material's 24 words.
    */
    private action WriteSwayWords(Number32BitArray words)
        NumberUtilities utility
        integer flags = loadedFlags
        if swayStrength > 0
            flags = flags + SWAY_FLAG
        end
        words:Set(FLAGS_INDEX, utility:EncodeIntegerAsNumber(flags))
        words:Set(SWAY_STRENGTH_INDEX, swayStrength)
        words:Set(SWAY_DIRECTION_INDEX, swayDirection)
    end

    /*
    This action sets how the material sways in the wind.
    The 3D and shadow vertex shaders move a point sideways by the strength
    times its height above its model's origin, back and forth over time,
    along the direction. A material already on the GPU is sent again, with
    a new buffer from the next frame; setting the same values does nothing.

    Attribute: Parameter strength How far a point moves sideways per unit of height, such as 0.05; 0 for none.
    Attribute: Parameter directionDegrees The wind's direction about the up axis, in degrees from +x toward +z.
    */
    action SetSway(number strength, number directionDegrees)
        Math math
        number direction = directionDegrees * math:pi / 180
        if strength = swayStrength and direction = swayDirection
            return now
        end
        swayStrength = strength
        swayDirection = direction
        if loadedWords = undefined or released
            // Not loaded yet: Load writes these values.
            return now
        end

        WriteSwayWords(loadedWords)
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        // A staging buffer not yet copied was never used by the GPU, but
        // retiring it is safe either way.
        graphics:Retire(stagingBuffer)
        VulkanBuffer staging
        stagingBuffer = staging
        stagingBuffer:CreateTransferSourceBuffer(device, MATERIAL_BYTE_SIZE)
        VulkanNumber32BitMappedMemory mapping = stagingBuffer:MapToNumber32BitMemory()
        mapping:Set(loadedWords)
        stagingBuffer:StopMapping()
        dataTransferred = false
        graphics:GetModelManager():GetMaterialManager():AddPendingMaterial(me)
    end

    /*
    This action returns how much the material sways.

    Attribute: Returns The strength, 0 for none.
    */
    action GetSway returns number
        return swayStrength
    end

    /*
    This action frees the material: its GPU buffers once no frame on the
    GPU still uses them, and its textures through the material manager,
    which disposes each when no other material uses it. Its blueprint calls
    it when no model uses the blueprint any more. Doing it twice does
    nothing.
    */
    action Release
        if released
            return now
        end
        released = true
        ModelManagerVulkan models
        MaterialManagerVulkan materials = models:GetMaterialManager()
        materials:RemovePendingMaterial(me)

        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        graphics:Retire(stagingBuffer)
        graphics:Retire(materialBuffer)
        stagingBuffer = undefined
        materialBuffer = undefined

        // The block that kept its textures in one group, once no frame draws with it.
        if blockStart >= 0
            graphics:GetTextureManager():ReleaseBlock(blockStart, blockTextures:GetSize())
            blockStart = -1
            blockTextures:Empty()
        end

        integer i = 0
        repeat while i < usedTextures:GetSize()
            materials:ReleaseSharedTexture(usedTextures:Get(i))
            i = i + 1
        end
        usedTextures:Empty()

        if packedAlbedoHeight not= undefined
            check
                packedAlbedoHeight:Dispose()
            detect error
                // If this was already disposed, it's an error, but we can safely ignore it.
            end
            packedAlbedoHeight = undefined
        end
        if packedNormalRoughness not= undefined
            check
                packedNormalRoughness:Dispose()
            detect error
                // If this was already disposed, it's an error, but we can safely ignore it.
            end
            packedNormalRoughness = undefined
        end
        albedoHeightTexture = undefined
        normalRoughnessTexture = undefined
    end

end
