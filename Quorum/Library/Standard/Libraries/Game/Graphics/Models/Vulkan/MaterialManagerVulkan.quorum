package Libraries.Game.Graphics.Models.Vulkan

use Libraries.Containers.Array
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanDevice
use Libraries.Containers.HashTable
use Libraries.Containers.Queue
use Libraries.Game.Graphics.Vulkan.VulkanBuffer
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSetLayoutBinding
use Libraries.Game.Graphics.Vulkan.VulkanConstants
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorResourcesInfo
use Libraries.Game.Graphics.Vulkan.VulkanDescriptorSet
use Libraries.Game.Graphics.Models.Data.Material

class MaterialManagerVulkan
    
    GameStateManager gameState
    
    // A mapping of material files to already-loaded materials.
    //HashTable<text, MaterialVulkan> materialMap
    
    // An array containing any materials that are awaiting data transfers to GPU.
    Array<MaterialVulkan> pendingMaterials

    VulkanDevice device = undefined

    // Hash tables for retrieving the index of a material in the global material arrays.
    //HashTable<MaterialVulkan, integer> materialToIndexTable
    
    // The next index to store a material buffer at in the global arrays.
    //integer nextMaterialID = 0
    
    // TO-DO: NYI, whenever a material is disposed, store its index here. New materials should reuse previously freed IDs before using a new index.
    //Queue<integer> recycledMaterialIDs
    
    //Array<VulkanBuffer> globalMaterialArray
    
    action Create(VulkanDevice device)
        me:device = device
    end
    
    action ProcessPendingResources
        if pendingMaterials:IsEmpty() = false
            GameStateManager manager
            VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
            VulkanCommandBuffer commandBuffer = graphics:GetCurrentRenderCommandBuffer()

            integer i = 0
            repeat while i < pendingMaterials:GetSize()
                MaterialVulkan material = pendingMaterials:Get(i)
                if material:IsPreloaded()
                    material:Load()
                end
if material:HasData()
                    material:TransferBuffers(commandBuffer)
                end

                i = i + 1
            end

            pendingMaterials:Empty()
        end
    end
    
    action AddPendingMaterial(MaterialVulkan material)
        pendingMaterials:Add(material)
    end
    
    action GetMaterial(Material data) returns MaterialVulkan
        text path = data:GetTexturePath()
        MaterialVulkan result = GetCachedMaterial(path)
        if result = undefined
            MaterialVulkan material
            material:Preload(device, data)
            //materialMap:Add(path, material)
            AddPendingMaterial(material)
            result = material
        end
        return result
    end
    
    private action GetCachedMaterial(text filePath) returns MaterialVulkan
        //if materialMap:HasKey(filePath)
            //return materialMap:GetValue(filePath)
        //end
        return undefined
    end
    
end