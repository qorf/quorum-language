    end
    
    action AddPendingMaterial(MaterialVulkan material)
        pendingMaterials:Add(material)
    end
    
    //action GetDescriptorSetLayoutBinding(integer descriptorCount) returns VulkanDescriptorSetLayoutBinding
        //VulkanConstants constants
        //VulkanDescriptorSetLayoutBinding binding
