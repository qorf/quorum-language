package Libraries.Game.Graphics.Models.Vulkan

use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Game.BoundingBox
use Libraries.Compute.Vector3
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Containers.Array
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Containers.Number32BitArray
use Libraries.Game.Graphics.Models.Data.Animation
use Libraries.Game.Graphics.Models.Data.Animations
use Libraries.Game.Graphics.Models.Data.ModelLightData

class ModelBlueprintVulkan is ModelBlueprint
    text key = undefined
    ModelData data = undefined
    Array<MeshVulkan> meshes = undefined
    Array<MaterialVulkan> materials = undefined

    // Whether a material is two-sided, found once the materials are set.
    boolean twoSided = false
    boolean twoSidedChecked = false
    Array<Array<AnimationFrameVulkan>> animationFrames = undefined
    
    // An additional animation frame that represents the bind pose -- i.e., no animation is performed. Used to allow the animation layer to apply base model transforms without animation.
    AnimationFrameVulkan bindPoseAnimationFrame = undefined
    
    BoundingBox boundingBox

    // How many models have this blueprint loaded (Item 33).
    integer userCount = 0

    // True once the blueprint's GPU memory has been freed (Item 33).
    boolean released = false

    // The lights read from the model file, kept after the data is released
    // (Lighting plan L8).
    Array<ModelLightData> lights = undefined
    
    on create
        boundingBox:Invalidate()
    end
    
action HasAnimations returns boolean
        // A released blueprint has let go of its data (Item 33).
        if data = undefined
            return false
        end
        Animations animations = data:GetAnimations()
        if animations = undefined
            return false
        end
        
        return animations:HasAnimations()
end
    
    action GetAnimation(integer index) returns Animation
        if not HasAnimations()
            return undefined
        end
Animations animations = data:GetAnimations()
        return animations:Get(index)
    end
    
    action GetAnimationsSize returns integer
        if not HasAnimations()
            return 0
        end
Animations animations = data:GetAnimations()
        return animations:GetSize()
    end
    
    action GetKey returns text
        return key
    end

    action SetKey(text key)
        me:key = key
    end

    action GetData returns ModelData
        return data
    end

    action SetData(ModelData data)
        me:data = data
    end

    /*
    This action returns the lights read from the model file the blueprint
    was made from, or undefined if it has none (Lighting plan L8). Model:Load
    turns each into a light on the model.

    Attribute: Returns The file's lights, or undefined.
    */
    action GetLights returns Array<ModelLightData>
        return lights
    end

    /*
    This action sets the lights read from the model file (Lighting plan L8).
    The model manager calls it when it makes the blueprint.

    Attribute: Parameter lights The file's lights, or undefined.
    */
    action SetLights(Array<ModelLightData> lights)
        me:lights = lights
    end
    
    action GetDimensions returns Vector3
        if boundingBox:IsValid() = false
            CalculateBoundingBox()
        end
        return boundingBox:GetDimensions()
    end
    
    /*
    CalculateBoundingBox will create a new BoundingBox object that contains the
    bounds of the Model.
    */
    private action CalculateBoundingBox returns BoundingBox
        boundingBox:Invalidate()
        return ExtendBoundingBox(boundingBox)
    end

    /*
    ExtendBoundingBox will expand the bounds of the given BoundingBox to fully
    encapsulate the bounds of this Model.
    */
    action ExtendBoundingBox(BoundingBox box) returns BoundingBox
        number minX = box:GetMinimum():GetX()
        number minY = box:GetMinimum():GetY()
        number minZ = box:GetMinimum():GetZ()
        number maxX = box:GetMaximum():GetX()
        number maxY = box:GetMaximum():GetY()
        number maxZ = box:GetMaximum():GetZ()
        
        integer i = 0
        repeat while i < data:GetMeshes():GetSize()
            MeshData mesh = data:GetMeshes():Get(i)
            Number32BitArray positions = mesh:GetVertices()
            integer j = 0
            repeat while j < positions:GetSize()
                number x = positions:Get(j)
                number y = positions:Get(j + 1)
                number z = positions:Get(j + 2)
                
                if x < minX
                    minX = x
                elseif x > maxX
                    maxX = x
                end
                if y < minY
                    minY = y
                elseif y > maxY
                    maxY = y
                end
                if z < minZ
                    minZ = z
                elseif z > maxZ
                    maxZ = z
                end
                
                j = j + 3
            end
            
            i = i + 1
        end
        
        Vector3 min
        min:Set(minX, minY, minZ)
        Vector3 max
        max:Set(maxX, maxY, maxZ)
        
        box:Set(min, max)
        return box
    end

    action GetMeshes returns Array<MeshVulkan>
        return meshes
    end

    action SetMeshes(Array<MeshVulkan> meshes)
        me:meshes = meshes
    end

    action GetMaterials returns Array<MaterialVulkan>
        return materials
    end

    action SetMaterials(Array<MaterialVulkan> materials)
        me:materials = materials
        twoSidedChecked = false
    end

    /*
    This action returns true if any of the blueprint's materials is
    two-sided, so the painter draws its models without hiding the backs of
    faces (Lighting plan L4).

    Attribute: Returns True if a material is two-sided.
    */
    action HasTwoSidedMaterial returns boolean
        if twoSidedChecked
            return twoSided
        end
        if materials = undefined or materials:IsEmpty()
            return false
        end
        twoSided = false
        integer i = 0
        repeat while i < materials:GetSize()
            MaterialVulkan material = materials:Get(i)
            if material not= undefined and material:IsTwoSided()
                twoSided = true
            end
            i = i + 1
        end
        twoSidedChecked = true
        return twoSided
    end
    
    action GetMeshCount returns integer
        return meshes:GetSize()
    end

    action GetAnimationFrames returns Array<Array<AnimationFrameVulkan>>
        return animationFrames
    end

    action SetAnimationFrames(Array<Array<AnimationFrameVulkan>> animationFrames)
        me:animationFrames = animationFrames
    end

    action GetBindPoseAnimationFrame returns AnimationFrameVulkan
        return bindPoseAnimationFrame
    end

    action SetBindPoseAnimationFrame(AnimationFrameVulkan bindPoseAnimationFrame)
        me:bindPoseAnimationFrame = bindPoseAnimationFrame
    end


    /*
    This action counts one more model using the blueprint. Model:Load calls
    it through the model manager.
    */
    action AddUser
        userCount = userCount + 1
    end

    /*
    This action counts one fewer model using the blueprint.

    Attribute: Returns How many models still use it.
    */
    action RemoveUser returns integer
        if userCount > 0
            userCount = userCount - 1
        end
        return userCount
    end

    /*
    This action returns how many models use the blueprint.

    Attribute: Returns The number of models.
    */
    action GetUserCount returns integer
        return userCount
    end

    /*
    This action returns true once the blueprint's GPU memory has been
    freed. A released blueprint can't be drawn or loaded into a model.

    Attribute: Returns True if released.
    */
    action IsReleased returns boolean
        return released
    end

    /*
    This action frees the GPU memory of the blueprint's meshes and
    animation frames, once no frame on the GPU still uses it, and lets go
    of its model data. The model manager calls it when no model uses the
    blueprint any more. Doing it twice does nothing.
    */
    action Release
        if released
            return now
        end
        released = true

        integer i = 0
        if meshes not= undefined
            repeat while i < meshes:GetSize()
                meshes:Get(i):Release()
                i = i + 1
            end
        end
        if animationFrames not= undefined
            i = 0
            repeat while i < animationFrames:GetSize()
                Array<AnimationFrameVulkan> frames = animationFrames:Get(i)
                integer j = 0
                repeat while j < frames:GetSize()
                    frames:Get(j):Release()
                    j = j + 1
                end
                i = i + 1
            end
        end
        if bindPoseAnimationFrame not= undefined
            bindPoseAnimationFrame:Release()
        end
        // Each blueprint makes its own materials, so nothing else holds
        // them (Item 34).
        if materials not= undefined
            i = 0
            repeat while i < materials:GetSize()
                materials:Get(i):Release()
                i = i + 1
            end
        end
        data = undefined
    end

end