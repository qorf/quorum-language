package Libraries.Game.Graphics.Models.Data

use Libraries.Containers.Array

class ModelData
    Array<Material> materials
    Array<MeshData> meshes
    Animations animations = undefined
    text ID = undefined

    // The lights read from the model file.
    Array<ModelLightData> lights
    
    action GetMaterials returns Array<Material>
        return materials
    end

    action SetMaterials(Array<Material> materials)
        me:materials = materials
    end

    action GetID returns text
        return ID
    end

    action SetID(text ID)
        me:ID = ID
    end

    action GetMeshes returns Array<MeshData>
        return meshes
    end

    action SetMeshes(Array<MeshData> meshes)
        me:meshes = meshes
    end
    
    action HasAnimations returns boolean
        if animations not= undefined and animations:HasAnimations()
            return true
        else
            return false
        end
    end

    action GetAnimations returns Animations
        return animations
    end

    action SetAnimations(Animations animations)
        me:animations = animations
    end

    /*
    This action returns the lights read from the model file, such as a
    lamp's bulb in a glTF file. It is empty if the file
    has none.

    Attribute: Returns The file's lights.
    */
    action GetLights returns Array<ModelLightData>
        return lights
    end

    /*
    This action sets the lights read from the model file.
    The model loader calls it.

    Attribute: Parameter lights The file's lights.
    */
    action SetLights(Array<ModelLightData> lights)
        me:lights = lights
    end

end