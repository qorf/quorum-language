package Libraries.Game.Graphics.Models.Data

use Libraries.Containers.Array

class Animations
    Array<Animation> animations
    Array<AnimationMeshData> animationMeshData
    AnimationFrame bindPoseFrame = undefined
    
    action HasAnimations returns boolean
        if animations = undefined or animations:IsEmpty()
            return false
        else
            return true
        end
    end
    
    action GetAnimations returns Array<Animation>
        return animations
    end

    action SetAnimations(Array<Animation> animations)
        me:animations = animations
    end

    action GetAnimationMeshData returns Array<AnimationMeshData>
        return animationMeshData
    end

    action SetAnimationMeshData(Array<AnimationMeshData> animationMeshData)
        me:animationMeshData = animationMeshData
    end
    
    action Get(integer index) returns Animation
        return animations:Get(index)
    end
    
    action Set(integer index, Animation animation)
        animations:Set(index,animation)
    end
    
    action GetSize returns integer
        if animations = undefined
            return 0
        end
        return animations:GetSize()
    end
    
    action GetBindPoseFrame returns AnimationFrame
        return bindPoseFrame
    end

    action SetBindPoseFrame(AnimationFrame bindPoseFrame)
        me:bindPoseFrame = bindPoseFrame
    end

end
