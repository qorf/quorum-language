package Libraries.Game.Graphics.Models.Data

use Libraries.Compute.Vector4

class Material
    text texturePath = ""
    text normalMapPath = ""
    text metalRoughMap = ""
    Vector4 diffuse
    Vector4 emissive
    number roughness = 0.0
    number metallic = 0.0
    number bumpShading = 1.0
    number opaque = 1.0
    number refractiveIndex = 1.0
    
    action GetTexturePath returns text
        return texturePath
    end

    action SetTexturePath(text texturePath)
        me:texturePath = texturePath
    end

    action GetDiffuse returns Vector4
        return diffuse
    end

    action SetDiffuse(Vector4 diffuse)
        me:diffuse = diffuse
    end

    action GetMetalRoughMap returns text
        return metalRoughMap
    end

    action SetMetalRoughMap(text metalRoughMap)
        me:metalRoughMap = metalRoughMap
    end

    action GetRoughness returns number
        return roughness
    end

    action SetRoughness(number roughness)
        me:roughness = roughness
    end

    action GetMetallic returns number
        return metallic
    end

    action SetMetallic(number metallic)
        me:metallic = metallic
    end

    action GetNormalMapPath returns text
        return normalMapPath
    end

    action SetNormalMapPath(text normalMapPath)
        me:normalMapPath = normalMapPath
    end

    action GetEmissive returns Vector4
        return emissive
    end

    action SetEmissive(Vector4 emissive)
        me:emissive = emissive
    end

    action GetBumpShading returns number
        return bumpShading
    end

    action SetBumpShading(number bumpShading)
        me:bumpShading = bumpShading
    end

    action GetOpaque returns number
        return opaque
    end

    action SetOpaque(number opaque)
        me:opaque = opaque
    end

    action GetRefractiveIndex returns number
        return refractiveIndex
    end

    action SetRefractiveIndex(number refractiveIndex)
        me:refractiveIndex = refractiveIndex
    end
end