package Libraries.Game.Graphics

use Libraries.Compute.Vector3
use Libraries.Game.Graphics.Light
use Libraries.Interface.Item3D

/*
A PointLight lights a 3D scene from one point, the way a light bulb, a
lamp or a campfire does. It shines out equally in every direction, and its
light gets dimmer the farther it travels: twice as far away, an object gets
a quarter of the light. A point light is an Item3D, so it can be placed
anywhere with SetPosition, and it can be added to another item, such as a
lantern carried by a character, so that it moves along with it.

The intensity sets how bright the light is, and the color sets what color
it adds to the scene. A brighter light reaches farther before it becomes
too dim to notice.

When shadows are drawn, a point light casts shadows in every direction
around it. Its range, set with SetRange, says how far from the light those
shadows reach, and so which objects are drawn into its shadows. A smaller
range is faster. Without a range, the light works one out from its
intensity, which for a bright light can be very far. See GetRange.

Attribute: Example

use Libraries.Game.Game
use Libraries.Game.Graphics.PointLight
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        Color color

        Model box
        box:LoadBox(2, 2, 2, color:Orange())
        box:SetPosition(0, 0, 5)
        Add(box)

        // A warm lamp hanging just above the box.
        PointLight lamp
        lamp:SetColor(color:Yellow())
        lamp:SetPosition(0, 3, 5)
        lamp:SetIntensity(10)
        lamp:SetRange(15)
        Add(lamp)
    end

    action Update(number seconds)
    end
end
*/
class PointLight is Light, Item3D

    /*
    How bright the light is.
    */
    number intensity = 0

    /*
    How far this light's shadows reach, as set with SetRange, or 0 if it has
    not been set, in which case it is worked out from the intensity. See
    GetRange.
    */
    number range = 0

    /*
    The light level below which a point light is treated as having no
    effect. Anything dimmer is treated as no light. It decides how far the
    light reaches, as returned by GetRange.
    */
    constant number MINIMUM_ILLUMINATION_THRESHOLD = 0.0003

    /*
    This action will set the intensity of this light, which indicates how bright
    it is.
    */
    action SetIntensity(number newIntensity)
        intensity = newIntensity
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

    /*
    This action returns the intensity of this light. The intensity is a measure
    of the brightness of the light.
    */
    action GetIntensity returns number
        return intensity
    end

    /*
    This action sets how far this light's shadows reach, measured from the
    light. Shadows from this light are only made within this distance, and
    only objects within it are drawn into its shadows, which makes a
    smaller range faster.

    The light's brightness still falls with the square of the distance, as
    before, so surfaces past the range are still lit a little, without
    shadows from this light. Choose a range where the light has become dim.

    A range of 0 lets the light work out its own range from its intensity.
    See GetRange.

    Attribute: Parameter newRange How far the shadows reach, in world units,
    or 0 for the light to work it out.
    */
    action SetRange(number newRange)
        if newRange < 0
            range = 0
        else
            range = newRange
        end

        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

    /*
    This action returns how far this light's shadows reach, measured from
    the light. Objects past this distance are not drawn into its shadows. If
    a range was set with SetRange, that is returned. Otherwise the light
    works out its own range. A point light's brightness falls with the
    square of the distance, so it never reaches zero. Instead, the light is
    treated as reaching as far as its brightest color, at its intensity,
    stays above MINIMUM_ILLUMINATION_THRESHOLD. That distance is the square
    root of the brightest color times the intensity, divided by the
    threshold.

    Attribute: Returns How far this light's shadows reach.
    */
    action GetRange returns number
        if range > 0
            return range
        end
        Color lightColor = GetColor()
        number brightest = lightColor:GetRed()
        if lightColor:GetGreen() > brightest
            brightest = lightColor:GetGreen()
        end
        if lightColor:GetBlue() > brightest
            brightest = lightColor:GetBlue()
        end
        return parent:Item3D:math:SquareRoot(brightest * intensity / MINIMUM_ILLUMINATION_THRESHOLD)
    end

    /*
    This action will create a copy of this PointLight that has the same color,
    position, intensity, and offsets as this light.
    */
    action Copy returns PointLight
        PointLight copy
        copy:SetLight(GetColor(), GetPosition(), intensity)
        copy:SetOffset(GetOffsetX(), GetOffsetY(), GetOffsetZ())
        copy:SetRange(range)
        return copy
    end

    /*
    This action will set the color, position, and intensity of this light to
    match the given values.
    */
    action SetLight(Color newColor, Vector3 newPosition, number newIntensity)
        if newColor not= undefined
            SetColor(newColor)
        end

        SetPosition(newPosition)

        intensity = newIntensity
    end
    
    action MoveX(number x)
        parent:Item3D:MoveX(x)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action MoveY(number y)
        parent:Item3D:MoveY(y)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action MoveZ(number z)
        parent:Item3D:MoveZ(z)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action Move(number x, number y, number z)
        parent:Item3D:Move(x, y, z)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action SetOffsetX(number x)
        parent:Item3D:SetOffsetX(x)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action SetOffsetY(number y)
        parent:Item3D:SetOffsetY(y)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action SetOffsetZ(number z)
        parent:Item3D:SetOffsetZ(z)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end
    
    action SetOffset(number x, number y, number z)
        parent:Item3D:SetOffset(x, y, z)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

end