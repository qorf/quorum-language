package Libraries.Game.Graphics

use Libraries.Game.Graphics.Color
use Libraries.Containers.Array
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics

/*
This class represents the basic foundation of a light used in 3D space. Users
shouldn't use this class directly, but instead use one of the classes that
inherits from it, such as DirectionalLight.
*/
class Light 

    /*
    The color of the light.
    */
    Color color
    Environment environment = undefined
    Array<CascadeShadowData> shadowData
    
    /*
    This action will set the color of the light using number values for the red,
    green, blue, and alpha components of a color, respectively. Each number 
    should be between 0 and 1, where 0 represents the total lack of a color
    component, and 1 represents the full presence of a color component.
    */
    action SetColor(number red, number green, number blue, number alpha)
        color:SetColor(red, green, blue, alpha)
        if environment not= undefined
            environment:LightChanged(me)
        end
    end

    /*
    This action will set the color of the light to match the given color.
    */
    action SetColor(Color newColor)
        color:CopyColor(newColor)
        if environment not= undefined
            environment:LightChanged(me)
        end
    end

    /*
    This action will return the current color of this light.
    */
    action GetColor returns Color
        return color
    end
    
    action GetEnvironment returns Environment
        return environment
    end

    /*This action sets the environment this light is a part of. This is called automatically when a light
is added to an environment, so users should never need to use this action directly.*/
    action SetEnvironment(Environment environment)
        me:environment = environment
    end

    action GetShadowData(integer index) returns CascadeShadowData
        if index >= shadowData:GetSize()
            return undefined
        end
        
        return shadowData:Get(index)
    end

    action SetShadowData(integer index, CascadeShadowData data)
        if index >= shadowData:GetSize()
            shadowData:SetSize(index + 1)
        end
        
        if data not= shadowData:Get(index) and environment not= undefined
            environment:LightChanged(me)
        end
        
        shadowData:Set(index, data)
    end

end