package Libraries.Game.Graphics

use Libraries.Game.Graphics.Light
use Libraries.Compute.Vector3

/*
A DirectionalLight lights a 3D scene from one direction, the way the sun
does. Its light has no starting point and does not get dimmer with
distance: every object in the scene is lit from the same direction and
with the same brightness, wherever it is. That makes it a good choice for
sunlight or moonlight outdoors.

The direction is the way the light shines, not where it comes from. A
direction of (0, -1, 0) shines straight down. A direction that also points
a little sideways, such as (-1, -4, 2), makes the light fall at an angle,
like the sun in the morning or afternoon, so shadows are longer.

The intensity sets how bright the light is, and the color sets what color
it adds to the scene.

When shadows are drawn, a directional light can cast shadows from objects
that are off screen, such as a tree behind the camera whose shadow falls
in front of it. Its culling range, set with SetCullingRange, says how far
from the camera those objects are looked for. A smaller culling range is
faster. A culling range of 0 lets the light work this out from its shadow
cascades.

Attribute: Example

use Libraries.Game.Game
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        Color color

        Model box
        box:LoadBox(2, 2, 2, color:Orange())
        box:SetPosition(0, 0, 5)
        Add(box)

        // A sun high in the sky, shining down and a little to the side.
        DirectionalLight sun
        sun:SetColor(color:White())
        sun:SetDirection(-1, -4, 2)
        sun:SetIntensity(2.5)
        sun:SetCullingRange(40)
        Add(sun)
    end

    action Update(number seconds)
    end
end
*/
class DirectionalLight is Light
    Vector3 direction
    number intensity = 5

    // How far from the camera objects are drawn into this light's shadows,
    // or 0 for the light to work it out. See SetCullingRange.
    number cullingRange = 50

    /*
    This action will set the direction the light points in. It takes three
    number values, which represent the three values of a 3-dimensional vector.
    */
    action SetDirection(number directionX, number directionY, number directionZ)
        direction:Set(directionX, directionY, directionZ)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

    /*
    This action will set the direction the light points in. The light will point
    in the same direction as the supplied Vector3 object.
    */
    action SetDirection(Vector3 newDirection)
        direction:Set(newDirection)
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

    /*
    This action will return the current direction of this DirectionalLight.
    */
    action GetDirection returns Vector3
        return direction
    end

    /*
    This action will create a copy of this DirectionalLight with the same color
    and direction as this light.
    */
    action Copy returns DirectionalLight
        DirectionalLight copy
        copy:SetLight(GetColor(), GetDirection())
        copy:SetCullingRange(cullingRange)
        return copy
    end

    /*
    This action will set both the color and direction of this light using the
    given values.
    */
    action SetLight(Color newColor, Vector3 newDirection)
        SetLight(newColor, newDirection, intensity)
    end
    
    action SetLight(Color newColor, Vector3 newDirection, number intensity)
        if newColor not= undefined
            SetColor(newColor)
        end

        if newDirection not= undefined
            SetDirection(newDirection)
            direction:Normalize()
        end
        
        me:intensity = intensity
    end

    action GetIntensity returns number
        return intensity
    end

    action SetIntensity(number intensity)
        me:intensity = intensity
        
        if GetEnvironment() not= undefined
            GetEnvironment():LightChanged(me)
        end
    end

    /*
    This action sets how far from the camera objects are drawn into this
    light's shadows when a layer culls what it draws. It is measured from
    the camera, since a directional light such as the sun has no position.
    An object that is off screen is only drawn into this light's shadows if
    it could cast a shadow within this distance of the camera. Objects on
    screen are drawn either way. A smaller culling range means fewer objects
    are drawn into the shadows, which is faster. The default is 50.

    A culling range of 0 lets the light work it out: as far as its shadow
    cascades reach, which is as far as the camera can see.

    This does not change how the shadows themselves are drawn.

    Attribute: Parameter range How far from the camera, in world units, or
    0 for the light to work it out.
    */
    action SetCullingRange(number range)
        if range < 0
            cullingRange = 0
        else
            cullingRange = range
        end
    end

    /*
    This action returns how far from the camera objects are drawn into this
    light's shadows, or 0 if the light works it out from its shadow
    cascades.

    Attribute: Returns The culling range, or 0.
    */
    action GetCullingRange returns number
        return cullingRange
    end
end