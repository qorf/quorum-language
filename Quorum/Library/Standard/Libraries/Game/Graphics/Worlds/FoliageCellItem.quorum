package Libraries.Game.Graphics.Worlds

use Libraries.Interface.Item3D
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Texture
use Libraries.Game.BoundingBox
use Libraries.Compute.Vector3
use Libraries.Containers.Array
use Libraries.System.File

/*
A FoliageCellItem draws the copies in one FoliageCell. Since Foliage plan
F5 it draws them all with one model that has copies (Model:SetCopies), so
the renderer draws every copy in one instanced draw: the asset's model, or
for a card asset, one upright two-sided picture, copied once per plane of
each copy. A TerrainItem makes one per cell and holds them as children,
hides the cells farther from the camera than their asset's draw distance
or outside its view (Dense grass plan DG1), and tells the shown ones how
far away they are (UpdateForDistance), which picks the level of detail and
thins the copies near the draw distance (Foliage plan F6).

Each model is a FoliageCellDrawing. Besides the level drawn, a cell may
draw the next level for a growing share of its copies near that level's
distance, so it changes a little at a time (Dense grass plan DG6), and a
simpler level only into the shadows in place of a detailed level's shadow
(Dense grass plan DG3).

The item stands at the origin, so each copy's place is its world place. The
model shares its file's blueprint, so the file is loaded once however many
cells use it.

Attribute: Example
use Libraries.Game.Graphics.Worlds.FoliageCellItem
use Libraries.Game.Graphics.Worlds.FoliageCell
use Libraries.Game.Graphics.Worlds.FoliageAsset
use Libraries.System.File

FoliageCell cell
cell:Set(0, 0, 0, 32)
cell:Add(4, 0, 6, 0, 1, 1)
FoliageAsset rock
rock:SetModelPath("Models/Rock.glb")
File modelFile
modelFile:SetPath("Models/Rock.glb")
FoliageCellItem item
item:Set(cell, rock, modelFile)
item:Build()
*/
class FoliageCellItem is Item3D
    FoliageCell cell = undefined
    FoliageAsset asset = undefined

    // Each level of detail's model file or card picture, and a card
    // level's picture, by level (Foliage plan F6). Level 0 is the asset's
    // own mesh; levels 1 to 3 match FoliageAsset's MAXIMUM_LEVELS. Entries
    // are undefined when not given.
    Array<File> levelFiles
    Array<Texture> levelTextures

    // The terrain's heights, for copies that lean with the slope (Dense
    // grass plan DG4), or undefined.
    TerrainData ground = undefined

    // The level of detail wanted at the camera's distance, and the
    // thinning band: 0 draws every copy, each higher band fewer (Foliage
    // plan F5 and F6).
    integer level = 0
    integer band = 0

    // Fading into the next level (Dense grass plan DG6): the level faded
    // into, or -1 for none, and how far along, in steps from 0 to
    // FADE_STEPS, so copies are only drawn again when a step changes.
    integer fadeLevel = -1
    integer fadeStep = 0
    constant integer FADE_STEPS = 8

    // The drawings: the level drawn, the level faded into, and the shadow
    // stand-in (Dense grass plan DG3 and DG6).
    FoliageCellDrawing main
    FoliageCellDrawing fading
    FoliageCellDrawing standIn

    // How tall the tallest copy reaches above where it stands, for the
    // terrain's render box.
    number reach = 0

    // Whether the cell is within its asset's draw distance of the camera,
    // and inside the camera's view (Dense grass plan DG1). It is shown only
    // when both are true; TerrainItem sets them.
    boolean nearCamera = false
    boolean inView = true

    // Thinning (Foliage plan F5): past this share of the draw distance,
    // copies thin out in this many bands, each keeping fewer.
    constant number THINNING_START = 0.8
    constant integer THINNING_BANDS = 4

    on create
        integer i = 0
        repeat while i <= 3
            levelFiles:Add(undefined)
            levelTextures:Add(undefined)
            i = i + 1
        end
    end

    /*
    This action sets the cell to draw, its asset, and the asset's model or
    card picture file. Levels of detail are given with SetLevelSource.

    Attribute: Parameter foliageCell The cell.
    Attribute: Parameter foliageAsset The cell's asset.
    Attribute: Parameter file The asset's model file, or its card picture.
    */
    action Set(FoliageCell foliageCell, FoliageAsset foliageAsset, File file)
        cell = foliageCell
        asset = foliageAsset
        levelFiles:Set(0, file)
    end

    /*
    This action sets the terrain's heights, so copies of an asset that
    leans with the slope can find it (Dense grass plan DG4).

    Attribute: Parameter data The terrain's heights, or undefined.
    */
    action SetGround(TerrainData data)
        ground = data
    end

    /*
    This action sets the picture every card of the asset shares, so it is
    loaded once. Without it, Build loads the picture itself.

    Attribute: Parameter texture The card picture.
    */
    action SetCardTexture(Texture texture)
        levelTextures:Set(0, texture)
    end

    /*
    This action sets a level of detail's file (Foliage plan F6): its model,
    or for a card level, its picture, with the picture's texture if it is
    already loaded.

    Attribute: Parameter levelNumber The level, from 1 to 3.
    Attribute: Parameter file The model or picture file, or undefined for none.
    Attribute: Parameter cardTexture The card's picture, or undefined to load it when needed.
    */
    action SetLevelSource(integer levelNumber, File file, Texture cardTexture)
        if levelNumber < 1 or levelNumber >= levelFiles:GetSize()
            alert("A foliage cell's levels of detail are numbered from 1 to " + (levelFiles:GetSize() - 1) + ", but was given " + levelNumber + ".")
        end
        levelFiles:Set(levelNumber, file)
        levelTextures:Set(levelNumber, cardTexture)
    end

    /*
    This action returns the cell the item draws.

    Attribute: Returns The cell.
    */
    action GetCell returns FoliageCell
        return cell
    end

    /*
    This action returns the cell's asset.

    Attribute: Returns The asset.
    */
    action GetAsset returns FoliageAsset
        return asset
    end

    /*
    This action returns the level of detail drawn (Foliage plan F6): 0 for
    the asset's own mesh.

    Attribute: Returns The level.
    */
    action GetLevel returns integer
        if main:GetLevel() < 0
            return 0
        end
        return main:GetLevel()
    end

    /*
    This action returns the model drawing the copies at the level drawn
    (Foliage plan F5).

    Attribute: Returns The model, or undefined before Build.
    */
    action GetModel returns Model
        return main:GetModel()
    end

    /*
    This action returns how many copies are drawn after thinning (Foliage
    plan F5), at the level drawn and the level faded into. A card's planes
    count as one copy each.

    Attribute: Returns The count.
    */
    action GetDrawnCopyCount returns integer
        return main:GetDrawnCount() + fading:GetDrawnCount()
    end

    /*
    This action makes the item's models again from its cell's copies, after
    copies were added, removed or moved, or the asset changed (Foliage plan
    F5). The old models are taken out and disposed.
    */
    action Build
        Clear()
        if cell = undefined or asset = undefined
            return now
        end
        UpdateDrawings()
    end

    /*
    This action moves the copies up or down to their heights, after they
    followed the ground (Terrain plan F4). It is quicker than Build, since
    nothing is loaded again; it works out the copies again, so copies added
    or removed are right too (Foliage plan F5).
    */
    action PlaceAgain
        if cell = undefined or asset = undefined
            return now
        end
        if main:GetModel() = undefined
            Build()
            return now
        end
        MakeDrawing(main)
        MakeDrawing(fading)
        MakeDrawing(standIn)
        KeepCopies()
    end

    /*
    This action tells the item how far the camera is from the cell's
    nearest side (Foliage plan F5 and F6). It picks the level of detail for
    that distance, how much the copies thin out near the draw distance, and
    how far they have faded into the next level (Dense grass plan DG6), and
    draws them again only if any of these changed, so calling it a few
    times a second costs little.

    Attribute: Parameter distance How far the camera is, in world units.
    Attribute: Returns True if what is drawn changed.
    */
    action UpdateForDistance(number distance) returns boolean
        if cell = undefined or asset = undefined
            return false
        end
        integer newLevel = asset:GetLevelForDistance(distance)
        integer newBand = GetBandFor(distance)
        integer newFadeLevel = -1
        integer newFadeStep = 0
        number margin = asset:GetFadeMargin()
        if margin > 0
            integer nextLevel = asset:GetLevelForDistance(distance + margin)
            if nextLevel not= newLevel
                number start = asset:GetLevelDistance(nextLevel)
                number share = (distance - (start - margin)) / margin
                newFadeStep = cast(integer, share * FADE_STEPS)
                if newFadeStep < 0
                    newFadeStep = 0
                elseif newFadeStep > FADE_STEPS
                    newFadeStep = FADE_STEPS
                end
                if newFadeStep > 0
                    newFadeLevel = nextLevel
                end
            end
        end
        if newLevel not= level or newFadeLevel not= fadeLevel
            level = newLevel
            band = newBand
            fadeLevel = newFadeLevel
            fadeStep = newFadeStep
            UpdateDrawings()
            return true
        end
        if newBand not= band or newFadeStep not= fadeStep
            band = newBand
            fadeStep = newFadeStep
            KeepCopies()
            return true
        end
        return false
    end

    /*
    This action sets whether the cell is within its asset's draw distance
    of the camera (Dense grass plan DG1). The cell shows when it is near
    and in view.

    Attribute: Parameter near True if the cell is near enough to draw.
    */
    action SetNearCamera(boolean near)
        nearCamera = near
        ShowIfWanted()
    end

    /*
    This action returns whether the cell is within its asset's draw
    distance of the camera (Dense grass plan DG1).

    Attribute: Returns True if it is near enough to draw.
    */
    action IsNearCamera returns boolean
        return nearCamera
    end

    /*
    This action sets whether the cell is inside the camera's view (Dense
    grass plan DG1). The cell shows when it is near and in view.

    Attribute: Parameter visible True if any of the cell is in view.
    */
    action SetInView(boolean visible)
        if inView = visible
            return now
        end
        inView = visible
        ShowIfWanted()
    end

    /*
    This action shows the cell if it is near the camera and in view, and
    hides it otherwise (Dense grass plan DG1).
    */
    private action ShowIfWanted
        boolean wanted = nearCamera and inView
        if wanted and not IsShowing()
            Show()
        elseif not wanted and IsShowing()
            Hide()
        end
    end

    /*
    This action takes out and disposes the models.
    */
    action Clear
        main:Dispose(me)
        fading:Dispose(me)
        standIn:Dispose(me)
        repeat while GetItemCount() > 0
            Item3D child = Remove(GetItemCount() - 1)
            if child is Model
                Model model = cast(Model, child)
                model:Dispose()
            end
        end
        reach = 0
    end

    /*
    This action returns how tall the tallest copy reaches above where it
    stands, in world units, once built.

    Attribute: Returns The height.
    */
    action GetReach returns number
        return reach
    end

    /*
    This action returns the cell's middle along x, in world units.

    Attribute: Returns The x.
    */
    action GetCellMiddleX returns number
        return (cell:GetCellX() + 0.5) * cell:GetCellSize()
    end

    /*
    This action returns the cell's middle along z, in world units.

    Attribute: Returns The z.
    */
    action GetCellMiddleZ returns number
        return (cell:GetCellZ() + 0.5) * cell:GetCellSize()
    end

    /*
    This action returns true if a level of detail can be drawn: the asset
    uses it and its file exists (Foliage plan F6).
    */
    private action IsLevelUsable(integer levelNumber) returns boolean
        if levelNumber < 0 or levelNumber >= levelFiles:GetSize()
            return false
        end
        if not asset:HasLevel(levelNumber)
            return false
        end
        File file = levelFiles:Get(levelNumber)
        if file = undefined
            return false
        end
        return file:Exists()
    end

    /*
    This action loads each drawing whose level should change, or disposes
    it when it isn't needed, then sets how each draws and which copies it
    keeps (Dense grass plan DG3 and DG6). The level drawn falls back to
    the asset's own mesh if its file is missing.
    */
    private action UpdateDrawings
        integer mainLevel = level
        if not IsLevelUsable(mainLevel)
            mainLevel = 0
        end
        if not IsLevelUsable(mainLevel)
            Clear()
            return now
        end
        LoadDrawing(main, mainLevel)

        integer wantedFade = -1
        if fadeLevel >= 0 and fadeLevel not= mainLevel and IsLevelUsable(fadeLevel)
            wantedFade = fadeLevel
        end
        LoadDrawing(fading, wantedFade)

        LoadDrawing(standIn, GetStandInLevel())
        ConfigureDrawings()
        KeepCopies()
    end

    /*
    This action returns the shadow stand-in's level (Dense grass plan DG3):
    the asset's shadow level, if the asset casts shadows, the level is
    usable and casts shadows, and a level drawn now is nearer than it.
    Otherwise -1, for none.
    */
    private action GetStandInLevel returns integer
        integer standInLevel = asset:GetShadowLevel()
        if not asset:CastsShadows() or standInLevel <= 0 or standInLevel > asset:GetLastShadowLevel()
            return -1
        end
        if not IsLevelUsable(standInLevel)
            return -1
        end
        boolean covers = (main:GetLevel() >= 0 and main:GetLevel() < standInLevel) or (fading:GetLevel() >= 0 and fading:GetLevel() < standInLevel)
        if not covers
            return -1
        end
        return standInLevel
    end

    /*
    This action makes a drawing draw a level, loading it if it draws
    another, or disposes it for -1. A loaded drawing works out its copies.
    */
    private action LoadDrawing(FoliageCellDrawing drawing, integer wanted)
        if wanted < 0
            drawing:Dispose(me)
            return now
        end
        if drawing:GetLevel() = wanted
            return now
        end
        boolean card = asset:IsLevelCard(wanted)
        Texture texture = drawing:Load(me, wanted, card, levelFiles:Get(wanted), levelTextures:Get(wanted))
        if card and texture not= undefined
            levelTextures:Set(wanted, texture)
        end
        MakeDrawing(drawing)
    end

    /*
    This action works out a loaded drawing's copies, and the cell's reach.
    */
    private action MakeDrawing(FoliageCellDrawing drawing)
        if drawing:GetModel() = undefined
            return now
        end
        drawing:Make(cell, asset, ground)
        reach = 0
        if main:GetReach() > reach
            reach = main:GetReach()
        end
        if fading:GetReach() > reach
            reach = fading:GetReach()
        end
        if standIn:GetReach() > reach
            reach = standIn:GetReach()
        end
    end

    /*
    This action sets how each drawing draws (Dense grass plan DG3): a level
    casts shadows if the asset does, the level isn't past the asset's last
    shadow level, and no stand-in throws its shadow; the stand-in draws
    only its shadow.
    */
    private action ConfigureDrawings
        integer standInLevel = standIn:GetLevel()
        boolean mouse = IsAcceptingMouseInput()
        main:Configure(CastsOwnShadow(main:GetLevel(), standInLevel), false, mouse, asset)
        fading:Configure(CastsOwnShadow(fading:GetLevel(), standInLevel), false, mouse, asset)
        standIn:Configure(true, true, false, asset)
    end

    /*
    This action returns true if a level throws its own shadow (Dense grass
    plan DG3).
    */
    private action CastsOwnShadow(integer drawnLevel, integer standInLevel) returns boolean
        if not asset:CastsShadows() or drawnLevel < 0 or drawnLevel > asset:GetLastShadowLevel()
            return false
        end
        if standInLevel >= 0 and drawnLevel < standInLevel
            return false
        end
        return true
    end

    /*
    This action gives each drawing the copies it keeps, by their numbers
    from 0 to 1 (Foliage plan F5, Dense grass plan DG3 and DG6). Thinning
    keeps those below a share; of those, the ones below the fade's share
    are drawn at the next level, the rest at the level drawn. The stand-in
    keeps the copies of every level nearer than its own.
    */
    private action KeepCopies
        number share = 1
        if band > 0
            share = 1 - band / cast(number, THINNING_BANDS + 1)
        end
        number faded = 0
        if fading:GetModel() not= undefined
            faded = fadeStep / cast(number, FADE_STEPS)
            if faded > share
                faded = share
            end
        end
        main:Keep(faded, share, me)
        if fading:GetModel() not= undefined
            fading:Keep(0, faded, me)
        end
        if standIn:GetModel() not= undefined
            integer standInLevel = standIn:GetLevel()
            boolean mainCovered = main:GetLevel() >= 0 and main:GetLevel() < standInLevel
            boolean fadingCovered = fading:GetLevel() >= 0 and fading:GetLevel() < standInLevel
            number low = faded
            number high = share
            if fadingCovered and mainCovered
                low = 0
            elseif fadingCovered
                low = 0
                high = faded
            end
            standIn:Keep(low, high, me)
        end
    end

    /*
    This action returns the thinning band for a distance from the camera
    (Foliage plan F5): 0 within THINNING_START of the draw distance, then
    1 to THINNING_BANDS out to the draw distance.
    */
    private action GetBandFor(number distance) returns integer
        number far = asset:GetDrawDistance()
        number start = far * THINNING_START
        if distance <= start or far <= start
            return 0
        end
        integer result = 1 + cast(integer, (distance - start) / (far - start) * THINNING_BANDS)
        if result > THINNING_BANDS
            result = THINNING_BANDS
        end
        return result
    end

    /*
    This action fills in the box around every copy, in world units, from the
    cell's lowest and highest copies and the tallest copy's reach.

    Attribute: Parameter local The box to fill in.
    Attribute: Returns True, or false if the cell is empty.
    */
    action GetRenderBounds(BoundingBox local) returns boolean
        if cell = undefined or cell:IsEmpty()
            return false
        end
        number size = cell:GetCellSize()
        number edge = reach
        Vector3 minimum
        minimum:Set(cell:GetCellX() * size - edge, cell:GetLowestY() - edge, cell:GetCellZ() * size - edge)
        Vector3 maximum
        maximum:Set((cell:GetCellX() + 1) * size + edge, cell:GetHighestY() + reach, (cell:GetCellZ() + 1) * size + edge)
        local:Set(minimum, maximum)
        return true
    end
end
