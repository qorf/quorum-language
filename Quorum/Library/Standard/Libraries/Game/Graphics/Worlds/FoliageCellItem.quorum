package Libraries.Game.Graphics.Worlds

use Libraries.Interface.Item3D
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Color
use Libraries.Game.BoundingBox
use Libraries.Compute.Vector3
use Libraries.System.File

/*
A FoliageCellItem draws the copies in one FoliageCell (Terrain plan F2,
phase 1): one model per copy, or for a card asset, one upright two-sided
picture per plane of each copy. A TerrainItem makes one per cell and holds
them as children, and hides the cells farther from the camera than their
asset's draw distance.

The item stands at the origin, so each copy's place is its world place. The
models share their asset's blueprint, so the asset's model file is loaded
once however many copies there are.

Attribute: Example
use Libraries.Game.Graphics.Worlds.FoliageCellItem
use Libraries.Game.Graphics.Worlds.FoliageCell
use Libraries.Game.Graphics.Worlds.FoliageAsset
use Libraries.System.File

FoliageCell cell
cell:Set(0, 0, 0, 32)
cell:Add(4, 0, 6, 0, 1, 1)
FoliageAsset rock
rock:SetModelPath("Models/Rock.glb")
File modelFile
modelFile:SetPath("Models/Rock.glb")
FoliageCellItem item
item:Set(cell, rock, modelFile)
item:Build()
*/
class FoliageCellItem is Item3D
    FoliageCell cell = undefined
    FoliageAsset asset = undefined

    // The asset's model file, or for a card, its picture's file.
    File assetFile = undefined

    // A card's picture, shared by every card of the asset.
    Texture cardTexture = undefined

    // How tall the tallest copy reaches above where it stands, found by
    // Build, for the terrain's render box.
    number reach = 0

    /*
    This action sets the cell to draw, its asset, and the asset's model or
    card picture file.

    Attribute: Parameter foliageCell The cell.
    Attribute: Parameter foliageAsset The cell's asset.
    Attribute: Parameter file The asset's model file, or its card picture.
    */
    action Set(FoliageCell foliageCell, FoliageAsset foliageAsset, File file)
        cell = foliageCell
        asset = foliageAsset
        assetFile = file
    end

    /*
    This action sets the picture every card of the asset shares, so it is
    loaded once. Without it, Build loads the picture itself.

    Attribute: Parameter texture The card picture.
    */
    action SetCardTexture(Texture texture)
        cardTexture = texture
    end

    /*
    This action returns the cell the item draws.

    Attribute: Returns The cell.
    */
    action GetCell returns FoliageCell
        return cell
    end

    /*
    This action returns the cell's asset.

    Attribute: Returns The asset.
    */
    action GetAsset returns FoliageAsset
        return asset
    end

    /*
    This action makes the item's models again from its cell's copies, after
    copies were added, removed or moved. The old models are taken out and
    disposed.
    */
    action Build
        Clear()
        if cell = undefined or asset = undefined or assetFile = undefined
            return now
        end
        if not assetFile:Exists()
            return now
        end
        if asset:IsCard()
            BuildCards()
        else
            BuildModels()
        end
    end

    /*
    This action moves the models up or down to their copies' heights, after
    the copies followed the ground (Terrain plan F4). It is quicker than
    Build, since nothing is loaded again. If the copies were added or
    removed, it builds instead.
    */
    action PlaceAgain
        if cell = undefined or asset = undefined
            return now
        end
        integer perCopy = 1
        if asset:IsCard()
            perCopy = asset:GetCardPlanes()
        end
        if GetItemCount() not= cell:GetCount() * perCopy
            Build()
            return now
        end
        integer i = 0
        repeat while i < cell:GetCount()
            number y = cell:GetY(i)
            if asset:IsCard()
                y = y + cell:GetScale(i) / 2
            end
            integer part = 0
            repeat while part < perCopy
                Item3D child = GetItem(i * perCopy + part)
                child:SetY(y)
                part = part + 1
            end
            i = i + 1
        end
    end

    /*
    This action takes out and disposes every model.
    */
    action Clear
        repeat while GetItemCount() > 0
            Item3D child = Remove(GetItemCount() - 1)
            if child is Model
                Model model = cast(Model, child)
                model:Dispose()
            end
        end
        reach = 0
    end

    /*
    This action returns how tall the tallest copy reaches above where it
    stands, in world units, once built.

    Attribute: Returns The height.
    */
    action GetReach returns number
        return reach
    end

    /*
    This action returns the cell's middle along x, in world units.

    Attribute: Returns The x.
    */
    action GetCellMiddleX returns number
        return (cell:GetCellX() + 0.5) * cell:GetCellSize()
    end

    /*
    This action returns the cell's middle along z, in world units.

    Attribute: Returns The z.
    */
    action GetCellMiddleZ returns number
        return (cell:GetCellZ() + 0.5) * cell:GetCellSize()
    end

    /*
    This action makes one model per copy, from the asset's model file.
    */
    private action BuildModels
        integer i = 0
        repeat while i < cell:GetCount()
            Model copy
            copy:Load(assetFile)
            // Its height before scaling, from its blueprint.
            number top = copy:GetHeight() * cell:GetScale(i)
            copy:SetCastsShadows(asset:CastsShadows())
            copy:SetAcceptsMouseInput(IsAcceptingMouseInput())
            number scale = cell:GetScale(i)
            copy:SetScale(scale, scale, scale)
            copy:SetYawPitchRoll(cell:GetTurn(i), 0, 0)
            copy:SetPosition(cell:GetX(i), cell:GetY(i), cell:GetZ(i))
            Shade(copy, cell:GetShade(i))
            Add(copy)
            if top > reach
                reach = top
            end
            i = i + 1
        end
    end

    /*
    This action makes the cards: for each copy, its asset's number of
    upright two-sided pictures, crossed about the copy's middle. A card is
    one unit tall, and as wide as its picture's shape, before the copy's
    scale.
    */
    private action BuildCards
        if cardTexture = undefined
            Texture texture
            texture:LoadFromFile(assetFile)
            cardTexture = texture
        end
        number width = 1
        if cardTexture:GetHeight() > 0
            width = cardTexture:GetWidth() / cast(number, cardTexture:GetHeight())
        end
        integer planes = asset:GetCardPlanes()
        integer i = 0
        repeat while i < cell:GetCount()
            number scale = cell:GetScale(i)
            integer plane = 0
            repeat while plane < planes
                Model card
                card:LoadPlane(width, 1, cardTexture, true)
                card:SetCastsShadows(asset:CastsShadows())
                card:SetAcceptsMouseInput(IsAcceptingMouseInput())
                card:SetScale(scale, scale, scale)
                // The plane lies flat; pitching it stands it up. Each plane
                // of a copy is turned an equal share of half a circle.
                card:SetYawPitchRoll(cell:GetTurn(i) + plane * 180.0 / planes, 90, 0)
                card:SetPosition(cell:GetX(i), cell:GetY(i) + scale / 2, cell:GetZ(i))
                Shade(card, cell:GetShade(i))
                Add(card)
                plane = plane + 1
            end
            if scale > reach
                reach = scale
            end
            i = i + 1
        end
    end

    /*
    This action darkens a copy by its shade. A shade of 1 leaves the
    model's own colors alone; a darker shade replaces its color with gray,
    which its textures are multiplied by.

    Attribute: Parameter model The copy.
    Attribute: Parameter shade Its shade, 1 for the asset's own color.
    */
    private action Shade(Model model, number shade)
        if shade >= 0.999
            return now
        end
        Color color
        color:SetColor(shade, shade, shade, 1)
        model:SetColor(color)
    end

    /*
    This action fills in the box around every copy, in world units, from the
    cell's lowest and highest copies and the tallest copy's reach.

    Attribute: Parameter local The box to fill in.
    Attribute: Returns True, or false if the cell is empty.
    */
    action GetRenderBounds(BoundingBox local) returns boolean
        if cell = undefined or cell:IsEmpty()
            return false
        end
        number size = cell:GetCellSize()
        number edge = reach
        Vector3 minimum
        minimum:Set(cell:GetCellX() * size - edge, cell:GetLowestY() - edge, cell:GetCellZ() * size - edge)
        Vector3 maximum
        maximum:Set((cell:GetCellX() + 1) * size + edge, cell:GetHighestY() + reach, (cell:GetCellZ() + 1) * size + edge)
        local:Set(minimum, maximum)
        return true
    end
end
