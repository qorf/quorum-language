package Libraries.Game.Graphics.Worlds

use Libraries.System.Logging.SharedLogger

use Libraries.Interface.Item3D
use Libraries.System.File
use Libraries.Game.Layer3D
use Libraries.Game.BoundingBox
use Libraries.Compute.Vector3
use Libraries.Compute.Math
use Libraries.Game.Graphics.Trees.RenderTree3D
use Libraries.Game.Graphics.Trees.CullingVolume3D
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.Texture
use Libraries.Containers.Array
use Libraries.Containers.HashTable
use Libraries.Containers.Iterator

/*
A TerrainItem is a terrain as an item: it holds a WorldTerrain loaded from a
terrain's folder, and its region models are its children. So a terrain can
go into a layer, be saved in a scene, and be loaded with LoadScene, like a
model. Quorum Studio's scene editor adds one from its palette.

A terrain's heights are world positions, so a TerrainItem stays at the
origin: it isn't moved, turned or scaled. Its region models have collision
by default, so physics objects land on it.

A terrain is loaded from its terrain.json file, which TerrainData's Save
writes into the terrain's folder beside the region images. A new terrain,
made with CreateFlat, is flat and plain: it has no painting and no
materials. It needs Vulkan.

Attribute: Example
use Libraries.Game.Game
use Libraries.Game.Graphics.Worlds.TerrainItem

class Main is Game
    TerrainItem ground

    action Main
        UseVulkan(true)
        StartGame()
    end

    action CreateGame
        EnablePhysics3D(true)
        ground:Load("Terrains/Terrain1/terrain.json")
        Add(ground)
        output "The ground at the origin is at height " + ground:GetWorldTerrain():GetData():GetHeight(0, 0)
    end
end
*/
class TerrainItem is Item3D
    WorldTerrain terrain
    // The terrain.json file's path, as given to Load or CreateFlat, so a
    // scene can save it as it was written.
    text terrainFile = ""

    // The terrain.json file itself, with its working directory, so a terrain
    // loaded relative to a project is saved back to the same place.
    File terrainLocation = undefined

    // True if Load was given a terrain.json that isn't there. The item then
    // has no regions, but keeps the file's path, so a scene that names it
    // still loads, and saves it unchanged.
    boolean missing = false

    // How the terrain can be collided with: WorldTerrain's COLLISION_FULL
    // (every region), COLLISION_DYNAMIC (only near moving bodies) or
    // COLLISION_DISABLED (step 13).
    integer collisionMode = 2

    // Streaming (step 13): the terrain loads and draws only the regions near
    // the camera, or near an item it follows, instead of every region. It
    // starts on the item's first update in a layer.
    boolean streaming = false
    boolean streamingStarted = false
    number drawRadius = 100
    Item3D followItem = undefined

    // The ground's look (step 9): undefined for plain ground, and the
    // terrain material file's path, as the scene names it.
    TerrainMaterial material = undefined
    text materialFile = ""

    // Foliage (Terrain plan F1): the list of assets, its file's path as the
    // scene names it, and where every copy stands, saved per region beside
    // the heights.
    FoliageList foliageList = undefined
    text foliageFile = ""
    TerrainFoliage foliage

    // The foliage's drawing (Terrain plan F2): one FoliageCellItem per
    // cell, as the item's children, by "asset/cellX/cellZ", and each card
    // asset's picture, shared by its cells. They are made again on the next
    // update after the foliage or its list changes.
    HashTable<text, FoliageCellItem> foliageItems
    HashTable<text, Texture> cardTextures
    boolean foliageChanged = false
    // How tall the tallest foliage reaches, for the render box.
    number foliageReach = 0
    // Cells are shown or hidden by their asset's draw distance a few times a
    // second, not every frame.
    number foliageCheckTime = 0
    constant number FOLIAGE_CHECK_SECONDS = 0.25
    // For the cells' distances from the camera (Foliage plan F5).
    Math foliageMath

    // For hiding cells outside the camera's view (Dense grass plan DG1),
    // kept so nothing is made each frame.
    CullingVolume3D foliageView
    BoundingBox foliageBox

    // Water (Water plan W5): a sea and lakes, saved beside the heights in
    // water.json, and drawn as the item's children.
    TerrainWater water

    // How far above the highest ground and below the lowest the box the
    // layer culls the terrain by reaches, in world units, so small edits
    // stay inside it before it is refreshed.
    constant number BOUNDS_PADDING = 8

    /*
    This action loads a terrain from its terrain.json file, and makes its
    region models, as the item's children.

    Attribute: Parameter path The terrain.json file's path.
    */
    action Load(text path)
        File file
        file:SetPath(path)
        Load(file)
    end

    /*
    This action loads a terrain from its terrain.json file, and makes its
    region models, as the item's children. The item must not have a terrain
    loaded already.

    Attribute: Parameter file The terrain.json file.
    */
    action Load(File file)
        CheckEmpty()
        terrainFile = file:GetPath()
        terrainLocation = file
        // A scene can name a terrain whose files were moved or not copied.
        // The scene still loads: the terrain is empty, and keeps its path.
        if not file:Exists()
            missing = true
            SharedLogger logger
            logger:Log("The terrain " + file:GetPath() + " wasn't found, so it is empty. Its folder may have been moved or not copied with the project.")
            return now
        end
        missing = false
        // The water is small, so it loads whether the terrain streams or
        // not (Water plan W5).
        water:SetTerrainData(terrain:GetData())
        water:Load(GetFolder(file))
        // A streaming terrain loads its regions as it starts, on its first
        // update in a layer (step 13).
        if streaming
            return now
        end
        terrain:GetData():Load(GetFolder(file))
        foliage:SetTerrainData(terrain:GetData())
        foliage:Load(GetFolder(file))
        foliageChanged = true
        BuildModels()
    end

    /*
    This action returns true if Load was given a terrain.json file that
    isn't there. The item then has no regions, and draws nothing.

    Attribute: Returns True if the terrain's files weren't found.
    */
    action IsMissing returns boolean
        return missing
    end

    /*
    This action makes a new, flat terrain at height 0, centered on the
    origin, saves it into the folder of the terrain.json file given, and
    makes its region models. The folder is made if it isn't there. The
    terrain has no painting and no materials, so it draws plain.

    Attribute: Parameter file Where the terrain.json file goes.
    Attribute: Parameter regionsAcross How many regions along x and along z.
    Attribute: Parameter regionSize How many samples along each side of a region: 64, 128, 256, 512, 1024 or 2048.
    Attribute: Parameter spacing How far apart the samples are, in world units.
    */
    action CreateFlat(File file, integer regionsAcross, integer regionSize, number spacing)
        CheckEmpty()
        terrainLocation = file
        missing = false
        if regionsAcross < 1
            alert("A terrain needs at least one region across, but was given " + regionsAcross + ".")
        end
        terrainFile = file:GetPath()
        TerrainData data = terrain:GetData()
        data:SetRegionSize(regionSize)
        data:SetVertexSpacing(spacing)
        integer first = -(regionsAcross / 2)
        integer x = 0
        repeat while x < regionsAcross
            integer z = 0
            repeat while z < regionsAcross
                data:AddRegion(first + x, first + z)
                z = z + 1
            end
            x = x + 1
        end
        data:Save(GetFolder(file))
        foliage:SetTerrainData(data)
        water:SetTerrainData(data)
        BuildModels()
    end

    /*
    This action saves the terrain's heights, and any painting, back into its
    folder.
    */
    action SaveTerrain
        if terrainFile = ""
            alert("The terrain can't be saved, because it wasn't loaded from or made into a terrain.json file.")
        end
        // A terrain whose files weren't found has nothing to save, and
        // saving would replace them with an empty terrain.
        if missing
            return now
        end
        // The file as it was loaded or made, so a path relative to a project
        // is saved back into that project.
        File file = terrainLocation
        if file = undefined
            File plainFile
            plainFile:SetPath(terrainFile)
            file = plainFile
        end
        // Regions removed in a scene editor are left out of terrain.json, so
        // they don't load again; their files stay in the folder, unused
        // (step 11). The item holds every region, so a saved region that
        // isn't in memory was removed.
        // A streaming terrain has only some regions in memory, so the others
        // stay listed.
        if not streaming
            integer forgotten = terrain:GetData():ForgetRegionsNotLoaded()
        end
        terrain:GetData():Save(GetFolder(file))
        // Each region with foliage, or that had a foliage file, writes it
        // beside its heights (Terrain plan F1).
        foliage:Save(GetFolder(file))
        // The sea and lakes, if there are any, in water.json (Water plan W5).
        water:Save(GetFolder(file))
    end

    /*
    This action returns the terrain's water: its sea and lakes, and their
    look (Water plan W5). After changing it, call WaterChanged so it is
    drawn again. It is loaded and saved with the terrain.

    Attribute: Returns The water.
    */
    action GetWater returns TerrainWater
        return water
    end

    /*
    This action draws the water again on the next update, after its sea,
    lakes or look were changed.
    */
    action WaterChanged
        water:Changed()
    end

    /*
    This action puts a sea around the terrain at a height (Water plan W5):
    water reaching the horizon, hidden wherever the ground is higher.

    Attribute: Parameter level The sea's height.
    */
    action SetSeaLevel(number level)
        water:SetSeaLevel(level)
    end

    /*
    This action takes the sea away.
    */
    action RemoveSea
        water:RemoveSea()
    end

    /*
    This action adds a lake: a rectangle of water centered on a point, at a
    level. It can be larger than its hollow, since the ground hides the
    water wherever it rises above it.

    Attribute: Parameter x The lake's middle along x.
    Attribute: Parameter z The lake's middle along z.
    Attribute: Parameter width Its size along x.
    Attribute: Parameter depth Its size along z.
    Attribute: Parameter level The water's height.
    Attribute: Returns The lake.
    */
    action AddLake(number x, number z, number width, number depth, number level) returns TerrainLake
        return water:AddLake(x, z, width, depth, level)
    end

    /*
    This action returns the height of the water over a point, or
    TerrainWater's NO_WATER where there is none.

    Attribute: Parameter x The point along x.
    Attribute: Parameter z The point along z.
    Attribute: Returns The water's height.
    */
    action GetWaterLevelAt(number x, number z) returns number
        return water:GetWaterLevelAt(x, z)
    end

    /*
    This action returns true if a point is in the water: below the water
    there, and above the ground.

    Attribute: Parameter x The point along x.
    Attribute: Parameter y The point's height.
    Attribute: Parameter z The point along z.
    Attribute: Returns True if the point is under water.
    */
    action IsUnderWater(number x, number y, number z) returns boolean
        return water:IsUnderWater(x, y, z)
    end

    /*
    This action makes the region models again after regions were added or
    removed, such as by a scene editor's region tools (step 11).
    */
    action RebuildRegionModels
        RebuildModels()
    end

    /*
    This action gives the ground a look: its layers and how they blend. The
    region models are made again with it. Undefined goes back to plain
    ground. Call it again after changing the TerrainMaterial.

    Attribute: Parameter material The terrain material, or undefined for plain ground.
    */
    action SetMaterial(TerrainMaterial material)
        me:material = material
        RefreshMaterial()
    end

    /*
    This action returns the ground's terrain material.

    Attribute: Returns The terrain material, or undefined for plain ground.
    */
    action GetMaterial returns TerrainMaterial
        return material
    end

    /*
    This action gives the terrain its material again, after the
    TerrainMaterial changed, and makes the region models again.
    */
    action RefreshMaterial
        if material = undefined
            terrain:SetTextureSplat(undefined)
            integer layer = 0
            repeat while layer < 4
                if terrain:GetLayerMaterial(layer) not= undefined
                    terrain:SetLayerMaterial(layer, undefined)
                end
                layer = layer + 1
            end
        else
            material:ApplyTo(terrain)
        end
        if terrain:GetData():GetRegionCount() > 0
            RebuildModels()
        end
    end

    /*
    This action gives the terrain one layer of its material again, after a
    map of that layer's Material changed, and makes the region models again
    (step 14).

    Attribute: Parameter layer The layer, from 0.
    */
    action RefreshMaterialLayer(integer layer)
        if material = undefined
            return now
        end
        material:ReloadLayer(terrain, layer)
        if terrain:GetData():GetRegionCount() > 0
            RebuildModels()
        end
    end

    /*
    This action loads a terrain material file and gives the ground its look.

    Attribute: Parameter file The terrain material file.
    */
    action LoadMaterial(File file)
        TerrainMaterial loaded
        loaded:Load(file)
        materialFile = file:GetPath()
        SetMaterial(loaded)
    end

    /*
    This action returns the terrain material file's path, as a scene names
    it.

    Attribute: Returns The path, or an empty text for plain ground.
    */
    action GetMaterialFile returns text
        return materialFile
    end

    /*
    This action sets the terrain material file's path, as a scene names it.

    Attribute: Parameter path The path, or an empty text for plain ground.
    */
    action SetMaterialFile(text path)
        materialFile = path
    end

    /*
    This action gives the terrain its foliage list: the assets its copies
    are of (Terrain plan F1). The copies themselves are in
    GetTerrainFoliage, by each asset's number in the list.

    Attribute: Parameter list The foliage list, or undefined for none.
    */
    action SetFoliageList(FoliageList list)
        foliageList = list
        cardTextures:Empty()
        foliageChanged = true
    end

    /*
    This action returns the terrain's foliage list.

    Attribute: Returns The list, or undefined if it has none.
    */
    action GetFoliageList returns FoliageList
        return foliageList
    end

    /*
    This action loads a foliage list file and gives it to the terrain.

    Attribute: Parameter file The foliage list file.
    */
    action LoadFoliageList(File file)
        FoliageList loaded
        loaded:Load(file)
        foliageFile = file:GetPath()
        foliageList = loaded
        cardTextures:Empty()
        foliageChanged = true
    end

    /*
    This action makes the foliage's drawing again on the next update, after
    copies were added or removed by code, or the foliage list's assets
    changed (Terrain plan F2). The foliage brush in a scene editor calls
    RefreshFoliage with the area it changed instead, which is quicker.
    */
    action FoliageChanged
        foliageChanged = true
    end

    /*
    This action makes the drawing of the foliage cells in an area again now,
    after copies there were added, removed or moved, such as by a brush
    stroke or by sculpting under them (Terrain plan F2 to F4).

    Attribute: Parameter x The area's middle along x, in world units.
    Attribute: Parameter z The area's middle along z, in world units.
    Attribute: Parameter radius How far the area reaches from its middle.
    */
    action RefreshFoliage(number x, number z, number radius)
        if foliageList = undefined or GetLayer() = undefined
            foliageChanged = true
            return now
        end
        integer i = 0
        repeat while i < foliage:GetCellCount()
            FoliageCell cell = foliage:GetCellAtIndex(i)
            number size = cell:GetCellSize()
            number lowX = cell:GetCellX() * size
            number lowZ = cell:GetCellZ() * size
            if lowX <= x + radius and lowX + size >= x - radius and lowZ <= z + radius and lowZ + size >= z - radius
                RefreshFoliageCell(cell)
            end
            i = i + 1
        end
        RefreshRenderBounds()
    end

    /*
    This action moves the foliage in an area onto the ground under it, after
    the ground there was sculpted, keeping each asset's height offset
    (Terrain plan F4). A scene editor calls it as the ground changes.

    Attribute: Parameter x The area's middle along x, in world units.
    Attribute: Parameter z The area's middle along z, in world units.
    Attribute: Parameter radius How far the area reaches from its middle; a negative radius is the whole terrain.
    Attribute: Returns How many cells of foliage moved.
    */
    action FollowGround(number x, number z, number radius) returns integer
        Array<FoliageCell> moved = foliage:FollowGround(foliageList, x, z, radius)
        integer i = 0
        repeat while i < moved:GetSize()
            FoliageCell cell = moved:Get(i)
            text key = "" + cell:GetAsset() + "/" + cell:GetCellX() + "/" + cell:GetCellZ()
            if foliageItems:HasKey(key)
                foliageItems:GetValue(key):PlaceAgain()
            end
            i = i + 1
        end
        return moved:GetSize()
    end

    /*
    This action makes every foliage cell's drawing again: the old cell items
    are taken out, and one made for each cell with copies whose asset is in
    the foliage list.
    */
    private action BuildFoliage
        foliageChanged = false
        Array<text> keys
        Iterator<text> iterator = foliageItems:GetKeyIterator()
        repeat while iterator:HasNext()
            keys:Add(iterator:Next())
        end
        integer k = 0
        repeat while k < keys:GetSize()
            FoliageCellItem old = foliageItems:RemoveKey(keys:Get(k))
            old:Clear()
            boolean removed = Remove(old)
            k = k + 1
        end
        foliageReach = 0
        if foliageList not= undefined
            integer i = 0
            repeat while i < foliage:GetCellCount()
                RefreshFoliageCell(foliage:GetCellAtIndex(i))
                i = i + 1
            end
        end
        foliageCheckTime = FOLIAGE_CHECK_SECONDS
        RefreshRenderBounds()
    end

    /*
    This action makes one cell's drawing again, adding its item the first
    time, and taking it out if the cell is now empty.

    Attribute: Parameter cell The cell.
    */
    private action RefreshFoliageCell(FoliageCell cell)
        text key = "" + cell:GetAsset() + "/" + cell:GetCellX() + "/" + cell:GetCellZ()
        FoliageCellItem item = undefined
        if foliageItems:HasKey(key)
            item = foliageItems:GetValue(key)
        end
        boolean usable = not cell:IsEmpty() and cell:GetAsset() >= 0 and cell:GetAsset() < foliageList:GetAssetCount()
        if not usable
            if item not= undefined
                FoliageCellItem old = foliageItems:RemoveKey(key)
                old:Clear()
                boolean removed = Remove(old)
            end
            return now
        end
        FoliageAsset asset = foliageList:GetAsset(cell:GetAsset())
        if item = undefined
            FoliageCellItem made
            made:SetAcceptsMouseInput(IsAcceptingMouseInput())
            Add(made)
            foliageItems:Add(key, made)
            item = made
        end
        File assetFile = GetFoliageAssetFile(asset)
        item:Set(cell, asset, assetFile)
        // For copies that lean with the slope (Dense grass plan DG4).
        item:SetGround(terrain:GetData())
        if asset:IsCard() and assetFile:Exists()
            text textureKey = assetFile:GetAbsolutePath()
            if not cardTextures:HasKey(textureKey)
                cardTextures:Add(textureKey, LoadCardTexture(assetFile))
            end
            item:SetCardTexture(cardTextures:GetValue(textureKey))
        end
        // Levels of detail (Foliage plan F6): their files, and a card
        // level's picture, shared like the asset's own.
        integer level = 1
        repeat while level <= asset:MAXIMUM_LEVELS
            File levelFile = undefined
            Texture levelTexture = undefined
            if asset:HasLevel(level)
                levelFile = GetFoliagePathFile(asset:GetLevelPath(level))
                if asset:IsLevelCard(level) and levelFile:Exists()
                    levelTexture = GetCardTexture(levelFile)
                end
            end
            item:SetLevelSource(level, levelFile, levelTexture)
            level = level + 1
        end
        item:Build()
        if item:GetReach() > foliageReach
            foliageReach = item:GetReach()
        end
    end

    /*
    This action returns an asset's model file, or its card picture, whose
    path is relative to the foliage list's file.

    Attribute: Parameter asset The asset.
    Attribute: Returns The file.
    */
    action GetFoliageAssetFile(FoliageAsset asset) returns File
        text path = asset:GetModelPath()
        if asset:IsCard()
            path = asset:GetCardPicturePath()
        end
        return GetFoliagePathFile(path)
    end

    /*
    This action returns a card picture's texture, loading it the first time
    and sharing it with every cell after (Foliage plan F6 uses it for card
    levels of detail).

    Attribute: Parameter file The picture.
    Attribute: Returns The texture.
    */
    private action GetCardTexture(File file) returns Texture
        text textureKey = file:GetAbsolutePath()
        if not cardTextures:HasKey(textureKey)
            cardTextures:Add(textureKey, LoadCardTexture(file))
        end
        return cardTextures:GetValue(textureKey)
    end

    /*
    This action loads a card's picture with mipmaps, as a cut-out picture
    (Dense grass plan DG5): without mipmaps, distant cards are read from the
    full-size picture and flicker; with plain mipmaps, thin blades fade
    below the cut and the grass thins out far away. A cut-out picture's
    smaller levels keep the same share of pixels past the cut (a half, the
    cut a card's plane uses).

    Attribute: Parameter file The picture.
    Attribute: Returns The texture.
    */
    action LoadCardTexture(File file) returns Texture
        Texture texture
        texture:SetCutoutMipMaps(0.5)
        texture:LoadFromFile(file:GetAbsolutePath(), true)
        return texture
    end

    /*
    This action returns the file for a path in the foliage list, such as an
    asset's model or a level of detail's picture: a full path as it is,
    and any other relative to the foliage list's file (Foliage plan F6
    split it out of GetFoliageAssetFile).

    Attribute: Parameter path The path.
    Attribute: Returns The file.
    */
    action GetFoliagePathFile(text path) returns File
        File file
        File listFile = undefined
        if foliageList not= undefined
            listFile = foliageList:GetFile()
        end
        if listFile = undefined or path:StartsWith("/") or path:Contains(":")
            file:SetPath(path)
            return file
        end
        file:SetWorkingDirectory(listFile:GetWorkingDirectory())
        text listPath = listFile:GetPath()
        // The list's folder: everything up to its last slash.
        integer slash = -1
        integer found = listPath:IndexOf("/")
        repeat while found >= 0
            slash = found
            found = listPath:IndexOf("/", found + 1)
        end
        if slash < 0
            file:SetPath(path)
        else
            file:SetPath(listPath:GetSubtext(0, slash + 1) + path)
        end
        return file
    end

    /*
    This action shows the foliage cells within their asset's draw distance
    of a place, and hides the others.

    Attribute: Parameter x The place along x, such as the camera's.
    Attribute: Parameter z The place along z.
    */
    private action ShowFoliageNear(number x, number z)
        Iterator<FoliageCellItem> items = foliageItems:GetValueIterator()
        repeat while items:HasNext()
            FoliageCellItem item = items:Next()
            number offsetX = item:GetCellMiddleX() - x
            number offsetZ = item:GetCellMiddleZ() - z
            // Measured to the cell's nearest side, about: its middle less
            // half its diagonal.
            number reachOut = item:GetAsset():GetDrawDistance() + item:GetCell():GetCellSize() * 0.71
            boolean near = offsetX * offsetX + offsetZ * offsetZ <= reachOut * reachOut
            // Shown when near and in the camera's view (Dense grass plan
            // DG1); the view is checked every frame by CullFoliageByView.
            item:SetNearCamera(near)
            // A shown cell picks its level of detail and thins its copies
            // near the draw distance (Foliage plan F5 and F6); it only
            // draws again when either changes.
            if near
                number distance = foliageMath:SquareRoot(offsetX * offsetX + offsetZ * offsetZ) - item:GetCell():GetCellSize() * 0.71
                if distance < 0
                    distance = 0
                end
                boolean changed = item:UpdateForDistance(distance)
                if changed and item:GetReach() > foliageReach
                    foliageReach = item:GetReach()
                    RefreshRenderBounds()
                end
            end
        end
    end

    /*
    This action returns how many foliage cells the terrain draws from:
    one per cell and asset with copies (Dense grass plan DG0).

    Attribute: Returns The number of cells.
    */
    action GetFoliageCellCount returns integer
        return foliageItems:GetSize()
    end

    /*
    This action returns how many foliage cells are shown now: within their
    asset's draw distance of the camera and, for assets that cast no
    shadows, in its view (Dense grass plan DG0 and DG1).

    Attribute: Returns The number of cells shown.
    */
    action GetShownFoliageCellCount returns integer
        integer shown = 0
        Iterator<FoliageCellItem> items = foliageItems:GetValueIterator()
        repeat while items:HasNext()
            FoliageCellItem item = items:Next()
            if item:IsShowing()
                shown = shown + 1
            end
        end
        return shown
    end

    /*
    This action returns how many foliage instances the shown cells draw
    now, after thinning (Dense grass plan DG0): a card's planes count as
    one each, so a two-plane card counts twice.

    Attribute: Returns The number of instances drawn.
    */
    action GetDrawnFoliageCount returns integer
        integer drawn = 0
        Iterator<FoliageCellItem> items = foliageItems:GetValueIterator()
        repeat while items:HasNext()
            FoliageCellItem item = items:Next()
            if item:IsShowing()
                drawn = drawn + item:GetDrawnCopyCount()
            end
        end
        return drawn
    end

    /*
    This action returns the foliage list file's path, as a scene names it.

    Attribute: Returns The path, or an empty text for no foliage list.
    */
    action GetFoliageFile returns text
        return foliageFile
    end

    /*
    This action sets the foliage list file's path, as a scene names it.

    Attribute: Parameter path The path, or an empty text for none.
    */
    action SetFoliageFile(text path)
        foliageFile = path
    end

    /*
    This action returns where every copy of the terrain's foliage stands.
    It is loaded and saved with the terrain.

    Attribute: Returns The terrain's foliage.
    */
    action GetTerrainFoliage returns TerrainFoliage
        return foliage
    end

    /*
    This action returns the terrain.json file's path, as given to Load or
    CreateFlat.

    Attribute: Returns The path, or an empty text if no terrain is loaded.
    */
    action GetTerrainFile returns text
        return terrainFile
    end

    /*
    This action returns the WorldTerrain the item holds, to read heights,
    edit the ground, or update its collision.

    Attribute: Returns The WorldTerrain.
    */
    action GetWorldTerrain returns WorldTerrain
        return terrain
    end

    /*
    This action gives back the places the terrain's ground textures hold in
    the renderer, once the terrain is no longer used, such as when its scene
    is closed. Remove the terrain from its layer first. If it is added and
    drawn again, it takes new places on its next update.
    */
    action Dispose
        terrain:ReleaseTexturePlaces()
        water:Clear(me)
        Iterator<FoliageCellItem> items = foliageItems:GetValueIterator()
        repeat while items:HasNext()
            items:Next():Clear()
        end
    end

    /*
    This action sets whether the terrain's region models have collision
    shapes, so physics objects land on them. Set it before Load or
    CreateFlat. Quorum Studio's editor turns it off, since it only draws.

    Attribute: Parameter enabled True for collision, the default.
    */
    action SetCollision(boolean enabled)
        if enabled
            collisionMode = terrain:COLLISION_FULL
        else
            collisionMode = terrain:COLLISION_DISABLED
        end
    end

    /*
    This action returns whether the terrain's region models have collision
    shapes.

    Attribute: Returns True for collision.
    */
    action HasCollision returns boolean
        return collisionMode not= terrain:COLLISION_DISABLED
    end

    /*
    This action sets how the terrain can be collided with: WorldTerrain's
    COLLISION_FULL, every region (the default); COLLISION_DYNAMIC, only near
    moving bodies, for large worlds; or COLLISION_DISABLED. Set it before
    Load or CreateFlat.

    Attribute: Parameter mode The collision mode.
    */
    action SetCollisionMode(integer mode)
        if mode < 0 or mode > 2
            alert("The collision mode must be COLLISION_DISABLED, COLLISION_DYNAMIC or COLLISION_FULL, but was given " + mode + ".")
        end
        collisionMode = mode
    end

    /*
    This action returns how the terrain can be collided with.

    Attribute: Returns WorldTerrain's COLLISION_FULL, COLLISION_DYNAMIC or COLLISION_DISABLED.
    */
    action GetCollisionMode returns integer
        return collisionMode
    end

    /*
    This action sets whether the terrain streams: it then loads and draws
    only the regions within the draw radius of the camera, or of the item it
    follows (SetFollowItem), loading and unloading regions as that moves.
    For large terrains. Set it before Load; streaming starts on the item's
    first update in a layer.

    Attribute: Parameter stream True to stream.
    Attribute: Parameter radius How near, in world units, a region must be to be drawn. It must be more than 0.
    */
    action SetStreaming(boolean stream, number radius)
        if radius <= 0
            alert("The draw radius must be more than 0, but was given " + radius + ".")
        end
        streaming = stream
        drawRadius = radius
    end

    /*
    This action returns true if the terrain streams its regions.

    Attribute: Returns True for streaming.
    */
    action IsStreaming returns boolean
        return streaming
    end

    /*
    This action returns how near a region must be to be drawn while
    streaming.

    Attribute: Returns The draw radius, in world units.
    */
    action GetDrawRadius returns number
        return drawRadius
    end

    /*
    This action sets the item the terrain keeps its regions and collision
    around, such as a player's car. Undefined, the default, uses the camera.

    Attribute: Parameter item The item to follow, or undefined for the camera.
    */
    action SetFollowItem(Item3D item)
        followItem = item
    end

    /*
    This action returns the item the terrain keeps its regions around.

    Attribute: Returns The item, or undefined for the camera.
    */
    action GetFollowItem returns Item3D
        return followItem
    end

    /*
    This action keeps the terrain up to date each frame, so a game needs no
    code for it: ground textures become ready to draw, and a streaming
    terrain loads and unloads regions around the camera, or the item it
    follows. The layer calls it.

    Attribute: Parameter secondsSinceUpdate The time since the last frame.
    */
    action Update(number secondsSinceUpdate)
        Layer3D layer = GetLayer()
        if layer = undefined or missing
            return now
        end
        number x = 0
        number z = 0
        if followItem not= undefined
            x = followItem:GetGlobalX()
            z = followItem:GetGlobalZ()
        else
            x = layer:GetCamera():GetPosition():GetX()
            z = layer:GetCamera():GetPosition():GetZ()
        end
        if streaming and not streamingStarted
            streamingStarted = true
            terrain:SetCollisionMode(collisionMode)
            terrain:SetName(GetName())
            terrain:SetDrawRadius(drawRadius)
            terrain:StartStreaming(GetFolder(terrainLocation), layer, x, z)
            return now
        end
        boolean changed = terrain:Update(layer, x, z)
        UpdateWaterAndFoliage(layer, x, z, secondsSinceUpdate)
    end

    /*
    This action keeps the water and foliage drawn: the water after it
    changed, with the sea following a place (Water plan W5), and the
    foliage after it changed, with its cells shown within their draw
    distance of the camera (Terrain plan F2).

    Attribute: Parameter layer The layer the terrain is in.
    Attribute: Parameter x The place the sea follows, along x.
    Attribute: Parameter z The place the sea follows, along z.
    Attribute: Parameter seconds The time since this was last called.
    */
    private action UpdateWaterAndFoliage(Layer3D layer, number x, number z, number seconds)
        if water:Update(me, layer, x, z)
            RefreshRenderBounds()
        end
        if foliageChanged
            BuildFoliage()
        end
        foliageCheckTime = foliageCheckTime + seconds
        if foliageCheckTime >= FOLIAGE_CHECK_SECONDS and not foliageItems:IsEmpty()
            foliageCheckTime = 0
            ShowFoliageNear(layer:GetCamera():GetPosition():GetX(), layer:GetCamera():GetPosition():GetZ())
        end
        if not foliageItems:IsEmpty()
            CullFoliageByView(layer)
        end
    end

    /*
    This action hides the foliage cells outside the camera's view, every
    frame (Dense grass plan DG1), so grass behind the camera isn't drawn.
    The layer only culls the terrain as a whole, and the cells are its
    children. Cells of assets that cast shadows stay shown while near,
    since a tree just out of view can still throw its shadow into it.
    The test treats the terrain item as standing at the origin, as foliage
    cells' boxes are in world units.

    Attribute: Parameter layer The layer whose camera is used.
    */
    private action CullFoliageByView(Layer3D layer)
        Camera camera = layer:GetCamera()
        if camera = undefined
            return now
        end
        foliageView:Set(camera:GetCombinedMatrix())
        integer outside = foliageView:OUTSIDE
        Iterator<FoliageCellItem> items = foliageItems:GetValueIterator()
        repeat while items:HasNext()
            FoliageCellItem item = items:Next()
            if item:IsNearCamera()
                boolean visible = true
                if not item:GetAsset():CastsShadows()
                    if item:GetRenderBounds(foliageBox)
                        visible = foliageView:Test(foliageBox) not= outside
                    end
                end
                item:SetInView(visible)
            end
        end
    end

    /*
    This action sets how much the ground's surface resists things sliding on
    it. Set it before Load or CreateFlat.

    Attribute: Parameter friction The friction.
    */
    action SetFriction(number friction)
        terrain:SetFriction(friction)
    end

    /*
    This action returns how much the ground's surface resists things sliding
    on it.

    Attribute: Returns The friction.
    */
    action GetFriction returns number
        return terrain:GetFriction()
    end

    /*
    This action keeps the terrain up to date, and should be called once a
    frame, with where the camera or player is. Ground textures that are
    painted onto the terrain only show once the renderer has them ready,
    which this checks. A plain terrain needs nothing from it, so calling it
    costs little.

    Attribute: Parameter layer The layer the terrain is in.
    Attribute: Parameter x Where the camera or player is, along x.
    Attribute: Parameter z Where the camera or player is, along z.
    Attribute: Returns True if anything about the terrain changed.
    */
    action Update(Layer3D layer, number x, number z) returns boolean
        boolean changed = terrain:Update(layer, x, z)
        // Its water and foliage too, as the frame update does. This may be
        // called without the time, so the foliage's distances are checked
        // each call.
        if GetLayer() not= undefined and not missing
            UpdateWaterAndFoliage(layer, x, z, FOLIAGE_CHECK_SECONDS)
        end
        return changed
    end

    /*
    This action makes the terrain's region models and adds them to the item.
    */
    private action BuildModels
        terrain:SetCollisionMode(collisionMode)
        terrain:SetName(GetName())
        terrain:Build()
        integer i = 0
        repeat while i < terrain:GetRegionModelCount()
            // The region models take mouse input only if the item does, so a
            // terrain that doesn't (such as in a scene editor) passes clicks
            // through to what is under it.
            terrain:GetRegionModel(i):SetAcceptsMouseInput(IsAcceptingMouseInput())
            Add(terrain:GetRegionModel(i))
            i = i + 1
        end
        // The box the layer culls the terrain by covers the new regions.
        RefreshRenderBounds()
    end

    /*
    This action fills in the box around every region the terrain has, in its
    own coordinates. The layer's render tree uses it to decide whether the
    terrain is in view, and the region models are the item's children, so
    they show or hide with it. Without it, a terrain has no size, and the
    layer treats it as a point at its position, hiding the whole terrain
    whenever that point is out of view.

    Attribute: Parameter local The box to fill in.
    Attribute: Returns True, or false if the terrain has no regions.
    */
    action GetRenderBounds(BoundingBox local) returns boolean
        TerrainData data = terrain:GetData()
        if data:GetRegionCount() = 0
            return false
        end
        TerrainRegion first = data:GetRegionAtIndex(0)
        integer lowX = first:GetLocationX()
        integer highX = lowX
        integer lowZ = first:GetLocationZ()
        integer highZ = lowZ
        integer i = 1
        repeat while i < data:GetRegionCount()
            TerrainRegion region = data:GetRegionAtIndex(i)
            if region:GetLocationX() < lowX
                lowX = region:GetLocationX()
            end
            if region:GetLocationX() > highX
                highX = region:GetLocationX()
            end
            if region:GetLocationZ() < lowZ
                lowZ = region:GetLocationZ()
            end
            if region:GetLocationZ() > highZ
                highZ = region:GetLocationZ()
            end
            i = i + 1
        end
        number regionWidth = data:GetRegionSize() * data:GetVertexSpacing()
        number minimumX = lowX * regionWidth
        number minimumZ = lowZ * regionWidth
        number maximumX = (highX + 1) * regionWidth
        number maximumZ = (highZ + 1) * regionWidth
        number lowest = data:GetLowestHeight()
        number highest = data:GetHighestHeight()
        // The water (Water plan W5): the sea's sheet reaches far past the
        // regions, and water can stand above or below the ground.
        if water:HasWater()
            number waterLow = water:GetLowestLevel()
            number waterHigh = water:GetHighestLevel()
            if waterLow < lowest
                lowest = waterLow
            end
            if waterHigh > highest
                highest = waterHigh
            end
            WaterSurface sea = water:GetSea()
            if sea not= undefined
                number half = water:GetSeaSize() / 2
                if sea:GetX() - half < minimumX
                    minimumX = sea:GetX() - half
                end
                if sea:GetZ() - half < minimumZ
                    minimumZ = sea:GetZ() - half
                end
                if sea:GetX() + half > maximumX
                    maximumX = sea:GetX() + half
                end
                if sea:GetZ() + half > maximumZ
                    maximumZ = sea:GetZ() + half
                end
            end
            integer lakeIndex = 0
            repeat while lakeIndex < water:GetLakeCount()
                TerrainLake lake = water:GetLake(lakeIndex)
                if lake:GetX() - lake:GetWidth() / 2 < minimumX
                    minimumX = lake:GetX() - lake:GetWidth() / 2
                end
                if lake:GetZ() - lake:GetDepth() / 2 < minimumZ
                    minimumZ = lake:GetZ() - lake:GetDepth() / 2
                end
                if lake:GetX() + lake:GetWidth() / 2 > maximumX
                    maximumX = lake:GetX() + lake:GetWidth() / 2
                end
                if lake:GetZ() + lake:GetDepth() / 2 > maximumZ
                    maximumZ = lake:GetZ() + lake:GetDepth() / 2
                end
                lakeIndex = lakeIndex + 1
            end
        end
        Vector3 minimum
        minimum:Set(minimumX, lowest - BOUNDS_PADDING, minimumZ)
        Vector3 maximum
        // The foliage can stand taller than the padding.
        number top = BOUNDS_PADDING
        if foliageReach > top
            top = foliageReach + BOUNDS_PADDING
        end
        maximum:Set(maximumX, highest + top, maximumZ)
        local:Set(minimum, maximum)
        return true
    end

    /*
    This action gives the layer's render tree the terrain's box again, after
    regions were added or removed or the ground was raised or lowered. A
    terrain not in a layer has nothing to tell.
    */
    action RefreshRenderBounds
        Layer3D layer = GetLayer()
        if layer = undefined
            return now
        end
        RenderTree3D tree = layer:GetRenderTree()
        BoundingBox local
        if tree not= undefined and tree:Has(me) and GetRenderBounds(local)
            tree:SetLocalBounds(me, local)
        end
    end

    /*
    This action makes the terrain's region models again, after the terrain's
    look or its regions have changed: its old region models are taken out of
    the item, and the new ones added. Build frees the old models.
    */
    private action RebuildModels
        integer i = 0
        repeat while i < terrain:GetRegionModelCount()
            Remove(terrain:GetRegionModel(i))
            i = i + 1
        end
        BuildModels()
    end

    /*
    This action stops a second terrain being loaded into the same item.
    */
    private action CheckEmpty
        if terrain:GetData():GetRegionCount() > 0
            alert("This TerrainItem already holds a terrain. Use a new TerrainItem for another.")
        end
    end

    /*
    This action returns the folder holding a terrain.json file, keeping the
    file's working directory, so a path relative to a project still works.

    Attribute: Parameter file The terrain.json file.
    Attribute: Returns The folder.
    */
    private action GetFolder(File file) returns File
        text name = "terrain.json"
        text path = file:GetPath()
        if not path:EndsWith(name)
            alert("A terrain is loaded from its terrain.json file, but was given " + path + ".")
        end
        text folderPath = path:GetSubtext(0, path:GetSize() - name:GetSize())
        if folderPath:EndsWith("/")
            folderPath = folderPath:GetSubtext(0, folderPath:GetSize() - 1)
        end
        File folder
        folder:SetWorkingDirectory(file:GetWorkingDirectory())
        folder:SetPath(folderPath)
        return folder
    end
end
