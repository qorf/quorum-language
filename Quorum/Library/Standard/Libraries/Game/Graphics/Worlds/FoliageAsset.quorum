package Libraries.Game.Graphics.Worlds

use Libraries.Containers.Iterator
use Libraries.Containers.Array
use Libraries.Containers.Number32BitArray
use Libraries.Data.Formats.JavaScriptObjectNotation

/*
A FoliageAsset is one kind of plant or object that can be scattered over a
terrain, such as a pine, a rock or a tuft of grass (Terrain plan F1). It
names the model to draw, or a picture for a flat card, and says how copies of
it are placed: how many per square unit, how much their size, turn and shade
vary, and on what slopes they grow. A FoliageList holds the assets a terrain
uses; TerrainFoliage holds where each copy stands.

Attribute: Example
use Libraries.Game.Graphics.Worlds.FoliageAsset

FoliageAsset pine
pine:SetName("Pine")
pine:SetModelPath("Models/Pine.glb")
pine:SetDensity(0.02)
pine:SetRandomScale(0.3)
pine:SetMaximumSlope(35)
*/
class FoliageAsset
    text name = ""

    // The model to draw, relative to the foliage list's file, or "" for a
    // card.
    text modelPath = ""

    // A card's picture, relative to the foliage list's file, and how many
    // crossed quads it has, from 1 to 3. Used when there is no model.
    text cardPicturePath = ""
    integer cardPlanes = 2

    // How far above or below the ground each copy stands, in world units.
    number heightOffset = 0

    // Each copy's size: the base scale, varied by up to this share either
    // way (0.2 is 20% larger or smaller).
    number baseScale = 1
    number randomScale = 0.2

    // True to turn each copy a random amount about the up axis.
    boolean randomTurn = true

    // How much each copy's shade varies, from 0 (all the same) to 1.
    number shadeVariation = 0.1

    // The slopes it grows on, in degrees from flat.
    number minimumSlope = 0
    number maximumSlope = 90

    // How many copies per square unit the foliage brush places.
    number density = 0.05

    boolean castsShadows = true

    // How far from the camera copies are drawn, in world units.
    number drawDistance = 200

    // Levels of detail (Foliage plan F6): up to MAXIMUM_LEVELS more meshes,
    // numbered from 1, each a model or a card picture (relative to the
    // foliage list's file, "" when unused) and the distance from the camera
    // it is used from. Level 0 is the asset's own mesh. Index 0 of each
    // array is unused, so a level's number is its place.
    Array<text> levelModelPaths
    Array<text> levelCardPicturePaths
    Number32BitArray levelDistances
    public constant integer MAXIMUM_LEVELS = 3

    // The wind (Foliage plan F6): how far a copy's points move sideways per
    // unit of height above where it stands, and the wind's direction about
    // the up axis, in degrees from +x toward +z.
    number wind = 0
    number windDirection = 0

    // Shadows by level of detail (Dense grass plan DG3): the farthest level
    // that casts shadows (levels past it cast none), and the level whose
    // mesh throws the shadow for nearer levels (0 for each level's own).
    integer lastShadowLevel = 3
    integer shadowLevel = 0

    // Placement (Dense grass plan DG4), worked out for each copy when its
    // cell is built, from where it stands, so painted copies follow a
    // change: whether copies lean with the ground's slope; a fixed lean and
    // a random lean of up to so many degrees, in a random direction; a
    // fixed turn about the up axis, added to the random one; the color
    // copies are tinted (red, green, blue, from 0 to 1, white for none);
    // and how far each copy's hue may turn either way, in degrees.
    boolean alignToNormal = false
    number fixedTilt = 0
    number randomTilt = 0
    number fixedTurn = 0
    number tintRed = 1
    number tintGreen = 1
    number tintBlue = 1
    number randomHue = 0

    // How far, in world units, a level of detail fades into the next
    // (Dense grass plan DG6): over this distance before the next level's
    // start, a growing share of the copies switch, so a cell doesn't change
    // all at once. 0 switches at once.
    number fadeMargin = 0

    on create
        levelDistances:SetSize(MAXIMUM_LEVELS + 1)
        integer i = 0
        repeat while i <= MAXIMUM_LEVELS
            levelModelPaths:Add("")
            levelCardPicturePaths:Add("")
            levelDistances:Set(i, 0)
            i = i + 1
        end
    end

    /*
    This action returns the asset's name, such as "Pine".

    Attribute: Returns The name.
    */
    action GetName returns text
        return name
    end

    /*
    This action sets the asset's name.

    Attribute: Parameter value The name.
    */
    action SetName(text value)
        name = value
    end

    /*
    This action returns the model's path, relative to the foliage list's
    file, or "" for a card.

    Attribute: Returns The path.
    */
    action GetModelPath returns text
        return modelPath
    end

    /*
    This action sets the model to draw, such as "Models/Pine.glb", relative
    to the foliage list's file.

    Attribute: Parameter path The path, or "" for a card.
    */
    action SetModelPath(text path)
        modelPath = path
    end

    /*
    This action returns true if the asset is drawn as a flat card instead of
    a model.

    Attribute: Returns True for a card.
    */
    action IsCard returns boolean
        return modelPath = ""
    end

    /*
    This action returns a card's picture, relative to the foliage list's
    file.

    Attribute: Returns The path.
    */
    action GetCardPicturePath returns text
        return cardPicturePath
    end

    /*
    This action sets a card's picture, a .png with transparent parts.

    Attribute: Parameter path The path, relative to the foliage list's file.
    */
    action SetCardPicturePath(text path)
        cardPicturePath = path
    end

    /*
    This action returns how many crossed quads a card has.

    Attribute: Returns From 1 to 3.
    */
    action GetCardPlanes returns integer
        return cardPlanes
    end

    /*
    This action sets how many crossed quads a card has.

    Attribute: Parameter planes From 1 to 3.
    */
    action SetCardPlanes(integer planes)
        if planes < 1 or planes > 3
            alert("A card has from 1 to 3 planes, but was given " + planes + ".")
        end
        cardPlanes = planes
    end

    /*
    This action returns how far above the ground each copy stands.

    Attribute: Returns The offset, in world units; below 0 sinks it.
    */
    action GetHeightOffset returns number
        return heightOffset
    end

    /*
    This action sets how far above the ground each copy stands.

    Attribute: Parameter offset The offset, in world units; below 0 sinks it.
    */
    action SetHeightOffset(number offset)
        heightOffset = offset
    end

    /*
    This action returns each copy's base scale.

    Attribute: Returns The scale.
    */
    action GetBaseScale returns number
        return baseScale
    end

    /*
    This action sets each copy's base scale.

    Attribute: Parameter scale The scale, more than 0.
    */
    action SetBaseScale(number scale)
        if scale <= 0
            alert("A foliage asset's scale must be more than 0, but was given " + scale + ".")
        end
        baseScale = scale
    end

    /*
    This action returns how much each copy's size varies.

    Attribute: Returns The share either way, from 0 to 1.
    */
    action GetRandomScale returns number
        return randomScale
    end

    /*
    This action sets how much each copy's size varies, as a share of the
    base scale either way.

    Attribute: Parameter share From 0 (all the same) to 1.
    */
    action SetRandomScale(number share)
        if share < 0 or share > 1
            alert("A foliage asset's random scale is from 0 to 1, but was given " + share + ".")
        end
        randomScale = share
    end

    /*
    This action returns true if each copy is turned a random amount.

    Attribute: Returns True for random turns.
    */
    action HasRandomTurn returns boolean
        return randomTurn
    end

    /*
    This action sets whether each copy is turned a random amount about the
    up axis.

    Attribute: Parameter value True for random turns.
    */
    action SetRandomTurn(boolean value)
        randomTurn = value
    end

    /*
    This action returns how much each copy's shade varies.

    Attribute: Returns From 0 to 1.
    */
    action GetShadeVariation returns number
        return shadeVariation
    end

    /*
    This action sets how much each copy's shade varies.

    Attribute: Parameter variation From 0 (all the same) to 1.
    */
    action SetShadeVariation(number variation)
        if variation < 0 or variation > 1
            alert("A foliage asset's shade variation is from 0 to 1, but was given " + variation + ".")
        end
        shadeVariation = variation
    end

    /*
    This action returns the least slope it grows on.

    Attribute: Returns Degrees from flat.
    */
    action GetMinimumSlope returns number
        return minimumSlope
    end

    /*
    This action sets the least slope it grows on.

    Attribute: Parameter degrees From 0 to 90.
    */
    action SetMinimumSlope(number degrees)
        minimumSlope = degrees
    end

    /*
    This action returns the steepest slope it grows on.

    Attribute: Returns Degrees from flat.
    */
    action GetMaximumSlope returns number
        return maximumSlope
    end

    /*
    This action sets the steepest slope it grows on.

    Attribute: Parameter degrees From 0 to 90.
    */
    action SetMaximumSlope(number degrees)
        maximumSlope = degrees
    end

    /*
    This action returns true if a slope is in the range this asset grows on.

    Attribute: Parameter degrees The slope, in degrees from flat.
    Attribute: Returns True if it can grow there.
    */
    action GrowsOnSlope(number degrees) returns boolean
        return degrees >= minimumSlope and degrees <= maximumSlope
    end

    /*
    This action returns how many copies per square unit the foliage brush
    places.

    Attribute: Returns The density.
    */
    action GetDensity returns number
        return density
    end

    /*
    This action sets how many copies per square unit the foliage brush
    places, such as 0.02 for trees or 2 for grass.

    Attribute: Parameter value The density, more than 0.
    */
    action SetDensity(number value)
        if value <= 0
            alert("A foliage asset's density must be more than 0, but was given " + value + ".")
        end
        density = value
    end

    /*
    This action returns true if copies cast shadows.

    Attribute: Returns True for shadows.
    */
    action CastsShadows returns boolean
        return castsShadows
    end

    /*
    This action sets whether copies cast shadows. Grass usually doesn't.

    Attribute: Parameter value True for shadows.
    */
    action SetCastsShadows(boolean value)
        castsShadows = value
    end

    /*
    This action returns how far from the camera copies are drawn.

    Attribute: Returns The distance, in world units.
    */
    action GetDrawDistance returns number
        return drawDistance
    end

    /*
    This action sets how far from the camera copies are drawn.

    Attribute: Parameter distance The distance, in world units, more than 0.
    */
    action SetDrawDistance(number distance)
        if distance <= 0
            alert("A foliage asset's draw distance must be more than 0, but was given " + distance + ".")
        end
        drawDistance = distance
    end

    /*
    This action makes a level of detail a model (Foliage plan F6), used from
    its distance on instead of the asset's own mesh.

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    Attribute: Parameter path The model, relative to the foliage list's file, such as "Models/PineLow.glb"; "" leaves the level unused.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset pine
    pine:SetModelPath("Models/Pine.glb")
    pine:SetDrawDistance(400)
    pine:SetLevelModel(1, "Models/PineLow.glb")
    pine:SetLevelDistance(1, 80)
    pine:SetLevelCardPicture(2, "Pictures/PineCard.png")
    pine:SetLevelDistance(2, 200)
    */
    action SetLevelModel(integer level, text path)
        CheckLevel(level)
        levelModelPaths:Set(level, path)
        levelCardPicturePaths:Set(level, "")
    end

    /*
    This action makes a level of detail a card (Foliage plan F6): crossed
    upright pictures, as many planes as the asset's cards have.

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    Attribute: Parameter path The picture, relative to the foliage list's file; "" leaves the level unused.
    */
    action SetLevelCardPicture(integer level, text path)
        CheckLevel(level)
        levelCardPicturePaths:Set(level, path)
        levelModelPaths:Set(level, "")
    end

    /*
    This action sets the distance from the camera a level of detail is used
    from (Foliage plan F6).

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    Attribute: Parameter distance The distance, in world units.
    */
    action SetLevelDistance(integer level, number distance)
        CheckLevel(level)
        levelDistances:Set(level, distance)
    end

    /*
    This action leaves a level of detail unused (Foliage plan F6).

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    */
    action ClearLevel(integer level)
        CheckLevel(level)
        levelModelPaths:Set(level, "")
        levelCardPicturePaths:Set(level, "")
        levelDistances:Set(level, 0)
    end

    /*
    This action returns true if a level of detail is used: it has a model
    or a card picture (Foliage plan F6). Level 0, the asset's own mesh, is
    always used.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.
    Attribute: Returns True if the level is used.
    */
    action HasLevel(integer level) returns boolean
        if level = 0
            return true
        end
        if level < 0 or level > MAXIMUM_LEVELS
            return false
        end
        return levelModelPaths:Get(level) not= "" or levelCardPicturePaths:Get(level) not= ""
    end

    /*
    This action returns true if a level of detail is a card (Foliage plan
    F6). Level 0 is the asset's own mesh.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.
    Attribute: Returns True for a card.
    */
    action IsLevelCard(integer level) returns boolean
        if level = 0
            return IsCard()
        end
        CheckLevel(level)
        return levelModelPaths:Get(level) = ""
    end

    /*
    This action returns a level of detail's model or card picture, relative
    to the foliage list's file (Foliage plan F6). Level 0 gives the asset's
    own model or card picture.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.
    Attribute: Returns The path, or "" for an unused level.
    */
    action GetLevelPath(integer level) returns text
        if level = 0
            if IsCard()
                return cardPicturePath
            end
            return modelPath
        end
        CheckLevel(level)
        if levelModelPaths:Get(level) not= ""
            return levelModelPaths:Get(level)
        end
        return levelCardPicturePaths:Get(level)
    end

    /*
    This action returns a level of detail's model path (Foliage plan F6).

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    Attribute: Returns The path, or "" if the level isn't a model.
    */
    action GetLevelModelPath(integer level) returns text
        CheckLevel(level)
        return levelModelPaths:Get(level)
    end

    /*
    This action returns a level of detail's card picture (Foliage plan F6).

    Attribute: Parameter level The level, from 1 to MAXIMUM_LEVELS.
    Attribute: Returns The path, or "" if the level isn't a card.
    */
    action GetLevelCardPicturePath(integer level) returns text
        CheckLevel(level)
        return levelCardPicturePaths:Get(level)
    end

    /*
    This action returns the distance from the camera a level of detail is
    used from (Foliage plan F6). Level 0 is used from 0.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.
    Attribute: Returns The distance, in world units.
    */
    action GetLevelDistance(integer level) returns number
        if level = 0
            return 0
        end
        CheckLevel(level)
        return levelDistances:Get(level)
    end

    /*
    This action returns the level of detail to draw at a distance from the
    camera (Foliage plan F6): the used level with the greatest distance
    that is no farther than it, or 0 for the asset's own mesh.

    Attribute: Parameter distance The distance from the camera, in world units.
    Attribute: Returns The level, from 0 to MAXIMUM_LEVELS.
    */
    action GetLevelForDistance(number distance) returns integer
        integer chosen = 0
        number chosenDistance = 0
        integer level = 1
        repeat while level <= MAXIMUM_LEVELS
            if HasLevel(level)
                number start = levelDistances:Get(level)
                if start <= distance and (chosen = 0 or start > chosenDistance)
                    chosen = level
                    chosenDistance = start
                end
            end
            level = level + 1
        end
        return chosen
    end

    /*
    This action stops a level number out of range.
    */
    private action CheckLevel(integer level)
        if level < 1 or level > MAXIMUM_LEVELS
            alert("A foliage asset's levels of detail are numbered from 1 to " + MAXIMUM_LEVELS + ", but was given " + level + ".")
        end
    end

    /*
    This action returns how much copies sway in the wind (Foliage plan F6).

    Attribute: Returns How far a point moves sideways per unit of height above where the copy stands, 0 for none.
    */
    action GetWind returns number
        return wind
    end

    /*
    This action sets how much copies sway in the wind (Foliage plan F6).
    The terrain's cells give it to the asset's models' materials when they
    are built, so a terrain shows a change after its FoliageChanged. The
    materials belong to the model file or card picture, so other models
    from the same file sway the same.

    Attribute: Parameter strength How far a point moves sideways per unit of height above where the copy stands, such as 0.03 for grass; 0 for none.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset grass
    grass:SetCardPicturePath("Pictures/Grass.png")
    grass:SetWind(0.08)
    */
    action SetWind(number strength)
        if strength < 0
            alert("A foliage asset's wind must be 0 or more, but was given " + strength + ".")
        end
        wind = strength
    end

    /*
    This action returns the wind's direction (Foliage plan F6).

    Attribute: Returns Degrees about the up axis, from +x toward +z.
    */
    action GetWindDirection returns number
        return windDirection
    end

    /*
    This action sets the wind's direction (Foliage plan F6).

    Attribute: Parameter degrees Degrees about the up axis, from +x toward +z.
    */
    action SetWindDirection(number degrees)
        windDirection = degrees
    end

    /*
    This action returns the farthest level of detail that casts shadows
    (Dense grass plan DG3). Levels past it cast none, which saves drawing
    far copies into the shadows.

    Attribute: Returns The level, from 0 to MAXIMUM_LEVELS; MAXIMUM_LEVELS (the default) lets every level cast.
    */
    action GetLastShadowLevel returns integer
        return lastShadowLevel
    end

    /*
    This action sets the farthest level of detail that casts shadows (Dense
    grass plan DG3). It only matters if the asset casts shadows.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset pine
    pine:SetModelPath("Models/Pine.glb")
    pine:SetLevelCardPicture(1, "Pictures/PineCard.png")
    pine:SetLevelDistance(1, 60)
    pine:SetLastShadowLevel(0)
    */
    action SetLastShadowLevel(integer level)
        if level < 0 or level > MAXIMUM_LEVELS
            alert("A foliage asset's last shadow level must be from 0 to " + MAXIMUM_LEVELS + ", but was given " + level + ".")
        end
        lastShadowLevel = level
    end

    /*
    This action returns the level of detail whose mesh throws the shadow
    for nearer levels (Dense grass plan DG3), or 0 for each level's own.

    Attribute: Returns The level, from 0 to MAXIMUM_LEVELS.
    */
    action GetShadowLevel returns integer
        return shadowLevel
    end

    /*
    This action sets the level of detail whose mesh throws the shadow for
    nearer levels (Dense grass plan DG3), a "shadow stand-in": a detailed
    tree near the camera is drawn without its own shadow, and a simpler
    level is drawn only into the shadows in its place. Levels from this one
    on throw their own shadows. 0 lets every level throw its own.

    Attribute: Parameter level The level, from 0 to MAXIMUM_LEVELS.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset pine
    pine:SetModelPath("Models/Pine.glb")
    pine:SetLevelModel(1, "Models/PineSimple.glb")
    pine:SetLevelDistance(1, 40)
    pine:SetShadowLevel(1)
    */
    action SetShadowLevel(integer level)
        if level < 0 or level > MAXIMUM_LEVELS
            alert("A foliage asset's shadow level must be from 0 to " + MAXIMUM_LEVELS + ", but was given " + level + ".")
        end
        shadowLevel = level
    end

    /*
    This action returns whether copies lean with the ground's slope (Dense
    grass plan DG4).

    Attribute: Returns True if they lean with the slope.
    */
    action IsAlignedToNormal returns boolean
        return alignToNormal
    end

    /*
    This action sets whether copies lean with the ground's slope (Dense
    grass plan DG4), standing at right angles to it, as grass and rocks
    often do; trees usually stand upright.

    Attribute: Parameter value True to lean with the slope.
    */
    action SetAlignedToNormal(boolean value)
        alignToNormal = value
    end

    /*
    This action returns how far every copy leans, in degrees (Dense grass
    plan DG4).

    Attribute: Returns The lean, in degrees from upright.
    */
    action GetFixedTilt returns number
        return fixedTilt
    end

    /*
    This action sets how far every copy leans, in degrees from upright, in
    a direction chosen for each copy (Dense grass plan DG4).

    Attribute: Parameter degrees The lean, from 0 to 90.
    */
    action SetFixedTilt(number degrees)
        fixedTilt = degrees
    end

    /*
    This action returns how much more each copy may lean, at random, in
    degrees (Dense grass plan DG4).

    Attribute: Returns The most extra lean, in degrees.
    */
    action GetRandomTilt returns number
        return randomTilt
    end

    /*
    This action sets how much more each copy may lean, at random, in
    degrees, on top of the fixed lean (Dense grass plan DG4), so grass and
    reeds don't all stand straight.

    Attribute: Parameter degrees The most extra lean, from 0 to 90.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset grass
    grass:SetCardPicturePath("Pictures/Grass.png")
    grass:SetRandomTilt(12)
    grass:SetAlignedToNormal(true)
    */
    action SetRandomTilt(number degrees)
        randomTilt = degrees
    end

    /*
    This action returns the turn every copy gets about the up axis, in
    degrees, added to its random turn (Dense grass plan DG4).

    Attribute: Returns The turn, in degrees.
    */
    action GetFixedTurn returns number
        return fixedTurn
    end

    /*
    This action sets a turn every copy gets about the up axis, in degrees,
    added to its random turn (Dense grass plan DG4), such as to face a
    model's front one way when random turn is off.

    Attribute: Parameter degrees The turn, in degrees.
    */
    action SetFixedTurn(number degrees)
        fixedTurn = degrees
    end

    /*
    This action returns the red part of the color copies are tinted (Dense
    grass plan DG4).

    Attribute: Returns The red part, from 0 to 1.
    */
    action GetTintRed returns number
        return tintRed
    end

    /*
    This action returns the green part of the color copies are tinted
    (Dense grass plan DG4).

    Attribute: Returns The green part, from 0 to 1.
    */
    action GetTintGreen returns number
        return tintGreen
    end

    /*
    This action returns the blue part of the color copies are tinted (Dense
    grass plan DG4).

    Attribute: Returns The blue part, from 0 to 1.
    */
    action GetTintBlue returns number
        return tintBlue
    end

    /*
    This action sets the color copies are tinted (Dense grass plan DG4): it
    replaces the model's color, which its textures are multiplied by, and
    each copy's shade and hue vary it. White, the default, leaves the
    model's own color.

    Attribute: Parameter red The red part, from 0 to 1.
    Attribute: Parameter green The green part, from 0 to 1.
    Attribute: Parameter blue The blue part, from 0 to 1.

    Attribute: Example
    use Libraries.Game.Graphics.Worlds.FoliageAsset

    FoliageAsset grass
    grass:SetCardPicturePath("Pictures/Grass.png")
    grass:SetTint(0.8, 1, 0.6)
    grass:SetRandomHue(15)
    */
    action SetTint(number red, number green, number blue)
        tintRed = red
        tintGreen = green
        tintBlue = blue
    end

    /*
    This action returns true if copies are tinted a color other than white.

    Attribute: Returns True if tinted.
    */
    action IsTinted returns boolean
        return tintRed not= 1 or tintGreen not= 1 or tintBlue not= 1
    end

    /*
    This action returns how far each copy's hue may turn either way, in
    degrees (Dense grass plan DG4).

    Attribute: Returns The most turn, in degrees.
    */
    action GetRandomHue returns number
        return randomHue
    end

    /*
    This action sets how far each copy's hue may turn either way, in
    degrees (Dense grass plan DG4), so a field of grass has greener and
    yellower tufts. It turns the tint's hue, so it shows only on a colored
    tint, or a model whose textures are colored and whose tint is set.

    Attribute: Parameter degrees The most turn, from 0 to 180.
    */
    action SetRandomHue(number degrees)
        randomHue = degrees
    end

    /*
    This action returns how far a level of detail fades into the next
    (Dense grass plan DG6).

    Attribute: Returns The distance, in world units; 0 switches at once.
    */
    action GetFadeMargin returns number
        return fadeMargin
    end

    /*
    This action sets how far a level of detail fades into the next (Dense
    grass plan DG6): over this distance before the next level's start, a
    growing share of the copies switch, chosen by where they stand, so a
    cell changes a little at a time instead of all at once.

    Attribute: Parameter distance The distance, in world units; 0, the default, switches at once.
    */
    action SetFadeMargin(number distance)
        if distance < 0
            alert("A foliage asset's fade margin must be 0 or more, but was given " + distance + ".")
        end
        fadeMargin = distance
    end

    /*
    This action returns a copy of the asset.

    Attribute: Returns The copy.
    */
    action Copy returns FoliageAsset
        FoliageAsset copy
        copy:CopyFrom(me)
        return copy
    end

    /*
    This action makes this asset the same as another.

    Attribute: Parameter other The asset to copy.
    */
    action CopyFrom(FoliageAsset other)
        name = other:GetName()
        modelPath = other:GetModelPath()
        cardPicturePath = other:GetCardPicturePath()
        cardPlanes = other:GetCardPlanes()
        heightOffset = other:GetHeightOffset()
        baseScale = other:GetBaseScale()
        randomScale = other:GetRandomScale()
        randomTurn = other:HasRandomTurn()
        shadeVariation = other:GetShadeVariation()
        minimumSlope = other:GetMinimumSlope()
        maximumSlope = other:GetMaximumSlope()
        density = other:GetDensity()
        castsShadows = other:CastsShadows()
        drawDistance = other:GetDrawDistance()
        integer level = 1
        repeat while level <= MAXIMUM_LEVELS
            levelModelPaths:Set(level, other:GetLevelModelPath(level))
            levelCardPicturePaths:Set(level, other:GetLevelCardPicturePath(level))
            levelDistances:Set(level, other:GetLevelDistance(level))
            level = level + 1
        end
        wind = other:GetWind()
        windDirection = other:GetWindDirection()
        lastShadowLevel = other:GetLastShadowLevel()
        shadowLevel = other:GetShadowLevel()
        alignToNormal = other:IsAlignedToNormal()
        fixedTilt = other:GetFixedTilt()
        randomTilt = other:GetRandomTilt()
        fixedTurn = other:GetFixedTurn()
        tintRed = other:GetTintRed()
        tintGreen = other:GetTintGreen()
        tintBlue = other:GetTintBlue()
        randomHue = other:GetRandomHue()
        fadeMargin = other:GetFadeMargin()
    end

    /*
    This action writes the asset as one entry of a foliage list file.

    Attribute: Returns The entry.
    */
    action ToJavaScriptObjectNotation returns JavaScriptObjectNotation
        JavaScriptObjectNotation json
        json:Add("Name", name)
        if modelPath not= ""
            json:Add("Model", modelPath)
        else
            json:Add("Card Picture", cardPicturePath)
            json:Add("Card Planes", cardPlanes)
        end
        json:Add("Height Offset", heightOffset)
        json:Add("Scale", baseScale)
        json:Add("Random Scale", randomScale)
        json:Add("Random Turn", randomTurn)
        json:Add("Shade Variation", shadeVariation)
        json:Add("Minimum Slope", minimumSlope)
        json:Add("Maximum Slope", maximumSlope)
        json:Add("Density", density)
        json:Add("Casts Shadows", castsShadows)
        json:Add("Draw Distance", drawDistance)
        // Levels of detail and wind (Foliage plan F6), written only when
        // used, so older files and readers are unaffected.
        integer level = 1
        repeat while level <= MAXIMUM_LEVELS
            if HasLevel(level)
                text prefix = "Level " + level + " "
                if levelModelPaths:Get(level) not= ""
                    json:Add(prefix + "Model", levelModelPaths:Get(level))
                else
                    json:Add(prefix + "Card Picture", levelCardPicturePaths:Get(level))
                end
                json:Add(prefix + "Distance", levelDistances:Get(level))
            end
            level = level + 1
        end
        if wind not= 0
            json:Add("Wind", wind)
        end
        if windDirection not= 0
            json:Add("Wind Direction", windDirection)
        end
        // Shadow levels, placement and fading (Dense grass plan DG3, DG4,
        // DG6), written only when not the defaults, so older files and
        // readers are unaffected.
        if lastShadowLevel not= MAXIMUM_LEVELS
            json:Add("Last Shadow Level", lastShadowLevel)
        end
        if shadowLevel not= 0
            json:Add("Shadow Level", shadowLevel)
        end
        if alignToNormal
            json:Add("Align To Normal", true)
        end
        if fixedTilt not= 0
            json:Add("Tilt", fixedTilt)
        end
        if randomTilt not= 0
            json:Add("Random Tilt", randomTilt)
        end
        if fixedTurn not= 0
            json:Add("Turn", fixedTurn)
        end
        if IsTinted()
            json:Add("Tint Red", tintRed)
            json:Add("Tint Green", tintGreen)
            json:Add("Tint Blue", tintBlue)
        end
        if randomHue not= 0
            json:Add("Random Hue", randomHue)
        end
        if fadeMargin not= 0
            json:Add("Fade Margin", fadeMargin)
        end
        return json
    end

    /*
    This action reads the asset from one entry of a foliage list file.
    Values the entry doesn't have keep their defaults.

    Attribute: Parameter json The entry.
    */
    action FromJavaScriptObjectNotation(JavaScriptObjectNotation json)
        if json:HasValue("Name")
            name = json:GetValue("Name")
        end
        if json:HasValue("Model")
            modelPath = json:GetValue("Model")
        end
        if json:HasValue("Card Picture")
            cardPicturePath = json:GetValue("Card Picture")
        end
        if HasNumber(json, "Card Planes")
            cardPlanes = cast(integer, ReadNumber(json, "Card Planes"))
        end
        if HasNumber(json, "Height Offset")
            heightOffset = ReadNumber(json, "Height Offset")
        end
        if HasNumber(json, "Scale")
            baseScale = ReadNumber(json, "Scale")
        end
        if HasNumber(json, "Random Scale")
            randomScale = ReadNumber(json, "Random Scale")
        end
        if HasBoolean(json, "Random Turn")
            randomTurn = json:GetBoolean("Random Turn")
        end
        if HasNumber(json, "Shade Variation")
            shadeVariation = ReadNumber(json, "Shade Variation")
        end
        if HasNumber(json, "Minimum Slope")
            minimumSlope = ReadNumber(json, "Minimum Slope")
        end
        if HasNumber(json, "Maximum Slope")
            maximumSlope = ReadNumber(json, "Maximum Slope")
        end
        if HasNumber(json, "Density")
            density = ReadNumber(json, "Density")
        end
        if HasBoolean(json, "Casts Shadows")
            castsShadows = json:GetBoolean("Casts Shadows")
        end
        if HasNumber(json, "Draw Distance")
            drawDistance = ReadNumber(json, "Draw Distance")
        end
        // Levels of detail and wind (Foliage plan F6); files without them
        // have none.
        integer level = 1
        repeat while level <= MAXIMUM_LEVELS
            text prefix = "Level " + level + " "
            levelModelPaths:Set(level, "")
            levelCardPicturePaths:Set(level, "")
            levelDistances:Set(level, 0)
            if json:HasValue(prefix + "Model")
                levelModelPaths:Set(level, json:GetValue(prefix + "Model"))
            elseif json:HasValue(prefix + "Card Picture")
                levelCardPicturePaths:Set(level, json:GetValue(prefix + "Card Picture"))
            end
            if HasNumber(json, prefix + "Distance")
                levelDistances:Set(level, ReadNumber(json, prefix + "Distance"))
            end
            level = level + 1
        end
        if HasNumber(json, "Wind")
            wind = ReadNumber(json, "Wind")
        end
        if HasNumber(json, "Wind Direction")
            windDirection = ReadNumber(json, "Wind Direction")
        end
        // Dense grass plan DG3, DG4 and DG6; files without them keep the
        // defaults.
        if HasNumber(json, "Last Shadow Level")
            lastShadowLevel = cast(integer, ReadNumber(json, "Last Shadow Level"))
        end
        if HasNumber(json, "Shadow Level")
            shadowLevel = cast(integer, ReadNumber(json, "Shadow Level"))
        end
        if HasBoolean(json, "Align To Normal")
            alignToNormal = json:GetBoolean("Align To Normal")
        end
        if HasNumber(json, "Tilt")
            fixedTilt = ReadNumber(json, "Tilt")
        end
        if HasNumber(json, "Random Tilt")
            randomTilt = ReadNumber(json, "Random Tilt")
        end
        if HasNumber(json, "Turn")
            fixedTurn = ReadNumber(json, "Turn")
        end
        if HasNumber(json, "Tint Red")
            tintRed = ReadNumber(json, "Tint Red")
        end
        if HasNumber(json, "Tint Green")
            tintGreen = ReadNumber(json, "Tint Green")
        end
        if HasNumber(json, "Tint Blue")
            tintBlue = ReadNumber(json, "Tint Blue")
        end
        if HasNumber(json, "Random Hue")
            randomHue = ReadNumber(json, "Random Hue")
        end
        if HasNumber(json, "Fade Margin")
            fadeMargin = ReadNumber(json, "Fade Margin")
        end
    end

    /*
    This action returns true if an entry has a number under a key, written
    as a whole number or with a decimal point.
    */
    private action HasNumber(JavaScriptObjectNotation json, text key) returns boolean
        Iterator<JavaScriptObjectNotation> children = json:GetIterator()
        repeat while children:HasNext()
            JavaScriptObjectNotation child = children:Next()
            if child:GetKey() = key and (child:IsInteger() or child:IsNumber())
                return true
            end
        end
        return false
    end

    /*
    This action returns a number from an entry, whether it was written as a
    whole number or with a decimal point.
    */
    private action ReadNumber(JavaScriptObjectNotation json, text key) returns number
        Iterator<JavaScriptObjectNotation> children = json:GetIterator()
        repeat while children:HasNext()
            JavaScriptObjectNotation child = children:Next()
            if child:GetKey() = key
                if child:IsInteger()
                    return child:GetInteger()
                elseif child:IsNumber()
                    return child:GetNumber()
                end
            end
        end
        return 0
    end

    /*
    This action returns true if an entry has a true or false under a key.
    */
    private action HasBoolean(JavaScriptObjectNotation json, text key) returns boolean
        Iterator<JavaScriptObjectNotation> children = json:GetIterator()
        repeat while children:HasNext()
            JavaScriptObjectNotation child = children:Next()
            if child:GetKey() = key and child:IsBoolean()
                return true
            end
        end
        return false
    end
end
