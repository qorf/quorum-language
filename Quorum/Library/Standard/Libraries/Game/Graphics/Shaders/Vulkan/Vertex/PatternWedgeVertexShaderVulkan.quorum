package Libraries.Game.Graphics.Shaders.Vulkan.Vertex

class PatternWedgeVertexShaderVulkan is WedgeVertexShaderVulkan

    constant text SHADER_NAME = "Pattern Wedge Vertex Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraInputs returns text
        return 
"layout(location = 11) in float a_aspectRatio;
layout(location = 12) in float a_patternDistance;
layout(location = 13) in float a_patternRotation;
layout(location = 14) in float a_patternThickness;
layout(location = 15) in vec4 a_patternColor;
layout(location = 10) out float v_aspectRatio;
layout(location = 11) out float v_patternDistance;
layout(location = 12) out float v_patternRotation;
layout(location = 13) out float v_patternThickness;
layout(location = 14) out vec4 v_patternColor;"
    end

    private action GetAppendedCode returns text
        return 
"v_aspectRatio = a_aspectRatio;
v_patternDistance = a_patternDistance;
v_patternRotation = a_patternRotation;
v_patternThickness = a_patternThickness;
v_patternColor = a_patternColor;"
    end

end