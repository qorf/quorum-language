package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

use Libraries.Game.Graphics.Shaders.Shader

/*
BloomUpFragmentShaderVulkan makes one step up the bloom chain (Lighting plan
L3): the step down of the same size, plus the smaller step above it, blurred
up with a 3 by 3 tent filter. The last step up is the bloom the result copy
adds to the light.

Its push constants (16 bytes): the smaller image's texel size, how far the
tent reaches (1 is one texel), and a spare.

Attribute: Example
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.BloomUpFragmentShaderVulkan

BloomUpFragmentShaderVulkan shader
*/
class BloomUpFragmentShaderVulkan is Shader

    public constant text DEFAULT_NAME = "Bloom Up Fragment Shader"

    on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        SetName(DEFAULT_NAME)

        SetCode(GetVersionHeader() + "

layout (location = 0) in vec2 v_samplerCoordinate;

layout (location = 0) out vec4 outputColor;

// The step down of this size, and the smaller step to blur up.
layout (set = 0, binding = 0) uniform sampler2D current;
layout (set = 0, binding = 1) uniform sampler2D smaller;

layout(push_constant) uniform BloomUp {
	vec2 texelSize;
	float radius;
	float spare;
} bloom;

void main()
{
	vec2 offset = bloom.texelSize * bloom.radius;
	vec2 uv = v_samplerCoordinate;
	// The tent: 1 2 1, 2 4 2, 1 2 1, over 16.
	vec3 sum = texture(smaller, uv).rgb * 4.0;
	sum += texture(smaller, uv + vec2(-offset.x, 0.0)).rgb * 2.0;
	sum += texture(smaller, uv + vec2(offset.x, 0.0)).rgb * 2.0;
	sum += texture(smaller, uv + vec2(0.0, -offset.y)).rgb * 2.0;
	sum += texture(smaller, uv + vec2(0.0, offset.y)).rgb * 2.0;
	sum += texture(smaller, uv + vec2(-offset.x, -offset.y)).rgb;
	sum += texture(smaller, uv + vec2(offset.x, -offset.y)).rgb;
	sum += texture(smaller, uv + vec2(-offset.x, offset.y)).rgb;
	sum += texture(smaller, uv + vec2(offset.x, offset.y)).rgb;
	vec3 color = texture(current, uv).rgb + sum / 16.0;
	outputColor = vec4(color, 1.0);
}
")
    end
end
