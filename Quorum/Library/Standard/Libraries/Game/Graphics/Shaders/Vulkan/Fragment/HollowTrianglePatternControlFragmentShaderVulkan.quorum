package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

class HollowTrianglePatternControlFragmentShaderVulkan is ControlFragmentShaderVulkan, HollowTrianglePatternFragmentShaderPartVulkan

    constant text SHADER_NAME = "Hollow Triangle Pattern Control Fragment Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraFunctions returns text
        return parent:HollowTrianglePatternFragmentShaderPartVulkan:GetExtraFunctions()
    end

    private action GetExtraInputs returns text
        return parent:HollowTrianglePatternFragmentShaderPartVulkan:GetExtraInputs()
    end

    private action GetAppendedCode returns text
        return parent:HollowTrianglePatternFragmentShaderPartVulkan:GetAppendedCode()
    end
    
action GetBaseInputs returns integer
        return parent:ControlFragmentShaderVulkan:GetBaseInputs()
    end

end