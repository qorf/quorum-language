package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

class HollowCirclePatternControlFragmentShaderVulkan is ControlFragmentShaderVulkan, HollowCirclePatternFragmentShaderPartVulkan

    constant text SHADER_NAME = "Hollow Circle Pattern Control Fragment Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraFunctions returns text
        return parent:HollowCirclePatternFragmentShaderPartVulkan:GetExtraFunctions()
    end

    private action GetExtraInputs returns text
        return parent:HollowCirclePatternFragmentShaderPartVulkan:GetExtraInputs()
    end

    private action GetAppendedCode returns text
        return parent:HollowCirclePatternFragmentShaderPartVulkan:GetAppendedCode()
    end
    
action GetBaseInputs returns integer
        return parent:ControlFragmentShaderVulkan:GetBaseInputs()
    end

end