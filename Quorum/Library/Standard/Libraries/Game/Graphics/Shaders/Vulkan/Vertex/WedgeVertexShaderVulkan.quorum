package Libraries.Game.Graphics.Shaders.Vulkan.Vertex

use Libraries.Game.Graphics.Shaders.DefaultAttributeNames
use Libraries.Game.Graphics.Shaders.Shader

class WedgeVertexShaderVulkan is Shader
constant text SHADER_NAME = "Wedge Vertex Shader"

    on create
        SetType(parent:Shader:VERTEX_SHADER)
        SetName(SHADER_NAME)

        DefaultAttributeNames attributes
        SetCode(GetVersionHeader() +
"
" + GetPreprocessorDefinitions() + "

layout(location = 0) in vec4 " + attributes:POSITION + ";
layout(location = 1) in vec4 " + attributes:COLOR + ";
layout(location = 2) in vec2 " + attributes:TEXTURE_COORDINATES + "0;
layout(location = 3) in uint a_textureIndex;
layout(location = 4) in float a_innerRadius;
layout(location = 5) in float a_outerRadius;
layout(location = 6) in float a_minAngle;
layout(location = 7) in float a_maxAngle;
layout(location = 8) in vec2 a_originPoint;
layout(location = 9) in float a_crustThickness;
layout(location = 10) in vec4 a_crustColor;

layout(location = 0) out vec4 v_color;
layout(location = 1) out vec2 v_textureCoords;
layout(location = 2) flat out uint v_textureIndex;
layout(location = 3) out float v_innerRadius;
layout(location = 4) out float v_outerRadius;
layout(location = 5) out float v_minAngle;
layout(location = 6) out float v_maxAngle;
layout(location = 7) out vec2 v_originPoint;
layout(location = 8) out float v_crustThickness;
layout(location = 9) out vec4 v_crustColor;

layout(set = 0, binding = 0) uniform Camera
{
    mat4 projectionViewMatrix;
} camera;

" + GetExtraInputs() + "

" + GetExtraFunctions() + "

void main()
{
    v_color = " + attributes:COLOR + ";
    v_textureCoords = " + attributes:TEXTURE_COORDINATES + "0;
    v_textureIndex = a_textureIndex;
    v_innerRadius = a_innerRadius;
    v_outerRadius = a_outerRadius;
    v_minAngle = a_minAngle;
    v_maxAngle = a_maxAngle;
    v_originPoint = a_originPoint;
    v_crustThickness = a_crustThickness;
    v_crustColor = a_crustColor;

    " + GetAppendedCode() + "

    gl_Position =  camera.projectionViewMatrix * " + attributes:POSITION + ";
}"
)
    end

    private action GetPreprocessorDefinitions returns text
        return ""
    end

    private action GetExtraInputs returns text
        return ""
    end

    private action GetExtraFunctions returns text
        return ""
    end

    private action GetAppendedCode returns text
        return ""
    end
    
end