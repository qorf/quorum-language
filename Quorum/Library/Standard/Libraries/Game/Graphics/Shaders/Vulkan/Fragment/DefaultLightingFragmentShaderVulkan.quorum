package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Vulkan.VulkanLightingProperties

class DefaultLightingFragmentShaderVulkan is Shader
    
    on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName(manager:DEFAULT_LIGHTING_FRAGMENT_SHADER)
		
		VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
		VulkanLightingProperties lights = graphics:GetLightingProperties()
        
        SetCode(GetVersionHeader() + "
// Adds support for nonuniformEXT and unsized descriptor arrays.
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout: require

#define SHADOW_MAP_CASCADE_COUNT " + lights:GetShadowMapCascadeCount() + "
#define MAXIMUM_LIGHTS " + lights:GetMaximumLights() + "

const float PI = 3.14159265359;

layout (location = 0) in vec2 v_samplerCoordinate;

layout (location = 0) out vec4 outputColor;

// Attachments calculated during geometry render pass
layout (set = 0, binding = 0) uniform sampler2D positionSampler;
layout (set = 0, binding = 1) uniform sampler2D albedoSampler;
layout (set = 0, binding = 2) uniform sampler2D normalsSampler;
layout (set = 0, binding = 3) uniform sampler2D pbrSampler;
// The light surfaces give off.
layout (set = 0, binding = 4) uniform sampler2D emissiveSampler;
layout (set = 2, binding = 1) uniform sampler2DArray shadowSamplers[];
// The light from the sky: the sky's own cube, then four
// smaller, blurrier ones (64, 32, 16 and 8 pixels a side).
layout (set = 3, binding = 0) uniform samplerCube skyLightCube0;
layout (set = 3, binding = 1) uniform samplerCube skyLightCube1;
layout (set = 3, binding = 2) uniform samplerCube skyLightCube2;
layout (set = 3, binding = 3) uniform samplerCube skyLightCube3;
layout (set = 3, binding = 4) uniform samplerCube skyLightCube4;

struct Light
{
	// A point light's or spotlight's position, or a directional light's direction
	vec3 positionDirection;
	// 0 point, 1 directional, 2 spot
	uint lightType;
	float intensity;
	vec3 color;
	// A spotlight's direction, in world space
	vec3 spotDirection;
	// Where a point light or spotlight fades to nothing
	float range;
	float cosInner;
	float cosOuter;
	float spare;
	// 1 if the light casts shadows, 0 if not.
	uint castsShadows;
};

struct CascadeShadow
{
	mat4 matrix[6];
	vec4 splitDistance;
};

layout(scalar, set = 1, binding = 0) readonly buffer Lights
{
	Light array[];
} lights;

layout(scalar, set = 1, binding = 1) uniform SceneInfo
{
	vec3 cameraPosition;
	float ambientIntensity;
	vec3 ambientColor;
	uint lightsCount;
	mat4 cameraViewMatrix;
	// Distance fog. An amount of 0 is no fog.
	vec3 fogColor;
	float fogStart;
	float fogEnd;
	float fogAmount;
	float fogBaseHeight;
	float fogHeightFalloff;
	// The light from the sky: strength (0 for none),
	// whether there are reflections, and 1 if lighting is linear; its tint; the sky's rotation as three columns; nine
	// diffuse light coefficients (rgb).
	vec4 skyLight;
	vec4 skyTint;
	vec4 skyRotation[3];
	vec4 skyIrradiance[9];
} sceneInfo;

layout(set = 2, binding = 0) uniform CascadeShadows
{
	CascadeShadow data[SHADOW_MAP_CASCADE_COUNT * MAXIMUM_LIGHTS];
} shadows;

//float chebyshevUpperBound(vec2 moments, float t) {
float chebyshevUpperBound(vec2 moments, float t) {
    // Surface is fully lit if the current fragment is before the light occluder
    if (t <= moments.x)
		return 1.0;

    // Compute variance
    float variance = moments.y - (moments.x * moments.x);
	variance = max(variance, 0.00002); // Small epsilon to avoid divide by zero

    // Compute probabilistic upper bound
    float d = t - moments.x;
    float p_max = variance / (variance + d * d);

    // Reduce light bleeding
    p_max = smoothstep(0.2, 1.0, p_max);

    return p_max;
}

/*
float calcVisibility(vec4 worldPosition, uint shadowIndex, uint matrixIndex) {
    //vec4 shadowMapPosition = shadows.cascadeshadows[cascadeIndex].projViewMatrix * worldPosition;
	vec4 shadowMapPosition = shadows.data[shadowIndex].matrix[matrixIndex] * worldPosition;

    vec2 uv = vec2(shadowMapPosition.x * 0.5 + 0.5, (-shadowMapPosition.y) * 0.5 + 0.5);
    float depth = shadowMapPosition.z;
    vec2 moments = texture(shadowSampler, vec4(uv, matrixIndex, shadowIndex)).rg;

    float visibility = chebyshevUpperBound(moments, depth);
    return visibility;
}
*/

float calculateDirectionalVisibility(vec4 worldPosition, uint lightIndex, uint cascadeIndex) 
{
	vec4 shadowMapPosition = shadows.data[lightIndex * SHADOW_MAP_CASCADE_COUNT + cascadeIndex].matrix[0] * worldPosition;
	vec3 shadowMapXYZ = shadowMapPosition.xyz / shadowMapPosition.w;

	vec2 uv = vec2(shadowMapXYZ.x * 0.5 + 0.5, (-shadowMapXYZ.y) * 0.5 + 0.5);
    float depth = shadowMapXYZ.z;
	
	// A directional light's map has one layer per cascade.
	vec2 moments = texture(nonuniformEXT(shadowSamplers[lightIndex]), vec3(uv, cascadeIndex)).rg;

	float visibility = chebyshevUpperBound(moments, depth);
    return visibility;
}

// A spotlight's map is one perspective view per cascade. Outside the view there is no map, and the
// cone gives no light there.
float calculateSpotVisibility(vec4 worldPosition, uint lightIndex, uint cascadeIndex)
{
	vec4 shadowMapPosition = shadows.data[lightIndex * SHADOW_MAP_CASCADE_COUNT + cascadeIndex].matrix[0] * worldPosition;
	if (shadowMapPosition.w <= 0.0001)
		return 1.0;
	vec3 shadowMapXYZ = shadowMapPosition.xyz / shadowMapPosition.w;
	vec2 uv = vec2(shadowMapXYZ.x * 0.5 + 0.5, (-shadowMapXYZ.y) * 0.5 + 0.5);
	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
		return 1.0;
	vec2 moments = textureLod(nonuniformEXT(shadowSamplers[lightIndex]), vec3(uv, cascadeIndex), 0.0).rg;
	return chebyshevUpperBound(moments, shadowMapXYZ.z);
}

float calculatePointVisibility(vec4 worldPosition, vec3 lightPosition, uint lightIndex, uint cascadeIndex) 
{
	vec3 direction = worldPosition.rgb - lightPosition;
	vec3 absDirection = abs(direction);
	
	// Determine which component is the largest
    // 1.0 if true, 0.0 if false
    float isX = float(absDirection.x >= absDirection.y && absDirection.x >= absDirection.z);
    float isY = float(absDirection.y >= absDirection.z) * (1.0 - isX);
    float isZ = 1.0 - isX - isY;

	// Find the sign of the dominant component (1.0 for positive, 0.0 for negative)
    // We sample the chosen component using dot products
    float dominantSign = step(0.0, dot(direction, vec3(isX, isY, isZ)));
	
	// Map to a face of the cubemap.
    // 0: Positive X, 1: Negative X, 2: Positive Y, 3: Negative Y, 4: Positive Z, 5: Negative Z 
    uint axisOffset = uint(isY * 2.0 + isZ * 4.0);
    uint signOffset = uint(1.0 - dominantSign); // Dominant sign is 0 if negative, or 1 if positive
	uint targetFace = axisOffset + signOffset;

	CascadeShadow shadow = shadows.data[lightIndex * SHADOW_MAP_CASCADE_COUNT + cascadeIndex];
	vec4 shadowMapPosition = shadow.matrix[targetFace] * worldPosition;
	vec3 shadowMapXYZ = shadowMapPosition.xyz / shadowMapPosition.w;

	vec2 uv = vec2(shadowMapXYZ.x * 0.5 + 0.5, (-shadowMapXYZ.y) * 0.5 + 0.5);
	// The map holds the distance from the light over its far distance,
	// kept in the split distance's first word. Past it,
	// nothing casts a shadow, so the point is lit.
	float farDistance = max(shadow.splitDistance.x, 0.0001);
	float depth = length(direction) / farDistance;
	if (depth >= 1.0)
		return 1.0;
	
	vec2 moments = texture(nonuniformEXT(shadowSamplers[lightIndex]), vec3(uv, 6 * cascadeIndex + targetFace)).rg;

	float visibility = chebyshevUpperBound(moments, depth);
    return visibility;
}

float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float nom = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return nom / denom;
}

float geometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0;

    float nom = NdotV;
    float denom = NdotV * (1.0 - k) + k;

    return nom / denom;
}

float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = geometrySchlickGGX(NdotV, roughness);
    float ggx1 = geometrySchlickGGX(NdotL, roughness);

    return ggx1 * ggx2;
}

// A color as stored in a picture (sRGB) turned into linear light. With
// linear lighting, the G-buffer's colors already
// are; the sky's cubes are turned here. Without it, only a metal's
// reflection color is turned, as before: used as stored, a dark bronze
// (0.32, 0.26, 0.19) reflects like a pale, bright gray.
vec3 linearFromPicture(vec3 color)
{
	vec3 c = clamp(color, 0.0, 1.0);
	vec3 low = c / 12.92;
	vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
	return mix(high, low, vec3(lessThanEqual(c, vec3(0.04045))));
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// The light a surface reflects toward the eye from one light, given the
// direction to the light and the light's strength there (Cook-Torrance).
vec3 lightContribution(vec3 L, vec3 radiance, vec3 V, vec3 N, vec3 F0, vec3 albedo, float metallic, float roughness) {
    vec3 H = normalize(V + L);

    float NDF = distributionGGX(N, H, roughness);
    float G = geometrySmith(N, V, L, roughness);
    vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
    vec3 specular = numerator / denominator;

    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= 1.0 - metallic;

    float NdotL = max(dot(N, L), 0.0);
    return (kD * albedo / PI + specular) * radiance * NdotL;
}

// How much of a light's strength reaches a distance: the inverse square,
// faded smoothly to nothing at the light's range.
float rangeAttenuation(float distance, float range) {
    float inverseSquare = 1.0 / max(distance * distance, 0.0001);
    if (range <= 0.0) {
        return inverseSquare;
    }
    float ratio = distance / range;
    float window = clamp(1.0 - ratio * ratio * ratio * ratio, 0.0, 1.0);
    return inverseSquare * window * window;
}

vec3 calculatePointLight(Light light, vec3 worldPos, vec3 V, vec3 N, vec3 F0, vec3 albedo, float metallic, float roughness) {
    vec3 toLight = light.positionDirection - worldPos;
    float distance = length(toLight);
    // The direction to the light (an earlier version subtracted worldPos twice).
    vec3 L = toLight / max(distance, 0.0001);
    vec3 radiance = light.color * light.intensity * rangeAttenuation(distance, light.range);
    return lightContribution(L, radiance, V, N, F0, albedo, metallic, roughness);
}

vec3 calculateSpotLight(Light light, vec3 worldPos, vec3 V, vec3 N, vec3 F0, vec3 albedo, float metallic, float roughness) {
    vec3 toLight = light.positionDirection - worldPos;
    float distance = length(toLight);
    vec3 L = toLight / max(distance, 0.0001);

    // Full strength inside the inner angle, fading to nothing at the outer.
    float cosAngle = dot(-L, light.spotDirection);
    float cone = clamp((cosAngle - light.cosOuter) / max(light.cosInner - light.cosOuter, 0.0001), 0.0, 1.0);
    if (cone <= 0.0) {
        return vec3(0.0);
    }
    cone = cone * cone;

    vec3 radiance = light.color * light.intensity * rangeAttenuation(distance, light.range) * cone;
    return lightContribution(L, radiance, V, N, F0, albedo, metallic, roughness);
}

vec3 calculateDirectionalLight(Light light, vec3 V, vec3 N, vec3 F0, vec3 albedo, float metallic, float roughness) {
    vec3 L = normalize(-light.positionDirection);
    vec3 radiance = light.color * light.intensity;
    return lightContribution(L, radiance, V, N, F0, albedo, metallic, roughness);
}

// A direction turned into the sky cube's own directions, as the skybox is
// drawn.
vec3 skyTurn(vec3 direction)
{
	return vec3(dot(direction, sceneInfo.skyRotation[0].xyz), dot(direction, sceneInfo.skyRotation[1].xyz), dot(direction, sceneInfo.skyRotation[2].xyz));
}

// The sky's diffuse light reaching a surface facing a direction, divided by
// pi: the nine spherical harmonics.
vec3 skyIrradiance(vec3 normal)
{
	vec3 d = skyTurn(normal);
	vec3 light = sceneInfo.skyIrradiance[0].rgb * 0.282095
		+ sceneInfo.skyIrradiance[1].rgb * (0.488603 * d.y)
		+ sceneInfo.skyIrradiance[2].rgb * (0.488603 * d.z)
		+ sceneInfo.skyIrradiance[3].rgb * (0.488603 * d.x)
		+ sceneInfo.skyIrradiance[4].rgb * (1.092548 * d.x * d.y)
		+ sceneInfo.skyIrradiance[5].rgb * (1.092548 * d.y * d.z)
		+ sceneInfo.skyIrradiance[6].rgb * (0.315392 * (3.0 * d.z * d.z - 1.0))
		+ sceneInfo.skyIrradiance[7].rgb * (1.092548 * d.x * d.z)
		+ sceneInfo.skyIrradiance[8].rgb * (0.546274 * (d.x * d.x - d.y * d.y));
	return max(light, vec3(0.0));
}

// One of the sky light's cubes: 0 is the sky itself, 4 the blurriest.
vec3 skyCubeColor(int level, vec3 direction)
{
	if (level <= 0)
		return textureLod(skyLightCube0, direction, 0.0).rgb;
	if (level == 1)
		return textureLod(skyLightCube1, direction, 0.0).rgb;
	if (level == 2)
		return textureLod(skyLightCube2, direction, 0.0).rgb;
	if (level == 3)
		return textureLod(skyLightCube3, direction, 0.0).rgb;
	return textureLod(skyLightCube4, direction, 0.0).rgb;
}

// A sky cube's color as light: turned from the picture's colors when
// lighting is linear.
vec3 skyCubeLevel(int level, vec3 direction)
{
	vec3 color = skyCubeColor(level, direction);
	if (sceneInfo.skyLight.z > 0.5)
		return linearFromPicture(color);
	return color;
}

// The sky seen along a reflection, blurrier for rougher surfaces: the two
// nearest cubes, mixed.
vec3 skyReflection(vec3 direction, float roughness)
{
	vec3 turned = skyTurn(direction);
	float level = clamp(roughness, 0.0, 1.0) * 4.0;
	float lower = floor(level);
	int first = int(lower);
	int second = min(first + 1, 4);
	return mix(skyCubeLevel(first, turned), skyCubeLevel(second, turned), level - lower);
}

// How much of the reflected light reaches the eye, for a surface's base
// reflectance, roughness and angle: Karis's fit for mobile, so no lookup
// image is needed.
vec3 environmentBRDF(vec3 F0, float roughness, float NdotV)
{
	const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
	const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
	vec4 r = roughness * c0 + c1;
	float a004 = min(r.x * r.x, exp2(-9.28 * NdotV)) * r.x + r.y;
	vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
	return F0 * AB.x + AB.y;
}

// The light from the sky on a surface: its diffuse light,
// less what the surface reflects, and the reflected sky.
vec3 skyLighting(vec3 N, vec3 V, vec3 F0, vec3 albedo, float metallic, float roughness)
{
	float NdotV = clamp(dot(N, V), 0.0001, 1.0);
	vec3 F = F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(1.0 - NdotV, 5.0);
	vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
	vec3 diffuse = skyIrradiance(N) * albedo * kD;
	vec3 specular = vec3(0.0);
	if (sceneInfo.skyLight.y > 0.5)
	{
		vec3 R = reflect(-V, N);
		specular = skyReflection(R, roughness) * environmentBRDF(F0, roughness, NdotV);
	}
	// The tint (the ambient light's color) keeps the sky's soft diffuse
	// light near the old flat ambient light. Reflections aren't tinted: the
	// sky is drawn at full brightness, so it is reflected at full brightness
	// too, or metals, which show only reflections, turn nearly black.
	return diffuse * sceneInfo.skyTint.rgb + specular;
}

// Fades a color into the fog by its distance from the camera, and less
// above the fog's base height.
vec3 applyFog(vec3 color, vec3 worldPosition)
{
	if (sceneInfo.fogAmount <= 0.0)
		return color;
	float distance = length(worldPosition - sceneInfo.cameraPosition);
	float fog = smoothstep(sceneInfo.fogStart, sceneInfo.fogEnd, distance);
	if (sceneInfo.fogHeightFalloff > 0.0)
	{
		float above = max(worldPosition.y - sceneInfo.fogBaseHeight, 0.0);
		fog *= exp(-above * sceneInfo.fogHeightFalloff);
	}
	return mix(color, sceneInfo.fogColor, fog * sceneInfo.fogAmount);
}

void main()
{
	vec4 rawAlbedo = texture(albedoSampler, v_samplerCoordinate);
	vec3 albedo = rawAlbedo.rgb;
	vec3 normal = texture(normalsSampler, v_samplerCoordinate).rgb;
	vec4 rawWorldPosition = texture(positionSampler, v_samplerCoordinate);
	vec3 worldPosition = rawWorldPosition.xyz;
	vec3 pbr = texture(pbrSampler, v_samplerCoordinate).rgb;

	// With MSAA, an edge pixel's G-buffer values are averages of
	// its samples, and samples where nothing was drawn hold zeros. Geometry
	// writes a position w of 1, so w is the share of the pixel covered.
	// Dividing by it gives the model's own values back, so silhouettes
	// against the sky are lit correctly and have no dark halo. Without MSAA,
	// coverage is exactly 1 or 0, and nothing changes.
	float coverage = rawWorldPosition.w;
	// Where nothing was drawn, there is nothing to light (and no normal to
	// light it by), so it stays clear, as the blend left it before.
	if (coverage <= 0.0001)
	{
		outputColor = vec4(0.0);
		return;
	}
	float uncover = 1.0 / coverage;
	albedo = albedo * uncover;
	worldPosition = worldPosition * uncover;
	pbr = pbr * uncover;
	vec3 emissive = texture(emissiveSampler, v_samplerCoordinate).rgb * uncover;
	
	float roughness = pbr.g;
	float metallic = pbr.b;
	
	vec3 N = normalize(normal);
    vec3 V = normalize(sceneInfo.cameraPosition - worldPosition);

    vec3 F0 = vec3(0.04);
    // With linear lighting the albedo is already light; otherwise only the metal's reflection color is turned.
    if (sceneInfo.skyLight.z > 0.5)
        F0 = mix(F0, albedo, metallic);
    else
        F0 = mix(F0, linearFromPicture(albedo), metallic);

    vec3 Lo = vec3(0.0);
	
	vec4 viewPos = sceneInfo.cameraViewMatrix * vec4(worldPosition, 1.0);
	
    for (uint i = 0; i < sceneInfo.lightsCount; i++) {
        Light light = lights.array[i];
		uint cascadeIndex = 0;
		
        if (light.lightType == 1u)
		{
			for (uint j = 0; j < SHADOW_MAP_CASCADE_COUNT - 1; ++j)
			{
				CascadeShadow currentShadow = shadows.data[i * SHADOW_MAP_CASCADE_COUNT + j];
				if (viewPos.z > currentShadow.splitDistance.x)
				{
					cascadeIndex = j + 1;
				}
			}
		
			float shadow = 1.0;
			if (light.castsShadows != 0u)
				shadow = calculateDirectionalVisibility(vec4(worldPosition, 1.0), i, cascadeIndex);
            Lo += (calculateDirectionalLight(light, V, N, F0, albedo, metallic, roughness) * shadow);
        }
        else if (light.lightType == 2u)
		{
			// Spotlights' maps split the distance along the spot's direction
			// into cascades.
			float along = dot(worldPosition - light.positionDirection, light.spotDirection);
			for (uint j = 0; j < SHADOW_MAP_CASCADE_COUNT - 1; ++j)
			{
				CascadeShadow currentShadow = shadows.data[i * SHADOW_MAP_CASCADE_COUNT + j];
				if (along > currentShadow.splitDistance.x)
				{
					cascadeIndex = j + 1;
				}
			}
			float shadow = 1.0;
			if (light.castsShadows != 0u)
				shadow = calculateSpotVisibility(vec4(worldPosition, 1.0), i, cascadeIndex);
            Lo += calculateSpotLight(light, worldPosition, V, N, F0, albedo, metallic, roughness) * shadow;
		}
		else
		{
			// A point light has one view per face, its first cascade's.
			float shadow = 1.0;
			if (light.castsShadows != 0u)
				shadow = calculatePointVisibility(vec4(worldPosition, 1.0), light.positionDirection, i, 0u);
            Lo += (calculatePointLight(light, worldPosition, V, N, F0, albedo, metallic, roughness) * shadow);
        }
    }
    // The PBR image's first channel is ambient occlusion (1 for none), so
    // cracks and hollows get less ambient light. Direct light is unchanged.
    vec3 ambient = sceneInfo.ambientColor * albedo * sceneInfo.ambientIntensity * pbr.r;
    // The light from the sky takes the flat ambient
    // light's place as its strength grows to 1. At 0 nothing changes.
    float skyStrength = sceneInfo.skyLight.x;
    if (skyStrength > 0.0)
    {
        vec3 sky = skyLighting(N, V, F0, albedo, metallic, roughness) * skyStrength;
        ambient = (ambient * (1.0 - min(skyStrength, 1.0)) + sky * pbr.r);
    }
    // Emissive light isn't lit or shadowed; it is added as it is.
    vec3 color = ambient + Lo + emissive;
    color = applyFog(color, worldPosition);

	outputColor = vec4(color.rgb, rawAlbedo.a);
}
")
    end
    
end