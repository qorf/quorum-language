package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Vulkan.VulkanLightingProperties

class DefaultShadowFragmentShaderVulkan is Shader
    on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName(manager:DEFAULT_SHADOW_FRAGMENT_SHADER)
        
		VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
		VulkanLightingProperties lights = graphics:GetLightingProperties()
		
        SetCode(GetVersionHeader() + "
		
		// Adds support for nonuniformEXT and unsized descriptor arrays.
		#extension GL_EXT_nonuniform_qualifier : require
		#extension GL_EXT_buffer_reference: require
		#extension GL_EXT_buffer_reference2: enable
		#extension GL_EXT_scalar_block_layout: require
		
		#define SHADOW_MAP_CASCADE_COUNT " + lights:GetShadowMapCascadeCount() + "
		#define MAXIMUM_LIGHTS " + lights:GetMaximumLights() + "
		
		layout (location = 0) in vec2 v_textureCoordinates;
		layout (location = 1) in flat uint v_entityID;
		layout (location = 2) in flat uint v_cascadeIndex;
		layout (location = 3) in vec4 v_worldPosition;
		
		struct CascadeShadow
		{
			// All lights will need to render to cubemaps, and each face has its own projection matrix.
			mat4 matrix[6];
			vec4 splitDistance;
		};
		
		layout(set = 0, binding = 0) uniform CascadeShadows
		{
			CascadeShadow data[SHADOW_MAP_CASCADE_COUNT * MAXIMUM_LIGHTS];
		} shadows;
		
		layout(set = 0, binding = 1) uniform sampler immutableSampler;
		//layout(set = 0, binding = 0) uniform sampler immutableSampler;
		layout(set = 1, binding = 0) uniform texture2D globalTextures[];
		
		layout (location = 0) out vec2 outputMoments;
		
		struct Material {
			uint diffuseColor;
			uint textureIndex;
			uint hasNormalMap;
			uint hasRoughMap;
			uint normalMapIndex;
			uint roughMapIndex;
			float roughness;
			float metallic;
		};
		
		layout(scalar, buffer_reference) buffer Materials
		{
			Material data;
		};
		
		struct InstanceData {
		   uint vertexPadding1;
		   uint vertexPadding2;
		   uint indexPadding1;
		   uint indexPadding2;
		   Materials materials;
		   uint textureOverride;
		   uint textureIndex;
		   uint diffuseColorOverride;
		   uint diffuseColor;
		   mat4 modelTransform;
		};

		layout(scalar, buffer_reference) buffer Instances {
		   InstanceData[] data;
		};

		layout(push_constant) uniform PushConstants {
		   Instances instances;
		   uint isPointLight;
		   uint lightIndex;
		} pushConstants;
		
		void main()
		{
			// Calculate albedo so we can get the alpha -- we need to know the opacity to know if this element casts shadows.
		    Instances instances = pushConstants.instances;
		    InstanceData instanceData = instances.data[v_entityID];
		    Materials materials = instanceData.materials;
		    Material material = materials.data;

			uint hasTextureOverride = instanceData.textureOverride;
			uint hasDiffuseOverride = instanceData.diffuseColorOverride;

		    uint textureIndex = material.textureIndex;
			if (hasTextureOverride == 1)
				textureIndex = instanceData.textureIndex;
				
			vec4 diffuse = unpackUnorm4x8(material.diffuseColor);
			if (hasDiffuseOverride == 1)
				diffuse = unpackUnorm4x8(instanceData.diffuseColor);

			vec4 sampledColor = texture(nonuniformEXT(sampler2D(globalTextures[textureIndex], immutableSampler)), v_textureCoordinates) * diffuse;

			// If the color is mostly transparent, discard the fragment.
			if (sampledColor.a < 0.5)
			{
				discard;
			}
			
			uint lightIndex = pushConstants.lightIndex;
			vec4 shadowPosition = shadows.data[lightIndex * SHADOW_MAP_CASCADE_COUNT + v_cascadeIndex].matrix[0] * v_worldPosition;
			
			float depth = gl_FragCoord.z;
			float moment1 = depth;
			float moment2 = depth * depth;
			
			// Adjust moments to avoid light bleeding
			float dx = dFdx(depth);
			float dy = dFdy(depth);
			moment2 += 0.25 * (dx * dx + dy * dy);

			outputMoments = vec2(moment1, moment2);
		}
		
		")
	end
end