package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

class LinePatternControlFragmentShaderVulkan is ControlFragmentShaderVulkan, LinePatternFragmentShaderPartVulkan

    constant text SHADER_NAME = "Line Pattern Control Fragment Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraFunctions returns text
        return parent:LinePatternFragmentShaderPartVulkan:GetExtraFunctions()
    end

    private action GetExtraInputs returns text
        return parent:LinePatternFragmentShaderPartVulkan:GetExtraInputs()
    end

    private action GetAppendedCode returns text
        return parent:LinePatternFragmentShaderPartVulkan:GetAppendedCode()
    end
    
action GetBaseInputs returns integer
        return parent:ControlFragmentShaderVulkan:GetBaseInputs()
    end

end