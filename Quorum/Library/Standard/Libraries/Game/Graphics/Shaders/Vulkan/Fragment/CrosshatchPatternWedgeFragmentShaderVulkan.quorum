package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

class CrosshatchPatternWedgeFragmentShaderVulkan is PatternWedgeFragmentShaderVulkan, CrosshatchPatternFragmentShaderPartVulkan

    constant text SHADER_NAME = "Crosshatch Pattern Wedge Fragment Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraFunctions returns text
        return parent:CrosshatchPatternFragmentShaderPartVulkan:GetExtraFunctions()
    end

    private action GetExtraInputs returns text
        return parent:CrosshatchPatternFragmentShaderPartVulkan:GetExtraInputs()
    end

    private action GetAppendedCode returns text
        return parent:CrosshatchPatternFragmentShaderPartVulkan:GetAppendedCode()
    end
    
action GetBaseInputs returns integer
        return parent:PatternWedgeFragmentShaderVulkan:GetBaseInputs()
    end

end