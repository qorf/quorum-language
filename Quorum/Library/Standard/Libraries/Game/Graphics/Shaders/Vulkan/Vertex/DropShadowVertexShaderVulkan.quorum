package Libraries.Game.Graphics.Shaders.Vulkan.Vertex

use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.DefaultAttributeNames

class DropShadowVertexShaderVulkan is Shader
    
constant text SHADER_NAME = "Drop Shadow Vertex Shader"

    on create
        SetType(parent:Shader:VERTEX_SHADER)
        SetName(SHADER_NAME)

        DefaultAttributeNames attributes
        SetCode(GetVersionHeader() +
"
" +
"layout(location = 0) in vec4 " + attributes:POSITION + ";
layout(location = 1) in vec4 " + attributes:COLOR + ";
layout(location = 2) in vec2 " + attributes:TEXTURE_COORDINATES + "0;
layout(location = 3) in uint a_textureIndex;
layout(location = 4) in vec2 a_thicknessOffset;
layout(location = 5) in vec2 a_shadowOffset;
layout(location = 6) in vec2 a_localCenter;
layout(location = 7) in vec4 a_rounding;
layout(location = 8) in float a_softness;
layout(location = 9) in float a_aspectRatio;

layout(location = 0) out vec4 v_color;
layout(location = 1) out vec2 v_textureCoords;
layout(location = 2) flat out uint v_textureIndex;
layout(location = 3) out vec4 v_rounding;
layout(location = 4) out float v_softness;
layout(location = 5) out float v_aspectRatio;

layout(set = 0, binding = 0) uniform Camera
{
    mat4 projectionViewMatrix;
} camera;

void main()
{
    v_color = " + attributes:COLOR + ";
    v_textureCoords = " + attributes:TEXTURE_COORDINATES + "0;
    v_textureIndex = a_textureIndex;
    v_rounding = a_rounding;
    v_softness = a_softness;
    v_aspectRatio = a_aspectRatio;

    vec2 localPosition = " + attributes:POSITION + ".xy - a_localCenter;
    localPosition = (localPosition * a_thicknessOffset) + a_localCenter + a_shadowOffset;
    gl_Position = camera.projectionViewMatrix * vec4(localPosition.x, localPosition.y, " + attributes:POSITION + ".z, " + attributes:POSITION + ".w);
}"
)
    end
    
end