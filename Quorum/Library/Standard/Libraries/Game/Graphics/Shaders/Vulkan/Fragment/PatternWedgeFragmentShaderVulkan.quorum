package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

use Libraries.Game.Graphics.Shaders.Shader

class PatternWedgeFragmentShaderVulkan is Shader
    
    on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        SetName("Wedge Fragment Shader")      
    end
	
	action GetCode returns text
	    return GetVersionHeader() + "
#extension GL_EXT_nonuniform_qualifier : require
" + GetPreprocessorDefinitions() +
"
#ifdef GL_ES
    #define LOWP lowp
    precision mediump float;
#else
    #define LOWP 
#endif

layout(set = 0, binding = 1) uniform sampler immutableSampler;
layout(set = 1, binding = 0) uniform texture2D globalTextures[];

layout(location = 0) in LOWP vec4 v_color;
layout(location = 1) in vec2 v_textureCoords;
layout(location = 2) flat in uint v_textureIndex;
layout(location = 3) in float v_innerRadius;
layout(location = 4) in float v_outerRadius;
layout(location = 5) in float v_minAngle;
layout(location = 6) in float v_maxAngle;
layout(location = 7) in vec2 v_originPoint;
layout(location = 8) in float v_crustThickness;
layout(location = 9) in vec4 v_crustColor;
layout(location = 10) in float v_aspectRatio;

layout (location = 0) out vec4 resultColor;

float PI = 3.1415926538;

" + GetExtraInputs() + "

" + GetExtraFunctions() + "

void main()
{
    float x = gl_FragCoord.x - v_originPoint.x;
    float y = v_originPoint.y - gl_FragCoord.y;
    vec2 point = vec2(x, y);
    float length = length(point);
    float angle = atan(x, y);
    if (angle < 0.0)
        angle = PI + (PI + angle);
    angle = angle / (2.0 * PI);

    if (angle < v_minAngle || angle > v_maxAngle || length < v_innerRadius)
    {
        resultColor = vec4(0.0);
    }
    else
    {
        vec4 textureColor = texture(nonuniformEXT(sampler2D(globalTextures[v_textureIndex], immutableSampler)), v_textureCoords);

        if (v_crustThickness != 0.0)
        {
            float halfCrust = v_crustThickness / 2.0;
            resultColor = mix(v_color * textureColor, vec4(v_color.rgb, 0.0), clamp(length - v_outerRadius, 0.0, 1.0));
			" + GetAppendedCode() + "
            resultColor = mix(v_crustColor, resultColor, clamp(abs(length - (v_outerRadius + halfCrust)) -  abs(halfCrust), 0.0, 1.0));
        }
        else
        {
            resultColor = v_color * textureColor;
			" + GetAppendedCode() + "
        }
    }
}"
	end
    
    action GetBaseInputs returns integer
        // Return the default count of values with "location = " so other classes can add their values after this.
        return 11
    end

    private action GetPreprocessorDefinitions returns text
        return ""
    end

    private action GetExtraInputs returns text
        return ""
    end

    private action GetExtraFunctions returns text
        return ""
    end

    private action GetAppendedCode returns text
        return ""
    end
    
end