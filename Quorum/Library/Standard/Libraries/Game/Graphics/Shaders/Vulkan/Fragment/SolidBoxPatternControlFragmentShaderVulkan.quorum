package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

class SolidBoxPatternControlFragmentShaderVulkan is ControlFragmentShaderVulkan, SolidBoxPatternFragmentShaderPartVulkan

    constant text SHADER_NAME = "Solid Box Pattern Control Fragment Shader"

    on create
        SetName(SHADER_NAME)
    end

    private action GetExtraFunctions returns text
        return parent:SolidBoxPatternFragmentShaderPartVulkan:GetExtraFunctions()
    end

    private action GetExtraInputs returns text
        return parent:SolidBoxPatternFragmentShaderPartVulkan:GetExtraInputs()
    end

    private action GetAppendedCode returns text
        return parent:SolidBoxPatternFragmentShaderPartVulkan:GetAppendedCode()
    end
    
action GetBaseInputs returns integer
        return parent:ControlFragmentShaderVulkan:GetBaseInputs()
    end

end