package Libraries.Game.Graphics.Shaders.Vulkan.Fragment

use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.DefaultAttributeNames

class ControlFragmentShaderVulkan is Shader
    
    constant text SHADER_NAME = "Control Fragment Shader"
    
    action GetBaseInputs returns integer
        // Return the default count of values with "location = " so other classes can add their values after this.
        return 8
    end

    on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        SetName(SHADER_NAME)
    end
	
	action GetCode returns text
	    DefaultAttributeNames attributes
	    return GetVersionHeader() +
"
" +
"#ifdef GL_ES
    #define LOWP lowp
    precision mediump float;
#else
    #define LOWP 
#endif

// Adds support for nonuniformEXT and unsized descriptor arrays.
#extension GL_EXT_nonuniform_qualifier : require

layout(set = 0, binding = 1) uniform sampler immutableSampler;
layout(set = 1, binding = 0) uniform texture2D globalTextures[];

layout (location = 0) in vec4 v_color;
layout (location = 1) in vec2 v_textureCoords;
layout (location = 2) flat in uint v_textureIndex;
layout (location = 3) in vec4 v_borderColor;
layout (location = 4) in vec4 v_rounding;
layout (location = 5) in vec4 v_borderThickness;
layout (location = 6) in float v_aspectRatio;
layout (location = 7) in float v_antiAlias;
" + GetExtraInputs() + "

layout (location = 0) out vec4 outputColor;

// Calculate how far a point is from the outer shell of a rounded rectangle.
// The rounding vector contains edge roundness values for:
// x: top-right
// y: bottom-right
// z: top-left
// w: bottom-left
float signedDistanceFunction(in vec2 point, in vec2 dimensions, in vec4 rounding)
{
    bool right = (point.x >= 0.0);
    bool top   = (point.y >= 0.0);

    // Select the correct corner radius based on quadrant
    float r = right
        ? (top ? rounding.x : rounding.y)   // right: top or bottom
        : (top ? rounding.z : rounding.w);  // left:  top or bottom

    // Scale radius relative to rectangle size (smallest half-dimension)
    float minHalf = min(dimensions.x, dimensions.y);
    float r_scaled = r * minHalf;

    // Canonical SDF
    vec2 q = abs(point) - (dimensions - vec2(r_scaled));
    float outsideDist = length(max(q, vec2(0.0)));
    float insideDist  = min(max(q.x, q.y), 0.0);

    return outsideDist + insideDist - r_scaled;
}

" + GetExtraFunctions() + "

void main()
{
    vec4 textureColor = texture(nonuniformEXT(sampler2D(globalTextures[v_textureIndex], immutableSampler)), v_textureCoords);

    // The control runs from -1 to 1 up and down, so its half height is 1.0 here.
    vec2 point = (v_textureCoords.xy - 0.5) * 2.0;
    point.x *= v_aspectRatio;
    vec2 dimensions = vec2(v_aspectRatio, 1.0);

    // One screen pixel in these units, from how fast point changes across the
    // screen. Right at any zoom, interface scale or rotation. (Taken before the
    // branch below, which goes the same way for the whole control.)
    float pixel = max(length(vec2(dFdx(point.y), dFdy(point.y))), 0.000001);
    float halfPixel = 0.5 * pixel;
    highp vec2 unitsPerPixel = vec2(dFdx(point.x), dFdy(point.y));
    bool axisAligned = abs(dFdy(point.x)) < 0.001 * abs(unitsPerPixel.x)
                    && abs(dFdx(point.y)) < 0.001 * abs(unitsPerPixel.y);

    // The GPU draws only the pixels whose centers are inside the control, so what's
    // drawn always ends on pixel boundaries. Measure from those boundaries, not from
    // edges that may fall partway into a pixel; otherwise a side whose edge is
    // mid-pixel spreads its border over two rows, thinner looking than the others.
    // (Rotated controls skip this.)
    if (axisAligned)
    {
        highp vec2 edgeA = gl_FragCoord.xy + (-dimensions - point) / unitsPerPixel;
        highp vec2 edgeB = gl_FragCoord.xy + (dimensions - point) / unitsPerPixel;
        highp vec2 snappedA = floor(edgeA + 0.5);
        highp vec2 snappedB = floor(edgeB + 0.5);
        point = (gl_FragCoord.xy - 0.5 * (snappedA + snappedB)) * unitsPerPixel;
        dimensions = 0.5 * abs(snappedB - snappedA) * abs(unitsPerPixel);
    }

    float distance = signedDistanceFunction(point, dimensions, v_rounding);

    // Each side's border, in the same units. The mapping gives each as half the
    // border in these units (thickness / height), which is what the fill's shift and
    // size below use. A side with a border is a whole number of screen pixels wide,
    // at least one (half a pixel per pixel here), so every side's border fills the
    // same rows and none falls between rows when zoomed out. A side without one
    // stays zero.
    vec4 hasBorder = step(vec4(0.000001), v_borderThickness);
    vec4 borderThickness = max(floor(v_borderThickness / halfPixel + 0.5), vec4(1.0)) * halfPixel * hasBorder;
    float borderSides = dot(hasBorder, vec4(1.0));

    vec4 resultColor = v_color * textureColor;

    if (borderSides > 3.5)
    {
        // Every side: the fill starts one border width inside the edge (left plus
        // right is one width, as the sides are equal). Blended across the pixel there.
        float inside = 1.0 - smoothstep(-halfPixel, halfPixel, distance + borderThickness.x + borderThickness.z);
        resultColor = mix(v_borderColor * textureColor, resultColor, inside);
    }
    else if (borderSides > 0.5)
    {
        // The enabled borders vector stores values for the sides in the following order:
        // x: left
        // y: top (y-positive: technically the bottom due to how GLSL handles texture coordinates)
        // z: right
        // w: bottom (y-negative)
        vec2 fillPoint = point - vec2(borderThickness.x - borderThickness.z, borderThickness.y - borderThickness.w);
        vec2 fillDimensions = vec2(dimensions.x - borderThickness.x - borderThickness.z, dimensions.y - borderThickness.y - borderThickness.w);
        float fillDistance = signedDistanceFunction(fillPoint, fillDimensions, v_rounding);
    
        float inside = 1.0 - smoothstep(-halfPixel, halfPixel, fillDistance);
        resultColor = mix(v_borderColor * textureColor, resultColor, inside);
    }

    // Fade out at the control's edge, blended across the pixel there, so the
    // outermost pixels inside are drawn on every side. Keeps the color and lowers
    // the alpha, as before.
    float coverage = 1.0 - smoothstep(-halfPixel, halfPixel, distance);
    resultColor = mix(vec4(resultColor.rgb, 0.0), resultColor, coverage);

    " + GetAppendedCode() + "

    //resultColor.rgb = pow(resultColor.rgb, (1.0/2.4));
    outputColor = resultColor;
}"
	end

    private action GetPreprocessorDefinitions returns text
        return ""
    end

    private action GetExtraInputs returns text
        return ""
    end

    private action GetExtraFunctions returns text
        return ""
    end

    private action GetAppendedCode returns text
        return ""
    end

end