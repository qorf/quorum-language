package Libraries.Game.Graphics.Shaders.Vulkan

use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.ShaderManager

class DefaultFragmentShader3DVulkan is Shader
    
	on create
        SetType(parent:Shader:FRAGMENT_SHADER)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName(manager:DEFAULT_3D_FRAGMENT_SHADER)

        SetCode(GetVersionHeader() +
"
" +
"#ifdef GL_ES
    #define LOWP lowp
    precision mediump float;
#else
    #define LOWP 
#endif

// Adds support for nonuniformEXT and unsized descriptor arrays.
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference: require
#extension GL_EXT_buffer_reference2: enable
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The 3D camera uniform (Item 38); only whether lighting is linear is
// used here (Linear lighting plan).
layout(set = 0, binding = 0) uniform Camera
{
    mat4 projectionViewMatrix;
    vec3 cameraPosition;
    float time;
    vec2 screenSize;
    float nearPlane;
    float farPlane;
    float linearLighting;
} camera;

layout(set = 0, binding = 1) uniform sampler immutableSampler;
layout(set = 1, binding = 0) uniform texture2D globalTextures[];

// The GPU material (MaterialVulkan). Its flags: 1 texture set, 2 emissive
// map, 4 occlusion map, 8 unlit, 16 two-sided, 32 texture transform, 64 the
// cutoff is compared with the texture's own alpha (Lighting plan L1, L4).
struct Material {
	uint diffuseColor;
	uint textureIndex;
	uint hasNormalMap;
	uint hasRoughMap;
	uint normalMapIndex;
	uint roughMapIndex;
	float roughness;
	float metallic;
	uint flags;
	float textureScale;
	uint emissiveColor;
	uint emissiveMapIndex;
	float emissiveStrength;
	uint occlusionMapIndex;
	float alphaCutoff;
	float normalStrength;
	float uvOffsetX;
	float uvOffsetY;
	float uvScaleX;
	float uvScaleY;
	float uvRotation;
	uint reserved1;
	uint reserved2;
	uint reserved3;
};

layout(scalar, buffer_reference) buffer Materials
{
	Material data;
};

layout(location = 0) in vec2 v_textureCoords;
layout(location = 1) flat in uint v_entityID;
layout(location = 2) flat in uint v_hasDiffuseOverride;
layout(location = 3) flat in uint v_diffuseOverride;
layout(location = 4) flat in uint v_hasTextureOverride;
layout(location = 5) flat in uint v_textureOverrideIndex;
layout(location = 6) in vec4 v_position;
layout(location = 7) in mat3 v_tangentBitangentNormal;

layout (location = 0) out vec4 outputPosition;
layout (location = 1) out vec4 outputColor;
layout (location = 2) out vec4 outputNormal;
layout (location = 3) out vec4 outputPBR;
// The light the surface gives off (Lighting plan L1), added after the
// lights by the lighting pass.
layout (location = 4) out vec4 outputEmissive;

// A color as pictures store it (sRGB) turned into an amount of light, for
// linear lighting (Linear lighting plan); as it is otherwise.
vec3 shaderColor(vec3 color)
{
	if (camera.linearLighting < 0.5)
		return color;
	vec3 c = clamp(color, 0.0, 1.0);
	vec3 low = c / 12.92;
	vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
	return mix(high, low, vec3(lessThanEqual(c, vec3(0.04045))));
}

vec3 calculateNormal(Material material, mat3 tanBitanNormal, vec2 textCoords)
{
    vec3 newNormal = tanBitanNormal[2];
    if (material.hasNormalMap > 0)
    {
		newNormal = texture(nonuniformEXT(sampler2D(globalTextures[material.normalMapIndex], immutableSampler)), textCoords).rgb;
        newNormal = newNormal * 2.0 - 1.0;
        // The normal map's strength (glTF's normal scale) bends it more or less.
        newNormal.xy *= material.normalStrength;
        newNormal = normalize(newNormal);
        newNormal = normalize(tanBitanNormal * newNormal);
    }
    return newNormal;
}

struct InstanceData {
   uint vertexPadding1;
   uint vertexPadding2;
   uint indexPadding1;
   uint indexPadding2;
   Materials materials;
   uint textureOverride;
   uint textureIndex;
   uint diffuseColorOverride;
   uint diffuseColor;
   mat4 modelTransform;
};

layout(scalar, buffer_reference) buffer Instances {
   InstanceData[] data;
};

layout(push_constant) uniform PushConstants {
   Instances instances;
} pushConstants;

void main()
{
	// Calculate albedo.
   Instances instances = pushConstants.instances;
   InstanceData instanceData = instances.data[v_entityID];
   Materials materials = instanceData.materials;
   Material material = materials.data;
   // A texture set keeps height in its albedo's alpha, and its normal,
   // ambient occlusion and roughness together in the normal map.
   bool textureSet = (material.flags & 1u) != 0u;
   bool twoSided = (material.flags & 16u) != 0u;

	// Back faces only reach here when a model has a two-sided material
	// (drawn without culling); its other materials still hide them.
	if (!gl_FrontFacing && !twoSided)
	{
		discard;
	}

	// The texture transform (glTF's KHR_texture_transform): scale, turn,
	// then move.
	vec2 coordinates = v_textureCoords;
	if ((material.flags & 32u) != 0u)
	{
		float turnCos = cos(material.uvRotation);
		float turnSin = sin(material.uvRotation);
		vec2 scaled = coordinates * vec2(material.uvScaleX, material.uvScaleY);
		coordinates = vec2(turnCos * scaled.x + turnSin * scaled.y, -turnSin * scaled.x + turnCos * scaled.y) + vec2(material.uvOffsetX, material.uvOffsetY);
	}

   uint textureIndex = material.textureIndex;
	if (v_hasTextureOverride == 1)
		textureIndex = v_textureOverrideIndex;

	vec4 diffuse = unpackUnorm4x8(material.diffuseColor);
	if (v_hasDiffuseOverride == 1)
		diffuse = unpackUnorm4x8(v_diffuseOverride);

    vec4 sampled = texture(nonuniformEXT(sampler2D(globalTextures[textureIndex], immutableSampler)), coordinates);
    outputColor = sampled * diffuse;
    // The color as an amount of light (Linear lighting plan). Alpha, and
    // a texture set's height in it, are left alone.
    outputColor.rgb = shaderColor(outputColor.rgb);

	if (textureSet)
	{
		// Alpha is height, not opacity.
		outputColor.a = diffuse.a;
	}
	else if ((material.flags & 64u) != 0u)
	{
		// The rule every model had before: cut out where the texture's own
		// alpha is below the cutoff (a half).
		if (sampled.a < material.alphaCutoff)
		{
			discard;
		}
	}
	else
	{
		// glTF's MASK cuts out below its cutoff; OPAQUE's cutoff is 0. What
		// is left of either is fully opaque, as glTF says.
		if (outputColor.a < material.alphaCutoff)
		{
			discard;
		}
		outputColor.a = 1.0;
	}

	// Set position.
	outputPosition = v_position;

	vec3 newNormal;
	float roughnessFactor = 0.0f;
    float metallicFactor = material.metallic;
	float ambientOcclusion = 1.0f;
	if (textureSet)
	{
		vec4 normalRoughness = texture(nonuniformEXT(sampler2D(globalTextures[material.normalMapIndex], immutableSampler)), coordinates);
		vec3 packedNormal = normalRoughness.rgb * 2.0 - 1.0;
		// Terrain3D's packing: the normal's length carries ambient occlusion.
		ambientOcclusion = clamp(length(packedNormal) * 2.0 - 1.0, 0.0, 1.0);
		newNormal = normalize(v_tangentBitangentNormal * normalize(packedNormal));
		roughnessFactor = normalRoughness.a;
	}
	else
	{
		// Calculate and set normal.
		newNormal = calculateNormal(material, v_tangentBitangentNormal, coordinates);

		// Calculate PBR properties.
		if (material.hasRoughMap > 0)
		{
			vec4 pbrValues = texture(nonuniformEXT(sampler2D(globalTextures[material.roughMapIndex], immutableSampler)), coordinates);
			roughnessFactor = pbrValues.g;
			metallicFactor = pbrValues.b;
		}
		else
		{
			roughnessFactor = material.roughness;
		}

		// An ambient occlusion map, as glTF models bring (its red channel).
		if ((material.flags & 4u) != 0u)
		{
			ambientOcclusion = texture(nonuniformEXT(sampler2D(globalTextures[material.occlusionMapIndex], immutableSampler)), coordinates).r;
		}
	}

	// The back of a two-sided face faces the other way.
	if (!gl_FrontFacing)
	{
		newNormal = -newNormal;
	}
	outputNormal = vec4(newNormal, 1.0);

	// The first channel, unused before, carries ambient occlusion: 1 for none.
	outputPBR = vec4(ambientOcclusion, roughnessFactor, metallicFactor, 1.0);

	// The emissive light: its color times its strength, times its texture
	// if it has one (Lighting plan L1).
	// Each color is turned into light before the strength scales it
	// (Linear lighting plan).
	vec3 emissive = shaderColor(unpackUnorm4x8(material.emissiveColor).rgb) * material.emissiveStrength;
	if ((material.flags & 2u) != 0u)
	{
		emissive *= shaderColor(texture(nonuniformEXT(sampler2D(globalTextures[material.emissiveMapIndex], immutableSampler)), coordinates).rgb);
	}

	// An unlit material shows its color as it is: it goes into the emissive
	// light, and gives the lights nothing to shade (Lighting plan L4).
	if ((material.flags & 8u) != 0u)
	{
		emissive += outputColor.rgb;
		outputColor.rgb = vec3(0.0);
	}
	outputEmissive = vec4(emissive, 1.0);
}"
)
    end

end
