package Libraries.Game.Graphics.Shaders.OpenGL.Fragment

use Libraries.Game.Graphics.Shaders.Shader

class HorizontalDashedLineFragmentShaderOpenGL is Shader
constant text SHADER_NAME = "Horizontal Dashed Line Fragment Shader"
    
    on create
SetName(SHADER_NAME)
        SetType(parent:Shader:FRAGMENT_SHADER)
        
SetCode(GetVersionHeader() +
"
" +
"#ifdef GL_ES
    #define LOWP lowp
    precision mediump float;
#else
    #define LOWP 
#endif

in vec4 v_color;
in vec2 v_textureCoords;
in float v_fillLength;
in float v_gapLength;
in float v_pixelLength;

uniform sampler2D u_texture;

layout (location = 0) out vec4 outputColor;

void main()
{
    float patternPoint = mod(v_textureCoords.x, v_fillLength + v_gapLength);
    outputColor = texture(u_texture, v_textureCoords) * v_color;
    outputColor.a = outputColor.a * (1.0 - smoothstep(v_fillLength, v_fillLength + v_pixelLength, patternPoint));
}"
)
    end
end
