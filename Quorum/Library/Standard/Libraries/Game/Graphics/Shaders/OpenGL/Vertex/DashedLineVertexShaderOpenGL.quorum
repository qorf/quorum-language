package Libraries.Game.Graphics.Shaders.OpenGL.Vertex

use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.DefaultAttributeNames

class DashedLineVertexShaderOpenGL is Shader
constant text SHADER_NAME = "Dashed Line Vertex Shader"
    
    on create
SetName(SHADER_NAME)
        SetType(parent:Shader:VERTEX_SHADER)
        
DefaultAttributeNames attributes

        SetCode(GetVersionHeader() +
"
 
in vec4 " + attributes:POSITION + ";
in vec4 " + attributes:COLOR + ";
in vec2 " + attributes:TEXTURE_COORDINATES + "0;
in uint a_textureIndex;
in float a_fillLength;
in float a_gapLength;
in float a_pixelLength;

uniform mat4 u_projTrans;

out vec4 v_color;
out vec2 v_textureCoords;
out float v_fillLength;
out float v_gapLength;
out float v_pixelLength;

void main()
{
    v_color = " + attributes:COLOR + ";
    v_textureCoords = " + attributes:TEXTURE_COORDINATES + "0;
    v_fillLength = a_fillLength;
    v_gapLength = a_gapLength;
    v_pixelLength = a_pixelLength;
    gl_Position =  u_projTrans * " + attributes:POSITION + ";
}
")
    end
    
end