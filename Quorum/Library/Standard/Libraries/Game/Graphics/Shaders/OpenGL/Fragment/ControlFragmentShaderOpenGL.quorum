package Libraries.Game.Graphics.Shaders.OpenGL.Fragment

use Libraries.Game.Graphics.Shaders.Shader

class ControlFragmentShaderOpenGL is Shader

    constant text SHADER_NAME = "Control Fragment Shader"

    on create
        SetName(SHADER_NAME)
        SetType(parent:Shader:FRAGMENT_SHADER)
        SetCode(GetVersionHeader() + "
" + GetPreprocessorDefinitions() +
"
#ifdef GL_ES
    #define LOWP lowp
    precision mediump float;
#else
    #define LOWP 
#endif

in LOWP vec4 v_color;
in LOWP vec4 v_borderColor;
in vec2 v_texCoords;
in vec4 v_rounding;
in vec4 v_borderThickness;
in float v_aspectRatio;
in float v_antiAlias;

uniform sampler2D u_texture;
" + GetExtraInputs() + "

layout (location = 0) out vec4 outputColor;

// Calculate how far a point is from the outer shell of a rounded rectangle.
// The rounding vector contains edge roundness values for:
// x: top-right
// y: bottom-right
// z: top-left
// w: bottom-left
float signedDistanceFunction(in vec2 point, in vec2 dimensions, in vec4 rounding)
{
    bool right = (point.x >= 0.0);
    bool top   = (point.y >= 0.0);

    // Select the correct corner radius based on quadrant
    float r = right
        ? (top ? rounding.x : rounding.y)   // right: top or bottom
        : (top ? rounding.z : rounding.w);  // left:  top or bottom

    // Scale radius relative to rectangle size (smallest half-dimension)
    float minHalf = min(dimensions.x, dimensions.y);
    float r_scaled = r * minHalf;

    // Canonical SDF
    vec2 q = abs(point) - (dimensions - vec2(r_scaled));
    float outsideDist = length(max(q, vec2(0.0)));
    float insideDist  = min(max(q.x, q.y), 0.0);

    return outsideDist + insideDist - r_scaled;
}

" + GetExtraFunctions() + "

void main()
{
    vec4 rounding = v_rounding;
    float aspectRatio = v_aspectRatio;
    vec4 borderColor = v_borderColor;

    // The control runs from -1 to 1 up and down, so its half height is 1.0 here.
    vec2 point = (v_texCoords.xy - 0.5) * 2.0;
    point.x *= aspectRatio;
    vec2 dimensions = vec2(aspectRatio, 1.0);

    // One screen pixel in these units, from how fast point changes across the
    // screen. Right at any zoom, interface scale or rotation.
    float pixel = max(length(vec2(dFdx(point.y), dFdy(point.y))), 0.000001);
    float halfPixel = 0.5 * pixel;

    // Edges are measured as they are. DrawableShape puts every interface
    // control's corners on whole pixels, so the drawn pixels end at the
    // edges. (Estimating each edge from derivatives here, as before, was
    // off by fractions of a pixel across a large control, and made left
    // and right edges ragged.)
    float distance = signedDistanceFunction(point, dimensions, rounding);

    // Each side's border, in the same units. The mapping gives each as half the
    // border in these units (thickness / height), which is what the fill's shift and
    // size below use. A side with a border is a whole number of screen pixels wide,
    // at least one (half a pixel per pixel here), so every side's border fills the
    // same rows and none falls between rows when zoomed out. A side without one
    // stays zero.
    vec4 hasBorder = step(vec4(0.000001), v_borderThickness);
    // The small bias settles a border that's exactly a half pixel past a
    // whole one (1.5 points at scale 1) the same way on every row; without it,
    // tiny differences from row to row made the left and right sides flicker
    // between one and two pixels.
    vec4 borderThickness = max(floor(v_borderThickness / halfPixel + 0.5 + 1.0 / 64.0), vec4(1.0)) * halfPixel * hasBorder;
    float borderSides = dot(hasBorder, vec4(1.0));

    vec4 textureColor = texture(u_texture, v_texCoords);
    vec4 resultColor = v_color * textureColor;

    if (borderSides > 3.5)
    {
        // Every side: the fill starts one border width inside the edge (left plus
        // right is one width, as the sides are equal). Blended across the pixel there.
        float inside = 1.0 - smoothstep(-halfPixel, halfPixel, distance + borderThickness.x + borderThickness.z);
        resultColor = mix(borderColor * textureColor, resultColor, inside);
    }
    else if (borderSides > 0.5)
    {
        // The enabled borders vector stores values for the sides in the following order:
        // x: left
        // y: top (y-positive: technically the bottom due to how GLSL handles texture coordinates)
        // z: right
        // w: bottom (y-negative)
        vec2 fillPoint = point - vec2(borderThickness.x - borderThickness.z, borderThickness.y - borderThickness.w);
        vec2 fillDimensions = vec2(dimensions.x - borderThickness.x - borderThickness.z, dimensions.y - borderThickness.y - borderThickness.w);
        float fillDistance = signedDistanceFunction(fillPoint, fillDimensions, rounding);
    
        float inside = 1.0 - smoothstep(-halfPixel, halfPixel, fillDistance);
        resultColor = mix(borderColor * textureColor, resultColor, inside);
    }

    // Fade out at the control's edge, blended across the pixel there, so the
    // outermost pixels inside are drawn on every side. Keeps the color and lowers
    // the alpha, as before.
    float coverage = 1.0 - smoothstep(-halfPixel, halfPixel, distance);
    resultColor = mix(vec4(resultColor.rgb, 0.0), resultColor, coverage);

    " + GetAppendedCode() + "

    outputColor = resultColor;
}

")
        

    end

    private action GetPreprocessorDefinitions returns text
        return ""
    end

    private action GetExtraInputs returns text
        return ""
    end

    private action GetExtraFunctions returns text
        return ""
    end

    private action GetAppendedCode returns text
        return ""
    end

end