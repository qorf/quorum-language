package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.DashedLineVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.VerticalDashedLineFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.VerticalDashedLineShaderMappingVulkan
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.DashedLineVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.VerticalDashedLineFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.VerticalDashedLineShaderMappingOpenGL

class VerticalDashedLineShaderProgram is ShaderProgram
    
public constant text DEFAULT_NAME = "Vertical Dashed Line Shader Program"
    constant text VERTEX_NAME = "Vertical Dashed Line Vertex Shader"
    constant text FRAGMENT_NAME = "Vertical Dashed Line Fragment Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        
        if manager:HasShader(VERTEX_NAME)
            Shader vertex = manager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
                DashedLineVertexShaderVulkan vertex
                Add(vertex)
            else
DashedLineVertexShaderOpenGL vertex
                Add(vertex)
            end
        end

        if manager:HasShader(FRAGMENT_NAME)
            Shader fragment = manager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
                VerticalDashedLineFragmentShaderVulkan fragment
                Add(fragment)
            else
VerticalDashedLineFragmentShaderOpenGL fragment
                Add(fragment)
            end
        end

        if IsVulkanProgram()
            VerticalDashedLineShaderMappingVulkan mapping
            SetShaderMapping(mapping)
        else
VerticalDashedLineShaderMappingOpenGL mapping
            SetShaderMapping(mapping)
        end
    end
    
end