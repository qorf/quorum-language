package Libraries.Game.Graphics.Shaders.Programs

use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.BloomDownShaderMappingVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.BloomDownFragmentShaderVulkan

/*
BloomDownShaderProgram draws one step down the bloom chain: a full-screen triangle into an image
half the size of its source. The
Vulkan 3D painter uses it on its own when bloom is on. It is Vulkan only.

Attribute: Example
use Libraries.Game.Graphics.Shaders.Programs.BloomDownShaderProgram

BloomDownShaderProgram program
program:Compile()
*/
class BloomDownShaderProgram is ShaderProgram

    on create
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName("Bloom Down Shader Program")

        Shader vertex = manager:GetCopyFromSamplerVertexShader()
        BloomDownFragmentShaderVulkan fragment
        Add(vertex)
        Add(fragment)

        BloomDownShaderMappingVulkan mapping
        SetShaderMapping(mapping)
    end
end
