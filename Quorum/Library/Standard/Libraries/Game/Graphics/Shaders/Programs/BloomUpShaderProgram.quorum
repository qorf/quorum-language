package Libraries.Game.Graphics.Shaders.Programs

use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.BloomUpShaderMappingVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.BloomUpFragmentShaderVulkan

/*
BloomUpShaderProgram draws one step up the bloom chain (Lighting plan L3):
a full-screen triangle adding a blurred smaller step to the step down of the
same size. The Vulkan 3D painter uses it on its own when bloom is on. It is
Vulkan only.

Attribute: Example
use Libraries.Game.Graphics.Shaders.Programs.BloomUpShaderProgram

BloomUpShaderProgram program
program:Compile()
*/
class BloomUpShaderProgram is ShaderProgram

    on create
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName("Bloom Up Shader Program")

        Shader vertex = manager:GetCopyFromSamplerVertexShader()
        BloomUpFragmentShaderVulkan fragment
        Add(vertex)
        Add(fragment)

        BloomUpShaderMappingVulkan mapping
        SetShaderMapping(mapping)
    end
end
