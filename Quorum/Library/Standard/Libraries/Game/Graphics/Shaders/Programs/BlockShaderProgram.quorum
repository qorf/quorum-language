package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.BlockVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.BlockFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.BlockShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.BlockVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.BlockFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.BlockShaderMappingVulkan

class BlockShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Block Shader Program"
    constant text FRAGMENT_NAME = "Block Fragment Shader"
    constant text VERTEX_NAME = "Block Vertex Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager manager
        ShaderManager shaderManager = manager:GetShaderManager()
        
        if shaderManager:HasShader(VERTEX_NAME)
            Shader vertex = shaderManager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
                BlockVertexShaderVulkan vertex
                Add(vertex)
            else
BlockVertexShaderOpenGL vertex
            Add(vertex)
            end
        end

        if shaderManager:HasShader(FRAGMENT_NAME)
            Shader fragment = shaderManager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
                BlockFragmentShaderVulkan fragment
                Add(fragment)
            else
BlockFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
            BlockShaderMappingVulkan mapping
            SetShaderMapping(mapping)
        else
BlockShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
    end

end