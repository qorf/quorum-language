package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.BlockErrorVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.BlockErrorFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.BlockErrorShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.BlockErrorVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.BlockErrorFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.BlockErrorShaderMappingVulkan

class BlockErrorShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Block Error Shader Program"
    constant text FRAGMENT_NAME = "Block Error Fragment Shader"
    constant text VERTEX_NAME = "Block Error Vertex Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        
        if manager:HasShader(VERTEX_NAME)
            Shader vertex = manager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
BlockErrorVertexShaderVulkan vertex
            Add(vertex)
            else
BlockErrorVertexShaderOpenGL vertex
            Add(vertex)
            end
        end

        if manager:HasShader(FRAGMENT_NAME)
            Shader fragment = manager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
BlockErrorFragmentShaderVulkan fragment
            Add(fragment)
            else
BlockErrorFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
BlockErrorShaderMappingVulkan mapping
        SetShaderMapping(mapping)
        else
BlockErrorShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
    end

end