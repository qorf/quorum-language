package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.PatternControlShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.PatternControlVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.CrosshatchPatternControlFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.PatternControlVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.CrosshatchPatternControlFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.PatternControlShaderMappingVulkan

class CrosshatchPatternControlShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Crosshatch Pattern Control Shader Program"
    constant text VERTEX_NAME = "Pattern Control Vertex Shader"
    constant text FRAGMENT_NAME = "Crosshatch Pattern Control Fragment Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        
        if manager:HasShader(VERTEX_NAME)
            Shader vertex = manager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
                PatternControlVertexShaderVulkan vertex
                Add(vertex)
            else
PatternControlVertexShaderOpenGL vertex
            Add(vertex)
            end
        end

        if manager:HasShader(FRAGMENT_NAME)
            Shader fragment = manager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
                CrosshatchPatternControlFragmentShaderVulkan fragment
                Add(fragment)
            else
CrosshatchPatternControlFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
            PatternControlShaderMappingVulkan mapping
            SetShaderMapping(mapping)
        else
PatternControlShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
    end

end