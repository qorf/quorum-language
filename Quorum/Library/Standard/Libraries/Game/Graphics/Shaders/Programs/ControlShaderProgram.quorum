package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.ControlVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.ControlFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.ControlShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.ControlVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.ControlFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.ControlShaderMappingVulkan

class ControlShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Control Shader Program"
    constant text VERTEX_NAME = "Control Vertex Shader"
    constant text FRAGMENT_NAME = "Control Fragment Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        
        if manager:HasShader(VERTEX_NAME)
            Shader vertex = manager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
                ControlVertexShaderVulkan vertex
                Add(vertex)
            else
ControlVertexShaderOpenGL vertex
            Add(vertex)
            end
        end

        if manager:HasShader(FRAGMENT_NAME)
            Shader fragment = manager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
                ControlFragmentShaderVulkan fragment
                Add(fragment)
            else
ControlFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
            ControlShaderMappingVulkan mapping
            SetShaderMapping(mapping)
        else
ControlShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
    end

end