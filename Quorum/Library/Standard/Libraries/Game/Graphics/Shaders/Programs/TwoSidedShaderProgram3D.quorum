package Libraries.Game.Graphics.Shaders.Programs

use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.TwoSidedShaderMapping3DVulkan

/*
TwoSidedShaderProgram3D draws 3D models the way the default 3D program does,
but without hiding the backs of faces. The Vulkan
painter uses it on its own for models with a two-sided material, such as
leaves and grass cards; programs don't need to set it. It is Vulkan only.

Attribute: Example
use Libraries.Game.Graphics.Shaders.Programs.TwoSidedShaderProgram3D

TwoSidedShaderProgram3D program
program:Compile()
*/
class TwoSidedShaderProgram3D is ShaderProgram

    on create
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName("Two Sided 3D Shader Program")

        Shader vertex = manager:GetDefaultVertexShader3D()
        Shader fragment = manager:GetDefaultFragmentShader3D()
        Add(vertex)
        Add(fragment)

        TwoSidedShaderMapping3DVulkan mapping
        SetShaderMapping(mapping)
    end
end
