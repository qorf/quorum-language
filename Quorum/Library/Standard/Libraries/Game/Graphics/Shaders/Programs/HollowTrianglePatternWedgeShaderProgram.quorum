package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.PatternWedgeShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.PatternWedgeVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.HollowTrianglePatternWedgeFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.PatternWedgeVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.HollowTrianglePatternWedgeFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.PatternWedgeShaderMappingVulkan

class HollowTrianglePatternWedgeShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Hollow Triangle Pattern Wedge Shader Program"
    constant text VERTEX_NAME = "Pattern Wedge Vertex Shader"
    constant text FRAGMENT_NAME = "Hollow Triangle Pattern Wedge Fragment Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        
        if manager:HasShader(VERTEX_NAME)
            Shader vertex = manager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
PatternWedgeVertexShaderVulkan vertex
            Add(vertex)
            else
PatternWedgeVertexShaderOpenGL vertex
            Add(vertex)
            end
        end

        if manager:HasShader(FRAGMENT_NAME)
            Shader fragment = manager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
HollowTrianglePatternWedgeFragmentShaderVulkan fragment
            Add(fragment)
            else
HollowTrianglePatternWedgeFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
PatternWedgeShaderMappingVulkan mapping
        SetShaderMapping(mapping)
        else
PatternWedgeShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
    end

end