package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.DefaultLightingShaderMappingVulkan

class DefaultLightingShaderProgram is ShaderProgram
    
    on create
        GameStateManager gameState
        ShaderManager manager = gameState:GetShaderManager()
        SetName(manager:DEFAULT_LIGHTING_SHADER_PROGRAM)

        Shader vertex = manager:GetDefaultLightingVertexShader()
        Shader fragment = manager:GetDefaultLightingFragmentShader()

        Add(vertex)
        Add(fragment)
        
        DefaultLightingShaderMappingVulkan mapping
        SetShaderMapping(mapping)
    end
    
end