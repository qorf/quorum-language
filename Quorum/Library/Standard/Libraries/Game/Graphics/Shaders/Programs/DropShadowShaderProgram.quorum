package Libraries.Game.Graphics.Shaders.Programs
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.OpenGL.Mapping.DropShadowShaderMappingOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Fragment.DropShadowFragmentShaderOpenGL
use Libraries.Game.Graphics.Shaders.OpenGL.Vertex.DropShadowVertexShaderOpenGL
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Shader
use Libraries.Game.Graphics.Shaders.Vulkan.Fragment.DropShadowFragmentShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Vertex.DropShadowVertexShaderVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Mapping.DropShadowShaderMappingVulkan

class DropShadowShaderProgram is ShaderProgram

    public constant text DEFAULT_NAME = "Drop Shadow Shader Program"
    constant text FRAGMENT_NAME = "Drop Shadow Fragment Shader"
    constant text VERTEX_NAME = "Drop Shadow Vertex Shader"

    on create
        SetName(DEFAULT_NAME)
        GameStateManager manager
        ShaderManager shaderManager = manager:GetShaderManager()

        if shaderManager:HasShader(VERTEX_NAME)
            Shader vertex = shaderManager:GetShader(VERTEX_NAME)
            Add(vertex)
        else
            if IsVulkanProgram()
                DropShadowVertexShaderVulkan vertex
                Add(vertex)
                else
DropShadowVertexShaderOpenGL vertex
            Add(vertex)
            end
        end
        
if shaderManager:HasShader(FRAGMENT_NAME)
            Shader fragment = shaderManager:GetShader(FRAGMENT_NAME)
            Add(fragment)
        else
            if IsVulkanProgram()
                DropShadowFragmentShaderVulkan fragment
                Add(fragment)
            else
DropShadowFragmentShaderOpenGL fragment
            Add(fragment)
            end
        end

        if IsVulkanProgram()
            DropShadowShaderMappingVulkan mapping
            SetShaderMapping(mapping)
        else
DropShadowShaderMappingOpenGL mapping
        SetShaderMapping(mapping)
        end
        
    end

end