package Libraries.Game.Graphics.Vulkan

use Libraries.Game.Graphics.Painter3D
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.Skybox
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Environment
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Array
use Libraries.Game.Graphics.Shaders.ShaderManager
use Libraries.Game.Graphics.Shaders.Vulkan.VulkanShaderProgram
use Libraries.Game.Game
use Libraries.Containers.Iterator
use Libraries.Game.Layer
use Libraries.Game.Layer3D
use Libraries.Containers.HashTable
use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Game.Graphics.Vulkan.Commands.PipelineBarrierCommand
use Libraries.Game.Graphics.Vulkan.Commands.BeginRenderPassCommand
use Libraries.Compute.Matrix4
use Libraries.Game.Graphics.Vulkan.Commands.SetViewportCommand
use Libraries.Game.Graphics.Vulkan.Commands.BindPipelineCommand
use Libraries.Game.Graphics.Vulkan.Commands.EndRenderPassCommand
use Libraries.Game.Graphics.Vulkan.Commands.BindDescriptorSetCommand
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.Graphics.Vulkan.Commands.DrawIndirectCommand
use Libraries.Game.Graphics.Vulkan.Commands.SetPushConstantsCommand
use Libraries.Game.Graphics.Vulkan.Commands.SetScissorCommand
use Libraries.Game.Graphics.Vulkan.Commands.BindVertexBufferCommand
use Libraries.Game.Graphics.Shaders.Programs.CopyFromSamplerShaderProgram
use Libraries.Game.Graphics.Vulkan.Commands.DrawCommand
use Libraries.Game.Graphics.Models.Vulkan.EnvironmentVulkan
use Libraries.Game.Graphics.Shaders.Vulkan.Compute.AnimationComputeShaderVulkan
use Libraries.Game.Graphics.Vulkan.Commands.BindComputePipelineCommand
use Libraries.Game.Graphics.Models.Data.AnimationState
use Libraries.Game.Graphics.Models.Vulkan.MeshVulkan
use Libraries.Game.Graphics.Models.Vulkan.AnimationFrameVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelResourcesVulkan
use Libraries.Compute.Math
use Libraries.Game.Graphics.Vulkan.Commands.ComputeShaderDispatchCommand
use Libraries.Game.Graphics.Shaders.Vulkan.VulkanShaderManager
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Compute.Vector3
use Libraries.Compute.Vector4

class VulkanPainter3D is Painter3D
    
    GameStateManager gameState
    Math math
    VulkanRenderPass sceneRenderPass = undefined
    VulkanRenderPass shadowRenderPass = undefined
    VulkanRenderPass lightRenderPass = undefined
    VulkanRenderPass resultRenderPass = undefined
    ShaderProgram defaultProgram = undefined
    ShaderProgram defaultLightingProgram = undefined
    ShaderProgram defaultShadowProgram = undefined
    
    // The clear value for the scene-space is not the same background clear value used for the swapchain.
    // It must be fully transparent to ensure proper blending with other layers.
    VulkanClearValues sceneClearValues
    VulkanClearValues shadowClearValues
    VulkanClearValues lightClearValues
    
    // Resources for the Camera uniform.
    Array<VulkanBuffer> cameraBuffers
    Array<VulkanNumber32BitMappedMemory> cameraMappings
    Array<VulkanDescriptorSet> cameraDescriptors
    Camera camera = undefined
    
    // An internal array used to transfer data from Matrix4 objects to mapped memory.
    Number32BitArray matrix4Array
    
    // The sampler used to access textures.
VulkanSampler immutableSampler = undefined
    
    integer viewportX = 0
    integer viewportY = 0
    integer viewportWidth = 0
    integer viewportHeight = 0
    
    HashTable<ModelBlueprint, VulkanPainter3DBatch> batches
    HashTable<ModelBlueprint,VulkanPainter3DBatch> transparentBatches
    Array<VulkanPainter3DBatch> pendingBatches
    Array<VulkanPainter3DBatch> pendingTransparentBatches
    
    // Batches for models drawn with their own shader program instead of the
    // default one. There is one table per program, keyed by blueprint like
    // batches and transparentBatches.
    HashTable<ShaderProgram, HashTable<ModelBlueprint, VulkanPainter3DBatch>> programBatches
    HashTable<ShaderProgram, HashTable<ModelBlueprint, VulkanPainter3DBatch>> programTransparentBatches

    // The model manager's release count when batches were last checked
    // for released blueprints (Item 33).
    integer releasesSeen = 0
    
    // Arrays of draw queues. There is one array per swapchain image, and each array contains up to as many draw queues as there are texture groups in the VulkanTextureManager.
    // Used to bulk store instance data and draw indirect commands.
    Array<Array<VulkanDrawQueue3D>> drawQueues
    
    // Draw queues for models drawn with their own shader program. For each
    // program there is one array per swapchain image, laid out like
    // drawQueues. customPrograms keeps the programs in the order they were
    // first used, so they are drawn in the same order every frame.
    HashTable<ShaderProgram, Array<Array<VulkanDrawQueue3D>>> programDrawQueues
    Array<ShaderProgram> customPrograms
    
    // An array of models with active animations. These will be pre-processed in a compute shader to calculate the current position of their vertices before rendering.
    Array<Model> animatedModels
    
    // Resources for the animation compute shader stage. Undefined until a model with an active animation is rendered.
    VulkanComputePipeline animationPipeline = undefined
    VulkanFence animationFence = undefined
    VulkanPushConstantBuffer animationPushConstants = undefined
    integer animationLocalSizeX = -1
    
    // A reusable buffer of data for sending push constants. Used to send a pointer to a DrawQueue's instance data during rendering.
    VulkanPushConstantBuffer pushConstants
    
    // Another push constant buffer, this time for the shadow mapping phase.
    VulkanPushConstantBuffer shadowPushConstants = undefined

    // The layer's skybox (Item 26), drawn first in the result pass. Each
    // frame slot has its own descriptor set for the cube, linked again only
    // when the cube's view changes.
    Skybox skybox = undefined
    VulkanPushConstantBuffer skyboxPushConstants = undefined
    VulkanDescriptorSetLayout skyboxLayout = undefined
    Array<VulkanDescriptorSet> skyboxDescriptors
    Array<VulkanImageView> skyboxLinkedViews
    
    integer DEFAULT_MAX_INSTANCES = 8192
    
    // A dummy vertex buffer. Without extensions to bypass it, the Vulkan spec requires we bind something to the vertex buffers, even if our pipeline doesn't need it due to bindless rendering.
    VulkanBuffer dummyVertexBuffer = undefined
    
    /*Resources for the lighting step.*/
    Array<VulkanFramebuffer> lightFramebuffers
    Array<VulkanDescriptorSet> lightDescriptors
    Array<VulkanDescriptorSet> lightShadowDataDescriptors
    Array<VulkanDescriptorSet> lightShadowCubemapDescriptors
    
    /*An array of framebuffers, used to render to blank images each frame. Unlike 2D, which can draw directly onto the previous image, 3D needs to
post-process the environment without interference from the rendering of previous layers. There is one framebuffer per image in the swapchain,
to allow for simultaneous rendering.*/
    Array<VulkanFramebuffer> renderFramebuffers
    /*An array of descriptor sets used with the result render pass.*/
    Array<VulkanDescriptorSet> resultDescriptors
    
    // Resources for the shadow mapping stage.
    Array<VulkanDescriptorSet> shadowProjectionDescriptors
    boolean shadowProjectionResourcesLinked = false
    
    Array<Array<VulkanFramebuffer>> shadowCubemapFramebuffers

    // For each frame slot, each light's shadow map view, in light order,
    // so the maps can be linked into new lighting descriptor sets when the
    // passes are made again (Item 30).
    Array<Array<VulkanImageView>> shadowMapViews

    // How many calls in a row the current slot had more shadow maps than
    // lights. Past SHADOW_MAP_KEEP_CALLS, the extra maps are freed (Item 35).
    integer extraShadowMapCalls = 0
    constant integer SHADOW_MAP_KEEP_CALLS = 180
    
    
    // Used to create combined image-sampler descriptors. Accesses the individual values in a sampled image.
    VulkanSampler resultSampler = undefined
    VulkanSampler shadowSampler = undefined
    
    EnvironmentVulkan environment = undefined
    
    boolean renderShadows = true
    
    // Whether the current frame is paused because the window is minimized.
    // Set in Begin. While it is true, Render ignores models, since End won't
    // draw them or empty the batches, and they would pile up frame after frame.
    boolean framePaused = false
    boolean renderCascadesSeparately = false

    // MSAA (Item 27): the sample count the scene pass was last built with,
    // and the multisampled images it draws into, shared by every frame's
    // framebuffer (they are transient, and each frame's scene pass waits
    // for the previous one's writes).
    integer sceneSampleCount = 1

    // The swapchain size the framebuffers below were made at. When the
    // window is resized, the swapchain changes size and Begin makes them
    // again (Item 28).
    integer framebufferWidth = 0
    integer framebufferHeight = 0

    // Every image, and its view, made for those framebuffers (G-buffer,
    // depth, lighting, MSAA), so they can be freed when they are made again.
    Array<VulkanImage> sizedImages
    Array<VulkanImageView> sizedImageViews
    
on create
        matrix4Array:SetSize(16)
        //Create the push constants buffer with a size of 8 bytes (one 64-bit pointer). 
        pushConstants:Create(8)
    end

    action AreRenderPassesValid returns boolean
        return sceneRenderPass not= undefined and resultRenderPass not= undefined
    end

    action RegenerateRenderPasses(boolean isFirstPass) returns boolean
        // Begin has already retired any old passes (Item 32).

        VulkanRenderPass sceneRender
        sceneRenderPass = sceneRender
        VulkanRenderPass shadowRender
        shadowRenderPass = shadowRender
        VulkanRenderPass lightRender
        lightRenderPass = lightRender
        VulkanRenderPass resultRender
        resultRenderPass = resultRender
        
        if not renderFramebuffers:IsEmpty()
            repeat until renderFramebuffers:IsEmpty()
                renderFramebuffers:RemoveFromEnd():Dispose()
            end
        end
        if not lightFramebuffers:IsEmpty()
            repeat until lightFramebuffers:IsEmpty()
                lightFramebuffers:RemoveFromEnd():Dispose()
            end
        end

        // The images behind those framebuffers go too (Item 28).
        ReleaseSizedImages()
        
        // Shadow maps don't depend on the window's size, so they are kept
        // (Item 30); Item 35 frees them when lights are removed.

        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
VulkanSwapchain swapchain = graphics:GetSwapchain()
        VulkanDevice device = graphics:GetDevice()
        VulkanTextureManager textureManager = graphics:GetTextureManager()
        VulkanShaderManager shaderManager = cast(VulkanShaderManager, gameState:GetShaderManager())
        VulkanLightingProperties lightProperties = graphics:GetLightingProperties()
        VulkanConstants constants

        // The scene pass's sample count: 1, or the MSAA count (Item 27).
        sceneSampleCount = graphics:GetUsableMultisampleCount()
        boolean multisampled = sceneSampleCount > 1

        // Make sure we have an array of framebuffers for each image available in the swapchain.
        repeat while shadowCubemapFramebuffers:GetSize() < swapchain:GetImageCount()
            Array<VulkanFramebuffer> array
            shadowCubemapFramebuffers:Add(array)
        end
        
        if resultSampler = undefined
            VulkanSampler sampler
            VulkanSamplerInfo info
            info:SetHorizontalWrapMode(constants:SAMPLER_ADDRESS_MODE_REPEAT)
            info:SetVerticalWrapMode(constants:SAMPLER_ADDRESS_MODE_REPEAT)
            sampler:Create(device, info)
            resultSampler = sampler
        end
        if shadowSampler = undefined
            VulkanSampler sampler
            VulkanSamplerInfo info
            info:SetHorizontalWrapMode(constants:SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE)
            info:SetVerticalWrapMode(constants:SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE)
            sampler:Create(device, info)
            shadowSampler = sampler
        end
        
        
        /*Begin by creating all the attachment information we'll need. We need attachments to represent the outputs for our render passes.
The attachments we need correspond to our phases of rendering:
    * Scene:
        - Position
        - Albedo
        - Normals
        - Physical-Based Rendering (PBR) Properties
        - Depth
    * Shadows:
        - Moments (cubemap of distances from light to impact surfaces)
        - Depth
    * Lighting:
        - Color
    * Result (Copy to Swapchain Image)
        - Color
*/
        Array<VulkanAttachmentDescription> sceneAttachmentDescriptions
        Array<VulkanAttachmentReference> sceneColorAttachmentReferences
        Array<VulkanAttachmentDescription> shadowAttachmentDescriptions
        Array<VulkanAttachmentReference> shadowColorAttachmentReferences
        Array<VulkanAttachmentDescription> lightAttachmentDescriptions
        Array<VulkanAttachmentReference> lightColorAttachmentReferences
        Array<VulkanAttachmentDescription> resultAttachmentDescriptions
        
        // Scene render attachments. Without MSAA, the scene is drawn straight
        // into the four G-buffer images (attachments 0 to 3) and depth (4).
        // With MSAA (Item 27), it is drawn into multisampled copies
        // (attachments 5 to 8, and a multisampled depth at 4), which the
        // subpass resolves into the four G-buffer images as it finishes. The
        // lighting pass reads the G-buffer images either way.
        integer positionFormat = constants:FORMAT_R32G32B32A32_SFLOAT
        integer gBufferFormat = constants:FORMAT_R16G16B16A16_SFLOAT
        sceneAttachmentDescriptions:Add(MakeSceneColorAttachment(positionFormat, 1, multisampled))
        repeat 3 times
            sceneAttachmentDescriptions:Add(MakeSceneColorAttachment(gBufferFormat, 1, multisampled))
        end

        VulkanAttachmentDescription depthDescription
        depthDescription:SetFormat(constants:FORMAT_D32_SFLOAT)
        depthDescription:SetSamples(sceneSampleCount)
        depthDescription:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        depthDescription:SetStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        depthDescription:SetStencilLoadOp(constants:ATTACHMENT_LOAD_OP_DONT_CARE)
        depthDescription:SetStencilStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        depthDescription:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        depthDescription:SetFinalLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
        sceneAttachmentDescriptions:Add(depthDescription)

        Array<VulkanAttachmentReference> sceneResolveReferences = undefined
        if multisampled
            sceneAttachmentDescriptions:Add(MakeSceneColorAttachment(positionFormat, sceneSampleCount, false))
            repeat 3 times
                sceneAttachmentDescriptions:Add(MakeSceneColorAttachment(gBufferFormat, sceneSampleCount, false))
            end
            Array<VulkanAttachmentReference> resolveReferences
            sceneResolveReferences = resolveReferences
        end

        // Position, albedo, normals and PBR: drawn into 0 to 3, or into 5 to
        // 8 and resolved into 0 to 3.
        integer gBufferIndex = 0
        repeat while gBufferIndex < 4
            VulkanAttachmentReference colorReference
            if multisampled
                colorReference:SetAttachmentIndex(5 + gBufferIndex)
                VulkanAttachmentReference resolveReference
                resolveReference:SetAttachmentIndex(gBufferIndex)
                resolveReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
                sceneResolveReferences:Add(resolveReference)
            else
                colorReference:SetAttachmentIndex(gBufferIndex)
            end
            colorReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
            sceneColorAttachmentReferences:Add(colorReference)
            gBufferIndex = gBufferIndex + 1
        end

        VulkanAttachmentReference sceneDepthReference
        sceneDepthReference:SetAttachmentIndex(4)
        sceneDepthReference:SetLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)

        // Now that we have all of the required attachment info, create the scene render pass.
        CreateRenderPass(sceneRenderPass, sceneAttachmentDescriptions, sceneColorAttachmentReferences, sceneDepthReference, sceneResolveReferences)
        
        // Shadow render attachments.
        VulkanAttachmentDescription momentsAttachment
        momentsAttachment:SetFormat(constants:FORMAT_R32G32_SFLOAT)
        momentsAttachment:SetSamples(1)
        momentsAttachment:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        momentsAttachment:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
        momentsAttachment:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        momentsAttachment:SetFinalLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        shadowAttachmentDescriptions:Add(momentsAttachment)
        
        VulkanAttachmentDescription shadowDepthDescription
        shadowDepthDescription:SetFormat(constants:FORMAT_D32_SFLOAT)
        shadowDepthDescription:SetSamples(constants:SAMPLE_COUNT_1_BIT)
        shadowDepthDescription:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        shadowDepthDescription:SetStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
shadowDepthDescription:SetStencilLoadOp(constants:ATTACHMENT_LOAD_OP_DONT_CARE)
shadowDepthDescription:SetStencilStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        shadowDepthDescription:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        shadowDepthDescription:SetFinalLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
        shadowAttachmentDescriptions:Add(shadowDepthDescription)
        
        // Now, handle the attachment references for the shadow pass.
        VulkanAttachmentReference momentsReference
        momentsReference:SetAttachmentIndex(0)
        momentsReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        shadowColorAttachmentReferences:Add(momentsReference)
        
        VulkanAttachmentReference shadowDepthReference
        shadowDepthReference:SetAttachmentIndex(1)
        shadowDepthReference:SetLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
        
        // Now that we have all of the required attachment info, create the scene render pass.
        CreateRenderPass(shadowRenderPass, shadowAttachmentDescriptions, shadowColorAttachmentReferences, shadowDepthReference)
        
        // Lighting render attachments.
        VulkanAttachmentDescription lightColorAttachment
        lightColorAttachment:SetFormat(constants:FORMAT_R16G16B16A16_SFLOAT)
        lightColorAttachment:SetSamples(1)
        lightColorAttachment:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        lightColorAttachment:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
        lightColorAttachment:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        lightColorAttachment:SetFinalLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        lightAttachmentDescriptions:Add(lightColorAttachment)
        
        VulkanAttachmentReference lightColorReference
        lightColorReference:SetAttachmentIndex(0)
        lightColorReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        lightColorAttachmentReferences:Add(lightColorReference)
        
        // Now, create the lighting render pass.
        CreateRenderPass(lightRenderPass, lightAttachmentDescriptions, lightColorAttachmentReferences, undefined)
        
        // Final result rendering attachments: the same as the swapchain's
        // framebuffers, with or without 2D MSAA (Item 29). The first layer
        // clears; later layers draw on what earlier layers drew.
        VulkanSubpassDescription resultSubpass = graphics:MakeSwapchainSubpass(isFirstPass, resultAttachmentDescriptions)
        CreateRenderPass(resultRenderPass, resultAttachmentDescriptions, resultSubpass:GetColorAttachments(),
            resultSubpass:GetDepthStencilAttachment(), resultSubpass:GetResolveAttachments())
        
        // The descriptor sets, and the layouts they're made from, are made
        // the first time only. On later calls the sets are kept, and the
        // loop below links the new images into the lighting and result
        // sets. The shadow sets don't depend on the window's size (Item 32).
        
        // Before creating any shadow resources, check which version of the shadow shader programs we're using.
        // Calling this will lazy load the shaders if they haven't been created yet.
        GetDefaultShadowProgram()
        
        VulkanDescriptorSetLayout shadowProjectionLayout = undefined
        if shadowProjectionDescriptors:GetSize() < swapchain:GetImageCount()
            VulkanDescriptorSetLayout descriptorLayout
            shadowProjectionLayout = descriptorLayout
            Array<VulkanDescriptorSetLayoutBinding> shadowBindings
            
            // First, create a binding for the shadow projection matrices. These are used in the geometry phase.
            VulkanDescriptorSetLayoutBinding projectionBinding
            projectionBinding:SetBinding(0)
            projectionBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
            projectionBinding:SetDescriptorCount(1)
            if renderCascadesSeparately = false
                projectionBinding:SetStageFlags(constants:SHADER_STAGE_GEOMETRY_BIT + constants:SHADER_STAGE_FRAGMENT_BIT)
            else
                projectionBinding:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT + constants:SHADER_STAGE_FRAGMENT_BIT)
            end
            shadowBindings:Add(projectionBinding)
            
            // Set = 0, Binding = 1 will be the immutable sampler for textures.
        VulkanDescriptorSetLayoutBinding samplerBinding
            samplerBinding:SetBinding(1)
            samplerBinding:SetDescriptorCount(1)
            samplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_SAMPLER)
            samplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
        Array<VulkanSampler> immutableSamplers
        VulkanSampler immutableSampler = textureManager:GetDefaultSampler()
        immutableSamplers:Add(immutableSampler)
        samplerBinding:SetImmutableSamplers(immutableSamplers)
            shadowBindings:Add(samplerBinding)
            
            shadowProjectionLayout:Create(device, shadowBindings)
        end
        
        VulkanDescriptorSetLayout lightsLayout = undefined
        VulkanDescriptorSetLayout lightShadowProjectionLayout = undefined
        if lightDescriptors:GetSize() < swapchain:GetImageCount()
            VulkanDescriptorSetLayout descriptorLayout
            lightsLayout = descriptorLayout
            Array<VulkanDescriptorSetLayoutBinding> lightsBindings
            
            // Describe the binding of the uniform buffers.
            VulkanDescriptorSetLayoutBinding positionSamplerBinding
            positionSamplerBinding:SetBinding(0)
            positionSamplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            positionSamplerBinding:SetDescriptorCount(1)
            positionSamplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            lightsBindings:Add(positionSamplerBinding)
            
            VulkanDescriptorSetLayoutBinding albedoSamplerBinding
            albedoSamplerBinding:SetBinding(1)
            albedoSamplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            albedoSamplerBinding:SetDescriptorCount(1)
            albedoSamplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            lightsBindings:Add(albedoSamplerBinding)
            
            VulkanDescriptorSetLayoutBinding normalsSamplerBinding
            normalsSamplerBinding:SetBinding(2)
            normalsSamplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            normalsSamplerBinding:SetDescriptorCount(1)
            normalsSamplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            lightsBindings:Add(normalsSamplerBinding)
            
            VulkanDescriptorSetLayoutBinding pbrSamplerBinding
            pbrSamplerBinding:SetBinding(3)
            pbrSamplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            pbrSamplerBinding:SetDescriptorCount(1)
            pbrSamplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            lightsBindings:Add(pbrSamplerBinding)
            
            lightsLayout:Create(device, lightsBindings)
            
            lightShadowProjectionLayout = lightProperties:GetShadowCubemapsDescriptorSetLayout()
        end
        
        VulkanDescriptorSetLayout resultsLayout = undefined
        if resultDescriptors:GetSize() < swapchain:GetImageCount()
            // Initialize the DescriptorSetLayouts that will describe how our uniforms will be sent to the device.
            // Define how our uniforms will be laid out.
            VulkanDescriptorSetLayout descriptorLayout
            resultsLayout = descriptorLayout
            Array<VulkanDescriptorSetLayoutBinding> resultsBindings            

            // Describe the binding of the uniform buffers.
            VulkanDescriptorSetLayoutBinding samplerBinding
            samplerBinding:SetBinding(0)
            samplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            samplerBinding:SetDescriptorCount(1)
            samplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            resultsBindings:Add(samplerBinding)

            resultsLayout:Create(device, resultsBindings)
        end
        
        VulkanDescriptorSetManager descriptorSetManager = graphics:GetDescriptorSetManager()
        
        // Create (or regenerate) our framebuffers. We need images to store data that reflects the attachments defined above.
        integer i = 0
        integer swapchainWidth = swapchain:GetImageWidth()
        integer swapchainHeight = swapchain:GetImageHeight()
        framebufferWidth = swapchainWidth
        framebufferHeight = swapchainHeight

        // With MSAA, the multisampled images every frame draws into: position,
        // albedo, normals, PBR, and depth (Item 27).
        Array<VulkanImageView> multisampledViews
        VulkanImageView multisampledDepthView = undefined
        if multisampled
            multisampledViews:Add(MakeMultisampledView(device, constants:FORMAT_R32G32B32A32_SFLOAT,
                constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT, constants:IMAGE_ASPECT_COLOR_BIT, swapchainWidth, swapchainHeight))
            repeat 3 times
                multisampledViews:Add(MakeMultisampledView(device, constants:FORMAT_R16G16B16A16_SFLOAT,
                    constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT, constants:IMAGE_ASPECT_COLOR_BIT, swapchainWidth, swapchainHeight))
            end
            multisampledDepthView = MakeMultisampledView(device, constants:FORMAT_D32_SFLOAT,
                constants:IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT, constants:IMAGE_ASPECT_DEPTH_BIT, swapchainWidth, swapchainHeight)
        end
        repeat while i < swapchain:GetImageCount()
            VulkanFramebuffer renderFramebuffer
            Array<VulkanImageView> renderImageViews
            
            // The position color attachment has a larger bit-depth than the other color attachments, so do that separately.
            VulkanImageInfo positionImageInfo
            positionImageInfo:SetWidth(swapchainWidth)
            positionImageInfo:SetHeight(swapchainHeight)
            positionImageInfo:SetFormat(constants:FORMAT_R32G32B32A32_SFLOAT)
            positionImageInfo:SetUsage(constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT + constants:IMAGE_USAGE_SAMPLED_BIT)
            VulkanImage positionImage
            positionImage:Create(device, positionImageInfo)
            
            VulkanImageViewInfo positionImageViewInfo
                positionImageViewInfo:SetFormat(positionImageInfo:GetFormat())
                VulkanImageView positionImageView
                positionImageView:Create(device, positionImage, positionImageViewInfo)
                KeepSizedImage(positionImage, positionImageView)
                renderImageViews:Add(positionImageView)
            
            // The other color attachments all have the same properties, so they can be quickly created in a loop.
            integer j = 0
            repeat while j < 3
                VulkanImageInfo imageInfo
            imageInfo:SetWidth(swapchainWidth)
            imageInfo:SetHeight(swapchainHeight)
            imageInfo:SetFormat(constants:FORMAT_R16G16B16A16_SFLOAT)
            imageInfo:SetUsage(constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT + constants:IMAGE_USAGE_SAMPLED_BIT)
            VulkanImage image
            image:Create(device, imageInfo)
                
                VulkanImageViewInfo imageViewInfo
                imageViewInfo:SetFormat(imageInfo:GetFormat())
                VulkanImageView imageView
                imageView:Create(device, image, imageViewInfo)
                KeepSizedImage(image, imageView)
                renderImageViews:Add(imageView)
                
                j = j + 1
            end
            
            // Depth: the shared multisampled one with MSAA, or this frame's own.
            if multisampled
                renderImageViews:Add(multisampledDepthView)
            else
                VulkanImageInfo depthImageInfo
                depthImageInfo:SetWidth(swapchainWidth)
                depthImageInfo:SetHeight(swapchainHeight)
                depthImageInfo:SetUsage(constants:IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
                depthImageInfo:SetFormat(constants:FORMAT_D32_SFLOAT)

                VulkanImage depthImage
                depthImage:Create(device, depthImageInfo)

                VulkanImageViewInfo depthViewInfo
                depthViewInfo:SetAspectMask(constants:IMAGE_ASPECT_DEPTH_BIT)
                depthViewInfo:SetFormat(depthImageInfo:GetFormat())

                VulkanImageView depthImageView
                depthImageView:Create(device, depthImage, depthViewInfo)
                KeepSizedImage(depthImage, depthImageView)
                renderImageViews:Add(depthImageView)
            end

            // With MSAA, the multisampled G-buffer images come after depth,
            // at 5 to 8.
            integer multisampledIndex = 0
            repeat while multisampledIndex < multisampledViews:GetSize()
                renderImageViews:Add(multisampledViews:Get(multisampledIndex))
                multisampledIndex = multisampledIndex + 1
            end
            
            renderFramebuffer:Create(device, renderImageViews, sceneRenderPass)
            renderFramebuffers:Add(renderFramebuffer)
            
            // Also create the light framebuffer.
            VulkanFramebuffer lightFramebuffer
            Array<VulkanImageView> lightImageViews
            
            VulkanImageInfo imageInfo
            imageInfo:SetWidth(swapchainWidth)
            imageInfo:SetHeight(swapchainHeight)
            imageInfo:SetFormat(constants:FORMAT_R16G16B16A16_SFLOAT)
            imageInfo:SetUsage(constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT + constants:IMAGE_USAGE_SAMPLED_BIT)
            VulkanImage image
            image:Create(device, imageInfo)
                
                VulkanImageViewInfo imageViewInfo
                imageViewInfo:SetFormat(imageInfo:GetFormat())
                VulkanImageView imageView
                imageView:Create(device, image, imageViewInfo)
                KeepSizedImage(image, imageView)
                lightImageViews:Add(imageView)
            
            lightFramebuffer:Create(device, lightImageViews, lightRenderPass)
            lightFramebuffers:Add(lightFramebuffer)
            
            // Also ensure we have all the descriptor sets we need for the shadow, lighting, and result stages.
            if shadowProjectionLayout not= undefined
                VulkanDescriptorSet shadowSet = descriptorSetManager:CreateDescriptorSet(shadowProjectionLayout)
                shadowProjectionDescriptors:Add(shadowSet)
            end
            if lightsLayout not= undefined
                VulkanDescriptorSet lightSet = descriptorSetManager:CreateDescriptorSet(lightsLayout)
                lightDescriptors:Add(lightSet)
            end
            if lightShadowProjectionLayout not= undefined
                VulkanDescriptorSet projectionSet = descriptorSetManager:CreateDescriptorSet(lightShadowProjectionLayout, constants:DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT)
                lightShadowDataDescriptors:Add(projectionSet)
            end
            if resultsLayout not= undefined
                VulkanDescriptorSet resultSet = descriptorSetManager:CreateDescriptorSet(resultsLayout)
                resultDescriptors:Add(resultSet)
            end
            
            VulkanDescriptorSet lightSet = lightDescriptors:Get(i)
            // Link up all four of the attachments out from the scene rendering stage as descriptor inputs to the lighting stage.
            j = 0
            repeat while j < 4
                VulkanDescriptorResourcesInfo lightResources
            VulkanDescriptorImageInfo lightImage
            lightImage:SetImageView(renderImageViews:Get(j))
            lightImage:SetSampler(resultSampler)
            lightImage:SetImageLayout(constants:IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL)
            Array<VulkanDescriptorImageInfo> lightImages
            lightImages:Add(lightImage)
            lightResources:SetImageInfo(lightImages)
            lightResources:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
                lightResources:SetDestinationBinding(j)
            lightSet:LinkResources(lightResources)
                
                j = j + 1
            end
            
            // Also update the descriptor set used by the results phase to get the output from the lighting phase.
            VulkanDescriptorSet resultSet = resultDescriptors:Get(i)
            VulkanDescriptorResourcesInfo resultResources
            VulkanDescriptorImageInfo resultImage
            // Get the color attachment from the lighting pass. The output color from lighting is the source color of the result copy step.
            resultImage:SetImageView(lightImageViews:Get(0))
            resultImage:SetSampler(resultSampler)
            resultImage:SetImageLayout(constants:IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL)
            Array<VulkanDescriptorImageInfo> resultImages
            resultImages:Add(resultImage)
            resultResources:SetImageInfo(resultImages)
            resultResources:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            resultSet:LinkResources(resultResources)
            
            i = i + 1
        end

        // The shadow sets are kept (Item 32), so this only links again what
        // is already linked. It is kept in case the sets are ever made again
        // (Item 30).
        shadowProjectionResourcesLinked = false
        integer slot = 0
        repeat while slot < shadowMapViews:GetSize() and slot < lightShadowDataDescriptors:GetSize()
            Array<VulkanImageView> views = shadowMapViews:Get(slot)
            integer light = 0
            repeat while light < views:GetSize()
                LinkShadowMap(slot, light, views:Get(light))
                light = light + 1
            end
            slot = slot + 1
        end

        return true
    end
    
    private action CreateRenderPass(VulkanRenderPass renderPass,
Array<VulkanAttachmentDescription> attachmentDescriptions,
Array<VulkanAttachmentReference> colorReferences,
VulkanAttachmentReference depthReference) returns boolean
        return CreateRenderPass(renderPass, attachmentDescriptions, colorReferences, depthReference, undefined)
    end

    /*
    This action makes a render pass with one subpass. With resolve
    references, the subpass resolves each multisampled color attachment
    into the matching single-sample one as it finishes (Item 27).
    */
    private action CreateRenderPass(VulkanRenderPass renderPass,
Array<VulkanAttachmentDescription> attachmentDescriptions,
Array<VulkanAttachmentReference> colorReferences,
VulkanAttachmentReference depthReference,
Array<VulkanAttachmentReference> resolveReferences) returns boolean
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanConstants constants

        VulkanSubpassDescription subpass
        subpass:SetPipelineBindPoint(constants:PIPELINE_BIND_POINT_GRAPHICS)
        subpass:SetColorAttachments(colorReferences)
        subpass:SetDepthStencilAttachment(depthReference)
        if resolveReferences not= undefined
            subpass:SetResolveAttachments(resolveReferences)
        end

        Array<VulkanSubpassDescription> subpassDescriptions
        subpassDescriptions:Add(subpass)

        VulkanSubpassDependency dependency
        dependency:SetSourceSubpass(constants:SUBPASS_EXTERNAL)
        dependency:SetDestinationSubpass(0)
        dependency:SetSourceStageMask(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT + constants:PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT)
        dependency:SetDestinationStageMask(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT + constants:PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT)
        // Color writes too, so a pass waits for the previous frame's writes
        // to attachments they share, such as the MSAA images (Item 27).
        dependency:SetSourceAccessMask(constants:ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT + constants:ACCESS_COLOR_ATTACHMENT_WRITE_BIT)
        dependency:SetDestinationAccessMask(constants:ACCESS_COLOR_ATTACHMENT_WRITE_BIT + constants:ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)

        Array<VulkanSubpassDependency> subpassDependencies
        subpassDependencies:Add(dependency)

        boolean success = renderPass:Create(graphics:GetDevice(), attachmentDescriptions, subpassDescriptions, subpassDependencies)
        return success
    end

    /*
    This action describes one of the scene pass's color attachments.

    Attribute: Parameter format The image format.
    Attribute: Parameter samples 1, or the MSAA sample count.
    Attribute: Parameter resolveTarget True for a G-buffer image that a multisampled one resolves into.
    Attribute: Returns The attachment description.
    */
    private action MakeSceneColorAttachment(integer format, integer samples, boolean resolveTarget) returns VulkanAttachmentDescription
        VulkanConstants constants
        VulkanAttachmentDescription attachment
        attachment:SetFormat(format)
        attachment:SetSamples(samples)
        if resolveTarget
            // Only the resolve writes it, so its old contents don't matter,
            // and it is stored for the lighting pass.
            attachment:SetLoadOp(constants:ATTACHMENT_LOAD_OP_DONT_CARE)
            attachment:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
        elseif samples > 1
            // Multisampled: cleared, drawn and resolved, never stored, so it
            // can stay in the GPU's tile memory.
            attachment:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
            attachment:SetStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        else
            attachment:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
            attachment:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
        end
        attachment:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        attachment:SetFinalLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        return attachment
    end

    /*
    This action makes one multisampled image for MSAA, and a view of it. It
    is transient, and asks for lazily allocated memory, which tile-based
    GPUs (Apple's, and phones') keep in tile memory only; other GPUs give it
    ordinary memory.

    Attribute: Parameter device The Vulkan device.
    Attribute: Parameter format The image format.
    Attribute: Parameter usage Color or depth attachment usage.
    Attribute: Parameter aspect The color or depth aspect, for the view.
    Attribute: Parameter width The width in pixels.
    Attribute: Parameter height The height in pixels.
    Attribute: Returns The image's view.
    */
    private action MakeMultisampledView(VulkanDevice device, integer format, integer usage, integer aspect,
            integer width, integer height) returns VulkanImageView
        VulkanConstants constants
        VulkanImageInfo info
        info:SetWidth(width)
        info:SetHeight(height)
        info:SetFormat(format)
        info:SetSamples(sceneSampleCount)
        info:SetUsage(usage + constants:IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)
        info:SetPreferredMemoryFlags(constants:MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT)
        VulkanImage image
        if not image:Create(device, info)
            alert("I couldn't make a multisampled image for MSAA with " + sceneSampleCount + " samples.")
        end

        VulkanImageViewInfo viewInfo
        viewInfo:SetFormat(format)
        viewInfo:SetAspectMask(aspect)
        VulkanImageView view
        view:Create(device, image, viewInfo)
        KeepSizedImage(image, view)
        return view
    end

    /*
    This action remembers an image, and its view, made for the painter's
    framebuffers, so ReleaseSizedImages can free them when the framebuffers
    are made again (Item 28).

    Attribute: Parameter image The image.
    Attribute: Parameter view Its view.
    */
    private action KeepSizedImage(VulkanImage image, VulkanImageView view)
        sizedImages:Add(image)
        sizedImageViews:Add(view)
    end

    /*
    This action frees every image, and view, made for the painter's
    framebuffers: views first, then images. It is called once the
    framebuffers using them are gone, after the device has finished with
    them (Begin waits for it).
    */
    private action ReleaseSizedImages
        integer i = 0
        repeat while i < sizedImageViews:GetSize()
            sizedImageViews:Get(i):Dispose()
            i = i + 1
        end
        i = 0
        repeat while i < sizedImages:GetSize()
            sizedImages:Get(i):Dispose()
            i = i + 1
        end
        sizedImageViews:Empty()
        sizedImages:Empty()
    end

    /*
    This action returns true if a pipeline must be made (again): it doesn't
    exist yet, or it was made for a different sample count than its pass
    now uses (Items 27 and 29).

    Attribute: Parameter pipeline The pipeline, or undefined.
    Attribute: Parameter samples The sample count of the pass it draws in.
    Attribute: Returns True if it must be made.
    */
    private action NeedsPipeline(VulkanPipeline pipeline, integer samples) returns boolean
        if pipeline = undefined
            return true
        end
        return pipeline:GetInfo():GetRasterizationSamples() not= samples
    end
    
    /*
    This action links one light's shadow map into a frame slot's lighting
    descriptor set (set 2, binding 1, at the light's place in the array).

    Attribute: Parameter resourceIndex The frame slot.
    Attribute: Parameter lightIndex The light's place.
    Attribute: Parameter view The light's shadow map view.
    */
    private action LinkShadowMap(integer resourceIndex, integer lightIndex, VulkanImageView view)
        VulkanConstants constants
        VulkanDescriptorSet shadowProjectionSet = lightShadowDataDescriptors:Get(resourceIndex)

        VulkanDescriptorResourcesInfo shadowOutputResources
        VulkanDescriptorImageInfo shadowOutputInfo
        shadowOutputInfo:SetImageView(view)
        shadowOutputInfo:SetSampler(shadowSampler)
        shadowOutputInfo:SetImageLayout(constants:IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL)
        Array<VulkanDescriptorImageInfo> shadowOutputImages
        shadowOutputImages:Add(shadowOutputInfo)
        shadowOutputResources:SetImageInfo(shadowOutputImages)
        shadowOutputResources:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
        shadowOutputResources:SetDestinationBinding(1)
        shadowOutputResources:SetDestinationArrayElement(lightIndex)
        shadowProjectionSet:LinkResources(shadowOutputResources)
    end

    /*
    This action makes sure the frame slot has a shadow map, with its
    framebuffer, for each light, sized for the light's type: one layer per
    cascade for a directional light, six per cascade for a point light.
    Maps that no longer fit their light are replaced, and maps past the
    light count are freed once unused for a while. Old maps are freed when
    no frame still draws with them (Item 35).

    Attribute: Parameter resourceIndex The frame slot.
    */
    private action EnsureShadowMaps(integer resourceIndex)
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanLightingProperties lightProperties = graphics:GetLightingProperties()
        integer cascades = lightProperties:GetShadowMapCascadeCount()

        integer directionalCount = environment:GetDirectionalLightCount()
        integer totalLights = directionalCount + environment:GetPointLightCount()
        if totalLights > environment:GetMaxLights()
            totalLights = environment:GetMaxLights()
        end

        repeat while shadowMapViews:GetSize() <= resourceIndex
            Array<VulkanImageView> newViews
            shadowMapViews:Add(newViews)
        end
        Array<VulkanFramebuffer> framebuffers = shadowCubemapFramebuffers:Get(resourceIndex)
        Array<VulkanImageView> views = shadowMapViews:Get(resourceIndex)

        integer i = 0
        repeat while i < totalLights
            integer layers = cascades * 6
            if i < directionalCount
                layers = cascades
            end
            if i >= framebuffers:GetSize()
                VulkanFramebuffer made = MakeShadowMap(layers)
                framebuffers:Add(made)
                views:Add(made:GetImageViews():Get(0))
                LinkShadowMap(resourceIndex, i, made:GetImageViews():Get(0))
            else
                VulkanFramebuffer existing = framebuffers:Get(i)
                if existing:GetImageViews():Get(0):GetInfo():GetLayerCount() not= layers
                    RetireShadowMap(existing, graphics)
                    VulkanFramebuffer remade = MakeShadowMap(layers)
                    framebuffers:Set(i, remade)
                    views:Set(i, remade:GetImageViews():Get(0))
                    LinkShadowMap(resourceIndex, i, remade:GetImageViews():Get(0))
                end
            end
            i = i + 1
        end

        if framebuffers:GetSize() > totalLights
            extraShadowMapCalls = extraShadowMapCalls + 1
            if extraShadowMapCalls >= SHADOW_MAP_KEEP_CALLS
                repeat while framebuffers:GetSize() > totalLights
                    RetireShadowMap(framebuffers:RemoveFromEnd(), graphics)
                    views:RemoveFromEnd()
                end
            end
        else
            extraShadowMapCalls = 0
        end
    end

    /*
    This action makes one shadow map: a color image (the depth moments)
    and a depth image, each with the given number of layers, their views,
    and a framebuffer for the shadow pass. The color view comes first in
    the framebuffer.

    Attribute: Parameter layers How many layers each image has.
    Attribute: Returns The framebuffer.
    */
    private action MakeShadowMap(integer layers) returns VulkanFramebuffer
        VulkanConstants constants
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanDevice device = graphics:GetDevice()
        integer size = graphics:GetLightingProperties():GetShadowMapSize()

        VulkanImageInfo colorInfo
        colorInfo:SetWidth(size)
        colorInfo:SetHeight(size)
        colorInfo:SetFormat(constants:FORMAT_R32G32_SFLOAT)
        colorInfo:SetUsage(constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT + constants:IMAGE_USAGE_SAMPLED_BIT)
        colorInfo:SetArrayLayers(layers)
        VulkanImage colorImage
        colorImage:Create(device, colorInfo)
        VulkanImageViewInfo colorViewInfo
        colorViewInfo:SetFormat(colorInfo:GetFormat())
        colorViewInfo:SetViewType(constants:IMAGE_VIEW_TYPE_2D_ARRAY)
        colorViewInfo:SetLayerCount(layers)
        VulkanImageView colorView
        colorView:Create(device, colorImage, colorViewInfo)

        VulkanImageInfo depthInfo
        depthInfo:SetWidth(size)
        depthInfo:SetHeight(size)
        depthInfo:SetUsage(constants:IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
        depthInfo:SetFormat(constants:FORMAT_D32_SFLOAT)
        depthInfo:SetArrayLayers(layers)
        VulkanImage depthImage
        depthImage:Create(device, depthInfo)
        VulkanImageViewInfo depthViewInfo
        depthViewInfo:SetAspectMask(constants:IMAGE_ASPECT_DEPTH_BIT)
        depthViewInfo:SetFormat(depthInfo:GetFormat())
        depthViewInfo:SetViewType(constants:IMAGE_VIEW_TYPE_2D_ARRAY)
        depthViewInfo:SetLayerCount(layers)
        VulkanImageView depthView
        depthView:Create(device, depthImage, depthViewInfo)

        Array<VulkanImageView> attachments
        attachments:Add(colorView)
        attachments:Add(depthView)
        VulkanFramebuffer framebuffer
        framebuffer:Create(device, attachments, shadowRenderPass)
        return framebuffer
    end

    /*
    This action frees a shadow map's framebuffer, views and images once no
    frame on the GPU still uses them.

    Attribute: Parameter framebuffer The shadow map's framebuffer.
    Attribute: Parameter graphics The Vulkan graphics.
    */
    private action RetireShadowMap(VulkanFramebuffer framebuffer, VulkanGraphics graphics)
        Array<VulkanImageView> attachments = framebuffer:GetImageViews()
        graphics:Retire(framebuffer)
        integer i = 0
        repeat while i < attachments:GetSize()
            VulkanImageView view = attachments:Get(i)
            graphics:Retire(view)
            graphics:Retire(view:GetImage())
            i = i + 1
        end
    end
    
    action GetDefaultProgram returns ShaderProgram
        if defaultProgram = undefined
            ShaderManager shaders = gameState:GetShaderManager()
            defaultProgram = shaders:GetDefaultShaderProgram3D()
        end
        
        return defaultProgram
    end
    
    action GetDefaultShadowPipeline returns VulkanPipeline
        ShaderProgram program = GetDefaultShadowProgram()
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        return strategy:GetPipeline()
    end
    
    action GetDefaultShadowProgram returns ShaderProgram
        if defaultShadowProgram = undefined
            VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
            VulkanPhysicalDeviceFeatures features = graphics:GetPhysicalDevice():GetFeatures()
            ShaderManager shaders = gameState:GetShaderManager()
            
            VulkanPushConstantBuffer pushConstants
            shadowPushConstants = pushConstants
            
            if features:HasGeometryShader()
            defaultShadowProgram = shaders:GetDefaultShadowShaderProgram()
                renderCascadesSeparately = false
                
                // The shadows need a pointer to a buffer (8-bytes) plus two additional uints (4-bytes each).
        shadowPushConstants:Create(16)
            elseif features:HasShaderOutputLayer()
                defaultShadowProgram = shaders:GetTwoStageShadowShaderProgram()
                renderCascadesSeparately = true
                
                // If there's no available geometry shader, the push constants need to store two additional uints (4-bytes each).
                shadowPushConstants:Create(24)
            else
                return undefined
            end
        end
        
        return defaultShadowProgram
    end
    
    action GetDefaultLightingPipeline returns VulkanPipeline
        ShaderProgram program = GetDefaultLightingProgram()
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        return strategy:GetPipeline()
    end
    
    action GetDefaultLightingProgram returns ShaderProgram
        if defaultLightingProgram = undefined
            ShaderManager shaders = gameState:GetShaderManager()
            defaultLightingProgram = shaders:GetDefaultLightingShaderProgram()
        end
        
        return defaultLightingProgram
    end
    
    action GetDefaultPipeline returns VulkanPipeline
        ShaderProgram program = GetDefaultProgram()
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        return strategy:GetPipeline()
    end
    
    private action GetCopyFromSamplerProgram returns CopyFromSamplerShaderProgram
        ShaderManager manager = gameState:GetShaderManager()
        CopyFromSamplerShaderProgram program = cast(CopyFromSamplerShaderProgram, manager:GetCopyFromSamplerShaderProgram())
        return program
    end
    
    action GetCopyFromSamplerPipeline returns VulkanPipeline
        ShaderProgram program = GetCopyFromSamplerProgram()
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        return strategy:GetPipeline()
    end
    
    action SetCamera(Camera camera)
        me:camera = camera
    end
    
    private action GetBatch(Model model) returns VulkanPainter3DBatch
        ShaderProgram program = GetCustomProgram(model)
        if program not= undefined
            return GetProgramBatch(model, program)
        end
        
        boolean isTransparent = model:HasTransparency()
        ModelBlueprintVulkan schematic = cast(ModelBlueprintVulkan, model:GetModelBlueprint())
        if not isTransparent
if batches:HasKey(schematic)
            return batches:GetValue(schematic)
        else
            // This is our first time using this ModelBlueprint.
            VulkanPainter3DBatch batch = NewBatch(model, isTransparent)
            batches:Add(schematic, batch)
            return batch
        end
            else
            if transparentBatches:HasKey(schematic)
                return transparentBatches:GetValue(schematic)
            else
                // This is our first time using this ModelBlueprint.
            VulkanPainter3DBatch batch = NewBatch(model, isTransparent)
            transparentBatches:Add(schematic, batch)
            return batch
            end
        end
    end

    /*
    This action returns the shader program a model asks to be drawn with,
    or undefined if it should be drawn with the default program. A model
    given the default program itself is drawn with the default batches.

    Attribute: Parameter model The model being drawn.
    Attribute: Returns The model's own program, or undefined for the default.
    */
    private action GetCustomProgram(Model model) returns ShaderProgram
        ShaderProgram program = model:GetShaderProgram()
        if program = undefined
            return undefined
        end
        ShaderProgram defaultOne = GetDefaultProgram()
        if program = defaultOne
            return undefined
        end
        return program
    end
    
    /*
    This action finds or makes the batch for a model drawn with its own
    shader program. The first time a program is seen, it is checked.

    Attribute: Parameter model The model being drawn.
    Attribute: Parameter program The model's own shader program.
    Attribute: Returns The batch for the model's blueprint and program.
    */
    private action GetProgramBatch(Model model, ShaderProgram program) returns VulkanPainter3DBatch
        boolean isTransparent = model:HasTransparency()
        ModelBlueprintVulkan schematic = cast(ModelBlueprintVulkan, model:GetModelBlueprint())
        
        HashTable<ShaderProgram, HashTable<ModelBlueprint, VulkanPainter3DBatch>> tables = programBatches
        if isTransparent
            tables = programTransparentBatches
        end
        
        HashTable<ModelBlueprint, VulkanPainter3DBatch> table = undefined
        if tables:HasKey(program)
            table = tables:GetValue(program)
        else
            CheckCustomProgram(program)
            HashTable<ModelBlueprint, VulkanPainter3DBatch> newTable
            tables:Add(program, newTable)
            table = newTable
        end
        
        if table:HasKey(schematic)
            return table:GetValue(schematic)
        end
        VulkanPainter3DBatch batch
        batch:Create(schematic, isTransparent, program)
        table:Add(schematic, batch)
        return batch
    end
    
    /*
    This action makes sure a custom program can draw 3D models: it is
    compiled, and its shader mapping uses the default 3D resources, so its
    layout matches what the painter binds.

    Attribute: Parameter program The program to check.
    */
    private action CheckCustomProgram(ShaderProgram program)
        if not program:IsCompiled()
            program:Compile()
        end
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        if not strategy:GetShaderMapping():UsesDefaultResources3D()
            alert("I can't draw 3D models with the shader program " + program:GetName() + " because its shader mapping doesn't use the default 3D resources. A DefaultShaderMapping3DVulkan does.")
        end
    end

    private action NewBatch(Model model, boolean isTransparent) returns VulkanPainter3DBatch
        VulkanPainter3DBatch batch
        ModelBlueprintVulkan blue = cast(ModelBlueprintVulkan, model:GetModelBlueprint())
        batch:Create(blue, isTransparent)
        return batch
    end
    
    action Begin
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        // Abort if rendering is paused due to window minimization.
        framePaused = graphics:IsRenderingPaused()
        if framePaused
            return now
        end
        
        if environment:GetCamera() = undefined
            environment:SetCamera(camera)
        end
        
        // If the window was resized (Item 28), or the game's MSAA sample
        // count changed (Item 27), since the passes and framebuffers were
        // made, make them again at the swapchain's size. Earlier frames may
        // still be using the old framebuffers, so wait for the device first.
        // The old passes are retired (Item 32); their framebuffers and
        // images are freed in RegenerateRenderPasses.
        if AreRenderPassesValid()
            VulkanSwapchain currentSwapchain = graphics:GetSwapchain()
            boolean resized = currentSwapchain:GetImageWidth() not= framebufferWidth or
                currentSwapchain:GetImageHeight() not= framebufferHeight
            if resized or graphics:GetUsableMultisampleCount() not= sceneSampleCount or
                resultRenderPass:GetSampleCount() not= graphics:GetSwapchainSampleCount()
                graphics:GetDevice():WaitUntilIdle()
                graphics:Retire(sceneRenderPass)
                graphics:Retire(shadowRenderPass)
                graphics:Retire(lightRenderPass)
                graphics:Retire(resultRenderPass)
                sceneRenderPass = undefined
                shadowRenderPass = undefined
                lightRenderPass = undefined
                resultRenderPass = undefined
            end
        end

        // If the render pass isn't defined and valid, regenerate it.
        // We'll have to determine if this is the first painter in the Game as part of this.
        if not AreRenderPassesValid()
            boolean isFirstLayer = false

            Game game = gameState:GetGame()
            Iterator<Layer> layers = game:GetLayerIterator()
            if layers:HasNext()
Layer layer = layers:Next()
                if layer is Layer3D
                    Layer3D layer3D = cast(Layer3D, layer)
                    isFirstLayer = layer3D:GetPainter():Equals(me)
                end
            end

            RegenerateRenderPasses(isFirstLayer)

            // If the default program hasn't been loaded, do so now.
            if defaultProgram = undefined
                GetDefaultProgram()
            end
        end
        if cameraBuffers:IsEmpty()
            // In this case, we haven't initialized the camera resources, sampler, or draw queues yet.
            VulkanDevice device = sceneRenderPass:GetDevice()
            VulkanConstants constants
            
// Start by creating a sampler. We'll use this to access texture information in the shaders.
            VulkanSampler immutableSampler = graphics:GetTextureManager():GetDefaultSampler()
            me:immutableSampler = immutableSampler
            
                        // Initialize the DescriptorSetLayouts that will describe how our uniforms will be sent to the device.
// Create a structure for the uniforms. We'll need this for the projection matrix (i.e. the camera).
            // Define how our uniforms will be laid out.
            VulkanDescriptorSetLayout descriptorLayout
            Array<VulkanDescriptorSetLayoutBinding> descriptorBindings            

            // Describe the binding of the uniform buffers.
            VulkanDescriptorSetLayoutBinding uniformsBinding
            uniformsBinding:SetBinding(0)
            uniformsBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
            uniformsBinding:SetDescriptorCount(1)
            uniformsBinding:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT)
            descriptorBindings:Add(uniformsBinding)

            // Describe the binding of the image sampler
            VulkanDescriptorSetLayoutBinding samplerBinding
            samplerBinding:SetBinding(1)
            samplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_SAMPLER)
            samplerBinding:SetDescriptorCount(1)
            samplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            Array<VulkanSampler> immutableSamplers
            immutableSamplers:Add(immutableSampler)
            samplerBinding:SetImmutableSamplers(immutableSamplers)
            descriptorBindings:Add(samplerBinding)

            descriptorLayout:Create(device, descriptorBindings)
            
// Create the buffers for the uniforms. We'll need to know how many images the swapchain has for this.
            // This is because we'll need separate buffers for each swapchain image, so each image can be done in parallel.
            // Once the buffers are made, we can also combine them together with the layouts to create our final DescriptorSets.
            VulkanDescriptorSetManager descriptorSetManager = graphics:GetDescriptorSetManager()

            integer counter = 0
            repeat while counter < graphics:GetSwapchain():GetImageCount()
                // These buffers are for a 4x4 matrix of floats, so 4 bytes * 16 values.
                VulkanBuffer buffer
                buffer:CreateMappableBuffer(device, 4 * 16, constants:BUFFER_USAGE_UNIFORM_BUFFER_BIT)
                cameraBuffers:Add(buffer)

                VulkanNumber32BitMappedMemory mapping = buffer:MapToNumber32BitMemory()
                cameraMappings:Add(mapping)

                VulkanDescriptorResourcesInfo cameraResourcesInfo
                cameraResourcesInfo:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
                cameraResourcesInfo:AddBufferInfo(cameraBuffers:Get(counter), 0, cameraBuffers:Get(counter):GetSize())

                VulkanDescriptorSet set = descriptorSetManager:CreateDescriptorSet(descriptorLayout, cameraResourcesInfo)
                cameraDescriptors:Add(set)
                
                // Also create an array of draw queues per image in the swapchain.
                Array<VulkanDrawQueue3D> queueArray
                drawQueues:Add(queueArray)

                counter = counter + 1
            end
        end
        if not shadowProjectionResourcesLinked
            VulkanConstants constants
            integer i = 0
            repeat while i < graphics:GetSwapchain():GetImageCount()
                VulkanBuffer shadowBuffer = environment:GetShadowProjectionBuffer(i)
                
                VulkanDescriptorResourcesInfo projectionResources
            projectionResources:AddBufferInfo(shadowBuffer, 0, shadowBuffer:GetSize())
            projectionResources:SetDestinationBinding(0)
            projectionResources:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
            
            VulkanDescriptorSet set = shadowProjectionDescriptors:Get(i)
            set:LinkResources(projectionResources)
                
                // Also link the same buffer as resources available to the lightShadowDataDescriptors.
                VulkanDescriptorResourcesInfo lightProjectionResources
                lightProjectionResources:AddBufferInfo(shadowBuffer, 0, shadowBuffer:GetSize())
            lightProjectionResources:SetDestinationBinding(0)
            lightProjectionResources:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
                
                VulkanDescriptorSet lightSet = lightShadowDataDescriptors:Get(i)
                lightSet:LinkResources(lightProjectionResources)
                
                i = i + 1
            end
            
            shadowProjectionResourcesLinked = true
        end
        
        if dummyVertexBuffer = undefined
            VulkanConstants constants
            
            VulkanBuffer dummyBuffer
            dummyVertexBuffer = dummyBuffer
            
            dummyBuffer:CreateMappableBuffer(sceneRenderPass:GetDevice(), 12, constants:BUFFER_USAGE_VERTEX_BUFFER_BIT)
        end
    end
    
    action End
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        // Abort if rendering is paused due to window minimization.
        if graphics:IsRenderingPaused()
            return now
        end
        
        integer resourceIndex = graphics:GetCurrentResourceIndex()

        VulkanCommandBuffer commandBuffer = graphics:GetCurrentRenderCommandBuffer()
        VulkanSwapchain swapchain = graphics:GetSwapchain()
        VulkanFramebuffer sceneFramebuffer = renderFramebuffers:Get(resourceIndex)
        VulkanConstants constants
        
        ModelManagerVulkan modelManager = graphics:GetModelManager()
        VulkanTextureManager textureManager = graphics:GetTextureManager()
        VulkanShaderManager shaderManager = cast(VulkanShaderManager, gameState:GetShaderManager())
        VulkanLightingProperties lightProperties = graphics:GetLightingProperties()
        
        if sceneClearValues:IsEmpty()
            repeat 4 times
                sceneClearValues:AddColor(0, 0, 0, 0)
            end
            sceneClearValues:AddDepthStencil(1, 0)
            // The multisampled G-buffer copies, with MSAA (Item 27).
            repeat 4 times
                sceneClearValues:AddColor(0, 0, 0, 0)
            end
        end
        if shadowClearValues:IsEmpty()
            shadowClearValues:AddColor(1, 1)
            shadowClearValues:AddDepthStencil(1, 0)
        end
        if lightClearValues:IsEmpty()
            lightClearValues:AddColor(0, 0, 0, 0)
        end
        
        if not pendingBatches:IsEmpty() or not pendingTransparentBatches:IsEmpty()
            // After ending the batches, we need to wait for data transfers to complete before any drawing can occur.
            // Create a memory barrier that ensures that all commands after this must wait for the transfer stage of
            // the pipeline to complete before operations in the vertex input stage can begin.
            VulkanMemoryBarrier memoryBarrier
            memoryBarrier:SetSourceStageMask(constants:PIPELINE_STAGE_TRANSFER_BIT)
            memoryBarrier:SetSourceAccessMask(constants:ACCESS_MEMORY_WRITE_BIT)
            memoryBarrier:SetDestinationStageMask(constants:PIPELINE_STAGE_VERTEX_INPUT_BIT)
            memoryBarrier:SetDestinationAccessMask(constants:ACCESS_MEMORY_READ_BIT)

            PipelineBarrierCommand barrierCommand
            barrierCommand:SetMemoryBarrier(memoryBarrier)
            commandBuffer:Record(barrierCommand)
        end
        
        // Before we begin rendering, we need to pre-process the vertices of any animated models in a compute shader.
        if not animatedModels:IsEmpty()
            ComputeAnimations(graphics)
            animatedModels:Empty()
        end

        integer currentSwapchainIndex = graphics:GetCurrentResourceIndex()
        
        camera:Update()
        environment:Update()
VulkanNumber32BitMappedMemory currentCameraMapping = cameraMappings:Get(currentSwapchainIndex)
        VulkanDescriptorSet currentCameraDescriptor = cameraDescriptors:Get(currentSwapchainIndex)
        
Number32BitArray projectionViewMatrix = MatrixToArray(camera:GetCombinedMatrix())
        currentCameraMapping:Set(projectionViewMatrix)
        
//VulkanDescriptorSet texturesDescriptorSet = graphics:GetTextureManager():GetGlobalTextureDescriptorSet()
        
        // TO-DO: Support custom shaders for 3D.
        ShaderProgram currentProgram = GetDefaultProgram()
        VulkanPipeline currentPipeline = GetDefaultPipeline()
        
        if NeedsPipeline(currentPipeline, sceneSampleCount)
            VulkanShaderProgram strategy = cast(VulkanShaderProgram, currentProgram:GetShaderProgramStrategy())
            strategy:CreatePipeline(sceneRenderPass)
            currentPipeline = strategy:GetPipeline()
        end
        
        i = 0
        repeat while i < drawQueues:GetSize()
            Array<VulkanDrawQueue3D> allQueues = drawQueues:Get(i)
            integer j = 0
            repeat while j < allQueues:GetSize()
                VulkanDrawQueue3D queue = allQueues:Get(j)
                if queue not= undefined
                    queue:Begin()
                end
                
                j = j + 1
            end
            i = i + 1
        end
        
        // Also reset this frame's queues for custom shader programs.
        integer programIndex = 0
        repeat while programIndex < customPrograms:GetSize()
            Array<VulkanDrawQueue3D> programQueues = GetCurrentProgramQueues(customPrograms:Get(programIndex))
            integer queueIndex = 0
            repeat while queueIndex < programQueues:GetSize()
                VulkanDrawQueue3D programQueue = programQueues:Get(queueIndex)
                if programQueue not= undefined
                    programQueue:Begin()
                end
                queueIndex = queueIndex + 1
            end
            programIndex = programIndex + 1
        end
        
        // Drop batches whose blueprint no model uses any more (Item 33).
        ModelManagerVulkan releaseManager = graphics:GetModelManager()
        if releaseManager:GetReleaseCount() not= releasesSeen
            releasesSeen = releaseManager:GetReleaseCount()
            RemoveReleasedBatches()
        end

        Array<VulkanPainter3DBatch> currentBatches = pendingBatches
        repeat until currentBatches = undefined
            integer counter = 0
            repeat while counter < currentBatches:GetSize()
                VulkanPainter3DBatch batch = currentBatches:Get(counter)
                batch:ProcessBatch(me)
                batch:PrepareForNextFrame()
                
                counter = counter + 1
            end
            
            // After drawing all opaque geometry, repeat the process for transparent batches.
            if currentBatches = pendingBatches
                currentBatches = pendingTransparentBatches
            else
                currentBatches = undefined
            end
        end

        // Create the command to begin the render pass.
        BeginRenderPassCommand beginRenderPass
        beginRenderPass:SetRenderPass(sceneRenderPass)
        beginRenderPass:SetClearValues(sceneClearValues)
        beginRenderPass:SetFramebuffer(sceneFramebuffer)
        beginRenderPass:SetRenderArea(swapchain:GetImageWidth(), swapchain:GetImageHeight())
        commandBuffer:Record(beginRenderPass)
        
        BindPipelineCommand bindPipeline
            bindPipeline:SetPipeline(currentPipeline)
            commandBuffer:Record(bindPipeline)
        
        //Set the viewport. If no viewport dimensions were set, we get reasonable defaults from the swapchain.
            if viewportWidth = 0
                viewportWidth = swapchain:GetImageWidth()
            end
            if viewportHeight = 0
                viewportHeight = swapchain:GetImageHeight()
            end
            
        SetViewportAndScissor(commandBuffer, swapchain)
        
        // We actually don't use regular vertex inputs in our bindless approach, but Vulkan complains if we never bind anything.
        // Bind a dummy set to satisfy the spec and prevent warnings and unpredictable behavior.
        BindVertexBufferCommand bindVertex
        bindVertex:SetBuffer(dummyVertexBuffer)
        commandBuffer:Record(bindVertex)
        
        VulkanPipelineLayout pipelineLayout = currentPipeline:GetInfo():GetLayout()
                
        //output "Binding camera. View: 
//" + camera:GetViewMatrix():ToText() + "
//
//Projection: 
//" + camera:GetProjectionMatrix():ToText() + "
//
//Combined: 
//" + camera:GetCombinedMatrix():ToText() + "
//
//---"
        
BindDescriptorSetCommand cameraBind
            cameraBind:SetPipelineLayout(pipelineLayout)
            cameraBind:SetDescriptorSet(currentCameraDescriptor)
            commandBuffer:Record(cameraBind)
        
        // One queue per texture group used so far, with undefined for
        // groups never used (#22: this counted frame slots before).
        Array<VulkanDrawQueue3D> defaultQueues = drawQueues:Get(currentSwapchainIndex)
        i = 0
        repeat while i < defaultQueues:GetSize()
            VulkanDrawQueue3D drawQueue = defaultQueues:Get(i)
            if drawQueue not= undefined and drawQueue:GetDrawCommandCount() > 0
                BindDescriptorSetCommand texturesBind
            texturesBind:SetPipelineLayout(pipelineLayout)
            texturesBind:SetDescriptorSet(textureManager:GetGlobalTextureDescriptorSet(i))
            texturesBind:SetSetIndex(1)
            commandBuffer:Record(texturesBind)
                
                pushConstants:ResetWritePosition()
        pushConstants:AddBufferPointer(drawQueue:GetInstanceDataBuffer())
        
        SetPushConstantsCommand setPushConstants
        setPushConstants:SetData(pushConstants)
        setPushConstants:SetPipelineLayout(currentPipeline:GetLayout())
        setPushConstants:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT + 
constants:SHADER_STAGE_FRAGMENT_BIT)
        commandBuffer:Record(setPushConstants)
                
                DrawIndirectCommand drawCommand
        drawCommand:SetDrawCommands(drawQueue:GetDrawCommandBuffer())
        drawCommand:SetDrawCount(drawQueue:GetDrawCommandCount())
        commandBuffer:Record(drawCommand)
            end
            i = i + 1
        end
        
        // Then draw the models that have their own shader programs, one
        // program at a time. Their layout matches the default program's, so
        // the same camera, textures and push constant are used.
        programIndex = 0
        repeat while programIndex < customPrograms:GetSize()
            ShaderProgram program = customPrograms:Get(programIndex)
            Array<VulkanDrawQueue3D> programQueues = GetCurrentProgramQueues(program)
            if HasDrawCommands(programQueues)
                VulkanShaderProgram programStrategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
                if NeedsPipeline(programStrategy:GetPipeline(), sceneSampleCount)
                    programStrategy:CreatePipeline(sceneRenderPass)
                end
                VulkanPipeline programPipeline = programStrategy:GetPipeline()
                VulkanPipelineLayout programLayout = programPipeline:GetInfo():GetLayout()
                
                BindPipelineCommand bindProgramPipeline
                bindProgramPipeline:SetPipeline(programPipeline)
                commandBuffer:Record(bindProgramPipeline)
                
                BindDescriptorSetCommand programCameraBind
                programCameraBind:SetPipelineLayout(programLayout)
                programCameraBind:SetDescriptorSet(currentCameraDescriptor)
                commandBuffer:Record(programCameraBind)
                
                integer group = 0
                repeat while group < programQueues:GetSize()
                    VulkanDrawQueue3D programQueue = programQueues:Get(group)
                    if programQueue not= undefined and programQueue:GetDrawCommandCount() > 0
                        BindDescriptorSetCommand programTexturesBind
                        programTexturesBind:SetPipelineLayout(programLayout)
                        programTexturesBind:SetDescriptorSet(textureManager:GetGlobalTextureDescriptorSet(group))
                        programTexturesBind:SetSetIndex(1)
                        commandBuffer:Record(programTexturesBind)
                        
                        pushConstants:ResetWritePosition()
                        pushConstants:AddBufferPointer(programQueue:GetInstanceDataBuffer())
                        SetPushConstantsCommand programPushConstants
                        programPushConstants:SetData(pushConstants)
                        programPushConstants:SetPipelineLayout(programPipeline:GetLayout())
                        programPushConstants:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT + constants:SHADER_STAGE_FRAGMENT_BIT)
                        commandBuffer:Record(programPushConstants)
                        
                        DrawIndirectCommand programDraw
                        programDraw:SetDrawCommands(programQueue:GetDrawCommandBuffer())
                        programDraw:SetDrawCount(programQueue:GetDrawCommandCount())
                        commandBuffer:Record(programDraw)
                    end
                    group = group + 1
                end
            end
            programIndex = programIndex + 1
        end

        // End the render pass.
        EndRenderPassCommand endRenderPass
        commandBuffer:Record(endRenderPass)
        
        // Now, submit commands to render the shadow maps.
        // We intentionally do NOT put any additional barriers or waiting here, because the shadow stage is independent of the scene rendering.
        // Allow Vulkan to run this stage in parallel with the scene rendering.
        
        // Before we begin rendering the shadows, make sure we have all the framebuffers needed for the data in this stage.
        EnsureShadowMaps(resourceIndex)
        
        Array<VulkanFramebuffer> shadowFramebuffers = shadowCubemapFramebuffers:Get(resourceIndex)
        
        // Perform the shadow rendering phase.
        integer directionalLightCount = environment:GetDirectionalLightCount()
            integer totalLightCount = directionalLightCount + environment:GetPointLightCount()
            if totalLightCount > lightProperties:GetMaximumLights()
                totalLightCount = lightProperties:GetMaximumLights()
            end
        
        ShaderProgram shadowProgram = GetDefaultShadowProgram()
        VulkanPipeline shadowPipeline = GetDefaultShadowPipeline()
        
        if shadowPipeline = undefined
            VulkanShaderProgram strategy = cast(VulkanShaderProgram, shadowProgram:GetShaderProgramStrategy())
            strategy:CreatePipeline(shadowRenderPass)
            shadowPipeline = strategy:GetPipeline()
        end
        VulkanPipelineLayout shadowPipelineLayout = shadowPipeline:GetInfo():GetLayout()
        
        integer shadowMapSize = lightProperties:GetShadowMapSize()
        
        // The queues the shadow pass draws: the default ones, in the same
        // order as before, then each custom program's. Every model casts
        // shadows with the default shadow program, whatever program draws it.
        Array<VulkanDrawQueue3D> shadowQueues
        // This frame's default queues, one per texture group used (#22).
        VulkanGraphics queueGraphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        Array<VulkanDrawQueue3D> defaultShadowQueues = drawQueues:Get(queueGraphics:GetCurrentResourceIndex())
        integer queueCounter = 0
        repeat while queueCounter < defaultShadowQueues:GetSize()
            shadowQueues:Add(defaultShadowQueues:Get(queueCounter))
            queueCounter = queueCounter + 1
        end
        programIndex = 0
        repeat while programIndex < customPrograms:GetSize()
            Array<VulkanDrawQueue3D> programQueues = GetCurrentProgramQueues(customPrograms:Get(programIndex))
            queueCounter = 0
            repeat while queueCounter < programQueues:GetSize()
                shadowQueues:Add(programQueues:Get(queueCounter))
                queueCounter = queueCounter + 1
            end
            programIndex = programIndex + 1
        end
        
        i = 0
        repeat while i < totalLightCount
            VulkanFramebuffer shadowFramebuffer = shadowFramebuffers:Get(i)
            
            // We have to render to a different framebuffer for each light, so we create a render pass for each one.
            // Create the command to begin the render pass.
        BeginRenderPassCommand beginShadowPass
        beginShadowPass:SetRenderPass(shadowRenderPass)
        beginShadowPass:SetClearValues(shadowClearValues)
        beginShadowPass:SetFramebuffer(shadowFramebuffer)
        beginShadowPass:SetRenderArea(shadowMapSize, shadowMapSize)
        commandBuffer:Record(beginShadowPass)
            
            BindPipelineCommand bindShadowPipeline
            bindShadowPipeline:SetPipeline(shadowPipeline)
            commandBuffer:Record(bindShadowPipeline)
            
            SetViewportCommand setViewport
            setViewport:SetPosition(0, shadowMapSize)
            setViewport:SetSize(shadowMapSize, -shadowMapSize)
            commandBuffer:Record(setViewport)
        
        SetScissorCommand setScissor
        setScissor:SetPosition(0, 0)
            setScissor:SetSize(shadowMapSize, shadowMapSize)
        commandBuffer:Record(setScissor)
            
            // We actually don't use regular vertex inputs in our bindless approach, but Vulkan complains if we never bind anything.
        // Use our previous command to bind a dummy set to satisfy the spec and prevent warnings and unpredictable behavior.
        commandBuffer:Record(bindVertex)
            
            BindDescriptorSetCommand shadowDescriptorBind
            shadowDescriptorBind:SetPipelineLayout(shadowPipelineLayout)
            shadowDescriptorBind:SetDescriptorSet(shadowProjectionDescriptors:Get(resourceIndex))
            commandBuffer:Record(shadowDescriptorBind)
            
            integer isPointLight = 0
            if i >= directionalLightCount
                isPointLight = 1
            end
            
            /*Note that if we are not rendering shadows, we still bind and begin the render pass -- we only skip the sending of draw
commands. This is because performing the lighting render pass relies on the output from the shadow stage even if there are
no shadows (the shaders expect the buffers to be present). A render pass with no draw will reset all cubemaps back to
their default clear values, which is functionally equivalent to there being no shadows.*/
            if IsRenderingShadows()
                
                // If the system supports geometry shaders, the cascade counting loop and face counting loop will both evaluate to limit = 1.
                // In other words, when using geometry shaders, only 1 render command will be sent per light. Otherwise, CASCADE_COUNT * 1 will
                // be sent for directional lights, and CASCADE_COUNT * 6 will be sent for point lights.
                integer cascadeRenderCount = 0
                integer cascadeRenderTotal = 1
                integer totalFaces = 1
                if renderCascadesSeparately
                    cascadeRenderTotal = lightProperties:GetShadowMapCascadeCount()
                    if isPointLight = 1
                        totalFaces = 6
                    end
                end
                
                repeat while cascadeRenderCount < cascadeRenderTotal
                    integer j = 0
                    repeat while j < shadowQueues:GetSize()
                    VulkanDrawQueue3D drawQueue = shadowQueues:Get(j)
            if drawQueue not= undefined and drawQueue:GetShadowDrawCommandCount() > 0
                            integer faceCounter = 0
                            repeat while faceCounter < totalFaces
                                BindDescriptorSetCommand shadowTextureDescriptorBind
            shadowTextureDescriptorBind:SetPipelineLayout(shadowPipelineLayout)
            shadowTextureDescriptorBind:SetDescriptorSet(textureManager:GetGlobalTextureDescriptorSet(drawQueue:GetTextureGroupID()))
            shadowTextureDescriptorBind:SetSetIndex(1)
            commandBuffer:Record(shadowTextureDescriptorBind)
                        
                shadowPushConstants:ResetWritePosition()
        shadowPushConstants:AddBufferPointer(drawQueue:GetInstanceDataBuffer())
                        shadowPushConstants:AddInteger32Bit(isPointLight)
                        shadowPushConstants:AddInteger32Bit(i)
        
        SetPushConstantsCommand setPushConstants
        setPushConstants:SetData(shadowPushConstants)
        setPushConstants:SetPipelineLayout(shadowPipeline:GetLayout())
                            
                            if renderCascadesSeparately
                                shadowPushConstants:AddInteger32Bit(cascadeRenderCount)
                                shadowPushConstants:AddInteger32Bit(faceCounter)
                                setPushConstants:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT + constants:SHADER_STAGE_FRAGMENT_BIT)
                            else
                                setPushConstants:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT + 
constants:SHADER_STAGE_GEOMETRY_BIT + constants:SHADER_STAGE_FRAGMENT_BIT)
                            end
                            
        commandBuffer:Record(setPushConstants)
                
                DrawIndirectCommand drawCommand
        drawCommand:SetDrawCommands(drawQueue:GetShadowDrawCommandBuffer())
        drawCommand:SetDrawCount(drawQueue:GetShadowDrawCommandCount())
        commandBuffer:Record(drawCommand)
                                
                                faceCounter = faceCounter + 1
                            end
            end
                
                j = j + 1
end
                    
                    cascadeRenderCount = cascadeRenderCount + 1
                end
            end
            
            // End the render pass.
        EndRenderPassCommand endShadowRenderPass
        commandBuffer:Record(endShadowRenderPass)
            
            i = i + 1
        end

        // Empty the pending arrays.
        pendingBatches:Empty()
        pendingTransparentBatches:Empty()
        
        // Now that scene geometry has been rendered, and shadow maps calculated, prepare for the lighting pass.
        // First, ensure that all writing to the scene's color attachments has finished before attempting to read any of it.
        i = 0
        repeat while i < 4
            VulkanImage attachment = sceneFramebuffer:GetImageViews():Get(i):GetImage()
        AttachmentWriteBarrier(commandBuffer, attachment)
            i = i + 1
        end
        
        // Also ensure all writing to the shadow cubemaps has finished, because the lighting stage needs that too.
        i = 0
        repeat while i < shadowFramebuffers:GetSize()
            AttachmentWriteBarrier(commandBuffer, shadowFramebuffers:Get(i):GetImageViews():Get(0):GetImage())
            i = i + 1
        end
        
        // Begin the render pass for the lighting phase.
        VulkanFramebuffer lightFramebuffer = lightFramebuffers:Get(resourceIndex)
        
        BeginRenderPassCommand beginLightRender
        beginLightRender:SetRenderPass(lightRenderPass)
        beginLightRender:SetClearValues(lightClearValues)
        beginLightRender:SetFramebuffer(lightFramebuffer)
        beginLightRender:SetRenderArea(swapchain:GetImageWidth(), swapchain:GetImageHeight())
        commandBuffer:Record(beginLightRender)
        
        VulkanPipeline lightPipeline = GetDefaultLightingPipeline()
        if lightPipeline = undefined
            VulkanShaderProgram strategy = cast(VulkanShaderProgram, GetDefaultLightingProgram():GetShaderProgramStrategy())
            strategy:CreatePipeline(lightRenderPass)
            lightPipeline = strategy:GetPipeline()
        end
        
        BindPipelineCommand bindLightPipeline
            bindLightPipeline:SetPipeline(lightPipeline)
            commandBuffer:Record(bindLightPipeline)
        
        SetViewportAndScissor(commandBuffer, swapchain)
        
        // We can reuse the earlier BindVertexBufferCommand to bind our dummy vertex data.
        commandBuffer:Record(bindVertex)
        
        VulkanPipelineLayout lightPipelineLayout = lightPipeline:GetInfo():GetLayout()
                
BindDescriptorSetCommand lightDescriptorBind
            lightDescriptorBind:SetPipelineLayout(lightPipelineLayout)
            lightDescriptorBind:SetDescriptorSet(lightDescriptors:Get(resourceIndex))
            commandBuffer:Record(lightDescriptorBind)
        
        BindDescriptorSetCommand lightDataDescriptorBind
        lightDataDescriptorBind:SetPipelineLayout(lightPipelineLayout)
        lightDataDescriptorBind:SetDescriptorSet(environment:GetLightDataDescriptorSet(resourceIndex))
        lightDataDescriptorBind:SetSetIndex(1)
        commandBuffer:Record(lightDataDescriptorBind)
        
        BindDescriptorSetCommand lightShadowDescriptorBind
        lightShadowDescriptorBind:SetPipelineLayout(lightPipelineLayout)
        lightShadowDescriptorBind:SetDescriptorSet(lightShadowDataDescriptors:Get(resourceIndex))
        lightShadowDescriptorBind:SetSetIndex(2)
        commandBuffer:Record(lightShadowDescriptorBind)

        DrawCommand lightDrawCommand
        lightDrawCommand:SetVertexCount(3)
        commandBuffer:Record(lightDrawCommand)

        // End the render pass.
        EndRenderPassCommand endLightRenderPass
        commandBuffer:Record(endLightRenderPass)
        
        // Now that the scene geometry and lighting are finished, copy the result from the Painter3D's framebuffer to the swapchain image that will eventually be drawn to the screen.
        // First, ensure all writing to the light's output attachment is done before we proceed.
        VulkanImage lightAttachmentImage = lightFramebuffer:GetImageViews():Get(0):GetImage()
        AttachmentWriteBarrier(commandBuffer, lightAttachmentImage)
        
        // Now, begin the render pass for the copy draw phase. Get the resources we'll need and create the command.
        VulkanFramebuffer resultFramebuffer = graphics:GetCurrentFramebuffer()
        VulkanClearValues resultClearValues = graphics:GetClearValues()
        
        BeginRenderPassCommand beginResultRender
        beginResultRender:SetRenderPass(resultRenderPass)
        beginResultRender:SetClearValues(resultClearValues)
        beginResultRender:SetFramebuffer(resultFramebuffer)
        beginResultRender:SetRenderArea(swapchain:GetImageWidth(), swapchain:GetImageHeight())
        commandBuffer:Record(beginResultRender)

        // The sky goes down first. The lit image is copied over it with its
        // alpha, which is 0 where nothing was drawn, so the sky shows there.
        RecordSkybox(commandBuffer, swapchain, resourceIndex)

        // TO-DO: Support custom shaders for 3D.
        VulkanPipeline resultPipeline = GetCopyFromSamplerPipeline()
        
        if NeedsPipeline(resultPipeline, resultRenderPass:GetSampleCount())
            VulkanShaderProgram strategy = cast(VulkanShaderProgram, GetCopyFromSamplerProgram():GetShaderProgramStrategy())
            strategy:CreatePipeline(resultRenderPass)
            resultPipeline = strategy:GetPipeline()
        end
        
        BindPipelineCommand bindResultPipeline
            bindResultPipeline:SetPipeline(resultPipeline)
            commandBuffer:Record(bindResultPipeline)
        
        SetResultViewportAndScissor(commandBuffer, swapchain)
        
        // We can reuse the earlier BindVertexBufferCommand to bind our dummy vertex data.
        commandBuffer:Record(bindVertex)
        
        VulkanPipelineLayout resultPipelineLayout = resultPipeline:GetInfo():GetLayout()
                
BindDescriptorSetCommand resultDescriptorBind
            resultDescriptorBind:SetPipelineLayout(resultPipelineLayout)
            resultDescriptorBind:SetDescriptorSet(resultDescriptors:Get(resourceIndex))
            commandBuffer:Record(resultDescriptorBind)

        DrawCommand resultDrawCommand
        resultDrawCommand:SetVertexCount(3)
        commandBuffer:Record(resultDrawCommand)

        // End the render pass.
        EndRenderPassCommand endResultRenderPass
        commandBuffer:Record(endResultRenderPass)
        
    end
    
    private action ComputeAnimations(VulkanGraphics graphics)
        VulkanConstants constants
        VulkanComputePipeline animationPipeline = GetAnimationPipeline(graphics)
        
        // Wait here for any previous animation computations to finish before processing them again.
        animationFence:Wait()
        animationFence:Reset()
        
        VulkanCommandBuffer commandBuffer = graphics:GetComputeCommandBuffer()
        commandBuffer:BeginRecording()
        
        // Don't allow any shader writes to occur during the compute shader stage until previous commands in the vertex input stage have finished.
        VulkanMemoryBarrier memoryBarrier
        memoryBarrier:SetSourceStageMask(constants:PIPELINE_STAGE_VERTEX_INPUT_BIT)
        memoryBarrier:SetSourceAccessMask(0)
        memoryBarrier:SetDestinationStageMask(constants:PIPELINE_STAGE_COMPUTE_SHADER_BIT)
        memoryBarrier:SetDestinationAccessMask(constants:ACCESS_SHADER_WRITE_BIT)
        PipelineBarrierCommand barrierCommand
        barrierCommand:SetMemoryBarrier(memoryBarrier)
        commandBuffer:Record(barrierCommand)
        
        BindComputePipelineCommand bindPipelineCommand
        bindPipelineCommand:SetPipeline(animationPipeline)
        commandBuffer:Record(bindPipelineCommand)
        
        integer i = 0
        repeat while i < animatedModels:GetSize()
            Model model = animatedModels:Get(i)
            ModelBlueprintVulkan modelBlueprint = cast(ModelBlueprintVulkan, model:GetModelBlueprint())
            ModelResourcesVulkan resources = cast(ModelResourcesVulkan, model:GetResources())
            
            AnimationState state = model:GetAnimationState()
            VulkanBuffer animationFrame = modelBlueprint:GetBindPoseAnimationFrame():GetBuffer()
            if state not= undefined
                animationIndex = state:GetAnimationIndex()
            frameIndex = state:GetCurrentFrame()
                Array<AnimationFrameVulkan> animationFrames = modelBlueprint:GetAnimationFrames():Get(animationIndex)
                animationFrame = animationFrames:Get(frameIndex):GetBuffer()
            end
            
            integer j = 0
            repeat while j < model:GetMeshCount()
                MeshVulkan mesh = modelBlueprint:GetMeshes():Get(j)
                VulkanBuffer sourceVertices = mesh:GetVertexBuffer()
                VulkanBuffer weightsBuffer = mesh:GetAnimationDataBuffer()
                VulkanBuffer destinationVertices = resources:GetPostAnimationVertexBuffers():Get(j)
                
                animationPushConstants:ResetWritePosition()
                animationPushConstants:AddBufferPointer(sourceVertices)
                animationPushConstants:AddBufferPointer(weightsBuffer)
                animationPushConstants:AddBufferPointer(animationFrame)
                animationPushConstants:AddBufferPointer(destinationVertices)
                animationPushConstants:AddInteger32Bit(sourceVertices:GetSize() / 4)
                
                SetPushConstantsCommand setPushConstants
                setPushConstants:SetData(animationPushConstants)
                setPushConstants:SetStageFlags(constants:SHADER_STAGE_COMPUTE_BIT)
                setPushConstants:SetPipelineLayout(animationPipeline:GetLayout())
                commandBuffer:Record(setPushConstants)
                
                integer workGroups = cast(integer, math:Ceiling(cast(number, mesh:GetVertexCount()) / animationLocalSizeX))
                ComputeShaderDispatchCommand dispatch
                dispatch:SetX(workGroups)
                commandBuffer:Record(dispatch)
                
                j = j + 1
            end
            i = i + 1
        end
        
        commandBuffer:EndRecording()
        
        VulkanQueue computeQueue = graphics:GetComputeQueue()
        
        VulkanSubmitInfo submitInfo
        Array<VulkanCommandBuffer> commandBuffers
        commandBuffers:Add(commandBuffer)
        submitInfo:SetCommandBuffers(commandBuffers)
        submitInfo:SetFence(animationFence)

        computeQueue:SubmitCommands(submitInfo)
    end
    
    private action GetAnimationPipeline(VulkanGraphics graphics) returns VulkanComputePipeline
        if animationPipeline = undefined
            VulkanDevice device = graphics:GetDevice()
            VulkanConstants constants
            
            VulkanFence fence
            animationFence = fence
            animationFence:Create(device, true)
            
            AnimationComputeShaderVulkan shader
            animationLocalSizeX = shader:GetLocalSizeX()
            shader:Compile()
            
            VulkanPushConstantBuffer animationPushConstants
            me:animationPushConstants = animationPushConstants
            // The push constants for the compute shader includes 4 8-byte pointers plus one 4-byte integer.
            animationPushConstants:Create(4 * 8 + 4)
            
            VulkanPushConstantRange pushConstantRange
            pushConstantRange:SetStage(constants:SHADER_STAGE_COMPUTE_BIT)
            pushConstantRange:SetSize(4 * 8 + 4)
            pushConstantRange:Create()
            
            VulkanPipelineLayout layout
            layout:SetPushConstants(pushConstantRange)
            layout:Create(device, undefined)
            
            VulkanComputePipelineInfo info
            info:SetShader(shader)
            info:SetPushConstants(pushConstantRange)
            info:SetPipelineLayout(layout)
            info:SetPushConstants(pushConstantRange)
            
            VulkanComputePipeline pipeline
            pipeline:Create(device, info)
            animationPipeline = pipeline
        end
        
        return animationPipeline
    end
    
    private action AttachmentWriteBarrier(VulkanCommandBuffer commandBuffer, VulkanImage image)
        VulkanImageMemoryBarrier barrier
        VulkanConstants constants
        
        barrier:SetOldLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        barrier:SetNewLayout(constants:IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL)
        barrier:SetSourceStageMask(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT)
        barrier:SetDestinationStageMask(constants:PIPELINE_STAGE_FRAGMENT_SHADER_BIT)
        barrier:SetSourceAccessMask(constants:ACCESS_COLOR_ATTACHMENT_WRITE_BIT)
        barrier:SetDestinationAccessMask(constants:ACCESS_SHADER_READ_BIT)
        barrier:SetAspectMask(constants:IMAGE_ASPECT_COLOR_BIT)
        barrier:SetImage(image)
        
        PipelineBarrierCommand barrierCommand
        barrierCommand:SetMemoryBarrier(barrier)
        commandBuffer:Record(barrierCommand)
    end
    
    private action SetViewportAndScissor(VulkanCommandBuffer commandBuffer, VulkanSwapchain swapchain)
        SetViewportCommand setViewport
            setViewport:SetPosition(viewportX, swapchain:GetImageHeight() - viewportY)
            setViewport:SetSize(viewportWidth, -viewportHeight)
        //setViewport:SetPosition(viewportX, viewportY)
            //setViewport:SetSize(viewportWidth, viewportHeight)
            commandBuffer:Record(setViewport)
        
        SetScissorCommand setScissor
        setScissor:SetPosition(0, 0)
            setScissor:SetSize(swapchain:GetImageWidth(), swapchain:GetImageHeight())
        commandBuffer:Record(setScissor)
    end
    
    private action SetResultViewportAndScissor(VulkanCommandBuffer commandBuffer, VulkanSwapchain swapchain)
        SetViewportCommand setViewport
            setViewport:SetPosition(0, swapchain:GetImageHeight())
            setViewport:SetSize(swapchain:GetImageWidth(), -swapchain:GetImageHeight())
        //setViewport:SetPosition(0, 0)
            //setViewport:SetSize(swapchain:GetImageWidth(), swapchain:GetImageHeight())
            commandBuffer:Record(setViewport)
        
        SetScissorCommand setScissor
        setScissor:SetPosition(0, 0)
            setScissor:SetSize(swapchain:GetImageWidth(), swapchain:GetImageHeight())
        commandBuffer:Record(setScissor)
    end
    
    action GetCurrentDrawQueue(integer textureGroupID) returns VulkanDrawQueue3D
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        integer resourceIndex = graphics:GetCurrentResourceIndex()
        return GetQueueForGroup(drawQueues:Get(resourceIndex), textureGroupID)
    end
    
    /*
    This action returns this frame's draw queue for a shader program and a
    texture group, making it if needed.

    Attribute: Parameter program The shader program, or undefined for the default.
    Attribute: Parameter textureGroupID The texture group the queue draws from.
    Attribute: Returns The draw queue.
    */
    action GetCurrentDrawQueue(ShaderProgram program, integer textureGroupID) returns VulkanDrawQueue3D
        if program = undefined
            return GetCurrentDrawQueue(textureGroupID)
        end
        return GetQueueForGroup(GetCurrentProgramQueues(program), textureGroupID)
    end
    
    /*
    This action returns this frame's array of draw queues for a custom
    shader program, indexed by texture group. The first time a program is
    used, its arrays are made and it is added to customPrograms.

    Attribute: Parameter program A custom shader program.
    Attribute: Returns The program's draw queues for this frame.
    */
    private action GetCurrentProgramQueues(ShaderProgram program) returns Array<VulkanDrawQueue3D>
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        integer resourceIndex = graphics:GetCurrentResourceIndex()
        
        Array<Array<VulkanDrawQueue3D>> perImage = undefined
        if programDrawQueues:HasKey(program)
            perImage = programDrawQueues:GetValue(program)
        else
            Array<Array<VulkanDrawQueue3D>> newPerImage
            programDrawQueues:Add(program, newPerImage)
            customPrograms:Add(program)
            perImage = newPerImage
        end
        
        repeat while perImage:GetSize() <= resourceIndex
            Array<VulkanDrawQueue3D> queueArray
            perImage:Add(queueArray)
        end
        return perImage:Get(resourceIndex)
    end
    
    /*
    This action returns the draw queue for a texture group from one frame's
    array of queues, making it if needed. Missing entries before it are
    filled with undefined.

    Attribute: Parameter array One frame's draw queues, indexed by texture group.
    Attribute: Parameter textureGroupID The texture group the queue draws from.
    Attribute: Returns The draw queue.
    */
    private action GetQueueForGroup(Array<VulkanDrawQueue3D> array, integer textureGroupID) returns VulkanDrawQueue3D
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        VulkanDevice device = graphics:GetDevice()
        
        // Elements are indexed in the array to match their texture group index.
        // If there's not enough entries, we'll create a new element at the index we care about,
        // and we'll pad out any extra values beforehand with undefined values.
        if array:GetSize() <= textureGroupID
            // Add undefined values until the size = the ID. This means we'll have one less element in the array than we need for the requested index.
            repeat until array:GetSize() = textureGroupID
                array:Add(undefined)
            end
            
            // Now create and add a queue at the required spot in the array.
            VulkanDrawQueue3D queue
                queue:Create(device, graphics, DEFAULT_MAX_INSTANCES, textureGroupID)
                array:Add(queue)
        end
        if array:Get(textureGroupID) = undefined
            // A previously unneeded queue is needed now. Instantiate and place it in the structure.
            VulkanDrawQueue3D queue
                queue:Create(device, graphics, DEFAULT_MAX_INSTANCES, textureGroupID)
                array:Set(textureGroupID, queue)
        end
        
        return array:Get(textureGroupID)
    end
    
    /*
    This action returns true if any queue in the array has draw commands.

    Attribute: Parameter queues One frame's draw queues.
    Attribute: Returns True if there is something to draw.
    */
    private action HasDrawCommands(Array<VulkanDrawQueue3D> queues) returns boolean
        integer i = 0
        repeat while i < queues:GetSize()
            VulkanDrawQueue3D queue = queues:Get(i)
            if queue not= undefined and queue:GetDrawCommandCount() > 0
                return true
            end
            i = i + 1
        end
        return false
    end
    
    action SetSkybox(Skybox skybox)
        me:skybox = skybox
    end

    /*
    This action draws the skybox, if the layer has one that is loaded and
    the camera is a perspective camera: the skybox program's full-screen
    triangle, with the camera's directions and the sky's rotation in push
    constants, and the cube in its own descriptor set.

    Attribute: Parameter commandBuffer The frame's command buffer, in the result pass.
    Attribute: Parameter swapchain The swapchain.
    Attribute: Parameter resourceIndex The frame slot.
    */
    private action RecordSkybox(VulkanCommandBuffer commandBuffer, VulkanSwapchain swapchain, integer resourceIndex)
        if skybox = undefined or camera = undefined
            return now
        end
        if not skybox:IsLoaded()
            return now
        end
        Texture cube = skybox:GetCubeMap()
        if cube = undefined or cube:GetVulkanImageView() = undefined
            return now
        end
        if not skybox:UpdateView(camera)
            return now
        end
        VulkanConstants constants

        ShaderManager shaders = gameState:GetShaderManager()
        ShaderProgram program = shaders:GetSkyboxShaderProgram()
        VulkanShaderProgram strategy = cast(VulkanShaderProgram, program:GetShaderProgramStrategy())
        VulkanPipeline pipeline = strategy:GetPipeline()
        if NeedsPipeline(pipeline, resultRenderPass:GetSampleCount())
            strategy:CreatePipeline(resultRenderPass)
            pipeline = strategy:GetPipeline()
        end
        VulkanPipelineLayout layout = pipeline:GetInfo():GetLayout()

        BindPipelineCommand bindPipeline
        bindPipeline:SetPipeline(pipeline)
        commandBuffer:Record(bindPipeline)
        SetResultViewportAndScissor(commandBuffer, swapchain)

        BindDescriptorSetCommand bindCube
        bindCube:SetPipelineLayout(layout)
        bindCube:SetDescriptorSet(GetSkyboxDescriptor(resourceIndex, cube:GetVulkanImageView()))
        commandBuffer:Record(bindCube)

        if skyboxPushConstants = undefined
            VulkanPushConstantBuffer buffer
            buffer:Create(112)
            skyboxPushConstants = buffer
        end
        Vector3 right = skybox:GetViewRight()
        Vector3 up = skybox:GetViewUp()
        Vector3 forward = skybox:GetViewForward()
        skyboxPushConstants:ResetWritePosition()
        skyboxPushConstants:AddNumber32Bit(right:GetX())
        skyboxPushConstants:AddNumber32Bit(right:GetY())
        skyboxPushConstants:AddNumber32Bit(right:GetZ())
        skyboxPushConstants:AddNumber32Bit(skybox:GetInverter())
        skyboxPushConstants:AddNumber32Bit(up:GetX())
        skyboxPushConstants:AddNumber32Bit(up:GetY())
        skyboxPushConstants:AddNumber32Bit(up:GetZ())
        skyboxPushConstants:AddNumber32Bit(0)
        skyboxPushConstants:AddNumber32Bit(forward:GetX())
        skyboxPushConstants:AddNumber32Bit(forward:GetY())
        skyboxPushConstants:AddNumber32Bit(forward:GetZ())
        skyboxPushConstants:AddNumber32Bit(0)
        skyboxPushConstants:AddMatrix4(skybox:GetRotation())

        SetPushConstantsCommand setPushConstants
        setPushConstants:SetData(skyboxPushConstants)
        setPushConstants:SetPipelineLayout(layout)
        setPushConstants:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
        commandBuffer:Record(setPushConstants)

        DrawCommand drawSky
        drawSky:SetVertexCount(3)
        commandBuffer:Record(drawSky)
    end

    /*
    This action returns a frame slot's descriptor set for the sky's cube,
    making it the first time, and linking it to the cube's view when the
    view changes. A slot's set is only changed after its previous frame has
    finished with it.

    Attribute: Parameter resourceIndex The frame slot.
    Attribute: Parameter view The cube's image view.
    Attribute: Returns The descriptor set.
    */
    private action GetSkyboxDescriptor(integer resourceIndex, VulkanImageView view) returns VulkanDescriptorSet
        VulkanConstants constants
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        if skyboxLayout = undefined
            VulkanDescriptorSetLayout layout
            Array<VulkanDescriptorSetLayoutBinding> bindings
            VulkanDescriptorSetLayoutBinding samplerBinding
            samplerBinding:SetBinding(0)
            samplerBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            samplerBinding:SetDescriptorCount(1)
            samplerBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            bindings:Add(samplerBinding)
            layout:Create(graphics:GetDevice(), bindings)
            skyboxLayout = layout
        end

        VulkanDescriptorSetManager descriptorSetManager = graphics:GetDescriptorSetManager()
        repeat while skyboxDescriptors:GetSize() <= resourceIndex
            VulkanDescriptorSet newSet = descriptorSetManager:CreateDescriptorSet(skyboxLayout)
            skyboxDescriptors:Add(newSet)
            skyboxLinkedViews:Add(undefined)
        end

        VulkanDescriptorSet set = skyboxDescriptors:Get(resourceIndex)
        if skyboxLinkedViews:Get(resourceIndex) not= view
            VulkanDescriptorResourcesInfo resources
            VulkanDescriptorImageInfo image
            image:SetImageView(view)
            image:SetSampler(resultSampler)
            image:SetImageLayout(constants:IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL)
            Array<VulkanDescriptorImageInfo> images
            images:Add(image)
            resources:SetImageInfo(images)
            resources:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            set:LinkResources(resources)
            skyboxLinkedViews:Set(resourceIndex, view)
        end
        return set
    end
    
    /*
    This action removes, from every batch table, the batches whose
    blueprint has been released (Item 33).
    */
    private action RemoveReleasedBatches
        RemoveReleasedBatches(batches)
        RemoveReleasedBatches(transparentBatches)
        Iterator<HashTable<ModelBlueprint, VulkanPainter3DBatch>> tables = programBatches:GetValueIterator()
        repeat while tables:HasNext()
            RemoveReleasedBatches(tables:Next())
        end
        tables = programTransparentBatches:GetValueIterator()
        repeat while tables:HasNext()
            RemoveReleasedBatches(tables:Next())
        end
    end

    /*
    This action removes, from one batch table, the batches whose blueprint
    has been released.

    Attribute: Parameter table A table of batches by blueprint.
    */
    private action RemoveReleasedBatches(HashTable<ModelBlueprint, VulkanPainter3DBatch> table)
        Array<ModelBlueprint> released
        Iterator<ModelBlueprint> keys = table:GetKeyIterator()
        repeat while keys:HasNext()
            ModelBlueprint key = keys:Next()
            if key is ModelBlueprintVulkan
                ModelBlueprintVulkan vulkanKey = cast(ModelBlueprintVulkan, key)
                if vulkanKey:IsReleased()
                    released:Add(key)
                end
            end
        end
        integer i = 0
        repeat while i < released:GetSize()
            VulkanPainter3DBatch batch = table:RemoveKey(released:Get(i))
            if batch not= undefined
                batch:Dispose()
            end
            i = i + 1
        end
    end

    action SetEnvironment(Environment environment)
        me:environment = cast(EnvironmentVulkan, environment)
    end
    
    action Render(Model model)
        if framePaused or model = undefined or model:GetModelBlueprint() = undefined
            return now
        end
        
        VulkanPainter3DBatch batch = GetBatch(model)
        if batch:IsPending() = false
            batch:SetPending(true)
            if batch:IsTransparent()
                pendingTransparentBatches:Add(batch)
            else
                pendingBatches:Add(batch)
            end
            batch:ResetAge()
        end
        batch:Add(model)
        
        if model:HasAnimations()
            animatedModels:Add(model)
        end
    end
    
    private action MatrixToArray(Matrix4 matrix) returns Number32BitArray
        matrix4Array:Set(0, matrix:row0column0)
        matrix4Array:Set(1, matrix:row1column0)
        matrix4Array:Set(2, matrix:row2column0)
        matrix4Array:Set(3, matrix:row3column0)
        matrix4Array:Set(4, matrix:row0column1)
        matrix4Array:Set(5, matrix:row1column1)
        matrix4Array:Set(6, matrix:row2column1)
        matrix4Array:Set(7, matrix:row3column1)
        matrix4Array:Set(8, matrix:row0column2)
        matrix4Array:Set(9, matrix:row1column2)
        matrix4Array:Set(10, matrix:row2column2)
        matrix4Array:Set(11, matrix:row3column2)
        matrix4Array:Set(12, matrix:row0column3)
        matrix4Array:Set(13, matrix:row1column3)
        matrix4Array:Set(14, matrix:row2column3)
        matrix4Array:Set(15, matrix:row3column3)
        return matrix4Array
    end
    
    action SetViewport(integer x, integer y, integer width, integer height)
        viewportX = x
        viewportY = y
        viewportWidth = width
        viewportHeight = height
    end
    
    action GetViewportX returns integer
        return viewportX
    end

    action GetViewportY returns integer
        return viewportY
    end

    action GetViewportWidth returns integer
        return viewportWidth
    end

    action GetViewportHeight returns integer
        return viewportHeight
    end

    action IsRenderingShadows returns boolean
        return renderShadows
    end

    action SetRenderShadows(boolean renderShadows)
        me:renderShadows = renderShadows
    end

end