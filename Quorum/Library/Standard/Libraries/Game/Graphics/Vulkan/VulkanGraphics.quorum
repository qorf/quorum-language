package Libraries.Game.Graphics.Vulkan

use Libraries.System.Logging.SharedLogger

use Libraries.Game.Graphics.GraphicsManager
use Libraries.Containers.Number32BitArray
use Libraries.Game.Graphics.Vulkan.Commands.all
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Game.GameStateManager
use Libraries.Game.DesktopApplication
use Libraries.Game.DesktopDisplay
use Libraries.Compute.BitwiseOperations
use Libraries.Containers.Array
use Libraries.Game.GameDisplay
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.Graphics.Models.Vulkan.MaterialManagerVulkan
use Libraries.Game.Graphics.DeviceCoordinates

use Libraries.Game.DesktopConfiguration
class VulkanGraphics is GraphicsManager
    
VulkanConstants constants
    
    VulkanInstance instance = undefined
    VulkanPhysicalDevice physicalDevice = undefined
    VulkanDevice device = undefined
    VulkanSurface surface = undefined
    VulkanQueue graphicsQueue = undefined
    VulkanQueue presentationQueue = undefined
    VulkanSwapchain swapchain = undefined
    VulkanCommandPool commandPool = undefined
    VulkanRenderPass renderPass = undefined

    // MSAA for 3D (Item 27): how many samples per pixel the game asked for.
    // 1 is off. GetUsableMultisampleCount gives the count the device can do.
    integer multisampleCount = 1
    boolean warnedAboutSampleCount = false

    // MSAA for everything drawn on the swapchain image: 2D layers, and the
    // 3D layers' final copy and sky (Item 29). 1 is off.
    integer multisampleCount2D = 1
    boolean warnedAboutSampleCount2D = false

    // The sample count the swapchain's framebuffers were last made with,
    // and with MSAA, the multisampled color image every pass on them draws
    // into and resolves from. The depth image (depthBufferImage) is
    // multisampled too, then.
    integer swapchainSampleCount = 1
    VulkanImage multisampledColorImage = undefined
    VulkanImageView multisampledColorView = undefined

    // Resources used to control rendering for each of the images of the swapchain.
    Array<VulkanCommandBuffer> renderCommandBuffers
    Array<VulkanFence> renderFences
    Array<VulkanFramebuffer> swapchainFramebuffers
    
// An image and view used for depth buffer information during rendering.
    // Even though there's multiple images in the swapchain that are rendered to, we only need one depth image,
    // because only one draw occurs at a time, and there's no need to preserve the depth information after drawing finishes.
VulkanImage depthBufferImage = undefined
    VulkanImageView depthBufferImageView = undefined

    // Resources used for managing the timing of image usage from the swapchain.
    Array<VulkanSemaphore> imageAcquiredSemaphores
    Array<VulkanSemaphore> imageRenderCompleteSemaphores

    // Values used to indicate the current resources for the current frame of animation.
//    integer currentFrameIndex = -1
    VulkanCommandBuffer currentRenderCommandBuffer = undefined
    VulkanFence currentRenderFence = undefined

    VulkanTextureManager textureManager
    ModelManagerVulkan modelManager
    VulkanLightingProperties lightingProperties

    /*
    Note that the swapchain index can de-sync from the current frame index sometimes.
    Many devices will reliably give us the images of the swapchain in order (e.g., 0, 1, 2, 0, 1, 2, etc.)
    but it's not guaranteed. However, we can't know if we'll get one out of order until it happens, so we
    can't rely on using the same value for both the current resource index and the swapchain index.
    */
    integer currentSwapchainIndex = - 1
    integer currentResourceIndex = -1

    // Counts frames: BeginNextFrame adds one (Item 31). Objects handed to
    // Retire are freed by frame number.
    integer frameNumber = 0

    // Objects waiting until no frame on the GPU can use them, oldest first
    // (Item 31).
    Array<VulkanRetirable> retired
    VulkanFramebuffer currentFramebuffer = undefined
    
    // The clear color, or in otherwords, the background color of the screen.
    VulkanClearValues clearValues

    // A resource used to centralize the creation of DescriptorSets.
    VulkanDescriptorSetManager descriptorSetManager
    
    GameStateManager gameState
    
    // Rendering is paused if, when a new frame would begin, the application is minimized.
    // It resumes when a new frame begins and the application is no longer minimized.
    boolean renderingPaused = false
    
    integer maxDescriptors = -1
    boolean cachedMaxDescriptors = false
    
    /*
We use the physical device limits to figure out how many descriptors we can store at once for textures, but
some platforms return -1 instead of a reasonable value. In this case, we use this default value.
*/
    constant integer DEFAULT_MAX_DESCRIPTORS = 256
    
    // Resources for compute shaders.
    VulkanQueue computeQueue = undefined
    VulkanCommandPool computeCommandPool = undefined
    VulkanCommandBuffer computeCommandBuffer = undefined

    on create
        clearValues:AddColor(0.85, 0.85, 0.85, 1.0)
        clearValues:AddDepthStencil(1, 0)
    end
    
    /*
    This action constructs the necessary Vulkan resources to render using this VulkanGraphics. This will also create and setup the GameDisplay for the Game class,
    if there isn't already one setup, because access to the screen is needed for full VulkanGraphics setup.
    */
    action Initialize(VulkanOptions options) returns boolean
        VulkanInstance instance
        me:instance = instance
        
        instance:SetLogger(options:logger)
        boolean success = instance:CreateGraphicsInstance(options:applicationName, options:applicationVersion, options:apiVersion, options:useValidationLayers)

        if not success
            return false
        end

        VulkanPhysicalDevice physicalDevice
        me:physicalDevice = physicalDevice
        
        success = physicalDevice:CreateGraphicsDevice(instance)

        if not success
            return false
        end

        VulkanDevice device
        me:device = device

        success = device:CreateGraphicsDevice(physicalDevice)

        if not success
            return false
        end

        // Create a DesktopDisplay initialized for use with Vulkan, if we don't have one already.
        if gameState:GetApplication() is DesktopApplication and gameState:GetGameDisplay() = undefined
            DesktopDisplay display
            gameState:SetGameDisplay(display)
            display:SetConfiguration(gameState:GetGame():GetDesktopConfiguration())
            success = display:SetupDisplay(true)

            if not success
                return false
            end
        else
            //Should this remain, but be logged?
            SharedLogger logger
            logger:Log("Display was already defined: " + (gameState:GetGameDisplay() not= undefined))
        end

        VulkanSurface surface
        me:surface = surface
        success = surface:Create(instance, gameState:GetGameDisplay())
       
        if not success
            return false
        end

        // Create the graphics queue. We need to check the device's queue families to see which one will do the work we want.
        // We'll need to compare against a bitmask for this.
        BitwiseOperations bits

        integer i = 0
        repeat while i < device:GetQueueFamilyCount()
            VulkanQueueFamily family = device:GetQueueFamily(i)
            if bits:And(family:GetQueueFlags(), constants:QUEUE_GRAPHICS_BIT) not= 0
                VulkanQueue queue
                graphicsQueue = queue
                // Create the queue using the device, the queue family, and indicate the first (or zero-th) queue in the family
                queue:Create(device, family, 0)
                i = device:GetQueueFamilyCount()
            end

            i = i + 1
        end

        if graphicsQueue = undefined
            return false
        end

        i = 0
        repeat while i < device:GetQueueFamilyCount()
            VulkanQueueFamily family = device:GetQueueFamily(i)
            if family:CanPresentToSurface(surface)
                // If the graphics queue we already have can also support presentation, use the same queue for both.
                if graphicsQueue:GetQueueFamily():GetQueueFamilyIndex() = i
                    presentationQueue = graphicsQueue
                else
                    VulkanQueue queue
                    presentationQueue = queue
                    // Create the queue using the device, the queue family, and indicate the first (or zero-th) queue in the family
                    queue:Create(device, family, 0)
                end
                i = device:GetQueueFamilyCount()
            end
            i = i + 1
        end

        if presentationQueue = undefined
            return false
        end

        VulkanSwapchain swapchain
        me:swapchain = swapchain

        VulkanSwapchainInfo swapchainInfo = options:swapchainInfo
        if graphicsQueue not= presentationQueue
            Array<integer> queueFamilyIndices
            queueFamilyIndices:Add(graphicsQueue:GetQueueFamily():GetQueueFamilyIndex())
            queueFamilyIndices:Add(presentationQueue:GetQueueFamily():GetQueueFamilyIndex())
            swapchainInfo:SetQueueFamilyIndices(queueFamilyIndices)
        end

        // vSync, from DesktopConfiguration: on shows each frame at the
        // display's refresh (FIFO); off, the default, shows frames as soon as
        // they're ready (IMMEDIATE), which can tear. The swapchain falls back
        // to FIFO if the device doesn't offer IMMEDIATE.
        DesktopConfiguration desktop = gameState:GetGame():GetDesktopConfiguration()
        if desktop not= undefined
            if desktop:vSyncEnabled
                swapchainInfo:SetPresentMode(constants:PRESENT_MODE_FIFO)
            else
                swapchainInfo:SetPresentMode(constants:PRESENT_MODE_IMMEDIATE)
            end
        end

        success = swapchain:Create(device, surface, swapchainInfo)
        if not success
            return false
        end
        
        // Now create the graphics command pool.
        VulkanCommandPool commandPool
        me:commandPool = commandPool

        success = commandPool:Create(device, constants:COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, graphicsQueue:GetQueueFamily():GetQueueFamilyIndex())
        if not success
            return false
        end
        
        // We'll also get a compute-compatible queue.
        i = 0
        repeat while i < device:GetQueueFamilyCount()
            VulkanQueueFamily family = device:GetQueueFamily(i)
            if bits:And(family:GetQueueFlags(), constants:QUEUE_COMPUTE_BIT) not= 0
                VulkanQueue queue
                computeQueue = queue
                // Create the queue using the device, the queue family, and indicate the first (or zero-th) queue in the family
                queue:Create(device, family, 0)
                i = device:GetQueueFamilyCount()
            end

            i = i + 1
        end
        
        // Also create the compute command pool.
        VulkanCommandPool computeCommandPool
        me:computeCommandPool = computeCommandPool
        
        success = computeCommandPool:Create(device, constants:COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, computeQueue:GetQueueFamily():GetQueueFamilyIndex())
        if not success
            return false
        end
        
        // Create the compute command buffer.
        VulkanCommandBuffer computeCommandBuffer
        me:computeCommandBuffer = computeCommandBuffer
            success = computeCommandBuffer:Create(device, computeCommandPool)
            if not success
                return false
            end

        // The render pass, depth image and framebuffers for the swapchain's
        // images, and with 2D MSAA the multisampled color image (Item 29).
        success = MakeSwapchainFramebuffers()
        if not success
            return false
        end


        i = 0
        repeat while i < swapchain:GetImageCount()
            VulkanCommandBuffer renderCommandBuffer
            success = renderCommandBuffer:Create(device, commandPool)
            if not success
                return false
            end
            renderCommandBuffers:Add(renderCommandBuffer)
            
            VulkanFence renderFence
            success = renderFence:Create(device, true)
            if not success
                return false
            end
            renderFences:Add(renderFence)

            VulkanSemaphore imageAcquiredSemaphore
            success = imageAcquiredSemaphore:Create(device)
            if not success
                return false
            end
            imageAcquiredSemaphores:Add(imageAcquiredSemaphore)
            
            VulkanSemaphore imageRenderCompleteSemaphore
            success = imageRenderCompleteSemaphore:Create(device)
            if not success
                return false
            end
            imageRenderCompleteSemaphores:Add(imageRenderCompleteSemaphore)

            i = i + 1
        end

        descriptorSetManager:Initialize(device)

        textureManager:Create(device, me)
        modelManager:Create(device, me)
        lightingProperties:Create(device, gameState:GetGame():GetDesktopConfiguration())
        
        DeviceCoordinates ndc = GetDeviceCoordinates()
        ndc:SetDefaultCoordinateSpace(ndc:LEFT_HANDED)
        ndc:SetDefaultDepthRange(ndc:DEPTH_ZERO_TO_ONE)

        return true
    end

    /*
    This action gets the next image in the swapchain for use in the next frame of animation, clears
    the image, and prepares the frame's related resources (e.g. CommandBuffers and Fences).
    */
    action BeginNextFrame
        currentResourceIndex = (currentResourceIndex + 1) mod swapchain:GetImageCount()
        frameNumber = frameNumber + 1
        currentRenderCommandBuffer = renderCommandBuffers:Get(currentResourceIndex)
        currentRenderFence = renderFences:Get(currentResourceIndex)     

        // Ensure that all work associated with this image has previously finished.
        currentRenderFence:Wait()

        // Frame frameNumber - N, the last to use this slot, has now
        // finished, so whatever was retired by then can be freed (Item 31).
        ReleaseRetired(false)
        
        GameDisplay display = gameState:GetGameDisplay()
        if display is DesktopDisplay
            DesktopDisplay desktopDisplay = cast(DesktopDisplay, display)
            renderingPaused = desktopDisplay:IsWindowMinimized()
        else
            renderingPaused = false
        end
        
        // Abort early if rendering is paused.
        if renderingPaused
            return now
        end

        // If the 2D sample count changed, remake the swapchain's
        // framebuffers for it (Item 29), as a resize would. The painters
        // see their passes no longer match, and remake them.
        if GetUsableMultisampleCount2D() not= swapchainSampleCount
            device:WaitUntilIdle()
            ReleaseRetired(true)
            integer old = 0
            repeat while old < swapchainFramebuffers:GetSize()
                swapchainFramebuffers:Get(old):Dispose()
                old = old + 1
            end
            if not MakeSwapchainFramebuffers()
                alert("I couldn't remake the screen's framebuffers for " + swapchainSampleCount + " samples per pixel.")
            end
        end

        // Make sure the next image in the swapchain is valid. Window resizing in particular can make the swapchain "out of date", in which case we'll need to regenerate it.
integer swapchainResult = PrepareNextSwapchainImage(device, swapchain, imageAcquiredSemaphores:Get(currentResourceIndex))
        if swapchainResult = constants:SUBOPTIMAL or swapchainResult = constants:ERROR_OUT_OF_DATE
            RegenerateSwapchain()
PrepareNextSwapchainImage(device, swapchain, imageAcquiredSemaphores:Get(currentResourceIndex))
        end
        
        currentSwapchainIndex = GetCurrentSwapchainIndexNative()
currentFramebuffer = swapchainFramebuffers:Get(currentSwapchainIndex)

        // Reset the fence associated with this frame.
        currentRenderFence:Reset()

        // Reset the render command buffer. In this case, we'll instruct the command buffer not to release memory (it might reuse it, depending on local implementation, or just ditch it anyway)
        currentRenderCommandBuffer:Reset(false)
        
        // Begin recording commands for our chosen command buffer.
        currentRenderCommandBuffer:BeginRecording()
    end

    // Asks the system to get the index of the next image in the Swapchain, and returns a boolean indicating if the operation was successful or not.
    // Use GetCurrentSwapchainIndex after using this to get the actual index.
    private system action PrepareNextSwapchainImage(VulkanDevice device, VulkanSwapchain swapchain, VulkanSemaphore semaphore) returns integer

    // Returns the index of the next image that the Swapchain has indicated is ready for use. Use PrepareNextSwapchainImage before calling this.
    private system action GetCurrentSwapchainIndexNative returns integer

    action DisplayCurrentImage
// Abort early if rendering is paused.
        if renderingPaused
            return now
        end
        
        // Stop recording commands.
        currentRenderCommandBuffer:EndRecording()


        // TO-DO: Recreating these arrays every frame is going to be an issue. Consider reusing them or making a pool for the SubmitInfo.
        VulkanSubmitInfo submitInfo
        Array<VulkanCommandBuffer> commandBuffers
        Array<VulkanSemaphore> signalSemaphores
        Array<VulkanSemaphore> waitSemaphores
        Array<integer> waitDestinationStageMasks

        commandBuffers:Add(currentRenderCommandBuffer)
        signalSemaphores:Add(imageRenderCompleteSemaphores:Get(currentSwapchainIndex))
        waitSemaphores:Add(imageAcquiredSemaphores:Get(currentResourceIndex))
        waitDestinationStageMasks:Add(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT)
        
        submitInfo:SetCommandBuffers(commandBuffers)
        submitInfo:SetSignalSemaphores(signalSemaphores)
        submitInfo:SetWaitSemaphores(waitSemaphores)
        submitInfo:SetWaitDestinationStageMasks(waitDestinationStageMasks)
        submitInfo:SetFence(currentRenderFence)

        graphicsQueue:SubmitCommands(submitInfo)

        DisplayCurrentImageNative(presentationQueue, swapchain, imageRenderCompleteSemaphores:Get(currentSwapchainIndex), currentSwapchainIndex)
    end

    private system action DisplayCurrentImageNative(VulkanQueue presentQueue, VulkanSwapchain swapchain, VulkanSemaphore waitSemaphore, integer imageIndex) returns boolean

    private action RegenerateSwapchain
        device:WaitUntilIdle()
        ReleaseRetired(true)
        
        integer i = 0
        repeat while i < swapchainFramebuffers:GetSize()
            VulkanFramebuffer buffer = swapchainFramebuffers:Get(i)
            buffer:Dispose()
            i = i + 1
        end
        
        VulkanSwapchainInfo info = swapchain:GetInfo():Copy()
        swapchain:Dispose()
        
        VulkanSwapchain newSwapchain
        swapchain = newSwapchain
        
boolean success = swapchain:Create(device, surface, info)
        if not success
            alert("Failed to regenerate swapchain!")
        end
        
        // The depth image, multisampled image and framebuffers at the new
        // size (Item 29).
        if not MakeSwapchainFramebuffers()
            alert("Failed to create framebuffers during swapchain regeneration!")
        end

        // While it's technically allowed to reuse the previous semaphores, it's possible for a semaphore to be signalled in a way that can't
        // be reset by a SUBOPTIMAL result when preparing frames. For safety, we generate new ones here.
        i = 0
        repeat while i < swapchain:GetImageCount()
            // The old semaphore may still have a signal pending from the
            // acquire that found the swapchain out of date, so it is freed
            // a few frames later rather than now (Item 32).
            if i < imageAcquiredSemaphores:GetSize()
                Retire(imageAcquiredSemaphores:Get(i))
            end
            VulkanSemaphore newSemaphore
            success = newSemaphore:Create(device)
            imageAcquiredSemaphores:Set(i, newSemaphore)
            i = i + 1
        end
    end
    
    /*
    This action sets the background color of the window. This is the color used to clear
    the screen between each frame of animation. 

    Attribute: Parameter red The red component of the color, as a number between 0.0 (no red) and 1.0 (full red).
    Attribute: Parameter green The green component of the color, as a number between 0.0 (no green) and 1.0 (full green).
    Attribute: Parameter blue The blue component of the color, as a number between 0.0 (no blue) and 1.0 (full blue).
    */
    action SetClearScreenColor(number red, number green, number blue)
        VulkanClearValue value = clearValues:Get(0)
        value:SetColor(red, green, blue)
    end

    /*
    This action sets the background color of the window. This is the color used to clear
    the screen between each frame of animation. The alpha component (transparency) isn't 
    supported for OpenGL rendering, but Vulkan rendering can draw a transparent window 
    background if the feature is enabled.

    Attribute: Parameter red The red component of the color, as a number between 0.0 (no red) and 1.0 (full red).
    Attribute: Parameter green The green component of the color, as a number between 0.0 (no green) and 1.0 (full green).
    Attribute: Parameter blue The blue component of the color, as a number between 0.0 (no blue) and 1.0 (full blue).
    Attribute: Parameter alpha The alpha component of the color, as a number between 0.0 (completely transparent) and 1.0 (completely opaque).
    */
    action SetClearScreenColor(number red, number green, number blue, number alpha)
        VulkanClearValue value = clearValues:Get(0)
        value:SetColor(red, green, blue, alpha)
    end

    /*
    This action sets how many samples per pixel 3D scenes are drawn with,
    for multisample anti-aliasing (MSAA): 1 turns it off; 2, 4 or 8 smooth
    the stair-stepped edges of 3D models, 4 being the usual choice. If the
    device can't do the count, the highest count it can do below it is
    used. It takes effect at the next frame.

    Attribute: Parameter samples 1, 2, 4 or 8.
    */
    action SetMultisampleCount(integer samples)
        if samples < 1
            samples = 1
        end
        multisampleCount = samples
        warnedAboutSampleCount = false
    end

    /*
    This action returns how many samples per pixel the game asked for.

    Attribute: Returns The count asked for; 1 means MSAA is off.
    */
    action GetMultisampleCount returns integer
        return multisampleCount
    end

    /*
    This action returns how many samples per pixel 3D scenes are really
    drawn with: the count asked for, or the highest count the device's
    framebuffers can do below it, for both color and depth.

    Attribute: Returns The count in use, 1 for no MSAA.
    */
    action GetUsableMultisampleCount returns integer
        integer samples = FindUsableSampleCount(multisampleCount)
        if samples not= multisampleCount and multisampleCount > 1 and not warnedAboutSampleCount
            SharedLogger logger
            logger:Log("MSAA: " + multisampleCount + " samples asked for; this device can do " + samples + ", so " + samples + " are used.")
            warnedAboutSampleCount = true
        end
        return samples
    end

    /*
    This action sets how many samples per pixel are used for everything
    drawn on the screen's own image: 2D layers, and the final picture of 3D
    layers. 1 turns it off; 4 is the usual choice. It smooths the edges of
    turned or scaled 2D items. If the device can't do the count, the highest
    count it can do below it is used. It takes effect at the next frame.

    Attribute: Parameter samples 1, 2, 4 or 8.
    */
    action SetMultisampleCount2D(integer samples)
        if samples < 1
            samples = 1
        end
        multisampleCount2D = samples
        warnedAboutSampleCount2D = false
    end

    /*
    This action returns how many samples per pixel 2D MSAA was asked to use.

    Attribute: Returns The count asked for; 1 means it's off.
    */
    action GetMultisampleCount2D returns integer
        return multisampleCount2D
    end

    /*
    This action returns how many samples per pixel the screen's image is
    really drawn with: the 2D count asked for, or less if the device can't
    do it.

    Attribute: Returns The count in use, 1 for none.
    */
    action GetUsableMultisampleCount2D returns integer
        integer samples = FindUsableSampleCount(multisampleCount2D)
        if samples not= multisampleCount2D and multisampleCount2D > 1 and not warnedAboutSampleCount2D
            SharedLogger logger
            logger:Log("2D MSAA: " + multisampleCount2D + " samples asked for; this device can do " + samples + ", so " + samples + " are used.")
            warnedAboutSampleCount2D = true
        end
        return samples
    end

    /*
    This action returns the sample count the swapchain's framebuffers are
    made with now. Every pass drawing on them must use it.

    Attribute: Returns The sample count.
    */
    action GetSwapchainSampleCount returns integer
        return swapchainSampleCount
    end

    /*
    This action returns the highest power of two, no more than the count
    asked for, that the device's framebuffers can do for color and depth.

    Attribute: Parameter requested The count asked for.
    Attribute: Returns The usable count, 1 if none.
    */
    private action FindUsableSampleCount(integer requested) returns integer
        if requested <= 1 or physicalDevice = undefined
            return 1
        end
        VulkanPhysicalDeviceLimits limits = physicalDevice:GetLimits()
        integer samples = 1
        repeat while samples * 2 <= requested and samples < 64
            samples = samples * 2
        end
        repeat while samples > 1 and not (limits:HasFrameBufferColorSampleSupport(samples) and limits:HasFrameBufferDepthSampleSupport(samples))
            samples = samples / 2
        end
        return samples
    end

    /*
    This action describes the attachments of a pass that draws on the
    swapchain image, and returns its one subpass. The 2D painter, the 3D
    painter's result pass, and the swapchain's framebuffers all use it, so
    they always match. Without MSAA the attachments are [swapchain image,
    depth]; with 2D MSAA (Item 29) they are [multisampled color, multisampled
    depth, swapchain image], and the subpass resolves the multisampled color
    into the swapchain image as it ends. Either way the clear color is at 0
    and depth at 1.

    Attribute: Parameter firstLayer True if the pass is the frame's first, which clears the image; false to draw on what earlier layers drew.
    Attribute: Parameter descriptions An empty array, which is filled with the attachments.
    Attribute: Returns The subpass.
    */
    action MakeSwapchainSubpass(boolean firstLayer, Array<VulkanAttachmentDescription> descriptions) returns VulkanSubpassDescription
        integer format = swapchain:GetImageViewInfo():GetFormat()
        integer samples = swapchainSampleCount

        VulkanAttachmentDescription color
        color:SetFormat(format)
        color:SetSamples(samples)
        color:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
        if firstLayer
            color:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
            color:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        elseif samples > 1
            color:SetInitialLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
            color:SetLoadOp(constants:ATTACHMENT_LOAD_OP_LOAD)
        else
            color:SetInitialLayout(constants:IMAGE_LAYOUT_PRESENT_SOURCE)
            color:SetLoadOp(constants:ATTACHMENT_LOAD_OP_LOAD)
        end
        if samples > 1
            // Kept between layers, so the next layer's pass can load it.
            color:SetFinalLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        else
            color:SetFinalLayout(constants:IMAGE_LAYOUT_PRESENT_SOURCE)
        end
        descriptions:Add(color)

        VulkanAttachmentDescription depth
        depth:SetFormat(constants:FORMAT_D32_SFLOAT)
        depth:SetSamples(samples)
        depth:SetLoadOp(constants:ATTACHMENT_LOAD_OP_CLEAR)
        depth:SetStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        depth:SetStencilLoadOp(constants:ATTACHMENT_LOAD_OP_DONT_CARE)
        depth:SetStencilStoreOp(constants:ATTACHMENT_STORE_OP_DONT_CARE)
        depth:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
        depth:SetFinalLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
        descriptions:Add(depth)

        VulkanSubpassDescription subpass
        subpass:SetPipelineBindPoint(constants:PIPELINE_BIND_POINT_GRAPHICS)

        Array<VulkanAttachmentReference> colorReferences
        VulkanAttachmentReference colorReference
        colorReference:SetAttachmentIndex(0)
        colorReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
        colorReferences:Add(colorReference)
        subpass:SetColorAttachments(colorReferences)

        VulkanAttachmentReference depthReference
        depthReference:SetAttachmentIndex(1)
        depthReference:SetLayout(constants:IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
        subpass:SetDepthStencilAttachment(depthReference)

        if samples > 1
            // The swapchain image, written only by the resolve.
            VulkanAttachmentDescription target
            target:SetFormat(format)
            target:SetSamples(constants:SAMPLE_COUNT_1_BIT)
            target:SetLoadOp(constants:ATTACHMENT_LOAD_OP_DONT_CARE)
            target:SetStoreOp(constants:ATTACHMENT_STORE_OP_STORE)
            target:SetInitialLayout(constants:IMAGE_LAYOUT_UNDEFINED)
            target:SetFinalLayout(constants:IMAGE_LAYOUT_PRESENT_SOURCE)
            descriptions:Add(target)

            Array<VulkanAttachmentReference> resolveReferences
            VulkanAttachmentReference resolveReference
            resolveReference:SetAttachmentIndex(2)
            resolveReference:SetLayout(constants:IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
            resolveReferences:Add(resolveReference)
            subpass:SetResolveAttachments(resolveReferences)
        end
        return subpass
    end

    /*
    This action makes, at the swapchain's size and the 2D sample count, the
    render pass the swapchain's framebuffers are made with, the depth image,
    the multisampled color image (with 2D MSAA), and one framebuffer per
    swapchain image. Old images are freed. The old framebuffers must already
    be disposed, and the device idle.

    Attribute: Returns True if everything was made.
    */
    private action MakeSwapchainFramebuffers returns boolean
        swapchainSampleCount = GetUsableMultisampleCount2D()
        boolean multisampled = swapchainSampleCount > 1

        Array<VulkanAttachmentDescription> attachmentDescriptions
        Array<VulkanSubpassDescription> subpassDescriptions
        subpassDescriptions:Add(MakeSwapchainSubpass(true, attachmentDescriptions))

        VulkanSubpassDependency dependency
        dependency:SetSourceSubpass(constants:SUBPASS_EXTERNAL)
        dependency:SetDestinationSubpass(0)
        dependency:SetSourceStageMask(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT + constants:PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT)
        dependency:SetDestinationStageMask(constants:PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT + constants:PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT)
        dependency:SetSourceAccessMask(constants:ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT + constants:ACCESS_COLOR_ATTACHMENT_WRITE_BIT)
        dependency:SetDestinationAccessMask(constants:ACCESS_COLOR_ATTACHMENT_WRITE_BIT + constants:ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
        Array<VulkanSubpassDependency> subpassDependencies
        subpassDependencies:Add(dependency)

        // The old pass is freed once no frame uses it (Item 32).
        Retire(renderPass)
        VulkanRenderPass pass
        renderPass = pass
        if not renderPass:Create(device, attachmentDescriptions, subpassDescriptions, subpassDependencies)
            return false
        end

        if depthBufferImageView not= undefined
            depthBufferImageView:Dispose()
            depthBufferImage:Dispose()
        end
        if multisampledColorView not= undefined
            multisampledColorView:Dispose()
            multisampledColorImage:Dispose()
            multisampledColorView = undefined
            multisampledColorImage = undefined
        end

        integer width = swapchain:GetImageWidth()
        integer height = swapchain:GetImageHeight()

        VulkanImageInfo depthInfo
        depthInfo:SetWidth(width)
        depthInfo:SetHeight(height)
        depthInfo:SetFormat(constants:FORMAT_D32_SFLOAT)
        depthInfo:SetSamples(swapchainSampleCount)
        if multisampled
            // Cleared by every pass and never kept, so it can stay in tile
            // memory where the GPU has it.
            depthInfo:SetUsage(constants:IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT + constants:IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)
            depthInfo:SetPreferredMemoryFlags(constants:MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT)
        else
            depthInfo:SetUsage(constants:IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
        end
        VulkanImage depthImage
        depthBufferImage = depthImage
        if not depthImage:Create(device, depthInfo)
            return false
        end
        VulkanImageViewInfo depthViewInfo
        depthViewInfo:SetAspectMask(constants:IMAGE_ASPECT_DEPTH_BIT)
        depthViewInfo:SetFormat(constants:FORMAT_D32_SFLOAT)
        VulkanImageView depthView
        depthBufferImageView = depthView
        depthView:Create(device, depthImage, depthViewInfo)

        if multisampled
            // Kept between layers in a frame, so not transient.
            VulkanImageInfo colorInfo
            colorInfo:SetWidth(width)
            colorInfo:SetHeight(height)
            colorInfo:SetFormat(swapchain:GetImageViewInfo():GetFormat())
            colorInfo:SetSamples(swapchainSampleCount)
            colorInfo:SetUsage(constants:IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
            VulkanImage colorImage
            multisampledColorImage = colorImage
            if not colorImage:Create(device, colorInfo)
                return false
            end
            VulkanImageViewInfo colorViewInfo
            colorViewInfo:SetFormat(colorInfo:GetFormat())
            VulkanImageView colorView
            multisampledColorView = colorView
            colorView:Create(device, colorImage, colorViewInfo)
        end

        swapchainFramebuffers:Empty()
        integer i = 0
        repeat while i < swapchain:GetImageCount()
            Array<VulkanImageView> views
            if multisampled
                views:Add(multisampledColorView)
                views:Add(depthBufferImageView)
                views:Add(swapchain:GetImageView(i))
            else
                views:Add(swapchain:GetImageView(i))
                views:Add(depthBufferImageView)
            end
            VulkanFramebuffer framebuffer
            if not framebuffer:Create(device, views, renderPass)
                return false
            end
            swapchainFramebuffers:Add(framebuffer)
            i = i + 1
        end
        return true
    end
    
    /*
    This action returns the maximum number of textures that can be supported on the system. This number depends
    on the local hardware being used.
    */
    action GetMaximumTextureCount returns integer
        alert("NYI")
        return -1
    end
    
    /*
    This action makes a new shader of the requested type (e.g., FRAGMENT_SHADER or VERTEX_SHADER from the Shader class)
    using the given source code. If the shader code successfully compiles, this action will return an integer ID
    representing that shader. If the shader can't be created or it does not successfully compile, this will alert an error.
    */
    action CreateShader(integer shaderType, text sourceCode, text shaderName) returns integer
        alert("NYI")
        return -1
    end
    
    /*
    This action instructs the rendering system to delete the native resources allocated to a shader. After deleting
    a shader, it can't be used by the rendering system unless it's recompiled.
    */
    action DeleteShader(integer shaderID)
        alert("NYI")
    end
    
    /*
    */
    action CreateShaderProgram(ShaderProgram program) returns integer
        alert("NYI")
    end

