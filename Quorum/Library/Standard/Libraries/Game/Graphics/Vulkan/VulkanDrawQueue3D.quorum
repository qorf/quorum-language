package Libraries.Game.Graphics.Vulkan

use Libraries.Containers.Array
use Libraries.Game.GameStateManager
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Compute.BitwiseOperations
use Libraries.Game.Graphics.Color
use Libraries.Compute.Matrix4
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.NumberUtilities
use Libraries.Game.Graphics.Models.Vulkan.MeshVulkan
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Models.Vulkan.MaterialVulkan

/*This class is used by the VulkanPainter3D to manage instance data and queue indirect draw commands.
Most users will never need to use this class directly.*/
class VulkanDrawQueue3D
    
    VulkanDevice device = undefined
    
    VulkanBuffer instanceData = undefined
    VulkanDrawQueue3DInstanceMappedMemory instanceMapping = undefined
    
    integer currentInstanceIndex = 0
    integer maxInstances = -1
    
    // The size of a single buffer of instance data, in bytes and as 4-byte words.
    public constant integer INSTANCE_DATA_WORD_SIZE = (2 + 2 + 2 + 1 + 1 + 1 + 1 + 16)
    public constant integer INSTANCE_DATA_BYTE_SIZE = INSTANCE_DATA_WORD_SIZE * 4
    
    // Indices for the location of instance data, aligned to word indices (not bytes).
    constant integer VERTEX_BUFFER_INDEX = 0
    constant integer INDEX_BUFFER_INDEX = 1
    constant integer MATERIAL_INDEX = 2
    constant integer TEXTURE_OVERRIDE = 3
    constant integer TEXTURE_INDEX = 4
    constant integer COLOR_OVERRIDE = 5
    constant integer DIFFUSE_COLOR_INDEX = 6
    constant integer TRANSFORM_MATRIX_INDEX = 7
    
    VulkanBuffer drawCommandBuffer = undefined
    VulkanDrawIndirectDataMappedMemory drawDataMemory = undefined
    integer currentDrawCommandIndex = 0
    integer currentDrawInstanceIndex = 0
    
    /* Draw commands for specifically the shadow mapping stage. This will render a subset (which may be the whole set) of the
queued elements for the scene render pass, only sending draw commands for models which are capable of casting shadows.*/
    VulkanBuffer shadowDrawCommandBuffer = undefined
    VulkanDrawIndirectDataMappedMemory shadowDrawDataMemory = undefined
    integer currentShadowDrawCommandIndex = 0

    // Each shadow command's numbers and the point lights whose shadow
    // searches found its models, one bit per light, so
    // each point light gets a list of only its own commands
    // (BuildPointShadowLists). -1 is every light.
    Integer32BitArray shadowCommandVertexCounts
    Integer32BitArray shadowCommandInstanceCounts
    Integer32BitArray shadowCommandFirstInstances
    Integer32BitArray shadowCommandMasks

    // The point lights' lists, one after another, and where each starts
    // and how many commands it has, by the light's place among the point
    // lights. The buffer grows by doubling, and an old one
    // is retired, as frames on the GPU may still read it.
    VulkanBuffer pointShadowDrawCommandBuffer = undefined
    VulkanDrawIndirectDataMappedMemory pointShadowDrawDataMemory = undefined
    integer pointShadowCommandCapacity = 0
    Integer32BitArray pointShadowListStarts
    Integer32BitArray pointShadowListCounts
    integer pointShadowListCount = 0
    BitwiseOperations bits

    on create
        // Integer32BitArray has no storage until SetSize. A few point
        // lights is the usual most; BuildPointShadowLists grows them.
        pointShadowListStarts:SetSize(4)
        pointShadowListCounts:SetSize(4)
    end
    
    integer textureGroupID = -1

    // Room for more instances. A queue holds maxInstances;
    // instances that don't fit are counted here and not drawn, and the
    // queue grows to fit them the next time it starts empty, so nothing
    // already written is lost. The old buffers are retired, since frames
    // already recorded may still read them. A queue never grows past
    // MAXIMUM_INSTANCES; past it, the rest are left out with one warning.
    integer droppedThisFrame = 0
    integer pendingCapacity = 0
    boolean warnedFull = false
    public constant integer MAXIMUM_INSTANCES = 262144
    
    action Create(VulkanDevice device, VulkanGraphics graphics, integer maxInstances, integer textureGroupID)
        me:device = device
        me:textureGroupID = textureGroupID
        CreateBuffers(maxInstances)
    end

    /*
    This action makes the queue's instance buffer and its two draw command
    buffers (for the scene and the shadows), with room for a number of
    instances, and maps them. Create uses it, and growing does again.

    Attribute: Parameter capacity How many instances the queue holds.
    */
    private action CreateBuffers(integer capacity)
        VulkanConstants constants
        maxInstances = capacity

        VulkanBuffer newInstanceData
        instanceData = newInstanceData
        instanceData:CreateMappableBuffer(device, capacity * INSTANCE_DATA_BYTE_SIZE, constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        
        VulkanDrawQueue3DInstanceMappedMemory newMapping
        instanceMapping = newMapping
        instanceMapping:Create(instanceData)
        
        // Also create the draw command buffer. In the worst case, every mesh is unique, so it's possible to have an equal number of draw commands and instances.
        VulkanBuffer newCommandBuffer
        drawCommandBuffer = newCommandBuffer
        
        // Dummy data used only to retrieve the size of each data structure in bytes. Needed to size the buffer.
        VulkanDrawIndirectData drawData
        
        drawCommandBuffer:CreateMappableBuffer(device, capacity * drawData:GetByteSize(), constants:BUFFER_USAGE_INDIRECT_BUFFER_BIT)
        drawDataMemory = drawCommandBuffer:MapToDrawIndirectDataMemory()
        
        // Also create the parallel draw resources for the shadow mapping pass.
        VulkanBuffer newShadowCommandBuffer
        shadowDrawCommandBuffer = newShadowCommandBuffer
        
        shadowDrawCommandBuffer:CreateMappableBuffer(device, drawCommandBuffer:GetSize(), constants:BUFFER_USAGE_INDIRECT_BUFFER_BIT)
        shadowDrawDataMemory = shadowDrawCommandBuffer:MapToDrawIndirectDataMemory()

        // Each shadow command's numbers, for the point lights' lists.
        shadowCommandVertexCounts:SetSize(capacity)
        shadowCommandInstanceCounts:SetSize(capacity)
        shadowCommandFirstInstances:SetSize(capacity)
        shadowCommandMasks:SetSize(capacity)
    end

    /*
    This action returns how many more instances fit in the queue this frame.
If instances were turned away in an earlier frame and
    nothing has been written yet this frame, the queue grows first.

    Attribute: Returns How many more instances fit.
    */
    action GetRoom returns integer
        if pendingCapacity > maxInstances and currentInstanceIndex = 0 and currentDrawCommandIndex = 0
            Grow(pendingCapacity)
        end
        return maxInstances - currentInstanceIndex
    end

    /*
    This action counts instances that didn't fit this frame, so the queue grows to fit them in a
    later frame. Once it can't
    grow any more, it says so once.

    Attribute: Parameter count How many instances were left out.
    */
    action NoteDropped(integer count)
        if count <= 0
            return now
        end
        droppedThisFrame = droppedThisFrame + count
        if maxInstances >= MAXIMUM_INSTANCES and not warnedFull
            warnedFull = true
            output "A 3D draw queue is full: more than " + MAXIMUM_INSTANCES + " copies of models share one texture group, so some are not drawn."
        end
    end

    /*
    This action returns how many instances the queue holds now.

    Attribute: Returns The capacity.
    */
    action GetCapacity returns integer
        return maxInstances
    end

    /*
    This action makes the queue's buffers larger, doubling until they hold
    the number of instances needed, up to MAXIMUM_INSTANCES. It is only used while the queue is
    empty this frame. The old
    buffers are retired, as frames on the GPU may still read them.

    Attribute: Parameter needed How many instances must fit.
    */
    private action Grow(integer needed)
        pendingCapacity = 0
        integer capacity = maxInstances
        if capacity < 1
            capacity = 1
        end
        repeat while capacity < needed and capacity < MAXIMUM_INSTANCES
            capacity = capacity * 2
        end
        if capacity > MAXIMUM_INSTANCES
            capacity = MAXIMUM_INSTANCES
        end
        if capacity <= maxInstances
            return now
        end

        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        instanceMapping:Dispose()
        drawDataMemory:Dispose()
        shadowDrawDataMemory:Dispose()
        graphics:Retire(instanceData)
        graphics:Retire(drawCommandBuffer)
        graphics:Retire(shadowDrawCommandBuffer)

        CreateBuffers(capacity)
        instanceMapping:PrepareForTransfers()
    end
    
    action Begin
        // Instances left out last time this queue was used make it grow
        // the next time it starts empty.
        if droppedThisFrame > 0
            integer needed = currentInstanceIndex + droppedThisFrame
            if needed > pendingCapacity
                pendingCapacity = needed
            end
            droppedThisFrame = 0
        end
        currentInstanceIndex = 0
        currentDrawCommandIndex = 0
        currentDrawInstanceIndex = 0
        instanceMapping:PrepareForTransfers()
        
        currentShadowDrawCommandIndex = 0
        pointShadowListCount = 0
    end
    
    action End
    end
    
    action AddInstanceData(MeshVulkan mesh,
Texture texture,
Color diffuseColor,
Matrix4 modelMatrix)
        instanceMapping:TransferInstanceData(mesh, texture, diffuseColor, modelMatrix)
        currentInstanceIndex = currentInstanceIndex + 1
    end
    
    action AddInstanceData(VulkanBuffer vertexBuffer,
VulkanBuffer indexBuffer,
MaterialVulkan material,
Texture texture,
Color diffuseColor,
Matrix4 modelMatrix)
        instanceMapping:TransferInstanceData(vertexBuffer, indexBuffer, material, texture, diffuseColor, modelMatrix)
        currentInstanceIndex = currentInstanceIndex + 1
    end
    
    /*
    This action adds instances packed in a block, in one copy: the first count of them. The caller makes sure they fit
    (GetRoom), as for AddInstanceData.

    Attribute: Parameter block The packed instances.
    Attribute: Parameter count How many of them to add, from the first.
    */
    action AddInstanceBlock(VulkanInstanceBlock block, integer count)
        if count <= 0
            return now
        end
        instanceMapping:TransferInstanceBlock(block, 0, count)
        currentInstanceIndex = currentInstanceIndex + count
    end

    action AddDrawIndirectCommand(integer vertexCount, integer instanceCount, boolean hasShadows)
        AddDrawIndirectCommand(vertexCount, instanceCount, hasShadows, -1)
    end

    /*
    This action adds a draw command for the scene and, if the instances
    cast shadows, for the shadows, with the point lights whose shadow
    searches found the instances' models, one bit per light. -1 is every point light.

    Attribute: Parameter vertexCount How many vertices each instance draws.
    Attribute: Parameter instanceCount How many instances the command draws.
    Attribute: Parameter hasShadows True if the instances cast shadows.
    Attribute: Parameter shadowLights The point lights' bits, or -1 for all.
    */
    action AddDrawIndirectCommand(integer vertexCount, integer instanceCount, boolean hasShadows, integer shadowLights)
        AddDrawIndirectCommand(vertexCount, instanceCount, hasShadows, shadowLights, true)
    end

    /*
    This action adds a draw command for the shadows and, unless the
    instances draw only their shadows, for the
    scene, as the action without inScene does.

    Attribute: Parameter vertexCount How many vertices each instance draws.
    Attribute: Parameter instanceCount How many instances the command draws.
    Attribute: Parameter hasShadows True if the instances cast shadows.
    Attribute: Parameter shadowLights The point lights' bits, or -1 for all.
    Attribute: Parameter inScene False if the instances draw only their shadows.
    */
    action AddDrawIndirectCommand(integer vertexCount, integer instanceCount, boolean hasShadows, integer shadowLights, boolean inScene)
        if inScene
            drawDataMemory:Set(currentDrawCommandIndex, vertexCount, instanceCount, 0, currentDrawInstanceIndex)
        end
        
        if hasShadows
            shadowDrawDataMemory:Set(currentShadowDrawCommandIndex, vertexCount, instanceCount, 0, currentDrawInstanceIndex)
            if currentShadowDrawCommandIndex < shadowCommandMasks:GetSize()
                shadowCommandVertexCounts:Set(currentShadowDrawCommandIndex, vertexCount)
                shadowCommandInstanceCounts:Set(currentShadowDrawCommandIndex, instanceCount)
                shadowCommandFirstInstances:Set(currentShadowDrawCommandIndex, currentDrawInstanceIndex)
                shadowCommandMasks:Set(currentShadowDrawCommandIndex, shadowLights)
            end
            currentShadowDrawCommandIndex = currentShadowDrawCommandIndex + 1
        end
        
        if inScene
            currentDrawCommandIndex = currentDrawCommandIndex + 1
        end
        currentDrawInstanceIndex = currentDrawInstanceIndex + instanceCount
    end
    
    action Dispose
        instanceMapping:Dispose()
        drawDataMemory:Dispose()
        drawCommandBuffer:Dispose()
        shadowDrawDataMemory:Dispose()
        shadowDrawCommandBuffer:Dispose()
        if pointShadowDrawCommandBuffer not= undefined
            pointShadowDrawDataMemory:Dispose()
            pointShadowDrawCommandBuffer:Dispose()
        end
        instanceData:Dispose()
    end

    action GetDrawCommandBuffer returns VulkanBuffer
        return drawCommandBuffer
    end

    action GetDrawCommandCount returns integer
        return currentDrawCommandIndex
    end
    
    action GetShadowDrawCommandBuffer returns VulkanBuffer
        return shadowDrawCommandBuffer
    end
    
    action GetShadowDrawCommandCount returns integer
        return currentShadowDrawCommandIndex
    end

    /*
    This action makes each point light's list of shadow commands, the ones
    whose models its shadow search found, for this frame.
    Lights past Layer3D's MAXIMUM_SHADOW_BITS have no bit, and use every
    shadow command (GetShadowDrawCommandBuffer). Call it once, after the
    frame's commands are added and before the shadow pass is recorded.

    Attribute: Parameter pointLightCount How many point lights there are.
    */
    action BuildPointShadowLists(integer pointLightCount)
        integer lists = pointLightCount
        if lists > 30
            lists = 30
        end
        if lists < 0
            lists = 0
        end
        if pointShadowListStarts:GetSize() < lists
            pointShadowListStarts:SetSize(lists)
            pointShadowListCounts:SetSize(lists)
        end
        pointShadowListCount = lists
        integer commands = currentShadowDrawCommandIndex
        if commands > shadowCommandMasks:GetSize()
            commands = shadowCommandMasks:GetSize()
        end

        // First count each light's commands, so the buffer is large enough.
        integer total = 0
        integer light = 0
        repeat while light < lists
            integer bit = bits:ShiftLeft(1, light)
            integer count = 0
            integer command = 0
            repeat while command < commands
                if bits:And(shadowCommandMasks:Get(command), bit) not= 0
                    count = count + 1
                end
                command = command + 1
            end
            pointShadowListStarts:Set(light, total)
            pointShadowListCounts:Set(light, count)
            total = total + count
            light = light + 1
        end
        if total = 0
            return now
        end
        EnsurePointShadowCapacity(total)

        integer written = 0
        light = 0
        repeat while light < lists
            integer bit = bits:ShiftLeft(1, light)
            integer command = 0
            repeat while command < commands
                if bits:And(shadowCommandMasks:Get(command), bit) not= 0
                    pointShadowDrawDataMemory:Set(written, shadowCommandVertexCounts:Get(command), shadowCommandInstanceCounts:Get(command), 0, shadowCommandFirstInstances:Get(command))
                    written = written + 1
                end
                command = command + 1
            end
            light = light + 1
        end
    end

    /*
    This action makes sure the point lights' list buffer holds a number of
    commands, doubling its size as needed. An old buffer
    is retired, since frames on the GPU may still read it.

    Attribute: Parameter needed How many commands must fit.
    */
    private action EnsurePointShadowCapacity(integer needed)
        if needed <= pointShadowCommandCapacity
            return now
        end
        integer capacity = pointShadowCommandCapacity
        if capacity < 16
            capacity = 16
        end
        repeat while capacity < needed
            capacity = capacity * 2
        end
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        if pointShadowDrawCommandBuffer not= undefined
            pointShadowDrawDataMemory:Dispose()
            graphics:Retire(pointShadowDrawCommandBuffer)
        end
        VulkanConstants constants
        VulkanDrawIndirectData drawData
        VulkanBuffer buffer
        buffer:CreateMappableBuffer(device, capacity * drawData:GetByteSize(), constants:BUFFER_USAGE_INDIRECT_BUFFER_BIT)
        pointShadowDrawCommandBuffer = buffer
        pointShadowDrawDataMemory = buffer:MapToDrawIndirectDataMemory()
        pointShadowCommandCapacity = capacity
    end

    /*
    This action returns true if the point light at a place among the point
    lights has its own list of shadow commands this frame. If not, it uses every shadow command.

    Attribute: Parameter place The light's place among the point lights.
    Attribute: Returns True if it has its own list.
    */
    action HasPointShadowList(integer place) returns boolean
        return place >= 0 and place < pointShadowListCount
    end

    /*
    This action returns the buffer holding the point lights' lists of
    shadow commands. It is undefined until a list has had
    a command.

    Attribute: Returns The buffer.
    */
    action GetPointShadowDrawCommandBuffer returns VulkanBuffer
        return pointShadowDrawCommandBuffer
    end

    /*
    This action returns where a point light's list of shadow commands
    starts in GetPointShadowDrawCommandBuffer, in bytes.

    Attribute: Parameter place The light's place among the point lights.
    Attribute: Returns The list's offset in bytes.
    */
    action GetPointShadowDrawCommandOffset(integer place) returns integer
        VulkanDrawIndirectData drawData
        return pointShadowListStarts:Get(place) * drawData:GetByteSize()
    end

    /*
    This action returns how many shadow commands a point light's list has.

    Attribute: Parameter place The light's place among the point lights.
    Attribute: Returns The number of commands.
    */
    action GetPointShadowDrawCommandCount(integer place) returns integer
        return pointShadowListCounts:Get(place)
    end
    
    action GetInstanceDataBuffer returns VulkanBuffer
        return instanceData
    end

    action GetTextureGroupID returns integer
        return textureGroupID
    end
    
    action DEBUG_OutputValidation()
        instanceMapping:DEBUG_OutputValidation()
    end

end