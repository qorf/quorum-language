/*This class is used by the VulkanPainter3D to manage instance data and queue indirect draw commands.
Most users will never need to use this class directly.*/
class VulkanDrawQueue3D
    
    VulkanDevice device = undefined
    
    //Array<VulkanBuffer> instanceData
    //Array<VulkanNumber32BitMappedMemory> instanceMappings
    VulkanBuffer instanceData = undefined
    VulkanDrawQueue3DInstanceMappedMemory instanceMapping = undefined
    
    integer currentInstanceIndex = 0
    integer maxInstances = -1
    
    //VulkanDescriptorSetLayout instanceDataLayout = undefined
    //VulkanDescriptorSet instanceDataDescriptorSet = undefined
    
    // The size of a single buffer of instance data, in bytes and as 4-byte words.
    public constant integer INSTANCE_DATA_WORD_SIZE = 23
    public constant integer INSTANCE_DATA_BYTE_SIZE = INSTANCE_DATA_WORD_SIZE * 4
    
    // Indices for the location of instance data, aligned to word indices (not bytes).
    constant integer VERTEX_BUFFER_INDEX = 0
    constant integer INDEX_BUFFER_INDEX = 1
    constant integer MATERIAL_INDEX = 2
    constant integer TEXTURE_OVERRIDE = 3
    constant integer TEXTURE_INDEX = 4
    constant integer COLOR_OVERRIDE = 5
    constant integer DIFFUSE_COLOR_INDEX = 6
    constant integer TRANSFORM_MATRIX_INDEX = 7
    
    // A reusable array for transferring data to mapped memory in bulk.
    //Number32BitArray transferArray
    
    VulkanBuffer drawCommandBuffer = undefined
    VulkanDrawIndirectDataMappedMemory drawDataMemory = undefined
    integer currentDrawCommandIndex = 0
    integer currentDrawInstanceIndex = 0
    
    //NumberUtilities utility
    
    action Create(VulkanDevice device, VulkanGraphics graphics, integer maxInstances)
        me:device = device
        //transferArray:SetSize(INSTANCE_DATA_WORD_SIZE * maxInstances)
        
        VulkanConstants constants
        VulkanDescriptorSetManager setManager = graphics:GetDescriptorSetManager()
        
me:maxInstances = maxInstances
        //Array<VulkanDescriptorSetLayoutBinding> bindings
//
        //VulkanDescriptorSetLayoutBinding buffersBinding
        //buffersBinding:SetBinding(0)
        //buffersBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
        //buffersBinding:SetStageFlags(constants:SHADER_STAGE_VERTEX_BIT)
        //buffersBinding:SetDescriptorCount(maxInstances)
        //buffersBinding:SetBindingFlags(constants:DESCRIPTOR_BINDING_DYNAMIC)
        //bindings:Add(buffersBinding)
        //
        //VulkanDescriptorSetLayout instanceDataLayout
        //instanceDataLayout:CreateUpdateAfterBind(device, bindings)
        //me:instanceDataLayout = instanceDataLayout

        //ModelManagerVulkan modelManager = graphics:GetModelManager()
        //instanceDataLayout = modelManager:GetInstanceDataDescriptorSetLayout()
        
        //VulkanDescriptorSetManager descriptorSetManager = graphics:GetDescriptorSetManager()
        //instanceDataDescriptorSet = descriptorSetManager:CreateDescriptorSet(instanceDataLayout, constants:DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT)
        
        
        VulkanBuffer instanceData
        me:instanceData = instanceData
        instanceData:CreateMappableBuffer(device, maxInstances * INSTANCE_DATA_BYTE_SIZE, constants:BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT)
        
        //instanceMapping = instanceData:MapToNumber32BitMemory()
        VulkanDrawQueue3DInstanceMappedMemory instanceMapping
        me:instanceMapping = instanceMapping
        instanceMapping:Create(instanceData)
        
        // Also create the draw command buffer. In the worst case, every mesh is unique, so it's possible to have an equal number of draw commands and instances.
        VulkanBuffer buffer
        drawCommandBuffer = buffer
        
        // Dummy data used only to retrieve the size of each data structure in bytes. Needed to size the buffer.
        VulkanDrawIndirectData drawData
        
        drawCommandBuffer:CreateMappableBuffer(device, maxInstances * drawData:GetByteSize(), constants:BUFFER_USAGE_INDIRECT_BUFFER_BIT)
        drawDataMemory = drawCommandBuffer:MapToDrawIndirectDataMemory()
    end
    
    action Begin
        currentInstanceIndex = 0
        currentDrawCommandIndex = 0
        currentDrawInstanceIndex = 0
        instanceMapping:PrepareForTransfers()
    end
    
    action End
        //instanceMapping:Set(0, transferArray, 0, currentInstanceIndex * INSTANCE_DATA_WORD_SIZE)
    end
    
    //action GetNextInstanceData returns VulkanNumber32BitMappedMemory
        //VulkanNumber32BitMappedMemory result = GetInstanceData(currentInstanceIndex)
        //currentInstanceIndex = currentInstanceIndex + 1
        //return result
    //end
    
    //action GetInstanceData(integer index) returns VulkanNumber32BitMappedMemory
        //if instanceData:GetSize() < index
            //return instanceMappings:Get(index)
        //end
        //
        //if instanceData:GetSize() >= maxInstances
            //return undefined
        //end
        //
        //VulkanConstants constants
        //
        //VulkanBuffer buffer
        //buffer:CreateMappableBuffer(device, INSTANCE_DATA_BYTE_SIZE, constants:BUFFER_USAGE_UNIFORM_BUFFER_BIT)
        //instanceData:Add(buffer)
        //
        //VulkanNumber32BitMappedMemory mapping = buffer:MapToNumber32BitMemory()
        //instanceMappings:Add(mapping)
        //
        //VulkanDescriptorResourcesInfo bufferInfo
                //bufferInfo:SetDestinationBinding(0)
                //bufferInfo:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
                //bufferInfo:SetDestinationArrayElement(index)
                //bufferInfo:AddBufferInfo(buffer, 0, buffer:GetSize())
        //        
                //instanceDataDescriptorSet:LinkResources(bufferInfo)
        //
        //return mapping
    //end
    
    action AddInstanceData(MeshVulkan mesh,
Texture texture,
Color diffuseColor,
Matrix4 modelMatrix)
        instanceMapping:TransferInstanceData(mesh, texture, diffuseColor, modelMatrix)
        currentInstanceIndex = currentInstanceIndex + 1
    end
    
    action AddDrawIndirectCommand(integer vertexCount, integer instanceCount)
        drawDataMemory:Set(currentDrawCommandIndex, vertexCount, instanceCount, 0, currentDrawInstanceIndex)
        
        currentDrawCommandIndex = currentDrawCommandIndex + 1
        currentDrawInstanceIndex = currentDrawInstanceIndex + instanceCount
    end
    
    action Dispose
        instanceMapping:Dispose()
        drawDataMemory:Dispose()
        drawCommandBuffer:Dispose()
        instanceData:Dispose()
        //integer i = 0
        //repeat while i < instanceData:GetSize()
            //VulkanBuffer data = instanceData:Get(i)
            //VulkanNumber32BitMappedMemory mapping = instanceMappings:Get(i)
            //data:StopMapping()
            //data:Dispose()
            //mapping:Dispose()
            //i = i + 1
        //end
        //instanceDataLayout:Dispose()
        //instanceDataDescriptorSet:Dispose()
    end
    
    //action GetInstanceDataDescriptorSet returns VulkanDescriptorSet
        //return instanceDataDescriptorSet
    //end

    action GetDrawCommandBuffer returns VulkanBuffer
        return drawCommandBuffer
    end

    action GetDrawCommandCount returns integer
        return currentDrawCommandIndex
    end
    
    action GetInstanceDataBuffer returns VulkanBuffer
        return instanceData
    end

end