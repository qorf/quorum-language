package Libraries.Game.Graphics.Vulkan.Commands

use Libraries.Game.Graphics.Vulkan.VulkanConstants
use Libraries.Game.Graphics.Vulkan.VulkanPipeline
use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.VulkanComputePipeline

class BindComputePipelineCommand is VulkanCommand
VulkanComputePipeline pipeline = undefined
    integer bindPoint = 0
    
    on create
        VulkanConstants constants
        SetBindPoint(constants:PIPELINE_BIND_POINT_COMPUTE)
    end

    system action Record(VulkanCommandBuffer buffer)
    
action GetPipeline returns VulkanComputePipeline
        return pipeline
    end

    action SetPipeline(VulkanComputePipeline pipeline)
        me:pipeline = pipeline
    end

    action GetBindPoint returns integer
        return bindPoint
    end

    action SetBindPoint(integer bindPoint)
        me:bindPoint = bindPoint
    end
end
