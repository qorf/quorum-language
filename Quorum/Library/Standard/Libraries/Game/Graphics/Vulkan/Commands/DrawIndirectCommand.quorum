package Libraries.Game.Graphics.Vulkan.Commands

use Libraries.Game.Graphics.Vulkan.VulkanCommandBuffer
use Libraries.Game.Graphics.Vulkan.VulkanBuffer

class DrawIndirectCommand is VulkanCommand
    
    VulkanBuffer drawCommands = undefined
    integer offset = 0
    integer drawCount = 0
    integer stride = 0
    
    /*
    This action records this command into the provided command buffer.
    The command buffer must already be open for recording using the
    buffer's "BeginRecording" action.
    */
    system action Record(VulkanCommandBuffer buffer)

    action GetDrawCommands returns VulkanBuffer
        return drawCommands
    end

    action SetDrawCommands(VulkanBuffer drawCommands)
        me:drawCommands = drawCommands
    end

    action GetOffset returns integer
        return offset
    end

    action SetOffset(integer offset)
        me:offset = offset
    end

    action GetDrawCount returns integer
        return drawCount
    end

    action SetDrawCount(integer drawCount)
        me:drawCount = drawCount
    end

    action GetStride returns integer
        return stride
    end

    action SetStride(integer stride)
        me:stride = stride
    end

end