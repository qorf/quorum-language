package Libraries.Game.Graphics.Vulkan.Commands

use Libraries.Game.Graphics.Vulkan.all

class ComputeShaderDispatchCommand is VulkanCommand
    integer x = 1
    integer y = 1
    integer z = 1
    
    system action Record(VulkanCommandBuffer buffer)
    
    action GetX returns integer
        return x
    end

    action SetX(integer x)
        me:x = x
    end

    action GetY returns integer
        return y
    end

    action SetY(integer y)
        me:y = y
    end

    action GetZ returns integer
        return z
    end

    action SetZ(integer z)
        me:z = z
    end

end
