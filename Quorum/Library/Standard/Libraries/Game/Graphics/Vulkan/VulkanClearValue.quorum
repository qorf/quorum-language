package Libraries.Game.Graphics.Vulkan

class VulkanClearValue

    number red = -1
    number green = -1
    number blue = -1
    number alpha = -1

    number depth = 1
    integer stencil = 0
    
    boolean isColorValue = true
    boolean isDirty = true
    
    integer colorComponents = 4

    action SetColor(number red, number green, number blue)
        SetColor(red, green, blue, 1.0)
    end

    action SetColor(number red, number green, number blue, number alpha)
        me:red = red
        me:green = green
        me:blue = blue
        me:alpha = alpha

        isColorValue = true
        isDirty = true
    end

    action GetRed returns number
        return red
    end

    action SetRed(number red)
        me:red = red

        isColorValue = true
        isDirty = true
    end

    action GetGreen returns number
        return green
    end

    action SetGreen(number green)
        me:green = green

        isColorValue = true
        isDirty = true
    end

    action GetBlue returns number
        return blue
    end

    action SetBlue(number blue)
        me:blue = blue

        isColorValue = true
        isDirty = true
    end

    action GetAlpha returns number
        return alpha
    end

    action SetAlpha(number alpha)
        me:alpha = alpha

        isColorValue = true
        isDirty = true
    end

    action GetDepth returns number
        return depth
    end

    action SetDepth(number depth)
        me:depth = depth

        isColorValue = false
        isDirty = true
    end

    action GetStencil returns integer
        return stencil
    end

    action SetStencil(integer stencil)
        me:stencil = stencil

        isColorValue = false
        isDirty = true
    end

    action IsDirty returns boolean
        return isDirty
    end

    action ResetDirtyFlag
        isDirty = false
    end
    
    action IsColorClearValue returns boolean
        return isColorValue
    end
    
    action IsDepthStencilClearValue returns boolean
        return not isColorValue
    end

    action GetColorComponents returns integer
        return colorComponents
    end

    action SetColorComponents(integer colorComponents)
        me:colorComponents = colorComponents
    end

end