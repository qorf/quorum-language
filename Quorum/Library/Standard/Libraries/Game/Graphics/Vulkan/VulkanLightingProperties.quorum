package Libraries.Game.Graphics.Vulkan

use Libraries.Game.DesktopConfiguration
use Libraries.Containers.Array

/*This class holds configuration options for the lighting and shadow systems in Vulkan.
The values here are "constant" in the sense that once the application begins they will
not change, but their values are not set until the Game starts.

It also holds the global descriptor set */
class VulkanLightingProperties
    
    VulkanDevice device = undefined
    
    integer maximumLights = 16
    integer shadowMapCascadeCount = 1
    integer shadowMapSize = 4096
    // Each face of a point light's shadow map (Shadow plan S1).
    integer pointShadowMapSize = 512
    
    VulkanDescriptorSetLayout shadowCubemapsLayout = undefined

    // The sky light's cubes (Lighting plan L5): the sky's own, then four
    // smaller ones. Their set's layout is made the first time it is asked for.
    constant integer SKY_LIGHT_CUBE_COUNT = 5
    VulkanDescriptorSetLayout skyLightLayout = undefined

    // What is behind see-through models, for those that let light through
    // (Transmission plan T3): BEHIND_LEVEL_COUNT copies of the lit image,
    // each half the size of the last, from half the window's size. Their
    // set's layout is made the first time it is asked for.
    public constant integer BEHIND_LEVEL_COUNT = 4
    VulkanDescriptorSetLayout behindLayout = undefined

    action Create(VulkanDevice device, DesktopConfiguration configuration)
        me:device = device
        
        maximumLights = configuration:maximumLights
        shadowMapCascadeCount = configuration:shadowMapCascadeCount
        shadowMapSize = configuration:shadowMapSize
        pointShadowMapSize = configuration:pointShadowMapSize
        if pointShadowMapSize < 1
            pointShadowMapSize = 512
        end
    end
    
    action GetMaximumLights returns integer
        return maximumLights
    end

    action GetShadowMapCascadeCount returns integer
        return shadowMapCascadeCount
    end

    action GetShadowMapSize returns integer
        return shadowMapSize
    end

    /*
    This action returns the size, in pixels, of each face of a point
    light's shadow map (Shadow plan S1), from DesktopConfiguration's
    pointShadowMapSize.

    Attribute: Returns The size of a point light's shadow map face.
    */
    action GetPointShadowMapSize returns integer
        return pointShadowMapSize
    end

    action GetShadowCubemapsDescriptorSetLayout returns VulkanDescriptorSetLayout
        if shadowCubemapsLayout = undefined
            VulkanConstants constants
            Array<VulkanDescriptorSetLayoutBinding> bindings
            
            VulkanDescriptorSetLayoutBinding projectionBinding
            projectionBinding:SetBinding(0)
            projectionBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
            projectionBinding:SetDescriptorCount(1)
            projectionBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            bindings:Add(projectionBinding)
            
            VulkanDescriptorSetLayoutBinding cubemapBinding
            cubemapBinding:SetBinding(1)
            cubemapBinding:SetBindingFlags(constants:DESCRIPTOR_BINDING_DYNAMIC)
            cubemapBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
            cubemapBinding:SetDescriptorCount(GetMaximumLights())
            cubemapBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
            bindings:Add(cubemapBinding)

            VulkanDescriptorSetLayout layout
        layout:CreateUpdateAfterBind(device, bindings)
        shadowCubemapsLayout = layout
        end

        return shadowCubemapsLayout
    end

    /*
    This action returns how many cubes the sky light's descriptor set holds
    (Lighting plan L5): the sky's own cube, then four smaller, blurrier
    ones (64, 32, 16 and 8 pixels a side).

    Attribute: Returns The number of cubes, 5.
    */
    action GetSkyLightCubeCount returns integer
        return SKY_LIGHT_CUBE_COUNT
    end

    /*
    This action returns the layout of the set holding what is behind
    see-through models (Transmission plan T3): BEHIND_LEVEL_COUNT bindings,
    0 to 3, each one image sampler for the fragment shader, the sharpest
    first. Forward programs use it as set 6. It is made the first time.

    Attribute: Returns The layout.
    */
    action GetBehindDescriptorSetLayout returns VulkanDescriptorSetLayout
        if behindLayout = undefined
            VulkanConstants constants
            Array<VulkanDescriptorSetLayoutBinding> bindings
            integer i = 0
            repeat while i < BEHIND_LEVEL_COUNT
                VulkanDescriptorSetLayoutBinding binding
                binding:SetBinding(i)
                binding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
                binding:SetDescriptorCount(1)
                binding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
                bindings:Add(binding)
                i = i + 1
            end
            VulkanDescriptorSetLayout layout
            layout:Create(device, bindings)
            behindLayout = layout
        end
        return behindLayout
    end

    /*
    This action returns the layout of the sky light's descriptor set
    (Lighting plan L5): SKY_LIGHT_CUBE_COUNT bindings, 0 to 4, each one
    cube sampler for the fragment shader. The lighting pass uses it as set
    3, and forward programs, such as water and see-through models, as set
    5. It is made the first time.

    Attribute: Returns The layout.
    */
    action GetSkyLightDescriptorSetLayout returns VulkanDescriptorSetLayout
        if skyLightLayout = undefined
            VulkanConstants constants
            Array<VulkanDescriptorSetLayoutBinding> bindings
            integer i = 0
            repeat while i < SKY_LIGHT_CUBE_COUNT
                VulkanDescriptorSetLayoutBinding cubeBinding
                cubeBinding:SetBinding(i)
                cubeBinding:SetDescriptorType(constants:DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
                cubeBinding:SetDescriptorCount(1)
                cubeBinding:SetStageFlags(constants:SHADER_STAGE_FRAGMENT_BIT)
                bindings:Add(cubeBinding)
                i = i + 1
            end
            VulkanDescriptorSetLayout layout
            layout:Create(device, bindings)
            skyLightLayout = layout
        end
        return skyLightLayout
    end

end