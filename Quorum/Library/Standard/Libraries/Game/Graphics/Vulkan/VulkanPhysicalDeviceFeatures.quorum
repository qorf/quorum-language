package Libraries.Game.Graphics.Vulkan

class VulkanPhysicalDeviceFeatures
    
    boolean initialized = false
    VulkanPhysicalDevice physicalDevice = undefined
    
    action Create
        CreateNative()
        initialized = true
    end
    
    action Create(VulkanPhysicalDevice device)
        Create()
        GetSupportedDeviceFeatures(device)
    end
    
    private system action CreateNative
    
    system action GetSupportedDeviceFeatures(VulkanPhysicalDevice device)
    
    action IsInitialized returns boolean
        return initialized
    end
    
    action GetPhysicalDevice returns VulkanPhysicalDevice
        return physicalDevice
    end
    
    action Dispose
        DisposeNative()
        initialized = false
        physicalDevice = undefined
    end
    
    private system action DisposeNative
    
    action HasRobustBufferAccess returns boolean
        if initialized = false
            alert("I cannot return this value because the device features haven't been initialized yet. Call Create() first, or use Create(VulkanPhysicalDevice) to get a list of that device's available features.")
        end
        return NativeHasRobustBufferAccess()
    end

    private system action NativeHasRobustBufferAccess returns boolean

    action SetRobustBufferAccess(boolean robustBufferAccess)
        if initialized = false
            alert("I cannot set this value because the features haven't been initialized. Call Create() first.")
        end
        NativeSetRobustBufferAccess(robustBufferAccess)
    end

