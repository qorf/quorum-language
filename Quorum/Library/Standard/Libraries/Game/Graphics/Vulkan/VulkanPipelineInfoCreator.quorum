package Libraries.Game.Graphics.Vulkan

use Libraries.Containers.Array
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan

/*
This is a helper class that is used to create VulkanPipelineInfo objects for
initializing VulkanPipelines. This class makes it easier to add vertex data,
and automatically calculates both Vulkan offsets as well as the vertex offets
in Quorum (used to find elements in the structure of a DrawableShape, for example).
Most commonly, this class is used as part of a VulkanShaderMapping to create a
program's pipeline info.

Attribute: Example

package Libraries.Game.Graphics.Shaders.Vulkan.Mapping

use Libraries.Game.Graphics.Shaders.Vulkan.VulkanShaderProgram
use Libraries.Game.Graphics.Vulkan.all
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.DrawableShape
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.Vulkan.Commands.BindDescriptorSetCommand

class ExampleShaderMapping is VulkanShaderMapping

    // This is the index of the added vertex inputs within a DrawableShape.
    integer myVertexInputIndex1 = 0
    integer myVertexInputIndex2 = 0

    // Resources for a descriptor used by the pipeline. Used to set a uniform buffer in the fragment shader.
    VulkanBuffer uniformBuffer
    VulkanNumber32BitMappedMemory uniformBufferMemory = undefined
    VulkanDescriptorSet uniformDescriptorSet = undefined
    VulkanPipelineLayout pipelineLayout = undefined

    on create
        // The info creator will add the default 2D resources, 
        // so we add this command so the ShaderMapping will automatically receive these resources from the Painter2D during drawing.
        UseDefaultResources2D(true)
    end

    // Returns the size of each vertex in the DrawableShape (which stores values as numbers).
    // This will be the index of the last added vertex input, plus its size in the data structure.
    action GetVertexSize returns integer
        return myVertexInputIndex2 + 1
    end

    // This action is used to setup the values of a VulkanPipelineInfo that will be used to create the
    // VulkanPipeline needed for the shader program. This can also be used to create and keep copies of
    // any Vulkan resources that will be needed to send or change shader data.
    action CreatePipelineInfo(VulkanShaderProgram program, VulkanDevice device) returns VulkanPipelineInfo
        VulkanConstants constants

        // Make the info creator, start it, and add the default vertex inputs and descriptors for 2D shader programs in the game engine.
        VulkanPipelineInfoCreator creator
        creator:Begin(device)
        creator:AddDefaultInfo2D()
        
        // Add an extra vertex input. This one is a Vulkan 32-bit signed float. 
        // The returned index is the offset into a Quorum DrawableShape where this input will be placed.
        myVertexInputIndex1 = creator:AddVertexInput(constants:FORMAT_R32_SFLOAT)
        // The second input is a 32-bit unsigned integer.
        myVertexInputIndex2 = creator:AddVertexInput(constants:FORMAT_R32_UINT)
        
        // Add a binding for a uniform buffer that will be accessible in the program's fragment shader.
        creator:AddDescriptorSetLayoutBinding(constants:SHADER_STAGE_FRAGMENT_BIT, constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
        VulkanDescriptorSetLayout descriptorLayout = creator:FinishDescriptorSetLayout()
        
        // Create a uniform buffer for a 3x3 matrix, where each value is 4 bytes large (i.e. 9 32-bit floats).
        uniformBuffer:CreateMappableBuffer(device, 3 * 3 * 4, constants:BUFFER_USAGE_UNIFORM_BUFFER_BIT)
        uniformBufferMemory = uniformBuffer:MapToNumber32BitMemory()
        
        // Indicate which buffer will be used for the descriptor, and the start and end index of that buffer to read from.
        VulkanDescriptorResourcesInfo bufferResourcesInfo
        bufferResourcesInfo:SetDescriptorType(constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)
        bufferResourcesInfo:AddBufferInfo(uniformBuffer, 0, uniformBuffer:GetSize())

        // Use the DescriptorSetManager from the game's graphics system to create the descriptor, using the layout we made with the Creator.
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanDescriptorSetManager descriptorManager = graphics:GetDescriptorSetManager()
        uniformDescriptorSet = descriptorManager:CreateDescriptorSet(descriptorLayout, bufferResourcesInfo)
        
        // Finish creating the PipelineInfo, then store the created PipelineLayout so we can use it later.
        VulkanPipelineInfo info = creator:Finish()
        pipelineLayout = info:GetLayout()
        return info
    end
    
    // This action is used to update the vertex information sent from Quorum to the vertex shader.
    action SetVertexData(ShaderProgram program, Drawable drawable, DrawableShape shape)
        // Set any vertex input information here, using the indices the creator returned for us.
        shape:SetDataForAllVertices(myVertexInputIndex1, 3.14)
        shape:SetDataForAllVertices(myVertexInputIndex2, 1)
    end

    // This action is called when the shader program will begin rendering.
    action Begin(ShaderProgram program, Camera camera, VulkanCommandBuffer commandBuffer, integer swapchainIndex)
        // Update the mapped data, if needed. In this case, we're setting a 3x3 matrix with dummy values.
        integer counter = 0 
        repeat while counter < uniformBufferMemory:GetSize()
            uniformBufferMemory:Set(counter, counter * 2)
            counter = counter + 1
        end

        // Send a command to bind our descriptors. This will make our mapped descriptor data available in the shaders.
        //Because default 2D resources uses set indices 0 and 1, our descriptor set must be bound to set index = 2.        
        BindDescriptorSetCommand descriptorBind
        descriptorBind:SetPipelineLayout(pipelineLayout)
        descriptorBind:SetDescriptorSet(uniformDescriptorSet)
        descriptorBind:SetSetIndex(2)
        commandBuffer:Record(descriptorBind)
    end

end
*/
class VulkanPipelineInfoCreator
    
    VulkanConstants constants
    
    VulkanDevice device = undefined
    VulkanPipelineInfo info = undefined
    Array<VulkanVertexInputAttributeDescription> vertexAttributes = undefined
    Array<VulkanVertexInputBindingDescription> vertexBindings = undefined
    Array<VulkanPipelineColorBlendAttachmentState> colorBlendAttachments = undefined
    Array<integer> dynamicStates = undefined
    
    Array<VulkanDescriptorSetLayout> descriptorSetLayouts = undefined
    Array<VulkanDescriptorSetLayoutBinding> descriptorBindings = undefined
    integer currentDescriptorBindingIndex = 0
    
    // Values indicating offsets within the Vulkan buffers and Quorum buffers for the currently added vertex attributes.
    integer vulkanOffset = 0
    integer quorumOffset = 0
    
    integer currentAttributeIndex = 0
    
    integer currentVertexBindingIndex = 0
    integer vertexRate = constants:VERTEX_INPUT_RATE_VERTEX
    
    /*
    This action begins creating a new VulkanPipelineInfo. This action must be called before using other actions to add elements to the info.

    Attribute: Parameter device An initialized VulkanDevice that will be used when creating pipeline resources.
    */
    action Begin(VulkanDevice device)
        me:device = device
        
        VulkanPipelineInfo info
        me:info = info
        
        vertexAttributes = info:GetVertexInputAttributeDescriptions()
        vertexBindings = info:GetVertexInputBindingDescriptions()
        colorBlendAttachments = info:GetPipelineColorBlendAttachmentStates()
        dynamicStates = info:GetDynamicStates()
        
        Array<VulkanDescriptorSetLayout> descriptorSetLayouts
        me:descriptorSetLayouts = descriptorSetLayouts
        Array<VulkanDescriptorSetLayoutBinding> descriptorBindings
        me:descriptorBindings = descriptorBindings
        
        currentDescriptorBindingIndex = 0
        vulkanOffset = 0
        quorumOffset = 0
        currentAttributeIndex = 0
        currentVertexBindingIndex = 0
    end
    
    private action CheckHasBegun
        if device = undefined
            alert("The creator hasn't been initialized yet. Call Begin before using the creator.")
        end
    end
    
    /*
    This action creates a new vertex input binding, and sets its binding rate to per-vertex.
    The new binding will be empty and will not include any previously added vertex inputs.
    Previously added inputs will be in their own binding.

    This function is only needed if you have more than one set of vertex inputs for the pipeline.
    Most pipelines only need one set of vertex inputs, so this action isn't needed.
    */
    action NewVertexRateVertexInputBinding
        NewVertexInputBinding(constants:VERTEX_INPUT_RATE_VERTEX)
    end
    
    /*
    This action creates a new vertex input binding, and sets its binding rate to per-instance.
    The new binding will be empty and will not include any previously added vertex inputs.
    Previously added inputs will be in their own binding.

    This function is only needed if you have more than one set of vertex inputs for the pipeline.
    Most pipelines only need one set of vertex inputs, so this action isn't needed.
    */
    action NewInstanceRateVertexInputBinding
        NewVertexInputBinding(constants:VERTEX_INPUT_RATE_INSTANCE)
    end
    
    /*
    This action creates a new vertex input binding, and sets its binding rate to the requested rate.
    The new binding will be empty and will not include any previously added vertex inputs.
    Previously added inputs will be in their own binding.

    This function is only needed if you have more than one set of vertex inputs for the pipeline.
    Most pipelines only need one set of vertex inputs, so this action isn't needed.

    Attribute: Parameter vulkanVertexRate A VERTEX_INPUT_RATE value from the VulkanConstants class, indicating how the vertex inputs will be used.
    */
    action NewVertexInputBinding(integer vulkanVertexRate)
        CheckHasBegun()
        
        // Only create and add the previous binding if something was added to it.
        if currentAttributeIndex > 0
            FinishCurrentVertexInputBinding()
        end
        
        currentAttributeIndex = 0
        vulkanOffset = 0
        quorumOffset = 0
        currentVertexBindingIndex = currentVertexBindingIndex + 1
        vertexRate = vulkanVertexRate
    end
    
    private action FinishCurrentVertexInputBinding
        VulkanVertexInputBindingDescription binding
        binding:Set(currentVertexBindingIndex, vulkanOffset, vertexRate)
        vertexBindings:Add(binding)
    end
    
    /*
    This action finishes PipelineInfo creation. This action returns the created info, which will be ready for use, and
    resets any state in the creator. After calling Finish, other actions can't be called on the Creator unless the Begin
    action is called again first.

    Attribute: Returns The created VulkanPipelineInfo.
    */
    action Finish returns VulkanPipelineInfo
        CheckHasBegun()
        
        FinishCurrentVertexInputBinding()
        VulkanPipelineInfo result = info
        
        if not descriptorBindings:IsEmpty()
            FinishDescriptorSetLayout()
        end
        if not descriptorSetLayouts:IsEmpty()
            VulkanPipelineLayout pipelineLayout = info:GetLayout()
            pipelineLayout:Create(device, descriptorSetLayouts)
        end
        
        info = undefined
        vertexAttributes = undefined
        vertexBindings = undefined
        colorBlendAttachments = undefined
        dynamicStates = undefined
        descriptorSetLayouts = undefined
        device = undefined
        
        return result
    end
    
    /*
    This action adds a new vertex input to the current set, using the given data format.
    Internally, this creates a new VulkanVertexInputAttributeDescription, where the binding
    and attribute indices are automatically incremented and the offset is calculated.
    This action also returns an index that corresponds to this input's location within a
    Quorum DrawableShape. This index can be used with a DrawableShape to set this input's
    data in a ShaderMapping.

    Attribute: Parameter vulkanFormat A Vulkan FORMAT value from the VulkanConstants class, describing the data type of the input.
    Attribute: Returns An index to where the value will be expected within a Quorum DrawableShape.
    */
    action AddVertexInput(integer vulkanFormat) returns integer
        CheckHasBegun()
        
        integer quorumIndexResult = quorumOffset
        integer quorumSize = GetQuorumSize(vulkanFormat)
        
        if quorumSize < 0
            return -1
        end
        
        VulkanVertexInputAttributeDescription attribute
        attribute:Set(currentVertexBindingIndex, currentAttributeIndex, vulkanFormat, vulkanOffset)
        vertexAttributes:Add(attribute)
        
        currentAttributeIndex = currentAttributeIndex + 1
        vulkanOffset = vulkanOffset + GetVulkanSize(vulkanFormat)
        quorumOffset = quorumOffset + quorumSize
        
        return quorumIndexResult
    end
    
    private action GetQuorumSize(integer vulkanFormat) returns integer
        integer size = GetVulkanSize(vulkanFormat)
        boolean dividesEvenly = (size mod 4) = 0
        if size < 0
            return -1
        else
            size = size / 4    
        end

        if dividesEvenly = false
            size = size + 1
        end

        return size
    end
    
    private action GetVulkanSize(integer vulkanFormat) returns integer
        if vulkanFormat = constants:FORMAT_UNDEFINED
            return -1
        elseif vulkanFormat = constants:FORMAT_R4G4_UNORM_PACK8
            return 1
        elseif vulkanFormat = constants:FORMAT_R4G4B4A4_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_B4G4R4A4_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_R5G6B5_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_B5G6R5_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_R5G5B5A1_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_B5G5R5A1_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_A1R5G5B5_UNORM_PACK16
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_UNORM
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_SNORM
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_USCALED
            return  1
        elseif vulkanFormat = constants:FORMAT_R8_SSCALED
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_UINT
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_SINT
            return 1
        elseif vulkanFormat = constants:FORMAT_R8_SRGB
            return 1
        elseif vulkanFormat = constants:FORMAT_R8G8_UNORM
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_SNORM
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_USCALED
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_SSCALED
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_UINT
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_SINT
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8_SRGB
            return 2
        elseif vulkanFormat = constants:FORMAT_R8G8B8_UNORM
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_SNORM
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_USCALED
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_SSCALED
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_UINT
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_SINT
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8_SRGB
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_UNORM
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_SNORM
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_USCALED
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_SSCALED
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_UINT
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_SINT
            return 3
        elseif vulkanFormat = constants:FORMAT_B8G8R8_SRGB
            return 3
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_UNORM
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_SNORM
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_USCALED
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_SSCALED
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_UINT
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_SINT
            return 4
        elseif vulkanFormat = constants:FORMAT_R8G8B8A8_SRGB
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_UNORM
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_SNORM
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_USCALED
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_SSCALED
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_UINT
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_SINT
            return 4
        elseif vulkanFormat = constants:FORMAT_B8G8R8A8_SRGB
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_UNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_SNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_USCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_SSCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_UINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_SINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A8B8G8R8_SRGB_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_UNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_SNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_USCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_SSCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_UINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2R10G10B10_SINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_UNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_SNORM_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_USCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_SSCALED_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_UINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_A2B10G10R10_SINT_PACK32
            return 4
        elseif vulkanFormat = constants:FORMAT_R16_UNORM
            return 2
        elseif vulkanFormat = constants:FORMAT_R16_SNORM
            return 2
        elseif vulkanFormat = constants:FORMAT_R16_USCALED
            return 2
        elseif vulkanFormat = constants:FORMAT_R16_SSCALED
