    /*
    This action adds the provided VulkanPipelineColorBlendAttachmentState as a blending value to the PipelineInfo.
    
    Attribute: Parameter colorBlend The blending attachment state to be added to the info.
    */
    action AddColorBlendAttachmentState(VulkanPipelineColorBlendAttachmentState colorBlend)
        CheckHasBegun()
        colorBlendAttachments:Add(colorBlend)
    end
    
    /*
    This action adds a default VulkanPipelineColorBlendAttachmentState with transparency to the PipelineInfo.
    */
    action AddTransparentColorBlendAttachmentState
            CheckHasBegun()
            VulkanPipelineColorBlendAttachmentState colorBlend
            colorBlend:EnableDefaultTransparency()
            colorBlendAttachments:Add(colorBlend)
    end
    
    /*
    This action adds a default VulkanPipelineColorBlendAttachmentState with NO transparency to the PipelineInfo.
    */
    action AddOpaqueColorBlendAttachmentState
            CheckHasBegun()
            VulkanPipelineColorBlendAttachmentState colorBlend
            colorBlendAttachments:Add(colorBlend)
    end
    
    /*
    This action adds a dynamic state flag to the VulkanPipelineInfo. This will signal that certain parameters can change while the pipeline is active.

    Attribute: Parameter dynamicState A Vulkan DYNAMIC_STATE flag from the VulkanConstants class.
    */
    action AddDynamicState(integer dynamicState)
        CheckHasBegun()
        dynamicStates:Add(dynamicState)
    end
    
    /*
    This action adds the DYNAMIC_STATE_SCISSOR flag to the VulkanPipelineInfo, indicating that scissor values can change while the pipeline is active.
    */
    action AddDynamicScissor
        CheckHasBegun()
        AddDynamicState(constants:DYNAMIC_STATE_SCISSOR)
    end
    
    /*
    This action adds the DYNAMIC_STATE_VIEWPORT flag to the VulkanPipelineInfo, indicating that the viewport can change while the pipeline is active.
    */
    action AddDynamicViewport
        CheckHasBegun()
        AddDynamicState(constants:DYNAMIC_STATE_VIEWPORT)
    end
    
    /*
    This action adds a VulkanDescriptorSetLayoutBinding to the creator's current DescriptorSetLayout. The binding's index will be automatically set to
    the next binding in the layout (i.e., 0, then 1, then 2, etc.) If the creator doesn't have a DescriptorSetLayout yet, this will automatically make one and
    insert the binding.

    Attribute: Parameter binding The binding to add to the creator's current DescriptorSetLayout.
    */
    action AddDescriptorSetLayoutBinding(VulkanDescriptorSetLayoutBinding binding)
        CheckHasBegun()
        
        binding:SetBinding(currentDescriptorBindingIndex)
        currentDescriptorBindingIndex = currentDescriptorBindingIndex + 1
        descriptorBindings:Add(binding)
    end
    
    /*
    This action adds a new VulkanDescriptorSetLayoutBinding to the creator's current DescriptorSetLayout, which will be available in the given shader stages
    and will have the provided type. The binding's index will be automatically set to the next binding in the layout (i.e., 0, then 1, then 2, etc.) If the 
    creator doesn't have a DescriptorSetLayout yet, this will automatically make one and insert the binding.

    Attribute: Parameter stageFlags A combination of 1 or more Vulkan SHADER_STAGE flags, combined using bitwise OR or addition, indicating which shader stages the descriptor will be available in.
    Attribute: Parameter type A Vulkan DESCRIPTOR_TYPE value from the VulkanConstants class.
    */
    action AddDescriptorSetLayoutBinding(integer stageFlags, integer type) returns VulkanDescriptorSetLayoutBinding
        CheckHasBegun()
        
        VulkanDescriptorSetLayoutBinding binding
        binding:SetBinding(currentDescriptorBindingIndex)
        binding:SetStageFlags(stageFlags)
        binding:SetDescriptorType(type)
        currentDescriptorBindingIndex = currentDescriptorBindingIndex + 1
        descriptorBindings:Add(binding)
        return binding
    end
    
    /*
    This action finalizes any previously added DescriptorSetLayoutBindings and creates a VulkanDescriptorSetLayout. While this action is called automatically when
    Finish is called, users may want to manually call this action before Finish if they need the VulkanDescriptorSetLayout (e.g., to bind descriptor sets later).

    Attribute: Returns A VulkanDescriptorSetLayout containing all of the currently added descriptor bindings.
    */
    action FinishDescriptorSetLayout returns VulkanDescriptorSetLayout
        CheckHasBegun()
        
        if descriptorBindings = undefined or descriptorBindings:IsEmpty()
            return undefined
        end
        
        VulkanDescriptorSetLayout layout
        layout:Create(device, descriptorBindings)
        descriptorSetLayouts:Add(layout)
        
        currentDescriptorBindingIndex = 0
        Array<VulkanDescriptorSetLayoutBinding> bindings
        descriptorBindings = bindings
        return layout
    end
    
    /*
    This action adds an already created VulkanDescriptorSetLayout to the info. This can be used to share descriptor set layouts across different pipelines.
    If any bindings have been individually added to the Creator, this will automatically finalize them into a separate layout, as if using FinishDescriptorSetLayout,
    before adding the new layout to the Creator.

    Attribute: Parameter layout An already initialized VulkanDescriptorSetLayout to add to the PipelineInfo.
    */
    action AddDescriptorSetLayout(VulkanDescriptorSetLayout layout)
        CheckHasBegun()
        if not descriptorBindings:IsEmpty()
            FinishDescriptorSetLayout()
        end
        descriptorSetLayouts:Add(layout)
    end
    
    /*
    This action adds default resources to the PipelineInfo, allowing it to use the default information provided by a VulkanPainter2D.
    More specifically, it adds these vertex inputs:
    - X, Y, Z position coordinates, as a Vector3 of 32-bit signed floating point values.
    - RGBA vertex colors, as a Vector4 of 8-bit values normalized between 0 and 1.
    - Texture (U, V) coordinates, stored as a Vector2 of 32-bit signed floating point values.
    - A texture index value, stored as a 32-bit unsigned integer.

    It also adds a transparency-enabled color blend attachment and dynamic scissor and viewport states.
    Finally, it adds descriptor layouts for the default 2D camera, sampler, and global textures.

    If using these values, this action should be called before adding additional vertex inputs or descriptors.
    If using this inside a VulkanShaderMapping, that mapping should also call "UseDefaultResources2D(true)".
    */
    action AddDefaultInfo2D
        CheckHasBegun()
        
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanTextureManager textureManager = graphics:GetTextureManager()
        
        VulkanConstants constants
        // Add the X, Y, Z coordinates as a Vector3 of 32 bit signed float values.
        AddVertexInput(constants:FORMAT_R32G32B32_SFLOAT)
        // Add vertex colors as a Vector4 of 8 bit values normalized between 0 and 1.
        AddVertexInput(constants:FORMAT_R8G8B8A8_UNORM)
        // Add texture coordinates as a Vector2 of 32 bit signed float values.
        AddVertexInput(constants:FORMAT_R32G32_SFLOAT)
        // Add the texture index value as a 32 bit unsigned integer.
        AddVertexInput(constants:FORMAT_R32_UINT)
            
        // Use transparency for color blending for this pipeline.    
        AddTransparentColorBlendAttachmentState()

            // Define the dynamic states permitted by the pipeline. For our case, we want to be able to dynamically adjust viewport and scissor values.
        AddDynamicViewport()
        AddDynamicScissor()

        // Add a uniform for the camera, used during the vertex shader stage.
        AddDescriptorSetLayoutBinding(constants:SHADER_STAGE_VERTEX_BIT, constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)

        // Create a binding for a sampler to use during fragment shading, then add the sampler to the returned binding.
        VulkanDescriptorSetLayoutBinding samplerBinding = AddDescriptorSetLayoutBinding(constants:SHADER_STAGE_FRAGMENT_BIT, constants:DESCRIPTOR_TYPE_SAMPLER)
        Array<VulkanSampler> immutableSamplers
        VulkanSampler immutableSampler = textureManager:GetDefaultSampler()
        immutableSamplers:Add(immutableSampler)
        samplerBinding:SetImmutableSamplers(immutableSamplers)

        // We also need the descriptor set layout for the global textures. The texture manager holds onto that layout, so go fetch it.
        // Now, add the pre-existing layout to the set of layouts used by the pipeline we're making.
        AddDescriptorSetLayout(textureManager:GetGlobalTextureDescriptorSetLayout())
    end
    
    action AddDefaultInfo3D
        CheckHasBegun()
        
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        VulkanTextureManager textureManager = graphics:GetTextureManager()
        ModelManagerVulkan modelManager = graphics:GetModelManager()
        
        VulkanConstants constants
            
        // Use transparency for color blending for this pipeline.    
        AddTransparentColorBlendAttachmentState()

            // Define the dynamic states permitted by the pipeline. For our case, we want to be able to dynamically adjust viewport and scissor values.
        AddDynamicViewport()
        AddDynamicScissor()

        // Add a uniform for the camera, used during the vertex shader stage.
        AddDescriptorSetLayoutBinding(constants:SHADER_STAGE_VERTEX_BIT, constants:DESCRIPTOR_TYPE_UNIFORM_BUFFER)

        // Create a binding for a sampler to use during fragment shading, then add the sampler to the returned binding.
        VulkanDescriptorSetLayoutBinding samplerBinding = AddDescriptorSetLayoutBinding(constants:SHADER_STAGE_FRAGMENT_BIT, constants:DESCRIPTOR_TYPE_SAMPLER)
        Array<VulkanSampler> immutableSamplers
        VulkanSampler immutableSampler = textureManager:GetDefaultSampler()
        immutableSamplers:Add(immutableSampler)
        samplerBinding:SetImmutableSamplers(immutableSamplers)

        // We also need the descriptor set layout for the global textures. The texture manager holds onto that layout, so go fetch it.
        // Now, add the pre-existing layout to the set of layouts used by the pipeline we're making.
        //AddDescriptorSetLayout(textureManager:GetGlobalTextureDescriptorSetLayout())
        
        // Also add the descriptor set layout for the global mesh resources, taken from the model manager.
        //AddDescriptorSetLayout(modelManager:GetGlobalMeshDescriptorSetLayout())
        
        // We'll also need a layout for the instance data that is managed by the VulkanDrawQueue3Ds.
        //AddDescriptorSetLayout(modelManager:GetInstanceDataDescriptorSetLayout())
    end
    
end