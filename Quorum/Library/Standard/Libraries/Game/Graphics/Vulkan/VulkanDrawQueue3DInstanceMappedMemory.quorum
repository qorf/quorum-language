package Libraries.Game.Graphics.Vulkan
use Libraries.Game.Graphics.Models.Vulkan.MeshVulkan
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Color
use Libraries.Compute.Matrix4
use Libraries.Game.Graphics.Models.Vulkan.MaterialVulkan

/* A specialized class for optimized memory management of instance data for 3D drawing.
Users should not use this class directly. */
class VulkanDrawQueue3DInstanceMappedMemory
    
    VulkanBuffer parentBuffer = undefined
    boolean initialized = false

    action Create(VulkanBuffer buffer)
        if initialized
            alert("I couldn't create the mapped memory because it's already created! Use the Dispose() action before reusing it, or make a new object instead.")
        end
        if not buffer:SupportsMapping()
            alert("I can't create mapped memory using this VulkanBuffer because it wasn't created with the MEMORY_PROPERTY_HOST_VISIBLE_BIT memory property.")
        end
        if not buffer:IsMapping()
            boolean success = buffer:BeginMapping()
            if not success
                alert("Failed to begin mapping to memory with the VulkanBuffer!")
            end
        end

        parentBuffer = buffer
        CreateNative(buffer)
        initialized = true
    end
    
    private system action CreateNative(VulkanBuffer buffer)
    
    // Resets the internal insertion position to 0, so incoming instance data is set from the front of the buffer.
    system action PrepareForTransfers
    
    // Adds all data needed for a single instance of 3D rendering to the current insertion position in the buffer.
    action TransferInstanceData(MeshVulkan mesh, Texture texture, Color diffuse, Matrix4 transform)
        TransferInstanceData(mesh:GetVertexBuffer(), mesh:GetIndexBuffer(), mesh:GetMaterial(), texture, diffuse, transform)
    end
    
    system action TransferInstanceData(VulkanBuffer vertexBuffer, VulkanBuffer indexBuffer, MaterialVulkan material, Texture texture, Color diffuse, Matrix4 transform)
    
    action GetByteSize returns integer
        return parentBuffer:GetSize()
    end
    
    system action Dispose
    
    system action DEBUG_OutputValidation()
    
end