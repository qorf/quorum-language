package Libraries.Game.Graphics.Vulkan

use Libraries.Compute.BitwiseOperations
use Libraries.Containers.Array
use Libraries.Containers.Integer32BitArray
use Libraries.Containers.Number32BitArray
use Libraries.Compute.Matrix4
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Game.Graphics.Models.Vulkan.MeshVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelResourcesVulkan
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Texture
use Libraries.Game.Graphics.Models.Vulkan.MaterialVulkan
use Libraries.Game.Graphics.Models.Data.AnimationState
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram

class VulkanPainter3DBatch
    
    ModelBlueprintVulkan schematic = undefined
    // It's necessary to store individual models in order to provide per-instance data when drawing occurs.
    Array<Model> models
    integer meshesPerModel = 0

    // Which of the blueprint's meshes this batch draws (the mesh split): all
    // of them, only those with a see-through material, or only the others.
    // A model with a paper shade draws its opaque meshes in the scene pass,
    // where they hide one another, and only the shade after the lighting.
    public constant integer ALL_MESHES = 0
    public constant integer SEE_THROUGH_MESHES = 1
    public constant integer OPAQUE_MESHES = 2
    integer meshFilter = 0
    integer totalVertices = 0
    
    boolean isTransparent = false
    
    // The shader program this batch's models are drawn with, or undefined
    // for the default program.
    ShaderProgram program = undefined
    
    // How many frames have passed without using this batch. Can be used to determine if a batch hasn't been used in a long time and can be disposed.
    integer age = 0
    
    boolean isPending = false
    
    // How many meshes have been sent to each draw queue (by texture group)
    // this frame. An Integer32BitArray, not Array<integer>, so counting
    // doesn't box an Integer object on every Set, which made garbage every
    // frame. Its size is its capacity, grown by doubling as higher texture
    // groups appear (see EnsureUsesCapacity); drawQueueUseCount is how many
    // entries are in use, one past the highest group seen.
    Integer32BitArray drawQueueUses
    integer drawQueueUseCount = 0
    // For each draw queue, the point lights whose shadow searches found any
    // of those meshes' models, ORed together, so each point light draws
    // only its own casters (Shadow plan S2). Sized with drawQueueUses.
    Integer32BitArray drawQueueMasks
    BitwiseOperations bits

    // Kept to write a model's copies (Foliage plan F5) without making
    // objects each frame: a copy's full transform, and its shade's color.
    Matrix4 copyTransform
    Color copyColor

    on create
        // Integer32BitArray has no storage until SetSize. A few texture
        // groups is the usual most, and it grows if more are needed.
        drawQueueUses:SetSize(4)
        drawQueueMasks:SetSize(4)
    end
    
    action Create(ModelBlueprintVulkan schematic, boolean isTransparent)
        Create(schematic, isTransparent, undefined)
    end
    
    /*
    This action sets up the batch for one blueprint, drawn with the given
    shader program.

    Attribute: Parameter schematic The blueprint whose models this batch draws.
    Attribute: Parameter isTransparent True if the models have transparency.
    Attribute: Parameter program The shader program to draw with, or undefined for the default.
    */
    action Create(ModelBlueprintVulkan schematic, boolean isTransparent, ShaderProgram program)
        me:schematic = schematic
        me:isTransparent = isTransparent
        me:program = program
        
        Array<MeshVulkan> meshes = schematic:GetMeshes()
        meshesPerModel = meshes:GetSize()
        
        integer i = 0
        repeat while i < meshesPerModel
            totalVertices = totalVertices + meshes:Get(i):GetVertexCount()
            i = i + 1
        end
    end
    
    /*
    This action returns the shader program the batch is drawn with.

    Attribute: Returns The program, or undefined for the default program.
    */
    action GetProgram returns ShaderProgram
        return program
    end

    /*
    This action sets which of the blueprint's meshes this batch draws:
    ALL_MESHES, SEE_THROUGH_MESHES or OPAQUE_MESHES (the mesh split).

    Attribute: Parameter filter Which meshes to draw.
    */
    action SetMeshFilter(integer filter)
        meshFilter = filter
    end

    /*
    This action returns which of the blueprint's meshes this batch draws.

    Attribute: Returns ALL_MESHES, SEE_THROUGH_MESHES or OPAQUE_MESHES.
    */
    action GetMeshFilter returns integer
        return meshFilter
    end

    // Whether this batch draws a mesh, by its material (the mesh split).
    private action DrawsMesh(MeshVulkan mesh) returns boolean
        if meshFilter = ALL_MESHES
            return true
        end
        MaterialVulkan material = mesh:GetMaterial()
        boolean seeThrough = material not= undefined and material:IsSeeThrough()
        if meshFilter = SEE_THROUGH_MESHES
            return seeThrough
        end
        return not seeThrough
    end
    
    action IsTransparent returns boolean
        return isTransparent
    end

    action GetModelBlueprint returns ModelBlueprintVulkan
        return schematic
    end
    
    action Add(Model model)
        models:Add(model)
    end
    
    action PrepareForNextFrame
        models:Empty()
        isPending = false
        age = age + 1
        
        integer i = 0
        repeat while i < drawQueueUseCount
            drawQueueUses:Set(i, 0)
            drawQueueMasks:Set(i, 0)
            i = i + 1
        end
    end

    action ResetAge
        age = 0
    end

    action GetAge returns integer
        return age
    end
    
    action Dispose
        models = undefined
    end
    
    action SetPending(boolean pending)
        isPending = pending
    end
    
    action IsPending returns boolean
        return isPending
    end
    
    action GetModelCount returns integer
        return models:GetSize()
    end
    
    action GetMeshCount returns integer
        return models:GetSize() * meshesPerModel
    end
    
    // For all of the models in this batch, store their per-instance data and queue up indirect draw command(s).
    action ProcessBatch(VulkanPainter3D painter)
        if schematic:HasAnimations()
            integer i = 0
            repeat while i < meshesPerModel
                MeshVulkan mesh = schematic:GetMeshes():Get(i)
                if DrawsMesh(mesh)
                VulkanBuffer indexBuffer = mesh:GetIndexBuffer()
                MaterialVulkan material = mesh:GetMaterial()
                integer baseTextureGroup = material:GetTextureGroupIndex()
                
                integer j = 0
                repeat while j < models:GetSize()
                    Model model = models:Get(j)
                    ModelResourcesVulkan resources = cast(ModelResourcesVulkan, model:GetResources())
                    Color diffuseOverride = resources:GetColor(i)
                    Texture textureOverride = resources:GetTexture(i)
                    
                    VulkanBuffer vertexBuffer = resources:GetPostAnimationVertexBuffers():Get(i)
                    //VulkanBuffer vertexBuffer = mesh:GetVertexBuffer()
                    //if model:GetAnimationState() not= undefined
                        //// Get the animation vertex buffer associated with this mesh.
                        //vertexBuffer = resources:GetPostAnimationVertexBuffers():Get(i)
                    //end
                    
                    VulkanDrawQueue3D queue = undefined
                    if textureOverride not= undefined
                        queue = painter:GetCurrentDrawQueue(program, textureOverride:GetVulkanTextureGroupIndex())
                    else
                        queue = painter:GetCurrentDrawQueue(program, baseTextureGroup)
                    end
                    
                    // Each animated model potentially uses a different vertex buffer and must be drawn separately.
                    // An animated model's copies (Foliage plan F5) aren't
                    // drawn; only the model is. A full queue grows for the
                    // next frame.
                    if queue:GetRoom() > 0
                        queue:AddInstanceData(vertexBuffer, indexBuffer, material, textureOverride, diffuseOverride, model:GetTransform())
                        queue:AddDrawIndirectCommand(mesh:GetIndexCount(), 1, model:CastsShadows(), painter:GetShadowLightMask(model))
                    else
                        queue:NoteDropped(1)
                    end
                    
                    j = j + 1
                end
                end
                
                i = i + 1
            end
            
            else
            integer i = 0
            repeat while i < meshesPerModel
                MeshVulkan mesh = schematic:GetMeshes():Get(i)
                if DrawsMesh(mesh)
                integer baseTextureGroup = mesh:GetMaterial():GetTextureGroupIndex()
                
                // The models that cast shadows are written first, then the
                // others, each with their own draw commands, so a command's
                // shadow setting is right for every instance in it. (It used
                // to come from the last model for all of them.)
                integer pass = 0
                repeat while pass < 2
                    boolean shadowPass = true
                    if pass = 1
                        shadowPass = false
                    end
                    
                    integer j = 0
                    repeat while j < models:GetSize()
                        Model model = models:Get(j)
                        if model:CastsShadows() = shadowPass
                            integer shadowMask = 0
                            if shadowPass
                                shadowMask = painter:GetShadowLightMask(model)
                            end
                            ModelResourcesVulkan resources = cast(ModelResourcesVulkan, model:GetResources())
                            Color diffuseOverride = resources:GetColor(i)
                            Texture textureOverride = resources:GetTexture(i)
                            
                            integer group = baseTextureGroup
                            if textureOverride not= undefined
                                group = textureOverride:GetVulkanTextureGroupIndex()
                            end
                            VulkanDrawQueue3D queue = painter:GetCurrentDrawQueue(program, group)
                            
                            if model:GetCopyCount() > 0
                                // One instance per copy (Foliage plan F5).
                                integer written = AddCopies(queue, mesh, model, textureOverride, diffuseOverride)
                                AddUses(group, written, shadowMask)
                            elseif queue:GetRoom() > 0
                                queue:AddInstanceData(mesh, textureOverride, diffuseOverride, model:GetTransform())
                                AddUses(group, 1, shadowMask)
                            else
                                queue:NoteDropped(1)
                            end
                        end
                        j = j + 1
                    end
                    
                    FlushDrawCommands(painter, mesh, shadowPass)
                    pass = pass + 1
                end
                end
                
                i = i + 1
            end
        end
    end

    /*
    This action adds one draw command to each draw queue this mesh's
    instances were written to since the last commands, covering them, and
    starts the counts again (Foliage plan F5 split this out of ProcessBatch).

    Attribute: Parameter painter The painter, whose queues are used.
    Attribute: Parameter mesh The mesh the instances draw.
    Attribute: Parameter castsShadows True if every one of these instances casts shadows.
    */
    private action FlushDrawCommands(VulkanPainter3D painter, MeshVulkan mesh, boolean castsShadows)
        integer j = 0
        repeat while j < drawQueueUseCount
            integer uses = drawQueueUses:Get(j)
            if uses > 0
                // The queue is only looked up for groups that were
                // used, since looking one up makes it if it doesn't
                // exist yet.
                VulkanDrawQueue3D queue = painter:GetCurrentDrawQueue(program, j)
                queue:AddDrawIndirectCommand(mesh:GetIndexCount(), uses, castsShadows, drawQueueMasks:Get(j))
                drawQueueUses:Set(j, 0)
                drawQueueMasks:Set(j, 0)
            end
            j = j + 1
        end
    end

    /*
    This action writes one instance for each of a model's copies (Foliage
    plan F5): the model's transform times the copy's, and the copy's shade.
    A shade below 1 replaces the model's color with gray, as a separate
    model's color would. Copies that don't fit in the queue are left out
    this frame, and the queue grows for the next.

    Attribute: Parameter queue The draw queue for the mesh's texture group.
    Attribute: Parameter mesh The mesh to draw.
    Attribute: Parameter model The model with copies.
    Attribute: Parameter textureOverride The model's texture for this mesh, or undefined.
    Attribute: Parameter diffuseOverride The model's color for this mesh, or undefined.
    Attribute: Returns How many instances were written.
    */
    private action AddCopies(VulkanDrawQueue3D queue, MeshVulkan mesh, Model model, Texture textureOverride, Color diffuseOverride) returns integer
        integer count = model:GetCopyCount()
        integer room = queue:GetRoom()
        if count > room
            queue:NoteDropped(count - room)
            count = room
        end
        Number32BitArray transforms = model:GetCopyTransforms()
        Number32BitArray shades = model:GetCopyShades()
        Matrix4 base = model:GetTransform()
        integer copy = 0
        repeat while copy < count
            MultiplyCopy(base, transforms, copy * 16)
            Color color = diffuseOverride
            if shades not= undefined
                number shade = shades:Get(copy)
                if shade < 0.999
                    copyColor:SetColor(shade, shade, shade, 1)
                    color = copyColor
                end
            end
            queue:AddInstanceData(mesh, textureOverride, color, copyTransform)
            copy = copy + 1
        end
        return count
    end

    /*
    This action sets copyTransform to a model's transform times one copy's
    transform (Foliage plan F5). The copy's 16 numbers are column by
    column, as a Matrix4 is written to the GPU.

    Attribute: Parameter m The model's transform.
    Attribute: Parameter t The copies' transforms.
    Attribute: Parameter b Where the copy's first number is.
    */
    private action MultiplyCopy(Matrix4 m, Number32BitArray t, integer b)
        number c00 = t:Get(b)
        number c10 = t:Get(b + 1)
        number c20 = t:Get(b + 2)
        number c30 = t:Get(b + 3)
        number c01 = t:Get(b + 4)
        number c11 = t:Get(b + 5)
        number c21 = t:Get(b + 6)
        number c31 = t:Get(b + 7)
        number c02 = t:Get(b + 8)
        number c12 = t:Get(b + 9)
        number c22 = t:Get(b + 10)
        number c32 = t:Get(b + 11)
        number c03 = t:Get(b + 12)
        number c13 = t:Get(b + 13)
        number c23 = t:Get(b + 14)
        number c33 = t:Get(b + 15)
        Matrix4 r = copyTransform
        r:row0column0 = m:row0column0 * c00 + m:row0column1 * c10 + m:row0column2 * c20 + m:row0column3 * c30
        r:row0column1 = m:row0column0 * c01 + m:row0column1 * c11 + m:row0column2 * c21 + m:row0column3 * c31
        r:row0column2 = m:row0column0 * c02 + m:row0column1 * c12 + m:row0column2 * c22 + m:row0column3 * c32
        r:row0column3 = m:row0column0 * c03 + m:row0column1 * c13 + m:row0column2 * c23 + m:row0column3 * c33
        r:row1column0 = m:row1column0 * c00 + m:row1column1 * c10 + m:row1column2 * c20 + m:row1column3 * c30
        r:row1column1 = m:row1column0 * c01 + m:row1column1 * c11 + m:row1column2 * c21 + m:row1column3 * c31
        r:row1column2 = m:row1column0 * c02 + m:row1column1 * c12 + m:row1column2 * c22 + m:row1column3 * c32
        r:row1column3 = m:row1column0 * c03 + m:row1column1 * c13 + m:row1column2 * c23 + m:row1column3 * c33
        r:row2column0 = m:row2column0 * c00 + m:row2column1 * c10 + m:row2column2 * c20 + m:row2column3 * c30
        r:row2column1 = m:row2column0 * c01 + m:row2column1 * c11 + m:row2column2 * c21 + m:row2column3 * c31
        r:row2column2 = m:row2column0 * c02 + m:row2column1 * c12 + m:row2column2 * c22 + m:row2column3 * c32
        r:row2column3 = m:row2column0 * c03 + m:row2column1 * c13 + m:row2column2 * c23 + m:row2column3 * c33
        r:row3column0 = m:row3column0 * c00 + m:row3column1 * c10 + m:row3column2 * c20 + m:row3column3 * c30
        r:row3column1 = m:row3column0 * c01 + m:row3column1 * c11 + m:row3column2 * c21 + m:row3column3 * c31
        r:row3column2 = m:row3column0 * c02 + m:row3column1 * c12 + m:row3column2 * c22 + m:row3column3 * c32
        r:row3column3 = m:row3column0 * c03 + m:row3column1 * c13 + m:row3column2 * c23 + m:row3column3 * c33
    end

    /*
    This action counts instances written to a texture group's draw queue
    since its last draw command (Foliage plan F5).

    Attribute: Parameter index The texture group.
    Attribute: Parameter count How many instances were written.
    */
    private action AddUses(integer index, integer count, integer shadowMask)
        if count <= 0
            return now
        end
        EnsureUsesCapacity(index)
        if index >= drawQueueUseCount
            drawQueueUseCount = index + 1
        end
        drawQueueUses:Set(index, drawQueueUses:Get(index) + count)
        drawQueueMasks:Set(index, bits:Or(drawQueueMasks:Get(index), shadowMask))
    end
    
    /*
    This action makes sure drawQueueUses has room for a texture group. When
    it doesn't, a larger array is made (doubling until it fits), the counts
    are copied over, and it replaces the old one. That only happens when a
    higher texture group than any before appears, so after the first frames
    nothing more is made.

    Attribute: Parameter index The texture group, 0 or more.
    */
    private action EnsureUsesCapacity(integer index)
        integer capacity = drawQueueUses:GetSize()
        if index < capacity
            return now
        end
        integer newCapacity = capacity
        if newCapacity < 1
            newCapacity = 1
        end
        repeat while newCapacity <= index
            newCapacity = newCapacity * 2
        end
        Integer32BitArray grown
        grown:SetSize(newCapacity)
        Integer32BitArray grownMasks
        grownMasks:SetSize(newCapacity)
        integer i = 0
        repeat while i < capacity
            grown:Set(i, drawQueueUses:Get(i))
            grownMasks:Set(i, drawQueueMasks:Get(i))
            i = i + 1
        end
        // The new array starts at zero past the old capacity (Java's int
        // array is filled with 0).
        drawQueueUses = grown
        drawQueueMasks = grownMasks
    end

end