package Libraries.Game.Graphics.Vulkan
use Libraries.Containers.Array

class VulkanRenderPass is VulkanRetirable

    VulkanDevice device = undefined
    boolean initialized = false

    // The most samples any attachment has: 1, or the MSAA sample count for
    // a multisampled pass (Item 27). Pipelines made for this pass use it.
    integer sampleCount = 1

    action Create(VulkanDevice device, Array<VulkanAttachmentDescription> attachments,
        Array<VulkanSubpassDescription> subpasses, Array<VulkanSubpassDependency> subpassDependencies) returns boolean
        sampleCount = 1
        integer i = 0
        repeat while i < attachments:GetSize()
            integer samples = attachments:Get(i):GetSamples()
            if samples > sampleCount
                sampleCount = samples
            end
            i = i + 1
        end

        boolean success = CreateNative(device, attachments, subpasses, subpassDependencies)
        if success
            me:device = device
            initialized = true
        end

        return success
    end

    private system action CreateNative(VulkanDevice device, Array<VulkanAttachmentDescription> attachments,
        Array<VulkanSubpassDescription> subpasses, Array<VulkanSubpassDependency> subpassDependencies) returns boolean

    /*
    This action frees the render pass. Doing it twice does nothing.
    Pipelines and framebuffers made with it keep working; only recording
    a new use of the pass needs it. The GPU must have finished every frame
    that used it: use VulkanGraphics:Retire unless the device is idle.
    */
    action Dispose
        if not initialized
            return now
        end
        DisposeNative(device)
        initialized = false
    end

    private system action DisposeNative(VulkanDevice device)

    action GetDevice returns VulkanDevice
        return device
    end

    /*
    This action returns how many samples per pixel the pass draws with: 1,
    or the MSAA sample count for a multisampled pass. Pipelines drawing in
    the pass must use the same count.

    Attribute: Returns The sample count.
    */
    action GetSampleCount returns integer
        return sampleCount
    end


    /*
    This action frees the object once VulkanGraphics:Retire knows no frame
    on the GPU still uses it (Item 31). It is the same as Dispose.
    */
    action Release
        Dispose()
    end

end