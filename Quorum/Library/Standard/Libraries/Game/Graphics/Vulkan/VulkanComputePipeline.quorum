package Libraries.Game.Graphics.Vulkan

use Libraries.Containers.Array
use Libraries.Game.Graphics.Shaders.Shader

class VulkanComputePipeline
    VulkanDevice device = undefined
    VulkanComputePipelineInfo info = undefined
    boolean initialized = false

    action Create(VulkanDevice device, VulkanComputePipelineInfo info) returns boolean
boolean result = CreateNative(device,  info)

        if result
            me:device = device
            me:info = info
            
            initialized = true
        end
        return result
    end
    
    private system action CreateNative(VulkanDevice device, VulkanComputePipelineInfo info) returns boolean

    action Dispose
        alert("NYI")
    end

    action GetDevice returns VulkanDevice
        return device
    end
    
    action GetInfo returns VulkanComputePipelineInfo
        return info
    end
    
    action GetLayout returns VulkanPipelineLayout
        if info not= undefined
            return info:GetPipelineLayout()
        else
            return undefined
        end
    end

end
