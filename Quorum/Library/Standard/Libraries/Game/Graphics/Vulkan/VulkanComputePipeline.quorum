package Libraries.Game.Graphics.Vulkan

use Libraries.Containers.Array
use Libraries.Game.Graphics.Shaders.Shader

class VulkanComputePipeline
    VulkanDevice device = undefined
    VulkanComputePipelineInfo info = undefined
    boolean initialized = false

    action Create(VulkanDevice device, VulkanComputePipelineInfo info) returns boolean
boolean result = CreateNative(device,  info)

        if result
            me:device = device
            me:info = info
            
            initialized = true
        end
        return result
    end
    
    private system action CreateNative(VulkanDevice device, VulkanComputePipelineInfo info) returns boolean

    /*
    This action frees the pipeline. Nothing may still be running with it.
    Doing it twice does nothing.

    Attribute: Example

    use Libraries.Game.Graphics.Vulkan.VulkanComputePipeline

    VulkanComputePipeline pipeline
    // after Create, and once the device has finished with it
    pipeline:Dispose()
    */
    action Dispose
        if not initialized
            return now
        end
        DisposeNative(device)
        initialized = false
    end

    private system action DisposeNative(VulkanDevice device)

    /*
    This action returns true if the pipeline has been made and not freed.

    Attribute: Returns True if the pipeline exists.

    Attribute: Example

    use Libraries.Game.Graphics.Vulkan.VulkanComputePipeline

    VulkanComputePipeline pipeline
    output pipeline:IsInitialized()
    */
    action IsInitialized returns boolean
        return initialized
    end

    action GetDevice returns VulkanDevice
        return device
    end
    
    action GetInfo returns VulkanComputePipelineInfo
        return info
    end
    
    action GetLayout returns VulkanPipelineLayout
        if info not= undefined
            return info:GetPipelineLayout()
        else
            return undefined
        end
    end

end
