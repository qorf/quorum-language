package Libraries.Game.Graphics.Vulkan
use Libraries.Containers.Array
use Libraries.Game.Graphics.Shaders.Shader

class VulkanComputePipelineInfo
    Shader shader = undefined
    Array<VulkanDescriptorSetLayout> descriptionSetLayouts
VulkanPipelineCache cache = undefined
VulkanPipelineLayout pipelineLayout = undefined
    VulkanPushConstantRange pushConstants = undefined

    on create
        
    end
    
    action GetShader returns Shader
        return shader
    end
    
    action SetShader(Shader shader)
        me:shader = shader
    end
    
    action GetDescriptorSetLayouts returns Array<VulkanDescriptorSetLayout> 
        return descriptionSetLayouts
    end
    
    action SetDescriptorSetLayouts(Array<VulkanDescriptorSetLayout> layouts)
        me:descriptionSetLayouts = layouts
    end
    
    action GetPipelineCache returns VulkanPipelineCache
        return cache
end
    
    action SetPipelineCache(VulkanPipelineCache cache)
        me:cache = cache
    end
    

    action Copy returns VulkanComputePipelineInfo
        VulkanComputePipelineInfo copy

        
        return copy
    end

    action GetPipelineLayout returns VulkanPipelineLayout
        return pipelineLayout
    end

    action SetPipelineLayout(VulkanPipelineLayout pipelineLayout)
        me:pipelineLayout = pipelineLayout
    end
    
    action GetPushConstants returns VulkanPushConstantRange
        return pushConstants
    end

    action SetPushConstants(VulkanPushConstantRange pushConstants)
        me:pushConstants = pushConstants
    end

end
