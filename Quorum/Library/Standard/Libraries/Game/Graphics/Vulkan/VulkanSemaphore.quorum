package Libraries.Game.Graphics.Vulkan

class VulkanSemaphore is VulkanRetirable

    VulkanDevice device = undefined
    boolean initialized = false

    action Create(VulkanDevice device) returns boolean
        boolean result = CreateNative(device)

        if result
            me:device = device
            initialized = true
        end

        return result
    end

    private system action CreateNative(VulkanDevice device) returns boolean
    
    system action Dispose


    /*
    This action frees the semaphore once VulkanGraphics:Retire knows no
    frame still uses it (Item 32). It is the same as Dispose.
    */
    action Release
        Dispose()
    end

end