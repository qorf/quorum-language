package Libraries.Game.Graphics.Vulkan

class VulkanImageView is VulkanRetirable

    VulkanDevice device = undefined
    VulkanImage image = undefined
    VulkanImageViewInfo info = undefined
    boolean initialized = false

    action Create(VulkanDevice device, VulkanImage image, VulkanImageViewInfo viewInfo) returns boolean
        info = viewInfo:Copy()
        boolean success = CreateNative(device, image, info)

        if success
            me:device = device
            me:image = image
            initialized = true
        end

        return success
    end

    private system action CreateNative(VulkanDevice device, VulkanImage image, VulkanImageViewInfo info) returns boolean

    action GetImage returns VulkanImage
        return image
    end

    action GetInfo returns VulkanImageViewInfo
        return info
    end
    
system action Dispose


    /*
    This action frees the object once VulkanGraphics:Retire knows no frame
    on the GPU still uses it (Item 31). It is the same as Dispose.
    */
    action Release
        Dispose()
    end

end