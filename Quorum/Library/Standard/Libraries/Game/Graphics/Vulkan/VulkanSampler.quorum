package Libraries.Game.Graphics.Vulkan

class VulkanSampler is VulkanRetirable

    VulkanDevice device = undefined
    VulkanSamplerInfo info = undefined
    boolean initialized = false

    action Create(VulkanDevice device, VulkanSamplerInfo info) returns boolean
        boolean success = CreateNative(device, info)
        if success
            me:device = device
            me:info = info:Copy()
            initialized = true
        end

        return success
    end

    private system action CreateNative(VulkanDevice device, VulkanSamplerInfo info) returns boolean

    /*
    This action frees the sampler. Doing it twice does nothing.
    */
    action Dispose
        if not initialized
            return now
        end
        DisposeNative(device)
        initialized = false
    end

    private system action DisposeNative(VulkanDevice device)


    /*
    This action frees the object once VulkanGraphics:Retire knows no frame
    on the GPU still uses it (Item 31). It is the same as Dispose.
    */
    action Release
        Dispose()
    end

end