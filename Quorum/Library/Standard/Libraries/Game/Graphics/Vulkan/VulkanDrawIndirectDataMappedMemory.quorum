package Libraries.Game.Graphics.Vulkan
use Libraries.Containers.Array

class VulkanDrawIndirectDataMappedMemory
    
    VulkanBuffer parentBuffer = undefined
    boolean initialized = false

    action Create(VulkanBuffer buffer)
        if initialized
            alert("I couldn't create the mapped memory because it's already created! Use the Dispose() action before reusing it, or make a new object instead.")
        end
        if not buffer:SupportsMapping()
            alert("I can't create mapped memory using this VulkanBuffer because it wasn't created with the MEMORY_PROPERTY_HOST_VISIBLE_BIT memory property.")
        end
        if not buffer:IsMapping()
            boolean success = buffer:BeginMapping()
            if not success
                alert("Failed to begin mapping to memory with the VulkanBuffer!")
            end
        end

        parentBuffer = buffer
        CreateNative(buffer)
        initialized = true
    end

    private system action CreateNative(VulkanBuffer buffer)
    
    system action Dispose

    action Set(integer index, integer vertexCount, integer instanceCount, integer firstVertex, integer firstInstance)
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        SetNative(index, vertexCount, instanceCount, firstVertex, firstInstance)
    end

    private system action SetNative(integer index, integer vertexCount, integer instanceCount, integer firstVertex, integer firstInstance)
    
    action Set(integer index, VulkanDrawIndirectData data)
        Set(index, data:GetVertexCount(), data:GetInstanceCount(), data:GetFirstVertex(), data:GetFirstInstance())
    end

    action Set(Array<VulkanDrawIndirectData> array)
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        Set(0, array, 0, array:GetSize())
    end

    action Set(integer index, Array<VulkanDrawIndirectData> array)
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        Set(index, array, 0, array:GetSize())
    end

    action Set(integer index, Array<VulkanDrawIndirectData> array, integer arrayOffset, integer arrayItems)
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        integer i = arrayOffset
        integer target = index
        repeat arrayItems times
            Set(target, array:Get(i))
            i = i + 1
            target = target + 1
        end
    end
    
    /*This action returns how many bytes separate the beginning of each data structure inside the mapped memory.
This is equivalent to GetByteSize in the VulkanDrawIndirectData class.*/
    system action GetByteStride returns integer

    /*
    This action returns the size of the mapped memory as a count of 32-bit numbers. For example, if the memory
    is 20 bytes, then this would return size = 5 (because 4 32-bit numbers fit inside the memory).
    */
    action GetSize returns integer
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        return parentBuffer:GetSize() / GetByteStride()
    end

    /*
    This action returns the size of the mapped memory in bytes.
    */
    action GetByteSize returns integer
        if not initialized
            alert("I can't use this memory because it hasn't been initialized! Use Create(VulkanBuffer) first.")
        end

        return parentBuffer:GetSize()
    end
    
end