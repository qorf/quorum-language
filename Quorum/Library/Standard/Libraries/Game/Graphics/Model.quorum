package Libraries.Game.Graphics

use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Game.Graphics.ModelLoaders.ModelReader
use Libraries.Game.Scenes.SceneProperties
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Containers.HashTable
use Libraries.Compute.Matrix4
use Libraries.Compute.Vector3
use Libraries.Compute.Quaternion
use Libraries.Interface.Item3D
use Libraries.Game.BoundingBox
use Libraries.System.File
use Libraries.Game.Collision.Shapes.all
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Game.Graphics.Shaders.ShaderMapping
use Libraries.Game.Graphics.Models.ModelResources
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.OpenGL.OpenGLManager
use Libraries.Game.Graphics.Models.Vulkan.ModelResourcesVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Containers.Number32BitArray
use Libraries.Game.Graphics.Models.Vulkan.MaterialVulkan
use Libraries.Compute.Math
use Libraries.Compute.Vector4
use Libraries.Game.Graphics.Models.Data.Animation
use Libraries.Game.Graphics.Models.OpenGL.ModelResourcesOpenGL
use Libraries.Game.Graphics.Models.OpenGL.ModelBlueprintOpenGL
use Libraries.Game.Graphics.Models.Data.AnimationState
use Libraries.Game.Graphics.Models.Data.AnimationFrame
use Libraries.Interface.Accessibility
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.AccessibilityManager
use Libraries.Game.Layer3D
use Libraries.Game.Graphics.Models.Data.ModelLightData

/*
The Model class represents a 3D model to be drawn on the screen by the Game
engine. The Model can load data from .obj, .g3db, or .g3dj files, or can be set
to some primitive shapes (such as boxes or cylinders).

Attribute: Author William Allee

Attribute: Example

use Libraries.Game.Game
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color

class Main is Game

    Model cube

    action Main
        StartGame()
    end

    action CreateGame
        Color cyan
        cyan:SetColor(0, 0.75, 1, 1)
        
        cube:LoadBox(2, 2, 2, cyan)
        Add(cube)
    end

    action Update(number seconds)
        cube:Rotate(0, 1, 0, 45 * seconds)
    end
end
*/
class Model is Item3D
    
    ModelBlueprint modelBlueprint = undefined
	ModelResources resources = undefined

    // The box around this model's meshes, and the blueprint it was
    // measured from, so it is measured again only when that changes.
    BoundingBox meshBounds
    ModelBlueprint meshBoundsBlueprint = undefined

    integer modelType = 0

    // The color of this Model. Used only if a primitive shape has been loaded.
    Color diffuseColor = undefined

    /*
    The asset file that was used to load this asset. This might be a custom
    model file (e.g. ".obj") or it might be a texture applied to a primitive
    (e.g. ".png"). If this model doesn't use an asset file (e.g. it's a 
    non-textured primitive object) then this will remain undefined.
    */
    File assetFile = undefined

    // A custom shader program. If this isn't undefined, this will be used instead of the default shader to render this object.
    ShaderProgram shaderProgram = undefined

    // A custom shader mapping. If this isn't undefined, it will be used to map this Model's renderables to shader inputs when it's rendered by a shader.
    ShaderMapping shaderMapping = undefined

    /*
    An optional field with an arbitrary object containing additional data for use by a shader.
    This is undefined by default. If it isn't undefined, it's up to the ShaderMapping to determine
    how this data should be used. The default shaders/mappings will typically ignore this value.
    */
    Object shaderData = undefined
    
    AnimationState animationState = undefined
    // The first boolean tracks if this Model is treated as having transparency.
    // The second boolean is true if the transparency can be automatically set by setting colors or other means, or false if it was set manually.
    boolean hasTransparency = false
    boolean transparencyAutoSet = true
    
    boolean castsShadows = true

    // Lights read from a model file (Lighting plan L8): whether Load adds
    // them, and the lights added. Point and spot lights are children of the
    // model; directional lights go on the model's layer.
    boolean loadLights = true
    Array<Light> fileLights = undefined
    // Whether the lights Load adds cast shadows (Shadow plan S4).
    boolean fileLightsCastShadows = true
    // Each file light's culling range in the model's own units, before the
    // model is scaled, by the light's place in fileLights; 0 for lights
    // that have none. SetScale sizes them to the model (Lighting plan L8).
    Number32BitArray fileLightCullingRanges = undefined
    // Each file light's place and range in the model's own units, as the
    // file gives them, FILE_LIGHT_VALUES words a light (x, y, z, range), by
    // the light's place in fileLights. Point and spot lights are placed at
    // them times the model's scale, so a scaled lamp keeps its bulb in its
    // shade (Lighting plan V1).
    Number32BitArray fileLightPlaces = undefined
    constant integer FILE_LIGHT_VALUES = 4
    /*
    How many times the model's largest side a point light from its file
    draws objects into its shadows, when the file gives the light no range
    (Lighting plan L8). Without one, a bright light's shadows would take in
    objects hundreds of units away; a lamp's bulb only needs its room.
    */
    constant number FILE_LIGHT_CULLING_SIZES = 3
    
    on create
        SceneProperties properties
        modelType = properties:NONE
    end
    
    action HasAnimations returns boolean
        return modelBlueprint:HasAnimations()
    end
    
    
    action GetAnimation(integer index) returns Animation
return modelBlueprint:GetAnimation(index)
    end
    
    action GetAnimationsSize returns integer
return modelBlueprint:GetAnimationsSize()
    end
	
	/*
    Sets a reference to the ModelBlueprint that this model was loaded from.
    */
    private action SetModelBlueprint(ModelBlueprint schematic)
        modelBlueprint = schematic
        if resources = undefined
            if modelBlueprint is ModelBlueprintOpenGL
                ModelResourcesOpenGL glResources
                resources = glResources
            elseif modelBlueprint is ModelBlueprintVulkan
                ModelResourcesVulkan vulkanResources
                resources = vulkanResources
            else
                alert("NYI: No available resources for this blueprint type")
            end
            
            resources:SetModel(me)
        end
    end

    /*
    This action will return the ModelBlueprint that this model was loaded from.

    Attribute: Returns The ModelBlueprint that this Model was loaded from.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Game.Graphics.ModelBlueprint

    class Main is Game

        Model cube
        ModelBlueprint schematic = undefined

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)

            schematic = cube:GetModelBlueprint()
        end
    end

    */
    action GetModelBlueprint returns ModelBlueprint
        return modelBlueprint
    end

    /*
    This action fills in the box around the model's meshes, in its own
    coordinates, measured once for each blueprint (ModelBlueprintVulkan
    walks every vertex). It returns false if the blueprint can't give it:
    no blueprint, an OpenGL one, or one whose mesh data was freed.
    */
    private action GetMeshBounds(BoundingBox local) returns boolean
        if not (modelBlueprint is ModelBlueprintVulkan)
            return false
        end
        if meshBoundsBlueprint not= modelBlueprint
            ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, modelBlueprint)
            if vulkanBlueprint:IsReleased() or vulkanBlueprint:GetData() = undefined
                return false
            end
            meshBounds:Invalidate()
            vulkanBlueprint:ExtendBoundingBox(meshBounds)
            meshBoundsBlueprint = modelBlueprint
        end
        Vector3 minimum = meshBounds:GetMinimum()
        Vector3 maximum = meshBounds:GetMaximum()
        if minimum:GetX() <= maximum:GetX() and minimum:GetY() <= maximum:GetY() and minimum:GetZ() <= maximum:GetZ()
            local:Set(minimum, maximum)
            return true
        end
        return false
    end

    /*
    This action will return the identifier for the ModelBlueprint that this 
    model was loaded from.

    Attribute: Returns A text value identifying the ModelBlueprint used to load this Model.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)

            text id = cube:GetBlueprintKey()
            output "The cube's ModelBlueprint ID is " + id
        end
    end

    */
    action GetBlueprintKey returns text
        return modelBlueprint:GetKey()
    end

    /*
    This action returns the type of Model that has been loaded using one of the
    integer codes found in SceneProperties. By default, this value is NONE.

    Attribute: Returns An integer code representing the type of Model that has been loaded.
    */
    action GetModelType returns integer
        return modelType
    end

    /*
    This action sets the diffuse color of a primitive model. If the model did not
    previously have a color applied to it, it will add a color to it.
    */
    action SetColor(Color color)
        resources:SetColor(color)
        if transparencyAutoSet and color:GetAlpha() < 1.0
            hasTransparency = true
        end
    end
    
    /*Models can be made up of multiple parts, called meshes. This action sets the color of a specific mesh in the model
based on its index.*/
    action SetColor(integer meshIndex, Color color)
        if transparencyAutoSet and color:GetAlpha() < 1.0
            hasTransparency = true
        end
        resources:SetColor(meshIndex, color)
    end

    /*
    This action returns the diffuse color of a primitive model. If a primitive
    shape hasn't been loaded, this action will return undefined.
    */
    action GetColor returns Color
        return GetColor(0)
    end
    
    /*This action returns the color applied to one of the meshes of the Model, which is located at the given index.*/
    action GetColor(integer meshIndex) returns Color
        if resources is ModelResourcesVulkan
            ModelResourcesVulkan vulkanResources = cast(ModelResourcesVulkan, resources)
            return vulkanResources:GetColor(meshIndex)
        else
            if meshIndex = 0
                return diffuseColor
            else
                return undefined
            end
        end
    end

    /*
    This action will load a model from a given model file. The supported file
    extensions are .obj, .g3db, and .g3dj.

    Attribute: Parameter file The file containing the model data to be loaded.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.System.File
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model hat

        action Main
            StartGame()
        end

        action CreateGame
            File file
            file:SetPath("Sombrero.obj")
            hat:Load(file)
            Add(hat)
        end
    end

    */
    action Load(File file)
        SceneProperties properties
        modelType = properties:CUSTOM
        ModelBlueprint schematic = GetCachedBlueprint(file)
        Load(schematic)

        assetFile = file
        AddFileLights(schematic)
    end

    /*
    This action will load the Model file with the given file name from the
    default file directory. The supported file extensions are .obj, .g3db, and
    .g3dj.

    Attribute: Parameter fileName The name of the file to be loaded.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.System.File
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model cup

        action Main
            StartGame()
        end

        action CreateGame
            cup:Load("brown-mug.obj")
            Add(cup)
        end
    end
    */
    action Load(text fileName)
        File file
        file:SetPath(fileName)
        Load(file)
    end
    
    /*
    This action sets whether loading a model file also adds the lights the
    file holds, such as a lamp's bulb in a glTF file (Lighting plan L8). It
    is true by default. Set it before calling Load. Each point or spot light
    becomes a PointLight or SpotLight child of the model, named as in the
    file; each directional light becomes a DirectionalLight on the model's
    layer while the model is on one. Area lights become point lights.

    Attribute: Parameter load True to add the file's lights, false to leave them out.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game
        Model lamp

        action Main
            StartGame()
        end

        action CreateGame
            lamp:SetLoadLights(false)
            lamp:Load("Models/Lamp.gltf")
            Add(lamp)
        end
    end
    */
    action SetLoadLights(boolean load)
        loadLights = load
    end

    /*
    This action returns whether loading a model file also adds the lights
    the file holds (Lighting plan L8). It is true by default.

    Attribute: Returns True if the file's lights are added.
    */
    action GetLoadLights returns boolean
        return loadLights
    end

    /*
    This action sets whether the lights loading a model file adds cast
    shadows (Shadow plan S4). It is true by default. Set it before Load, or
    change each light afterward with GetFileLights and SetCastsShadows.
    Lights without shadows are cheaper: they have no shadow maps and draw
    nothing into them.

    Attribute: Parameter casts True for the file's lights to cast shadows.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game
        Model lamp

        action Main
            StartGame()
        end

        action CreateGame
            lamp:SetFileLightsCastShadows(false)
            lamp:Load("Models/Lamp.gltf")
            Add(lamp)
        end
    end
    */
    action SetFileLightsCastShadows(boolean casts)
        fileLightsCastShadows = casts
    end

    /*
    This action returns whether the lights loading a model file adds cast
    shadows (Shadow plan S4). See SetFileLightsCastShadows.

    Attribute: Returns True if the file's lights cast shadows.
    */
    action GetFileLightsCastShadows returns boolean
        return fileLightsCastShadows
    end

    /*
    This action returns the lights added from the model file when it was
    loaded (Lighting plan L8): PointLight, SpotLight and DirectionalLight
    objects. It is empty if the file had none, or SetLoadLights(false) was
    used. Changing a light here, such as its intensity, changes it in the
    scene.

    Attribute: Returns The lights added from the model file.
    */
    action GetFileLights returns Array<Light>
        if fileLights = undefined
            Array<Light> lights
            fileLights = lights
        end
        return fileLights
    end

    /*
    This action adds the lights the model file holds, as read into the
    blueprint (Lighting plan L8). Point and spot lights are positioned in
    the model's space as children; directional lights shine as in the file.
    */
    private action AddFileLights(ModelBlueprint schematic)
        if loadLights = false or schematic = undefined
            return now
        end
        if not (schematic is ModelBlueprintVulkan)
            return now
        end
        ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, schematic)
        Array<ModelLightData> lightData = vulkanBlueprint:GetLights()
        if lightData = undefined or lightData:IsEmpty()
            return now
        end

        Array<Light> lights = GetFileLights()
        if fileLightCullingRanges = undefined
            Number32BitArray ranges
            fileLightCullingRanges = ranges
        end
        fileLightCullingRanges:SetSize(lights:GetSize() + lightData:GetSize())
        if fileLightPlaces = undefined
            Number32BitArray places
            fileLightPlaces = places
        end
        fileLightPlaces:SetSize((lights:GetSize() + lightData:GetSize()) * FILE_LIGHT_VALUES)

        // How far a point light without a range of its own draws objects
        // into its shadows, in the model's own units.
        number largestSide = GetWidth()
        if GetHeight() > largestSide
            largestSide = GetHeight()
        end
        if GetDepth() > largestSide
            largestSide = GetDepth()
        end
        number modelCullingRange = largestSide * FILE_LIGHT_CULLING_SIZES

        integer i = 0
        repeat while i < lightData:GetSize()
            ModelLightData fileLight = lightData:Get(i)
            fileLightCullingRanges:Set(lights:GetSize(), 0)
            Color lightColor = fileLight:GetColor()
            Vector3 position = fileLight:GetPosition()
            Vector3 direction = fileLight:GetDirection()
            number strength = fileLight:GetQuorumIntensity()
            integer place = lights:GetSize() * FILE_LIGHT_VALUES
            fileLightPlaces:Set(place, position:GetX())
            fileLightPlaces:Set(place + 1, position:GetY())
            fileLightPlaces:Set(place + 2, position:GetZ())
            fileLightPlaces:Set(place + 3, fileLight:GetRange())

            if fileLight:IsDirectionalLight()
                DirectionalLight sun
                sun:SetColor(lightColor:GetRed(), lightColor:GetGreen(), lightColor:GetBlue(), 1)
                sun:SetDirection(direction:GetX(), direction:GetY(), direction:GetZ())
                sun:SetIntensity(strength)
                sun:SetCastsShadows(fileLightsCastShadows)
                lights:Add(sun)
                Layer3D currentLayer = GetLayer()
                if currentLayer not= undefined
                    currentLayer:Add(sun)
                end
            elseif fileLight:IsSpotLight()
                SpotLight spot
                spot:SetName(fileLight:GetName())
                spot:SetColor(lightColor:GetRed(), lightColor:GetGreen(), lightColor:GetBlue(), 1)
                spot:SetIntensity(strength)
                spot:SetCastsShadows(fileLightsCastShadows)
                spot:SetRange(fileLight:GetRange() * GetLargestScale())
                spot:SetConeAngles(fileLight:GetInnerAngle(), fileLight:GetOuterAngle())
                spot:SetDirection(direction:GetX(), direction:GetY(), direction:GetZ())
                spot:SetPosition(position:GetX() * GetScaleX(), position:GetY() * GetScaleY(), position:GetZ() * GetScaleZ())
                lights:Add(spot)
                Add(spot)
            else
                PointLight bulb
                bulb:SetName(fileLight:GetName())
                bulb:SetColor(lightColor:GetRed(), lightColor:GetGreen(), lightColor:GetBlue(), 1)
                bulb:SetIntensity(strength)
                bulb:SetCastsShadows(fileLightsCastShadows)
                // A point light has no range of its own; the file's range
                // limits its shadows instead, or, without one, a few times
                // the model's size. SetScale keeps it sized to the model.
                number cullingRange = modelCullingRange
                if fileLight:GetRange() > 0
                    cullingRange = fileLight:GetRange()
                end
                fileLightCullingRanges:Set(lights:GetSize(), cullingRange)
                bulb:SetCullingRange(cullingRange * GetLargestScale())
                bulb:SetPosition(position:GetX() * GetScaleX(), position:GetY() * GetScaleY(), position:GetZ() * GetScaleZ())
                lights:Add(bulb)
                Add(bulb)
            end
            i = i + 1
        end
    end

    /*
    This action sets the model's scale, as Item3D's SetScale does, and keeps
    the point and spot lights from its file sized to match: each is placed
    at its place in the file times the scale, so a lamp made larger keeps
    its bulb in its shade (Lighting plan V1), and their ranges grow with it,
    so it draws objects into its bulb's shadows from as far, for its size,
    as before (L8). The file's lights follow the model whether or not
    scaleChildren is true, as its meshes do.

    Attribute: Parameter scaleX The scale along the x axis.
    Attribute: Parameter scaleY The scale along the y axis.
    Attribute: Parameter scaleZ The scale along the z axis.
    Attribute: Parameter scaleChildren Whether the model's children are
    scaled too.
    */
    action SetScale(number scaleX, number scaleY, number scaleZ, boolean scaleChildren)
        parent:Item3D:SetScale(scaleX, scaleY, scaleZ, scaleChildren)
        UpdateFileLights(false)
    end

    /*
    This action scales the model by the given amounts, as Item3D's Scale
    does, and keeps the point and spot lights from its file placed and
    sized to match, as SetScale does (Lighting plan V1 and L8).

    Attribute: Parameter vector How much to scale along each axis.
    Attribute: Parameter scaleChildren Whether the model's children are
    scaled too.
    */
    action Scale(Vector3 vector, boolean scaleChildren)
        parent:Item3D:Scale(vector, scaleChildren)
        UpdateFileLights(true)
    end

    // The largest of the model's scales, ignoring sign.
    private action GetLargestScale returns number
        number largest = GetScaleX()
        if largest < 0
            largest = -largest
        end
        number y = GetScaleY()
        if y < 0
            y = -y
        end
        if y > largest
            largest = y
        end
        number z = GetScaleZ()
        if z < 0
            z = -z
        end
        if z > largest
            largest = z
        end
        return largest
    end

    /*
    Keeps the point and spot lights from the model's file sized to the
    model's scale: each is placed at its place in the file times the scale
    (Lighting plan V1), a spot light's range and a point light's culling
    range grow with the largest scale (L8). Item3D's SetScale doesn't move
    children, and a child's offset is set again to its parent's place
    whenever the parent moves, so the scale is kept in the light's own
    position. Item3D's Scale also moves children by their offsets, so after
    it (resetOffsets true) each light's offset is put back to the model's
    place, or the light would be moved twice.
    */
    private action UpdateFileLights(boolean resetOffsets)
        if fileLights = undefined
            return now
        end
        number largest = GetLargestScale()
        number sizeX = GetScaleX()
        number sizeY = GetScaleY()
        number sizeZ = GetScaleZ()
        number modelX = GetGlobalX()
        number modelY = GetGlobalY()
        number modelZ = GetGlobalZ()
        integer i = 0
        repeat while i < fileLights:GetSize()
            Light light = fileLights:Get(i)
            integer place = i * FILE_LIGHT_VALUES
            boolean hasPlace = fileLightPlaces not= undefined and (i + 1) * FILE_LIGHT_VALUES <= fileLightPlaces:GetSize()
            if light is PointLight
                PointLight bulb = cast(PointLight, light)
                if fileLightCullingRanges not= undefined and i < fileLightCullingRanges:GetSize()
                    number range = fileLightCullingRanges:Get(i)
                    if range > 0
                        bulb:SetCullingRange(range * largest)
                    end
                end
                if hasPlace
                    if resetOffsets
                        bulb:SetOffset(modelX, modelY, modelZ)
                    end
                    bulb:SetPosition(fileLightPlaces:Get(place) * sizeX, fileLightPlaces:Get(place + 1) * sizeY, fileLightPlaces:Get(place + 2) * sizeZ)
                end
            elseif light is SpotLight and hasPlace
                SpotLight spot = cast(SpotLight, light)
                if resetOffsets
                    spot:SetOffset(modelX, modelY, modelZ)
                end
                spot:SetPosition(fileLightPlaces:Get(place) * sizeX, fileLightPlaces:Get(place + 1) * sizeY, fileLightPlaces:Get(place + 2) * sizeZ)
                spot:SetRange(fileLightPlaces:Get(place + 3) * largest)
            end
            i = i + 1
        end
    end

    /*
    This action takes away the lights added from a model file, so loading
    again doesn't add them twice (Lighting plan L8).
    */
    private action RemoveFileLights
        if fileLights = undefined or fileLights:IsEmpty()
            return now
        end
        Layer3D currentLayer = GetLayer()
        integer i = 0
        repeat while i < fileLights:GetSize()
            Light light = fileLights:Get(i)
            if light is DirectionalLight
                if currentLayer not= undefined
                    currentLayer:Remove(cast(DirectionalLight, light))
                end
            elseif light is SpotLight
                SpotLight spot = cast(SpotLight, light)
                Remove(spot)
            elseif light is PointLight
                PointLight bulb = cast(PointLight, light)
                Remove(bulb)
            end
            i = i + 1
        end
        fileLights:Empty()
    end

    /*
    This action is called by the layer when the model is added to it or
    taken off it. Besides what every Item3D does, it moves the directional
    lights from the model file to the new layer, since they are not
    children of the model (Lighting plan L8). Most users will never need to
    use this action directly.

    Attribute: Parameter parentLayer The layer the model is now on, or undefined.
    */
    action SetLayer(Layer3D parentLayer)
        Layer3D previous = GetLayer()
        parent:Item3D:SetLayer(parentLayer)
        if fileLights = undefined or previous = parentLayer
            return now
        end
        integer i = 0
        repeat while i < fileLights:GetSize()
            Light light = fileLights:Get(i)
            if light is DirectionalLight
                DirectionalLight sun = cast(DirectionalLight, light)
                if previous not= undefined
                    previous:Remove(sun)
                end
                if parentLayer not= undefined
                    parentLayer:Add(sun)
                end
            end
            i = i + 1
        end
    end

    private action GetCachedBlueprint(File file) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedBlueprintOpenGL(file)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetModelBlueprint(file)
        end
    end
    

    /*
    This action will search the cached blueprint hash table for a ModelBlueprint
    that was loaded from the given file. If the blueprint was not loaded before,
    it will be loaded and cached.
    */
    private system action GetCachedBlueprintOpenGL(File file) returns ModelBlueprintOpenGL
    
    private action GetCachedDimensions(ModelBlueprint schematic) returns Vector3
        if UsingOpenGL()
            return GetCachedDimensionsOpenGL(cast(ModelBlueprintOpenGL, schematic))
        else
            ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, schematic)
            return vulkanBlueprint:GetDimensions()
        end
    end

    /*
    This action will return the base (that is, unscaled) dimensions of the axis
    aligned bounding box of the ModelBlueprint. This will return a cached value
    if there is one, or compute the dimensions then cache the result.
    */
    private system action GetCachedDimensionsOpenGL(ModelBlueprintOpenGL schematic) returns Vector3
    
    /*
    This action will load the Model with a box with the given width, height,
    depth, and color.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter color What color the box should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Color color)
        ModelBlueprint schematic = GetCachedBox(width, height, depth, color)
        Load(schematic)
        SetDiffuseColor(color)
        Box box
        box:Set(width, height, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:BOX
        diffuseColor = color
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture located in the provided file.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter textureFile A file containing a texture to show on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.System.File

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            File texture
            texture:SetPath("Crate.png")

            cube:LoadBox(2, 2, 2, texture)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, File textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadBox(width, height, depth, texture)
        assetFile = textureFile
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture located at the provided file path.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter textureFile The name of a texture file to be displayed on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            cube:LoadBox(2, 2, 2, "Box.png")
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, text textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadBox(width, height, depth, texture)
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture that has been loaded by the given
    Drawable.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
