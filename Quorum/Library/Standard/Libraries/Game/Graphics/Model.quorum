    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Drawable

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Drawable logo
            logo:Load("Logo.png")

            cube:LoadBox(2, 2, 2, logo)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Drawable drawable)
        Texture texture = drawable:GetTexture()
        LoadBox(width, height, depth, texture)
    end

    /*
    This action will load the Model with a box with the given width, height,
    depth, and texture.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            cube:LoadBox(2, 2, 2, texture)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Texture texture)
        ModelBlueprint schematic = GetCachedBox(width, height, depth, texture)
        Load(schematic)
        SetTexture(texture)
        Box box
        box:Set(width, height, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:BOX

        if texture:GetSource() not= undefined
            File file
            file:SetPath(texture:GetSource())
            assetFile = file
        end
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and color.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter color What color the plane should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            plane:LoadPlane(2, 2, cyan)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Color color)
        ModelBlueprint schematic = GetCachedPlane(width, depth, color, false)
        Load(schematic)
        SetDiffuseColor(color)
        
        Box box
        // Using a box with a thin height isn't correct -- it's only a rough
        // approximation, as we currently lack a "plane" shape.
        box:Set(width, 0.01, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:PLANE
        diffuseColor = color
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located in the provided file.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile A file containing a texture to show on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.System.File

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            File texture
            texture:SetPath("Floor.png")

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, File textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture)

        assetFile = textureFile
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located at the provided file path.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile The name of a texture file to be displayed on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            plane:LoadPlane(2, 2, "Box.png")
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, text textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture)
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture that has been loaded by the given
    Drawable.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Drawable

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Drawable logo
            logo:Load("Logo.png")

            plane:LoadPlane(2, 2, logo)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Drawable drawable)
        Texture texture = drawable:GetTexture()
        Vector4 coordinates
        coordinates:Set(drawable:GetLeftSide(), drawable:GetBottomSide(), drawable:GetRightSide(), drawable:GetTopSide())
        LoadPlane(width, depth, texture, coordinates)
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and texture.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture)
        LoadPlane(width, depth, texture, undefined)
    end
    
    /*
    This action will load the Model with a plane with the given width,
    depth, and texture. The texture will be sampled according to the texture
    coordinates provided, with the first two values providing the x and y
    coordinates of the first point on the texture, and the second values
    indicating the x y coordinates of the second point.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture, Vector4 textureCoordinates)
        LoadPlane(width, depth, texture, textureCoordinates, false)
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and color. If the boolean value provided is true, it will be double
    sided (allowing it to be viewed from both sides of the plane) -- otherwise,
    it will only visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter color What color the plane should be.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            plane:LoadPlane(2, 2, cyan, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Color color, boolean doubleSided)
        ModelBlueprint schematic = GetCachedPlane(width, depth, color, doubleSided)
        Load(schematic)
        SetDiffuseColor(color)
        Box box
        // Using a box with a thin height isn't correct -- it's only a rough
        // approximation, as we currently lack a "plane" shape.
        box:Set(width, 0.01, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:PLANE
        diffuseColor = color
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located in the provided file.
    If the boolean value provided is true, it will be double sided (allowing it 
    to be viewed from both sides of the plane) -- otherwise, it will only 
    visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
