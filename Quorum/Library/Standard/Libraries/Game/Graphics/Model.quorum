    /*
    This action will set the diffuse color of any Materials being used by this
    Model. Used after loading a cached primitive shape, in case the cached shape
    was built with a different color than this one.
    */
    private action SetDiffuseColor(Color color)
        diffuseColor = color
        SetColor(color)
    end

    /*
    This action will set the texture of any Materials being used by this Model.
    This is used after loading a cached primitive shape, in case the cached
    shape was using a different texture than this one.
    */
    private action SetTexture(Texture texture)
        resources:SetTexture(texture)
    end

    private action GetCachedBox(number width, number height, number depth, Color color) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedBoxOpenGL(width, height, depth, color)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetBoxBlueprint(width, height, depth)
        end
end
    
    /*
    Find a box matching the dimensions (but not necessarily color) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedBoxOpenGL(number width, number height, number depth, Color color) returns ModelBlueprintOpenGL
    
    private action GetCachedPlane(number width, number depth, Color color, boolean doubleSided) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedPlaneOpenGL(width, depth, color, doubleSided)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetPlaneBlueprint(width, depth, doubleSided)
        end
    end

    /*
    Find a plane matching the dimensions (but not necessarily color) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedPlaneOpenGL(number width, number depth, Color color, boolean doubleSided) returns ModelBlueprintOpenGL
    
    private action GetCachedCylinder(number width, number height, number depth, integer divisions, Color color) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedCylinderOpenGL(width, height, depth, divisions, color)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetCylinderBlueprint(width, height, depth, divisions)
        end
    end

    /*
    Find a cylinder matching the dimensions (but not necessarily color) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedCylinderOpenGL(number width, number height, number depth, integer divisions, Color color) returns ModelBlueprintOpenGL
    
    private action GetCachedSphere(number width, number height, number depth, integer hDivisions, integer vDivisions, Color color) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedSphereOpenGL(width, height, depth, hDivisions, vDivisions, color)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetSphereBlueprint(width, height, depth, hDivisions, vDivisions)
        end
    end

    /*
    Find a sphere matching the dimensions (but not necessarily color) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedSphereOpenGL(number width, number height, number depth, integer hDivisions, integer vDivisions, Color color) returns ModelBlueprintOpenGL
    
    private action GetCachedBox(number width, number height, number depth, Texture texture) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedBoxOpenGL(width, height, depth, texture)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetBoxBlueprint(width, height, depth)
        end
end

    /*
    Find a box matching the dimensions (but not necessarily texture) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedBoxOpenGL(number width, number height, number depth, Texture texture) returns ModelBlueprintOpenGL
    
    private action GetCachedPlane(number width, number depth, Texture texture, Vector4 coordinates, boolean doubleSided) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedPlaneOpenGL(width, depth, texture, doubleSided)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetPlaneBlueprint(width, depth, coordinates, doubleSided)
        end
end

    /*
    Find a plane matching the dimensions (but not necessarily texture) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedPlaneOpenGL(number width, number depth, Texture texture, boolean doubleSided) returns ModelBlueprintOpenGL

    private action GetCachedCylinder(number width, number height, number depth, integer divisions, Texture texture) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedCylinderOpenGL(width, height, depth, divisions, texture)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetCylinderBlueprint(width, height, depth, divisions)
        end
end
    
    /*
    Find a cylinder matching the dimensions (but not necessarily texture) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedCylinderOpenGL(number width, number height, number depth, integer divisions, Texture texture) returns ModelBlueprintOpenGL
    
    private action GetCachedSphere(number width, number height, number depth, integer hDivisions, integer vDivisions, Texture texture) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedSphereOpenGL(width, height, depth, hDivisions, vDivisions, texture)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetSphereBlueprint(width, height, depth, hDivisions, vDivisions)
        end
end

    /*
    Find a sphere matching the dimensions (but not necessarily texture) provided,
    and return it. If none is found, create a new one and cache it.
    */
    private system action GetCachedSphereOpenGL(number width, number height, number depth, integer hDivisions, integer vDivisions, Texture texture) returns ModelBlueprintOpenGL

    /*
    This action will load this Model using the data contained in the given
    ModelBlueprint.

    Attribute: Parameter loader The ModelBlueprint to load.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.ModelBlueprint
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model cube
        Model cubeCopy

        action Main
            StartGame()
        end

        action CreateGame
            Color mint
            mint:SetColor(0.5, 1, 0.75, 1)

            cube:LoadBox(2, 2, 2, mint)
            Add(cube)

            ModelBlueprint schematic = cube:GetModelBlueprint()
            cubeCopy:Load(schematic)
            Add(cubeCopy)

            cube:SetX(-2)
            cubeCopy:SetX(2)
        end
    end

    */
    action Load(ModelBlueprint loader)
        Load(loader, undefined)
    end

    /*
    This action will load this Model using the data contained in the given
    ModelBlueprint, and set its transform using the given Matrix4 (if it is
    defined).

    Attribute: Parameter loader The ModelBlueprint to load.
    Attribute: Parameter matrix The Matrix4 used to transform this Model.

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.ModelBlueprint
    use Libraries.Game.Graphics.Color
    use Libraries.Compute.Matrix4

    class Main is Game

        Model cube
        Model cubeCopy

        action Main
            StartGame()
        end

        action CreateGame
            Color mint
            mint:SetColor(0.5, 1, 0.75, 1)

            cube:LoadBox(2, 2, 2, mint)
            Add(cube)

            Matrix4 matrix
            matrix:SetToTranslation(2, 0, 0)
            matrix:Rotate(0, 1, 0, 45)

            ModelBlueprint schematic = cube:GetModelBlueprint()
            cubeCopy:Load(schematic, matrix)
            Add(cubeCopy)

            cube:SetX(-2)
        end
    end

    */
    action Load(ModelBlueprint loader, Matrix4 matrix)
        // Lights from an earlier model file go (Lighting plan L8).
        RemoveFileLights()
        ModelBlueprint previous = modelBlueprint
        SetModelBlueprint(loader)
        if matrix not= undefined
            GetTransform():Set(matrix)
        end

        resources:SetFromBlueprint(loader)

        // Under Vulkan, blueprints count the models using them, so one no
        // model uses can be freed (Item 33).
        if previous not= loader
            if loader is ModelBlueprintVulkan
                ModelManagerVulkan modelManager = GetModelManager()
                modelManager:AddUser(cast(ModelBlueprintVulkan, loader))
            end
            if previous not= undefined
                if previous is ModelBlueprintVulkan
                    ModelManagerVulkan previousManager = GetModelManager()
                    previousManager:RemoveUser(cast(ModelBlueprintVulkan, previous))
                end
            end
        end

        SetDimensions(GetCachedDimensions(loader))
    end

    /*
    This action frees the graphics memory this model uses. Under Vulkan,
    the model's own buffers are freed, and its blueprint (the meshes loaded
    from a file or made from model data) is freed too once no other model
    uses it. Boxes, planes, spheres and cylinders stay cached for reuse.
    Under OpenGL it does nothing yet.

    Remove the model from the game first. A disposed model draws nothing
    until it is loaded again.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game
        Model car

        action Main
            StartGame()
        end

        action CreateGame
            car:Load("Models/Car.obj")
            Add(car)
        end

        action Update(number seconds)
            // When the car is no longer needed:
            // Remove(car)
            // car:Dispose()
        end
    end
    */
    action Dispose
        if resources is ModelResourcesVulkan
            ModelResourcesVulkan vulkanResources = cast(ModelResourcesVulkan, resources)
            vulkanResources:Release()
            if modelBlueprint not= undefined
                if modelBlueprint is ModelBlueprintVulkan
                    ModelManagerVulkan modelManager = GetModelManager()
                    modelManager:RemoveUser(cast(ModelBlueprintVulkan, modelBlueprint))
                end
            end
            modelBlueprint = undefined
            resources = undefined
        end
    end

    /*
    GetRenderables is used to retrieve all of the individual renderable
    components of this Model. This action is used internally by the Game engine.
    Most users should never need to access this action directly.
    
    Attribute: Parameter renderables An array that will contain all of the retrieved Renderables.
    */
    action GetRenderables(Array<Renderable> renderables)
        if resources = undefined
            return now
        end
        
        resources:GetRenderables(renderables)
    end

    /*
    The Draw action is what makes a Model appear on the screen. This action
    will automatically be called by the Game class if the Model has been
    added to the Game with the Add(Item) action. Most users will never need to
    use this action directly.

    Attribute: Parameter painter The Painter3D being used to draw this Model.
    */
    action Draw(Painter3D painter)
        if not IsShowing()
            return now
        end

        painter:Render(me)

        parent:Item3D:Draw(painter)
    end

    /*
    CalculateBoundingBox will create a new BoundingBox object that contains the
    bounds of the Model.

    Attribute: Returns A new axis-aligned BoundingBox for this Model.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Game.BoundingBox

    class Main is Game

        Model cube
        
        action Main
            StartGame()
        end

        action CreateGame
            Color mint
            mint:SetColor(0.5, 1, 0.75, 1)
 
            cube:LoadBox(2, 2, 2, mint)
            Add(cube)

            BoundingBox box = cube:CalculateBoundingBox()
            output "The dimensions of the bounding box are: " + box:GetWidth() + ", " + box:GetHeight() + ", " + box:GetDepth()
        end
    end

    */
    action CalculateBoundingBox returns BoundingBox
        BoundingBox box
        return CalculateBoundingBox(box)
    end

    /*
    CalculateBoundingBox will compute the bounds of this Model, and then store
    them inside the provided BoundingBox object. If any data was previously
    stored in this BoundingBox, it will be overwritten.

    Attribute: Returns The given axis-aligned BoundingBox, which will contain the bounds of this Model.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Game.BoundingBox

    class Main is Game

        Model cube
        BoundingBox box
        
        action Main
            StartGame()
        end

        action CreateGame
            Color mint
            mint:SetColor(0.5, 1, 0.75, 1)

            cube:LoadBox(2, 2, 2, mint)
            Add(cube)

            cube:CalculateBoundingBox(box)
            output "The dimensions of the bounding box are: " + box:GetWidth() + ", " + box:GetHeight() + ", " + box:GetDepth()
        end
    end

    */
    action CalculateBoundingBox(BoundingBox box) returns BoundingBox
        box:Invalidate()
        return ExtendBoundingBox(box)
    end

    /*
    ExtendBoundingBox will expand the bounds of the given BoundingBox to fully
    encapsulate the bounds of this Model.

    Attribute: Parameter box The BoundingBox to extend.

    Attribute: Returns The given BoundingBox, which now includes the bounds of this Model.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Game.BoundingBox

    class Main is Game

        Model cube
        Model cylinder
        
        action Main
            StartGame()
        end

        action CreateGame
            Color blue
            blue:SetColor(0, 0, 1, 1)

            cube:LoadBox(2, 2, 2, blue)
            Add(cube)

            cylinder:LoadCylinder(1, 4, 1, blue)
            Add(cylinder)

            BoundingBox box = cube:CalculateBoundingBox()
            cylinder:ExtendBoundingBox(box)
            output "The dimensions of the bounding box are: " + box:GetWidth() + ", " + box:GetHeight() + ", " + box:GetDepth()
        end
    end

    */
    action ExtendBoundingBox(BoundingBox box) returns BoundingBox
        return modelBlueprint:ExtendBoundingBox(box)
    end

    /*
    This action returns the asset file that was used to load this asset. 
    This might be a custom model file (e.g. ".obj") or it might be a 
    texture applied to a primitive (e.g. ".png"). If this model doesn't 
    use an asset file (e.g. it's a non-textured primitive object) then 
    this will remain undefined.

    Attribute: Returns The file that was used to load this Model, or undefined if no such file has been used.
    */
    action GetAssetFile returns File
        return assetFile
    end

    action GetShaderProgram returns ShaderProgram
        return shaderProgram
    end

    action SetShaderProgram(ShaderProgram shaderProgram)
        me:shaderProgram = shaderProgram
    end

    action GetShaderMapping returns ShaderMapping
        return shaderMapping
    end

    action SetShaderMapping(ShaderMapping shaderMapping)
        me:shaderMapping = shaderMapping
    end

    action GetShaderData returns Object
        return shaderData
    end

    action SetShaderData(Object shaderData)
        me:shaderData = shaderData
    end
    
    private action UsingOpenGL returns boolean
        if resources not= undefined
            return resources is ModelResourcesOpenGL
        else
            GameStateManager manager
            return manager:GetGameGraphics() is OpenGLManager
        end
    end
    
    action GetResources returns ModelResources
        return resources
    end
    
    private action GetModelManager returns ModelManagerVulkan
        GameStateManager manager
        VulkanGraphics graphics = cast(VulkanGraphics, manager:GetGameGraphics())
        return graphics:GetModelManager()
    end
    
    action GetMeshCount returns integer
        return modelBlueprint:GetMeshCount()
    end
    
    action HasTransparency returns boolean
        return hasTransparency
    end
    
    action EnableTransparency(boolean enable)
        hasTransparency = enable
        transparencyAutoSet = false
    end

    action GetAnimationState returns AnimationState
        return animationState
    end

    action SetAnimationState(AnimationState animationState)
        me:animationState = animationState
        if animationState = undefined
            SetDescription("")
        end
    end
    
    action StartAnimation(integer index) returns AnimationState
        AnimationState state
        state:SetStarted(true)
        state:SetAnimationIndex(index)
        SetAnimationState(state)
        return state
    end
    
    action StopAnimation
        SetAnimationState(undefined)
    end
    
    action PauseAnimation
        if animationState not= undefined
            animationState:SetPaused(true)
        end
    end
    
    action ResumeAnimation
        if animationState not= undefined
            animationState:SetPaused(false)
        end
    end
    
    action IsAnimating returns boolean
        if animationState = undefined or not HasAnimations()
            return false
        end
        
        if animationState:IsStarted()
            return true
        else
            return false
        end
    end
    
    private action UpdateAnimationState(number seconds)
        if animationState = undefined or not HasAnimations()
            return now
        end
        
        if animationState:IsStarted() and (animationState:IsPaused() = false)
            integer index = animationState:GetAnimationIndex()
            if index < 0 or index >= GetAnimationsSize()
                return now
            end
            
            Animation animation = GetAnimation(index)
            if animation = undefined
                return now
            end
            
            Array<AnimationFrame> frames = animation:GetFrames()
            if frames = undefined
                return now
            end
            
            number adjustedSeconds = seconds * animationState:GetAnimationSpeed()
            boolean playingForward = adjustedSeconds >= 0.0
            
            number timePerFrame = animation:GetMilliseconds() / 1000
            integer frame = animationState:GetCurrentFrame()
            
            //calculate the frame that we are on
            number startTime = animationState:GetCurrentTime()
            number currentTime = startTime + adjustedSeconds
            number newFrameNumber = currentTime / timePerFrame
            integer newFrame = cast(integer, newFrameNumber)
            
            if playingForward
                if newFrame >= frames:GetSize()
                    integer endState = animationState:GetEndBehavior()
                    if endState = animationState:STOP_ON_COMPLETE
                        StopAnimation()
                    elseif endState = animationState:PAUSE_ON_COMPLETE
                        newFrame = frames:GetSize() - 1
                        currentTime = animation:GetFrames():GetSize() * timePerFrame
                        PauseAnimation()
                    elseif endState = animationState:LOOP_ON_COMPLETE
                        newFrame = 0
                        currentTime = 0
                    end
            end
            else
                if newFrame < 0
                    integer endState = animationState:GetEndBehavior()
                    if endState = animationState:STOP_ON_COMPLETE
                        StopAnimation()
                    elseif endState = animationState:PAUSE_ON_COMPLETE
                        newFrame = 0
                        currentTime = 0
                        PauseAnimation()
                    elseif endState = animationState:LOOP_ON_COMPLETE
                        newFrame = animation:GetFrames():GetSize() - 1
                        currentTime = (newFrame + 1) * timePerFrame
                    end
                end
            end
            
            if animationState not= undefined
                animationState:SetCurrentFrame(newFrame)
                animationState:SetCurrentTime(currentTime)
            end
            
            //somehow decide what the accessibility system does here.
            if startTime = 0 or (animationState not= undefined and animationState:HasLabelChange())
                text description = GetAnimationDescriptionLabelWithExtra(animation, animationState)
                NotifyAnimationChange(description)
                animationState:SetLabelChange(false)
            end
        end
    end
    
    Item3D dummyNode = undefined
    text dummyDescription = ""
    private action NotifyAnimationChange(text description)
        SetDescription(description)
        GameStateManager manager
        text newDummyDescription = GetName() + ", " + description
        if manager:GetAccessibility() is AccessibilityManager and newDummyDescription not= dummyDescription
            AccessibilityManager accessibility = cast(AccessibilityManager, manager:GetAccessibility())
            Item3D dummy
            dummy:SetLayer(GetLayer())
            dummy:SetFocusable(true)
            dummy:SetAccessibilityCode(parent:Item:CUSTOM)
            dummy:SetName(newDummyDescription)
            accessibility:Add(dummy)
            
            FocusEvent dummyEvent
            dummyEvent:Initialize(manager:GetFocus(), dummy)
            accessibility:FocusChanged(dummyEvent)
            
            if dummyNode not= undefined
                accessibility:Remove(dummyNode)
            end
            dummyNode = dummy
            dummyDescription = newDummyDescription
            //accessibility:Notify(me, GetName() + ", " + description)
        end
    end
    
    private action GetAnimationDescriptionLabelWithExtra(Animation animation, AnimationState state) returns text
        text name = animation:GetName()
                text extra = state:GetAnimationStateLabel()
        text total = name
        
                if extra = undefined
            return total
                else
                    return total + ", " + extra
                end
    end
    
    action UpdateAll(number seconds)
        parent:Item:UpdateAll(seconds)
        UpdateAnimationState(seconds)
    end
    
    action SetCastsShadows(boolean castsShadows)
        me:castsShadows = castsShadows
    end

    action CastsShadows returns boolean
        return castsShadows
    end

    // Copies (Foliage plan F5): more places to draw the model, each a
    // transform of 16 numbers relative to the model, and a shade for each.
    // The model's box for culling covers them all.
    Number32BitArray copyTransforms = undefined
    Number32BitArray copyShades = undefined
    integer copyCount = 0
    number copyLowestX = 0
    number copyLowestY = 0
    number copyLowestZ = 0
    number copyHighestX = 0
    number copyHighestY = 0
    number copyHighestZ = 0
    number copyLargestScale = 1

    // Each copy's color, three numbers (red, green, blue) per copy, or
    // undefined to use the shades (Dense grass plan DG4); a number that
    // changes whenever the copies do, so the renderer knows to pack them
    // again; and what the renderer keeps for drawing them (Dense grass plan
    // DG2), which the model only holds.
    Number32BitArray copyColors = undefined
    integer copyVersion = 0
    Object copyDrawingCache = undefined

    // True if the model draws only its shadow, not itself (Dense grass plan
    // DG3), such as a simpler stand-in that throws a detailed model's shadow.
    boolean shadowOnly = false

    /*
    This action gives the model copies: it is drawn once at each copy's
    transform, times the model's own, instead of once (Foliage plan F5).
    All copies are drawn together, so many copies cost far less than as
    many models. They share the model's colors, textures and shadow setting.
    The model keeps the arrays it is given; after changing them, call
    SetCopies again. Animated models draw no copies. Only the Vulkan
    renderer draws copies.

    Attribute: Parameter transforms 16 numbers per copy: its transform, column by column (as a Matrix4 is written to the GPU: row 0 to 3 of column 0, then column 1, and so on).
    Attribute: Parameter shades One number per copy, or undefined for none. A shade below 1 replaces the model's color with that gray, which its textures are multiplied by; 1 leaves it.

    Attribute: Example
    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Containers.Number32BitArray

    class Main is Game
        Model boxes

        action Main
            StartGame()
        end

        action CreateGame
            Color green
            green:SetColor(0, 0.6, 0, 1)
            boxes:LoadBox(1, 1, 1, green)
            Number32BitArray transforms
            transforms:SetSize(16 * 3)
            integer copy = 0
            repeat while copy < 3
                integer base = copy * 16
                transforms:Set(base, 1)
                transforms:Set(base + 5, 1)
                transforms:Set(base + 10, 1)
                transforms:Set(base + 15, 1)
                transforms:Set(base + 12, copy * 2)
                copy = copy + 1
            end
            boxes:SetCopies(transforms, undefined)
            Add(boxes)
        end
    end
    */
    action SetCopies(Number32BitArray transforms, Number32BitArray shades)
        if transforms = undefined
            ClearCopies()
            return now
        end
        integer count = transforms:GetSize() / 16
        if count * 16 not= transforms:GetSize()
            alert("A model's copies need 16 numbers each, but were given " + transforms:GetSize() + " numbers.")
        end
        if shades not= undefined and shades:GetSize() < count
            alert("A model's copies need one shade each, but " + count + " copies were given " + shades:GetSize() + " shades.")
        end
        copyTransforms = transforms
        copyShades = shades
        copyCount = count
        copyColors = undefined
        copyVersion = copyVersion + 1

        Math copyMath
        copyLargestScale = 0
        integer copy = 0
        repeat while copy < count
            integer base = copy * 16
            number copyX = transforms:Get(base + 12)
            number copyY = transforms:Get(base + 13)
            number copyZ = transforms:Get(base + 14)
            if copy = 0 or copyX < copyLowestX
                copyLowestX = copyX
            end
            if copy = 0 or copyY < copyLowestY
                copyLowestY = copyY
            end
            if copy = 0 or copyZ < copyLowestZ
                copyLowestZ = copyZ
            end
            if copy = 0 or copyX > copyHighestX
                copyHighestX = copyX
            end
            if copy = 0 or copyY > copyHighestY
                copyHighestY = copyY
            end
            if copy = 0 or copyZ > copyHighestZ
                copyHighestZ = copyZ
            end
            // The longest of its three axes is how much it is scaled.
            integer column = 0
            repeat while column < 3
                number a = transforms:Get(base + column * 4)
                number b = transforms:Get(base + column * 4 + 1)
                number c = transforms:Get(base + column * 4 + 2)
                number length = copyMath:SquareRoot(a * a + b * b + c * c)
                if length > copyLargestScale
                    copyLargestScale = length
                end
                column = column + 1
            end
            copy = copy + 1
        end
        NotifyCopiesChanged()
    end

    /*
    This action takes away the model's copies (Foliage plan F5), so it is
    drawn once again, at its own place.
    */
    action ClearCopies
        copyTransforms = undefined
        copyShades = undefined
        copyColors = undefined
        copyCount = 0
        copyVersion = copyVersion + 1
        NotifyCopiesChanged()
    end

    /*
    This action gives each copy its own color (Dense grass plan DG4), in
    place of its shade: three numbers per copy, red, green and blue, from 0
    to 1. The color replaces the model's color, which its textures are
    multiplied by. Call it after SetCopies, which clears the colors.

    Attribute: Parameter colors Three numbers per copy, or undefined to use the shades.
    */
    action SetCopyColors(Number32BitArray colors)
        if colors not= undefined and colors:GetSize() < copyCount * 3
            alert("A model's copies need three color numbers each, but " + copyCount + " copies were given " + colors:GetSize() + " numbers.")
        end
        copyColors = colors
        copyVersion = copyVersion + 1
    end

    /*
    This action returns the copies' colors (Dense grass plan DG4), three
    numbers per copy.

    Attribute: Returns The colors, or undefined if the copies use their shades.
    */
    action GetCopyColors returns Number32BitArray
        return copyColors
    end

    /*
    This action returns a number that changes whenever the copies, their
    shades or their colors change (Dense grass plan DG2), so the renderer
    can tell when to pack them again.

    Attribute: Returns The version.
    */
    action GetCopyVersion returns integer
        return copyVersion
    end

    /*
    This action returns what the renderer keeps for drawing the copies
    (Dense grass plan DG2). Only the renderer uses it.

    Attribute: Returns The renderer's data, or undefined.
    */
    action GetCopyDrawingCache returns Object
        return copyDrawingCache
    end

    /*
    This action sets what the renderer keeps for drawing the copies (Dense
    grass plan DG2). Only the renderer uses it.

    Attribute: Parameter cache The renderer's data, or undefined.
    */
    action SetCopyDrawingCache(Object cache)
        copyDrawingCache = cache
    end

    /*
    This action sets whether the model draws only its shadow (Dense grass
    plan DG3): it is not seen, but casts shadows like the model would. A
    foliage asset uses it to throw a detailed level's shadow from a simpler
    level. It needs CastsShadows to be true to have any effect. Only the
    Vulkan renderer draws shadows only, and not for animated models.

    Attribute: Parameter value True to draw only the shadow.

    Attribute: Example
    use Libraries.Game.Graphics.Model

    Model stand
    stand:Load("Models/TreeSimple.glb")
    stand:SetCastsShadows(true)
    stand:SetShadowOnly(true)
    */
    action SetShadowOnly(boolean value)
        shadowOnly = value
    end

    /*
    This action returns whether the model draws only its shadow (Dense
    grass plan DG3).

    Attribute: Returns True if only the shadow is drawn.
    */
    action IsShadowOnly returns boolean
        return shadowOnly
    end

    /*
    This action returns how many copies the model has (Foliage plan F5).

    Attribute: Returns The count, 0 when the model is drawn once.
    */
    action GetCopyCount returns integer
        return copyCount
    end

    /*
    This action returns the copies' transforms (Foliage plan F5), 16
    numbers each, column by column.

    Attribute: Returns The transforms, or undefined for none.
    */
    action GetCopyTransforms returns Number32BitArray
        return copyTransforms
    end

    /*
    This action returns the copies' shades (Foliage plan F5), one each.

    Attribute: Returns The shades, or undefined for none.
    */
    action GetCopyShades returns Number32BitArray
        return copyShades
    end

    /*
    This action tells the layer's render tree the model's box changed, if
    it is in one (Foliage plan F5).
    */
    private action NotifyCopiesChanged
        Libraries.Game.Layer3D layer = GetLayer()
        if layer = undefined
            return now
        end
        Libraries.Game.Graphics.Trees.RenderTree3D tree = layer:GetRenderTree()
        BoundingBox local
        if tree not= undefined and tree:Has(me) and GetRenderBounds(local)
            tree:SetLocalBounds(me, local)
        end
    end

    /*
    This action fills in the box around the model, in its own coordinates,
    for a layer that culls what it draws, and for screen readers
    (Item3D:GetScreenBounds). A model with copies (Foliage plan F5) gives a
    box around every copy: their places, widened by the model's size times
    the largest copy's scale, whichever way it is turned. Otherwise it is
    the box around the model's meshes, when the blueprint can give it: a
    mesh often doesn't sit centered on its model (a wall piece's base is
    usually at the model's position). Failing that, it is the box of the
    model's width, height and depth, centered on it.

    Attribute: Parameter local The box to fill in.
    Attribute: Returns True if the box was filled in, false if there is none.
    */
    action GetRenderBounds(BoundingBox local) returns boolean
        if copyCount <= 0
            if GetMeshBounds(local)
                return true
            end
            return parent:Item3D:GetRenderBounds(local)
        end
        Math boundsMath
        number modelWidth = GetWidth()
        number modelHeight = GetHeight()
        number modelDepth = GetDepth()
        number reach = boundsMath:SquareRoot(modelWidth * modelWidth + modelHeight * modelHeight + modelDepth * modelDepth) / 2 * copyLargestScale
        Vector3 minimum
        minimum:Set(copyLowestX - reach, copyLowestY - reach, copyLowestZ - reach)
        Vector3 maximum
        maximum:Set(copyHighestX + reach, copyHighestY + reach, copyHighestZ + reach)
        local:Set(minimum, maximum)
        return true
    end

    /*
    This action makes the model sway in the wind (Foliage plan F6): the
    renderer moves each point sideways by the strength times its height
    above the model's origin, back and forth over time. It changes the
    materials of the model's blueprint, so every model loaded from the
    same file or shape sways the same. Only the Vulkan renderer sways, in
    its 3D and shadow vertex shaders.

    Attribute: Parameter strength How far a point moves sideways per unit of height above the model's origin, such as 0.05; 0 for none.
    Attribute: Parameter directionDegrees The wind's direction about the up axis, in degrees from +x toward +z.

    Attribute: Example
    use Libraries.Game.Graphics.Model

    Model tree
    tree:Load("Models/Tree.glb")
    tree:SetSway(0.04, 30)
    */
    action SetSway(number strength, number directionDegrees)
        if modelBlueprint = undefined or UsingOpenGL()
            return now
        end
        if not (modelBlueprint is ModelBlueprintVulkan)
            return now
        end
        ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, modelBlueprint)
        Array<MaterialVulkan> materials = vulkanBlueprint:GetMaterials()
        if materials = undefined
            return now
        end
        integer i = 0
        repeat while i < materials:GetSize()
            MaterialVulkan material = materials:Get(i)
            if material not= undefined
                material:SetSway(strength, directionDegrees)
            end
            i = i + 1
        end
    end

end