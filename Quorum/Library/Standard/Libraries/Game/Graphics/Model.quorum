package Libraries.Game.Graphics

use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Game.Graphics.ModelLoaders.ModelReader
use Libraries.Game.Scenes.SceneProperties
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Containers.HashTable
use Libraries.Compute.Matrix4
use Libraries.Compute.Vector3
use Libraries.Compute.Quaternion
use Libraries.Interface.Item3D
use Libraries.Game.BoundingBox
use Libraries.System.File
use Libraries.Game.Collision.Shapes.all
use Libraries.Game.Graphics.Shaders.Programs.ShaderProgram
use Libraries.Game.Graphics.Shaders.ShaderMapping
use Libraries.Game.Graphics.Models.ModelResources
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.OpenGL.OpenGLManager
use Libraries.Game.Graphics.Models.Vulkan.ModelResourcesVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelManagerVulkan
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Compute.Vector4
use Libraries.Game.Graphics.Models.Data.Animation
use Libraries.Game.Graphics.Models.OpenGL.ModelResourcesOpenGL
use Libraries.Game.Graphics.Models.OpenGL.ModelBlueprintOpenGL
use Libraries.Game.Graphics.Models.Data.AnimationState
use Libraries.Game.Graphics.Models.Data.AnimationFrame
use Libraries.Interface.Accessibility
use Libraries.Interface.Events.FocusEvent
use Libraries.Interface.AccessibilityManager

/*
The Model class represents a 3D model to be drawn on the screen by the Game
engine. The Model can load data from .obj, .g3db, or .g3dj files, or can be set
to some primitive shapes (such as boxes or cylinders).

Attribute: Author William Allee

Attribute: Example

use Libraries.Game.Game
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color

class Main is Game

    Model cube

    action Main
        StartGame()
    end

    action CreateGame
        Color cyan
        cyan:SetColor(0, 0.75, 1, 1)
        
        cube:LoadBox(2, 2, 2, cyan)
        Add(cube)
    end

    action Update(number seconds)
        cube:Rotate(0, 1, 0, 45 * seconds)
    end
end
*/
class Model is Item3D
    
    ModelBlueprint modelBlueprint = undefined
	ModelResources resources = undefined

    integer modelType = 0

    // The color of this Model. Used only if a primitive shape has been loaded.
    Color diffuseColor = undefined

    /*
    The asset file that was used to load this asset. This might be a custom
    model file (e.g. ".obj") or it might be a texture applied to a primitive
    (e.g. ".png"). If this model doesn't use an asset file (e.g. it's a 
    non-textured primitive object) then this will remain undefined.
    */
    File assetFile = undefined

    // A custom shader program. If this isn't undefined, this will be used instead of the default shader to render this object.
    ShaderProgram shaderProgram = undefined

    // A custom shader mapping. If this isn't undefined, it will be used to map this Model's renderables to shader inputs when it's rendered by a shader.
    ShaderMapping shaderMapping = undefined

    /*
    An optional field with an arbitrary object containing additional data for use by a shader.
    This is undefined by default. If it isn't undefined, it's up to the ShaderMapping to determine
    how this data should be used. The default shaders/mappings will typically ignore this value.
    */
    Object shaderData = undefined
    
    AnimationState animationState = undefined
    // The first boolean tracks if this Model is treated as having transparency.
    // The second boolean is true if the transparency can be automatically set by setting colors or other means, or false if it was set manually.
    boolean hasTransparency = false
    boolean transparencyAutoSet = true
    
    boolean castsShadows = true
    
    on create
        SceneProperties properties
        modelType = properties:NONE
    end
    
    action HasAnimations returns boolean
        return modelBlueprint:HasAnimations()
    end
    
    
    action GetAnimation(integer index) returns Animation
return modelBlueprint:GetAnimation(index)
    end
    
    action GetAnimationsSize returns integer
return modelBlueprint:GetAnimationsSize()
    end
	
	/*
    Sets a reference to the ModelBlueprint that this model was loaded from.
    */
    private action SetModelBlueprint(ModelBlueprint schematic)
        modelBlueprint = schematic
        if resources = undefined
            if modelBlueprint is ModelBlueprintOpenGL
                ModelResourcesOpenGL glResources
                resources = glResources
            elseif modelBlueprint is ModelBlueprintVulkan
                ModelResourcesVulkan vulkanResources
                resources = vulkanResources
            else
                alert("NYI: No available resources for this blueprint type")
            end
            
            resources:SetModel(me)
        end
    end

    /*
    This action will return the ModelBlueprint that this model was loaded from.

    Attribute: Returns The ModelBlueprint that this Model was loaded from.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color
    use Libraries.Game.Graphics.ModelBlueprint

    class Main is Game

        Model cube
        ModelBlueprint schematic = undefined

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)

            schematic = cube:GetModelBlueprint()
        end
    end

    */
    action GetModelBlueprint returns ModelBlueprint
        return modelBlueprint
    end

    /*
    This action will return the identifier for the ModelBlueprint that this 
    model was loaded from.

    Attribute: Returns A text value identifying the ModelBlueprint used to load this Model.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)

            text id = cube:GetBlueprintKey()
            output "The cube's ModelBlueprint ID is " + id
        end
    end

    */
    action GetBlueprintKey returns text
        return modelBlueprint:GetKey()
    end

    /*
    This action returns the type of Model that has been loaded using one of the
    integer codes found in SceneProperties. By default, this value is NONE.

    Attribute: Returns An integer code representing the type of Model that has been loaded.
    */
    action GetModelType returns integer
        return modelType
    end

    /*
    This action sets the diffuse color of a primitive model. If the model did not
    previously have a color applied to it, it will add a color to it.
    */
    action SetColor(Color color)
        resources:SetColor(color)
        if transparencyAutoSet and color:GetAlpha() < 1.0
            hasTransparency = true
        end
    end
    
    /*Models can be made up of multiple parts, called meshes. This action sets the color of a specific mesh in the model
based on its index.*/
    action SetColor(integer meshIndex, Color color)
        if transparencyAutoSet and color:GetAlpha() < 1.0
            hasTransparency = true
        end
        resources:SetColor(meshIndex, color)
    end

    /*
    This action returns the diffuse color of a primitive model. If a primitive
    shape hasn't been loaded, this action will return undefined.
    */
    action GetColor returns Color
        return GetColor(0)
    end
    
    /*This action returns the color applied to one of the meshes of the Model, which is located at the given index.*/
    action GetColor(integer meshIndex) returns Color
        if resources is ModelResourcesVulkan
            ModelResourcesVulkan vulkanResources = cast(ModelResourcesVulkan, resources)
            return vulkanResources:GetColor(meshIndex)
        else
            if meshIndex = 0
                return diffuseColor
            else
                return undefined
            end
        end
    end

    /*
    This action will load a model from a given model file. The supported file
    extensions are .obj, .g3db, and .g3dj.

    Attribute: Parameter file The file containing the model data to be loaded.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.System.File
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model hat

        action Main
            StartGame()
        end

        action CreateGame
            File file
            file:SetPath("Sombrero.obj")
            hat:Load(file)
            Add(hat)
        end
    end

    */
    action Load(File file)
        SceneProperties properties
        modelType = properties:CUSTOM
        ModelBlueprint schematic = GetCachedBlueprint(file)
        Load(schematic)

        assetFile = file
    end

    /*
    This action will load the Model file with the given file name from the
    default file directory. The supported file extensions are .obj, .g3db, and
    .g3dj.

    Attribute: Parameter fileName The name of the file to be loaded.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.System.File
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model cup

        action Main
            StartGame()
        end

        action CreateGame
            cup:Load("brown-mug.obj")
            Add(cup)
        end
    end
    */
    action Load(text fileName)
        File file
        file:SetPath(fileName)
        Load(file)
    end
    
    private action GetCachedBlueprint(File file) returns ModelBlueprint
        if UsingOpenGL()
            return GetCachedBlueprintOpenGL(file)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetModelBlueprint(file)
        end
    end
    

    /*
    This action will search the cached blueprint hash table for a ModelBlueprint
    that was loaded from the given file. If the blueprint was not loaded before,
    it will be loaded and cached.
    */
    private system action GetCachedBlueprintOpenGL(File file) returns ModelBlueprintOpenGL
    
    private action GetCachedDimensions(ModelBlueprint schematic) returns Vector3
        if UsingOpenGL()
            return GetCachedDimensionsOpenGL(cast(ModelBlueprintOpenGL, schematic))
        else
            ModelBlueprintVulkan vulkanBlueprint = cast(ModelBlueprintVulkan, schematic)
            return vulkanBlueprint:GetDimensions()
        end
    end

    /*
    This action will return the base (that is, unscaled) dimensions of the axis
    aligned bounding box of the ModelBlueprint. This will return a cached value
    if there is one, or compute the dimensions then cache the result.
    */
    private system action GetCachedDimensionsOpenGL(ModelBlueprintOpenGL schematic) returns Vector3
    
    /*
    This action will load the Model with a box with the given width, height,
    depth, and color.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter color What color the box should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            cube:LoadBox(2, 2, 2, cyan)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Color color)
        ModelBlueprint schematic = GetCachedBox(width, height, depth, color)
        Load(schematic)
        SetDiffuseColor(color)
        Box box
        box:Set(width, height, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:BOX
        diffuseColor = color
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture located in the provided file.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter textureFile A file containing a texture to show on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.System.File

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            File texture
            texture:SetPath("Crate.png")

            cube:LoadBox(2, 2, 2, texture)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, File textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadBox(width, height, depth, texture)
        assetFile = textureFile
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture located at the provided file path.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter textureFile The name of a texture file to be displayed on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            cube:LoadBox(2, 2, 2, "Box.png")
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, text textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadBox(width, height, depth, texture)
    end

    /*
    This action will load the Model with a box with the given width, height,
    and depth. The box will use the texture that has been loaded by the given
    Drawable.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Drawable

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Drawable logo
            logo:Load("Logo.png")

            cube:LoadBox(2, 2, 2, logo)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Drawable drawable)
        Texture texture = drawable:GetTexture()
        LoadBox(width, height, depth, texture)
    end

    /*
    This action will load the Model with a box with the given width, height,
    depth, and texture.

    Attribute: Parameter width How long the box should be along the x-axis.
    Attribute: Parameter height How long the box should be along the y-axis.
    Attribute: Parameter depth How long the box should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on each side of the box.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model cube

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            cube:LoadBox(2, 2, 2, texture)
            Add(cube)
        end
    end

    */
    action LoadBox(number width, number height, number depth, Texture texture)
        ModelBlueprint schematic = GetCachedBox(width, height, depth, texture)
        Load(schematic)
        SetTexture(texture)
        Box box
        box:Set(width, height, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:BOX

        if texture:GetSource() not= undefined
            File file
            file:SetPath(texture:GetSource())
            assetFile = file
        end
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and color.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter color What color the plane should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            plane:LoadPlane(2, 2, cyan)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Color color)
        ModelBlueprint schematic = GetCachedPlane(width, depth, color, false)
        Load(schematic)
        SetDiffuseColor(color)
        
        Box box
        // Using a box with a thin height isn't correct -- it's only a rough
        // approximation, as we currently lack a "plane" shape.
        box:Set(width, 0.01, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:PLANE
        diffuseColor = color
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located in the provided file.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile A file containing a texture to show on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.System.File

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            File texture
            texture:SetPath("Floor.png")

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, File textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture)

        assetFile = textureFile
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located at the provided file path.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile The name of a texture file to be displayed on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            plane:LoadPlane(2, 2, "Box.png")
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, text textureFile)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture)
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture that has been loaded by the given
    Drawable.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Drawable

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Drawable logo
            logo:Load("Logo.png")

            plane:LoadPlane(2, 2, logo)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Drawable drawable)
        Texture texture = drawable:GetTexture()
        Vector4 coordinates
        coordinates:Set(drawable:GetLeftSide(), drawable:GetBottomSide(), drawable:GetRightSide(), drawable:GetTopSide())
        LoadPlane(width, depth, texture, coordinates)
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and texture.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture)
        LoadPlane(width, depth, texture, undefined)
    end
    
    /*
    This action will load the Model with a plane with the given width,
    depth, and texture. The texture will be sampled according to the texture
    coordinates provided, with the first two values providing the x and y
    coordinates of the first point on the texture, and the second values
    indicating the x y coordinates of the second point.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            plane:LoadPlane(2, 2, texture)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture, Vector4 textureCoordinates)
        LoadPlane(width, depth, texture, textureCoordinates, false)
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and color. If the boolean value provided is true, it will be double
    sided (allowing it to be viewed from both sides of the plane) -- otherwise,
    it will only visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter color What color the plane should be.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Color cyan
            cyan:SetColor(0, 0.75, 1, 1)

            plane:LoadPlane(2, 2, cyan, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Color color, boolean doubleSided)
        ModelBlueprint schematic = GetCachedPlane(width, depth, color, doubleSided)
        Load(schematic)
        SetDiffuseColor(color)
        Box box
        // Using a box with a thin height isn't correct -- it's only a rough
        // approximation, as we currently lack a "plane" shape.
        box:Set(width, 0.01, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:PLANE
        diffuseColor = color
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located in the provided file.
    If the boolean value provided is true, it will be double sided (allowing it 
    to be viewed from both sides of the plane) -- otherwise, it will only 
    visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile A file containing a texture to show on the surface of the plane.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.System.File

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            File texture
            texture:SetPath("Floor.png")

            plane:LoadPlane(2, 2, texture, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, File textureFile, boolean doubleSided)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture, doubleSided)

        assetFile = textureFile
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture located at the provided file path.
    If the boolean value provided is true, it will be double sided (allowing it 
    to be viewed from both sides of the plane) -- otherwise, it will only 
    visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter textureFile The name of a texture file to be displayed on the surface of the plane.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            plane:LoadPlane(2, 2, "Box.png", true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, text textureFile, boolean doubleSided)
        Texture texture
        texture:LoadFromFile(textureFile)
        LoadPlane(width, depth, texture, doubleSided)
    end

    /*
    This action will load the Model with a plane with the given width
    and depth. The plane will use the texture that has been loaded by the given
    Drawable. If the boolean value provided is true, it will be double sided 
    (allowing it to be viewed from both sides of the plane) -- otherwise, it 
    will only visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Drawable

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Drawable logo
            logo:Load("Logo.png")

            plane:LoadPlane(2, 2, logo, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Drawable drawable, boolean doubleSided)
        Texture texture = drawable:GetTexture()
        Vector4 coordinates
        coordinates:Set(drawable:GetLeftSide(), drawable:GetBottomSide(), drawable:GetRightSide(), drawable:GetTopSide())
        LoadPlane(width, depth, texture, coordinates, doubleSided)
    end

    /*
    This action will load the Model with a plane with the given width,
    depth, and texture.
    If the boolean value provided is true, it will be double sided (allowing it 
    to be viewed from both sides of the plane) -- otherwise, it will only 
    visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter drawable A loaded Drawable containing an image to be used on the surface of the plane.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            plane:LoadPlane(2, 2, texture, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture, boolean doubleSided)
        LoadPlane(width, depth, texture, undefined, doubleSided)
    end
    
    /*
    This action will load the Model with a plane with the given width,
    depth, and texture. The texture will be sampled according to the texture
    coordinates provided, with the first two values providing the x and y
    coordinates of the first point on the texture, and the second values
    indicating the x y coordinates of the second point.
    If the boolean value provided is true, it will be double sided (allowing it 
    to be viewed from both sides of the plane) -- otherwise, it will only 
    visible along the top of the plane.

    Attribute: Parameter width How long the plane should be along the x-axis.
    Attribute: Parameter depth How long the plane should be along the z-axis.
    Attribute: Parameter texture A texture to be used on the surface of the plane.
    Attribute: Parameter textureCoordinates Coordinates to sample on the texture, with the format X1, Y1, X2, Y2.
    Attribute: Parameter doubleSided True to make the plane double-sided, false otherwise.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Texture
    use Libraries.Game.Graphics.Vector4

    class Main is Game

        Model plane

        action Main
            StartGame()
        end

        action CreateGame
            Texture texture
            texture:LoadFilledCircle(150)

            Vector4 textureCoordinates
            textureCoordinates:Set(0, 0, 0.5, 0.5)

            plane:LoadPlane(2, 2, texture, textureCoordinates, true)
            Add(plane)
        end
    end

    */
    action LoadPlane(number width, number depth, Texture texture, Vector4 textureCoordinates, boolean doubleSided)
        ModelBlueprint schematic = GetCachedPlane(width, depth, texture, textureCoordinates, doubleSided)
        Load(schematic)
        SetTexture(texture)
        Box box
        // Using a box with a thin height isn't correct -- it's only a rough
        // approximation, as we currently lack a "plane" shape.
        box:Set(width, 0.01, depth)
        SetShape(box)

        SceneProperties properties
        modelType = properties:PLANE

        if texture:GetSource() not= undefined
            File file
            file:SetPath(texture:GetSource())
            assetFile = file
        end
    end

    /*
    This action will load the Model with a cylinder with the given width,
    height, depth, and color. The default cylinder will be made using 16
    straight sides to simulate the curve of the cylinder.

    Attribute: Parameter width How long the cylinder should be along the x-axis.
    Attribute: Parameter height How long the cylinder should be along the y-axis.
    Attribute: Parameter depth How long the cylinder should be along the z-axis.
    Attribute: Parameter color What color the cylinder should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model tube

        action Main
            StartGame()
        end

        action CreateGame
            Color orange
            orange:SetColor(1, 0.5, 0, 1)

            tube:LoadCylinder(2, 2, 2, orange)
            Add(tube)
        end
    end

    */
    action LoadCylinder(number width, number height, number depth, Color color)
        LoadCylinder(width, height, depth, 16, color)
    end

    /*
    This action will load the Model with a cylinder with the given dimensions
    and color. The provided number of divisions will be used to simulate the
    curve of the cylinder - the more divisions used, the smoother the curve will
    appear.

    Attribute: Parameter width How long the cylinder should be along the x-axis.
    Attribute: Parameter height How long the cylinder should be along the y-axis.
    Attribute: Parameter depth How long the cylinder should be along the z-axis.
    Attribute: Parameter divisions How many straight edges to use to simulate the curve of the cylinder.
    Attribute: Parameter color What color the cylinder should be.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        Model tube

        action Main
            StartGame()
        end

        action CreateGame
            Color orange
            orange:SetColor(1, 0.5, 0, 1)

            tube:LoadCylinder(2, 2, 2, 8, orange)
            Add(tube)
        end
    end

    */
    action LoadCylinder(number width, number height, number depth, integer divisions, Color color)
        ModelBlueprint schematic = GetCachedCylinder(width, height, depth, divisions, color)
        Load(schematic)
        SetDiffuseColor(color)
        Cylinder cylinder
        cylinder:Set(width, height, depth)
        SetShape(cylinder)

        SceneProperties properties
        modelType = properties:CYLINDER
        diffuseColor = color
    end

