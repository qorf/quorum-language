        if UsingOpenGL()
            return GetCachedPlaneOpenGL(width, depth, color, doubleSided)
        else
            ModelManagerVulkan modelManager = GetModelManager()
            return modelManager:GetPlaneBlueprint(width, depth, doubleSided)
