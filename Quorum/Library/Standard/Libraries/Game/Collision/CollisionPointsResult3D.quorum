package Libraries.Game.Collision

use Libraries.Game.Collision.LocalCollisionPoints3D
use Libraries.Compute.Vector3
use Libraries.Interface.Item3D
use Libraries.Compute.Matrix3
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Compute.Math
use Libraries.Containers.Array
use Libraries.Containers.Number32BitArray

/*
This class stores the collision points between the two objects colliding in addition to
providing functions that calculates the friction and restitution between these two objects.
*/
class CollisionPointsResult3D 
    LocalCollisionPoints3D collisionPoints

    PhysicsPosition3D rootTransformA
    PhysicsPosition3D rootTransformB
    Item3D body0
    Item3D body1
    integer partID0 = 0
    integer partID1 = 0
    integer index0 = 0
    integer index1 = 0
    
    //These values are for terrain. The face normal in this context lets us tell terrain that you can never be below it.
    Vector3 faceNormal
    Vector3 adjustedNormal
    boolean hasFaceNormal = false
    
    // Reused for every contact point. LocalCollisionPoints3D copies the
    // values into its own storage, so no reference to these is kept.
    CollisionPoint3D scratchPoint
    Vector3 scratchPointA
    Vector3 scratchLocalA
    Vector3 scratchLocalB

    // Gathering, for concave shapes such as terrain. While gathering, each
    // contact is buffered instead of stored, and FinishGathering stores at
    // most four of them. The buffers are only made the first time they are
    // needed, so collisions that never gather do not pay for them.
    constant integer MAXIMUM_GATHERED = 64
    boolean gathering = false
    integer gatheredCount = 0
    Array<Vector3> gatheredNormals = undefined
    Array<Vector3> gatheredPoints = undefined
    Number32BitArray gatheredDepths = undefined
    Vector3 gatherEdge
    Vector3 gatherAcross
    Math math

    /*
    This action adds the bodies that are colliding into this CollisionPointsResult3D class.
    Attribute: Parameter body0 The first body that is colliding.
    Attribute: Parameter body1 The second body that is colliding.
    */
    action Initialize(Item3D body0, Item3D body1)
        me:body0 = body0
        me:body1 = body1
        rootTransformA:Set(body0:GetCollisionTransform())
        rootTransformB:Set(body1:GetCollisionTransform())
    end
    
    /*
    This action tells this CollisionPointsResult3D that the contacts it is about to
    receive come from a one sided surface with a known normal, so that a contact
    reported on an internal edge, or from underneath the surface, can be corrected.
    Concave shapes set this before each of their pieces collides.
    */
    action SetFaceNormal(Vector3 normal)
        faceNormal:Set(normal)
        hasFaceNormal = true
    end

    /*
    This action stops correcting contacts against a surface normal. It must be called
    once a concave shape is done, because this class is shared with the ordinary
    convex collision path, which has no surface normal to correct against.
    */
    action ClearFaceNormal
        hasFaceNormal = false
    end

    /*
    This action returns a bundle of collision points to this CollisionPointsResult3D 
    using the collision points bundled inside LocalCollisionPoints3D.
    Attribute: Returns the collision points.
    */
    action GetCollisionPoints returns LocalCollisionPoints3D
        return collisionPoints
    end

    /*
    This action allows you to add a bundle of collision points to this CollisionPointsResult3D 
    using the collision points bundled inside LocalCollisionPoints3D.
    Attribute: Paramter collisionPoints The collision points.
    */
    action SetCollisionPoints(LocalCollisionPoints3D collisionPoints)
        me:collisionPoints = collisionPoints
    end

    /*
    This action allows you to set if objects A and B are a convex part of a larger object or is in a triangular mesh.
    Attribute: Parameter partID0 The part ID of object A.
    Attribute: Parameter index0 The index of object A.
    Attribute: Parameter partID1 The part ID of object B.
    Attribute: Parameter index1 The index of object B.
    */
    action SetShapeIdentifiers(integer partID0, integer index0, integer partID1, integer index1)
        me:partID0 = partID0
        me:index0 = index0
        me:partID1 = partID1
        me:index1 = index1
    end

    /*
    This action adds a collision point to this CollisionPointsResult3D class.
    Attribute: Paramter normalOnBInWorld The vector from the collision point on B to the collision point on A.
    Attribute: Parameter pointInWorld The collision point on B in world coordinates.
    Attribute: Parameter depth The shortest distance from the collision point on B to the collision point on A.
    */
    action AddCollisionPoint(Vector3 normalOnBInWorld, Vector3 pointInWorld, number depth)
        adjustedNormal:Set(normalOnBInWorld)
        boolean isSwapped = collisionPoints:GetBody0() not= body0

        if hasFaceNormal
            number alignment = adjustedNormal:DotProduct(faceNormal)

            boolean inverted = alignment > 0
            if isSwapped
                inverted = alignment < 0
            end

            if inverted
                adjustedNormal:Scale(-1)
            end

            //adjustedNormal:Set(faceNormal)
        end
        
        if depth > collisionPoints:GetCollisionBreakingThreshold()
            return now
        end

        // While gathering, keep the point for FinishGathering. The face
        // normal has already been applied above, because it belongs to the
        // triangle this point came from. If the buffer is full, the point
        // is stored right away instead.
        if gathering and gatheredCount < MAXIMUM_GATHERED
            gatheredNormals:Get(gatheredCount):Set(adjustedNormal)
            gatheredPoints:Get(gatheredCount):Set(pointInWorld)
            gatheredDepths:Set(gatheredCount, depth)
            gatheredCount = gatheredCount + 1
            return now
        end

        StoreCollisionPoint(adjustedNormal, pointInWorld, depth)
    end

    /*
    This action stores one collision point in the collision's points, either
    replacing a stored point it matches or adding it as a new one.
    */
    private action StoreCollisionPoint(Vector3 normal, Vector3 pointInWorld, number depth)
        boolean isSwapped = collisionPoints:GetBody0() not= body0

        Vector3 pointA = scratchPointA
        pointA:Set(normal)
        pointA:Scale(depth)
        pointA:Add(pointInWorld)
        Vector3 localA = scratchLocalA
        Vector3 localB = scratchLocalB

        if isSwapped
            rootTransformB:InverseTransform(pointA, localA)
            rootTransformA:InverseTransform(pointInWorld, localB)
        else
            rootTransformA:InverseTransform(pointA, localA)
            rootTransformB:InverseTransform(pointInWorld, localB)
        end
        
        CollisionPoint3D newPoint = scratchPoint
        newPoint:Initialize(localA, localB, normal, depth)

        newPoint:GetWorldPositionOnA():Set(pointA)
        newPoint:GetWorldPositionOnB():Set(pointInWorld)

        integer insertIndex = collisionPoints:GetCacheEntry(newPoint)

        newPoint:combinedFriction = CalculateCombinedFriction(body0, body1)
        newPoint:combinedRestitution = CalculateCombinedRestitution(body0, body1)

        newPoint:partID0 = partID0
        newPoint:partID1 = partID1
        newPoint:index0 = index0
        newPoint:index1 = index1

        if insertIndex >= 0
            collisionPoints:ReplaceCollisionPoint(newPoint, insertIndex)
        else
            insertIndex = collisionPoints:AddCollisionPoint(newPoint)
        end
    end

    /*
    This action starts gathering. Until FinishGathering is called, points
    passed to AddCollisionPoint are buffered instead of stored. Concave
    shapes, such as terrain, use this so that the contacts from all of
    their triangles are considered together, and only the best four are
    stored, instead of each triangle's contacts being stored one at a time.
    */
    action BeginGathering
        if gatheredPoints = undefined
            Array<Vector3> normals
            Array<Vector3> positions
            integer i = 0
            repeat while i < MAXIMUM_GATHERED
                Vector3 normal
                Vector3 position
                normals:Add(normal)
                positions:Add(position)
                i = i + 1
            end
            gatheredNormals = normals
            gatheredPoints = positions
            Number32BitArray depths
            depths:SetSize(MAXIMUM_GATHERED)
            gatheredDepths = depths
        end
        gatheredCount = 0
        gathering = true
    end

    /*
    This action stops gathering and stores at most four of the gathered
    points. If there are four or fewer, all of them are stored. Otherwise
    the four are chosen to keep the deepest point and to spread out as
    widely as possible: the deepest point, then the point farthest from it,
    then the point that makes the largest triangle with those two, and
    finally the point that reaches farthest outside that triangle. The points
    can come from many triangles in any order, so this does not depend on
    their order.
    */
    action FinishGathering
        gathering = false
        integer count = gatheredCount
        gatheredCount = 0

        if count <= 4
            integer index = 0
            repeat while index < count
                StoreGathered(index)
                index = index + 1
            end
            return now
        end

        // The deepest point.
        integer first = 0
        integer i = 1
        repeat while i < count
            if gatheredDepths:Get(i) < gatheredDepths:Get(first)
                first = i
            end
            i = i + 1
        end

        // The point farthest from the deepest.
        integer second = -1
        number best = 0
        i = 0
        repeat while i < count
            number distance = gatheredPoints:Get(i):DistanceSquared(gatheredPoints:Get(first))
            if i not= first and distance > best
                best = distance
                second = i
            end
            i = i + 1
        end

        // The point making the largest triangle with the first two.
        integer third = -1
        if second >= 0
            best = 0
            i = 0
            repeat while i < count
                if i not= first and i not= second
                    number area = GatheredArea(i, first, second)
                    if area > best
                        best = area
                        third = i
                    end
                end
                i = i + 1
            end
        end

        // The point reaching farthest outside that triangle, measured by the
        // largest triangle it makes with any of the triangle's sides.
        integer fourth = -1
        if third >= 0
            best = 0
            i = 0
            repeat while i < count
                if i not= first and i not= second and i not= third
                    number reach = math:MaximumOf(GatheredArea(i, first, second),
                        math:MaximumOf(GatheredArea(i, second, third), GatheredArea(i, third, first)))
                    if reach > best
                        best = reach
                        fourth = i
                    end
                end
                i = i + 1
            end
        end

        StoreGathered(first)
        if second >= 0
            StoreGathered(second)
        end
        if third >= 0
            StoreGathered(third)
        end
        if fourth >= 0
            StoreGathered(fourth)
        end
    end

    /*
    This action stores the gathered point at the given index.
    */
    private action StoreGathered(integer index)
        StoreCollisionPoint(gatheredNormals:Get(index), gatheredPoints:Get(index), gatheredDepths:Get(index))
    end

    /*
    This action returns a value that grows with the area of the triangle made
    by three gathered points: the squared length of (point - a) crossed with
    (b - a).
    */
    private action GatheredArea(integer point, integer a, integer b) returns number
        gatherEdge:Set(gatheredPoints:Get(point)):Subtract(gatheredPoints:Get(a))
        gatherAcross:Set(gatheredPoints:Get(b)):Subtract(gatheredPoints:Get(a))
        gatherEdge:CrossProduct(gatherAcross)
        return gatherEdge:LengthSquared()
    end

    /*
    This action calculates the friction between the two objects.
    Attribute: Paramter body0 The first Item3D that is involved in the collision.
    Attribute: Paramter body1 The second Item3D that is involved in the collision.
    Attribute: Returns the friction between the two objects.
    */
    action CalculateCombinedFriction(Item3D body0, Item3D body1) returns number
        if not body0:IsPhysicsEnabled() or not body1:IsPhysicsEnabled()
            return 0
        end

        number friction = body0:GetFriction() * body1:GetFriction()

        number maxFriction = 10
        if friction < -maxFriction
            friction = -maxFriction
        end
        if friction > maxFriction
            friction = maxFriction
        end

        return friction
    end

    /*
    This action calculates the restitution between the two objects.
    Attribute: Paramter body0 The first Item3D that is involved in the collision.
    Attribute: Paramter body1 The second Item3D that is involved in the collision.
    Attribute: Returns the restitution between the two objects.
    */
    action CalculateCombinedRestitution(Item3D body0, Item3D body1) returns number
        if not body0:IsPhysicsEnabled() or not body1:IsPhysicsEnabled()
            return 0
        end

        number max = body0:GetRestitution()
        if max < body1:GetRestitution()
           max = body1:GetRestitution()
        end
        return max
    end

    /*
    This action changes the collision points between the two objects to new points calculated.
    */
    action RefreshCollisionPoints
        if collisionPoints:GetPointCount() = 0
            return now
        end

        boolean isSwapped = collisionPoints:GetBody0() not= body0

        if isSwapped
            collisionPoints:RefreshCollisionPoints(rootTransformB, rootTransformA)
        else
            collisionPoints:RefreshCollisionPoints(rootTransformA, rootTransformB)
        end
    end
end