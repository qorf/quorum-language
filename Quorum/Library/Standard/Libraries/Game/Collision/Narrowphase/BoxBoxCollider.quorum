package Libraries.Game.Collision.Narrowphase
use Libraries.Game.Collision.LocalCollisionPoints3D
use Libraries.Compute.Matrix3
use Libraries.Containers.Array
use Libraries.Compute.Vector3
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.Collision.CollisionPointsResult3D
use Libraries.Game.Collision.Shapes.Box
use Libraries.Compute.Math
use Libraries.Containers.Integer32BitArray
use Libraries.Containers.Number32BitArray

class BoxBoxCollider
    public constant number EPSILON = 0.00000011920928955078125
    Math math
    
    action CollideBoxes(LocalCollisionPoints3D collisionPoints,
Box boxA,PhysicsPosition3D transformA,
Box boxB,PhysicsPosition3D transformB,
CollisionPointsResult3D result)
    result:SetCollisionPoints(collisionPoints)

    Matrix3 basisA = transformA:GetBasis()
    Matrix3 basisB = transformB:GetBasis()

    Array<Vector3> axesA
    Array<Vector3> axesB

    Vector3 axisA0
    axisA0:Set(basisA:row0column0, basisA:row1column0, basisA:row2column0)
    axesA:Add(axisA0)

    Vector3 axisA1
    axisA1:Set(basisA:row0column1, basisA:row1column1, basisA:row2column1)
    axesA:Add(axisA1)

    Vector3 axisA2
    axisA2:Set(basisA:row0column2, basisA:row1column2, basisA:row2column2)
    axesA:Add(axisA2)

    Vector3 axisB0
    axisB0:Set(basisB:row0column0, basisB:row1column0, basisB:row2column0)
    axesB:Add(axisB0)

    Vector3 axisB1
    axisB1:Set(basisB:row0column1, basisB:row1column1, basisB:row2column1)
    axesB:Add(axisB1)

    Vector3 axisB2
    axisB2:Set(basisB:row0column2, basisB:row1column2, basisB:row2column2)
    axesB:Add(axisB2)

    Vector3 halfA = boxA:GetHalfExtentsWithMargin()
    Vector3 halfB = boxB:GetHalfExtentsWithMargin()

    Vector3 centerDelta
    centerDelta:Set(transformA:GetOrigin())
    centerDelta:Subtract(transformB:GetOrigin())

    number minimumOverlap = 1.0e100
    number bestAxisScore = 1.0e100
    integer winningAxis = -1

    Vector3 normalBtoA
    normalBtoA:Set(1, 0, 0)

    number rotationFudge = 0.00001
    number crossAxisBias = 1.05

    integer i = 0
    repeat while i < 15
        Vector3 axis
        integer edgeA = -1
        integer edgeB = -1

        if i < 6
            integer selectedAxisIndex = 0

            if i mod 2 = 0
                selectedAxisIndex = i / 2
                axis:Set(axesA:Get(selectedAxisIndex))
            else
                selectedAxisIndex = (i - 1) / 2
                axis:Set(axesB:Get(selectedAxisIndex))
            end
        else
            integer edgePair = i - 6
            edgeA = edgePair / 3
            edgeB = edgePair mod 3

            // CrossProduct(Vector3) mutates its receiver. Cross a copy so
            // axesA remains valid for all SAT tests and contact generation.
            Vector3 crossAxis
            crossAxis:Set(axesA:Get(edgeA))
            axis:Set(crossAxis:CrossProduct(axesB:Get(edgeB)))
        end

        number axisLength = axis:Length()

        // Skip degenerate cross products from parallel or nearly parallel edges.
        if axisLength > EPSILON
            axis:Scale(1 / axisLength)

            number radiusA =
                math:AbsoluteValue(axis:DotProduct(axesA:Get(0))) * halfA:GetX() +
                math:AbsoluteValue(axis:DotProduct(axesA:Get(1))) * halfA:GetY() +
                math:AbsoluteValue(axis:DotProduct(axesA:Get(2))) * halfA:GetZ()

            number radiusB =
                math:AbsoluteValue(axis:DotProduct(axesB:Get(0))) * halfB:GetX() +
                math:AbsoluteValue(axis:DotProduct(axesB:Get(1))) * halfB:GetY() +
                math:AbsoluteValue(axis:DotProduct(axesB:Get(2))) * halfB:GetZ()

            number signedDistance = centerDelta:DotProduct(axis)
            number rawOverlap =
                radiusA + radiusB - math:AbsoluteValue(signedDistance)

            number testedOverlap = rawOverlap
            number candidateScore = rawOverlap

            if i >= 6
                // Bullet adds rotationFudge to the four relative-rotation
                // terms that contribute to this edge-cross-edge projection.
                // In normalized world-axis space this is the corresponding
                // extent padding divided by the original cross-axis length.
                number paddingA = 0
                number paddingB = 0

                integer extentIndex = 0
                repeat while extentIndex < 3
                    if extentIndex not= edgeA
                        paddingA = paddingA + GetBoxExtent(halfA, extentIndex)
                    end
                    if extentIndex not= edgeB
                        paddingB = paddingB + GetBoxExtent(halfB, extentIndex)
                    end
                    extentIndex = extentIndex + 1
                end

                number crossAxisPadding =
                    rotationFudge * (paddingA + paddingB) / axisLength

                testedOverlap = rawOverlap + crossAxisPadding

                // Bullet gives cross axes a 1.05 selection bias so a face
                // axis wins close ties. The bias affects selection only;
                // minimumOverlap retains the unweighted contact depth.
                candidateScore = testedOverlap * crossAxisBias

                // Bullet's cross-axis separation check allows SIMD_EPSILON
                // before declaring a separating axis. Convert that tolerance
                // to the normalized-axis units used here.
                if testedOverlap < -(EPSILON / axisLength)
                    result:RefreshCollisionPoints()
                    return now
                end
            else
                if testedOverlap < 0
                    result:RefreshCollisionPoints()
                    return now
                end
            end

            if candidateScore < bestAxisScore
                bestAxisScore = candidateScore
                minimumOverlap = testedOverlap
                winningAxis = i
                normalBtoA:Set(axis)

                // The result normal points from B toward A.
                if signedDistance < 0
                    normalBtoA:Scale(-1)
                end
            end
        end

        i = i + 1
    end

    if winningAxis < 0
        result:RefreshCollisionPoints()
        return now
    end

    if winningAxis < 6
        boolean referenceIsA = winningAxis mod 2 = 0
        integer referenceAxisIndex = winningAxis / 2

        CollideBoxFaces(
            transformA, transformB,
            axesA, axesB,
            halfA, halfB,
            referenceIsA, referenceAxisIndex,
            normalBtoA, result)
    else
        integer edgePair = winningAxis - 6
        integer selectedEdgeA = edgePair / 3
        integer selectedEdgeB = edgePair mod 3

        CollideBoxEdges(
            transformA, transformB,
            axesA, axesB,
            halfA, halfB,
            selectedEdgeA, selectedEdgeB,
            normalBtoA, minimumOverlap, result)
    end

    result:RefreshCollisionPoints()
end
    
    
    
    /*
Return one box face's four corners. faceDirection points outward from the face.
*/
private action MakeBoxFace(Vector3 boxCenter,
Array<Vector3> axes,
Vector3 half,
Vector3 faceDirection) returns Array<Vector3>

    integer normalIndex = 0
    number bestAlignment =
        math:AbsoluteValue(faceDirection:DotProduct(axes:Get(0)))

    integer i = 1
    repeat while i < 3
        number alignment =
            math:AbsoluteValue(faceDirection:DotProduct(axes:Get(i)))
        if alignment > bestAlignment
            bestAlignment = alignment
            normalIndex = i
        end
        i = i + 1
    end

    integer side1 = 0
    integer side2 = 0
    if normalIndex = 0
        side1 = 1
        side2 = 2
    else
        if normalIndex = 1
            side1 = 0
            side2 = 2
        else
            side1 = 0
            side2 = 1
        end
    end

    number normalExtent = GetBoxExtent(half, normalIndex)
    number extent1 = GetBoxExtent(half, side1)
    number extent2 = GetBoxExtent(half, side2)

    Vector3 faceCenter
    faceCenter:Set(axes:Get(normalIndex))
    if faceDirection:DotProduct(faceCenter) < 0
        faceCenter:Scale(-normalExtent)
    else
        faceCenter:Scale(normalExtent)
    end
    faceCenter:Add(boxCenter)

    
        Array<Vector3> face

    Vector3 point0
    point0:Set(faceCenter)
    point0:MultiplyAndAdd(axes:Get(side1), -extent1)
    point0:MultiplyAndAdd(axes:Get(side2), -extent2)
    face:Add(point0)

    Vector3 point1
    point1:Set(faceCenter)
    point1:MultiplyAndAdd(axes:Get(side1), -extent1)
    point1:MultiplyAndAdd(axes:Get(side2), extent2)
    face:Add(point1)

    Vector3 point2
    point2:Set(faceCenter)
    point2:MultiplyAndAdd(axes:Get(side1), extent1)
    point2:MultiplyAndAdd(axes:Get(side2), extent2)
    face:Add(point2)

    Vector3 point3
    point3:Set(faceCenter)
    point3:MultiplyAndAdd(axes:Get(side1), extent1)
    point3:MultiplyAndAdd(axes:Get(side2), -extent2)
    face:Add(point3)

    return face
end
    
    
    /*
Clip a polygon to sign * dot(point - planeCenter, planeAxis) <= extent.
*/
private action ClipBoxPolygon(Array<Vector3> polygon,
Vector3 planeCenter,
Vector3 planeAxis,
number extent,
number sign) returns Array<Vector3>

    Array<Vector3> clipped
    integer count = polygon:GetSize()

    if count = 0
        return clipped
    end

    integer i = 0
    repeat while i < count
        Vector3 current
        current:Set(polygon:Get(i))

        Vector3 next
        next:Set(polygon:Get((i + 1) mod count))

        Vector3 currentDelta
        currentDelta:Set(current)
        currentDelta:Subtract(planeCenter)
        number currentDistance =
            sign * currentDelta:DotProduct(planeAxis) - extent

        Vector3 nextDelta
        nextDelta:Set(next)
        nextDelta:Subtract(planeCenter)
        number nextDistance =
            sign * nextDelta:DotProduct(planeAxis) - extent

        boolean currentInside = currentDistance <= 0
        boolean nextInside = nextDistance <= 0

        if currentInside
            Vector3 copy
            copy:Set(current)
            clipped:Add(copy)
        end

        if currentInside not= nextInside
            number fraction = currentDistance / (currentDistance - nextDistance)

            Vector3 intersection
            intersection:Set(current)

            Vector3 segment
            segment:Set(next)
            segment:Subtract(current)

            intersection:MultiplyAndAdd(segment, fraction)
            clipped:Add(intersection)
        end

        i = i + 1
    end

    return clipped
end
    
    
    private action CollideBoxFaces(PhysicsPosition3D transformA,
PhysicsPosition3D transformB,
Array<Vector3> axesA,
Array<Vector3> axesB,
Vector3 halfA,Vector3 halfB,
boolean referenceIsA,
integer referenceAxisIndex,
Vector3 normalBtoA,
CollisionPointsResult3D result)
    Vector3 referenceCenter
    Vector3 incidentCenter
    Vector3 referenceHalf
    Vector3 incidentHalf
    Vector3 referenceOutward
    Vector3 incidentOutward

    if referenceIsA
        referenceCenter:Set(transformA:GetOrigin())
        incidentCenter:Set(transformB:GetOrigin())
        referenceHalf:Set(halfA)
        incidentHalf:Set(halfB)
        referenceOutward:Set(normalBtoA)
        referenceOutward:Scale(-1)
        incidentOutward:Set(normalBtoA)
    else
        referenceCenter:Set(transformB:GetOrigin())
        incidentCenter:Set(transformA:GetOrigin())
        referenceHalf:Set(halfB)
        incidentHalf:Set(halfA)
        referenceOutward:Set(normalBtoA)
        incidentOutward:Set(normalBtoA)
        incidentOutward:Scale(-1)
    end

    Array<Vector3> referenceAxes
    Array<Vector3> incidentAxes
    if referenceIsA
        referenceAxes = axesA
        incidentAxes = axesB
    else
        referenceAxes = axesB
        incidentAxes = axesA
    end

    number referenceExtent = GetBoxExtent(referenceHalf, referenceAxisIndex)

    Vector3 referenceFaceCenter
    referenceFaceCenter:Set(referenceAxes:Get(referenceAxisIndex))
    if referenceOutward:DotProduct(referenceFaceCenter) < 0
        referenceFaceCenter:Scale(-referenceExtent)
    else
        referenceFaceCenter:Scale(referenceExtent)
    end
    referenceFaceCenter:Add(referenceCenter)

    Array<Vector3> polygon = MakeBoxFace(incidentCenter, incidentAxes, incidentHalf, incidentOutward)

    integer side1 = 0
    integer side2 = 0
    if referenceAxisIndex = 0
        side1 = 1
        side2 = 2
    else
        if referenceAxisIndex = 1
            side1 = 0
            side2 = 2
        else
            side1 = 0
            side2 = 1
        end
    end

    number extent1 = GetBoxExtent(referenceHalf, side1)
    number extent2 = GetBoxExtent(referenceHalf, side2)

    polygon = ClipBoxPolygon(polygon, referenceFaceCenter,
                             referenceAxes:Get(side1), extent1, 1)
    polygon = ClipBoxPolygon(polygon, referenceFaceCenter,
                             referenceAxes:Get(side1), extent1, -1)
    polygon = ClipBoxPolygon(polygon, referenceFaceCenter,
                             referenceAxes:Get(side2), extent2, 1)
    polygon = ClipBoxPolygon(polygon, referenceFaceCenter,
                             referenceAxes:Get(side2), extent2, -1)

    // Keep penetrating points and their depths.
    Array<Vector3> pointsOnB
    Number32BitArray depths
        depths:SetSize(polygon:GetSize())
        integer numDepths = 0

    integer i = 0
    repeat while i < polygon:GetSize()
        Vector3 incidentPoint
        incidentPoint:Set(polygon:Get(i))

        Vector3 pointOnB
        number depth = 0

        if referenceIsA
            pointOnB:Set(incidentPoint)

            Vector3 referenceToIncident
            referenceToIncident:Set(referenceFaceCenter)
            referenceToIncident:Subtract(incidentPoint)

            depth = referenceToIncident:DotProduct(normalBtoA)
        else
            Vector3 incidentToReference
            incidentToReference:Set(incidentPoint)
            incidentToReference:Subtract(referenceFaceCenter)

            depth = incidentToReference:DotProduct(normalBtoA)

            pointOnB:Set(incidentPoint)
            pointOnB:MultiplyAndAdd(normalBtoA, -depth)
        end

        if depth <= 0
            pointsOnB:Add(pointOnB)
            depths:Set(numDepths, depth)
                numDepths = numDepths + 1
        end

        i = i + 1
    end

    integer count = pointsOnB:GetSize()
    if count = 0
        return now
    end

    // Contact reduction: deepest point first, then greedily choose points
    // farthest from the already selected contacts, up to four total.
        integer targetSelectedPoints = count
    if targetSelectedPoints > 4
        targetSelectedPoints = 4
    end
    Integer32BitArray selected
        selected:SetSize(targetSelectedPoints)
        integer numberSelectedPoints = 1
    Integer32BitArray used
        constant integer TRUE = 1
        constant integer FALSE = 0
        
        used:SetSize(count)
    i = 0
    repeat while i < count
        used:Set(i, FALSE)
        i = i + 1
    end

    integer deepest = 0
    i = 1
    repeat while i < count
        if depths:Get(i) < depths:Get(deepest)
            deepest = i
        end
        i = i + 1
    end

    selected:Set(0, deepest)
        //Set 1s and 0s for optimization,  with 1 = true and 0 = false
    used:Set(deepest, TRUE)

    repeat while numberSelectedPoints < targetSelectedPoints
        number bestDistance = -1
        integer bestIndex = -1

        i = 0
        repeat while i < count
            if not (used:Get(i) = TRUE)
                number nearestSelectedDistance = 1.0e100
                integer j = 0
                repeat while j < numberSelectedPoints
                    Vector3 delta
                    delta:Set(pointsOnB:Get(i))
                    delta:Subtract(pointsOnB:Get(selected:Get(j)))
                    number distance = delta:LengthSquared()
                    if distance < nearestSelectedDistance
                        nearestSelectedDistance = distance
                    end
                    j = j + 1
                end

                if nearestSelectedDistance > bestDistance
                    bestDistance = nearestSelectedDistance
                    bestIndex = i
                end
            end
            i = i + 1
        end

        if bestIndex >= 0
            selected:Set(numberSelectedPoints, bestIndex)
                numberSelectedPoints = numberSelectedPoints + 1
            used:Set(bestIndex, TRUE)
        else
            // Defensive exit if the array has no unused point.
            return now
        end
    end

    i = 0
    repeat while i < numberSelectedPoints
        integer index = selected:Get(i)
        result:AddCollisionPoint(
            normalBtoA, pointsOnB:Get(index), depths:Get(index))
        i = i + 1
    end
end
    
    private action GetBoxExtent(Vector3 half, integer index) returns number
    if index = 0
        return half:GetX()
    end
    if index = 1
        return half:GetY()
    end
    return half:GetZ()
end
    
    
    private action CollideBoxEdges(PhysicsPosition3D transformA,
PhysicsPosition3D transformB,
Array<Vector3> axesA,
Array<Vector3> axesB,
Vector3 halfA,Vector3 halfB,
integer edgeA, integer edgeB,
Vector3 normalBtoA,
number penetration,
CollisionPointsResult3D result)
    Vector3 pointA
    pointA:Set(transformA:GetOrigin())

    Vector3 pointB
    pointB:Set(transformB:GetOrigin())

    // Offset the edge centers along their two non-edge axes.
    integer i = 0
    repeat while i < 3
        if i not= edgeA
            number extentA = GetBoxExtent(halfA, i)
            number signA = 1
            if normalBtoA:DotProduct(axesA:Get(i)) > 0
                signA = -1
            end
            pointA:MultiplyAndAdd(axesA:Get(i), signA * extentA)
        end

        if i not= edgeB
            number extentB = GetBoxExtent(halfB, i)
            number signB = 1
            if normalBtoA:DotProduct(axesB:Get(i)) < 0
                signB = -1
            end
            pointB:MultiplyAndAdd(axesB:Get(i), signB * extentB)
        end

        i = i + 1
    end

    Vector3 directionA
    directionA:Set(axesA:Get(edgeA))

    Vector3 directionB
    directionB:Set(axesB:Get(edgeB))

    Vector3 between
    between:Set(pointB)
    between:Subtract(pointA)

    number dotAB = directionA:DotProduct(directionB)
    number q1 = directionA:DotProduct(between)
    number q2 = -directionB:DotProduct(between)
    number denominator = 1 - dotAB * dotAB

    number alpha = 0
    number beta = 0
    if denominator > 0.0001
        alpha = (q1 + dotAB * q2) / denominator
        beta = (dotAB * q1 + q2) / denominator
    end

    // Apply both line parameters; the contact point is on B's edge.
    pointA:MultiplyAndAdd(directionA, alpha)
    pointB:MultiplyAndAdd(directionB, beta)

    result:AddCollisionPoint(normalBtoA, pointB, -penetration)
end
end