package Libraries.Game.Collision.Narrowphase
use Libraries.Game.Collision.LocalCollisionPoints3D
use Libraries.Compute.Matrix3
use Libraries.Containers.Array
use Libraries.Compute.Vector3
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.Collision.CollisionPointsResult3D
use Libraries.Game.Collision.Shapes.Box
use Libraries.Compute.Math
use Libraries.Containers.Integer32BitArray
use Libraries.Containers.Number32BitArray

class BoxBoxCollider
    public constant number EPSILON = 0.00000011920928955078125
    Math math
    
    // Storage for face contacts. Every box-against-box pair goes through the
    // one BoxBoxCollider owned by SharedNarrowSolver, so these are created
    // once and reused. Clipping a four-sided face against four planes leaves
    // at most eight points.
    constant integer MAXIMUM_CLIP_POINTS = 8
    Array<Vector3> clipBufferA
    Array<Vector3> clipBufferB
    Array<Vector3> contactPoints
    Number32BitArray contactDepths
    Number32BitArray contactX
    Number32BitArray contactY
    Number32BitArray contactAngles
    Integer32BitArray selectedPoints
    Integer32BitArray availablePoints

    Vector3 faceCenter
    Vector3 referenceCenter
    Vector3 incidentCenter
    Vector3 referenceHalf
    Vector3 incidentHalf
    Vector3 referenceOutward
    Vector3 incidentOutward
    Vector3 referenceFaceCenter
    Vector3 separation
    Vector3 relativePoint
    
    
    // Storage for the separating-axis test and for edge contacts, reused for
    // every pair in the same way.
    Array<Vector3> axesOfA
    Array<Vector3> axesOfB
    Vector3 halfExtentsA
    Vector3 halfExtentsB
    Vector3 boxCenterDelta
    Vector3 bestNormal
    Vector3 testAxis
    Vector3 edgePointA
    Vector3 edgePointB
    Vector3 edgeBetween

    on create
        integer i = 0
        repeat while i < MAXIMUM_CLIP_POINTS
            Vector3 a
            Vector3 b
            Vector3 c
            clipBufferA:Add(a)
            clipBufferB:Add(b)
            contactPoints:Add(c)
            i = i + 1
        end
        contactDepths:SetSize(MAXIMUM_CLIP_POINTS)
        contactX:SetSize(MAXIMUM_CLIP_POINTS)
        contactY:SetSize(MAXIMUM_CLIP_POINTS)
        contactAngles:SetSize(MAXIMUM_CLIP_POINTS)
        selectedPoints:SetSize(MAXIMUM_CLIP_POINTS)
        availablePoints:SetSize(MAXIMUM_CLIP_POINTS)
        
        
        i = 0
        repeat while i < 3
            Vector3 axisOfA
            Vector3 axisOfB
            axesOfA:Add(axisOfA)
            axesOfB:Add(axisOfB)
            i = i + 1
        end
    end
    
    action CollideBoxes(LocalCollisionPoints3D collisionPoints,
Box boxA,PhysicsPosition3D transformA,
Box boxB,PhysicsPosition3D transformB,
CollisionPointsResult3D result)
    result:SetCollisionPoints(collisionPoints)

    Matrix3 basisA = transformA:GetBasis()
    Matrix3 basisB = transformB:GetBasis()
    
        Array<Vector3> axesA = axesOfA
    Array<Vector3> axesB = axesOfB

    axesA:Get(0):Set(basisA:row0column0, basisA:row1column0, basisA:row2column0)
    axesA:Get(1):Set(basisA:row0column1, basisA:row1column1, basisA:row2column1)
    axesA:Get(2):Set(basisA:row0column2, basisA:row1column2, basisA:row2column2)

    axesB:Get(0):Set(basisB:row0column0, basisB:row1column0, basisB:row2column0)
    axesB:Get(1):Set(basisB:row0column1, basisB:row1column1, basisB:row2column1)
    axesB:Get(2):Set(basisB:row0column2, basisB:row1column2, basisB:row2column2)

    // The same values as Box:GetHalfExtentsWithMargin, copied into vectors
    // owned here. That action builds a new margin vector on every call, and
    // returns the box's own internal vector rather than a copy.
    number marginA = boxA:GetMargin()
    number marginB = boxB:GetMargin()
    Vector3 halfA = halfExtentsA
    halfA:Set(boxA:GetHalfExtentsWithoutMargin()):Add(marginA, marginA, marginA)
    Vector3 halfB = halfExtentsB
    halfB:Set(boxB:GetHalfExtentsWithoutMargin()):Add(marginB, marginB, marginB)

    Vector3 centerDelta = boxCenterDelta
    centerDelta:Set(transformA:GetOrigin())
    centerDelta:Subtract(transformB:GetOrigin())

    number minimumOverlap = 1.0e100
    number bestAxisScore = 1.0e100
    integer winningAxis = -1

    Vector3 normalBtoA = bestNormal
    normalBtoA:Set(1, 0, 0)

    number rotationFudge = 0.00001
    number crossAxisBias = 1.05

    integer i = 0
    repeat while i < 15
            Vector3 axis = testAxis
        integer edgeA = -1
        integer edgeB = -1

        if i < 6
            integer selectedAxisIndex = 0

            if i mod 2 = 0
                selectedAxisIndex = i / 2
                axis:Set(axesA:Get(selectedAxisIndex))
            else
                selectedAxisIndex = (i - 1) / 2
                axis:Set(axesB:Get(selectedAxisIndex))
            end
        else
            integer edgePair = i - 6
            edgeA = edgePair / 3
            edgeB = edgePair mod 3

                // CrossProduct(Vector3) changes the vector it is called on. axis
                // holds a copy of A's edge axis first, so axesA is left unchanged
                // for the remaining tests and for contact generation.
                axis:Set(axesA:Get(edgeA)):CrossProduct(axesB:Get(edgeB))
        end

        number axisLength = axis:Length()

        // Skip degenerate cross products from parallel or nearly parallel edges.
        if axisLength > EPSILON
            axis:Scale(1 / axisLength)

            number radiusA =
                math:AbsoluteValue(axis:DotProduct(axesA:Get(0))) * halfA:GetX() +
                math:AbsoluteValue(axis:DotProduct(axesA:Get(1))) * halfA:GetY() +
                math:AbsoluteValue(axis:DotProduct(axesA:Get(2))) * halfA:GetZ()

            number radiusB =
                math:AbsoluteValue(axis:DotProduct(axesB:Get(0))) * halfB:GetX() +
                math:AbsoluteValue(axis:DotProduct(axesB:Get(1))) * halfB:GetY() +
                math:AbsoluteValue(axis:DotProduct(axesB:Get(2))) * halfB:GetZ()

            number signedDistance = centerDelta:DotProduct(axis)
            number rawOverlap =
                radiusA + radiusB - math:AbsoluteValue(signedDistance)

            number testedOverlap = rawOverlap
            number candidateScore = rawOverlap

            if i >= 6
                // Bullet adds rotationFudge to the four relative-rotation
                // terms that contribute to this edge-cross-edge projection.
                // In normalized world-axis space this is the corresponding
                // extent padding divided by the original cross-axis length.
                number paddingA = 0
                number paddingB = 0

                integer extentIndex = 0
                repeat while extentIndex < 3
                    if extentIndex not= edgeA
                        paddingA = paddingA + GetBoxExtent(halfA, extentIndex)
                    end
                    if extentIndex not= edgeB
                        paddingB = paddingB + GetBoxExtent(halfB, extentIndex)
                    end
                    extentIndex = extentIndex + 1
                end

                number crossAxisPadding =
                    rotationFudge * (paddingA + paddingB) / axisLength

                testedOverlap = rawOverlap + crossAxisPadding

                // Bullet gives cross axes a 1.05 selection bias so a face
                // axis wins close ties. The bias affects selection only;
                // minimumOverlap retains the unweighted contact depth.
                candidateScore = testedOverlap * crossAxisBias

                // Bullet's cross-axis separation check allows SIMD_EPSILON
                // before declaring a separating axis. Convert that tolerance
                // to the normalized-axis units used here.
                if testedOverlap < -(EPSILON / axisLength)
                    result:RefreshCollisionPoints()
                    return now
                end
            else
                if testedOverlap < 0
                    result:RefreshCollisionPoints()
                    return now
                end
            end

            if candidateScore < bestAxisScore
                bestAxisScore = candidateScore
                minimumOverlap = testedOverlap
                winningAxis = i
                normalBtoA:Set(axis)

                // The result normal points from B toward A.
                if signedDistance < 0
                    normalBtoA:Scale(-1)
                end
            end
        end

        i = i + 1
    end

    if winningAxis < 0
        result:RefreshCollisionPoints()
        return now
    end

    if winningAxis < 6
        boolean referenceIsA = winningAxis mod 2 = 0
        integer referenceAxisIndex = winningAxis / 2

        CollideBoxFaces(
            transformA, transformB,
            axesA, axesB,
            halfA, halfB,
            referenceIsA, referenceAxisIndex,
            normalBtoA, result)
    else
        integer edgePair = winningAxis - 6
        integer selectedEdgeA = edgePair / 3
        integer selectedEdgeB = edgePair mod 3

        CollideBoxEdges(
            transformA, transformB,
            axesA, axesB,
            halfA, halfB,
            selectedEdgeA, selectedEdgeB,
            normalBtoA, minimumOverlap, result)
    end

    result:RefreshCollisionPoints()
end
    
    
    /*
Write one box face's four corners into the first four entries of corners.
faceDirection points outward from the face.
*/
private action MakeBoxFace(Vector3 boxCenter,
Array<Vector3> axes,
Vector3 half,
Vector3 faceDirection,
Array<Vector3> corners)

    integer normalIndex = 0
    number bestAlignment =
        math:AbsoluteValue(faceDirection:DotProduct(axes:Get(0)))

    integer i = 1
    repeat while i < 3
        number alignment =
            math:AbsoluteValue(faceDirection:DotProduct(axes:Get(i)))
        if alignment > bestAlignment
            bestAlignment = alignment
            normalIndex = i
        end
        i = i + 1
    end

    integer side1 = 0
    integer side2 = 0
    if normalIndex = 0
        side1 = 1
        side2 = 2
    else
        if normalIndex = 1
            side1 = 0
            side2 = 2
        else
            side1 = 0
            side2 = 1
        end
    end

    number normalExtent = GetBoxExtent(half, normalIndex)
    number extent1 = GetBoxExtent(half, side1)
    number extent2 = GetBoxExtent(half, side2)

    faceCenter:Set(axes:Get(normalIndex))
    if faceDirection:DotProduct(faceCenter) < 0
        faceCenter:Scale(-normalExtent)
    else
        faceCenter:Scale(normalExtent)
    end
    faceCenter:Add(boxCenter)

    Vector3 axis1 = axes:Get(side1)
    Vector3 axis2 = axes:Get(side2)
    corners:Get(0):Set(faceCenter):MultiplyAndAdd(axis1, -extent1):MultiplyAndAdd(axis2, -extent2)
    corners:Get(1):Set(faceCenter):MultiplyAndAdd(axis1, -extent1):MultiplyAndAdd(axis2, extent2)
    corners:Get(2):Set(faceCenter):MultiplyAndAdd(axis1, extent1):MultiplyAndAdd(axis2, extent2)
    corners:Get(3):Set(faceCenter):MultiplyAndAdd(axis1, extent1):MultiplyAndAdd(axis2, -extent2)
end
    
    
    private action CollideBoxFaces(PhysicsPosition3D transformA,
PhysicsPosition3D transformB,
Array<Vector3> axesA,
Array<Vector3> axesB,
Vector3 halfA,Vector3 halfB,
boolean referenceIsA,
integer referenceAxisIndex,
Vector3 normalBtoA,
CollisionPointsResult3D result)
    // These name existing arrays. Declaring them without a value would make
    // Quorum build two new arrays only to replace them.
    Array<Vector3> referenceAxes = axesB
    Array<Vector3> incidentAxes = axesA

    if referenceIsA
        referenceCenter:Set(transformA:GetOrigin())
        incidentCenter:Set(transformB:GetOrigin())
        referenceHalf:Set(halfA)
        incidentHalf:Set(halfB)
        referenceOutward:Set(normalBtoA):Scale(-1)
        incidentOutward:Set(normalBtoA)
        referenceAxes = axesA
        incidentAxes = axesB
    else
        referenceCenter:Set(transformB:GetOrigin())
        incidentCenter:Set(transformA:GetOrigin())
        referenceHalf:Set(halfB)
        incidentHalf:Set(halfA)
        referenceOutward:Set(normalBtoA)
        incidentOutward:Set(normalBtoA):Scale(-1)
    end

    number referenceExtent = GetBoxExtent(referenceHalf, referenceAxisIndex)

    referenceFaceCenter:Set(referenceAxes:Get(referenceAxisIndex))
    if referenceOutward:DotProduct(referenceFaceCenter) < 0
        referenceFaceCenter:Scale(-referenceExtent)
    else
        referenceFaceCenter:Scale(referenceExtent)
    end
    referenceFaceCenter:Add(referenceCenter)

    MakeBoxFace(incidentCenter, incidentAxes, incidentHalf, incidentOutward, clipBufferA)

    integer side1 = 0
    integer side2 = 0
    if referenceAxisIndex = 0
        side1 = 1
        side2 = 2
    else
        if referenceAxisIndex = 1
            side1 = 0
            side2 = 2
        else
            side1 = 0
            side2 = 1
        end
    end

    number extent1 = GetBoxExtent(referenceHalf, side1)
    number extent2 = GetBoxExtent(referenceHalf, side2)
    Vector3 axis1 = referenceAxes:Get(side1)
    Vector3 axis2 = referenceAxes:Get(side2)

    // Clip back and forth between the two buffers. The result ends up in A.
    integer clippedCount = ClipBoxPolygon(clipBufferA, 4, clipBufferB, referenceFaceCenter, axis1, extent1, 1)
    clippedCount = ClipBoxPolygon(clipBufferB, clippedCount, clipBufferA, referenceFaceCenter, axis1, extent1, -1)
    clippedCount = ClipBoxPolygon(clipBufferA, clippedCount, clipBufferB, referenceFaceCenter, axis2, extent2, 1)
    clippedCount = ClipBoxPolygon(clipBufferB, clippedCount, clipBufferA, referenceFaceCenter, axis2, extent2, -1)

    // Keep penetrating points and their depths.
    integer count = 0
    integer i = 0
    repeat while i < clippedCount
        Vector3 incidentPoint = clipBufferA:Get(i)
        number depth = 0

        if referenceIsA
            separation:Set(referenceFaceCenter):Subtract(incidentPoint)
            depth = separation:DotProduct(normalBtoA)
            if depth <= 0
                contactPoints:Get(count):Set(incidentPoint)
            end
        else
            separation:Set(incidentPoint):Subtract(referenceFaceCenter)
            depth = separation:DotProduct(normalBtoA)
            if depth <= 0
                contactPoints:Get(count):Set(incidentPoint):MultiplyAndAdd(normalBtoA, -depth)
            end
        end

        if depth <= 0
            contactDepths:Set(count, depth)
            count = count + 1
        end

        i = i + 1
    end

    if count = 0
        return now
    end

    // Two boxes resting face to face give four points, the most common case,
    // and reduction only matters when there are more than four.
    if count <= 4
        i = 0
        repeat while i < count
            result:AddCollisionPoint(normalBtoA, contactPoints:Get(i), contactDepths:Get(i))
            i = i + 1
        end
        return now
    end

    // Bullet-style cullPoints2: keep the deepest contact, then select
    // contacts at evenly spaced angles around the polygon centroid.
    integer targetSelectedPoints = 4

    number centroidX = 0
    number centroidY = 0

    // Project the contact polygon into the reference face's 2D coordinates.
    i = 0
    repeat while i < count
        relativePoint:Set(contactPoints:Get(i)):Subtract(referenceFaceCenter)
        number x = relativePoint:DotProduct(axis1)
        number y = relativePoint:DotProduct(axis2)
        contactX:Set(i, x)
        contactY:Set(i, y)
        centroidX = centroidX + x
        centroidY = centroidY + y
        i = i + 1
    end

    // Area-weighted polygon centroid, including the closing edge. There are
    // always more than four points here.
    number twiceArea = 0
    number centroidNumeratorX = 0
    number centroidNumeratorY = 0

    i = 0
    repeat while i < count
        integer nextIndex = (i + 1) mod count
        number x0 = contactX:Get(i)
        number y0 = contactY:Get(i)
        number x1 = contactX:Get(nextIndex)
        number y1 = contactY:Get(nextIndex)
        number cross = x0 * y1 - x1 * y0

        twiceArea = twiceArea + cross
        centroidNumeratorX = centroidNumeratorX + cross * (x0 + x1)
        centroidNumeratorY = centroidNumeratorY + cross * (y0 + y1)
        i = i + 1
    end

    if math:AbsoluteValue(twiceArea) > EPSILON
        centroidX = centroidNumeratorX / (3 * twiceArea)
        centroidY = centroidNumeratorY / (3 * twiceArea)
    else
        // Degenerate polygon: use the arithmetic mean.
        centroidX = centroidX / count
        centroidY = centroidY / count
    end

    // Bullet cullPoints2 anchors its angular sampling at the deepest point.
    integer deepest = 0
    i = 1
    repeat while i < count
        if contactDepths:Get(i) < contactDepths:Get(deepest)
            deepest = i
        end
        i = i + 1
    end

    i = 0
    repeat while i < count
        number x = contactX:Get(i) - centroidX
        number y = contactY:Get(i) - centroidY

        // InverseTangent(x, y) returns the angle of Cartesian point (x, y).
        if math:AbsoluteValue(x) + math:AbsoluteValue(y) > EPSILON
            contactAngles:Set(i, math:InverseTangent(x, y))
        else
            contactAngles:Set(i, 0)
        end
        i = i + 1
    end

    constant integer TRUE = 1
    constant integer FALSE = 0

    i = 0
    repeat while i < count
        availablePoints:Set(i, TRUE)
        i = i + 1
    end

    selectedPoints:Set(0, deepest)
    availablePoints:Set(deepest, FALSE)

    integer numberSelectedPoints = 1
    repeat while numberSelectedPoints < targetSelectedPoints
        integer bestIndex = -1
        number bestDifference = 1.0e100

        number targetAngle =
            contactAngles:Get(deepest) +
            numberSelectedPoints * (2 * math:pi / targetSelectedPoints)

        if targetAngle > math:pi
            targetAngle = targetAngle - 2 * math:pi
        end

        i = 0
        repeat while i < count
            if availablePoints:Get(i) = TRUE
                number difference =
                    math:AbsoluteValue(contactAngles:Get(i) - targetAngle)

                if difference > math:pi
                    difference = 2 * math:pi - difference
                end

                if difference < bestDifference
                    bestDifference = difference
                    bestIndex = i
                end
            end
            i = i + 1
        end

        if bestIndex >= 0
            selectedPoints:Set(numberSelectedPoints, bestIndex)
            availablePoints:Set(bestIndex, FALSE)
            numberSelectedPoints = numberSelectedPoints + 1
        else
            return now
        end
    end

    i = 0
    repeat while i < numberSelectedPoints
        integer index = selectedPoints:Get(i)
        result:AddCollisionPoint(normalBtoA, contactPoints:Get(index), contactDepths:Get(index))
        i = i + 1
    end
end
    
    /*
Clip the first sourceCount points of source to
sign * dot(point - planeCenter, planeAxis) <= extent, writing the clipped
polygon into destination. Returns how many points were written. source and
destination must be different arrays.
*/
private action ClipBoxPolygon(Array<Vector3> source,
integer sourceCount,
Array<Vector3> destination,
Vector3 planeCenter,
Vector3 planeAxis,
number extent,
number sign) returns integer
    if sourceCount = 0
        return 0
    end

    // sign * dot(point - planeCenter, planeAxis) - extent, written so that no
    // temporary vector is needed for point - planeCenter.
    number planeOffset = sign * planeCenter:DotProduct(planeAxis) + extent

    Vector3 current = source:Get(0)
    number currentDistance = sign * current:DotProduct(planeAxis) - planeOffset
    number firstDistance = currentDistance

    integer clippedCount = 0
    integer i = 0
    repeat while i < sourceCount
        integer nextIndex = i + 1
        number nextDistance = firstDistance
        if nextIndex = sourceCount
            nextIndex = 0
        else
            nextDistance = sign * source:Get(nextIndex):DotProduct(planeAxis) - planeOffset
        end
        Vector3 next = source:Get(nextIndex)

        boolean currentInside = currentDistance <= 0
        boolean nextInside = nextDistance <= 0

        if currentInside
            destination:Get(clippedCount):Set(current)
            clippedCount = clippedCount + 1
        end

        if currentInside not= nextInside
            number fraction = currentDistance / (currentDistance - nextDistance)
            // current + (next - current) * fraction
            destination:Get(clippedCount):Set(current):Scale(1 - fraction):MultiplyAndAdd(next, fraction)
            clippedCount = clippedCount + 1
        end

        current = next
        currentDistance = nextDistance
        i = i + 1
    end

    return clippedCount
end
    
    
    
    private action GetBoxExtent(Vector3 half, integer index) returns number
    if index = 0
        return half:GetX()
    end
    if index = 1
        return half:GetY()
    end
    return half:GetZ()
end
    
    
    private action CollideBoxEdges(PhysicsPosition3D transformA,
PhysicsPosition3D transformB,
Array<Vector3> axesA,
Array<Vector3> axesB,
Vector3 halfA,Vector3 halfB,
integer edgeA, integer edgeB,
Vector3 normalBtoA,
number penetration,
CollisionPointsResult3D result)
        Vector3 pointA = edgePointA
    pointA:Set(transformA:GetOrigin())

    Vector3 pointB = edgePointB
    pointB:Set(transformB:GetOrigin())

    // Offset the edge centers along their two non-edge axes.
    integer i = 0
    repeat while i < 3
        if i not= edgeA
            number extentA = GetBoxExtent(halfA, i)
            number signA = 1
            if normalBtoA:DotProduct(axesA:Get(i)) > 0
                signA = -1
            end
            pointA:MultiplyAndAdd(axesA:Get(i), signA * extentA)
        end

        if i not= edgeB
            number extentB = GetBoxExtent(halfB, i)
            number signB = 1
            if normalBtoA:DotProduct(axesB:Get(i)) < 0
                signB = -1
            end
            pointB:MultiplyAndAdd(axesB:Get(i), signB * extentB)
        end

        i = i + 1
    end

    
        // The edge directions are only read, so these name the axes directly.
    Vector3 directionA = axesA:Get(edgeA)
    Vector3 directionB = axesB:Get(edgeB)

    Vector3 between = edgeBetween
    between:Set(pointB)
    between:Subtract(pointA)

    number dotAB = directionA:DotProduct(directionB)
    number q1 = directionA:DotProduct(between)
    number q2 = -directionB:DotProduct(between)
    number denominator = 1 - dotAB * dotAB

    number alpha = 0
    number beta = 0
    if denominator > 0.0001
        alpha = (q1 + dotAB * q2) / denominator
        beta = (dotAB * q1 + q2) / denominator
    end

    // Apply both line parameters; the contact point is on B's edge.
    pointA:MultiplyAndAdd(directionA, alpha)
    pointB:MultiplyAndAdd(directionB, beta)

    result:AddCollisionPoint(normalBtoA, pointB, -penetration)
end
end