package Libraries.Game.Collision.Shapes

use Libraries.Compute.Vector3
use Libraries.Game.Graphics.Worlds.Terrain
use Libraries.Game.BoundingBox
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Containers.Array
use Libraries.Compute.Matrix3
use Libraries.Compute.Math
use Libraries.Compute.Matrix4
use Libraries.Game.Collision.CollisionPointsResult3D
use Libraries.Game.Collision.Narrowphase.ConvexConvexPairSolver
use Libraries.Game.Collision.LocalCollisionPoints3D
use Libraries.Game.Collision.CollisionPoint3D

class HeightmapTerrainShape is Box, ConcaveShape3D
    Terrain terrain = undefined
    Math math
    Array<Vector3> tempVertices
    BoundingBox tempTerrainBox
    BoundingBox tempShapeBox
    BoundingBox tempTriangleBox
    ConvexConvexPairSolver gjkPairDetector
    
    
    Triangle triangle
    PhysicsPosition3D triangleTransform
    Vector3 worldVertex0
    Vector3 worldVertex1
    Vector3 worldVertex2
    Vector3 triangleNormal
    Vector3 supportDirection
    Vector3 supportPoint
    
    on create
        SetType(parent:CollisionShape3D:TERRAIN)
        
        //Setup some vertices for temporary storage
        Vector3 v1
        Vector3 v2
        Vector3 v3
        tempVertices:Add(v1)
        tempVertices:Add(v2)
        tempVertices:Add(v3)
    end
    
    
    action ComputeBoundingBox(BoundingBox boundingBox, PhysicsPosition3D transform)
        parent:Box:ComputeBoundingBox(boundingBox, transform)
 end
    
    action ProcessAllTriangles(LocalCollisionPoints3D collisionPoints, CollisionShape3D shape, PhysicsPosition3D terrainTransform, 
PhysicsPosition3D shapeTransform, CollisionPointsResult3D result)
        me:ComputeBoundingBox(tempTerrainBox, terrainTransform)
        shape:ComputeBoundingBox(tempShapeBox, shapeTransform)
        //tempShapeBox:Clamp(tempTerrainBox)
        number extraMargin = GetMargin() + collisionPoints:GetCollisionBreakingThreshold()
        tempShapeBox:GetMinimum():Add(-extraMargin)
        tempShapeBox:GetMaximum():Add(extraMargin)
        tempShapeBox:CalculateDimensions()
        
        result:SetCollisionPoints(collisionPoints)
        
        //Get where the bounding box is on the map.
        Vector3 terrainDimensions = tempTerrainBox:GetDimensions()
        number scaleX = terrain:GetScaleX()
        number scaleZ = terrain:GetScaleZ()
        
        Vector3 terrainOrigin = terrainTransform:GetOrigin()
        number originX = terrainOrigin:GetX()
        number originZ = terrainOrigin:GetZ()
        
        number xLocalMin = (tempShapeBox:GetMinimum():GetX() - originX) / scaleX
        number xLocalMax = (tempShapeBox:GetMaximum():GetX() - originX) / scaleX
        number zLocalMin = (tempShapeBox:GetMinimum():GetZ() - originZ) / scaleZ
        number zLocalMax = (tempShapeBox:GetMaximum():GetZ() - originZ) / scaleZ

        //Expand by a cell each way, as Bullet does, so a box that falls between
        //grid points still tests the cells on either side of it.
        integer xmin = cast(integer, math:Floor(xLocalMin)) - 1
        integer xmax = cast(integer, math:Floor(xLocalMax)) + 1
        integer zmin = cast(integer, math:Floor(zLocalMin)) - 1
        integer zmax = cast(integer, math:Floor(zLocalMax)) + 1

        if xmin < 0
            xmin = 0
        end

        if zmin < 0
            zmin = 0
        end

        if xmax > terrain:GetPixelWidth() - 2
            xmax = terrain:GetPixelWidth() - 2
        end

        if zmax > terrain:GetPixelHeight() - 2
            zmax = terrain:GetPixelHeight() - 2
        end
        
        Matrix4 terrainNormalTransform = terrain:GetTransform()
        i = xmin
        j = zmin
        repeat while i <= xmax
            repeat while j <= zmax
                ProcessTriangle(collisionPoints, shape, shapeTransform, result, terrainNormalTransform, i, j, false)
                ProcessTriangle(collisionPoints, shape, shapeTransform, result, terrainNormalTransform, i, j, true)
                j = j + 1
            end
            
            j = zmin
            i = i + 1
        end
        
        result:RefreshCollisionPoints()
        
        integer p = 0
            repeat while p < collisionPoints:GetPointCount()
                CollisionPoint3D point = collisionPoints:GetCollisionPoint(p)
                Vector3 n = point:GetWorldNormalOnB()
                p = p + 1
            end
 end
    
    action ProcessTriangle(LocalCollisionPoints3D collisionPoints, CollisionShape3D shape, PhysicsPosition3D shapeTransform, 
CollisionPointsResult3D result, Matrix4 terrainNormalTransform, integer x, integer z, boolean leftTriangle)

        terrain:FillAtPixel(x, z, tempVertices, tempTriangleBox, leftTriangle)
                Vector3 value1 = terrainNormalTransform:TransformWorldCoordinate(tempTriangleBox:GetMinimum())
                Vector3 value2 = terrainNormalTransform:TransformWorldCoordinate(tempTriangleBox:GetMaximum())
                tempTriangleBox:Set(value1, value2)
        
        
        terrainNormalTransform:TransformWorldCoordinate(tempVertices:Get(0), worldVertex0)
        terrainNormalTransform:TransformWorldCoordinate(tempVertices:Get(1), worldVertex1)
        terrainNormalTransform:TransformWorldCoordinate(tempVertices:Get(2), worldVertex2)
        triangle:Set(worldVertex0, worldVertex1, worldVertex2)
        triangle:SetMargin(GetMargin())
                
        BoundingBox tempProxyBox
    Box proxyBox
    PhysicsPosition3D proxyPosition
                boolean value = tempTriangleBox:Intersects(tempShapeBox)
                if value
            if not tempTriangleBox:Intersects(tempShapeBox)
            return now
        end
            triangle:CalculateNormal(triangleNormal)
        result:SetFaceNormal(triangleNormal)
        CollideConvexConvex(collisionPoints, triangle, triangleTransform, shape, shapeTransform, result)
            result:ClearFaceNormal()
                end
    end
    
    /*
    This action checks whether the object is entirely off one face of the triangle's
    plane, far enough away that no contact could reach it. Both facings have to be
    checked, because the object may be on either side of the triangle.
    */
    private action IsSeparatedFromTriangle(CollisionShape3D shape, PhysicsPosition3D shapeTransform, number contactThreshold) returns boolean
        triangle:CalculateNormal(triangleNormal)
        if IsBeyondPlane(shape, shapeTransform, contactThreshold)
            return true
        end
        triangleNormal:Scale(-1)
        if IsBeyondPlane(shape, shapeTransform, contactThreshold)
            return true
        end
        return false
    end
    
    /*
    This action is used by "action IsSeparatedFromTriangle." It finds the point on
    the object that reaches furthest along the current triangle normal, and reports
    whether even that point falls short of the triangle's plane.
    */
    private action IsBeyondPlane(CollisionShape3D shape, PhysicsPosition3D shapeTransform, number contactThreshold) returns boolean
        supportDirection:Set(triangleNormal)
        supportDirection:MultiplyByTranspose(shapeTransform:GetBasis())
        supportPoint:Set(shape:LocalGetSupportingVertex(supportDirection))
        shapeTransform:Transform(supportPoint)
        number planeDistance = triangleNormal:DotProduct(triangle:GetVertex(0))
        number pointDistance = triangleNormal:DotProduct(supportPoint)
        return planeDistance - pointDistance > contactThreshold
    end
    
    private action CollideConvexConvex(LocalCollisionPoints3D collisionPoints, CollisionShape3D shapeA, PhysicsPosition3D transformA, 
CollisionShape3D shapeB, PhysicsPosition3D transformB, CollisionPointsResult3D result)
        result:SetCollisionPoints(collisionPoints)
        number maximumDistanceSquared = 0

        gjkPairDetector:SetMinkowskiA(shapeA)
        gjkPairDetector:SetMinkowskiB(shapeB)
        maximumDistanceSquared = shapeA:GetMargin() + shapeB:GetMargin() + collisionPoints:GetCollisionBreakingThreshold()
        maximumDistanceSquared = maximumDistanceSquared * maximumDistanceSquared

        PhysicsPosition3D inputTransformA
        inputTransformA:Set(transformA)
        PhysicsPosition3D inputTransformB
        inputTransformB:Set(transformB)

        gjkPairDetector:GetClosestPoints(inputTransformA, inputTransformB, maximumDistanceSquared, result, false)
    end
    
    
    action Copy returns CollisionShape3D
        HeightmapTerrainShape copy
        copy:Set(parent:CollisionShape3D:implicitShapeDimensions)
        copy:parent:CollisionShape3D:localScaling:Set(parent:CollisionShape3D:localScaling)
        copy:SetTerrain(terrain)
        return copy
    end
    
    
    private action Set(Vector3 halfExtents)
        Vector3 margin
        margin:Set(GetMargin(), GetMargin(), GetMargin())
        parent:CollisionShape3D:implicitShapeDimensions:Set(halfExtents:GetX() * parent:CollisionShape3D:localScaling:GetX(), 
                                                            halfExtents:GetY() * parent:CollisionShape3D:localScaling:GetY(), 
                                                            halfExtents:GetZ() * parent:CollisionShape3D:localScaling:GetZ())
        parent:CollisionShape3D:implicitShapeDimensions:Subtract(margin)
    end
    
    action GetChildCount returns integer
        return 1
    end
    
    action GetTerrain returns Terrain
        return terrain
    end

    action SetTerrain(Terrain terrain)
        me:terrain = terrain
    end
end
