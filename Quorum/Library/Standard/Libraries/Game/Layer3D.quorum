package Libraries.Game

use Libraries.Interface.Item
use Libraries.Interface.Item3D
use Libraries.Interface.Accessibility
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Events.TouchEvent
use Libraries.Interface.Events.ResizeEvent
use Libraries.Interface.Events.MouseListener
use Libraries.Interface.Events.MouseMovementListener
use Libraries.Interface.Events.MouseWheelListener
use Libraries.Interface.Events.TouchListener
use Libraries.Interface.Events.CollisionEvent3D
use Libraries.Interface.Events.CollisionListener3D
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.PerspectiveCamera
use Libraries.Game.Graphics.GraphicsManager
use Libraries.Game.Graphics.Painter3D
use Libraries.Game.Graphics.OpenGL.OpenGLPainter3D
use Libraries.Game.Graphics.Environment
use Libraries.Game.Graphics.Light
use Libraries.Game.Graphics.PointLight
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.AmbientLight
use Libraries.Game.Graphics.Models.OpenGL.Attributes.DirectionalLightsAttribute
use Libraries.Game.Graphics.Models.OpenGL.Attributes.PointLightsAttribute
use Libraries.Game.Graphics.Skybox
use Libraries.Game.Collision.CollisionManager3D
use Libraries.Game.Collision.CollisionEdge3D
use Libraries.Compute.Ray
use Libraries.Compute.Vector3
use Libraries.Compute.Matrix4
use Libraries.Game.Physics.CollisionGroup3D
use Libraries.Containers.Stack
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.Physics.CollisionSolverInformation3D
use Libraries.Game.Physics.Joints.Joint3D
use Libraries.Game.Physics.Joints.JointEdge3D
use Libraries.Compute.Math
use Libraries.Compute.Quaternion
use Libraries.System.SystemHelper
use Libraries.Language.Errors.ConcurrencyError
use Libraries.Interface.Events.GestureListener
use Libraries.Interface.Events.GestureEvent
use Libraries.Game.Graphics.OpenGL.OpenGLManager
use Libraries.Game.Graphics.Vulkan.VulkanPainter3D
use Libraries.Game.Graphics.Models.Vulkan.EnvironmentVulkan
use Libraries.Game.Graphics.Models.OpenGL.Attributes.EnvironmentOpenGL
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Collision.RayCastResult3D
use Libraries.Game.Physics.PhysicsBehavior3D
use Libraries.Game.Graphics.Trees.RenderTree3D
use Libraries.Game.Graphics.Trees.DynamicVolumeRenderTree3D
use Libraries.Game.Graphics.Trees.RenderTreeNode3D
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Trees.RenderTree3DResult

/*
The Layer3D class is used to manage a number of 3D objects, as well as manage
input. The Layer2D effectively consists of a 3D "world", where all objects added
to it exist in the same space and can interact with each other.

The layer only draws what the camera can see, and, in Vulkan, what could
cast a shadow into view. It finds these with a render tree, which holds a
box around each item added to the layer (see Item3D:GetRenderBounds). An
item's children are drawn with it, so a child is not drawn when its parent's
box is out of view, even if the child itself would be in view.

Attribute: Author William Allee

Attribute: Example

use Libraries.Game.Game
use Libraries.Game.Layer3D
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color

class Main is Game

    action Main
        StartGame()
    end

    action CreateGame
        Color color

        Model box
        box:LoadBox(2, 2, 2, color:Maroon())
        box:SetPosition(-2, 0, 2)

        Model sphere
        sphere:LoadSphere(2, 2, 2, color:Teal())
        sphere:SetPosition(2, 0, 2)

        Layer3D layer
        layer:Add(box)
        layer:Add(sphere)
        AddLayer(layer)
    end

    action Update(number seconds)
    end
end
*/
class Layer3D is Layer

    // Every item added to the layer. Their children are reached through
    // them. The tree also finds what the camera can see.
    RenderTree3D renderTree = undefined
    DynamicVolumeRenderTree3D defaultRenderTree

    // The items with physics, split by whether physics is moving them. They
    // use the same kind of tree as the rendering tree, only to hold their
    // items, so physics visits only the bodies that are awake.
    RenderTree3D awakeBodies = undefined
    RenderTree3D sleepingBodies = undefined
    DynamicVolumeRenderTree3D defaultAwakeBodies
    DynamicVolumeRenderTree3D defaultSleepingBodies

    // Bodies put in a group during the last physics step, so their group
    // flags can be cleared without visiting every body.
    Array<Item3D> grouped

    // Bodies that woke or fell asleep, moved to the matching physics tree
    // once no walk of the trees is under way.
    Array<Item3D> changedBodies

    // Items that reported a move since the rendering tree was last told.
    Array<Item3D> movedItems

    // The bounds given to items with no shape: a box of no size at the
    // item's own position, so every item is in the rendering tree.
    BoundingBox emptyBounds

    // Reused every frame while drawing. Emptied with Empty(false), which
    // keeps their storage.
    RenderTree3DResult found
    Array<Item3D> transparentItems
    Array<Item3D> sortSpace

    // Sorts transparent models from farthest to nearest.
    Item3DBackToFrontComparison backToFront

    // Counts frames, so an item found by more than one search is drawn once.
    integer frame = 0
    Array<MouseListener> mouseListeners
    Array<MouseMovementListener> mouseMovementListeners
    Array<MouseWheelListener> mouseWheelListeners
    Array<TouchListener> touchListeners
    Array<GestureListener> gestureListeners
    Array<PhysicsBehavior3D> physicsBehaviors
    Camera camera = undefined
    Environment environment = undefined
    Skybox skybox = undefined
    GameStateManager manager
    SystemHelper systemHelper
    GraphicsManager graphics = undefined
    
// The painter is lazy-loaded. Once it's loaded, it'll instantiate a different type of Painter depending on if the system uses OpenGL or Vulkan.
    Painter3D painter = undefined
    boolean painterInitialized = false

    boolean newItemAdded = false

    CollisionManager3D collisionManager

    boolean physicsEnabled = false
    boolean automaticallyClearForces = true
    boolean warmStarting = true
    boolean continuousPhysics = false
    boolean subStepping = false
    boolean stepComplete = true
    boolean requireSimulation = false
    Math math

    number inverseDeltaTime0 = 0

    Vector3 gravity

    number physicsTimeStep = 1.0 / 60.0
    integer maxSubSteps = 1


    number localTime = 1.0 / 60.0
    /*
    This array is used when adding or removing Items to the game to find any
    lights in the children hierarchy that need to be added/removed from the
    environment at the same time. Since it will be reused often, the array
    should be emptied after each use.
    */
    Array<Light> lightGatheringArray
    /* This allows us to turn off collisions for the entire game. */
    private boolean collide = true

    /*
    This array is used when processing mouse or touch events. It stores the
    possible candidates for mouse and touch events. Since it will be reused
    often, it must be emptied after each use.
    */
    Array<Item3D> eventTargetArray
    Item3DDepthComparison depthSorter

    on create
        renderTree = defaultRenderTree
        awakeBodies = defaultAwakeBodies
        sleepingBodies = defaultSleepingBodies

        SetName("Layer3D")

        PerspectiveCamera cam
        camera = cam
        camera:SetPosition(0, 3, -5)
        camera:LookAt(0, 0, 0)
        camera:Update()
        SetViewport(0, 0, manager:GetGameDisplay():GetWidth(), manager:GetGameDisplay():GetHeight())
        
        graphics = manager:GetGameGraphics()
        
        Painter3D painter = GetPainter()
        if painter is VulkanPainter3D
            VulkanGraphics vGraphics = cast(VulkanGraphics, manager:GetGameGraphics())
            EnvironmentVulkan environ
            environ:Create(vGraphics:GetDevice(), vGraphics)
            environment = environ
        else
            EnvironmentOpenGL environ
            environment = environ
        end
        
        painter:SetEnvironment(environment)
        painter:SetCamera(camera)
    end
    
    
    /*
    This action adds a PhysicsBehavior3D to the layer. A behavior takes part
    in the layer's physics without being an item. Joints, which connect two
    items, are behaviors, and so are vehicles. While it is in the layer, the
    layer calls the behavior during each physics step and each frame, as
    described in PhysicsBehavior3D.

    Attribute: Parameter behavior The behavior to add.
    */
    action Add(PhysicsBehavior3D behavior)
        //if the behavior reports it is in the layer, don't add it to avoid an infinite loop
        //This would not prevent all cases without a O(n) search, but should be sufficient.
        Layer3D current = behavior:GetLayer()
        if current = me
            return now
        elseif current not= undefined
            current:Remove(behavior)
        end
        
        physicsBehaviors:Add(behavior)
        behavior:SetLayer(me)
        behavior:LinkEdges()
        behavior:AddedToLayer(me)
    end

    /*
    This action removes a PhysicsBehavior3D from the layer. The layer stops
    calling the behavior, and any items it connected, such as the two items
    of a joint, are no longer held together.

    Attribute: Parameter behavior The behavior to remove.
    */
    action Remove(PhysicsBehavior3D behavior)
        if behavior:GetLayer() not= me
            return now
        end
        behavior:RemovedFromLayer(me)
        behavior:UnlinkEdges()
        physicsBehaviors:Remove(behavior)
        behavior:SetLayer(undefined)
    end

    /*
    This action returns how many PhysicsBehavior3D objects are in this layer.

    Attribute: Returns The number of behaviors in the layer.
    */
    action GetPhysicsBehaviorsSize returns integer
        return physicsBehaviors:GetSize()
    end

    /*
    This action returns one of the PhysicsBehavior3D objects in this layer.
    Indexes start at 0.

    Attribute: Parameter index The index of the behavior.
    Attribute: Returns The behavior at that index.
    */
    action GetPhysicsBehavior(integer index) returns PhysicsBehavior3D
        return physicsBehaviors:Get(index)
    end
    
    
    /*
    This action checks which item in this layer a straight line segment,
    called a ray, touches first. The ray starts at "from" and ends at "to,"
    both in world space. Every collidable item in the layer can be hit.

    This is a physics query. It tests each item's collision shape, not its
    drawn model, so it agrees with what the physics system considers solid.
    It is different from the mouse picking this layer uses to find which item
    is under the pointer.

    The result is reset before the search begins. If the ray hits anything,
    the result holds the item that was hit, the fraction of the way along the
    ray where the hit happened (0 is "from" and 1 is "to"), the hit point in
    world space, and the surface normal at that point.

    Attribute: Parameter from The world-space point where the ray starts.
    Attribute: Parameter to The world-space point where the ray ends.
    Attribute: Parameter result Receives the closest hit. It is reset before the search begins.
    Attribute: Returns true if the ray hit an item, and false otherwise.

    Attribute: Example

        use Libraries.Game.Game
        use Libraries.Game.Graphics.Model
        use Libraries.Game.Graphics.Color
        use Libraries.Game.Collision.RayCastResult3D
        use Libraries.Compute.Vector3

        class Main is Game
            Model ground

            action Main
                StartGame()
            end

            action CreateGame
                EnablePhysics3D(true)
                Color color
                // A flat ground whose top surface is at y = 0.
                ground:LoadBox(10, 1, 10, color:Gray())
                ground:SetPosition(0, -0.5, 0)
                ground:EnablePhysics(true)
                ground:SetMass(0)
                Add(ground)
            end

            action Update(number seconds)
                // A ray straight down from 10 units above the ground.
                Vector3 from
                from:Set(0, 10, 0)
                Vector3 to
                to:Set(0, -10, 0)
                RayCastResult3D result
                if GetCurrentLayer3D():RayCastPhysics(from, to, result)
                    // The ray reaches the top of the ground halfway down,
                    // so this outputs a fraction of about 0.5.
                    output "Hit at fraction " + result:GetFraction()
                end
            end
        end
    */
    action RayCastPhysics(Vector3 from, Vector3 to, RayCastResult3D result) returns boolean
        return collisionManager:RayCastPhysics(from, to, result)
    end

    /*
    This action checks which item in this layer a straight line segment,
    called a ray, touches first, skipping one item. The ray starts at "from"
    and ends at "to," both in world space. Skipping an item is useful when
    the ray starts on or inside something that should not count. For
    example, a vehicle skips its own body when it checks the ground under
    its wheels.

    This is a physics query that tests collision shapes. See the other
    RayCast action in this class for what the result holds.

    Attribute: Parameter from The world-space point where the ray starts.
    Attribute: Parameter to The world-space point where the ray ends.
    Attribute: Parameter ignore An item the ray passes through, or undefined to test every item.
    Attribute: Parameter result Receives the closest hit. It is reset before the search begins.
    Attribute: Returns true if the ray hit an item, and false otherwise.
    */
    action RayCastPhysics(Vector3 from, Vector3 to, Item3D ignore, RayCastResult3D result) returns boolean
        return collisionManager:RayCastPhysics(from, to, ignore, result)
    end
    

    /* This allows us to know if collisions are on or off for the layer. */
    action IsColliding returns boolean
        return collide
    end

    /* This allows us to turn collisions on or off for the layer. */
    action SetColliding(boolean collide)
        me:collide = collide
    end

    /*
    This action ensures that the current thread is the same as the main GUI
    thread. Certain kinds of actions like adding or removing items should only
    be done on the GUI thread.

    If this code is being called from outside the GUI thread, it alerts a
    ConcurrencyException.
    */
    private action EnsureCorrectThread
        if (manager:GetApplication() is DesktopApplication) and (manager:GetMainThreadName() not= systemHelper:GetThreadName())
            ConcurrencyError error
            error:SetErrorMessage("I can only add or remove items from the Game on the main thread, but I was asked to do so on a different thread.")
            alert(error)
        end
    end

    /*
    This action will add an Item3D to this Layer. It will be updated along with
    the rest of the layer, and will be drawn on the screen (if it is visible and
    possible to draw the given Item3D). The layer keeps its items in a tree, so
    they have no order.

    Attribute: Parameter item The Item3D to be added to the layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Item3D
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            // Item3D objects aren't visible, but can still be used for game logic.
            Item3D area
            area:SetWidth(5)
            area:SetHeight(5)
            area:SetDepth(5)
            area:SetPosition(0, 10, 0)

            // Models inherit from Item3D, so they can be added too.
            Model cylinder
            Color color
            cylinder:LoadCylinder(2, 4, 2, color:Orange())
            cylinder:SetPosition(0, 0, 3)

            Layer3D layer
            layer:Add(area)
            layer:Add(cylinder)
            AddLayer(layer)
        end

        action Update(number seconds)
        end
    end
    */
    action Add(Item3D item)
        EnsureCorrectThread()

        item:SetLayer(me)
        AddToRenderTree(item)
        if item:IsPhysicsEnabled()
            AddBody(item)
        end
        EnableItemLighting(item)
        newItemAdded = true

        Accessibility accessibility = manager:GetAccessibility()
        if accessibility not= undefined
            accessibility:Add(item)
        end
    end

    /*
    This action will clear all the items in this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Color color

            Model box
            box:LoadBox(2, 2, 2, color:Red())
            box:SetPosition(0, 0, 2)

            Layer3D layer
            layer:Add(box)
            AddLayer(layer)

            layer:Empty()
        end

        action Update(number seconds)
        end
    end
    */
    action Empty
        //has to be done this way so that physics behaviors are informed that they were removed
        if physicsBehaviors not= undefined
            repeat while not physicsBehaviors:IsEmpty()
                Remove(physicsBehaviors:Get(physicsBehaviors:GetSize() - 1))
            end
        end

        // The next leaf is found before an item is handled, since handling it
        // takes it off the layer.
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            RenderTreeNode3D upcoming = renderTree:GetNextLeaf(leaf)
            Item3D body = leaf:GetItem()
            CollisionEdge3D edge = body:GetCollisionList()
            repeat while edge not= undefined
                CollisionEdge3D edge0 = edge
                edge = edge:GetNext()
                collisionManager:Destroy(edge0:GetCollision())
            end
            body:SetCollisionList(undefined)
            body:DestroyNodes(collisionManager:GetBroadphase())
            body:SetCollidable(false)
            body:SetLayer(undefined)
            leaf = upcoming
        end

        renderTree:Empty()
        awakeBodies:Empty()
        sleepingBodies:Empty()
        grouped:Empty()
        changedBodies:Empty()
        movedItems:Empty()
    end

    /*
    This action will remove an Item3D from this layer. If the item was not a
    part of this layer, this action will have no effect.

    Attribute: Parameter item The item to remove from this layer.

    Attribute: Returns Whether or not the item was found and removed from the layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.Model
    use Libraries.Game.Graphics.Color

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Color color
            Model box
            box:LoadBox(2, 2, 2, color:Orange())
            box:SetPosition(0, 0, 2)

            Layer3D layer
            layer:Add(box)
            AddLayer(layer)

            layer:Remove(box)
        end

        action Update(number seconds)
        end
    end
    */
    action Remove(Item3D item)
        EnsureCorrectThread()

        if IsColliding()
            CollisionEdge3D edge = item:GetCollisionList()
            repeat while edge not= undefined
                CollisionEdge3D edge0 = edge
                edge = edge:GetNext()
                collisionManager:Destroy(edge0:GetCollision())
            end
            item:SetCollisionList(undefined)

            item:DestroyNodes(collisionManager:GetBroadphase())
            item:SetCollidable(false)
        end

        item:SetLayer(undefined)
        renderTree:Remove(item)
        RemoveBody(item)
        DisableItemLighting(item)

        Accessibility accessibility = manager:GetAccessibility()
        if accessibility not= undefined
            accessibility:Remove(item)
        end
    end

    /*
    This action will return an iterator of all the Item3D's stored inside this
    layer. The items come in the order of the layer's tree, which is not the
    order they were added in, and can change as they move.

    Attribute: Returns An iterator containing all Item3D's stored in this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Item3D
    use Libraries.Containers.Iterator

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Item3D item1
            Item3D item2
            Item3D item3

            Layer3D layer
            layer:Add(item1)
            layer:Add(item2)
            layer:Add(item3)
            AddLayer(layer)

            Iterator<Item3D> itemIterator = layer:GetIterator()
        end

        action Update(number seconds)
        end
    end
    */
    action GetIterator returns Iterator<Item3D>
        return renderTree:GetIterator()
    end

    /*
    This action will return the number of items that have been added to this
    layer.

    Attribute: Returns The number of items stored in this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Item3D

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Item3D item1
            Item3D item2
            Item3D item3

            Layer3D layer
            layer:Add(item1)
            layer:Add(item2)
            layer:Add(item3)
            AddLayer(layer)

            integer size = layer:GetSize()
            output "There are " + size + " items stored in the layer."
        end

        action Update(number seconds)
        end
    end
    */
    action GetSize returns integer
        return renderTree:GetSize()
    end

    /*
    This action will return false if there are items stored in this layer, or
    true if there are none.

    Attribute: Returns Whether or not any items are stored in this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Item3D

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            Item3D item1
            Item3D item2
            Item3D item3

            Layer3D layer
            boolean empty = layer:IsEmpty()
            output "IsEmpty() returned " + empty

            layer:Add(item1)
            layer:Add(item2)
            layer:Add(item3)

            empty = layer:IsEmpty()
            output "After adding items, IsEmpty() returns " + empty

            AddLayer(layer)            
        end

        action Update(number seconds)
        end
    end
    */
    action IsEmpty returns boolean
        return renderTree:GetSize() = 0
    end

    /*
    This action returns true if the given item was added to this layer. It
    does not look for children of the layer's items.

    Attribute: Parameter item The item to look for.
    Attribute: Returns True if the item was added to this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Item3D

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            Item3D item
            Layer3D layer = GetCurrentLayer3D()
            output layer:Has(item)
            layer:Add(item)
            output layer:Has(item)
        end
    end
    */
    action Has(Item3D item) returns boolean
        return renderTree:Has(item)
    end

    /*
    This action will enable lighting for the given Item3D (if it is a light)
    and any of its children (if they are lights). This action is called
    automatically by the Layer when adding or removing items. Most users will
    never need to use this action directly.
    */
    action EnableItemLighting(Item3D item)
        // Find all lights in the item's children hierarchy.
        item:GetLights(lightGatheringArray)

        // Add all found lights to the environment.
        environment:Add(lightGatheringArray)

        // Empty the array after, to allow for re-use.
        lightGatheringArray:Empty()
    end

    /*
    This action will disable lighting for the given Item3D (if it is a light)
    and any of its children (if they are lights). This action is called
    automatically by the Layer when adding or removing items. Most users will
    never need to use this action directly.
    */
    action DisableItemLighting(Item3D item)
        // Find all lights in the item's children hierarchy.
        item:GetLights(lightGatheringArray)

        // Remove all found lights from the environment.
        environment:Remove(lightGatheringArray)

        // Empty the array after, to allow for re-use.
        lightGatheringArray:Empty()
    end

    /*
    This action is called by an item on this layer, or one of its
    children, the first time it moves, turns or changes scale after its
    move report was cleared. The layer keeps it until collisions are next
    found, so its collision box can be brought up to date. Then it tells the
    rendering tree the item moved, and clears its report.

    Attribute: Parameter item The item that moved.
    */
    action ItemMoved(Item3D item)
        movedItems:Add(item)
    end

    /*
    This action is called by an item on this layer, or one of its
    children, when its width, height or depth changes, such as when a model
    finishes loading. An item added to the layer is placed in the rendering
    tree again, with its new bounds. A child is left alone, since only the
    items added to the layer are in the tree.

    Attribute: Parameter item The item whose size changed.
    */
    action ItemResized(Item3D item)
        if renderTree:Remove(item)
            AddToRenderTree(item)
        end
    end

    /*
    This action is called by an item on this layer when its physics is
    turned on or off. An item added to the layer is put in, or taken out of,
    the trees physics uses.

    Attribute: Parameter item The item whose physics changed.
    */
    action ItemPhysicsChanged(Item3D item)
        if not renderTree:Has(item)
            return now
        end
        if item:IsPhysicsEnabled()
            AddBody(item)
        else
            RemoveBody(item)
        end
    end

    /*
    This action is called by an item on this layer when physics starts or
    stops simulating it, that is, when it wakes or falls asleep. The item is
    moved to the matching physics tree once no walk of the trees is under
    way.

    Attribute: Parameter item The item that woke or fell asleep.
    */
    action ItemSimulationChanged(Item3D item)
        changedBodies:Add(item)
    end

    /*
    This action will update all of the items contained within this Layer. The
    given number of seconds will be passed to each updated item. This is
    automatically called by the Game class as needed. Most users will never need
    to use this action directly.
    */
    action Update(number seconds)
        // The next leaf is found before an item is updated, so an item can
        // remove itself while it updates.
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            RenderTreeNode3D upcoming = renderTree:GetNextLeaf(leaf)
            leaf:GetItem():UpdateAll(seconds)
            leaf = upcoming
        end
    end

    /*
    This action draws the items in this layer that the camera can see, if
    the layer is showing. In Vulkan, it also draws the items that are out of
    view but could cast a shadow into it, so their shadows still show.
    Transparent models are drawn last, from farthest to nearest, so each
    blends over what is behind it. This is automatically called by the Game
    class as needed. Most users will never need to use this action directly.
    */
    action Draw
        if not IsShowing()
            return now
        end
        
        camera:Update()

if graphics is OpenGLManager
            OpenGLManager openGL = cast(OpenGLManager, graphics)
if (GetViewportX() not= openGL:GetViewportX() or GetViewportY() not= openGL:GetViewportY()
            or GetViewportWidth() not= openGL:GetViewportWidth() or GetViewportHeight() not= openGL:GetViewportHeight())
            openGL:SetViewport(GetViewportX(), GetViewportY(), GetViewportWidth(), GetViewportHeight())
        end
        end

Painter3D painter = GetPainter()
        if painter is VulkanPainter3D
            VulkanPainter3D vulkan = cast(VulkanPainter3D, painter)
            if (GetViewportX() not= vulkan:GetViewportX() or GetViewportY() not= vulkan:GetViewportY()
            or GetViewportWidth() not= vulkan:GetViewportWidth() or GetViewportHeight() not= vulkan:GetViewportHeight())
                vulkan:SetViewport(GetViewportX(), GetViewportY(), GetViewportWidth(), GetViewportHeight())
            end
        end

        // Moves are usually handed to the tree while collisions are found.
        // This catches any left, such as when the game has collisions off.
        UpdateRenderTree()

        painter:Begin()
        frame = frame + 1
found:SetCamera(camera)
        found:SetFrame(frame)
        found:SetSearchCount(0)
        found:Empty()
        
        renderTree:CollectVisible(camera, found)

        if painter is VulkanPainter3D
            CollectShadowCasters()
        end

        DrawFound(painter, found:GetInvisible())
        DrawFound(painter, found:GetVisible())

        painter:End()
        renderTree:EndFrame()
    end
    
    /* This action returns the percent of items that were culled in the frustrum on the last frame
of animation. The number returned is between 0 (no culling) and 1 (Everything is culled).

Attribute: Returns The percent of items culled in the last frame of animation. */
    action GetCullPercentage returns number
        if found = undefined
            return 0.0
        end
        Array<Item3D> visible = found:GetVisible()
        Array<Item3D> invisible = found:GetInvisible()
        integer size = 0
        if visible not= undefined
            size = size + visible:GetSize()
        end
        if invisible not= undefined
            size = size + invisible:GetSize()
        end
        
        integer total = 0
        if renderTree not= undefined
            total = renderTree:GetSize()
        end
        
        if total = 0
            return 0.0
        end
        number result = cast(number, total - size) / cast(number, total)
        return result
    end
    
    /*
    This action draws each found item that has not been drawn yet this
    frame. Drawing an item draws its children too. Transparent models the
    camera can see are set aside, to be drawn last by DrawTransparent.

    Attribute: Parameter painter The layer's painter.
    Attribute: The array to draw
    */
    private action DrawFound(Painter3D painter, Array<Item3D> items)
        integer i = 0
        repeat while i < items:GetSize()
            Item3D item = items:Get(i)
            item:Draw(painter)
            i = i + 1
        end
    end

    /*
    This action returns the render tree the layer uses to find what to draw.
    It holds every item added to the layer.

    Attribute: Returns The layer's render tree.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.Trees.RenderTree3D

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            Layer3D layer = GetCurrentLayer3D()
            RenderTree3D tree = layer:GetRenderTree()
            output tree:GetSize()
        end
    end
    */
    action GetRenderTree returns RenderTree3D
        return renderTree
    end

    /*
    This action changes the kind of render tree the layer uses to find what
    to draw, such as to a QuadTree3D or an Octree3D, which can be faster for
    a large, flat world. Every item on the layer is moved into the new tree,
    and the old tree is emptied. The new tree should be empty to begin with.

    Attribute: Parameter tree The render tree to use.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.Trees.QuadTree3D

    class Main is Game
        action Main
            StartGame()
        end

        action CreateGame
            QuadTree3D tree
            tree:SetRegion(-100, -10, -100, 100, 50, 100)
            Layer3D layer = GetCurrentLayer3D()
            layer:SetRenderTree(tree)
        end
    end
    */
    action SetRenderTree(RenderTree3D tree)
        if tree = undefined or tree = renderTree
            return now
        end

        RenderTree3D oldTree = renderTree
        renderTree = tree
        RenderTreeNode3D leaf = oldTree:GetFirstLeaf()
        repeat while leaf not= undefined
            AddToRenderTree(leaf:GetItem())
            leaf = oldTree:GetNextLeaf(leaf)
        end
        oldTree:Empty()
    end

    /*
    This action will set the camera being used by this Layer. The camera is used
    to determine what will be drawn on the screen. Objects will be drawn on the
    screen as they are seen by the Layer's set camera.

    Attribute: Parameter cam The camera that this layer should use.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.PerspectiveCamera

    class Main is Game

        action Main
            StartGame()
        end

        action CreateGame
            PerspectiveCamera camera
            Layer3D layer
            layer:SetCamera(camera)
            AddLayer(layer)
        end

        action Update(number seconds)
        end
    end

    */
    action SetCamera(Camera cam)
        camera = cam
Painter3D painter = GetPainter()
        painter:SetCamera(camera)
    end

    /*
    This action will return the camera being used by this Layer. The camera is used
    to determine what will be drawn on the screen. Objects will be drawn on the
    screen as they are seen by the Layer's set camera.

    Attribute: Returns The camera currently being used by this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Game.Graphics.Camera

    class Main is Game

        Camera layerCamera = undefined

        action Main
            StartGame()
        end

        action CreateGame
            Layer3D layer
            layerCamera = layer:GetCamera()
            AddLayer(layer)
        end

        action Update(number seconds)
        end
    end
    */
    action GetCamera returns Camera
        return camera
    end

    /*
    This action will notify mouse listeners that are a part of this layer of the
    given mouse event. This is called automatically by the Game engine as 
    needed. Most users will never need to use this action directly.

    Attribute: Parameter event The MouseEvent to send to the MouseListeners.
    Attribute: Returns The Item which intercepted the event, or undefined if no Item received the event.
    */
    action ProcessMouseEvent(MouseEvent event) returns Item
        Ray ray = camera:GetPickRay(event:GetX(), event:GetY())
        Vector3 origin = ray:GetOrigin()

        integer counter = 0
        Item3D temp = undefined
        Item result = undefined

        /*
        TO-DO: This array of all items is regenerated for each mouse event
        processed. It would be more efficient to maintain this array
        independently of this action.
        */
        Array<Item3D> allItems
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            GetChildrenHierarchy(leaf:GetItem(), allItems)
            leaf = renderTree:GetNextLeaf(leaf)
        end
        counter = 0

        repeat allItems:GetSize() times
            temp = allItems:Get(counter)
            if RayIntersectsItem(ray, temp)
                eventTargetArray:Add(temp)
            end

            counter = counter + 1
        end

        boolean processing = true

        if eventTargetArray:GetSize() not= 0
            depthSorter:SetOrigin(origin)
            eventTargetArray:Sort(depthSorter)
            counter = 0
            repeat while processing and counter < eventTargetArray:GetSize()
                event:SetSource(eventTargetArray:Get(counter))
                eventTargetArray:Get(counter):ProcessMouseEvent(event)
                processing = not event:WasEventHandled()
                if event:WasEventHandled()
                    result = eventTargetArray:Get(counter)
                end
                counter = counter + 1
            end

            eventTargetArray:Empty()
        end

        if processing
            if event:eventType = event:MOVED_MOUSE
                if mouseMovementListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat mouseMovementListeners:GetSize() times
                        mouseMovementListeners:Get(counter):MovedMouse(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:DRAGGED_MOUSE
                if mouseMovementListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat mouseMovementListeners:GetSize() times
                        mouseMovementListeners:Get(counter):DraggedMouse(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:CLICKED_MOUSE
                if mouseListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat mouseListeners:GetSize() times
                        mouseListeners:Get(counter):ClickedMouse(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:RELEASED_MOUSE
                if mouseListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat mouseListeners:GetSize() times
                        mouseListeners:Get(counter):ReleasedMouse(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:SCROLLED_MOUSE
                if mouseWheelListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat mouseWheelListeners:GetSize() times
                        mouseWheelListeners:Get(counter):ScrolledMouse(event)
                        counter = counter + 1
                    end
                end
            end
        end

        if event:GetSource() not= undefined and event:eventType = event:CLICKED_MOUSE
            event:GetSource():Focus()
        end

        return result
    end

    /*
    This action finds an Item on this layer which is present at the given coordinates
    and will respond to at least one of the given InputSets.
    */
    action GetItemWithInput(number x, number y, Array<InputSet> inputValues) returns Item
        Ray ray = camera:GetPickRay(x, y)
        Vector3 origin = ray:GetOrigin()

        integer counter = 0
        Game game = manager:GetGame()

        /*
        TO-DO: This array of all items is regenerated for each mouse event
        processed. It would be more efficient to maintain this array
        independently of this action.
        */
        Array<Item3D> allItems
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            GetChildrenHierarchy(leaf:GetItem(), allItems)
            leaf = renderTree:GetNextLeaf(leaf)
        end
        counter = 0

        repeat allItems:GetSize() times
            Item3D temp = allItems:Get(counter)
            if RayIntersectsItem(ray, temp)
                eventTargetArray:Add(temp)
            end

            counter = counter + 1
        end

        if eventTargetArray:GetSize() not= 0
            depthSorter:SetOrigin(origin)
            eventTargetArray:Sort(depthSorter)
            counter = 0
            repeat while counter < eventTargetArray:GetSize()
                Item3D item = eventTargetArray:Get(counter)
                InputTable table = game:GetInputTable(item:GetInputGroup())
                if table not= undefined
                    integer i = 0
                    repeat while i < inputValues:GetSize()
                        if table:HasKey(inputValues:Get(i))
                            return item
                        end
                        i = i + 1
                    end
                end
                counter = counter + 1
            end

            eventTargetArray:Empty()
        end

        return undefined
    end

    /*
    This action will notify touch listeners that are a part of this layer of the
    given touch event. This is called automatically by the Game engine as 
    needed. Most users will never need to use this action directly.

    Attribute: Parameter event The TouchEvent to send to the TouchListeners.
    */
    action ProcessTouchEvent(TouchEvent event) returns Item
        if event:GetX() < GetViewportX() or (event:GetX() > GetViewportX() + GetViewportWidth())
            or event:GetY() < GetViewportY() or (event:GetY() > GetViewportY() + GetViewportHeight())
            
            return undefined
        end

        Ray ray = camera:GetPickRay(event:GetX(), event:GetY())
        Vector3 origin = ray:GetOrigin()

        integer counter = 0
        Item3D temp = undefined
        Item result = undefined

        /*
        TO-DO: This array of all items is regenerated for each mouse event
        processed. It would be more efficient to maintain this array
        independently of this action.
        */
        Array<Item3D> allItems
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            GetChildrenHierarchy(leaf:GetItem(), allItems)
            leaf = renderTree:GetNextLeaf(leaf)
        end
        counter = 0

        repeat allItems:GetSize() times
            temp = allItems:Get(counter)
            if RayIntersectsItem(ray, temp)
                eventTargetArray:Add(temp)
            end

            counter = counter + 1
        end

        boolean processing = true

        if eventTargetArray:GetSize() not= 0
            depthSorter:SetOrigin(origin)
            eventTargetArray:Sort(depthSorter)
            counter = 0
            repeat while processing and counter < eventTargetArray:GetSize()
                event:SetSource(eventTargetArray:Get(counter))
                eventTargetArray:Get(counter):ProcessTouchEvent(event)
                processing = not event:WasEventHandled()
                if event:WasEventHandled()
                    result = eventTargetArray:Get(counter)
                end
                counter = counter + 1
            end

            eventTargetArray:Empty()
        end

        if processing

            if event:eventType = event:MOVED or event:eventType = event:STATIONARY
                if touchListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat touchListeners:GetSize() times
                        touchListeners:Get(counter):ContinuedTouch(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:BEGAN
                if touchListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat touchListeners:GetSize() times
                        touchListeners:Get(counter):BeganTouch(event)
                        counter = counter + 1
                    end
                end

            elseif event:eventType = event:ENDED or event:eventType = event:CANCELLED
                if touchListeners:GetSize() > 0
                    counter = 0
                    event:SetEventHandled(true)
                    repeat touchListeners:GetSize() times
                        touchListeners:Get(counter):EndedTouch(event)
                        counter = counter + 1
                    end
                end

            end

        end

        if event:GetSource() not= undefined and event:eventType = event:BEGAN
            event:GetSource():Focus()
        end

        return result
    end

    /*
    This action will notify gesture listeners that are a part of this layer of the
    given gesture event. This is called automatically by the Game engine as 
    needed. Most users will never need to use this action directly.

    Attribute: Parameter event The GestureEvent to send to the GestureListeners.
    */
    action ProcessGestureEvent(GestureEvent event) returns Item
        if event:GetX() < GetViewportX() or (event:GetX() > GetViewportX() + GetViewportWidth())
            or event:GetY() < GetViewportY() or (event:GetY() > GetViewportY() + GetViewportHeight())
            
            return undefined
        end

        Ray ray = camera:GetPickRay(event:GetX(), event:GetY())
        Vector3 origin = ray:GetOrigin()

        integer counter = 0
        Item3D temp = undefined
        Item result = undefined

        /*
        TO-DO: This array of all items is regenerated for each mouse event
        processed. It would be more efficient to maintain this array
        independently of this action.
        */
        Array<Item3D> allItems
        RenderTreeNode3D leaf = renderTree:GetFirstLeaf()
        repeat while leaf not= undefined
            GetChildrenHierarchy(leaf:GetItem(), allItems)
            leaf = renderTree:GetNextLeaf(leaf)
        end
        counter = 0

        repeat allItems:GetSize() times
            temp = allItems:Get(counter)
            if RayIntersectsItem(ray, temp)
                eventTargetArray:Add(temp)
            end

            counter = counter + 1
        end

        boolean processing = true

        if eventTargetArray:GetSize() not= 0
            depthSorter:SetOrigin(origin)
            eventTargetArray:Sort(depthSorter)
            counter = 0
            repeat while processing and counter < eventTargetArray:GetSize()
                event:SetSource(eventTargetArray:Get(counter))
                eventTargetArray:Get(counter):ProcessGestureEvent(event)
                processing = not event:WasEventHandled()
                if event:WasEventHandled()
                    result = eventTargetArray:Get(counter)
                end
                counter = counter + 1
            end

            eventTargetArray:Empty()
        end

        if processing and gestureListeners:IsEmpty() = false
            counter = 0
            event:SetEventHandled(true)

            if event:eventType = event:SINGLE_TAP
                repeat gestureListeners:GetSize() times
                    gestureListeners:Get(counter):OnSingleTap(event)
                    counter = counter + 1
                end
            elseif event:eventType = event:DOUBLE_TAP
                repeat gestureListeners:GetSize() times
                    gestureListeners:Get(counter):OnDoubleTap(event)
                    counter = counter + 1
                end
            elseif event:eventType = event:SWIPE
                repeat gestureListeners:GetSize() times
                    gestureListeners:Get(counter):OnSwipe(event)
                    counter = counter + 1
                end
            elseif event:eventType = event:PAN
                repeat gestureListeners:GetSize() times
                    gestureListeners:Get(counter):OnPan(event)
                    counter = counter + 1
                end
            elseif event:eventType = event:LONG_PRESS
                if event:timingCode = event:BEGIN
                    repeat gestureListeners:GetSize() times
                        gestureListeners:Get(counter):OnLongPressBegin(event)
                        counter = counter + 1
                    end
                elseif event:timingCode = event:FINISH
                    repeat gestureListeners:GetSize() times
                        gestureListeners:Get(counter):OnLongPressEnd(event)
                        counter = counter + 1
                    end
                end
            elseif event:eventType = event:PINCH
                if event:timingCode = event:BEGIN
                    repeat gestureListeners:GetSize() times
                        gestureListeners:Get(counter):OnPinchBegin(event)
                        counter = counter + 1
                    end
                elseif event:timingCode = event:CONTINUE
                    repeat gestureListeners:GetSize() times
                        gestureListeners:Get(counter):OnPinchContinue(event)
                        counter = counter + 1
                    end
                elseif event:timingCode = event:FINISH
                    repeat gestureListeners:GetSize() times
                        gestureListeners:Get(counter):OnPinchEnd(event)
                        counter = counter + 1
                    end
                end
            end
        end

        return result
    end

    /*
    This action recursively finds all children in the hierarchy of the given
    Item3D. The found items are appended to the provided array. The provided
    Item3D is also automatically added to the array.
    */
    private action GetChildrenHierarchy(Item3D item, Array<Item3D> array)
        array:Add(item)
        integer counter = 0
        repeat item:GetItemCount() times
            GetChildrenHierarchy(item:GetItem(counter), array)
            counter = counter + 1
        end
    end

    /*
    This action adds an item to the rendering tree, with the box its
    GetRenderBounds action gives. An item with no box is added with a box
    of no size at its own position, so every item is in the tree.

    Attribute: Parameter item The item to add.
    */
    private action AddToRenderTree(Item3D item)
        if renderTree:Has(item)
            return now
        end
        if not renderTree:Add(item)
            renderTree:Add(item, emptyBounds)
        end
    end

    /*
    This action puts an item with physics in the awake or sleeping tree, by
    whether physics is simulating it. An item already in either is left
    where it is.

    Attribute: Parameter item The item.
    */
    private action AddBody(Item3D item)
        if awakeBodies:Has(item) or sleepingBodies:Has(item)
            return now
        end
        if item:IsSimulated()
            AddToPhysicsTree(awakeBodies, item)
        else
            AddToPhysicsTree(sleepingBodies, item)
        end
    end

    /*
    This action takes an item out of both physics trees.

    Attribute: Parameter item The item.
    */
    private action RemoveBody(Item3D item)
        awakeBodies:Remove(item)
        sleepingBodies:Remove(item)
    end

    /*
    This action adds an item to one of the physics trees. The trees only
    hold the bodies, so an item with no box is added with a box of no size.

    Attribute: Parameter tree The awake or sleeping tree.
    Attribute: Parameter item The item.
    */
    private action AddToPhysicsTree(RenderTree3D tree, Item3D item)
        if not tree:Add(item)
            tree:Add(item, emptyBounds)
        end
    end

    /*
    This action moves each body that woke or fell asleep into the physics
    tree that matches whether physics is simulating it now. A body that
    changed more than once ends up where its last change put it. Bodies that
    are in neither tree, such as children with physics, are left alone.
    */
    private action MoveChangedBodies
        integer i = 0
        repeat while i < changedBodies:GetSize()
            Item3D body = changedBodies:Get(i)
            if body:IsPhysicsEnabled()
                if body:IsSimulated()
                    if sleepingBodies:Remove(body)
                        AddToPhysicsTree(awakeBodies, body)
                    end
                else
                    if awakeBodies:Remove(body)
                        AddToPhysicsTree(sleepingBodies, body)
                    end
                end
            end
            i = i + 1
        end
        changedBodies:Empty(false)
    end

    /*
    This action notes that a body was put in a group this step, so its group
    flag is cleared next step and its collision box is moved after this
    step. Unmovable bodies, such as terrain, are left out. Their flag is
    cleared right after each group is solved, so they can join many groups
    in one step, and they do not move.

    Attribute: Parameter body The body put in a group.
    */
    private action AddToGrouped(Item3D body)
        if not body:IsUnmovable()
            grouped:Add(body)
        end
    end

    /*
    This action brings the collision boxes of the items that reported a
    move up to date: those without physics, and bodies marked as moved, as
    when their position is set. Awake bodies moved by physics were brought
    up to date after each physics step. An item that has left the layer is
    skipped.
    */
    private action SynchronizeMovedItems
        integer i = 0
        repeat while i < movedItems:GetSize()
            Item3D item = movedItems:Get(i)
            if item:GetLayer() = me
                if not item:IsPhysicsEnabled()
                    item:SynchronizeNodes()
                elseif item:HasMoved()
                    item:SynchronizeNodes()
                end
            end
            i = i + 1
        end
    end

    /*
    This action tells the rendering tree about every item that reported a
    move, so the tree knows where it is now. Each item's report is cleared,
    so it reports its next move, and the list is emptied. A child, or an
    item that has left the layer, is not in the tree and is skipped by it.
    */
    private action UpdateRenderTree
        integer i = 0
        repeat while i < movedItems:GetSize()
            Item3D item = movedItems:Get(i)
            renderTree:Moved(item)
            item:SetReportedMove(false)
            i = i + 1
        end
        movedItems:Empty(false)
    end

    /*
    This action adds to the found items every item that could cast a shadow
    into view: for each directional light, those its CollectDirectionalShadowCasters
    search finds, which uses the light's culling range, and for each point
    light, those within its reach.
    */
    private action CollectShadowCasters
        Iterator<DirectionalLight> directionalLights = GetDirectionalLights()
        repeat while directionalLights:HasNext()
            renderTree:CollectDirectionalShadowCasters(directionalLights:Next(), camera, found)
        end

        Iterator<PointLight> pointLights = GetPointLights()
        repeat while pointLights:HasNext()
            renderTree:CollectPointShadowCasters(pointLights:Next(), found)
        end
    end

    /*
    This action returns true if an item could cast a shadow. Only a model
    can be told not to, with SetCastsShadows. Any other item might have
    models among its children, so it is drawn.

    Attribute: Parameter item The item.
    Attribute: Returns False if the item is a model that casts no shadow.
    */
    private action CastsShadows(Item3D item) returns boolean
        if item is Model
            Model model = cast(Model, item)
            return model:CastsShadows()
        end
        return true
    end

    /*
    This action returns true if an item is a model with transparency, so it
    must be drawn after the models behind it.

    Attribute: Parameter item The item.
    Attribute: Returns True if the item is a transparent model.
    */
    private action IsTransparent(Item3D item) returns boolean
        if item is Model
            Model model = cast(Model, item)
            return model:HasTransparency()
        end
        return false
    end


    /*
    This action will test if the given ray intersects with an Item3D. This
    intersection is tested using the base, axis-aligned dimensions of the item.
    It will not properly reflect changes made due to scaling or rotation, and
    assumes the Item is a box-like shape.
    */
    private action RayIntersectsItem(Ray ray, Item3D item) returns boolean
        number divX = 1.0 / ray:GetDirection():GetX()
        number divY = 1.0 / ray:GetDirection():GetY()
        number divZ = 1.0 / ray:GetDirection():GetZ()

        number minX = ((item:GetGlobalX() - item:GetWidth() * 0.5) - ray:GetOrigin():GetX()) * divX
        number maxX = ((item:GetGlobalX() + item:GetWidth() * 0.5) - ray:GetOrigin():GetX()) * divX
        
        if minX > maxX
            number temp = minX
            minX = maxX
            maxX = temp
        end

        number minY = ((item:GetGlobalY() - item:GetHeight() * 0.5) - ray:GetOrigin():GetY()) * divY
        number maxY = ((item:GetGlobalY() + item:GetHeight() * 0.5) - ray:GetOrigin():GetY()) * divY

        if minY > maxY
            number temp = minY
            minY = maxY
            maxY = temp
        end

        number minZ = ((item:GetGlobalZ() - item:GetDepth() * 0.5) - ray:GetOrigin():GetZ()) * divZ
        number maxZ = ((item:GetGlobalZ() + item:GetDepth() * 0.5) - ray:GetOrigin():GetZ()) * divZ

        if minZ > maxZ
            number temp = minZ
            minZ = maxZ
            maxZ = temp
        end

        number min = minX
        if minY > min
            min = minY
        end
        if minZ > min
            min = minZ
        end

        number max = maxX
        if maxY < max
            max = maxY
        end
        if maxZ < max
            max = maxZ
        end

        return max >= 0 and max >= min
    end

    /*
    This action will add a MouseListener to the layer. When the layer receives a
    mouse event, it will first try to find the topmost item which can handle the
    event. If the event is not handled, then all MouseListeners in the layer 
    will receive the event.

    Attribute: Parameter listener The MouseListener to add to this layer.

    Attribute: Example

    use Libraries.Game.Game
    use Libraries.Game.Layer3D
    use Libraries.Interface.Events.MouseListener

    class Main is Game

        // For most programs, this should be replaced with 
        // a custom class inheriting from MouseListener.
        MouseListener myListener

