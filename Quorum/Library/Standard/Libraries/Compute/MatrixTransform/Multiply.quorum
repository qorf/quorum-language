package Libraries.Compute.MatrixTransform

use Libraries.Compute.MatrixTransform.MatrixTransform
use Libraries.Compute.Matrix
use Libraries.Containers.Array
use Libraries.Containers.Number64BitArray
use Libraries.Game.GameStateManager
use Libraries.Compute.Hardware.HardwareCompute
use Libraries.Compute.Hardware.HardwareComputeDevice
use Libraries.Compute.Hardware.HardwareComputeLimits
use Libraries.Compute.Hardware.Shaders.MatrixMultiplyShaderCode
use Libraries.System.Logging.SharedLogger

    /*
        This is a MatrixTransform class to perform a matrix multiply operation on two matrices.

        Transform multiplies on the CPU. TransformInHardware multiplies on
        the graphics card (GameStateManager:GetComputeDevice), with or
        without a game, and is much faster for large matrices: about 45
        times the CPU's speed at 2,048 x 2,048 on a recent Mac.

        Its answers equal Transform's, bit for bit, on every graphics card:
        numbers go to the card as the 64-bit numbers they are, and every
        add and multiply rounds as the CPU's does. How the card works with
        them depends on what it has (SetNumberMode; AUTOMATIC, the default,
        picks the first that fits):

            NUMBER_64              GLSL double: cards with 64-bit numbers.
            EMULATED_NUMBER_64     IEEE 754 worked out with 64-bit
                                   integers: cards with 64-bit integers,
                                   Apple's included.
            EMULATED_32_NUMBER_64  the same with 32-bit integers: every
                                   card.
            DOUBLE_NUMBER_32       two 32-bit numbers each, about 48 bits:
                                   only when asked for. Its answers agree
                                   with the CPU's to about 14 significant
                                   digits, and it can't hold numbers past
                                   about 1e38 or products below 1e-30.

        When there is no graphics card that can compute, or the matrices
        are too large for it, TransformInHardware multiplies on the CPU
        instead (RanInHardware says which), and logs why.

        The graphics card's program and memory are kept between calls, so
        keep one Multiply for many multiplies; Release lets them go.

        Attribute Returns A new matrix after the operation is performed.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(2, 3, 10.0)
                Matrix matrix2
                matrix2:Fill(3, 2, 2.0)
                Multiply multiply
                multiply:SetValue(matrix2)
                Matrix result = multiply:Transform(matrix)
                output result:ToText()
            end
        end
    */
class Multiply is MatrixTransform
    private Matrix values
    private integer metadata = 4
    private integer cutoffSingleSize = 80
    private integer hardwareCutoff = cutoffSingleSize * cutoffSingleSize * cutoffSingleSize
boolean forceSoftware = false

    // the graphics card: one computation, kept between calls
    HardwareCompute compute = undefined
    MatrixMultiplyShaderCode shaderCode = undefined
    boolean tiled = false
    integer requestedTileSize = 0
    integer tileSize = 16
    boolean ranInHardware = false

    /* Choose by the graphics card: the first of NUMBER_64, EMULATED_NUMBER_64 and EMULATED_32_NUMBER_64 it can run. */
    public constant integer AUTOMATIC = -1
    /* Two 32-bit numbers per number: about 14 digits; every graphics card. */
    public constant integer DOUBLE_NUMBER_32 = 0
    /* 64-bit numbers in GLSL double: the CPU's answers; cards with 64-bit numbers. */
    public constant integer NUMBER_64 = 1
    /* 64-bit numbers, IEEE 754 emulated with 64-bit integers: the CPU's answers; cards with 64-bit integers. */
    public constant integer EMULATED_NUMBER_64 = 2
    /* 64-bit numbers, IEEE 754 emulated with 32-bit integers: the CPU's answers; every graphics card. */
    public constant integer EMULATED_32_NUMBER_64 = 3

    integer numberMode = AUTOMATIC
    integer numberModeUsed = AUTOMATIC

    /*
        This method sets the a matrix of values for the transform function to apply.

        Attribute Parameter The value matrix to apply in the transform.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix2
                matrix2:Fill(3, 2, 2.0)
                Multiply multiply
                multiply:SetValue(matrix2)
                output multiply:GetValueMatrix():ToText()
            end
        end
    */
    action SetValue(Matrix values)
        me:values = values
    end

    /*
        This method gets the matrix of values that the transform function will apply.

        Attribute Parameter The value to apply in the transform.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix2
                matrix2:Fill(3, 2, 2.0)
                Multiply multiply
                multiply:SetValue(matrix2)
                output multiply:GetValueMatrix():ToText()
            end
        end
    */
    action GetValueMatrix returns Matrix
        return values
    end

    /*
        This is a MatrixTransform class to perform a matrix multiply operation on two matrices.

        Attribute Returns A new matrix after the operation is performed.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(2, 3, 10.0)
                Matrix matrix2
                matrix2:Fill(3, 2, 2.0)
                Multiply multiply
                multiply:SetValue(matrix2)
                Matrix result = multiply:Transform(matrix)
                output result:ToText()
            end
        end
    */
    action Transform(Matrix matrix) returns Matrix
return TransformInSoftware(matrix)
    end

    action TransformInSoftware(Matrix matrix) returns Matrix
Matrix newMatrix
        newMatrix:SetSize(matrix:GetRows(), values:GetColumns())
        row = 0
        repeat matrix:GetRows() times
            col = 0
            repeat values:GetColumns() times
                number sum = 0.0
                i = 0
                repeat matrix:GetColumns() times
                    sum = sum + matrix:Get(row,i) * values:Get(i,col)
                    i = i + 1
                end
                newMatrix:Set(row, col, sum)
                col = col + 1
            end
            row = row + 1
        end
        return newMatrix
    end

    /*
        This action multiplies matrix by the value matrix on the graphics
        card, in the number mode SetNumberMode says (AUTOMATIC, the
        default, gives Transform's answer bit for bit on every card). It
        uses the CPU instead (and logs why) when there is no graphics card
        that can compute, when the matrices don't fit the graphics card,
        when the mode asked for needs something the card doesn't have, or,
        with DOUBLE_NUMBER_32 only, when a number or product is too large
        or too small to hold as two 32-bit numbers.

        Attribute: Parameter matrix The matrix on the left.

        Attribute: Returns A new matrix: matrix times the value matrix.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(512, 512, 1.5)
                Multiply multiply
                multiply:SetValue(matrix)
                Matrix result = multiply:TransformInHardware(matrix)
                output result:Get(0, 0)
                multiply:Release()
            end
        end
    */
    action TransformInHardware(Matrix matrix) returns Matrix
        ranInHardware = false
        if values = undefined
            alert("Multiply needs the value matrix: call SetValue first.")
        end
        if matrix:GetColumns() not= values:GetRows()
            alert("A " + matrix:GetRows() + " x " + matrix:GetColumns() + " matrix can't be multiplied by a " + values:GetRows() + " x " + values:GetColumns() + " one: the columns of the first must equal the rows of the second.")
        end
        if compute = undefined
            GameStateManager manager
            HardwareComputeDevice device = manager:GetComputeDevice()
            if device = undefined
                return InSoftwareBecause(matrix, "no graphics card can compute")
            end
            compute = device:CreateCompute()
            if compute = undefined
                return InSoftwareBecause(matrix, "the graphics card has no queue that can compute")
            end
        end

        HardwareComputeLimits limits = compute:GetDevice():GetLimits()
        integer mode = ChooseNumberMode(limits)
        if mode = NUMBER_64 and not limits:HasNumber64()
            return InSoftwareBecause(matrix, "NUMBER_64 was asked for, but the graphics card has no 64-bit numbers")
        end
        if mode = EMULATED_NUMBER_64 and not limits:HasInteger64()
            return InSoftwareBecause(matrix, "EMULATED_NUMBER_64 was asked for, but the graphics card has no 64-bit integers")
        end
        if mode = DOUBLE_NUMBER_32
            text problem = CheckRange(matrix)
            if problem not= ""
                return InSoftwareBecause(matrix, problem)
            end
        end

        integer rows = matrix:GetRows()
        integer inner = matrix:GetColumns()
        integer columns = values:GetColumns()
        tileSize = ChooseTileSize(limits)
        integer groupsAcross = (rows + tileSize - 1) / tileSize
        integer groupsDown = (columns + tileSize - 1) / tileSize
        if groupsAcross > limits:GetMaxWorkGroupCount(0) or groupsDown > limits:GetMaxWorkGroupCount(1)
            return InSoftwareBecause(matrix, "the answer needs more work groups than the graphics card allows in one run")
        end

        // the buffer, in numbers: A, then B, then room for the answer,
        // each column by column
        integer placeB = matrix:GetSize()
        integer placeAnswer = placeB + values:GetSize()
        integer total = placeAnswer + rows * columns
        if total * 8.0 > limits:GetMaxDataBytes()
            return InSoftwareBecause(matrix, "the matrices are larger than the graphics card's largest block of data")
        end

        // made only for the graphics card, so multiplying in software never
        // creates shader code (Python has no graphics card support)
        if shaderCode = undefined
            MatrixMultiplyShaderCode code
            shaderCode = code
        end
        compute:SetRunIntegerCount(shaderCode:RUN_INTEGER_COUNT)
        // the same source is compiled once and kept
        text kind = "Plain"
        if tiled
            kind = "Tiled"
        end
        if mode = DOUBLE_NUMBER_32
            compute:SetProgram("MatrixMultiply" + kind + tileSize, shaderCode:GetCode(tiled, tileSize))
        else
            // the modes have the same values as MatrixMultiplyShaderCode's arithmetics
            compute:SetProgram("MatrixMultiply" + kind + tileSize + "Number64Mode" + mode, shaderCode:GetCode(tiled, tileSize, mode))
        end

        Number64BitArray numbers
        numbers:SetSize(total)
        FillNumbers(0, numbers, matrix)
        FillNumbers(placeB, numbers, values)
        if mode = DOUBLE_NUMBER_32
            compute:SetNumberFormat(compute:DOUBLE_NUMBER_32)
        else
            // the numbers as they are, 64 bits each
            compute:SetNumberFormat(compute:NUMBER_64)
        end
        compute:SetData(numbers)

        Array<integer> place
        place:Add(rows)
        place:Add(inner)
        place:Add(columns)
        place:Add(0)
        place:Add(placeB)
        place:Add(placeAnswer)
        compute:BeginRuns()
        compute:AddRun(groupsAcross, groupsDown, 1, place)
        compute:FinishRuns()

        Number64BitArray answer
        answer:SetSize(rows * columns)
        compute:GetValues(placeAnswer, answer)
        Matrix result
        result:SetSize(rows, columns)
        integer i = 0
        integer column = 0
        repeat while column < columns
            integer row = 0
            repeat while row < rows
                result:Set(row, column, answer:Get(i))
                row = row + 1
                i = i + 1
            end
            column = column + 1
        end
        ranInHardware = true
        numberModeUsed = mode
        return result
    end

    /*
        This action sets how TransformInHardware works with numbers on the
        graphics card. AUTOMATIC (the default) picks NUMBER_64 if the card
        has 64-bit numbers, otherwise EMULATED_NUMBER_64 if it has 64-bit
        integers, otherwise EMULATED_32_NUMBER_64: all three give
        Transform's answer bit for bit. DOUBLE_NUMBER_32 gives about 14
        digits and is used only when set here. A mode the card can't run
        (NUMBER_64 without 64-bit numbers, EMULATED_NUMBER_64 without
        64-bit integers) makes TransformInHardware use the CPU, and log
        why.

        Attribute: Parameter mode AUTOMATIC, DOUBLE_NUMBER_32, NUMBER_64, EMULATED_NUMBER_64 or EMULATED_32_NUMBER_64.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                multiply:SetNumberMode(multiply:EMULATED_32_NUMBER_64)
            end
        end
    */
    action SetNumberMode(integer mode)
        if mode < AUTOMATIC or mode > EMULATED_32_NUMBER_64
            alert("Multiply's number mode needs to be AUTOMATIC, DOUBLE_NUMBER_32, NUMBER_64, EMULATED_NUMBER_64 or EMULATED_32_NUMBER_64, not " + mode + ".")
        end
        numberMode = mode
    end

    /*
        This action returns the number mode set by SetNumberMode: AUTOMATIC
        unless one was set.

        Attribute: Returns AUTOMATIC, DOUBLE_NUMBER_32, NUMBER_64, EMULATED_NUMBER_64 or EMULATED_32_NUMBER_64.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                output multiply:GetNumberMode()
            end
        end
    */
    action GetNumberMode returns integer
        return numberMode
    end

    /*
        This action returns the number mode the last TransformInHardware
        that ran on the graphics card used, after AUTOMATIC chose one:
        AUTOMATIC if none has run there yet.

        Attribute: Returns DOUBLE_NUMBER_32, NUMBER_64, EMULATED_NUMBER_64, EMULATED_32_NUMBER_64, or AUTOMATIC if none has run.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(64, 64, 2.0)
                Multiply multiply
                multiply:SetValue(matrix)
                Matrix result = multiply:TransformInHardware(matrix)
                if multiply:RanInHardware()
                    output multiply:GetNumberModeUsed()
                end
            end
        end
    */
    action GetNumberModeUsed returns integer
        return numberModeUsed
    end

    // The mode set, or with AUTOMATIC the first exact one the card can run.
    private action ChooseNumberMode(HardwareComputeLimits limits) returns integer
        if numberMode not= AUTOMATIC
            return numberMode
        end
        if limits:HasNumber64()
            return NUMBER_64
        elseif limits:HasInteger64()
            return EMULATED_NUMBER_64
        end
        return EMULATED_32_NUMBER_64
    end

    /*
        This action says whether the last TransformInHardware ran on the
        graphics card, or fell back to the CPU.

        Attribute: Returns true if the graphics card did the last multiply.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(64, 64, 2.0)
                Multiply multiply
                multiply:SetValue(matrix)
                Matrix result = multiply:TransformInHardware(matrix)
                output multiply:RanInHardware()
            end
        end
    */
    action RanInHardware returns boolean
        return ranInHardware
    end

    /*
        This action chooses how TransformInHardware divides the work: true
        loads tiles of both matrices into each work group's shared memory,
        which is faster from about 1,024 x 1,024 up; false (the default)
        reads from memory directly, which is as fast or faster for smaller
        matrices.

        Attribute: Parameter yes true to use tiles.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                multiply:SetTiled(true)
            end
        end
    */
    action SetTiled(boolean yes)
        tiled = yes
    end

    /*
        This action says whether TransformInHardware uses tiles.

        Attribute: Returns true if it uses tiles.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                output multiply:IsTiled()
            end
        end
    */
    action IsTiled returns boolean
        return tiled
    end

    /*
        This action sets the width and height of TransformInHardware's work
        groups. It is halved until the graphics card allows it. 0, the
        default, picks 16.

        Attribute: Parameter size The width and height, or 0 for the default.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                multiply:SetTileSize(32)
            end
        end
    */
    action SetTileSize(integer size)
        if size < 0
            alert("A tile size needs to be 0 (the default) or more, not " + size + ".")
        end
        requestedTileSize = size
    end

    /*
        This action returns the work group width and height the last
        TransformInHardware used.

        Attribute: Returns The tile size.

        Attribute: Example

        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Multiply multiply
                output multiply:GetTileSize()
            end
        end
    */
    action GetTileSize returns integer
        return tileSize
    end

    /*
        This action lets go of what TransformInHardware keeps on the
        graphics card between calls: its program, memory and commands. The
        next call makes them again. The graphics card itself is the
        program's and stays.

        Attribute: Example

        use Libraries.Compute.Matrix
        use Libraries.Compute.MatrixTransform.Multiply

        class Main
            action Main
                Matrix matrix
                matrix:Fill(64, 64, 2.0)
                Multiply multiply
                multiply:SetValue(matrix)
                Matrix result = multiply:TransformInHardware(matrix)
                multiply:Release()
            end
        end
    */
    action Release
        if compute not= undefined
            compute:Dispose()
        end
        compute = undefined
    end

    // The CPU's answer, logging why the graphics card wasn't used.
    private action InSoftwareBecause(Matrix matrix, text reason) returns Matrix
        SharedLogger logger
        logger:Log("Multiply:TransformInHardware used the CPU: " + reason + ".")
        return TransformInSoftware(matrix)
    end

    /*
    Why the numbers can't be held as two 32-bit numbers each, or "" if they
    can: a number, or the largest possible sum, past about 3.4e38; or the
    smallest product so small that its low part would lose precision.
    */
    private action CheckRange(Matrix matrix) returns text
        number largestA = LargestMagnitude(matrix)
        number largestB = LargestMagnitude(values)
        if largestA > 1.0e38 or largestB > 1.0e38
            return "a number is too large to hold as two 32-bit numbers"
        end
        if largestA * largestB * matrix:GetColumns() > 1.0e38
            return "a product or sum could pass the largest 32-bit number"
        end
        number smallestA = SmallestMagnitude(matrix)
        number smallestB = SmallestMagnitude(values)
        if smallestA > 0 and smallestB > 0 and smallestA * smallestB < 1.0e-30
            return "a product could be too small to hold as two 32-bit numbers"
        end
        return ""
    end

    private action LargestMagnitude(Matrix matrix) returns number
        number largest = 0
        integer row = 0
        repeat while row < matrix:GetRows()
            integer column = 0
            repeat while column < matrix:GetColumns()
                number value = matrix:Get(row, column)
                if value < 0
                    value = -value
                end
                if value > largest
                    largest = value
                end
                column = column + 1
            end
            row = row + 1
        end
        return largest
    end

    // The smallest number that isn't zero, ignoring sign; 0 if all are zero.
    private action SmallestMagnitude(Matrix matrix) returns number
        number smallest = 0
        integer row = 0
        repeat while row < matrix:GetRows()
            integer column = 0
            repeat while column < matrix:GetColumns()
                number value = matrix:Get(row, column)
                if value < 0
                    value = -value
                end
                if value > 0 and (smallest = 0 or value < smallest)
                    smallest = value
                end
                column = column + 1
            end
            row = row + 1
        end
        return smallest
    end

    // The tile size asked for (or 16), halved until the device allows it.
    private action ChooseTileSize(HardwareComputeLimits limits) returns integer
        integer size = requestedTileSize
        if size = 0
            size = 16
        end
        repeat while size > 1 and not Fits(size, limits)
            size = size / 2
        end
        return size
    end

    private action Fits(integer size, HardwareComputeLimits limits) returns boolean
        if size * size > limits:GetMaxWorkGroupThreads()
            return false
        end
        if size > limits:GetMaxWorkGroupSize(0) or size > limits:GetMaxWorkGroupSize(1)
            return false
        end
        if tiled and 2 * size * size * 8 > limits:GetMaxSharedMemoryBytes()
            return false
        end
        return true
    end

    // A matrix into the numbers from place on, column by column.
    private action FillNumbers(integer place, Number64BitArray numbers, Matrix matrix)
        integer i = place
        integer column = 0
        repeat while column < matrix:GetColumns()
            integer row = 0
            repeat while row < matrix:GetRows()
                numbers:Set(i, matrix:Get(row, column))
                row = row + 1
                i = i + 1
            end
            column = column + 1
        end
    end

action CalculateBufferSize(Matrix matrix1, Matrix matrix2) returns integer
        integer size1 = matrix1:GetSize()
integer size2 = matrix2:GetSize()
        integer size3 = matrix1:GetRows() * matrix2:GetColumns()

        //4 positions in the buffer for constants
        return (size1 + size2 + size3) * 2
    end

    action GetHardwareCutoff returns integer
        return hardwareCutoff
    end

    action SetHardwareCutoff(integer hardwareCutoff)
        me:hardwareCutoff = hardwareCutoff
    end

end
