package Libraries.Compute.Statistics.Design.Variables


class NumericalVariable is DesignVariable

    on create
        parent:DesignVariable:variableType = parent:DesignVariable:NUMERICAL
    end

    action SetToInput(text columnName)
        parent:DesignVariable:variableRole = parent:DesignVariable:INPUT
        parent:DesignVariable:columnName = columnName
    end

    action SetToOutput(text columnName)
        parent:DesignVariable:variableRole = parent:DesignVariable:OUTPUT
        parent:DesignVariable:columnName = columnName
    end

    action SetToControl(text columnName)
        parent:DesignVariable:variableRole = parent:DesignVariable:CONTROL
        parent:DesignVariable:columnName = columnName
    end

end