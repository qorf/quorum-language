package Libraries.Language.Compile.Test

use Libraries.Language.Compile.all
use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Language.Compile.Parser
use Libraries.System.File
use Libraries.Containers.Iterator
use Libraries.Language.Compile.Translate.JarGenerator
use Libraries.System.StackTraceItem

/*
    Note that the compression libraries are not supported in JavaScript mode. Therefore the tests are not
    included in the test suite.
*/
class DecompresserTester
    CompilerTestSuite suite = undefined
    text path = "Library/Tests/Decompresser/"
    text passPath = path + "Pass/"
    text failPath = path + "Fail/"

    action Test
        path = passPath
        DecompressGZip()
        DecompressZip()
        HasZipEntry()
        ReadZipEntry()
        ReadZipEntryErrors()

//FAIL TESTS
        path = failPath
    end

    action GetName returns text
        return "Decompresser Tests"
    end

    action GetCompilerTestSuite returns CompilerTestSuite
        return suite
    end

    action SetCompilerTestSuite(CompilerTestSuite suite)
        me:suite = suite
    end

    action DecompressGZip
        Array<File> files
        Array<text> results
        File main
        main:SetPath(path + "DecompressGZip.quorum")
        files:Add(main)
        results:Add(0, "success")
        suite:Test(files, results)
        //suite:TestJavaScript(files, results)
    end

    action DecompressZip
        Array<File> files
        Array<text> results
        File main
        main:SetPath(path + "DecompressZip.quorum")
        files:Add(main)
        results:Add(0, "success")
        suite:Test(files, results)
        //suite:TestJavaScript(files, results)
    end

    action HasZipEntry
        Array<File> files
        Array<text> results
        File main
        main:SetPath(path + "HasZipEntry.quorum")
        files:Add(main) 
        results:Add(0, "true")
        results:Add(1, "false")
        suite:Test(files, results)
        //suite:TestJavaScript(files, results)
    end

    action ReadZipEntry
        Array<File> files
        Array<text> results
        File main
        main:SetPath(path + "ReadZipEntry.quorum")
        files:Add(main)
        results:Add(0, "This is a test file for Quorum's Decompresser library. This file was ziped.")
        results:Add(1, "inside a folder")
        suite:Test(files, results)
    end

    action ReadZipEntryErrors
        Array<File> files
        Array<text> results
        File main
        main:SetPath(path + "ReadZipEntryErrors.quorum")
        files:Add(main)
        results:Add(0, "missing entry")
        results:Add(1, "missing archive")
        results:Add(2, "not a ZIP archive")
        suite:Test(files, results)
    end
end
