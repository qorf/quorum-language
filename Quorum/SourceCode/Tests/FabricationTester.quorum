package Libraries.Language.Compile.Test

use Libraries.Containers.Array
use Libraries.System.File

/*
Tests Libraries.Fabrication. Like DataFormatsTester, each test is a small
program in Library/Tests/Fabrication/Pass that the suite compiles against the
repository's standard library, runs, and checks line by line against the
expected output. Programs that build models, read G-code or write scratch
files also compile the helper classes they use from
Library/Tests/Fabrication/Support.

Each check prints one line: "what: true" when a condition holds, the value
itself for a count or a text, and for a measurement "true" when it is close
enough or the number it got when it isn't. Checks over many items print what
was wrong, so a passing line ends at the colon.

Bytecode only: the tests read and write files.
*/
class FabricationTester
    CompilerTestSuite suite = undefined
    text path = "Library/Tests/Fabrication/"
    text passPath = path + "Pass/"
    text supportPath = path + "Support/"

    action Test
        TestArgumentChecker()
        TestContour()
        TestPathRole()
        TestGeometryUtilities()
        TestContourLayers()
        TestContourSimplifier()
        TestConvexHull()
        TestLineFill()
        TestPolygonOperations()
        TestPolygonOffsetter()
        TestTriangleMesh()
        TestMeshSlicer()
        TestContourGenerator()
        TestPathGenerator()
        TestPathOrderer()
        TestSkirtGenerator()
        TestTreeSupport()
        TestProfile()
        TestProfileManager()
        TestGcodeWriter()
        TestBambu()
    end

    action GetName returns text
        return "Fabrication Tests"
    end

    action GetCompilerTestSuite returns CompilerTestSuite
        return suite
    end

    action SetCompilerTestSuite(CompilerTestSuite suite)
        me:suite = suite
    end

    action TestArgumentChecker
        Array<File> files
        Array<text> results
        Add(files, passPath + "ArgumentChecker.quorum")
        results:Add(0, "a small positive number passes: true")
        results:Add(1, "0 is rejected: true")
        results:Add(2, "a negative number is rejected: true")
        results:Add(3, "the minimum itself passes: true")
        results:Add(4, "below the minimum is rejected: true")
        results:Add(5, "the lower end passes: true")
        results:Add(6, "the upper end passes: true")
        results:Add(7, "above the range is rejected: true")
        results:Add(8, "below the range is rejected: true")
        results:Add(9, "the message names the setting: true")
        results:Add(10, "the message gives the value: true")
        results:Add(11, "a missing file stops with FileNotFoundError: true")
        results:Add(12, "the message gives the path: true")
        results:Add(13, "an empty path is rejected: true")
        results:Add(14, "an existing file passes: true")
        suite:Test(files, results)
    end

    action TestContour
        Array<File> files
        Array<text> results
        Add(files, passPath + "Contour.quorum")
