        results:Add(6, "a 3-4-5 triangle: true")
        results:Add(7, "reversed, the area is negative: true")
        results:Add(8, "Area doesn't depend on direction: true")
        results:Add(9, "the last point comes first: true")
        results:Add(10, "the centre: true")
        results:Add(11, "a point outside: true")
        results:Add(12, "just outside the left edge: true")
        results:Add(13, "two points enclose nothing: true")
        results:Add(14, "a clockwise hole inside: true")
        results:Add(15, "a counter-clockwise loop inside: true")
        results:Add(16, "the bigger loop isn't inside the smaller one: true")
        results:Add(17, "(why IsInside exists) a shared corner counts as inside the ledge: true")
        results:Add(18, "the block isn't inside the ledge: true")
        results:Add(19, "the ledge isn't inside the block: true")
        results:Add(20, "fewer than 3 points: true")
        results:Add(21, "same points: 4")
        results:Add(22, "planeIndex copied: 3")
        results:Add(23, "wallIndex copied: 2")
        results:Add(24, "role copied: 1")
        results:Add(25, "closed and keepShort copied: true")
        results:Add(26, "changing the copy leaves the original alone: 4")
        results:Add(27, "the original's first point: true")
        results:Add(28, "the repeated first point is removed: 3")
        results:Add(29, "nothing else is removed: 3")
        results:Add(30, "nearest to the far corner: 2")
        results:Add(31, "squared distance to it: true")
        results:Add(32, "0 for an empty contour: 0")
        results:Add(33, "0 distance for an empty contour: true")
        suite:Test(files, results)
    end

