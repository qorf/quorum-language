package Formats.Tests

use Libraries.Data.Formats.NumberFormatter
use Tests.Support.CaseTest

/* Tests Libraries.Data.Formats.NumberFormatter: the text every G-code coordinate and JSON setting goes through. */
class NumberFormatterTest is CaseTest
    NumberFormatter format

    on create
        SetName("NumberFormatter")
    end

    action Run
        FixedRounding()
        FixedSigns()
        FixedLargeNumbers()
        ShortTrimsZeros()
        PercentAndRounded()
    end

    action FixedRounding
        Case("Fixed rounds half up")
        ExpectText(format:Fixed(3.14159, 2), "3.14", "Fixed(3.14159, 2)")
        ExpectText(format:Fixed(2.5, 0), "3", "Fixed(2.5, 0)")
        ExpectText(format:Fixed(0.0005, 3), "0.001", "Fixed(0.0005, 3)")
        ExpectText(format:Fixed(1.0, 3), "1.000", "Fixed(1, 3) keeps its zeros")
        ExpectText(format:Fixed(0.05, 5), "0.05000", "Fixed(0.05, 5) pads the fraction")
        ExpectText(format:Fixed(12.0, 0), "12", "Fixed(12, 0) has no point")
    end

    action FixedSigns
        Case("Fixed never writes -0")
        ExpectText(format:Fixed(-1.25, 1), "-1.3", "Fixed(-1.25, 1)")
        ExpectText(format:Fixed(-0.0001, 2), "0.00", "a negative that rounds to zero")
        ExpectText(format:Fixed(-0.0, 3), "0.000", "minus zero")
    end

    action FixedLargeNumbers
        Case("Fixed handles numbers past the integer range")
        ExpectText(format:Fixed(123456789.5, 3), "123456789.500", "Fixed(123456789.5, 3)")
        ExpectText(format:Fixed(-5000000.25, 2), "-5000000.25", "Fixed(-5000000.25, 2)")
    end

    action ShortTrimsZeros
        Case("Short writes up to 6 significant digits")
        ExpectText(format:Short(0.2), "0.2", "Short(0.2)")
        ExpectText(format:Short(200.0), "200", "Short(200)")
        ExpectText(format:Short(1.75), "1.75", "Short(1.75)")
        ExpectText(format:Short(0.1 + 0.2), "0.3", "Short(0.1 + 0.2)")
        ExpectText(format:Short(123456.7), "123457", "Short(123456.7)")
        ExpectText(format:Short(-0.0000001), "0", "Short of a tiny negative")
    end

    action PercentAndRounded
        Case("Percent and Rounded")
        ExpectText(format:Percent(0.15), "15%", "Percent(0.15)")
        ExpectText(format:Percent(1.0), "100%", "Percent(1)")
        ExpectText(format:Rounded(99.6), "100", "Rounded(99.6)")
    end
end
